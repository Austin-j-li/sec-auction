at = re.compile(r'^Fin: (committed|no contingency|not needed|represented|not committed|not stated); DD required: (none|confirmatory|substantive \\\\(\\\\d+ wks\\\\)|not stated); DD open: (yes|no|not disclosed); Excl: (requested \\\\(\\\\d+ wks\\\\)|granted|none|not stated)$')\\nbad=[]; n=0\\nfor r in range(2, ws.max_row+1):\\n    what=ws.cell(row=r,column=4).value\\n    det=ws.cell(row=r,column=30).value\\n    if what in ('Bid','Bid reaffirmed'):\\n        n+=1\\n        if not det or not pat.match(det): bad.append((r, what, det))\\nprint('bid rows:', n, 'bad detail:', bad)\\n# tag consistency\\nfor r in range(2, ws.max_row+1):\\n    t=(ws.cell(row=r,column=8).value or '')\\n    if t.startswith('Inferred: residual') and ws.cell(row=r,column=36).value!='Inferred: residual': print('tag mismatch', r)\\n    if t.startswith('Inferred: exclusivity') and ws.cell(row=r,column=36).value!='Inferred: exclusivity': print('tag mismatch2', r)\\nprint('tags ok')\\nEOF\"}"},"time":{"start":1789825115060,"end":1789825116485}}}}
