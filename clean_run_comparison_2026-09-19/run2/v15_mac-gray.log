HE MERGER    <BR>    </B></FONT></P>  <P style=\"font-family:times;\"><FONT SIZE=2><A NAME=\"df46801_background_of_the_merger\"> </A> <A NAME=\"toc_df46801_7\"> </A></FONT> <FONT SIZE=2><B>  Background of the Merger    <BR>    </B></FONT></P>  <UL>  <P style=\"font-family:times;\"><FONT SIZE=2><I> Background of the Merger.  </I></FONT></P>  </UL>  <P style=\"font-family:times;\"><FONT SIZE=2>&nbsp;\n======\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /tmp/opencode/macgray && python3 - <<'EOF'\\nimport re\\nraw = open('/home/uctpiaj/work/raw_filing/mac-gray_2013-12-04_DEFM14A.htm', encoding='utf-8', errors='replace').read()\\n\\n# locate the background heading occurrence in raw html (2nd occurrence)\\nidxs = [m.start() for m in re.finditer(r'Background of the Merger', raw)]\\nprint(idxs)\\nfor i in idxs:\\n    # find nearest preceding FOLIO comment\\n    prev = raw.rfind('FOLIO=', 0, i)\\n    folio = raw[prev:prev+40]\\n    # find next FOLIO after\\n    nxt = raw.find('FOLIO=', i)\\n    folio2 = raw[nxt:nxt+40]\\n    print('at', i, 'prev:', folio, '| next:', folio2)\\n    print(raw[max(0,i-300):i+100].replace('\\\\n',' ')[:400])\\n    print('======')\\nEOF\"}"},"time":{"start":1789824274454,"end":1789824275239}}}}
