{"type":"tool_use","timestamp":1789824871141,"sessionID":"ses_f46297742ffe9mtUSz9GNRYMps","part":{"partID":"prt_0b9df2d940012MBM2P4T38iVJt","sessionID":"ses_f46297742ffe9mtUSz9GNRYMps","messageID":"msg_0b9ddf79b001CCoQAcVk6qcGRV","type":"tool","id":"call_00_nyT4aSyabmMXhx1fzNTN9182","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/macgray/build_ledger.py","content":"# -*- coding: utf-8 -*-\n\"\"\"Build mac-gray.xlsx deal ledger from DEFM14A extraction.\"\"\"\nimport re, math, datetime\nfrom bs4 import BeautifulSoup  # noqa\nimport openpyxl\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nWORK = '/tmp/opencode/macgray'\nBLOCKS = WORK + '/filing_blocks2.txt'\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\n\n# ---------------- load source blocks ----------------\nblocks = {}\nfor line in open(BLOCKS, encoding='utf-8'):\n    line = line.rstrip('\\n')\n    m = re.match(r'\\[B(\\d+)\\|PG([^\\]]*)\\] (.*)', line)\n    if m:\n        blocks[m.group(1)] = {'page': m.group(2).strip(), 'text': m.group(3)}\n\n# background paragraph order (P-001..P-087)\nBG = ['B0561','B0562','B0563','B0564','B0565','B0568','B0569','B0570','B0571','B0574',\n'B0575','B0576','B0577','B0578','B0579','B0580','B0583','B0584','B0585','B0586',\n'B0589','B0590','B0591','B0594','B0595','B0596','B0597','B0598','B0599','B0600',\n'B0603','B0604','B0605','B0606','B0607','B0608','B0609','B0612','B0613','B0614',\n'B0615','B0616','B0617','B0618','B0619','B0620','B0623','B0624','B0625','B0626',\n'B0627','B0628','B0629','B0630','B0633','B0634','B0635','B0636','B0637','B0640',\n'B0641','B0642','B0643','B0646','B0647','B0648','B0649','B0650','B0653','B0654',\n'B0655','B0656','B0657','B0658','B0661','B0662','B0663','B0664','B0665','B0668',\n'B0669','B0670','B0671','B0672','B0673','B0674','B0675']\n\n# extra passages used elsewhere (X-###): (block id, section)\nXTRA = [\n ('B0152','Summary Term Sheet — defined terms'),\n ('B0162','The Merger — The Companies (Spin Holdco Inc.)'),\n ('B0164','The Merger — The Companies (CSC Fenway, Inc.)'),\n ('B0546','The Merger — The Companies (Mac-Gray)'),\n ('B0548','The Merger — The Companies (CSC)'),\n ('B0195','Summary Term Sheet — merger consideration'),\n ('B0198','Summary Term Sheet — premium (52-week high)'),\n ('B0200','Summary Term Sheet — premium (Oct 11, 2013 close)'),\n ('B0169','Summary Term Sheet — record date and shares outstanding'),\n ('B0201','Summary Term Sheet — closing price November 27, 2013'),\n ('B0211','Summary Term Sheet — financing of the merger'),\n ('B0212','Summary Term Sheet — Pamplona damages cap'),\n ('B0284','Summary Term Sheet — termination fees'),\n ('B0297','Summary Term Sheet — voting agreements percentage'),\n ('B0299','Summary Term Sheet — regulatory matters (HSR)'),\n ('B0320','Summary Term Sheet — expected closing'),\n ('B0713','Reasons for the Merger — Pamplona commitment letter'),\n ('B0719','Reasons for the Merger — process/parties engaged'),\n ('B0721','Reasons for the Merger — highest price obtainable'),\n ('B0867','Opinion of Mac-Gray\\u2019s Financial Advisor — BofA fee'),\n ('B0881','Projected Financial Information — prepared June 2013'),\n ('B0885','Projected Financial Information — Without Acquisitions: revenue'),\n ('B0886','Projected Financial Information — Without Acquisitions: EBITDA'),\n ('B0887','Projected Financial Information — Without Acquisitions: EPS'),\n ('B0888','Projected Financial Information — Without Acquisitions: capex'),\n ('B0899','Projected Financial Information — With Acquisitions: revenue'),\n ('B0900','Projected Financial Information — With Acquisitions: EBITDA'),\n ('B0901','Projected Financial Information — With Acquisitions: EPS'),\n ('B0902','Projected Financial Information — With Acquisitions: capex'),\n ('B0989','Financing of the Merger — commitment amount'),\n ('B1005','The Merger Agreement — consideration'),\n ('B2068','Merger agreement — Section 5.08 Available Funds'),\n ('B2231','Merger agreement — Section 8.01(b) End Date'),\n ('B0250','Summary Term Sheet — non-solicitation / fiduciary out'),\n ('B1217','Merger agreement — Section 6.02(b) unsolicited proposals'),\n ('B1351','The Merger Agreement — termination fee circumstances'),\n ('B1366','The Merger Agreement — Mac-Gray termination fee payment'),\n ('B1375','The Merger Agreement — Parent termination fee payment'),\n ('B1395','The Voting Agreements — summary'),\n ('B1797','Merger agreement — definition of Voting Agreements'),\n ('B2340','Annex B — fairness opinion (opening)'),\n]\n\npara = {}   # 'P-001' / 'X-001' -> dict(page, section, text, block)\nsection_counter = {'P': 0, 'X': 0}\nfor b in BG:\n    k = 'P-%03d' % (section_counter['P'] + 1); section_counter['P'] += 1\n    para[k] = {'page': blocks[b]['page'], 'section': 'Background of the Merger',\n               'text': blocks[b]['text'], 'block': b}\nfor b, sec in XTRA:\n    k = 'X-%03d' % (section_counter['X'] + 1); section_counter['X'] += 1\n    para[k] = {'page': blocks[b]['page'], 'section': sec, 'text': blocks[b]['text'], 'block': b}\n\n# ---------------- quote checker ----------------\ndef nrm(s):\n    s = s.replace('\\u2019', \"'\").replace('\\u2018', \"'\").replace('\\u201c', '\"').replace('\\u201d', '\"')\n    s = s.replace('\\u2013', '-').replace('\\u2014', '--').replace('\\u2011', '-').replace('\\xa0', ' ')\n    s = re.sub(r'\\s+', ' ', s)\n    return s.strip()\n\ndef check_quote(pk, q):\n    t = nrm(para[pk]['text']); qq = nrm(q)\n    if qq not in t:\n        print('QUOTE FAIL [%s]: %s' % (pk, q[:90]))\n        return False\n    return True\n\n# ---------------- ledger rows ----------------\n# helper to reduce typing\ndef R(key, when, who, what, process, rnd, typ, terms, formality, clevel, reason, quotes,\n      source, review, count, df=None, dt=None, wd=None, basis=None, method=None,\n      plow=None, phigh=None, pkind=None, porigin=None, cur=None, allcash=None, cashclose=None,\n      cdetail=None, due=None, dtreat=None, rfin=None, dby=None, ereason=None, obasis=None,\n      related=None, include='Yes'):\n    return dict(key=key, when=when, who=who, what=what, process=process, rnd=rnd, typ=typ,\n                terms=terms, formality=formality, clevel=clevel, reason=reason, quotes=quotes,\n                source=source, review=review, count=count, df=df, dt=dt, wd=wd, basis=basis,\n                method=method, plow=plow, phigh=phigh, pkind=pkind, porigin=porigin, cur=cur,\n                allcash=allcash, cashclose=cashclose, cdetail=cdetail, due=due, dtreat=dtreat,\n                rfin=rfin, dby=dby, ereason=ereason, obasis=obasis, related=related or [],\n                include=include)\n\nrows = []\n\nrows.append(R('ctx2011', 'Winter 2011 into early 2012 (month/day not disclosed)', 'Mac-Gray; CSC',\n 'Material process update', 1, 0, '',\n 'Pre-opening context: Mac-Gray and CSC discussed CSC\\u2019s possible acquisition by Mac-Gray (the 2011-2012 Discussions) \\u2014 a reverse-direction exploration, not a sale of Mac-Gray; CSC was later sold to Pamplona in May 2013. Kept to explain the BofA Merrill Lynch mandate history.',\n '', '', 'Context only: the filing records an earlier attempt in the opposite direction (Mac-Gray as potential acquirer of CSC), which is not one of the target\\u2019s sale attempts. Working date is a convention for the winter 2011\\u2013early 2012 window.',\n [('P-002', 'including discussions between Mac-Gray and CSC in the winter of 2011 and into 2012 regarding the possible acquisition of CSC by Mac-Gray'),\n  ('P-002', 'During the fall and winter of 2012, CSC engaged in a sale process and, ultimately, CSC was purchased by Pamplona in May 2013.')],\n ['P-002'], ['Q1'], None, df='12/01/2011', dt='03/31/2012', wd='01/15/2012',\n basis='Approximate window', method='Assigned: midpoint', related=[('bofa2012', 'related')]))\n\nrows.append(R('bofa2012', '10/23/2012', 'BofA Merrill Lynch', 'Adviser engaged', 1, 0, '',\n 'BofA Merrill Lynch engaged by Mac-Gray in connection with the 2011-2012 Discussions (Mac-Gray\\u2019s possible acquisition of CSC).',\n '', '', 'Stated engagement date; client = Mac-Gray; mandate concerned the earlier reverse-direction exploration (no process number of its own).',\n [('P-002', 'Mac-Gray engaged BofA Merrill Lynch on October 23, 2012')],\n ['P-002'], [], None, df='10/23/2012', dt='10/23/2012', wd='10/23/2012',\n basis='Reported day', method='Reported', related=[('ctx2011', 'related'), ('bofaend', 'related')]))\n\nrows.append(R('apr5', '04/05/2013', 'Mac-Gray Board of Directors', 'Target decision', 1, 0, '',\n 'Board discussed CSC\\u2019s sale to Pamplona and industry-wide M&A, and authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities, including with Party A (another strategic party in the laundry facilities management industry); alternatives review to continue at the scheduled May 9, 2013 meeting.',\n '', '', 'Stated day; initiation step authorizing exploration, not yet an irrevocable sale decision.',\n [('P-003', 'authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities that might be available to Mac-Gray, including opportunities with another strategic party, whom we refer to as Party A, in the laundry facilities management industry')],\n ['P-003'], [], None, df='04/05/2013', dt='04/05/2013', wd='04/05/2013',\n basis='Reported day', method='Reported', related=[('pa_contact', 'related')]))\n\nrows.append(R('pa_contact', '04/08/2013', 'Party A', 'Target interest', 1, 0, 'Strategic',\n 'First sale-related contact (outbound): BofA Merrill Lynch, instructed by the Board, telephoned Party A to discuss a possible business combination; Party A indicated it might consider one. First-contact fact carried here; no duplicate Contact row.',\n '', '', 'Stated day and direction (Mac-Gray side telephoned). Party A treated as Strategic \\u2014 an industry participant identified at initiation and later grouped with CSC/Pamplona as the two strategic bidders.',\n [('P-004', 'representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray'),\n  ('P-004', 'the representative of Party A indicated that Party A might consider a business combination with Mac-Gray')],\n ['P-004', 'P-025'], ['Q1'], 1, df='04/08/2013', dt='04/08/2013', wd='04/08/2013',\n basis='Reported day', method='Reported', related=[('apr5', 'follows'), ('pa_bid', 'followed by')]))\n\nrows.append(R('goodwin', 'from 05/09/2013 (first observed acting on the mandate)', 'Goodwin Procter LLP',\n 'Adviser service observed', 1, 0, '',\n 'Mac-Gray\\u2019s outside legal counsel; first shown acting on the strategic-alternatives/sale mandate at the May 9, 2013 Board meeting; continued through exclusivity, the merger agreement, the Pamplona commitment letter and signing. Engagement date and terms not disclosed.',\n '', '', 'First-mention date used as the Working date by convention; the filing shows service rather than a dated engagement (no engagement letter or start date is reported).',\n [('P-005', 'representatives from BofA Merrill Lynch and Goodwin Procter LLP, outside legal counsel to Mac-Gray, were also in attendance')],\n ['P-005'], [], None, df='05/09/2013', dt='05/09/2013', wd='05/09/2013',\n basis='Reported day', method='Reported'))\n\nrows.append(R('bofaend', '05/15/2013 (Transaction Committee decision 05/14/2013)', 'BofA Merrill Lynch',\n 'Adviser ended', 1, 0, '',\n 'Engagement letter for the 2011-2012 Discussions terminated. The Transaction Committee determined on 05/14/2013 to terminate it because BofA Merrill Lynch was a candidate for the new strategic-alternatives mandate and the CSC sale process had ended; Mac-Gray sent the termination letter on 05/15/2013.',\n '', '', 'Stated dates; termination of the earlier mandate (not an end to the relationship \\u2014 re-engagement followed, see Adviser engaged 05/31/2013).',\n [('P-010', 'the Transaction Committee determined to terminate BofA Merrill Lynch\\u2019s engagement letter entered into for purposes of the 2011-2012 Discussions'),\n  ('P-011', 'On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions.')],\n ['P-011', 'P-010'], [], None, df='05/15/2013', dt='05/15/2013', wd='05/15/2013',\n basis='Reported day', method='Reported', related=[('bofa2012', 'ends'), ('bofa2013', 'followed by')]))\n\nrows.append(R('bofa2013', '05/31/2013 (Board approval 05/30/2013; selection process from 05/10/2013)', 'BofA Merrill Lynch',\n 'Adviser engaged', 1, 0, '',\n 'Engaged for the Board\\u2019s review of strategic alternatives, including a potential sale process; agreed not to engage as a possible source of new acquisition financing for any potential buyers without Mac-Gray\\u2019s prior written consent. The Board approved the engagement on 05/30/2013 after interviews of three banks, and the engagement letter was entered on 05/31/2013.',\n '', '', 'Stated dates; the no-buyer-financing restriction is recorded because it bears on how buyer financing could be arranged.',\n [('P-017', 'On May 31, 2013, Mac-Gray entered into an engagement letter with BofA Merrill Lynch with respect to the Board\\u2019s undertaking a review of strategic alternatives, including a potential sale process, and in which BofA Merrill Lynch agreed not to engage as a possible source of new acquisition financing for any potential buyers in connection with any such sale process without Mac-Gray\\u2019s prior written consent.')],\n ['P-017'], ['Q1'], None, df='05/31/2013', dt='05/31/2013', wd='05/31/2013',\n basis='Reported day', method='Reported', related=[('bofaend', 'follows')]))\n\nrows.append(R('pa_bid', '06/21/2013', 'Party A', 'Bid', 1, 0, 'Strategic',\n 'Unsolicited pre-NDA proposal to purchase Mac-Gray for $17.00\\u2013$19.00 per share in all cash (Party A June 21 proposal); made before any diligence access. Considered by the Special Committee alongside the preliminary indications at the 07/25/2013 meeting. Price range preserved; no retrospective upgrade.',\n 'Informal', 'Heavy',\n 'Stated price and whole-company scope. Formality: preliminary unsolicited proposal with no supported formal signal (no returned markups or final-solicitation response) \\u2014 Informal. Conditions: Heavy by context because the proposal preceded substantive diligence access. DD open: no access yet. Count 1 (Party A\\u2019s first bid unit); the proposal was still standing when Round 1 was evaluated, so the round map shows Party A as a round-1 participant although this row sits in round 0.',\n [('P-019', 'On June 21, 2013, Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share'),\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal, in each case from a financial point of view')],\n ['P-019', 'P-036'], ['Q1', 'Q6'], 1, df='06/21/2013', dt='06/21/2013', wd='06/21/2013',\n basis='Reported day', method='Reported', plow=17.00, phigh=19.00, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes', cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n related=[('pa_contact', 'follows'), ('pa_nda', 'followed by'), ('pa_bid2', 'revises'), ('r1', 'standing at round 1')]))\n\nrows.append(R('exclu', '06/24/2013', 'Mac-Gray Board of Directors / Special Committee', 'Target decision', 1, 0, '',\n 'Board excluded CEO Stewart G. MacDonald, Jr. (potential rollover conflict; the Transaction Committee had recommended exclusion on 05/10/2013) and Moab\\u2019s Michael Rothenberg (~9% holder; possible Moab rollover) from the evaluation of strategic alternatives and negotiations with third parties, and established the six-member Special Committee (Bullock, chair; Daoust, Hyman, Meagher, Percelay, Robinson), with the Transaction Committee as administrative sub-committee. Mr. Rothenberg was later asked to recuse himself from Board meetings for the duration of the process (07/25/2013).',\n '', '', 'Stated day; governance step material to process design and to the Moab/MacDonald rollover treatments in this ledger.',\n [('P-020', 'the Board decided, and Mr. MacDonald and Mr. Rothenberg agreed, that it would be appropriate to exclude Mr. MacDonald and Mr. Rothenberg from the Board\\u2019s evaluation of strategic alternatives and any negotiations with third parties that might take place'),\n  ('P-018', 'At the time of this meeting, Moab beneficially owned approximately 9% of Mac-Gray\\u2019s outstanding common stock.'),\n  ('P-036', 'decided that Mr. Rothenberg should be asked to recuse himself from participating in Board meetings for the duration of the sale process')],\n ['P-020', 'P-018', 'P-036'], ['Q1', 'Q8'], None, df='06/24/2013', dt='06/24/2013', wd='06/24/2013',\n basis='Reported day', method='Reported', related=[('r1', 'precedes'), ('moab_deny', 'related'), ('macdecl', 'related'), ('moab_res', 'related')]))\n\nrows.append(R('r1', '06/24/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 1, '',\n 'R1 anchor: the 06/24/2013 Special Committee conclusion to consider a sale of Mac-Gray and approach 50 parties (15 strategic, 35 financial), including CSC/Pamplona and Party A; BofA Merrill Lynch outreach followed within days (06/28/2013 update) and informational packages instructed preliminary indications of interest by 07/23/2013. Rejected anchor candidates: '\n '10/23/2012 BofA engagement, 04/08/2013 Party A contact and 06/21/2013 Party A proposal (all retained as their own rows); the first outreach wave has no single disclosed date. Finality: Not final \\u2014 no finality announcement; the process continued to staged diligence and revised indications.',\n '', '',\n 'Round 1 opens on the decision that launched solicitation (outreach as its direct execution beginning within about a week); due date carried on this row as the deadline set with the solicitation, per section 8.3. Participant scope: the 50 approached parties, of which 20 signed confidentiality agreements (see the NDA cohort and individual rows).',\n [('P-022', 'the Special Committee concluded that it would be in the best interests of stockholders to consider a potential sale of Mac-Gray'),\n  ('P-023', 'Guided by the foregoing principles, the Special Committee determined to approach a total of'),\n  ('P-024', '50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray, 15 of which were potential strategic buyers and 35 of which were potential financial buyers, including private equity firms.'),\n  ('P-025', 'Parties that had entered into confidentiality and standstill agreements with Mac-Gray were furnished an informational package for the purpose of providing potential bidders with data to formulate a preliminary indication of interest, which they were instructed to submit by July 23, 2013.')],\n ['P-022', 'P-024', 'P-023', 'P-025'], ['Q1', 'Q2'], None, df='06/24/2013', dt='06/24/2013', wd='06/24/2013',\n basis='Reported day', method='Reported', due='07/23/2013', rfin='Not final',\n related=[('exclu', 'follows'), ('pa_bid', 'anchor candidate, rejected'), ('bofa2012', 'anchor candidate, rejected'), ('pa_contact', 'anchor candidate, rejected'), ('nda_res', 'admits population')]))\n\nrows.append(R('nda_res', 'between 06/24/2013 and 08/24/2013 (over the next two months; individual dates not disclosed)',\n '16 financial confidentiality-agreement signers (residual cohort)', 'NDA signed', 1, 1, 'Financial',\n 'Residual cohort: 20 reported confidentiality and standstill signers less the four individually recorded signers (Party A, Party B, Party C, CSC/Pamplona) = 16 remaining financial signers. Form individually negotiated but not materially varied; standstill with a sunset allowing confidential proposals upon an announced business combination.',\n '', '',\n 'Reported total and composition (2 strategic, 18 financial) with individual details for four signers; the residual cohort is disjoint by construction. Working date is the first day of the two-month signing window (Assigned: bound); exact dates not disclosed.',\n [('P-025', 'Over the next two months a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray on a form provided by Mac-Gray, the terms of which were individually negotiated with potential bidders, but did not vary materially from the form provided.'),\n  ('P-025', 'The confidentiality agreements contained customary non-disclosure provisions and a customary standstill provision that either expired or permitted the potential bidder to make confidential proposals to Mac-Gray (a so-called \"sunset\" provision) upon announcement of a business combination between Mac-Gray and a third party')],\n ['P-025'], ['Q3'], 16, df='06/24/2013', dt='08/24/2013', wd='06/24/2013',\n basis='Approximate window', method='Assigned: bound', related=[('r1', 'admits cohort'), ('pb_nda', 'named signer excluded from residual'), ('pc_nda', 'named signer excluded from residual'), ('cs_nda', 'named signer excluded from residual'), ('pa_nda', 'named signer excluded from residual')]))\n\nrows.append(R('cs_contact', 'by 06/28/2013 (first reported contact; exact date not disclosed)', 'CSC/Pamplona', 'Contact', 1, 1, 'Strategic',\n 'BofA Merrill Lynch had spoken with Pamplona, which expressed interest in a transaction including an acquisition of Mac-Gray by its portfolio company, CSC; Pamplona said business and legal due diligence would be minimal given its familiarity with Mac-Gray and the industry.',\n '', '',\n 'First sale-related contact reported on 06/28/2013; earlier bound not disclosed, so Working date = the bound (Assigned: bound). Direction: target-side outreach. Type Strategic (CSC is an operating laundry-services company; sponsor-owned \\u2014 acquisition through a sponsor-owned operating company, not a financial role).',\n [('P-026', 'BofA Merrill Lynch also reported that they had spoken with representatives of Pamplona, as instructed by the Special Committee, who expressed interest in a transaction, including an acquisition of Mac-Gray by its portfolio company, CSC.'),\n  ('P-026', 'Pamplona emphasized that business and legal due diligence would be minimal given its familiarity with Mac-Gray and the industry generally.')],\n ['P-026'], ['Q3'], 1, dt='06/28/2013', wd='06/28/2013', basis='Relative only', method='Assigned: bound',\n related=[('cs_nda', 'followed by'), ('r1', 'outreach under round 1')]))\n\nrows.append(R('pb_nda', '06/28/2013', 'Party B', 'NDA signed', 1, 1, 'Financial',\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\n '', '', 'Stated execution day; entry gate for a financial bidder.',\n [('P-027', 'Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party B with data to formulate a preliminary indication of interest.')],\n ['P-027'], ['Q3'], 1, df='06/28/2013', dt='06/28/2013', wd='06/28/2013',\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pb_bid1', 'followed by')]))\n\nrows.append(R('pc_nda', '06/30/2013', 'Party C', 'NDA signed', 1, 1, 'Financial',\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\n '', '', 'Stated execution day; entry gate for a financial bidder.',\n [('P-028', 'On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party C with data to formulate a preliminary indication of interest.')],\n ['P-028'], ['Q3'], 1, df='06/30/2013', dt='06/30/2013', wd='06/30/2013',\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pc_bid1', 'followed by')]))\n\nrows.append(R('moab_deny', '07/06/2013', 'Moab (shareholder)', 'Material process update', 1, 1, '',\n 'Special Committee denied Moab\\u2019s request to partner exclusively with CSC/Pamplona at this stage, so the potential equity rollover of Moab\\u2019s shares could remain available as a source of capital for other bidders; Moab was told the discussions were premature but would be permitted at a later stage of the sale process.',\n '', '',\n 'Stated day; one permitted/denied row for the Moab rollover relationship (its resolution is recorded separately when the discussions concluded).',\n [('P-031', 'the Special Committee decided to deny the exclusivity request at this stage of the process so that the potential equity rollover of Moab\\u2019s shares could be available as a source of capital for other potential bidders'),\n  ('P-031', 'it was premature for Mac-Gray to permit Moab to engage in equity rollover discussions with any party, including CSC/Pamplona, but that such discussions would be permitted at a later stage of the sale process')],\n ['P-031'], ['Q8'], None, df='07/06/2013', dt='07/06/2013', wd='07/06/2013',\n basis='Reported day', method='Reported', related=[('exclu', 'related'), ('moab_res', 'resolved later')]))\n\nrows.append(R('cs_nda', '07/11/2013', 'CSC/Pamplona', 'NDA signed', 1, 1, 'Strategic',\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\n '', '', 'Stated execution day; entry gate for the strategic unit.',\n [('P-032', 'On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package for the purpose of providing CSC/Pamplona with data to formulate a preliminary indication of interest.')],\n ['P-032'], ['Q3'], 1, df='07/11/2013', dt='07/11/2013', wd='07/11/2013',\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('cs_bid1', 'followed by')]))\n\nrows.append(R('dl723', '07/23/2013 (preliminary IOI due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 1, '',\n 'Scheduled due date for preliminary indications of interest. CSC/Pamplona submitted on the date; Party B and Party C submitted on 07/24/2013 and were considered at the 07/25/2013 Special Committee meeting \\u2014 late bids accepted; the date was not revised.',\n '', '',\n 'Treatment from what followed in the same round: submissions dated after the due date were considered without any revision \\u2014 Late bids accepted.',\n [('P-025', 'which they were instructed to submit by July 23, 2013'),\n  ('P-035', 'On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share.'),\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal')],\n ['P-025', 'P-035', 'P-036'], ['Q2'], None, df='07/23/2013', dt='07/23/2013', wd='07/23/2013',\n basis='Reported day', method='Reported', due='07/23/2013', dtreat='Late bids accepted'))\n\nrows.append(R('cs_bid1', '07/23/2013', 'CSC/Pamplona', 'Bid', 1, 1, 'Strategic',\n 'Preliminary indication of interest: all cash at $18.50 per share. Made after only the informational package; no substantive diligence access yet.',\n 'Informal', 'Heavy',\n 'Stated price. Formality: preliminary indication before diligence with no supported formal signal \\u2014 Informal. Conditions: Heavy by context because the indication preceded substantive diligence access (data-room or management access), whatever diligence wording it used; Pamplona\\u2019s stated familiarity did not remove that context.',\n [('P-034', 'On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share.')],\n ['P-034'], ['Q6'], 1, df='07/23/2013', dt='07/23/2013', wd='07/23/2013',\n basis='Reported day', method='Reported', plow=18.50, phigh=18.50, pkind='Point', porigin='Stated',\n cur='USD', allcash='Yes', cashclose=18.50,\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n related=[('cs_nda', 'follows'), ('cs_bid2', 'revises')]))\n\nrows.append(R('nonsub1', 'by 07/23/2013', '16 financial confidentiality-agreement signers (residual cohort)', 'Did not submit', 1, 1, 'Financial',\n 'Inferred: residual \\u2014 20 confidentiality agreement signers \\u2212 4 bidders the filing accounts for at this transition (CSC/Pamplona, Party B and Party C, whose preliminary indications were reviewed on 07/25/2013, and Party A, whose June 21 proposal was reviewed while it negotiated its NDA) = 16 non-submitters. Base assumes the four named continuing bidders are the complete set; if unnamed signers also submitted, this overstates the residual.',\n '', '',\n 'Inferred: residual with the arithmetic shown; no decision dates, motives, identities or voluntary withdrawals inferred. Working date = the solicitation\\u2019s due date (Assigned: deadline).',\n [('P-025', 'a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray'),\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal, in each case from a financial point of view'),\n  ('P-038', 'to reach out to each of the four interested bidders and arrange management meetings')],\n ['P-025', 'P-036', 'P-038'], ['Q3', 'Q4'], 16, dt='07/23/2013', wd='07/23/2013',\n basis='Relative only', method='Assigned: deadline', dby='Unknown', ereason='Not stated',\n obasis='Inferred: residual', related=[('nda_res', 'closes part of cohort'), ('pa_bid', 'accounted at transition'), ('cs_bid1', 'accounted at transition'), ('pb_bid1', 'accounted at transition'), ('pc_bid1', 'accounted at transition')]))\n\nrows.append(R('pb_bid1', '07/24/2013', 'Party B', 'Bid', 1, 1, 'Financial',\n 'Preliminary indication of interest: all cash at $17.00\\u2013$18.00 per share. Submitted one day after the 07/23/2013 request; considered by the Special Committee on 07/25/2013 (late bids accepted). Made before substantive diligence access.',\n 'Informal', 'Heavy',\n 'Stated range and timing. Formality Informal (preliminary indication; no formal signal). Conditions Heavy by context (pre-diligence indication). DD open: no; no firm financing information reported at this stage.',\n [('P-035', 'On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share.')],\n ['P-035', 'P-036'], ['Q6'], 1, df='07/24/2013', dt='07/24/2013', wd='07/24/2013',\n basis='Reported day', method='Reported', plow=17.00, phigh=18.00, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes',\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n related=[('pb_nda', 'follows'), ('pb_bid2', 'revises')]))\n\nrows.append(R('pc_bid1', '07/24/2013', 'Party C', 'Bid', 1, 1, 'Financial',\n 'Oral preliminary indication of interest: all cash at $15.00\\u2013$17.00 per share, presented by telephone to BofA Merrill Lynch; considered on 07/25/2013 (late bids accepted).',\n 'Informal', 'Heavy',\n 'Stated range, oral form and timing. Formality Informal (preliminary indication before diligence). Conditions Heavy by context (pre-diligence indication).',\n [('P-035', 'representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share')],\n ['P-035', 'P-036'], ['Q6'], 1, df='07/24/2013', dt='07/24/2013', wd='07/24/2013',\n basis='Reported day', method='Reported', plow=15.00, phigh=17.00, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes',\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n related=[('pc_nda', 'follows'), ('pc_bid1w', 'superseded by written version')]))\n\nrows.append(R('pc_bid1w', '07/25/2013', 'Party C', 'Bid', 1, 1, 'Financial',\n 'Same preliminary indication put in writing at a narrowed $16.00\\u2013$16.50 per share; the written version revises the oral range given the previous day.',\n 'Informal', 'Heavy',\n 'Stated range and written form. Count 0 because this is the same bidder unit\\u2019s preliminary indication already counted earlier in Round 1 (repeated/revised description); formality and conditions unchanged from the oral indication.',\n [('P-039', 'Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share.')],\n ['P-039'], ['Q6'], 0, df='07/25/2013', dt='07/25/2013', wd='07/25/2013',\n basis='Reported day', method='Reported', plow=16.00, phigh=16.50, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes',\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n related=[('pc_bid1', 'revises (written version of same indication)')]))\n\nrows.append(R('r2', '07/25/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 2, '',\n 'R2 opened: after reviewing the preliminary indications (all lower than expected), the Special Committee selected the four interested bidders for the second stage \\u2014 management presentations and staged data-site access \\u2014 and authorized BofA Merrill Lynch to proceed with the staged disclosure and to request revised indications of interest. Party A\\u2019s management meeting was conditional on its agreeing a confidentiality agreement. Revised written proposals were requested on 08/27/2013 with a 09/09/2013 due date (see deadline rows). Finality: Not final \\u2014 no finality announcement; the round continued to a final-indication stage.',\n '', '',\n 'Round boundary from selection of advancing participants plus a distinct information stage linked to new offers. Uniform access (presentations to all four) is recorded on this row; differentiated access is its own Information access changed row. Mr. Rothenberg\\u2019s duration recusal belongs to the exclusion row.',\n [('P-037', 'the Special Committee concluded that it would be advisable to stage the disclosure of such information to each of the bidders to the extent that a bidder\\u2019s indication of interest and other actions demonstrated its seriousness in acquiring Mac-Gray on terms viewed favorably by the Special Committee'),\n  ('P-038', 'the Special Committee authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure as discussed at this meeting and to reach out to each of the four interested bidders and arrange management meetings'),\n  ('P-038', 'and to then request that each of these parties submit a revised indication of interest')],\n ['P-037', 'P-038'], ['Q1'], None, df='07/25/2013', dt='07/25/2013', wd='07/25/2013',\n basis='Reported day', method='Reported', rfin='Not final',\n related=[('r1', 'follows'), ('access1', 'opens staged access'), ('dl909', 'requests revised proposals')]))\n\nrows.append(R('pa_nda', '08/05/2013', 'Party A', 'NDA signed', 1, 1, 'Strategic',\n 'Confidentiality and standstill agreement executed after negotiations paused over the customer and employee non-solicitation provisions; informational package furnished to enable improvement of the June 21 proposal. Last of the four bidder NDAs.',\n '', '',\n 'Stated execution day. Source typo retained: Discussions with Party A resumed on July 27, 2103 (read 07/27/2013); the filing places the resumed negotiations between 07/11/2013 and 07/23/2013.',\n [('P-040', 'Discussions with Party A resumed on July 27, 2103 and Party A and the Transaction Committee agreed to the terms of the customer and employee non-solicitation provisions.'),\n  ('P-040', 'On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party A with data to potentially improve the terms of the Party A June 21 proposal.')],\n ['P-040', 'P-033'], ['Q3', 'Q8'], 1, df='08/05/2013', dt='08/05/2013', wd='08/05/2013',\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pa_bid2', 'followed by')]))\n\nrows.append(R('access1', 'between 08/06/2013 and 08/27/2013', 'Party A and CSC/Pamplona (limited) vs. Party B and Party C (broad)', 'Information access changed', 1, 2, '',\n 'Tiered access during the August 6\\u201327 diligence: Party B and Party C (financial bidders) were given broad access to the electronic data site while Party A and CSC/Pamplona (strategic bidders) were given somewhat limited access, with customer data including customer locations reserved until later in the process. Management presentations were given to all four (Party B 08/06, Party C 08/08, CSC/Pamplona 08/12, Party A 08/14), and Party A and CSC/Pamplona had synergy discussions with management.',\n '', '',\n 'Stated interval, recipients, withholding and rationale (staging decided at the 07/25/2013 meeting). Access given alike to all four is recorded on the Round 2 row; this row records the differentiation. Working date = first day of the period (Assigned: bound).',\n [('P-046', 'During this time, Party B and Party C, in light of the fact that they were financial bidders, were given broad access to an electronic data site, and Party A and CSC/Pamplona, in light of the fact that they were strategic bidders, were given somewhat limited access to this electronic data site, with access to customer data, including customer locations, being reserved until later in the process as part of the staging discussed at the July 25th Special Committee meeting.')],\n ['P-046', 'P-041', 'P-042', 'P-043', 'P-044'], ['Q3'], None, df='08/06/2013', dt='08/27/2013',\n wd='08/06/2013', basis='Reported interval', method='Assigned: bound', related=[('r2', 'implements staged access'), ('access2', 'later full access to winner')]))\n\nrows.append(R('dl909set', '08/27/2013', 'Mac-Gray (via BofA Merrill Lynch)', 'Deadline set', 1, 2, '',\n 'BofA Merrill Lynch, as instructed (authorization 08/15/2013), sent letters to Party A, Party B, Party C and CSC/Pamplona instructing revised written proposals no later than 09/09/2013 to continue in the process toward in-depth confirmatory diligence; proposals to address valuation, financing sources and structures, regulatory approvals, post-signing covenants and diligence focus areas.',\n '', '', 'Stated communication date; new bid-submission due date for Round 2 (09/09/2013).',\n [('P-047', 'sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013'),\n  ('P-045', 'the Special Committee authorized and instructed BofA Merrill Lynch to send a letter to each of Party A, Party B, Party C and CSC/Pamplona once all four of the bidders\\u2019 due diligence was substantially complete requesting that, in light of the results of the respective party\\u2019s due diligence, such party submit a revised written proposal in order to continue in the process')],\n ['P-047', 'P-045'], ['Q2'], None, df='08/27/2013', dt='08/27/2013', wd='08/27/2013',\n basis='Reported day', method='Reported', due='09/09/2013', related=[('r2', 'follows'), ('dl909', 'sets')]))\n\nrows.append(R('dl909', '09/09/2013 (revised-proposal due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 2, '',\n 'Scheduled due date for revised written proposals. CSC/Pamplona and Party B submitted on the date; Party A and Party C submitted on 09/10/2013 and were considered at the 09/11/2013 Special Committee meeting \\u2014 late bids accepted; the date was not revised.',\n '', '',\n 'Treatment from what followed in the same round: submissions dated after the due date were considered without revision \\u2014 Late bids accepted.',\n [('P-047', 'submit revised written proposals no later than September 9, 2013'),\n  ('P-052', 'On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share'),\n  ('P-054', 'the Special Committee held a telephonic meeting to review the revised indications of interest submitted by Party A, Party B, Party C and CSC/Pamplona')],\n ['P-047', 'P-052', 'P-054'], ['Q2'], None, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\n basis='Reported day', method='Reported', due='09/09/2013', dtreat='Late bids accepted'))\n\nrows.append(R('cs_bid2', '09/09/2013', 'CSC/Pamplona', 'Bid', 1, 2, 'Strategic',\n 'Revised indication of interest: all cash at $19.50 per share. Pamplona committed to provide 100% of the capital required to consummate the transaction; requested two-week exclusive negotiations. No third-party financing needed.',\n 'Informal', 'Light',\n 'Stated price and commitment. Formality Informal: a revised indication submitted to continue in the process, not a response to a final solicitation; no markup or other formal signal. Conditions Light: committed financing with no diligence condition attached (the two-week exclusive negotiation is treated as an exclusivity request, not an attached substantive diligence period \\u2014 flagged in Q6). DD open: yes (continuing diligence).',\n [('P-051', 'On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share, indicating that Pamplona was committed to provide 100% of the capital required to consummate the transaction and requesting that CSC/Pamplona and Mac-Gray agree to exclusive negotiations for two weeks.')],\n ['P-051'], ['Q5', 'Q6'], 1, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\n basis='Reported day', method='Reported', plow=19.50, phigh=19.50, pkind='Point', porigin='Stated',\n cur='USD', allcash='Yes', cashclose=19.50,\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\n related=[('cs_bid1', 'revises'), ('cs_bid3', 'revised by')]))\n\nrows.append(R('pb_bid2', '09/09/2013', 'Party B', 'Bid', 1, 2, 'Financial',\n 'Revised indication of interest: all cash at $18.50 per share; proposed financing from a combination of equity from affiliated funds and third-party debt. No firm financing commitment.',\n 'Informal', 'Heavy',\n 'Stated price, financing plan and absence of a firm commitment. Formality Informal (revised indication in the continuing process). Conditions Heavy: reported absence of committed financing; third-party debt dependence later emphasized by the Special Committee.',\n [('P-051', 'On September 9, 2013, Party B also submitted a revised indication of interest with an all-cash purchase price of $18.50 per share and proposed to finance the transaction with a combination of equity from affiliated funds and third party debt. Party B\\u2019s revised indication of interest did not include a firm financing commitment.')],\n ['P-051'], ['Q6'], 1, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\n basis='Reported day', method='Reported', plow=18.50, phigh=18.50, pkind='Point', porigin='Stated',\n cur='USD', allcash='Yes', cashclose=18.50,\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\n related=[('pb_bid1', 'revises'), ('pb_bid3', 'revised by')]))\n\nrows.append(R('pa_bid2', '09/10/2013', 'Party A', 'Bid', 1, 2, 'Strategic',\n 'Revised indication of interest: all cash at $18.00\\u2013$19.00 per share, to be financed from outstanding credit facilities or affiliated equity sources; no firm financing commitment. Submitted one day after the 09/09/2013 due date and considered on 09/11/2013 (late bids accepted).',\n 'Informal', 'Heavy',\n 'Stated range and financing sources; reported absence of a firm commitment. Formality Informal (continuing-process revision). Conditions Heavy (no committed financing). DD open: yes.',\n [('P-052', 'On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share, to be financed by outstanding credit facilities or affiliated equity sources.'),\n  ('P-052', 'Neither Party A\\u2019s nor Party C\\u2019s revised indication of interest included a firm financing commitment.')],\n ['P-052', 'P-054'], ['Q6'], 1, df='09/10/2013', dt='09/10/2013', wd='09/10/2013',\n basis='Reported day', method='Reported', plow=18.00, phigh=19.00, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes',\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\n related=[('pa_bid', 'revises (previous indication retained)'), ('pa_reaff', 'reaffirmed later')]))\n\nrows.append(R('pc_bid2', '09/10/2013', 'Party C', 'Bid', 1, 2, 'Financial',\n 'Revised oral indication of interest: all cash at $16.00\\u2013$17.00 per share, by telephone to BofA Merrill Lynch; no firm financing commitment. Submitted one day after the 09/09/2013 due date and considered on 09/11/2013 (late bids accepted).',\n 'Informal', 'Heavy',\n 'Stated range, oral form and timing; reported absence of a firm commitment. Formality Informal; Conditions Heavy (no committed financing).',\n [('P-052', 'a representative of Party C indicated that it was submitting a revised oral indication of interest with an all-cash purchase price of $16.00 to $17.00 per share')],\n ['P-052', 'P-054'], ['Q6'], 1, df='09/10/2013', dt='09/10/2013', wd='09/10/2013',\n basis='Reported day', method='Reported', plow=16.00, phigh=17.00, pkind='Bidder range',\n porigin='Stated', cur='USD', allcash='Yes',\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\n related=[('pc_bid1w', 'revises')]))\n\nrows.append(R('macdecl', '09/11/2013', 'Stewart G. MacDonald, Jr. (CEO)', 'Material process update', 1, 2, '',\n 'Mr. MacDonald, given a limited overview without bidder identities or prices, decided he was not interested in rolling over any of his Mac-Gray shares in any transaction (resolved; no rollover formed). A detailed briefing followed on 09/12/2013; he supported continuing the process while urging a higher value.',\n '', '',\n 'Stated day; resolution row for the CEO rollover relationship under the at-most-two-rows convention (the exclusion itself is recorded separately).',\n [('P-053', 'During this call, Mr. MacDonald indicated that he had decided that he was not interested in rolling over any of his shares in any transaction.'),\n  ('P-056', 'Although Mr. MacDonald voiced his general support for continuing with the process, he expressed his view that Mac-Gray should continue to seek a higher value for stockholders.')],\n ['P-053', 'P-056'], ['Q8'], None, df='09/11/2013', dt='09/11/2013', wd='09/11/2013',\n basis='Reported day', method='Reported', related=[('exclu', 'related'), ('target_dec', 'support at $21.25')]))\n\nrows.append(R('r3', '09/11/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 3, '',\n 'R3 opened: the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by 09/18/2013 and to indicate that Mac-Gray would consider a short period of exclusive negotiations with one bidder depending on price and deal certainty (calls made the same day). Finality: Announced as final \\u2014 the bidders were told these were final indications of interest.',\n '', '',\n 'The target\\u2019s first request for final/best-and-final offers opens a new round even though the invited bidders are unchanged; the deadline set in the same instruction is carried on this row as the Due date, per section 8.3.',\n [('P-055', 'the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by September 18, 2013 and to indicate that Mac-Gray would consider engaging in a short period of exclusive negotiations with one of the bidders depending upon, among other things, the proposed purchase price and the level of deal certainty indicated in the bidder\\u2019s final proposal')],\n ['P-055', 'P-054'], ['Q1', 'Q2'], None, df='09/11/2013', dt='09/11/2013', wd='09/11/2013',\n basis='Reported day', method='Reported', due='09/18/2013', rfin='Announced as final',\n related=[('r2', 'follows'), ('dl918', 'sets final due date')]))\n\nrows.append(R('dl918', '09/18/2013 (final-indication due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 3, '',\n 'Scheduled due date for final indications of interest. CSC/Pamplona and Party B submitted and Party A reaffirmed its best-and-final offer on the date; Party C did not submit. The Special Committee moved the next day to select CSC/Pamplona and authorize exclusivity \\u2014 the date passed on the bids in hand.',\n '', '',\n 'Treatment from what followed in the same round: no extension and no acceptance of anything submitted after the date; the target took its next step (selection/exclusivity) on the bids in hand \\u2014 Enforced.',\n [('P-055', 'request final indications of interest by September 18, 2013'),\n  ('P-058', 'On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share'),\n  ('P-061', 'authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share')],\n ['P-055', 'P-058', 'P-061'], ['Q2'], None, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\n basis='Reported day', method='Reported', due='09/18/2013', dtreat='Enforced'))\n\nrows.append(R('cs_bid3', '09/18/2013', 'CSC/Pamplona', 'Bid', 1, 3, 'Strategic',\n 'Final indication of interest: all cash at $20.75 per share. Pamplona reiterated its commitment to provide 100% of the capital required; requested two-week exclusive negotiations. Response on the requested final basis.',\n 'Formal', 'Light',\n 'Stated price; response on the requested basis to a genuine final solicitation (strong formal signal 2), so Formality Formal although the document remains an indication of interest. Conditions Light: committed financing, no diligence condition attached; the two-week exclusive negotiation is read as exclusivity rather than an attached substantive diligence period (flagged in Q6). DD open: yes.',\n [('P-058', 'On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share, reiterating that Pamplona was committed to provide 100% of the capital required to consummate the transaction and requesting that CSC/Pamplona and Mac-Gray agree to engage in exclusive negotiations for two weeks.')],\n ['P-058'], ['Q5', 'Q6'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\n basis='Reported day', method='Reported', plow=20.75, phigh=20.75, pkind='Point', porigin='Stated',\n cur='USD', allcash='Yes', cashclose=20.75,\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\n related=[('cs_bid2', 'revises'), ('cs_bid4', 'revised by')]))\n\nrows.append(R('pa_reaff', '09/18/2013', 'Party A', 'Bid reaffirmed', 1, 3, 'Strategic',\n 'Reiterated by telephone that its previous $18.00\\u2013$19.00 all-cash indication was its best and final offer; no formal resubmission, price carried forward from the 09/10/2013 indication.',\n 'Formal', 'Heavy',\n 'Actual bidder confirmation that its existing offer stands, including a supported best-and-final response; price carried forward, visibly not restated. Formality Formal as a response on the requested basis to the final solicitation (signal 2; oral \\u2014 flagged). Conditions Heavy: the 09/10/2013 reported absence of a firm financing commitment was not superseded at this reaffirmation. DD open: yes.',\n [('P-058', 'Also on September 18, 2013, Party A reiterated in a telephone call to a representative of BofA Merrill Lynch that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer.')],\n ['P-058'], ['Q5', 'Q6'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\n basis='Reported day', method='Reported', plow=18.00, phigh=19.00, pkind='Bidder range',\n porigin='Carried forward', cur='USD', allcash='Yes',\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\n related=[('pa_bid2', 'reaffirms'), ('dropped_a', 'followed by')]))\n\nrows.append(R('pb_bid3', '09/18/2013', 'Party B', 'Bid', 1, 3, 'Financial',\n 'Final-round package valued by Party B at $21.50 per share: $19.00 in cash at closing plus options for the remainder representing 10% of the new equity with a strike price equal to Party B\\u2019s initial cost basis; options vest on achievement of the base-case management projections (about five years, excluding future acquisitions) and were stated by Party B to be worth $2.50 per share. Not all cash.',\n 'Formal', 'Heavy',\n 'Stated package value (bidder\\u2019s own valuation; not guaranteed cash) and structure. Formality Formal as a response on the requested basis to the final solicitation (signal 2). Conditions Heavy: third-party debt and no firm financing commitment; the Special Committee later emphasized the contingent, deferred options and performance-measurement risk. Count 1 (first submission in this round; earlier rounds counted separately).',\n [('P-058', 'On September 18, 2013, Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share, including $19.00 of cash to be paid at closing and the remaining per share price to be paid in the form of options to be issued to Mac-Gray stockholders, representing 10% of the new equity with a strike price equal to Party B\\u2019s initial cost basis.'),\n  ('P-058', 'These options, which we refer to as the Party B options, would vest on the achievement of the base case management projections (i.e., over five years), excluding any future acquisitions.'),\n  ('P-058', 'Party B\\u2019s proposal stated that it valued the Party B options at $2.50 of incremental value per share.')],\n ['P-058'], ['Q5', 'Q6', 'Q7'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\n basis='Reported day', method='Reported', plow=21.50, phigh=21.50, pkind='Point', porigin='Stated',\n cur='USD', allcash='No', cashclose=19.00,\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\n related=[('pb_bid2', 'revises')]))\n\nrows.append(R('pc_nonsub', 'by 09/18/2013', 'Party C', 'Did not submit', 1, 3, 'Financial',\n 'Did not submit a revised indication of interest or reiterate its prior $16.00\\u2013$17.00 indication at the final due date; no reasons given.',\n '', '', 'Stated non-submission (the filing reports the absence and the lack of reasons); recorded at the solicitation due date under section 8.1 rule 2. No motive or withdrawal inferred; Decided by Unknown and Exit reason Not stated.',\n [('P-058', 'Party C did not submit a revised indication of interest or reiterate its prior indication of interest of an all-cash purchase price of $16.00 to $17.00 per share nor did it specify any reasons in connection therewith.')],\n ['P-058'], ['Q4'], 1, dt='09/18/2013', wd='09/18/2013', basis='Relative only',\n method='Assigned: deadline', dby='Unknown', ereason='Not stated', obasis='Stated',\n related=[('pc_bid2', 'no submission after'), ('dl918', 'closed at deadline')]))\n\nrows.append(R('target_dec', '09/19/2013', 'Mac-Gray Special Committee', 'Target decision', 1, 3, '',\n 'Special Committee concluded CSC/Pamplona\\u2019s $20.75 proposal had the potential to deliver the most value with greater certainty (Pamplona funding, no third-party financing) than Party B\\u2019s higher-face-value package (contingent, deferred options; performance-measurement risk) and less risk than the others; concluded CSC/Pamplona should be in a position to raise above $20.75 in view of synergies, and authorized the Transaction Committee to inform CSC/Pamplona that Mac-Gray was prepared to move to exclusivity at $21.25 per share. Mr. MacDonald indicated support for $21.25.',\n '', '',\n 'Stated day; preferred-bidder/price-requirement decision (not a round opening, which is recorded separately).',\n [('P-061', 'the Special Committee concluded that the revised indication of interest submitted by CSC/Pamplona had the potential of delivering the most value to stockholders, provided greater certainty and involved less potential risk than the other indications'),\n  ('P-061', 'the Special Committee also concluded that, primarily in view of potential synergies between Mac-Gray and CSC, CSC/Pamplona should be in a position to increase their offer price above $20.75'),\n  ('P-061', 'authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share'),\n  ('P-061', 'at this meeting Mr. MacDonald indicated that he would be supportive of a price of $21.25 per share')],\n ['P-061'], ['Q1'], None, df='09/19/2013', dt='09/19/2013', wd='09/19/2013',\n basis='Reported day', method='Reported', related=[('dl918', 'follows'), ('r4', 'leads to'), ('cs_bid4', 'price requirement')]))\n\nrows.append(R('r4', '09/21/2013', 'Mac-Gray Special Committee; Transaction Committee', 'Round opened', 1, 4, '',\n 'R4 opened: the target moved to exclusive definitive negotiation with the selected bidder, CSC/Pamplona \\u2014 the Transaction Committee proposed exclusivity conditioned on a $21.25 price and CSC/Pamplona confirmed the increase as a last-and-best offer conditional on a two-week exclusive negotiation. Finality: Inferred final \\u2014 no announcement, but the target moved to definitive negotiation with the selected bidder. Alternative boundary dates considered: 09/19/2013 (selection decision) and 09/24/2013 (executed exclusivity).',\n '', '',\n 'New round because the target moved to definitive negotiation with a selected bidder; the round is bilateral (one live bidder).',\n [('P-062', 'the members of the Transaction Committee called the representative of CSC/Pamplona to propose that Mac-Gray was prepared to move forward with CSC/Pamplona on an exclusive basis for two weeks subject to CSC/Pamplona increasing their all-cash purchase price to $21.25 per share'),\n  ('P-062', 'the representative of CSC/Pamplona called the members of the Transaction Committee to confirm that CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer, provided that Mac-Gray agree to a two week period of exclusive negotiations')],\n ['P-062', 'P-061'], ['Q1'], None, df='09/21/2013', dt='09/21/2013', wd='09/21/2013',\n basis='Reported day', method='Reported', rfin='Inferred final',\n related=[('target_dec', 'follows'), ('excl_done', 'lead to')]))\n\nrows.append(R('cs_bid4', '09/21/2013', 'CSC/Pamplona', 'Bid', 1, 4, 'Strategic',\n 'Raised to $21.25 per share in all cash as a last-and-best offer, provided Mac-Gray agree to a two-week period of exclusive negotiations; also requested a customary voting agreement covering Mr. MacDonald\\u2019s and his immediate family\\u2019s shares. Together with the negotiated exclusivity terms this became the CSC/Pamplona final proposal (no financing contingency; Pamplona funding 100% of the capital needed for closing).',\n 'Formal', 'Light',\n 'Stated price and condition; price confirmation while definitive negotiation was beginning. Formality carried forward as Formal from the 09/18/2013 final-round submission (no return to a preliminary basis). Conditions Light: committed financing, no diligence condition attached (two-week exclusive negotiation read as exclusivity; flagged in Q6).',\n [('P-062', 'to confirm that CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer, provided that Mac-Gray agree to a two week period of exclusive negotiations'),\n  ('P-064', 'committing to fund 100% of the capital needed for closing, which, together with the all-cash per share purchase price of $21.25, we refer to as the CSC/Pamplona final proposal')],\n ['P-062', 'P-064', 'P-063'], ['Q5', 'Q6', 'Q7'], 1, df='09/21/2013', dt='09/21/2013',\n wd='09/21/2013', basis='Reported day', method='Reported', plow=21.25, phigh=21.25,\n pkind='Point', porigin='Stated', cur='USD', allcash='Yes', cashclose=21.25,\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\n related=[('cs_bid3', 'revises'), ('excl_done', 'terms negotiated'), ('sign', 'becomes agreement price')]))\n\nrows.append(R('excl_done', '09/24/2013', 'CSC; Pamplona; Mac-Gray', 'Exclusivity changed', 1, 4, '',\n 'Granted/executed: exclusive negotiations until 5 p.m. ET on 10/12/2013 on the CSC/Pamplona final proposal terms negotiated 09/21\\u201309/23 (no financing contingency; Pamplona committing to fund 100% of the capital needed for closing; $15 million CSC reverse termination fee; post-signing covenants); the agreement automatically terminates if CSC or Pamplona adversely change the final proposal terms. Authorized by the Special Committee on 09/23/2013.',\n '', '',\n 'Actual state: executed 09/24/2013, scheduled expiry 10/12/2013 (later extended). This execution drops rival live bidders (rows below).',\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013, subject to certain conditions, including that CSC and Pamplona not adversely change or modify the terms of the CSC/Pamplona final proposal.'),\n  ('P-066', 'the Special Committee authorized Mac-Gray to enter into an exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013 on the terms included in the CSC/Pamplona final proposal')],\n ['P-067', 'P-066', 'P-063'], ['Q2'], None, df='09/24/2013', dt='09/24/2013', wd='09/24/2013',\n basis='Reported day', method='Reported', related=[('cs_bid4', 'executed with'), ('dropped_a', 'drops rival'), ('dropped_b', 'drops rival'), ('rolex', 'extended by')]))\n\nrows.append(R('dropped_a', 'by 09/24/2013', 'Party A', 'Dropped by target', 1, 4, 'Strategic',\n 'Inferred: exclusivity \\u2014 exclusivity executed with CSC/Pamplona on 09/24/2013; Party A was still live with its standing $18.00\\u2013$19.00 all-cash best-and-final offer. Displaced from the exclusive final-negotiation stage.',\n '', '', 'Inferred row per section 10.2: a live rival when the target executed exclusivity with another bidder; no notice, reason or voluntary exit is inferred. Working date = execution date (Assigned: decision day).',\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013'),\n  ('P-058', 'Party A reiterated in a telephone call to a representative of BofA Merrill Lynch that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer')],\n ['P-067', 'P-058'], ['Q4'], 1, dt='09/24/2013', wd='09/24/2013', basis='Relative only',\n method='Assigned: decision day', dby='Target', ereason='Not stated', obasis='Inferred: exclusivity',\n related=[('pa_reaff', 'closes'), ('excl_done', 'displaces')]))\n\nrows.append(R('dropped_b', 'by 09/24/2013', 'Party B', 'Dropped by target', 1, 4, 'Financial',\n 'Inferred: exclusivity \\u2014 exclusivity executed with CSC/Pamplona on 09/24/2013; Party B was still live with its 09/18/2013 package valued by Party B at $21.50 per share. Displaced from the exclusive final-negotiation stage.',\n '', '', 'Inferred row per section 10.2: a live rival when the target executed exclusivity with another bidder; no notice, reason or voluntary exit is inferred. Working date = execution date (Assigned: decision day).',\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013'),\n  ('P-058', 'Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share')],\n ['P-067', 'P-058'], ['Q4'], 1, dt='09/24/2013', wd='09/24/2013', basis='Relative only',\n method='Assigned: decision day', dby='Target', ereason='Not stated', obasis='Inferred: exclusivity',\n related=[('pb_bid3', 'closes'), ('excl_done', 'displaces')]))\n\nrows.append(R('kirkland', 'from 09/25/2013 (first observed acting; engagement date not disclosed)', 'Kirkland & Ellis LLP',\n 'Adviser service observed', 1, 4, '',\n 'Outside legal counsel to CSC/Pamplona; first shown acting when it received Mac-Gray\\u2019s initial merger agreement draft (09/25/2013); negotiated the merger agreement and the Pamplona commitment letter through signing.',\n '', '', 'First observed service date per section 5.4; client = CSC/Pamplona; no engagement letter date disclosed.',\n [('P-068', 'On September 25, 2013, Goodwin Procter delivered to Kirkland & Ellis LLP, outside legal counsel to CSC/Pamplona, whom we refer to as Kirkland, the initial draft of the merger agreement.')],\n ['P-068'], [], None, df='09/25/2013', dt='09/25/2013', wd='09/25/2013',\n basis='Reported day', method='Reported'))\n\nrows.append(R('access2', 'between 09/25/2013 and 10/07/2013', 'CSC/Pamplona', 'Information access changed', 1, 4, '',\n 'CSC and Pamplona were granted full access to the electronic data site and access to certain members of management during the exclusive negotiations, and conducted confirmatory business and legal due diligence. The customer-data restriction applied to the strategic bidders in the 08/06\\u201308/27 stage is not shown to have continued against the exclusive bidder.',\n '', '',\n 'Late-stage expanded/catch-up access for the selected bidder; distinct from the earlier tiering. Working date = first day of the period (Assigned: bound).',\n [('P-068', 'Also during this time, CSC and Pamplona were granted full access to the electronic data site and access to certain members of management and conducted confirmatory business and legal due diligence on Mac-Gray.')],\n ['P-068'], ['Q3'], None, df='09/25/2013', dt='10/07/2013', wd='09/25/2013',\n basis='Reported interval', method='Assigned: bound', related=[('access1', 'expands earlier tiering')]))\n\nrows.append(R('moab_res', '10/07/2013', 'Moab (shareholder)', 'Material process update', 1, 4, '',\n 'Resolved: after facilitated discussions (from 09/23/2013, when Mr. Rothenberg asked to explore a rollover with CSC/Pamplona), it was determined that Moab would not roll over any Moab shares in the transaction. Moab later entered a voting agreement executed at signing.',\n '', '',\n 'Stated resolution; the 09/23/2013 facilitation is folded here under the two-row convention for rollover relationships (denial recorded separately).',\n [('P-072', 'after discussions between Moab and representatives of Pamplona, it was determined that Moab would not rollover any Moab shares in the transaction'),\n  ('P-065', 'to provide Moab with the opportunity to resume discussions with CSC/Pamplona regarding a possible equity rollover of Moab\\u2019s shares in the transaction if Moab still had an interest in such a rollover')],\n ['P-072', 'P-065'], ['Q8'], None, df='10/07/2013', dt='10/07/2013', wd='10/07/2013',\n basis='Reported day', method='Reported', related=[('moab_deny', 'resolves'), ('sign', 'voting agreement at signing')]))\n\nrows.append(R('rolex', '10/12/2013', 'CSC; Pamplona; Mac-Gray', 'Exclusivity changed', 1, 4, '',\n 'Extended to 11:59 p.m. ET on 10/15/2013 by letter agreement executed 10/12/2013. CSC/Pamplona had requested the extension on 10/09/2013 amid open issues; the Special Committee authorized extension on 10/09/2013 and on 10/11/2013 conditioned it on a Mac-Gray termination fee of not more than $11 million, agreed on 10/11/2013 (recorded on the signing row).',\n '', '', 'Actual state: executed 10/12/2013; the earlier scheduled expiry (5 p.m. ET 10/12/2013) was superseded.',\n [('P-081', 'On October 12, 2013, CSC, Pamplona and Mac-Gray executed a letter agreement extending exclusivity until 11:59 p.m. ET on October 15, 2013.'),\n  ('P-077', 'Goodwin Procter then reported that Kirkland had requested on behalf of CSC/Pamplona that the exclusivity agreement, due to expire at 5 p.m. ET on October 12, 2013, be extended to allow for continued negotiations of these open issues.')],\n ['P-081', 'P-077'], ['Q2'], None, df='10/12/2013', dt='10/12/2013', wd='10/12/2013',\n basis='Reported day', method='Reported', related=[('excl_done', 'extends'), ('sign', 'follows')]))\n\nrows.append(R('sign', '10/14/2013', 'Mac-Gray; Spin Holdco Inc. (Parent); CSC Fenway, Inc. (Merger Subsidiary); CSC ServiceWorks Holdings, Inc.; CSC ServiceWorks, Inc.',\n 'Merger agreement signed', 1, 4, '',\n 'Executed at $21.25 per share in cash (merger consideration), with no financing condition; the Pamplona commitment letter (up to $594 million; Pamplona damages liability capped at $50 million; Mac-Gray an express third-party beneficiary) was delivered; Mac-Gray termination fee $11 million and CSC reverse termination fee $15 million; End Date 03/31/2014, extendable to 07/31/2014 if antitrust clearance is the only open condition; Mr. MacDonald\\u2019s voting agreements (entered 09/27/2013) became effective and the Moab voting agreement was executed; the Special Committee and the Board approved the transaction and BofA Merrill Lynch delivered its fairness opinion the same day. Signing is not an extra submitted bid: price, formality and conditionality cells are left blank.',\n '', '',\n 'Stated execution day. Agreed consideration and commitment terms are recorded here and in Summary; post-signing competition is separately assessed (none reported as of the filing date).',\n [('P-086', 'Later in the day, on October 14, 2013, the merger agreement was executed, the Pamplona commitment letter was delivered, Moab and Parent executed the Moab voting agreement and the Mac-Donald voting agreements became effective.'),\n  ('X-010', 'The merger agreement does not contain any condition to the obligations of the Buyer Entities or Merger Subsidiary relating to the receipt of financing by the Buyer Entities.'),\n  ('X-011', 'Mac-Gray has agreed to pay Parent $11 million upon the termination of the merger agreement under certain circumstances, which we refer to as the Mac-Gray termination fee. Parent has agreed to pay Mac-Gray $15 million upon the termination of the merger agreement under certain circumstances, which we refer to as the Parent termination fee.')],\n ['P-086', 'X-010', 'X-011', 'X-030'], ['Q5'], None, df='10/14/2013', dt='10/14/2013', wd='10/14/2013',\n basis='Reported day', method='Reported', related=[('cs_bid4', 'agreed price'), ('rolex', 'follows'), ('announce', 'announced next day')]))\n\nrows.append(R('announce', '10/15/2013', 'Mac-Gray; CSC ServiceWorks, Inc.', 'Merger announced', 1, 'post', '',\n 'Mac-Gray and CSC jointly announced the execution of the merger agreement before U.S. stock markets opened. No competing proposal and no post-signing solicitation period (no go-shop; the agreement provides only a fiduciary out for unsolicited superior proposals) is reported as of the 12/04/2013 proxy statement; the HSR waiting period expired 11/27/2013; the special meeting is set for 01/08/2014 and closing is expected in January 2014. No closing is observed at the filing date.',\n '', '', 'Stated day and medium. Post-signing phase: keep last; no go-shop or competing-proposal rows are required on this record.',\n [('P-087', 'On October 15, 2013, before the U.S. stock markets opened, Mac-Gray and CSC jointly announced the execution of the merger agreement.'),\n  ('X-014', 'We currently expect the merger to be completed in January 2014.'),\n  ('X-013', 'While early termination was not granted, the waiting period expired on November 27, 2013.')],\n ['P-087', 'X-014', 'X-013'], [], None, df='10/15/2013', dt='10/15/2013', wd='10/15/2013',\n basis='Reported day', method='Reported', related=[('sign', 'announces')]))\n\n# --- verify quotes and unique keys ---\nseen = set()\nfor r in rows:\n    if r['key'] in seen:\n        raise SystemExit('duplicate key ' + r['key'])\n    seen.add(r['key'])\nbad = 0\nfor r in rows:\n    for pk, q in r['quotes']:\n        if pk not in para:\n            print('MISSING PARA', pk, 'in', r['key']); bad += 1\n        elif not check_quote(pk, q):\n            bad += 1\nprint('rows:', len(rows), 'quote problems:', bad)\n"},"output":"Created file successfully: /tmp/opencode/macgray/build_ledger.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/macgray/build_ledger.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/macgray/build_ledger.py\", \"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build mac-gray.xlsx deal ledger from DEFM14A extraction.\\\"\\\"\\\"\\nimport re, math, datetime\\nfrom bs4 import BeautifulSoup  # noqa\\nimport openpyxl\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nWORK = '/tmp/opencode/macgray'\\nBLOCKS = WORK + '/filing_blocks2.txt'\\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\\n\\n# ---------------- load source blocks ----------------\\nblocks = {}\\nfor line in open(BLOCKS, encoding='utf-8'):\\n    line = line.rstrip('\\\\n')\\n    m = re.match(r'\\\\[B(\\\\d+)\\\\|PG([^\\\\]]*)\\\\] (.*)', line)\\n    if m:\\n        blocks[m.group(1)] = {'page': m.group(2).strip(), 'text': m.group(3)}\\n\\n# background paragraph order (P-001..P-087)\\nBG = ['B0561','B0562','B0563','B0564','B0565','B0568','B0569','B0570','B0571','B0574',\\n'B0575','B0576','B0577','B0578','B0579','B0580','B0583','B0584','B0585','B0586',\\n'B0589','B0590','B0591','B0594','B0595','B0596','B0597','B0598','B0599','B0600',\\n'B0603','B0604','B0605','B0606','B0607','B0608','B0609','B0612','B0613','B0614',\\n'B0615','B0616','B0617','B0618','B0619','B0620','B0623','B0624','B0625','B0626',\\n'B0627','B0628','B0629','B0630','B0633','B0634','B0635','B0636','B0637','B0640',\\n'B0641','B0642','B0643','B0646','B0647','B0648','B0649','B0650','B0653','B0654',\\n'B0655','B0656','B0657','B0658','B0661','B0662','B0663','B0664','B0665','B0668',\\n'B0669','B0670','B0671','B0672','B0673','B0674','B0675']\\n\\n# extra passages used elsewhere (X-###): (block id, section)\\nXTRA = [\\n ('B0152','Summary Term Sheet — defined terms'),\\n ('B0162','The Merger — The Companies (Spin Holdco Inc.)'),\\n ('B0164','The Merger — The Companies (CSC Fenway, Inc.)'),\\n ('B0546','The Merger — The Companies (Mac-Gray)'),\\n ('B0548','The Merger — The Companies (CSC)'),\\n ('B0195','Summary Term Sheet — merger consideration'),\\n ('B0198','Summary Term Sheet — premium (52-week high)'),\\n ('B0200','Summary Term Sheet — premium (Oct 11, 2013 close)'),\\n ('B0169','Summary Term Sheet — record date and shares outstanding'),\\n ('B0201','Summary Term Sheet — closing price November 27, 2013'),\\n ('B0211','Summary Term Sheet — financing of the merger'),\\n ('B0212','Summary Term Sheet — Pamplona damages cap'),\\n ('B0284','Summary Term Sheet — termination fees'),\\n ('B0297','Summary Term Sheet — voting agreements percentage'),\\n ('B0299','Summary Term Sheet — regulatory matters (HSR)'),\\n ('B0320','Summary Term Sheet — expected closing'),\\n ('B0713','Reasons for the Merger — Pamplona commitment letter'),\\n ('B0719','Reasons for the Merger — process/parties engaged'),\\n ('B0721','Reasons for the Merger — highest price obtainable'),\\n ('B0867','Opinion of Mac-Gray\\\\u2019s Financial Advisor — BofA fee'),\\n ('B0881','Projected Financial Information — prepared June 2013'),\\n ('B0885','Projected Financial Information — Without Acquisitions: revenue'),\\n ('B0886','Projected Financial Information — Without Acquisitions: EBITDA'),\\n ('B0887','Projected Financial Information — Without Acquisitions: EPS'),\\n ('B0888','Projected Financial Information — Without Acquisitions: capex'),\\n ('B0899','Projected Financial Information — With Acquisitions: revenue'),\\n ('B0900','Projected Financial Information — With Acquisitions: EBITDA'),\\n ('B0901','Projected Financial Information — With Acquisitions: EPS'),\\n ('B0902','Projected Financial Information — With Acquisitions: capex'),\\n ('B0989','Financing of the Merger — commitment amount'),\\n ('B1005','The Merger Agreement — consideration'),\\n ('B2068','Merger agreement — Section 5.08 Available Funds'),\\n ('B2231','Merger agreement — Section 8.01(b) End Date'),\\n ('B0250','Summary Term Sheet — non-solicitation / fiduciary out'),\\n ('B1217','Merger agreement — Section 6.02(b) unsolicited proposals'),\\n ('B1351','The Merger Agreement — termination fee circumstances'),\\n ('B1366','The Merger Agreement — Mac-Gray termination fee payment'),\\n ('B1375','The Merger Agreement — Parent termination fee payment'),\\n ('B1395','The Voting Agreements — summary'),\\n ('B1797','Merger agreement — definition of Voting Agreements'),\\n ('B2340','Annex B — fairness opinion (opening)'),\\n]\\n\\npara = {}   # 'P-001' / 'X-001' -> dict(page, section, text, block)\\nsection_counter = {'P': 0, 'X': 0}\\nfor b in BG:\\n    k = 'P-%03d' % (section_counter['P'] + 1); section_counter['P'] += 1\\n    para[k] = {'page': blocks[b]['page'], 'section': 'Background of the Merger',\\n               'text': blocks[b]['text'], 'block': b}\\nfor b, sec in XTRA:\\n    k = 'X-%03d' % (section_counter['X'] + 1); section_counter['X'] += 1\\n    para[k] = {'page': blocks[b]['page'], 'section': sec, 'text': blocks[b]['text'], 'block': b}\\n\\n# ---------------- quote checker ----------------\\ndef nrm(s):\\n    s = s.replace('\\\\u2019', \\\"'\\\").replace('\\\\u2018', \\\"'\\\").replace('\\\\u201c', '\\\"').replace('\\\\u201d', '\\\"')\\n    s = s.replace('\\\\u2013', '-').replace('\\\\u2014', '--').replace('\\\\u2011', '-').replace('\\\\xa0', ' ')\\n    s = re.sub(r'\\\\s+', ' ', s)\\n    return s.strip()\\n\\ndef check_quote(pk, q):\\n    t = nrm(para[pk]['text']); qq = nrm(q)\\n    if qq not in t:\\n        print('QUOTE FAIL [%s]: %s' % (pk, q[:90]))\\n        return False\\n    return True\\n\\n# ---------------- ledger rows ----------------\\n# helper to reduce typing\\ndef R(key, when, who, what, process, rnd, typ, terms, formality, clevel, reason, quotes,\\n      source, review, count, df=None, dt=None, wd=None, basis=None, method=None,\\n      plow=None, phigh=None, pkind=None, porigin=None, cur=None, allcash=None, cashclose=None,\\n      cdetail=None, due=None, dtreat=None, rfin=None, dby=None, ereason=None, obasis=None,\\n      related=None, include='Yes'):\\n    return dict(key=key, when=when, who=who, what=what, process=process, rnd=rnd, typ=typ,\\n                terms=terms, formality=formality, clevel=clevel, reason=reason, quotes=quotes,\\n                source=source, review=review, count=count, df=df, dt=dt, wd=wd, basis=basis,\\n                method=method, plow=plow, phigh=phigh, pkind=pkind, porigin=porigin, cur=cur,\\n                allcash=allcash, cashclose=cashclose, cdetail=cdetail, due=due, dtreat=dtreat,\\n                rfin=rfin, dby=dby, ereason=ereason, obasis=obasis, related=related or [],\\n                include=include)\\n\\nrows = []\\n\\nrows.append(R('ctx2011', 'Winter 2011 into early 2012 (month/day not disclosed)', 'Mac-Gray; CSC',\\n 'Material process update', 1, 0, '',\\n 'Pre-opening context: Mac-Gray and CSC discussed CSC\\\\u2019s possible acquisition by Mac-Gray (the 2011-2012 Discussions) \\\\u2014 a reverse-direction exploration, not a sale of Mac-Gray; CSC was later sold to Pamplona in May 2013. Kept to explain the BofA Merrill Lynch mandate history.',\\n '', '', 'Context only: the filing records an earlier attempt in the opposite direction (Mac-Gray as potential acquirer of CSC), which is not one of the target\\\\u2019s sale attempts. Working date is a convention for the winter 2011\\\\u2013early 2012 window.',\\n [('P-002', 'including discussions between Mac-Gray and CSC in the winter of 2011 and into 2012 regarding the possible acquisition of CSC by Mac-Gray'),\\n  ('P-002', 'During the fall and winter of 2012, CSC engaged in a sale process and, ultimately, CSC was purchased by Pamplona in May 2013.')],\\n ['P-002'], ['Q1'], None, df='12/01/2011', dt='03/31/2012', wd='01/15/2012',\\n basis='Approximate window', method='Assigned: midpoint', related=[('bofa2012', 'related')]))\\n\\nrows.append(R('bofa2012', '10/23/2012', 'BofA Merrill Lynch', 'Adviser engaged', 1, 0, '',\\n 'BofA Merrill Lynch engaged by Mac-Gray in connection with the 2011-2012 Discussions (Mac-Gray\\\\u2019s possible acquisition of CSC).',\\n '', '', 'Stated engagement date; client = Mac-Gray; mandate concerned the earlier reverse-direction exploration (no process number of its own).',\\n [('P-002', 'Mac-Gray engaged BofA Merrill Lynch on October 23, 2012')],\\n ['P-002'], [], None, df='10/23/2012', dt='10/23/2012', wd='10/23/2012',\\n basis='Reported day', method='Reported', related=[('ctx2011', 'related'), ('bofaend', 'related')]))\\n\\nrows.append(R('apr5', '04/05/2013', 'Mac-Gray Board of Directors', 'Target decision', 1, 0, '',\\n 'Board discussed CSC\\\\u2019s sale to Pamplona and industry-wide M&A, and authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities, including with Party A (another strategic party in the laundry facilities management industry); alternatives review to continue at the scheduled May 9, 2013 meeting.',\\n '', '', 'Stated day; initiation step authorizing exploration, not yet an irrevocable sale decision.',\\n [('P-003', 'authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities that might be available to Mac-Gray, including opportunities with another strategic party, whom we refer to as Party A, in the laundry facilities management industry')],\\n ['P-003'], [], None, df='04/05/2013', dt='04/05/2013', wd='04/05/2013',\\n basis='Reported day', method='Reported', related=[('pa_contact', 'related')]))\\n\\nrows.append(R('pa_contact', '04/08/2013', 'Party A', 'Target interest', 1, 0, 'Strategic',\\n 'First sale-related contact (outbound): BofA Merrill Lynch, instructed by the Board, telephoned Party A to discuss a possible business combination; Party A indicated it might consider one. First-contact fact carried here; no duplicate Contact row.',\\n '', '', 'Stated day and direction (Mac-Gray side telephoned). Party A treated as Strategic \\\\u2014 an industry participant identified at initiation and later grouped with CSC/Pamplona as the two strategic bidders.',\\n [('P-004', 'representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray'),\\n  ('P-004', 'the representative of Party A indicated that Party A might consider a business combination with Mac-Gray')],\\n ['P-004', 'P-025'], ['Q1'], 1, df='04/08/2013', dt='04/08/2013', wd='04/08/2013',\\n basis='Reported day', method='Reported', related=[('apr5', 'follows'), ('pa_bid', 'followed by')]))\\n\\nrows.append(R('goodwin', 'from 05/09/2013 (first observed acting on the mandate)', 'Goodwin Procter LLP',\\n 'Adviser service observed', 1, 0, '',\\n 'Mac-Gray\\\\u2019s outside legal counsel; first shown acting on the strategic-alternatives/sale mandate at the May 9, 2013 Board meeting; continued through exclusivity, the merger agreement, the Pamplona commitment letter and signing. Engagement date and terms not disclosed.',\\n '', '', 'First-mention date used as the Working date by convention; the filing shows service rather than a dated engagement (no engagement letter or start date is reported).',\\n [('P-005', 'representatives from BofA Merrill Lynch and Goodwin Procter LLP, outside legal counsel to Mac-Gray, were also in attendance')],\\n ['P-005'], [], None, df='05/09/2013', dt='05/09/2013', wd='05/09/2013',\\n basis='Reported day', method='Reported'))\\n\\nrows.append(R('bofaend', '05/15/2013 (Transaction Committee decision 05/14/2013)', 'BofA Merrill Lynch',\\n 'Adviser ended', 1, 0, '',\\n 'Engagement letter for the 2011-2012 Discussions terminated. The Transaction Committee determined on 05/14/2013 to terminate it because BofA Merrill Lynch was a candidate for the new strategic-alternatives mandate and the CSC sale process had ended; Mac-Gray sent the termination letter on 05/15/2013.',\\n '', '', 'Stated dates; termination of the earlier mandate (not an end to the relationship \\\\u2014 re-engagement followed, see Adviser engaged 05/31/2013).',\\n [('P-010', 'the Transaction Committee determined to terminate BofA Merrill Lynch\\\\u2019s engagement letter entered into for purposes of the 2011-2012 Discussions'),\\n  ('P-011', 'On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions.')],\\n ['P-011', 'P-010'], [], None, df='05/15/2013', dt='05/15/2013', wd='05/15/2013',\\n basis='Reported day', method='Reported', related=[('bofa2012', 'ends'), ('bofa2013', 'followed by')]))\\n\\nrows.append(R('bofa2013', '05/31/2013 (Board approval 05/30/2013; selection process from 05/10/2013)', 'BofA Merrill Lynch',\\n 'Adviser engaged', 1, 0, '',\\n 'Engaged for the Board\\\\u2019s review of strategic alternatives, including a potential sale process; agreed not to engage as a possible source of new acquisition financing for any potential buyers without Mac-Gray\\\\u2019s prior written consent. The Board approved the engagement on 05/30/2013 after interviews of three banks, and the engagement letter was entered on 05/31/2013.',\\n '', '', 'Stated dates; the no-buyer-financing restriction is recorded because it bears on how buyer financing could be arranged.',\\n [('P-017', 'On May 31, 2013, Mac-Gray entered into an engagement letter with BofA Merrill Lynch with respect to the Board\\\\u2019s undertaking a review of strategic alternatives, including a potential sale process, and in which BofA Merrill Lynch agreed not to engage as a possible source of new acquisition financing for any potential buyers in connection with any such sale process without Mac-Gray\\\\u2019s prior written consent.')],\\n ['P-017'], ['Q1'], None, df='05/31/2013', dt='05/31/2013', wd='05/31/2013',\\n basis='Reported day', method='Reported', related=[('bofaend', 'follows')]))\\n\\nrows.append(R('pa_bid', '06/21/2013', 'Party A', 'Bid', 1, 0, 'Strategic',\\n 'Unsolicited pre-NDA proposal to purchase Mac-Gray for $17.00\\\\u2013$19.00 per share in all cash (Party A June 21 proposal); made before any diligence access. Considered by the Special Committee alongside the preliminary indications at the 07/25/2013 meeting. Price range preserved; no retrospective upgrade.',\\n 'Informal', 'Heavy',\\n 'Stated price and whole-company scope. Formality: preliminary unsolicited proposal with no supported formal signal (no returned markups or final-solicitation response) \\\\u2014 Informal. Conditions: Heavy by context because the proposal preceded substantive diligence access. DD open: no access yet. Count 1 (Party A\\\\u2019s first bid unit); the proposal was still standing when Round 1 was evaluated, so the round map shows Party A as a round-1 participant although this row sits in round 0.',\\n [('P-019', 'On June 21, 2013, Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share'),\\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal, in each case from a financial point of view')],\\n ['P-019', 'P-036'], ['Q1', 'Q6'], 1, df='06/21/2013', dt='06/21/2013', wd='06/21/2013',\\n basis='Reported day', method='Reported', plow=17.00, phigh=19.00, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes', cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n related=[('pa_contact', 'follows'), ('pa_nda', 'followed by'), ('pa_bid2', 'revises'), ('r1', 'standing at round 1')]))\\n\\nrows.append(R('exclu', '06/24/2013', 'Mac-Gray Board of Directors / Special Committee', 'Target decision', 1, 0, '',\\n 'Board excluded CEO Stewart G. MacDonald, Jr. (potential rollover conflict; the Transaction Committee had recommended exclusion on 05/10/2013) and Moab\\\\u2019s Michael Rothenberg (~9% holder; possible Moab rollover) from the evaluation of strategic alternatives and negotiations with third parties, and established the six-member Special Committee (Bullock, chair; Daoust, Hyman, Meagher, Percelay, Robinson), with the Transaction Committee as administrative sub-committee. Mr. Rothenberg was later asked to recuse himself from Board meetings for the duration of the process (07/25/2013).',\\n '', '', 'Stated day; governance step material to process design and to the Moab/MacDonald rollover treatments in this ledger.',\\n [('P-020', 'the Board decided, and Mr. MacDonald and Mr. Rothenberg agreed, that it would be appropriate to exclude Mr. MacDonald and Mr. Rothenberg from the Board\\\\u2019s evaluation of strategic alternatives and any negotiations with third parties that might take place'),\\n  ('P-018', 'At the time of this meeting, Moab beneficially owned approximately 9% of Mac-Gray\\\\u2019s outstanding common stock.'),\\n  ('P-036', 'decided that Mr. Rothenberg should be asked to recuse himself from participating in Board meetings for the duration of the sale process')],\\n ['P-020', 'P-018', 'P-036'], ['Q1', 'Q8'], None, df='06/24/2013', dt='06/24/2013', wd='06/24/2013',\\n basis='Reported day', method='Reported', related=[('r1', 'precedes'), ('moab_deny', 'related'), ('macdecl', 'related'), ('moab_res', 'related')]))\\n\\nrows.append(R('r1', '06/24/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 1, '',\\n 'R1 anchor: the 06/24/2013 Special Committee conclusion to consider a sale of Mac-Gray and approach 50 parties (15 strategic, 35 financial), including CSC/Pamplona and Party A; BofA Merrill Lynch outreach followed within days (06/28/2013 update) and informational packages instructed preliminary indications of interest by 07/23/2013. Rejected anchor candidates: '\\n '10/23/2012 BofA engagement, 04/08/2013 Party A contact and 06/21/2013 Party A proposal (all retained as their own rows); the first outreach wave has no single disclosed date. Finality: Not final \\\\u2014 no finality announcement; the process continued to staged diligence and revised indications.',\\n '', '',\\n 'Round 1 opens on the decision that launched solicitation (outreach as its direct execution beginning within about a week); due date carried on this row as the deadline set with the solicitation, per section 8.3. Participant scope: the 50 approached parties, of which 20 signed confidentiality agreements (see the NDA cohort and individual rows).',\\n [('P-022', 'the Special Committee concluded that it would be in the best interests of stockholders to consider a potential sale of Mac-Gray'),\\n  ('P-023', 'Guided by the foregoing principles, the Special Committee determined to approach a total of'),\\n  ('P-024', '50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray, 15 of which were potential strategic buyers and 35 of which were potential financial buyers, including private equity firms.'),\\n  ('P-025', 'Parties that had entered into confidentiality and standstill agreements with Mac-Gray were furnished an informational package for the purpose of providing potential bidders with data to formulate a preliminary indication of interest, which they were instructed to submit by July 23, 2013.')],\\n ['P-022', 'P-024', 'P-023', 'P-025'], ['Q1', 'Q2'], None, df='06/24/2013', dt='06/24/2013', wd='06/24/2013',\\n basis='Reported day', method='Reported', due='07/23/2013', rfin='Not final',\\n related=[('exclu', 'follows'), ('pa_bid', 'anchor candidate, rejected'), ('bofa2012', 'anchor candidate, rejected'), ('pa_contact', 'anchor candidate, rejected'), ('nda_res', 'admits population')]))\\n\\nrows.append(R('nda_res', 'between 06/24/2013 and 08/24/2013 (over the next two months; individual dates not disclosed)',\\n '16 financial confidentiality-agreement signers (residual cohort)', 'NDA signed', 1, 1, 'Financial',\\n 'Residual cohort: 20 reported confidentiality and standstill signers less the four individually recorded signers (Party A, Party B, Party C, CSC/Pamplona) = 16 remaining financial signers. Form individually negotiated but not materially varied; standstill with a sunset allowing confidential proposals upon an announced business combination.',\\n '', '',\\n 'Reported total and composition (2 strategic, 18 financial) with individual details for four signers; the residual cohort is disjoint by construction. Working date is the first day of the two-month signing window (Assigned: bound); exact dates not disclosed.',\\n [('P-025', 'Over the next two months a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray on a form provided by Mac-Gray, the terms of which were individually negotiated with potential bidders, but did not vary materially from the form provided.'),\\n  ('P-025', 'The confidentiality agreements contained customary non-disclosure provisions and a customary standstill provision that either expired or permitted the potential bidder to make confidential proposals to Mac-Gray (a so-called \\\"sunset\\\" provision) upon announcement of a business combination between Mac-Gray and a third party')],\\n ['P-025'], ['Q3'], 16, df='06/24/2013', dt='08/24/2013', wd='06/24/2013',\\n basis='Approximate window', method='Assigned: bound', related=[('r1', 'admits cohort'), ('pb_nda', 'named signer excluded from residual'), ('pc_nda', 'named signer excluded from residual'), ('cs_nda', 'named signer excluded from residual'), ('pa_nda', 'named signer excluded from residual')]))\\n\\nrows.append(R('cs_contact', 'by 06/28/2013 (first reported contact; exact date not disclosed)', 'CSC/Pamplona', 'Contact', 1, 1, 'Strategic',\\n 'BofA Merrill Lynch had spoken with Pamplona, which expressed interest in a transaction including an acquisition of Mac-Gray by its portfolio company, CSC; Pamplona said business and legal due diligence would be minimal given its familiarity with Mac-Gray and the industry.',\\n '', '',\\n 'First sale-related contact reported on 06/28/2013; earlier bound not disclosed, so Working date = the bound (Assigned: bound). Direction: target-side outreach. Type Strategic (CSC is an operating laundry-services company; sponsor-owned \\\\u2014 acquisition through a sponsor-owned operating company, not a financial role).',\\n [('P-026', 'BofA Merrill Lynch also reported that they had spoken with representatives of Pamplona, as instructed by the Special Committee, who expressed interest in a transaction, including an acquisition of Mac-Gray by its portfolio company, CSC.'),\\n  ('P-026', 'Pamplona emphasized that business and legal due diligence would be minimal given its familiarity with Mac-Gray and the industry generally.')],\\n ['P-026'], ['Q3'], 1, dt='06/28/2013', wd='06/28/2013', basis='Relative only', method='Assigned: bound',\\n related=[('cs_nda', 'followed by'), ('r1', 'outreach under round 1')]))\\n\\nrows.append(R('pb_nda', '06/28/2013', 'Party B', 'NDA signed', 1, 1, 'Financial',\\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\\n '', '', 'Stated execution day; entry gate for a financial bidder.',\\n [('P-027', 'Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party B with data to formulate a preliminary indication of interest.')],\\n ['P-027'], ['Q3'], 1, df='06/28/2013', dt='06/28/2013', wd='06/28/2013',\\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pb_bid1', 'followed by')]))\\n\\nrows.append(R('pc_nda', '06/30/2013', 'Party C', 'NDA signed', 1, 1, 'Financial',\\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\\n '', '', 'Stated execution day; entry gate for a financial bidder.',\\n [('P-028', 'On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party C with data to formulate a preliminary indication of interest.')],\\n ['P-028'], ['Q3'], 1, df='06/30/2013', dt='06/30/2013', wd='06/30/2013',\\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pc_bid1', 'followed by')]))\\n\\nrows.append(R('moab_deny', '07/06/2013', 'Moab (shareholder)', 'Material process update', 1, 1, '',\\n 'Special Committee denied Moab\\\\u2019s request to partner exclusively with CSC/Pamplona at this stage, so the potential equity rollover of Moab\\\\u2019s shares could remain available as a source of capital for other bidders; Moab was told the discussions were premature but would be permitted at a later stage of the sale process.',\\n '', '',\\n 'Stated day; one permitted/denied row for the Moab rollover relationship (its resolution is recorded separately when the discussions concluded).',\\n [('P-031', 'the Special Committee decided to deny the exclusivity request at this stage of the process so that the potential equity rollover of Moab\\\\u2019s shares could be available as a source of capital for other potential bidders'),\\n  ('P-031', 'it was premature for Mac-Gray to permit Moab to engage in equity rollover discussions with any party, including CSC/Pamplona, but that such discussions would be permitted at a later stage of the sale process')],\\n ['P-031'], ['Q8'], None, df='07/06/2013', dt='07/06/2013', wd='07/06/2013',\\n basis='Reported day', method='Reported', related=[('exclu', 'related'), ('moab_res', 'resolved later')]))\\n\\nrows.append(R('cs_nda', '07/11/2013', 'CSC/Pamplona', 'NDA signed', 1, 1, 'Strategic',\\n 'Confidentiality and standstill agreement executed; informational package furnished for a preliminary indication of interest (requested by 07/23/2013).',\\n '', '', 'Stated execution day; entry gate for the strategic unit.',\\n [('P-032', 'On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package for the purpose of providing CSC/Pamplona with data to formulate a preliminary indication of interest.')],\\n ['P-032'], ['Q3'], 1, df='07/11/2013', dt='07/11/2013', wd='07/11/2013',\\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('cs_bid1', 'followed by')]))\\n\\nrows.append(R('dl723', '07/23/2013 (preliminary IOI due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 1, '',\\n 'Scheduled due date for preliminary indications of interest. CSC/Pamplona submitted on the date; Party B and Party C submitted on 07/24/2013 and were considered at the 07/25/2013 Special Committee meeting \\\\u2014 late bids accepted; the date was not revised.',\\n '', '',\\n 'Treatment from what followed in the same round: submissions dated after the due date were considered without any revision \\\\u2014 Late bids accepted.',\\n [('P-025', 'which they were instructed to submit by July 23, 2013'),\\n  ('P-035', 'On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share.'),\\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal')],\\n ['P-025', 'P-035', 'P-036'], ['Q2'], None, df='07/23/2013', dt='07/23/2013', wd='07/23/2013',\\n basis='Reported day', method='Reported', due='07/23/2013', dtreat='Late bids accepted'))\\n\\nrows.append(R('cs_bid1', '07/23/2013', 'CSC/Pamplona', 'Bid', 1, 1, 'Strategic',\\n 'Preliminary indication of interest: all cash at $18.50 per share. Made after only the informational package; no substantive diligence access yet.',\\n 'Informal', 'Heavy',\\n 'Stated price. Formality: preliminary indication before diligence with no supported formal signal \\\\u2014 Informal. Conditions: Heavy by context because the indication preceded substantive diligence access (data-room or management access), whatever diligence wording it used; Pamplona\\\\u2019s stated familiarity did not remove that context.',\\n [('P-034', 'On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share.')],\\n ['P-034'], ['Q6'], 1, df='07/23/2013', dt='07/23/2013', wd='07/23/2013',\\n basis='Reported day', method='Reported', plow=18.50, phigh=18.50, pkind='Point', porigin='Stated',\\n cur='USD', allcash='Yes', cashclose=18.50,\\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n related=[('cs_nda', 'follows'), ('cs_bid2', 'revises')]))\\n\\nrows.append(R('nonsub1', 'by 07/23/2013', '16 financial confidentiality-agreement signers (residual cohort)', 'Did not submit', 1, 1, 'Financial',\\n 'Inferred: residual \\\\u2014 20 confidentiality agreement signers \\\\u2212 4 bidders the filing accounts for at this transition (CSC/Pamplona, Party B and Party C, whose preliminary indications were reviewed on 07/25/2013, and Party A, whose June 21 proposal was reviewed while it negotiated its NDA) = 16 non-submitters. Base assumes the four named continuing bidders are the complete set; if unnamed signers also submitted, this overstates the residual.',\\n '', '',\\n 'Inferred: residual with the arithmetic shown; no decision dates, motives, identities or voluntary withdrawals inferred. Working date = the solicitation\\\\u2019s due date (Assigned: deadline).',\\n [('P-025', 'a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray'),\\n  ('P-036', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal, in each case from a financial point of view'),\\n  ('P-038', 'to reach out to each of the four interested bidders and arrange management meetings')],\\n ['P-025', 'P-036', 'P-038'], ['Q3', 'Q4'], 16, dt='07/23/2013', wd='07/23/2013',\\n basis='Relative only', method='Assigned: deadline', dby='Unknown', ereason='Not stated',\\n obasis='Inferred: residual', related=[('nda_res', 'closes part of cohort'), ('pa_bid', 'accounted at transition'), ('cs_bid1', 'accounted at transition'), ('pb_bid1', 'accounted at transition'), ('pc_bid1', 'accounted at transition')]))\\n\\nrows.append(R('pb_bid1', '07/24/2013', 'Party B', 'Bid', 1, 1, 'Financial',\\n 'Preliminary indication of interest: all cash at $17.00\\\\u2013$18.00 per share. Submitted one day after the 07/23/2013 request; considered by the Special Committee on 07/25/2013 (late bids accepted). Made before substantive diligence access.',\\n 'Informal', 'Heavy',\\n 'Stated range and timing. Formality Informal (preliminary indication; no formal signal). Conditions Heavy by context (pre-diligence indication). DD open: no; no firm financing information reported at this stage.',\\n [('P-035', 'On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share.')],\\n ['P-035', 'P-036'], ['Q6'], 1, df='07/24/2013', dt='07/24/2013', wd='07/24/2013',\\n basis='Reported day', method='Reported', plow=17.00, phigh=18.00, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes',\\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n related=[('pb_nda', 'follows'), ('pb_bid2', 'revises')]))\\n\\nrows.append(R('pc_bid1', '07/24/2013', 'Party C', 'Bid', 1, 1, 'Financial',\\n 'Oral preliminary indication of interest: all cash at $15.00\\\\u2013$17.00 per share, presented by telephone to BofA Merrill Lynch; considered on 07/25/2013 (late bids accepted).',\\n 'Informal', 'Heavy',\\n 'Stated range, oral form and timing. Formality Informal (preliminary indication before diligence). Conditions Heavy by context (pre-diligence indication).',\\n [('P-035', 'representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share')],\\n ['P-035', 'P-036'], ['Q6'], 1, df='07/24/2013', dt='07/24/2013', wd='07/24/2013',\\n basis='Reported day', method='Reported', plow=15.00, phigh=17.00, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes',\\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n related=[('pc_nda', 'follows'), ('pc_bid1w', 'superseded by written version')]))\\n\\nrows.append(R('pc_bid1w', '07/25/2013', 'Party C', 'Bid', 1, 1, 'Financial',\\n 'Same preliminary indication put in writing at a narrowed $16.00\\\\u2013$16.50 per share; the written version revises the oral range given the previous day.',\\n 'Informal', 'Heavy',\\n 'Stated range and written form. Count 0 because this is the same bidder unit\\\\u2019s preliminary indication already counted earlier in Round 1 (repeated/revised description); formality and conditions unchanged from the oral indication.',\\n [('P-039', 'Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share.')],\\n ['P-039'], ['Q6'], 0, df='07/25/2013', dt='07/25/2013', wd='07/25/2013',\\n basis='Reported day', method='Reported', plow=16.00, phigh=16.50, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes',\\n cdetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n related=[('pc_bid1', 'revises (written version of same indication)')]))\\n\\nrows.append(R('r2', '07/25/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 2, '',\\n 'R2 opened: after reviewing the preliminary indications (all lower than expected), the Special Committee selected the four interested bidders for the second stage \\\\u2014 management presentations and staged data-site access \\\\u2014 and authorized BofA Merrill Lynch to proceed with the staged disclosure and to request revised indications of interest. Party A\\\\u2019s management meeting was conditional on its agreeing a confidentiality agreement. Revised written proposals were requested on 08/27/2013 with a 09/09/2013 due date (see deadline rows). Finality: Not final \\\\u2014 no finality announcement; the round continued to a final-indication stage.',\\n '', '',\\n 'Round boundary from selection of advancing participants plus a distinct information stage linked to new offers. Uniform access (presentations to all four) is recorded on this row; differentiated access is its own Information access changed row. Mr. Rothenberg\\\\u2019s duration recusal belongs to the exclusion row.',\\n [('P-037', 'the Special Committee concluded that it would be advisable to stage the disclosure of such information to each of the bidders to the extent that a bidder\\\\u2019s indication of interest and other actions demonstrated its seriousness in acquiring Mac-Gray on terms viewed favorably by the Special Committee'),\\n  ('P-038', 'the Special Committee authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure as discussed at this meeting and to reach out to each of the four interested bidders and arrange management meetings'),\\n  ('P-038', 'and to then request that each of these parties submit a revised indication of interest')],\\n ['P-037', 'P-038'], ['Q1'], None, df='07/25/2013', dt='07/25/2013', wd='07/25/2013',\\n basis='Reported day', method='Reported', rfin='Not final',\\n related=[('r1', 'follows'), ('access1', 'opens staged access'), ('dl909', 'requests revised proposals')]))\\n\\nrows.append(R('pa_nda', '08/05/2013', 'Party A', 'NDA signed', 1, 1, 'Strategic',\\n 'Confidentiality and standstill agreement executed after negotiations paused over the customer and employee non-solicitation provisions; informational package furnished to enable improvement of the June 21 proposal. Last of the four bidder NDAs.',\\n '', '',\\n 'Stated execution day. Source typo retained: Discussions with Party A resumed on July 27, 2103 (read 07/27/2013); the filing places the resumed negotiations between 07/11/2013 and 07/23/2013.',\\n [('P-040', 'Discussions with Party A resumed on July 27, 2103 and Party A and the Transaction Committee agreed to the terms of the customer and employee non-solicitation provisions.'),\\n  ('P-040', 'On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party A with data to potentially improve the terms of the Party A June 21 proposal.')],\\n ['P-040', 'P-033'], ['Q3', 'Q8'], 1, df='08/05/2013', dt='08/05/2013', wd='08/05/2013',\\n basis='Reported day', method='Reported', related=[('nda_res', 'counted within/reported separately'), ('pa_bid2', 'followed by')]))\\n\\nrows.append(R('access1', 'between 08/06/2013 and 08/27/2013', 'Party A and CSC/Pamplona (limited) vs. Party B and Party C (broad)', 'Information access changed', 1, 2, '',\\n 'Tiered access during the August 6\\\\u201327 diligence: Party B and Party C (financial bidders) were given broad access to the electronic data site while Party A and CSC/Pamplona (strategic bidders) were given somewhat limited access, with customer data including customer locations reserved until later in the process. Management presentations were given to all four (Party B 08/06, Party C 08/08, CSC/Pamplona 08/12, Party A 08/14), and Party A and CSC/Pamplona had synergy discussions with management.',\\n '', '',\\n 'Stated interval, recipients, withholding and rationale (staging decided at the 07/25/2013 meeting). Access given alike to all four is recorded on the Round 2 row; this row records the differentiation. Working date = first day of the period (Assigned: bound).',\\n [('P-046', 'During this time, Party B and Party C, in light of the fact that they were financial bidders, were given broad access to an electronic data site, and Party A and CSC/Pamplona, in light of the fact that they were strategic bidders, were given somewhat limited access to this electronic data site, with access to customer data, including customer locations, being reserved until later in the process as part of the staging discussed at the July 25th Special Committee meeting.')],\\n ['P-046', 'P-041', 'P-042', 'P-043', 'P-044'], ['Q3'], None, df='08/06/2013', dt='08/27/2013',\\n wd='08/06/2013', basis='Reported interval', method='Assigned: bound', related=[('r2', 'implements staged access'), ('access2', 'later full access to winner')]))\\n\\nrows.append(R('dl909set', '08/27/2013', 'Mac-Gray (via BofA Merrill Lynch)', 'Deadline set', 1, 2, '',\\n 'BofA Merrill Lynch, as instructed (authorization 08/15/2013), sent letters to Party A, Party B, Party C and CSC/Pamplona instructing revised written proposals no later than 09/09/2013 to continue in the process toward in-depth confirmatory diligence; proposals to address valuation, financing sources and structures, regulatory approvals, post-signing covenants and diligence focus areas.',\\n '', '', 'Stated communication date; new bid-submission due date for Round 2 (09/09/2013).',\\n [('P-047', 'sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013'),\\n  ('P-045', 'the Special Committee authorized and instructed BofA Merrill Lynch to send a letter to each of Party A, Party B, Party C and CSC/Pamplona once all four of the bidders\\\\u2019 due diligence was substantially complete requesting that, in light of the results of the respective party\\\\u2019s due diligence, such party submit a revised written proposal in order to continue in the process')],\\n ['P-047', 'P-045'], ['Q2'], None, df='08/27/2013', dt='08/27/2013', wd='08/27/2013',\\n basis='Reported day', method='Reported', due='09/09/2013', related=[('r2', 'follows'), ('dl909', 'sets')]))\\n\\nrows.append(R('dl909', '09/09/2013 (revised-proposal due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 2, '',\\n 'Scheduled due date for revised written proposals. CSC/Pamplona and Party B submitted on the date; Party A and Party C submitted on 09/10/2013 and were considered at the 09/11/2013 Special Committee meeting \\\\u2014 late bids accepted; the date was not revised.',\\n '', '',\\n 'Treatment from what followed in the same round: submissions dated after the due date were considered without revision \\\\u2014 Late bids accepted.',\\n [('P-047', 'submit revised written proposals no later than September 9, 2013'),\\n  ('P-052', 'On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share'),\\n  ('P-054', 'the Special Committee held a telephonic meeting to review the revised indications of interest submitted by Party A, Party B, Party C and CSC/Pamplona')],\\n ['P-047', 'P-052', 'P-054'], ['Q2'], None, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\\n basis='Reported day', method='Reported', due='09/09/2013', dtreat='Late bids accepted'))\\n\\nrows.append(R('cs_bid2', '09/09/2013', 'CSC/Pamplona', 'Bid', 1, 2, 'Strategic',\\n 'Revised indication of interest: all cash at $19.50 per share. Pamplona committed to provide 100% of the capital required to consummate the transaction; requested two-week exclusive negotiations. No third-party financing needed.',\\n 'Informal', 'Light',\\n 'Stated price and commitment. Formality Informal: a revised indication submitted to continue in the process, not a response to a final solicitation; no markup or other formal signal. Conditions Light: committed financing with no diligence condition attached (the two-week exclusive negotiation is treated as an exclusivity request, not an attached substantive diligence period \\\\u2014 flagged in Q6). DD open: yes (continuing diligence).',\\n [('P-051', 'On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share, indicating that Pamplona was committed to provide 100% of the capital required to consummate the transaction and requesting that CSC/Pamplona and Mac-Gray agree to exclusive negotiations for two weeks.')],\\n ['P-051'], ['Q5', 'Q6'], 1, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\\n basis='Reported day', method='Reported', plow=19.50, phigh=19.50, pkind='Point', porigin='Stated',\\n cur='USD', allcash='Yes', cashclose=19.50,\\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\\n related=[('cs_bid1', 'revises'), ('cs_bid3', 'revised by')]))\\n\\nrows.append(R('pb_bid2', '09/09/2013', 'Party B', 'Bid', 1, 2, 'Financial',\\n 'Revised indication of interest: all cash at $18.50 per share; proposed financing from a combination of equity from affiliated funds and third-party debt. No firm financing commitment.',\\n 'Informal', 'Heavy',\\n 'Stated price, financing plan and absence of a firm commitment. Formality Informal (revised indication in the continuing process). Conditions Heavy: reported absence of committed financing; third-party debt dependence later emphasized by the Special Committee.',\\n [('P-051', 'On September 9, 2013, Party B also submitted a revised indication of interest with an all-cash purchase price of $18.50 per share and proposed to finance the transaction with a combination of equity from affiliated funds and third party debt. Party B\\\\u2019s revised indication of interest did not include a firm financing commitment.')],\\n ['P-051'], ['Q6'], 1, df='09/09/2013', dt='09/09/2013', wd='09/09/2013',\\n basis='Reported day', method='Reported', plow=18.50, phigh=18.50, pkind='Point', porigin='Stated',\\n cur='USD', allcash='Yes', cashclose=18.50,\\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\\n related=[('pb_bid1', 'revises'), ('pb_bid3', 'revised by')]))\\n\\nrows.append(R('pa_bid2', '09/10/2013', 'Party A', 'Bid', 1, 2, 'Strategic',\\n 'Revised indication of interest: all cash at $18.00\\\\u2013$19.00 per share, to be financed from outstanding credit facilities or affiliated equity sources; no firm financing commitment. Submitted one day after the 09/09/2013 due date and considered on 09/11/2013 (late bids accepted).',\\n 'Informal', 'Heavy',\\n 'Stated range and financing sources; reported absence of a firm commitment. Formality Informal (continuing-process revision). Conditions Heavy (no committed financing). DD open: yes.',\\n [('P-052', 'On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share, to be financed by outstanding credit facilities or affiliated equity sources.'),\\n  ('P-052', 'Neither Party A\\\\u2019s nor Party C\\\\u2019s revised indication of interest included a firm financing commitment.')],\\n ['P-052', 'P-054'], ['Q6'], 1, df='09/10/2013', dt='09/10/2013', wd='09/10/2013',\\n basis='Reported day', method='Reported', plow=18.00, phigh=19.00, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes',\\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\\n related=[('pa_bid', 'revises (previous indication retained)'), ('pa_reaff', 'reaffirmed later')]))\\n\\nrows.append(R('pc_bid2', '09/10/2013', 'Party C', 'Bid', 1, 2, 'Financial',\\n 'Revised oral indication of interest: all cash at $16.00\\\\u2013$17.00 per share, by telephone to BofA Merrill Lynch; no firm financing commitment. Submitted one day after the 09/09/2013 due date and considered on 09/11/2013 (late bids accepted).',\\n 'Informal', 'Heavy',\\n 'Stated range, oral form and timing; reported absence of a firm commitment. Formality Informal; Conditions Heavy (no committed financing).',\\n [('P-052', 'a representative of Party C indicated that it was submitting a revised oral indication of interest with an all-cash purchase price of $16.00 to $17.00 per share')],\\n ['P-052', 'P-054'], ['Q6'], 1, df='09/10/2013', dt='09/10/2013', wd='09/10/2013',\\n basis='Reported day', method='Reported', plow=16.00, phigh=17.00, pkind='Bidder range',\\n porigin='Stated', cur='USD', allcash='Yes',\\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\\n related=[('pc_bid1w', 'revises')]))\\n\\nrows.append(R('macdecl', '09/11/2013', 'Stewart G. MacDonald, Jr. (CEO)', 'Material process update', 1, 2, '',\\n 'Mr. MacDonald, given a limited overview without bidder identities or prices, decided he was not interested in rolling over any of his Mac-Gray shares in any transaction (resolved; no rollover formed). A detailed briefing followed on 09/12/2013; he supported continuing the process while urging a higher value.',\\n '', '',\\n 'Stated day; resolution row for the CEO rollover relationship under the at-most-two-rows convention (the exclusion itself is recorded separately).',\\n [('P-053', 'During this call, Mr. MacDonald indicated that he had decided that he was not interested in rolling over any of his shares in any transaction.'),\\n  ('P-056', 'Although Mr. MacDonald voiced his general support for continuing with the process, he expressed his view that Mac-Gray should continue to seek a higher value for stockholders.')],\\n ['P-053', 'P-056'], ['Q8'], None, df='09/11/2013', dt='09/11/2013', wd='09/11/2013',\\n basis='Reported day', method='Reported', related=[('exclu', 'related'), ('target_dec', 'support at $21.25')]))\\n\\nrows.append(R('r3', '09/11/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 3, '',\\n 'R3 opened: the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by 09/18/2013 and to indicate that Mac-Gray would consider a short period of exclusive negotiations with one bidder depending on price and deal certainty (calls made the same day). Finality: Announced as final \\\\u2014 the bidders were told these were final indications of interest.',\\n '', '',\\n 'The target\\\\u2019s first request for final/best-and-final offers opens a new round even though the invited bidders are unchanged; the deadline set in the same instruction is carried on this row as the Due date, per section 8.3.',\\n [('P-055', 'the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by September 18, 2013 and to indicate that Mac-Gray would consider engaging in a short period of exclusive negotiations with one of the bidders depending upon, among other things, the proposed purchase price and the level of deal certainty indicated in the bidder\\\\u2019s final proposal')],\\n ['P-055', 'P-054'], ['Q1', 'Q2'], None, df='09/11/2013', dt='09/11/2013', wd='09/11/2013',\\n basis='Reported day', method='Reported', due='09/18/2013', rfin='Announced as final',\\n related=[('r2', 'follows'), ('dl918', 'sets final due date')]))\\n\\nrows.append(R('dl918', '09/18/2013 (final-indication due date)', 'Mac-Gray (solicitation deadline)', 'Deadline', 1, 3, '',\\n 'Scheduled due date for final indications of interest. CSC/Pamplona and Party B submitted and Party A reaffirmed its best-and-final offer on the date; Party C did not submit. The Special Committee moved the next day to select CSC/Pamplona and authorize exclusivity \\\\u2014 the date passed on the bids in hand.',\\n '', '',\\n 'Treatment from what followed in the same round: no extension and no acceptance of anything submitted after the date; the target took its next step (selection/exclusivity) on the bids in hand \\\\u2014 Enforced.',\\n [('P-055', 'request final indications of interest by September 18, 2013'),\\n  ('P-058', 'On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share'),\\n  ('P-061', 'authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share')],\\n ['P-055', 'P-058', 'P-061'], ['Q2'], None, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\\n basis='Reported day', method='Reported', due='09/18/2013', dtreat='Enforced'))\\n\\nrows.append(R('cs_bid3', '09/18/2013', 'CSC/Pamplona', 'Bid', 1, 3, 'Strategic',\\n 'Final indication of interest: all cash at $20.75 per share. Pamplona reiterated its commitment to provide 100% of the capital required; requested two-week exclusive negotiations. Response on the requested final basis.',\\n 'Formal', 'Light',\\n 'Stated price; response on the requested basis to a genuine final solicitation (strong formal signal 2), so Formality Formal although the document remains an indication of interest. Conditions Light: committed financing, no diligence condition attached; the two-week exclusive negotiation is read as exclusivity rather than an attached substantive diligence period (flagged in Q6). DD open: yes.',\\n [('P-058', 'On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share, reiterating that Pamplona was committed to provide 100% of the capital required to consummate the transaction and requesting that CSC/Pamplona and Mac-Gray agree to engage in exclusive negotiations for two weeks.')],\\n ['P-058'], ['Q5', 'Q6'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\\n basis='Reported day', method='Reported', plow=20.75, phigh=20.75, pkind='Point', porigin='Stated',\\n cur='USD', allcash='Yes', cashclose=20.75,\\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\\n related=[('cs_bid2', 'revises'), ('cs_bid4', 'revised by')]))\\n\\nrows.append(R('pa_reaff', '09/18/2013', 'Party A', 'Bid reaffirmed', 1, 3, 'Strategic',\\n 'Reiterated by telephone that its previous $18.00\\\\u2013$19.00 all-cash indication was its best and final offer; no formal resubmission, price carried forward from the 09/10/2013 indication.',\\n 'Formal', 'Heavy',\\n 'Actual bidder confirmation that its existing offer stands, including a supported best-and-final response; price carried forward, visibly not restated. Formality Formal as a response on the requested basis to the final solicitation (signal 2; oral \\\\u2014 flagged). Conditions Heavy: the 09/10/2013 reported absence of a firm financing commitment was not superseded at this reaffirmation. DD open: yes.',\\n [('P-058', 'Also on September 18, 2013, Party A reiterated in a telephone call to a representative of BofA Merrill Lynch that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer.')],\\n ['P-058'], ['Q5', 'Q6'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\\n basis='Reported day', method='Reported', plow=18.00, phigh=19.00, pkind='Bidder range',\\n porigin='Carried forward', cur='USD', allcash='Yes',\\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\\n related=[('pa_bid2', 'reaffirms'), ('dropped_a', 'followed by')]))\\n\\nrows.append(R('pb_bid3', '09/18/2013', 'Party B', 'Bid', 1, 3, 'Financial',\\n 'Final-round package valued by Party B at $21.50 per share: $19.00 in cash at closing plus options for the remainder representing 10% of the new equity with a strike price equal to Party B\\\\u2019s initial cost basis; options vest on achievement of the base-case management projections (about five years, excluding future acquisitions) and were stated by Party B to be worth $2.50 per share. Not all cash.',\\n 'Formal', 'Heavy',\\n 'Stated package value (bidder\\\\u2019s own valuation; not guaranteed cash) and structure. Formality Formal as a response on the requested basis to the final solicitation (signal 2). Conditions Heavy: third-party debt and no firm financing commitment; the Special Committee later emphasized the contingent, deferred options and performance-measurement risk. Count 1 (first submission in this round; earlier rounds counted separately).',\\n [('P-058', 'On September 18, 2013, Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share, including $19.00 of cash to be paid at closing and the remaining per share price to be paid in the form of options to be issued to Mac-Gray stockholders, representing 10% of the new equity with a strike price equal to Party B\\\\u2019s initial cost basis.'),\\n  ('P-058', 'These options, which we refer to as the Party B options, would vest on the achievement of the base case management projections (i.e., over five years), excluding any future acquisitions.'),\\n  ('P-058', 'Party B\\\\u2019s proposal stated that it valued the Party B options at $2.50 of incremental value per share.')],\\n ['P-058'], ['Q5', 'Q6', 'Q7'], 1, df='09/18/2013', dt='09/18/2013', wd='09/18/2013',\\n basis='Reported day', method='Reported', plow=21.50, phigh=21.50, pkind='Point', porigin='Stated',\\n cur='USD', allcash='No', cashclose=19.00,\\n cdetail='Fin: not committed; DD required: not stated; DD open: yes; Excl: not stated',\\n related=[('pb_bid2', 'revises')]))\\n\\nrows.append(R('pc_nonsub', 'by 09/18/2013', 'Party C', 'Did not submit', 1, 3, 'Financial',\\n 'Did not submit a revised indication of interest or reiterate its prior $16.00\\\\u2013$17.00 indication at the final due date; no reasons given.',\\n '', '', 'Stated non-submission (the filing reports the absence and the lack of reasons); recorded at the solicitation due date under section 8.1 rule 2. No motive or withdrawal inferred; Decided by Unknown and Exit reason Not stated.',\\n [('P-058', 'Party C did not submit a revised indication of interest or reiterate its prior indication of interest of an all-cash purchase price of $16.00 to $17.00 per share nor did it specify any reasons in connection therewith.')],\\n ['P-058'], ['Q4'], 1, dt='09/18/2013', wd='09/18/2013', basis='Relative only',\\n method='Assigned: deadline', dby='Unknown', ereason='Not stated', obasis='Stated',\\n related=[('pc_bid2', 'no submission after'), ('dl918', 'closed at deadline')]))\\n\\nrows.append(R('target_dec', '09/19/2013', 'Mac-Gray Special Committee', 'Target decision', 1, 3, '',\\n 'Special Committee concluded CSC/Pamplona\\\\u2019s $20.75 proposal had the potential to deliver the most value with greater certainty (Pamplona funding, no third-party financing) than Party B\\\\u2019s higher-face-value package (contingent, deferred options; performance-measurement risk) and less risk than the others; concluded CSC/Pamplona should be in a position to raise above $20.75 in view of synergies, and authorized the Transaction Committee to inform CSC/Pamplona that Mac-Gray was prepared to move to exclusivity at $21.25 per share. Mr. MacDonald indicated support for $21.25.',\\n '', '',\\n 'Stated day; preferred-bidder/price-requirement decision (not a round opening, which is recorded separately).',\\n [('P-061', 'the Special Committee concluded that the revised indication of interest submitted by CSC/Pamplona had the potential of delivering the most value to stockholders, provided greater certainty and involved less potential risk than the other indications'),\\n  ('P-061', 'the Special Committee also concluded that, primarily in view of potential synergies between Mac-Gray and CSC, CSC/Pamplona should be in a position to increase their offer price above $20.75'),\\n  ('P-061', 'authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share'),\\n  ('P-061', 'at this meeting Mr. MacDonald indicated that he would be supportive of a price of $21.25 per share')],\\n ['P-061'], ['Q1'], None, df='09/19/2013', dt='09/19/2013', wd='09/19/2013',\\n basis='Reported day', method='Reported', related=[('dl918', 'follows'), ('r4', 'leads to'), ('cs_bid4', 'price requirement')]))\\n\\nrows.append(R('r4', '09/21/2013', 'Mac-Gray Special Committee; Transaction Committee', 'Round opened', 1, 4, '',\\n 'R4 opened: the target moved to exclusive definitive negotiation with the selected bidder, CSC/Pamplona \\\\u2014 the Transaction Committee proposed exclusivity conditioned on a $21.25 price and CSC/Pamplona confirmed the increase as a last-and-best offer conditional on a two-week exclusive negotiation. Finality: Inferred final \\\\u2014 no announcement, but the target moved to definitive negotiation with the selected bidder. Alternative boundary dates considered: 09/19/2013 (selection decision) and 09/24/2013 (executed exclusivity).',\\n '', '',\\n 'New round because the target moved to definitive negotiation with a selected bidder; the round is bilateral (one live bidder).',\\n [('P-062', 'the members of the Transaction Committee called the representative of CSC/Pamplona to propose that Mac-Gray was prepared to move forward with CSC/Pamplona on an exclusive basis for two weeks subject to CSC/Pamplona increasing their all-cash purchase price to $21.25 per share'),\\n  ('P-062', 'the representative of CSC/Pamplona called the members of the Transaction Committee to confirm that CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer, provided that Mac-Gray agree to a two week period of exclusive negotiations')],\\n ['P-062', 'P-061'], ['Q1'], None, df='09/21/2013', dt='09/21/2013', wd='09/21/2013',\\n basis='Reported day', method='Reported', rfin='Inferred final',\\n related=[('target_dec', 'follows'), ('excl_done', 'lead to')]))\\n\\nrows.append(R('cs_bid4', '09/21/2013', 'CSC/Pamplona', 'Bid', 1, 4, 'Strategic',\\n 'Raised to $21.25 per share in all cash as a last-and-best offer, provided Mac-Gray agree to a two-week period of exclusive negotiations; also requested a customary voting agreement covering Mr. MacDonald\\\\u2019s and his immediate family\\\\u2019s shares. Together with the negotiated exclusivity terms this became the CSC/Pamplona final proposal (no financing contingency; Pamplona funding 100% of the capital needed for closing).',\\n 'Formal', 'Light',\\n 'Stated price and condition; price confirmation while definitive negotiation was beginning. Formality carried forward as Formal from the 09/18/2013 final-round submission (no return to a preliminary basis). Conditions Light: committed financing, no diligence condition attached (two-week exclusive negotiation read as exclusivity; flagged in Q6).',\\n [('P-062', 'to confirm that CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer, provided that Mac-Gray agree to a two week period of exclusive negotiations'),\\n  ('P-064', 'committing to fund 100% of the capital needed for closing, which, together with the all-cash per share purchase price of $21.25, we refer to as the CSC/Pamplona final proposal')],\\n ['P-062', 'P-064', 'P-063'], ['Q5', 'Q6', 'Q7'], 1, df='09/21/2013', dt='09/21/2013',\\n wd='09/21/2013', basis='Reported day', method='Reported', plow=21.25, phigh=21.25,\\n pkind='Point', porigin='Stated', cur='USD', allcash='Yes', cashclose=21.25,\\n cdetail='Fin: committed; DD required: not stated; DD open: yes; Excl: requested (2 wks)',\\n related=[('cs_bid3', 'revises'), ('excl_done', 'terms negotiated'), ('sign', 'becomes agreement price')]))\\n\\nrows.append(R('excl_done', '09/24/2013', 'CSC; Pamplona; Mac-Gray', 'Exclusivity changed', 1, 4, '',\\n 'Granted/executed: exclusive negotiations until 5 p.m. ET on 10/12/2013 on the CSC/Pamplona final proposal terms negotiated 09/21\\\\u201309/23 (no financing contingency; Pamplona committing to fund 100% of the capital needed for closing; $15 million CSC reverse termination fee; post-signing covenants); the agreement automatically terminates if CSC or Pamplona adversely change the final proposal terms. Authorized by the Special Committee on 09/23/2013.',\\n '', '',\\n 'Actual state: executed 09/24/2013, scheduled expiry 10/12/2013 (later extended). This execution drops rival live bidders (rows below).',\\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013, subject to certain conditions, including that CSC and Pamplona not adversely change or modify the terms of the CSC/Pamplona final proposal.'),\\n  ('P-066', 'the Special Committee authorized Mac-Gray to enter into an exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013 on the terms included in the CSC/Pamplona final proposal')],\\n ['P-067', 'P-066', 'P-063'], ['Q2'], None, df='09/24/2013', dt='09/24/2013', wd='09/24/2013',\\n basis='Reported day', method='Reported', related=[('cs_bid4', 'executed with'), ('dropped_a', 'drops rival'), ('dropped_b', 'drops rival'), ('rolex', 'extended by')]))\\n\\nrows.append(R('dropped_a', 'by 09/24/2013', 'Party A', 'Dropped by target', 1, 4, 'Strategic',\\n 'Inferred: exclusivity \\\\u2014 exclusivity executed with CSC/Pamplona on 09/24/2013; Party A was still live with its standing $18.00\\\\u2013$19.00 all-cash best-and-final offer. Displaced from the exclusive final-negotiation stage.',\\n '', '', 'Inferred row per section 10.2: a live rival when the target executed exclusivity with another bidder; no notice, reason or voluntary exit is inferred. Working date = execution date (Assigned: decision day).',\\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013'),\\n  ('P-058', 'Party A reiterated in a telephone call to a representative of BofA Merrill Lynch that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer')],\\n ['P-067', 'P-058'], ['Q4'], 1, dt='09/24/2013', wd='09/24/2013', basis='Relative only',\\n method='Assigned: decision day', dby='Target', ereason='Not stated', obasis='Inferred: exclusivity',\\n related=[('pa_reaff', 'closes'), ('excl_done', 'displaces')]))\\n\\nrows.append(R('dropped_b', 'by 09/24/2013', 'Party B', 'Dropped by target', 1, 4, 'Financial',\\n 'Inferred: exclusivity \\\\u2014 exclusivity executed with CSC/Pamplona on 09/24/2013; Party B was still live with its 09/18/2013 package valued by Party B at $21.50 per share. Displaced from the exclusive final-negotiation stage.',\\n '', '', 'Inferred row per section 10.2: a live rival when the target executed exclusivity with another bidder; no notice, reason or voluntary exit is inferred. Working date = execution date (Assigned: decision day).',\\n [('P-067', 'On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013'),\\n  ('P-058', 'Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share')],\\n ['P-067', 'P-058'], ['Q4'], 1, dt='09/24/2013', wd='09/24/2013', basis='Relative only',\\n method='Assigned: decision day', dby='Target', ereason='Not stated', obasis='Inferred: exclusivity',\\n related=[('pb_bid3', 'closes'), ('excl_done', 'displaces')]))\\n\\nrows.append(R('kirkland', 'from 09/25/2013 (first observed acting; engagement date not disclosed)', 'Kirkland & Ellis LLP',\\n 'Adviser service observed', 1, 4, '',\\n 'Outside legal counsel to CSC/Pamplona; first shown acting when it received Mac-Gray\\\\u2019s initial merger agreement draft (09/25/2013); negotiated the merger agreement and the Pamplona commitment letter through signing.',\\n '', '', 'First observed service date per section 5.4; client = CSC/Pamplona; no engagement letter date disclosed.',\\n [('P-068', 'On September 25, 2013, Goodwin Procter delivered to Kirkland & Ellis LLP, outside legal counsel to CSC/Pamplona, whom we refer to as Kirkland, the initial draft of the merger agreement.')],\\n ['P-068'], [], None, df='09/25/2013', dt='09/25/2013', wd='09/25/2013',\\n basis='Reported day', method='Reported'))\\n\\nrows.append(R('access2', 'between 09/25/2013 and 10/07/2013', 'CSC/Pamplona', 'Information access changed', 1, 4, '',\\n 'CSC and Pamplona were granted full access to the electronic data site and access to certain members of management during the exclusive negotiations, and conducted confirmatory business and legal due diligence. The customer-data restriction applied to the strategic bidders in the 08/06\\\\u201308/27 stage is not shown to have continued against the exclusive bidder.',\\n '', '',\\n 'Late-stage expanded/catch-up access for the selected bidder; distinct from the earlier tiering. Working date = first day of the period (Assigned: bound).',\\n [('P-068', 'Also during this time, CSC and Pamplona were granted full access to the electronic data site and access to certain members of management and conducted confirmatory business and legal due diligence on Mac-Gray.')],\\n ['P-068'], ['Q3'], None, df='09/25/2013', dt='10/07/2013', wd='09/25/2013',\\n basis='Reported interval', method='Assigned: bound', related=[('access1', 'expands earlier tiering')]))\\n\\nrows.append(R('moab_res', '10/07/2013', 'Moab (shareholder)', 'Material process update', 1, 4, '',\\n 'Resolved: after facilitated discussions (from 09/23/2013, when Mr. Rothenberg asked to explore a rollover with CSC/Pamplona), it was determined that Moab would not roll over any Moab shares in the transaction. Moab later entered a voting agreement executed at signing.',\\n '', '',\\n 'Stated resolution; the 09/23/2013 facilitation is folded here under the two-row convention for rollover relationships (denial recorded separately).',\\n [('P-072', 'after discussions between Moab and representatives of Pamplona, it was determined that Moab would not rollover any Moab shares in the transaction'),\\n  ('P-065', 'to provide Moab with the opportunity to resume discussions with CSC/Pamplona regarding a possible equity rollover of Moab\\\\u2019s shares in the transaction if Moab still had an interest in such a rollover')],\\n ['P-072', 'P-065'], ['Q8'], None, df='10/07/2013', dt='10/07/2013', wd='10/07/2013',\\n basis='Reported day', method='Reported', related=[('moab_deny', 'resolves'), ('sign', 'voting agreement at signing')]))\\n\\nrows.append(R('rolex', '10/12/2013', 'CSC; Pamplona; Mac-Gray', 'Exclusivity changed', 1, 4, '',\\n 'Extended to 11:59 p.m. ET on 10/15/2013 by letter agreement executed 10/12/2013. CSC/Pamplona had requested the extension on 10/09/2013 amid open issues; the Special Committee authorized extension on 10/09/2013 and on 10/11/2013 conditioned it on a Mac-Gray termination fee of not more than $11 million, agreed on 10/11/2013 (recorded on the signing row).',\\n '', '', 'Actual state: executed 10/12/2013; the earlier scheduled expiry (5 p.m. ET 10/12/2013) was superseded.',\\n [('P-081', 'On October 12, 2013, CSC, Pamplona and Mac-Gray executed a letter agreement extending exclusivity until 11:59 p.m. ET on October 15, 2013.'),\\n  ('P-077', 'Goodwin Procter then reported that Kirkland had requested on behalf of CSC/Pamplona that the exclusivity agreement, due to expire at 5 p.m. ET on October 12, 2013, be extended to allow for continued negotiations of these open issues.')],\\n ['P-081', 'P-077'], ['Q2'], None, df='10/12/2013', dt='10/12/2013', wd='10/12/2013',\\n basis='Reported day', method='Reported', related=[('excl_done', 'extends'), ('sign', 'follows')]))\\n\\nrows.append(R('sign', '10/14/2013', 'Mac-Gray; Spin Holdco Inc. (Parent); CSC Fenway, Inc. (Merger Subsidiary); CSC ServiceWorks Holdings, Inc.; CSC ServiceWorks, Inc.',\\n 'Merger agreement signed', 1, 4, '',\\n 'Executed at $21.25 per share in cash (merger consideration), with no financing condition; the Pamplona commitment letter (up to $594 million; Pamplona damages liability capped at $50 million; Mac-Gray an express third-party beneficiary) was delivered; Mac-Gray termination fee $11 million and CSC reverse termination fee $15 million; End Date 03/31/2014, extendable to 07/31/2014 if antitrust clearance is the only open condition; Mr. MacDonald\\\\u2019s voting agreements (entered 09/27/2013) became effective and the Moab voting agreement was executed; the Special Committee and the Board approved the transaction and BofA Merrill Lynch delivered its fairness opinion the same day. Signing is not an extra submitted bid: price, formality and conditionality cells are left blank.',\\n '', '',\\n 'Stated execution day. Agreed consideration and commitment terms are recorded here and in Summary; post-signing competition is separately assessed (none reported as of the filing date).',\\n [('P-086', 'Later in the day, on October 14, 2013, the merger agreement was executed, the Pamplona commitment letter was delivered, Moab and Parent executed the Moab voting agreement and the Mac-Donald voting agreements became effective.'),\\n  ('X-010', 'The merger agreement does not contain any condition to the obligations of the Buyer Entities or Merger Subsidiary relating to the receipt of financing by the Buyer Entities.'),\\n  ('X-011', 'Mac-Gray has agreed to pay Parent $11 million upon the termination of the merger agreement under certain circumstances, which we refer to as the Mac-Gray termination fee. Parent has agreed to pay Mac-Gray $15 million upon the termination of the merger agreement under certain circumstances, which we refer to as the Parent termination fee.')],\\n ['P-086', 'X-010', 'X-011', 'X-030'], ['Q5'], None, df='10/14/2013', dt='10/14/2013', wd='10/14/2013',\\n basis='Reported day', method='Reported', related=[('cs_bid4', 'agreed price'), ('rolex', 'follows'), ('announce', 'announced next day')]))\\n\\nrows.append(R('announce', '10/15/2013', 'Mac-Gray; CSC ServiceWorks, Inc.', 'Merger announced', 1, 'post', '',\\n 'Mac-Gray and CSC jointly announced the execution of the merger agreement before U.S. stock markets opened. No competing proposal and no post-signing solicitation period (no go-shop; the agreement provides only a fiduciary out for unsolicited superior proposals) is reported as of the 12/04/2013 proxy statement; the HSR waiting period expired 11/27/2013; the special meeting is set for 01/08/2014 and closing is expected in January 2014. No closing is observed at the filing date.',\\n '', '', 'Stated day and medium. Post-signing phase: keep last; no go-shop or competing-proposal rows are required on this record.',\\n [('P-087', 'On October 15, 2013, before the U.S. stock markets opened, Mac-Gray and CSC jointly announced the execution of the merger agreement.'),\\n  ('X-014', 'We currently expect the merger to be completed in January 2014.'),\\n  ('X-013', 'While early termination was not granted, the waiting period expired on November 27, 2013.')],\\n ['P-087', 'X-014', 'X-013'], [], None, df='10/15/2013', dt='10/15/2013', wd='10/15/2013',\\n basis='Reported day', method='Reported', related=[('sign', 'announces')]))\\n\\n# --- verify quotes and unique keys ---\\nseen = set()\\nfor r in rows:\\n    if r['key'] in seen:\\n        raise SystemExit('duplicate key ' + r['key'])\\n    seen.add(r['key'])\\nbad = 0\\nfor r in rows:\\n    for pk, q in r['quotes']:\\n        if pk not in para:\\n            print('MISSING PARA', pk, 'in', r['key']); bad += 1\\n        elif not check_quote(pk, q):\\n            bad += 1\\nprint('rows:', len(rows), 'quote problems:', bad)\\n\"}"},"time":{"start":1789824806292,"end":1789824871141}}}}
