{"type":"tool_use","timestamp":1789824959671,"sessionID":"ses_f46297742ffe9mtUSz9GNRYMps","part":{"partID":"prt_0b9e1079f001RupljxlGKt8KLr","sessionID":"ses_f46297742ffe9mtUSz9GNRYMps","messageID":"msg_0b9e0fc8c001A00PEFNDKJDKTf","type":"tool","id":"call_00_9s8HtHkRHyWbkncxFEr18116","tool":"shell","state":{"status":"completed","input":{"command":"cat >> /tmp/opencode/macgray/build_ledger.py <<'PYEOF'\n\n# ---------------- Summary ----------------\nws_sum.column_dimensions['A'].width = 30\nws_sum.column_dimensions['B'].width = 100\nws_sum.column_dimensions['C'].width = 44\nws_sum.column_dimensions['D'].width = 22\nws_sum.column_dimensions['E'].width = 22\nws_sum.column_dimensions['F'].width = 44\nws_sum.column_dimensions['G'].width = 26\n\nsrow = [1]\ndef put(label, text, note='', bold_b=False):\n    r = srow[0]; srow[0] += 1\n    c1 = ws_sum.cell(row=r, column=1, value=label); c1.alignment = wrap; c1.font = bold if bold_b else Font()\n    c2 = ws_sum.cell(row=r, column=2, value=text); c2.alignment = wrap\n    if note:\n        c3 = ws_sum.cell(row=r, column=3, value=note); c3.alignment = wrap\n    return r\n\ndef put_block(title):\n    r = srow[0]; srow[0] += 1\n    c = ws_sum.cell(row=r, column=1, value=title)\n    c.font = bold; c.fill = block_fill; c.alignment = wrap\n    return r\n\ndef put_table(headers, data, widths=None):\n    r = srow[0]; srow[0] += 1\n    for j, h in enumerate(headers, 1):\n        c = ws_sum.cell(row=r, column=j, value=h); c.font = bold; c.fill = block_fill; c.alignment = wrap\n    for row_ in data:\n        r = srow[0]; srow[0] += 1\n        for j, v in enumerate(row_, 1):\n            c = ws_sum.cell(row=r, column=j, value=v); c.alignment = wrap\n    return r\n\nc = ws_sum.cell(row=1, column=1, value='Mac-Gray Corporation \\u2014 sale process ledger \\u2014 Summary')\nc.font = Font(bold=True, size=14)\nsrow[0] = 3\nput('Status and coverage', 'AI first pass; not human-approved. Instruction revision: Revision of 19 September 2026 \\u2014 short form. '\n    'Supplied-source coverage: the single DEFM14A proxy statement for Mac-Gray Corporation, dated 12/04/2013 (file mac-gray_2013-12-04_DEFM14A.htm); '\n    'complete background (printed pages 27\\u201341) and every other passage cited are reproduced in the Source text sheet.')\n\nput_block('1. Commercial account')\nput('Commercial account', 'Mac-Gray\\u2019s Board maintained an ongoing strategic review; after CSC\\u2019s May 2013 sale to Pamplona, the Board authorized exploration '\n    '(04/05/2013), Mac-Gray\\u2019s banker approached Party A (04/08/2013), and Party A submitted an unsolicited $17.00\\u2013$19.00 all-cash proposal (06/21/2013). '\n    'On 06/24/2013 the Board formed a six-member Special Committee, excluded CEO MacDonald and Moab\\u2019s Rothenberg for rollover conflicts, and launched a solicitation of 50 parties; '\n    '20 signed confidentiality agreements (2 strategic, 18 financial) and four bidders \\u2014 Party A, Party B, Party C and CSC/Pamplona \\u2014 advanced through staged diligence and revised indications. '\n    'CSC/Pamplona led the price upward ($18.50 \\u2192 $19.50 \\u2192 $20.75 \\u2192 $21.25 all cash); Party B\\u2019s final package was nominally higher at $21.50 but largely contingent options; '\n    'Party A stood at $18.00\\u2013$19.00 best-and-final and Party C dropped out at the final due date. Mac-Gray granted CSC/Pamplona exclusivity on 09/24/2013 and, after resolving the termination-fee dispute, '\n    'extended it on 10/12/2013 and signed at $21.25 per share in cash on 10/14/2013, announced 10/15/2013; the proxy reports no closing by 12/04/2013 (special meeting 01/08/2014, closing expected January 2014).')\nput('Observed outcome', 'Signed 10/14/2013 with CSC/Pamplona; announced 10/15/2013; no closing observed at the filing date; no post-signing competing proposal or go-shop reported.')\n\nput_block('2. Deal facts')\nput_table(['Item', 'Fact', 'Source'], [\n ['Target', 'Mac-Gray Corporation (Delaware; Waltham, Massachusetts; NYSE-listed; founded 1927; second largest U.S. laundry facilities management contractor; laundry rooms in 44 states and the District of Columbia)', 'X-004'],\n ['Focal acquirer / type', 'Spin Holdco Inc. (Parent), wholly-owned subsidiary of CSC ServiceWorks, Inc. (CSC), a wholly-owned subsidiary of CSC ServiceWorks Holdings, Inc.; backed by Pamplona Capital Partners III, L.P. Type: Strategic (operating-company acquisition role through a sponsor-owned operating company)', 'X-002, X-003, X-005'],\n ['Structure', 'CSC Fenway, Inc. (Merger Subsidiary) merges into Mac-Gray; Mac-Gray survives as a wholly-owned subsidiary of Parent', 'X-003, X-032'],\n ['Agreed consideration', '$21.25 per share in cash, without interest, less withholding; all-cash; equity awards cashed out', 'X-006, X-031'],\n ['Implied equity value (labelled calculation, not a filing figure)', '14,758,306 shares \\u00d7 $21.25 = $313,614,002.50 (\\u2248 $313.6M). Inputs: shares outstanding as of the 11/27/2013 record date and the merger consideration. Simple product; ignores equity awards, dilution, net debt and other adjustments (not disclosed)', 'X-009, X-006'],\n ['Signing / announcement / closing', 'Signed 10/14/2013; jointly announced 10/15/2013 before market open; closing not observed at 12/04/2013 (expected January 2014; special meeting 01/08/2014)', 'X-006, X-016'],\n ['Commitment / termination terms', 'Pamplona commitment letter up to $594M; no financing condition; Pamplona damages liability capped at $50M (Buyer Entities unlimited); Mac-Gray termination fee $11M; Parent termination fee $15M; End Date 03/31/2014 (extendable to 07/31/2014 for antitrust)', 'X-011, X-012, X-013, X-030, X-033'],\n ['Market benchmarks', '10/11/2013 close $14.72 (last trading day before approval); 52-week high (period ending 10/11/2013) $15.61; premiums ~44%/~36%; 11/27/2013 close $21.30', 'X-007, X-008, X-010'],\n ['Voting agreements', 'Stockholders with voting agreements (\\u2248 15% of shares as of the record date) agreed to vote for adoption; agreements terminate if the merger agreement terminates. MacDonald family agreements entered 09/27/2013; Moab agreement executed 10/14/2013', 'X-014, X-040, P-069, P-086'],\n ['Filing', 'DEFM14A, Mac-Gray Corporation, dated 12/04/2013; background at pages 27\\u201341; BofA Merrill Lynch fairness opinion at Annex B (page 45 and Annex B)', 'X-001'],\n])\n\nput_block('3. Process and round map')\nput('Processes', 'One sale process (Process 1, a sale of Mac-Gray). The 2011-2012 Discussions were a reverse-direction exploration (Mac-Gray as potential acquirer of CSC) and are kept only as context (R001\\u2013R002). No process termination or restart is recorded; the process ends in signing with post-signing activity unobserved at the filing date.')\nput('Initiation assessment', 'Mixed (target-led review with a bidder accelerant): the Board\\u2019s ongoing strategic review and 04/05/2013 authorization, the 04/08/2013 approach to Party A and Party A\\u2019s unsolicited 06/21/2013 proposal immediately preceded the 06/24/2013 sale decision and outreach. Moab\\u2019s proxy contest (two nominees elected 05/30/2013) explains the Moab rollover/exclusion thread; the filing does not report sale advocacy by Moab.')\nput('Round 0', 'Pre-opening: 2011-2012 context (R001\\u2013R002); 04/05/2013 authorization (R003); 04/08/2013 Party A contact (R004); adviser history (R005\\u2013R007); 06/21/2013 Party A proposal (R008), still standing when Round 1 was evaluated.')\nput_table(['Round', 'Opened', 'Objective / participant scope', 'Finality', 'Deadline & treatment', 'Round-bidder tally', 'Ending'], [\n ['0', 'pre-opening', 'Context, initiation, first contact, unsolicited Party A proposal', '\\u2014', '\\u2014', '1 bid (Party A)' , 'Leads to Round 1'],\n ['1', '06/24/2013 (R010)', 'Broad solicitation: 50 parties approached (15 strategic / 35 financial); 20 confidentiality signers; informational packages and preliminary IOIs', 'Not final', 'Due 07/23/2013; Late bids accepted', '4 accounted: 3 submissions (CSC/Pamplona, Party B, Party C) + Party A\\u2019s standing proposal', '16 residual non-submitters (R019); four advance'],\n ['2', '07/25/2013 (R023)', 'Staged disclosure: management presentations and tiered data access; revised written proposals to continue', 'Not final', 'Due 09/09/2013; Late bids accepted', '4 submissions (CSC/Pamplona, Party B on 09/09; Party A, Party C on 09/10)', 'All four advance to final round'],\n ['3', '09/11/2013 (R033)', 'Final indications of interest; possible short exclusive negotiation', 'Announced as final', 'Due 09/18/2013; Enforced', '3: 2 submissions (CSC/Pamplona $20.75; Party B $21.50-value) + Party A reaffirmation; Party C Did not submit', 'Selection and $21.25 exclusivity authorization (R039)'],\n ['4', '09/21/2013 (R040)', 'Exclusive definitive negotiation with the selected bidder (CSC/Pamplona)', 'Inferred final', 'No bid deadline; exclusivity expiry 10/12/2013 extended to 10/15/2013', '1 bid ($21.25)', 'Signed 10/14/2013 (R048)'],\n ['post', '10/15/2013 (R049)', 'Post-signing competition and closing', '\\u2014', '\\u2014', '0 competing proposals; no go-shop', 'No closing observed at 12/04/2013'],\n])\nput('Rejected boundaries', 'Round-1 anchor alternatives retained as rows: 10/23/2012 engagement (R002), 04/08/2013 contact (R004), 06/21/2013 proposal (R008); the first outreach wave has no single disclosed date. Round-2 alternative: 08/27/2013 letter (kept as Deadline set, R026) rejected in favor of the 07/25/2013 selection/staging decision. Round-4 alternatives: 09/19/2013 selection decision (R039) and 09/24/2013 executed exclusivity (R042) rejected in favor of the 09/21/2013 mutually agreed move to exclusive negotiation (R040).')\n\nput_block('4. Participants and advisers')\nput_table(['Name', 'Type / role', 'First observed', 'Observed activity and closing outcome (basis)'], [\n ['Party A', 'Strategic (laundry-industry operator)', '04/08/2013 contact (R004)', 'Bid 06/21 $17\\u201319 (R008); NDA 08/05 (R024); revised $18\\u201319 09/10 (R030); best-and-final 09/18 (R036); Dropped by target 09/24 \\u2014 Inferred: exclusivity (R043)'],\n ['Party B', 'Financial', 'NDA 06/28 (R013)', 'Bids 07/24 $17\\u201318 (R020), 09/09 $18.50 (R029), 09/18 $21.50-valued package (R037); Dropped by target 09/24 \\u2014 Inferred: exclusivity (R044)'],\n ['Party C', 'Financial', 'NDA 06/30 (R014)', 'Bids 07/24 $15\\u201317 oral (R021), 07/25 $16\\u201316.50 written (R022), 09/10 $16\\u201317 (R031); Did not submit 09/18 \\u2014 Stated (R038)'],\n ['CSC/Pamplona (CSC ServiceWorks, Inc. / Pamplona Capital Partners III, L.P.)', 'Strategic (CSC is an operating company owned by the Pamplona fund; one bidder unit)', 'Contact by 06/28 (R012); NDA 07/11 (R016)', 'Bids $18.50 (07/23, R018), $19.50 (09/09, R028), $20.75 (09/18, R035), $21.25 (09/21, R041); exclusivity 09/24 (R042); winner \\u2014 signed 10/14 (R048); no exit row (winner)'],\n ['16 financial NDA signers (residual cohort)', 'Financial cohort', 'NDA window 06/24\\u201308/24 (R011)', 'No preliminary indication reported; Did not submit 07/23 \\u2014 Inferred: residual (R019)'],\n ['Moab (Moab Partners, L.P. and affiliates)', 'Shareholder (~9% at 06/12/2013; not a bidder)', 'Rollover interest; June 24 exclusion (R009)', 'Exclusivity request denied 07/06 (R015); discussions facilitated 09/23; resolved no rollover 10/07 (R047); voting agreement executed at signing (R048)'],\n ['Stewart G. MacDonald, Jr.', 'CEO and significant stockholder (not a bidder)', 'Excluded from evaluation 06/24 (R009)', 'Declined rollover 09/11 (R032); supported $21.25; voting agreements entered 09/27/2013, effective at signing (R048)'],\n])\nput_table(['Adviser', 'Client and role', 'Dates and notes'], [\n ['BofA Merrill Lynch (Merrill Lynch, Pierce, Fenner & Smith Incorporated)', 'Mac-Gray; financial advisor', 'Engaged 10/23/2012 for the 2011-2012 Discussions (R002); mandate terminated 05/15/2013 (R006); re-engaged 05/31/2013 for the strategic-alternatives review (R007); fairness opinion 10/14/2013; fee ~$8.1M ($0.75M on opinion delivery; balance contingent on completion); barred from buyer-side acquisition financing without consent'],\n ['Goodwin Procter LLP', 'Mac-Gray; outside legal counsel', 'First observed on the mandate 05/09/2013 (R005); negotiated exclusivity, the merger agreement and the Pamplona commitment letter; advised on fiduciary duties'],\n ['Kirkland & Ellis LLP', 'CSC/Pamplona; outside legal counsel', 'First observed 09/25/2013 receiving the initial merger agreement draft (R045); negotiated the merger agreement and commitment letter'],\n])\nput('Aliases and relationships', 'Pamplona = Pamplona Capital Partners III, L.P. (the sponsor fund; CSC\\u2019s owner). Buyer chain: CSC ServiceWorks Holdings, Inc. \\u2192 CSC ServiceWorks, Inc. \\u2192 Spin Holdco Inc. (Parent) \\u2192 CSC Fenway, Inc. (Merger Subsidiary); CSC/Pamplona bids as one unit. Party A, Party B and Party C are the filing\\u2019s anonymous names; no individual identities are inferred. Public/private and country attributes: Mac-Gray (US/Delaware, NYSE-listed); CSC group (US/Delaware; workforce across US, Canada and Europe); Pamplona (sponsor fund).')\n\nput_block('5. Counts and auction screen')\nput('Method', 'Ledger-derived figures use SUMIFS over Count (column Q) filtered by What happened (D), Process (E), Round (F) and Include (P), excluding Include = No. Count is a scoped tally contribution, not a population balance; a sum of populated Count cells is not a complete total where rows remain blank. The initial Party A Bid carries first-round contact evidence and is included in the Round 1 tally explicitly (formula adds Round 0 bids).')\nput_table(['Metric', 'Ledger-derived value (formula)', 'Filing assertion (source)', 'Reconciliation / notes'], [\n ['Confidentiality agreements (Process 1)', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"NDA signed\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n  '20 potential bidders entered confidentiality agreements: 2 strategic (Party A, CSC/Pamplona) + 18 financial incl. Party B, Party C (X-025 detail P-025)', '4 individually recorded signers + 16 residual financial signers = 20. The residual is a partition of the stated total, not independent validation; population overlap between named and unnamed signers is assumed disjoint per section 5.2.'],\n ['First contacts', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Contact\",\\'Deal ledger\\'!$P:$P,\"Yes\")+SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Target interest\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n  'BofA Merrill Lynch contacted the parties identified at the June 24 meeting; a total of 50 parties were identified (P-023/P-024); contacts with Party A and Pamplona reported 06/28/2013 (P-004, P-026)',\n  '2 individually recorded first contacts (Party A 04/08/2013; CSC/Pamplona by 06/28/2013). The other 48 approaches are reported only at aggregate level, so this total covers named contacts only \\u2014 incomplete by design.'],\n ['Parties approached', '(no ledger sum \\u2014 50 is not a Count row)', '50 parties: 15 strategic, 35 financial (P-023/P-024)', '30 approached parties did not sign agreements and never entered; the filing reports no individual outcomes for them, and none are invented.'],\n ['Round 1 bidders', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Bid\",\\'Deal ledger\\'!$F:$F,1,\\'Deal ledger\\'!$P:$P,\"Yes\")+SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Bid\",\\'Deal ledger\\'!$F:$F,0,\\'Deal ledger\\'!$P:$P,\"Yes\")',\n  'Four bidders considered (three preliminary indications plus the Party A June 21 proposal) (P-036); four interested bidders advanced (P-038)', '4 = 3 Round-1 submissions + Party A\\u2019s standing Round-0 proposal (R008). The formula includes Round 0 explicitly; a blanket sum over Round 1 Bid rows would show 3.'],\n ['Round 2 bidders / Round 3 bidders / Round 4 bids', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Bid\",\\'Deal ledger\\'!$F:$F,2,\\'Deal ledger\\'!$P:$P,\"Yes\"); Round 3: same for \"Bid\" + \"Bid reaffirmed\"; Round 4: same for \"Bid\"',\n  'Revised indications reviewed 09/11/2013 (P-052, P-054); final indications 09/18/2013 (P-058); $21.25 confirmation 09/21/2013 (P-062)', 'Round 2 = 4; Round 3 = 3 (2 submissions + 1 reaffirmation); Round 4 = 1. Round tallies are stage-specific units, not unique bidders across the deal.'],\n ['Non-submissions', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Did not submit\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n  'Party C absent at the final due date (P-058); the continuing set was the four named bidders (P-036, P-038)', '17 affected units = Party C (stated, 1) + 16 residual signers (inferred residual, 16).'],\n ['Exclusivity drops', '=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Dropped by target\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n  'Exclusivity executed with CSC/Pamplona 09/24/2013 (P-067)', '2 affected units (Party A and Party B), both Inferred: exclusivity; no notice, reason or voluntary exit inferred.'],\n ['Auction screen', 'Met', '\\u2014',\n  'More than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements (20 signers; at least Party A and CSC/Pamplona as separate strategic units, plus 18 financial). Excluded: no lender-only, adviser or rollover-holder agreements reported; no agreements expressly reused from an earlier attempt reported.'],\n])\nput('Per-stage balance (Process 1)', 'Participants stock = entrants \\u2212 stated exits \\u2212 inferred exits + re-entries. R1: 20 \\u2212 16 (residual non-submitters) = 4. R2: 4 \\u2212 0 = 4. R3: 4 \\u2212 1 (Party C) = 3. R4: 3 \\u2212 2 (exclusivity drops) = 1 = winner. At signing only the winner remains; no go-shop; no post-signing entrants. Exit events: 19 total \\u2014 1 stated (Party C), 18 inferred (16 residual + 2 exclusivity drops); inferred share is visible, not forced.')\n\nput_block('6. Comparability and inputs')\nput('Other-scope proposals', 'None observed: every recorded proposal concerned the whole company\\u2019s equity. No segment, asset, minority-stake or unresolved-scope bids were recorded, so no Other-scope bid rows exist and no non-comparability adjustment is applied.')\nput('Consideration structure', 'All proposals were all-cash except Party B\\u2019s 09/18/2013 package: $19.00 cash at closing plus options for the remainder (10% of the new equity; strike price equal to Party B\\u2019s initial cost basis; vesting on the base-case management projections over about five years, excluding future acquisitions; bidder-stated option value $2.50 per share). Price cells carry the bidder-stated $21.50 with All cash = No and Cash at closing $19.00; no CVR or earnout is present. Currency USD throughout.')\nput('Projections and benchmarks', 'Management projections prepared June 2013 for 2013\\u20132018 (Without Acquisitions and With Acquisitions cases); used in BofA Merrill Lynch\\u2019s analyses and as the Party B options\\u2019 vesting benchmark, with extensive cautionary language. Market benchmarks: 10/11/2013 close $14.72; 52-week high $15.61 (period ending 10/11/2013); 11/27/2013 close $21.30.')\nput('Stated inputs', 'Shares outstanding 14,758,306 as of the 11/27/2013 record date; merger consideration $21.25; Pamplona commitment up to $594M; damages cap $50M; HSR filed 10/29/2013 and waiting period expired 11/27/2013. Net debt: not disclosed.')\nput('Labelled conversion', 'Implied equity value \\u2248 $313.6M = 14,758,306 \\u00d7 $21.25 (simple product of stated inputs; not a filing figure; ignores equity awards, dilution, net debt and any other adjustments, none of which are disclosed in the supplied filing).')\nput('Glossary', 'NDA = confidentiality agreement. IOI = indication of interest. LOI = letter of intent. Due diligence = investigation of the target. Exclusivity = a period in which the target negotiates only with one bidder. Reverse termination fee = fee payable by the buyer to the target on specified terminations ($15M here). Go-shop = agreement-provided post-signing solicitation period (none here; only a fiduciary out for unsolicited superior proposals). CVR = contingent value right (none here). Equity value = value of the shares; enterprise value = the business before debt/cash adjustments (not used for the bid prices).')\n\n# ---------------- Questions ----------------\nqhead = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\nws_q.append(qhead)\nfor c in range(1, len(qhead)+1):\n    cell = ws_q.cell(row=1, column=c); cell.fill = head_fill; cell.font = head_font\n    cell.alignment = Alignment(wrap_text=True, vertical='center')\nqw = [8,26,72,72,30,40,10,26]\nfor i, w in enumerate(qw, 1):\n    ws_q.column_dimensions[get_column_letter(i)].width = w\n\nquestions = [\n ['Q1','Process segmentation and round map',\n  'Accept one process (Process 1) and the four-round map. R1 anchor = 06/24/2013 sale decision (rejected candidates: 10/23/2012 engagement R002, 04/08/2013 contact R004, 06/21/2013 proposal R008; first outreach wave undated). R2 = 07/25/2013 selection/staging (reject 08/27/2013 letter R026 as the boundary). R3 = 09/11/2013 final-indication request (Announced as final). R4 = 09/21/2013 move to exclusive negotiation (Inferred final; alternatives 09/19 R039 and 09/24 R042). Treat the 2011-2012 Discussions as reverse-direction context, not a prior sale attempt.',\n  'R1 anchor and 50-party outreach: P-022, P-023, P-024; R2: P-037, P-038; R3: P-055; R4: P-061, P-062; context P-002. Working dates and finality as recorded on rows R001, R010, R023, R033, R040.',\n  'R001, R002, R004, R007, R008, R010, R023, R033, R040 (Process, Round, Round finality, Due date)',\n  'Renumbers rounds and moves bid/outcome rows and tallies; Summary round map changes. No facts change.',\n  'Pending',''],\n ['Q2','Deadlines and their treatment',\n  'Accept: 07/23/2013 (preliminary IOIs) = Late bids accepted (Party B and Party C submitted 07/24 and were reviewed 07/25); 09/09/2013 (revised written proposals) = Late bids accepted (Party A and Party C submitted 09/10 and were reviewed 09/11); 09/18/2013 (final indications) = Enforced (selection/exclusivity authorized the next day on the bids in hand). Exclusivity expiries (10/12/2013; extended to 10/15/2013) are recorded in Terms, not as Deadline rows.',\n  'Due dates: P-025; late submissions and review: P-035, P-036, P-052, P-054; final due date and next step: P-055, P-058, P-061; exclusivity extension: P-077, P-081.',\n  'R017, R026, R027, R034, R042, R048 (Deadline treatment, Due date)',\n  'Treatment labels only; no price or participation changes. If the 09/18 round were read as unclear, Enforced would fall back to Unclear.',\n  'Pending',''],\n ['Q3','NDA population, residual cohorts and the auction screen',\n  'Accept the representation: 20 confidentiality signers = 4 individually recorded (Party A, Party B, Party C, CSC/Pamplona) + 16 residual financial signers; 16 residual non-submitters at 07/23/2013. Base caveat: the filing elsewhere refers to \"other potential bidders\" and does not date every signing, so if unnamed signers submitted indications the residual would shrink; flag on review but keep as the filing\\u2019s stated-base inference. Auction screen: met.',\n  '20 signers and composition P-025; four bidders P-036, P-038; \"other potential bidders\" (Reasons) X-018.',\n  'R011, R019, R012\\u2013R016, R018\\u2013R021, R025, R046 (Count, Type, Outcome basis)',\n  'Changes residual counts and the non-submitter cohort; screening conclusion (met) is unchanged on any reading with at least two independent signers.',\n  'Pending',''],\n ['Q4','Inferred participation outcomes (closing rows)',\n  'Accept: Party A and Party B Dropped by target on 09/24/2013 (Inferred: exclusivity; Decided by Target; Exit reason Not stated; no notice inferred) and the 16 residual signers Did not submit at 07/23/2013 (Inferred: residual; arithmetic shown on the row). Party C\\u2019s 09/18/2013 non-submission is stated (no reasons \\u2192 Decided by Unknown; Exit reason Not stated). Inferred rows state only that the participant was out by that transition.',\n  'Exclusivity execution P-067; live rival bids P-058; base and accounting P-025, P-036, P-038.',\n  'R019, R038, R043, R044 (Outcome basis, Decided by, Exit reason, Count)',\n  'If a named exit for an anonymous signer were later established, it would be an identity mapping only \\u2014 no counts move; if Party C\\u2019s silence were read as withdrawal, relabel Withdrew (agency still unknown).',\n  'Pending',''],\n ['Q5','Formality of final-round indications',\n  'Accept Formal for the 09/18/2013 final-round rows (CSC/Pamplona R035, Party B R037, Party A reaffirmation R036) as responses on the requested basis to a genuine final solicitation; earlier indications remain Informal; no returned markups or full agreements by any bidder; the winner therefore reaches signing with a Formal row and no late-reconfirmation row is needed. Borderline: the documents remain indications of interest (Party A\\u2019s oral) \\u2014 flagged.',\n  'Final request and responses P-055, P-058; winner reaches agreement P-061, P-062, P-066, P-067.',\n  'R028\\u2013R031 (Informal), R035\\u2013R037 (Formal), R041 (carried Formal), R008, R018\\u2013R021 (Informal)',\n  'If all stay Informal, the winner has no Formal row and the deal reads as an informal-only process; bidding counts and prices do not change.',\n  'Pending',''],\n ['Q6','Conditions levels (diligence-period and financing readings)',\n  'Accept: CSC/Pamplona 09/09, 09/18 and 09/21 rows = Light (committed financing; the two-week exclusive negotiation is treated as an exclusivity request, not an attached substantive diligence period); Party A and Party B rows = Heavy (reported absence of a firm financing commitment; Party B\\u2019s third-party debt and contingent options); the July pre-diligence indications (Party A, Party B, Party C, CSC/Pamplona) = Heavy by context; no Conditions level None is used. Every level is reassessed per bid, not carried forward blindly (CSC/Pamplona moved Heavy at 07/23 \\u2192 Light once capital was committed).',\n  'Financing statements P-051, P-052; exclusivity requests P-051, P-058, P-062; certainty assessment P-061; pre-diligence context P-034, P-035; diligence period P-046, P-068.',\n  'R008, R018\\u2013R021, R028\\u2013R031, R035\\u2013R037, R041 (Conditions level, Conditions detail)',\n  'Reading the two-week exclusivity as an attached diligence period would move CSC/Pamplona\\u2019s last rows to Heavy and change the buyer-commitment profile presented in Summary.',\n  'Pending',''],\n ['Q7','Prices, package values and consideration comparability',\n  'Accept: Party B\\u2019s 09/18/2013 row carries the bidder-stated package value $21.50 in the price cells with Price origin Stated, All cash = No, Cash at closing $19.00, and the $2.50 option value and five-year vesting in Terms; alternative would be to populate only $19.00 and leave the package in Terms. Ranges stay ranges (no midpoints); Party A\\u2019s 09/18/2013 reaffirmation is Carried forward; USD throughout; no bound-only, other-scope, share-exchange or CVR consideration in this deal.',\n  'Party B package P-058; ranges P-019, P-035, P-039, P-052; $21.25 P-062, P-064; comparability X-006, X-011.',\n  'R037, R035, R036, R028\\u2013R031, R018\\u2013R021, R008 (Price low/high, Price kind, Price origin, All cash, Cash at closing)',\n  'Changes how Party B\\u2019s nominal $21.50 package compares with CSC/Pamplona\\u2019s $21.25 cash; no ranking change is asserted by the ledger.',\n  'Pending',''],\n ['Q8','Dates, ordering and rollover conventions',\n  'Accept the stated conventions: 2011-2012 window midpoint 01/15/2012 (R001); residual NDA cohort Working date 06/24/2013 (Assigned: bound, R011); \"by\" rows (R012, R019, R038, R043, R044) use Date to = bound with Assigned methods and When \"by \\u2026\"; the \"July 27, 2103\" source typo reads 07/27/2013 (R024 reason); Moab rollover uses two rows (denial R015; resolution R047, folding the 09/23/2013 facilitation); MacDonald rollover resolution R032; same-day row order within rounds (e.g., 06/24, 07/25, 09/11, 09/18, 09/21, 09/24) is a deterministic display convention, including that Party C\\u2019s non-submission (R038) is displayed after the same-day submissions.',\n  'Window text P-002; NDA window P-025; contact bound P-026; drops P-067; non-submissions P-058; typo P-040; rollover P-031, P-053, P-065, P-072.',\n  'R001, R012, R019, R032, R038, R043, R044, R047 (Date from/to, Working date, Date basis, Date method)',\n  'Re-sorts or re-bounds individual rows; no facts, prices or counts change.',\n  'Pending',''],\n]\nfor q in questions:\n    ws_q.append(q)\nfor r in range(2, 2 + len(questions)):\n    ws_q.row_dimensions[r].height = 150\n    for c in range(1, 9):\n        ws_q.cell(row=r, column=c).alignment = wrap\nws_q.freeze_panes = 'A2'\nws_q.auto_filter.ref = 'A1:H%d' % (len(questions) + 1)\n\n# ---------------- Source text ----------------\nws_src.append(['Paragraph','Section','Page','Text'])\nfor c in range(1, 5):\n    cell = ws_src.cell(row=1, column=c); cell.fill = head_fill; cell.font = head_font\n    cell.alignment = Alignment(wrap_text=True, vertical='center')\nws_src.column_dimensions['A'].width = 11\nws_src.column_dimensions['B'].width = 42\nws_src.column_dimensions['C'].width = 7\nws_src.column_dimensions['D'].width = 150\nfor i, k in enumerate(src_order):\n    r = i + 2\n    p = para[k]\n    ws_src.cell(row=r, column=1, value=k)\n    ws_src.cell(row=r, column=2, value=p['section'])\n    pg = int(p['page']) if p['page'].isdigit() else p['page']\n    ws_src.cell(row=r, column=3, value=pg)\n    c4 = ws_src.cell(row=r, column=4, value=p['text'])\n    for c in range(1, 5):\n        ws_src.cell(row=r, column=c).alignment = wrap\n    ws_src.row_dimensions[r].height = est_height([(p['text'], 150)])\nnote_r = len(src_order) + 2\nws_src.cell(row=note_r, column=1, value='Note')\nws_src.cell(row=note_r, column=2, value='Source text declaration')\nws_src.cell(row=note_r, column=4, value='Source text decoded from the filed HTML with layout-only decoding and whitespace normalization; no wording, punctuation, numbers or qualifications changed. Printed page numbers follow the filing pagination (component markers). Paragraph IDs were assigned by the extracting session: P-001 onward for the complete background in source order; X-001 onward for every other passage used. Quotations in the ledger are recoverable from the cited rows.')\nfor c in range(1, 5):\n    ws_src.cell(row=note_r, column=c).alignment = wrap\nws_src.freeze_panes = 'A2'\nws_src.auto_filter.ref = 'A1:D%d' % note_r\n\nwb.save(OUT)\nprint('saved', OUT)\nprint('ledger rows:', len(rows), 'source paragraphs:', len(src_order))\nPYEOF\npython3 /tmp/opencode/macgray/build_ledger.py"},"output":"rows: 50 quote problems: 0\nsaved /home/uctpiaj/work/extraction/mac-gray.xlsx\nledger rows: 50 source paragraphs: 128\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"rows: 50 quote problems: 0\nsaved /home/uctpiaj/work/extraction/mac-gray.xlsx\nledger rows: 50 source paragraphs: 128\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cat >> /tmp/opencode/macgray/build_ledger.py <<'PYEOF'\\n\\n# ---------------- Summary ----------------\\nws_sum.column_dimensions['A'].width = 30\\nws_sum.column_dimensions['B'].width = 100\\nws_sum.column_dimensions['C'].width = 44\\nws_sum.column_dimensions['D'].width = 22\\nws_sum.column_dimensions['E'].width = 22\\nws_sum.column_dimensions['F'].width = 44\\nws_sum.column_dimensions['G'].width = 26\\n\\nsrow = [1]\\ndef put(label, text, note='', bold_b=False):\\n    r = srow[0]; srow[0] += 1\\n    c1 = ws_sum.cell(row=r, column=1, value=label); c1.alignment = wrap; c1.font = bold if bold_b else Font()\\n    c2 = ws_sum.cell(row=r, column=2, value=text); c2.alignment = wrap\\n    if note:\\n        c3 = ws_sum.cell(row=r, column=3, value=note); c3.alignment = wrap\\n    return r\\n\\ndef put_block(title):\\n    r = srow[0]; srow[0] += 1\\n    c = ws_sum.cell(row=r, column=1, value=title)\\n    c.font = bold; c.fill = block_fill; c.alignment = wrap\\n    return r\\n\\ndef put_table(headers, data, widths=None):\\n    r = srow[0]; srow[0] += 1\\n    for j, h in enumerate(headers, 1):\\n        c = ws_sum.cell(row=r, column=j, value=h); c.font = bold; c.fill = block_fill; c.alignment = wrap\\n    for row_ in data:\\n        r = srow[0]; srow[0] += 1\\n        for j, v in enumerate(row_, 1):\\n            c = ws_sum.cell(row=r, column=j, value=v); c.alignment = wrap\\n    return r\\n\\nc = ws_sum.cell(row=1, column=1, value='Mac-Gray Corporation \\\\u2014 sale process ledger \\\\u2014 Summary')\\nc.font = Font(bold=True, size=14)\\nsrow[0] = 3\\nput('Status and coverage', 'AI first pass; not human-approved. Instruction revision: Revision of 19 September 2026 \\\\u2014 short form. '\\n    'Supplied-source coverage: the single DEFM14A proxy statement for Mac-Gray Corporation, dated 12/04/2013 (file mac-gray_2013-12-04_DEFM14A.htm); '\\n    'complete background (printed pages 27\\\\u201341) and every other passage cited are reproduced in the Source text sheet.')\\n\\nput_block('1. Commercial account')\\nput('Commercial account', 'Mac-Gray\\\\u2019s Board maintained an ongoing strategic review; after CSC\\\\u2019s May 2013 sale to Pamplona, the Board authorized exploration '\\n    '(04/05/2013), Mac-Gray\\\\u2019s banker approached Party A (04/08/2013), and Party A submitted an unsolicited $17.00\\\\u2013$19.00 all-cash proposal (06/21/2013). '\\n    'On 06/24/2013 the Board formed a six-member Special Committee, excluded CEO MacDonald and Moab\\\\u2019s Rothenberg for rollover conflicts, and launched a solicitation of 50 parties; '\\n    '20 signed confidentiality agreements (2 strategic, 18 financial) and four bidders \\\\u2014 Party A, Party B, Party C and CSC/Pamplona \\\\u2014 advanced through staged diligence and revised indications. '\\n    'CSC/Pamplona led the price upward ($18.50 \\\\u2192 $19.50 \\\\u2192 $20.75 \\\\u2192 $21.25 all cash); Party B\\\\u2019s final package was nominally higher at $21.50 but largely contingent options; '\\n    'Party A stood at $18.00\\\\u2013$19.00 best-and-final and Party C dropped out at the final due date. Mac-Gray granted CSC/Pamplona exclusivity on 09/24/2013 and, after resolving the termination-fee dispute, '\\n    'extended it on 10/12/2013 and signed at $21.25 per share in cash on 10/14/2013, announced 10/15/2013; the proxy reports no closing by 12/04/2013 (special meeting 01/08/2014, closing expected January 2014).')\\nput('Observed outcome', 'Signed 10/14/2013 with CSC/Pamplona; announced 10/15/2013; no closing observed at the filing date; no post-signing competing proposal or go-shop reported.')\\n\\nput_block('2. Deal facts')\\nput_table(['Item', 'Fact', 'Source'], [\\n ['Target', 'Mac-Gray Corporation (Delaware; Waltham, Massachusetts; NYSE-listed; founded 1927; second largest U.S. laundry facilities management contractor; laundry rooms in 44 states and the District of Columbia)', 'X-004'],\\n ['Focal acquirer / type', 'Spin Holdco Inc. (Parent), wholly-owned subsidiary of CSC ServiceWorks, Inc. (CSC), a wholly-owned subsidiary of CSC ServiceWorks Holdings, Inc.; backed by Pamplona Capital Partners III, L.P. Type: Strategic (operating-company acquisition role through a sponsor-owned operating company)', 'X-002, X-003, X-005'],\\n ['Structure', 'CSC Fenway, Inc. (Merger Subsidiary) merges into Mac-Gray; Mac-Gray survives as a wholly-owned subsidiary of Parent', 'X-003, X-032'],\\n ['Agreed consideration', '$21.25 per share in cash, without interest, less withholding; all-cash; equity awards cashed out', 'X-006, X-031'],\\n ['Implied equity value (labelled calculation, not a filing figure)', '14,758,306 shares \\\\u00d7 $21.25 = $313,614,002.50 (\\\\u2248 $313.6M). Inputs: shares outstanding as of the 11/27/2013 record date and the merger consideration. Simple product; ignores equity awards, dilution, net debt and other adjustments (not disclosed)', 'X-009, X-006'],\\n ['Signing / announcement / closing', 'Signed 10/14/2013; jointly announced 10/15/2013 before market open; closing not observed at 12/04/2013 (expected January 2014; special meeting 01/08/2014)', 'X-006, X-016'],\\n ['Commitment / termination terms', 'Pamplona commitment letter up to $594M; no financing condition; Pamplona damages liability capped at $50M (Buyer Entities unlimited); Mac-Gray termination fee $11M; Parent termination fee $15M; End Date 03/31/2014 (extendable to 07/31/2014 for antitrust)', 'X-011, X-012, X-013, X-030, X-033'],\\n ['Market benchmarks', '10/11/2013 close $14.72 (last trading day before approval); 52-week high (period ending 10/11/2013) $15.61; premiums ~44%/~36%; 11/27/2013 close $21.30', 'X-007, X-008, X-010'],\\n ['Voting agreements', 'Stockholders with voting agreements (\\\\u2248 15% of shares as of the record date) agreed to vote for adoption; agreements terminate if the merger agreement terminates. MacDonald family agreements entered 09/27/2013; Moab agreement executed 10/14/2013', 'X-014, X-040, P-069, P-086'],\\n ['Filing', 'DEFM14A, Mac-Gray Corporation, dated 12/04/2013; background at pages 27\\\\u201341; BofA Merrill Lynch fairness opinion at Annex B (page 45 and Annex B)', 'X-001'],\\n])\\n\\nput_block('3. Process and round map')\\nput('Processes', 'One sale process (Process 1, a sale of Mac-Gray). The 2011-2012 Discussions were a reverse-direction exploration (Mac-Gray as potential acquirer of CSC) and are kept only as context (R001\\\\u2013R002). No process termination or restart is recorded; the process ends in signing with post-signing activity unobserved at the filing date.')\\nput('Initiation assessment', 'Mixed (target-led review with a bidder accelerant): the Board\\\\u2019s ongoing strategic review and 04/05/2013 authorization, the 04/08/2013 approach to Party A and Party A\\\\u2019s unsolicited 06/21/2013 proposal immediately preceded the 06/24/2013 sale decision and outreach. Moab\\\\u2019s proxy contest (two nominees elected 05/30/2013) explains the Moab rollover/exclusion thread; the filing does not report sale advocacy by Moab.')\\nput('Round 0', 'Pre-opening: 2011-2012 context (R001\\\\u2013R002); 04/05/2013 authorization (R003); 04/08/2013 Party A contact (R004); adviser history (R005\\\\u2013R007); 06/21/2013 Party A proposal (R008), still standing when Round 1 was evaluated.')\\nput_table(['Round', 'Opened', 'Objective / participant scope', 'Finality', 'Deadline & treatment', 'Round-bidder tally', 'Ending'], [\\n ['0', 'pre-opening', 'Context, initiation, first contact, unsolicited Party A proposal', '\\\\u2014', '\\\\u2014', '1 bid (Party A)' , 'Leads to Round 1'],\\n ['1', '06/24/2013 (R010)', 'Broad solicitation: 50 parties approached (15 strategic / 35 financial); 20 confidentiality signers; informational packages and preliminary IOIs', 'Not final', 'Due 07/23/2013; Late bids accepted', '4 accounted: 3 submissions (CSC/Pamplona, Party B, Party C) + Party A\\\\u2019s standing proposal', '16 residual non-submitters (R019); four advance'],\\n ['2', '07/25/2013 (R023)', 'Staged disclosure: management presentations and tiered data access; revised written proposals to continue', 'Not final', 'Due 09/09/2013; Late bids accepted', '4 submissions (CSC/Pamplona, Party B on 09/09; Party A, Party C on 09/10)', 'All four advance to final round'],\\n ['3', '09/11/2013 (R033)', 'Final indications of interest; possible short exclusive negotiation', 'Announced as final', 'Due 09/18/2013; Enforced', '3: 2 submissions (CSC/Pamplona $20.75; Party B $21.50-value) + Party A reaffirmation; Party C Did not submit', 'Selection and $21.25 exclusivity authorization (R039)'],\\n ['4', '09/21/2013 (R040)', 'Exclusive definitive negotiation with the selected bidder (CSC/Pamplona)', 'Inferred final', 'No bid deadline; exclusivity expiry 10/12/2013 extended to 10/15/2013', '1 bid ($21.25)', 'Signed 10/14/2013 (R048)'],\\n ['post', '10/15/2013 (R049)', 'Post-signing competition and closing', '\\\\u2014', '\\\\u2014', '0 competing proposals; no go-shop', 'No closing observed at 12/04/2013'],\\n])\\nput('Rejected boundaries', 'Round-1 anchor alternatives retained as rows: 10/23/2012 engagement (R002), 04/08/2013 contact (R004), 06/21/2013 proposal (R008); the first outreach wave has no single disclosed date. Round-2 alternative: 08/27/2013 letter (kept as Deadline set, R026) rejected in favor of the 07/25/2013 selection/staging decision. Round-4 alternatives: 09/19/2013 selection decision (R039) and 09/24/2013 executed exclusivity (R042) rejected in favor of the 09/21/2013 mutually agreed move to exclusive negotiation (R040).')\\n\\nput_block('4. Participants and advisers')\\nput_table(['Name', 'Type / role', 'First observed', 'Observed activity and closing outcome (basis)'], [\\n ['Party A', 'Strategic (laundry-industry operator)', '04/08/2013 contact (R004)', 'Bid 06/21 $17\\\\u201319 (R008); NDA 08/05 (R024); revised $18\\\\u201319 09/10 (R030); best-and-final 09/18 (R036); Dropped by target 09/24 \\\\u2014 Inferred: exclusivity (R043)'],\\n ['Party B', 'Financial', 'NDA 06/28 (R013)', 'Bids 07/24 $17\\\\u201318 (R020), 09/09 $18.50 (R029), 09/18 $21.50-valued package (R037); Dropped by target 09/24 \\\\u2014 Inferred: exclusivity (R044)'],\\n ['Party C', 'Financial', 'NDA 06/30 (R014)', 'Bids 07/24 $15\\\\u201317 oral (R021), 07/25 $16\\\\u201316.50 written (R022), 09/10 $16\\\\u201317 (R031); Did not submit 09/18 \\\\u2014 Stated (R038)'],\\n ['CSC/Pamplona (CSC ServiceWorks, Inc. / Pamplona Capital Partners III, L.P.)', 'Strategic (CSC is an operating company owned by the Pamplona fund; one bidder unit)', 'Contact by 06/28 (R012); NDA 07/11 (R016)', 'Bids $18.50 (07/23, R018), $19.50 (09/09, R028), $20.75 (09/18, R035), $21.25 (09/21, R041); exclusivity 09/24 (R042); winner \\\\u2014 signed 10/14 (R048); no exit row (winner)'],\\n ['16 financial NDA signers (residual cohort)', 'Financial cohort', 'NDA window 06/24\\\\u201308/24 (R011)', 'No preliminary indication reported; Did not submit 07/23 \\\\u2014 Inferred: residual (R019)'],\\n ['Moab (Moab Partners, L.P. and affiliates)', 'Shareholder (~9% at 06/12/2013; not a bidder)', 'Rollover interest; June 24 exclusion (R009)', 'Exclusivity request denied 07/06 (R015); discussions facilitated 09/23; resolved no rollover 10/07 (R047); voting agreement executed at signing (R048)'],\\n ['Stewart G. MacDonald, Jr.', 'CEO and significant stockholder (not a bidder)', 'Excluded from evaluation 06/24 (R009)', 'Declined rollover 09/11 (R032); supported $21.25; voting agreements entered 09/27/2013, effective at signing (R048)'],\\n])\\nput_table(['Adviser', 'Client and role', 'Dates and notes'], [\\n ['BofA Merrill Lynch (Merrill Lynch, Pierce, Fenner & Smith Incorporated)', 'Mac-Gray; financial advisor', 'Engaged 10/23/2012 for the 2011-2012 Discussions (R002); mandate terminated 05/15/2013 (R006); re-engaged 05/31/2013 for the strategic-alternatives review (R007); fairness opinion 10/14/2013; fee ~$8.1M ($0.75M on opinion delivery; balance contingent on completion); barred from buyer-side acquisition financing without consent'],\\n ['Goodwin Procter LLP', 'Mac-Gray; outside legal counsel', 'First observed on the mandate 05/09/2013 (R005); negotiated exclusivity, the merger agreement and the Pamplona commitment letter; advised on fiduciary duties'],\\n ['Kirkland & Ellis LLP', 'CSC/Pamplona; outside legal counsel', 'First observed 09/25/2013 receiving the initial merger agreement draft (R045); negotiated the merger agreement and commitment letter'],\\n])\\nput('Aliases and relationships', 'Pamplona = Pamplona Capital Partners III, L.P. (the sponsor fund; CSC\\\\u2019s owner). Buyer chain: CSC ServiceWorks Holdings, Inc. \\\\u2192 CSC ServiceWorks, Inc. \\\\u2192 Spin Holdco Inc. (Parent) \\\\u2192 CSC Fenway, Inc. (Merger Subsidiary); CSC/Pamplona bids as one unit. Party A, Party B and Party C are the filing\\\\u2019s anonymous names; no individual identities are inferred. Public/private and country attributes: Mac-Gray (US/Delaware, NYSE-listed); CSC group (US/Delaware; workforce across US, Canada and Europe); Pamplona (sponsor fund).')\\n\\nput_block('5. Counts and auction screen')\\nput('Method', 'Ledger-derived figures use SUMIFS over Count (column Q) filtered by What happened (D), Process (E), Round (F) and Include (P), excluding Include = No. Count is a scoped tally contribution, not a population balance; a sum of populated Count cells is not a complete total where rows remain blank. The initial Party A Bid carries first-round contact evidence and is included in the Round 1 tally explicitly (formula adds Round 0 bids).')\\nput_table(['Metric', 'Ledger-derived value (formula)', 'Filing assertion (source)', 'Reconciliation / notes'], [\\n ['Confidentiality agreements (Process 1)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"NDA signed\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n  '20 potential bidders entered confidentiality agreements: 2 strategic (Party A, CSC/Pamplona) + 18 financial incl. Party B, Party C (X-025 detail P-025)', '4 individually recorded signers + 16 residual financial signers = 20. The residual is a partition of the stated total, not independent validation; population overlap between named and unnamed signers is assumed disjoint per section 5.2.'],\\n ['First contacts', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Contact\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")+SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Target interest\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n  'BofA Merrill Lynch contacted the parties identified at the June 24 meeting; a total of 50 parties were identified (P-023/P-024); contacts with Party A and Pamplona reported 06/28/2013 (P-004, P-026)',\\n  '2 individually recorded first contacts (Party A 04/08/2013; CSC/Pamplona by 06/28/2013). The other 48 approaches are reported only at aggregate level, so this total covers named contacts only \\\\u2014 incomplete by design.'],\\n ['Parties approached', '(no ledger sum \\\\u2014 50 is not a Count row)', '50 parties: 15 strategic, 35 financial (P-023/P-024)', '30 approached parties did not sign agreements and never entered; the filing reports no individual outcomes for them, and none are invented.'],\\n ['Round 1 bidders', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F:$F,1,\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")+SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F:$F,0,\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n  'Four bidders considered (three preliminary indications plus the Party A June 21 proposal) (P-036); four interested bidders advanced (P-038)', '4 = 3 Round-1 submissions + Party A\\\\u2019s standing Round-0 proposal (R008). The formula includes Round 0 explicitly; a blanket sum over Round 1 Bid rows would show 3.'],\\n ['Round 2 bidders / Round 3 bidders / Round 4 bids', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F:$F,2,\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\"); Round 3: same for \\\"Bid\\\" + \\\"Bid reaffirmed\\\"; Round 4: same for \\\"Bid\\\"',\\n  'Revised indications reviewed 09/11/2013 (P-052, P-054); final indications 09/18/2013 (P-058); $21.25 confirmation 09/21/2013 (P-062)', 'Round 2 = 4; Round 3 = 3 (2 submissions + 1 reaffirmation); Round 4 = 1. Round tallies are stage-specific units, not unique bidders across the deal.'],\\n ['Non-submissions', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n  'Party C absent at the final due date (P-058); the continuing set was the four named bidders (P-036, P-038)', '17 affected units = Party C (stated, 1) + 16 residual signers (inferred residual, 16).'],\\n ['Exclusivity drops', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Dropped by target\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n  'Exclusivity executed with CSC/Pamplona 09/24/2013 (P-067)', '2 affected units (Party A and Party B), both Inferred: exclusivity; no notice, reason or voluntary exit inferred.'],\\n ['Auction screen', 'Met', '\\\\u2014',\\n  'More than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements (20 signers; at least Party A and CSC/Pamplona as separate strategic units, plus 18 financial). Excluded: no lender-only, adviser or rollover-holder agreements reported; no agreements expressly reused from an earlier attempt reported.'],\\n])\\nput('Per-stage balance (Process 1)', 'Participants stock = entrants \\\\u2212 stated exits \\\\u2212 inferred exits + re-entries. R1: 20 \\\\u2212 16 (residual non-submitters) = 4. R2: 4 \\\\u2212 0 = 4. R3: 4 \\\\u2212 1 (Party C) = 3. R4: 3 \\\\u2212 2 (exclusivity drops) = 1 = winner. At signing only the winner remains; no go-shop; no post-signing entrants. Exit events: 19 total \\\\u2014 1 stated (Party C), 18 inferred (16 residual + 2 exclusivity drops); inferred share is visible, not forced.')\\n\\nput_block('6. Comparability and inputs')\\nput('Other-scope proposals', 'None observed: every recorded proposal concerned the whole company\\\\u2019s equity. No segment, asset, minority-stake or unresolved-scope bids were recorded, so no Other-scope bid rows exist and no non-comparability adjustment is applied.')\\nput('Consideration structure', 'All proposals were all-cash except Party B\\\\u2019s 09/18/2013 package: $19.00 cash at closing plus options for the remainder (10% of the new equity; strike price equal to Party B\\\\u2019s initial cost basis; vesting on the base-case management projections over about five years, excluding future acquisitions; bidder-stated option value $2.50 per share). Price cells carry the bidder-stated $21.50 with All cash = No and Cash at closing $19.00; no CVR or earnout is present. Currency USD throughout.')\\nput('Projections and benchmarks', 'Management projections prepared June 2013 for 2013\\\\u20132018 (Without Acquisitions and With Acquisitions cases); used in BofA Merrill Lynch\\\\u2019s analyses and as the Party B options\\\\u2019 vesting benchmark, with extensive cautionary language. Market benchmarks: 10/11/2013 close $14.72; 52-week high $15.61 (period ending 10/11/2013); 11/27/2013 close $21.30.')\\nput('Stated inputs', 'Shares outstanding 14,758,306 as of the 11/27/2013 record date; merger consideration $21.25; Pamplona commitment up to $594M; damages cap $50M; HSR filed 10/29/2013 and waiting period expired 11/27/2013. Net debt: not disclosed.')\\nput('Labelled conversion', 'Implied equity value \\\\u2248 $313.6M = 14,758,306 \\\\u00d7 $21.25 (simple product of stated inputs; not a filing figure; ignores equity awards, dilution, net debt and any other adjustments, none of which are disclosed in the supplied filing).')\\nput('Glossary', 'NDA = confidentiality agreement. IOI = indication of interest. LOI = letter of intent. Due diligence = investigation of the target. Exclusivity = a period in which the target negotiates only with one bidder. Reverse termination fee = fee payable by the buyer to the target on specified terminations ($15M here). Go-shop = agreement-provided post-signing solicitation period (none here; only a fiduciary out for unsolicited superior proposals). CVR = contingent value right (none here). Equity value = value of the shares; enterprise value = the business before debt/cash adjustments (not used for the bid prices).')\\n\\n# ---------------- Questions ----------------\\nqhead = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\\nws_q.append(qhead)\\nfor c in range(1, len(qhead)+1):\\n    cell = ws_q.cell(row=1, column=c); cell.fill = head_fill; cell.font = head_font\\n    cell.alignment = Alignment(wrap_text=True, vertical='center')\\nqw = [8,26,72,72,30,40,10,26]\\nfor i, w in enumerate(qw, 1):\\n    ws_q.column_dimensions[get_column_letter(i)].width = w\\n\\nquestions = [\\n ['Q1','Process segmentation and round map',\\n  'Accept one process (Process 1) and the four-round map. R1 anchor = 06/24/2013 sale decision (rejected candidates: 10/23/2012 engagement R002, 04/08/2013 contact R004, 06/21/2013 proposal R008; first outreach wave undated). R2 = 07/25/2013 selection/staging (reject 08/27/2013 letter R026 as the boundary). R3 = 09/11/2013 final-indication request (Announced as final). R4 = 09/21/2013 move to exclusive negotiation (Inferred final; alternatives 09/19 R039 and 09/24 R042). Treat the 2011-2012 Discussions as reverse-direction context, not a prior sale attempt.',\\n  'R1 anchor and 50-party outreach: P-022, P-023, P-024; R2: P-037, P-038; R3: P-055; R4: P-061, P-062; context P-002. Working dates and finality as recorded on rows R001, R010, R023, R033, R040.',\\n  'R001, R002, R004, R007, R008, R010, R023, R033, R040 (Process, Round, Round finality, Due date)',\\n  'Renumbers rounds and moves bid/outcome rows and tallies; Summary round map changes. No facts change.',\\n  'Pending',''],\\n ['Q2','Deadlines and their treatment',\\n  'Accept: 07/23/2013 (preliminary IOIs) = Late bids accepted (Party B and Party C submitted 07/24 and were reviewed 07/25); 09/09/2013 (revised written proposals) = Late bids accepted (Party A and Party C submitted 09/10 and were reviewed 09/11); 09/18/2013 (final indications) = Enforced (selection/exclusivity authorized the next day on the bids in hand). Exclusivity expiries (10/12/2013; extended to 10/15/2013) are recorded in Terms, not as Deadline rows.',\\n  'Due dates: P-025; late submissions and review: P-035, P-036, P-052, P-054; final due date and next step: P-055, P-058, P-061; exclusivity extension: P-077, P-081.',\\n  'R017, R026, R027, R034, R042, R048 (Deadline treatment, Due date)',\\n  'Treatment labels only; no price or participation changes. If the 09/18 round were read as unclear, Enforced would fall back to Unclear.',\\n  'Pending',''],\\n ['Q3','NDA population, residual cohorts and the auction screen',\\n  'Accept the representation: 20 confidentiality signers = 4 individually recorded (Party A, Party B, Party C, CSC/Pamplona) + 16 residual financial signers; 16 residual non-submitters at 07/23/2013. Base caveat: the filing elsewhere refers to \\\"other potential bidders\\\" and does not date every signing, so if unnamed signers submitted indications the residual would shrink; flag on review but keep as the filing\\\\u2019s stated-base inference. Auction screen: met.',\\n  '20 signers and composition P-025; four bidders P-036, P-038; \\\"other potential bidders\\\" (Reasons) X-018.',\\n  'R011, R019, R012\\\\u2013R016, R018\\\\u2013R021, R025, R046 (Count, Type, Outcome basis)',\\n  'Changes residual counts and the non-submitter cohort; screening conclusion (met) is unchanged on any reading with at least two independent signers.',\\n  'Pending',''],\\n ['Q4','Inferred participation outcomes (closing rows)',\\n  'Accept: Party A and Party B Dropped by target on 09/24/2013 (Inferred: exclusivity; Decided by Target; Exit reason Not stated; no notice inferred) and the 16 residual signers Did not submit at 07/23/2013 (Inferred: residual; arithmetic shown on the row). Party C\\\\u2019s 09/18/2013 non-submission is stated (no reasons \\\\u2192 Decided by Unknown; Exit reason Not stated). Inferred rows state only that the participant was out by that transition.',\\n  'Exclusivity execution P-067; live rival bids P-058; base and accounting P-025, P-036, P-038.',\\n  'R019, R038, R043, R044 (Outcome basis, Decided by, Exit reason, Count)',\\n  'If a named exit for an anonymous signer were later established, it would be an identity mapping only \\\\u2014 no counts move; if Party C\\\\u2019s silence were read as withdrawal, relabel Withdrew (agency still unknown).',\\n  'Pending',''],\\n ['Q5','Formality of final-round indications',\\n  'Accept Formal for the 09/18/2013 final-round rows (CSC/Pamplona R035, Party B R037, Party A reaffirmation R036) as responses on the requested basis to a genuine final solicitation; earlier indications remain Informal; no returned markups or full agreements by any bidder; the winner therefore reaches signing with a Formal row and no late-reconfirmation row is needed. Borderline: the documents remain indications of interest (Party A\\\\u2019s oral) \\\\u2014 flagged.',\\n  'Final request and responses P-055, P-058; winner reaches agreement P-061, P-062, P-066, P-067.',\\n  'R028\\\\u2013R031 (Informal), R035\\\\u2013R037 (Formal), R041 (carried Formal), R008, R018\\\\u2013R021 (Informal)',\\n  'If all stay Informal, the winner has no Formal row and the deal reads as an informal-only process; bidding counts and prices do not change.',\\n  'Pending',''],\\n ['Q6','Conditions levels (diligence-period and financing readings)',\\n  'Accept: CSC/Pamplona 09/09, 09/18 and 09/21 rows = Light (committed financing; the two-week exclusive negotiation is treated as an exclusivity request, not an attached substantive diligence period); Party A and Party B rows = Heavy (reported absence of a firm financing commitment; Party B\\\\u2019s third-party debt and contingent options); the July pre-diligence indications (Party A, Party B, Party C, CSC/Pamplona) = Heavy by context; no Conditions level None is used. Every level is reassessed per bid, not carried forward blindly (CSC/Pamplona moved Heavy at 07/23 \\\\u2192 Light once capital was committed).',\\n  'Financing statements P-051, P-052; exclusivity requests P-051, P-058, P-062; certainty assessment P-061; pre-diligence context P-034, P-035; diligence period P-046, P-068.',\\n  'R008, R018\\\\u2013R021, R028\\\\u2013R031, R035\\\\u2013R037, R041 (Conditions level, Conditions detail)',\\n  'Reading the two-week exclusivity as an attached diligence period would move CSC/Pamplona\\\\u2019s last rows to Heavy and change the buyer-commitment profile presented in Summary.',\\n  'Pending',''],\\n ['Q7','Prices, package values and consideration comparability',\\n  'Accept: Party B\\\\u2019s 09/18/2013 row carries the bidder-stated package value $21.50 in the price cells with Price origin Stated, All cash = No, Cash at closing $19.00, and the $2.50 option value and five-year vesting in Terms; alternative would be to populate only $19.00 and leave the package in Terms. Ranges stay ranges (no midpoints); Party A\\\\u2019s 09/18/2013 reaffirmation is Carried forward; USD throughout; no bound-only, other-scope, share-exchange or CVR consideration in this deal.',\\n  'Party B package P-058; ranges P-019, P-035, P-039, P-052; $21.25 P-062, P-064; comparability X-006, X-011.',\\n  'R037, R035, R036, R028\\\\u2013R031, R018\\\\u2013R021, R008 (Price low/high, Price kind, Price origin, All cash, Cash at closing)',\\n  'Changes how Party B\\\\u2019s nominal $21.50 package compares with CSC/Pamplona\\\\u2019s $21.25 cash; no ranking change is asserted by the ledger.',\\n  'Pending',''],\\n ['Q8','Dates, ordering and rollover conventions',\\n  'Accept the stated conventions: 2011-2012 window midpoint 01/15/2012 (R001); residual NDA cohort Working date 06/24/2013 (Assigned: bound, R011); \\\"by\\\" rows (R012, R019, R038, R043, R044) use Date to = bound with Assigned methods and When \\\"by \\\\u2026\\\"; the \\\"July 27, 2103\\\" source typo reads 07/27/2013 (R024 reason); Moab rollover uses two rows (denial R015; resolution R047, folding the 09/23/2013 facilitation); MacDonald rollover resolution R032; same-day row order within rounds (e.g., 06/24, 07/25, 09/11, 09/18, 09/21, 09/24) is a deterministic display convention, including that Party C\\\\u2019s non-submission (R038) is displayed after the same-day submissions.',\\n  'Window text P-002; NDA window P-025; contact bound P-026; drops P-067; non-submissions P-058; typo P-040; rollover P-031, P-053, P-065, P-072.',\\n  'R001, R012, R019, R032, R038, R043, R044, R047 (Date from/to, Working date, Date basis, Date method)',\\n  'Re-sorts or re-bounds individual rows; no facts, prices or counts change.',\\n  'Pending',''],\\n]\\nfor q in questions:\\n    ws_q.append(q)\\nfor r in range(2, 2 + len(questions)):\\n    ws_q.row_dimensions[r].height = 150\\n    for c in range(1, 9):\\n        ws_q.cell(row=r, column=c).alignment = wrap\\nws_q.freeze_panes = 'A2'\\nws_q.auto_filter.ref = 'A1:H%d' % (len(questions) + 1)\\n\\n# ---------------- Source text ----------------\\nws_src.append(['Paragraph','Section','Page','Text'])\\nfor c in range(1, 5):\\n    cell = ws_src.cell(row=1, column=c); cell.fill = head_fill; cell.font = head_font\\n    cell.alignment = Alignment(wrap_text=True, vertical='center')\\nws_src.column_dimensions['A'].width = 11\\nws_src.column_dimensions['B'].width = 42\\nws_src.column_dimensions['C'].width = 7\\nws_src.column_dimensions['D'].width = 150\\nfor i, k in enumerate(src_order):\\n    r = i + 2\\n    p = para[k]\\n    ws_src.cell(row=r, column=1, value=k)\\n    ws_src.cell(row=r, column=2, value=p['section'])\\n    pg = int(p['page']) if p['page'].isdigit() else p['page']\\n    ws_src.cell(row=r, column=3, value=pg)\\n    c4 = ws_src.cell(row=r, column=4, value=p['text'])\\n    for c in range(1, 5):\\n        ws_src.cell(row=r, column=c).alignment = wrap\\n    ws_src.row_dimensions[r].height = est_height([(p['text'], 150)])\\nnote_r = len(src_order) + 2\\nws_src.cell(row=note_r, column=1, value='Note')\\nws_src.cell(row=note_r, column=2, value='Source text declaration')\\nws_src.cell(row=note_r, column=4, value='Source text decoded from the filed HTML with layout-only decoding and whitespace normalization; no wording, punctuation, numbers or qualifications changed. Printed page numbers follow the filing pagination (component markers). Paragraph IDs were assigned by the extracting session: P-001 onward for the complete background in source order; X-001 onward for every other passage used. Quotations in the ledger are recoverable from the cited rows.')\\nfor c in range(1, 5):\\n    ws_src.cell(row=note_r, column=c).alignment = wrap\\nws_src.freeze_panes = 'A2'\\nws_src.auto_filter.ref = 'A1:D%d' % note_r\\n\\nwb.save(OUT)\\nprint('saved', OUT)\\nprint('ledger rows:', len(rows), 'source paragraphs:', len(src_order))\\nPYEOF\\npython3 /tmp/opencode/macgray/build_ledger.py\"}"},"time":{"start":1789824927648,"end":1789824959671}}}}
