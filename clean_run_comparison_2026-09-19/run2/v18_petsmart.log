{"type":"text","timestamp":1789825505292,"sessionID":"ses_f461eb89fffeglVev82zxa58vo","part":{"id":"prt_0b9e9677d001wPQ0abgORL6uV1","sessionID":"ses_f461eb89fffeglVev82zxa58vo","messageID":"msg_0b9e95e3c001va7MRel9nII0aM","type":"text","text":"Now I'll build the workbook. This is a substantial script — I'll write it with exact-quote validation against the filing text.","time":{"start":1789825476477,"end":1789825505292}}}
{"type":"tool_use","timestamp":1789825505304,"sessionID":"ses_f461eb89fffeglVev82zxa58vo","part":{"partID":"prt_0b9e9680d001V2EXPEzm6LKjnA","sessionID":"ses_f461eb89fffeglVev82zxa58vo","messageID":"msg_0b9e95e3c001va7MRel9nII0aM","type":"tool","id":"call_00_elIGP4SA4F5yRKdItrvv9358","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/petsmart/build.py","content":"# -*- coding: utf-8 -*-\n\"\"\"Build petsmart.xlsx deal ledger from the DEFM14A background.\"\"\"\nimport re, datetime\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\n\nFILING = '/tmp/opencode/petsmart/filing.txt'\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\n\n# ---------------------------------------------------------------- text matching\nraw = open(FILING, encoding='utf-8').read()\n\ndef norm_char(c):\n    return {\n        '\\u2019': \"'\", '\\u2018': \"'\", '\\u201c': '\"', '\\u201d': '\"',\n        '\\u2013': '-', '\\u2014': '-', '\\u2018': \"'\",\n    }.get(c, c)\n\ntokens = [(m.group(0), m.start(), m.end()) for m in re.finditer(r'\\S+', raw)]\nnorm_toks = []\nfor t, s, e in tokens:\n    nt = ''.join(norm_char(c) for c in t)\n    nt = nt.replace('\\u200b', '')\n    norm_toks.append(nt)\n\ndef extract_quote(q):\n    \"\"\"Find q in the filing by token sequence; return the exact filing text with runs of whitespace collapsed to one space.\"\"\"\n    qn = ''.join(norm_char(c) for c in q)\n    qn = qn.replace('\\u200b', '')\n    qs = qn.split()\n    n = len(qs)\n    for i in range(len(norm_toks) - n + 1):\n        if norm_toks[i:i+n] == qs:\n            start = tokens[i][1]\n            end = tokens[i+n-1][2]\n            text = raw[start:end]\n            text = re.sub(r'\\s+', ' ', text)\n            return text\n    raise SystemExit('QUOTE NOT FOUND: %r' % q)\n\ndef wc(s):\n    return len(s.split())\n\n# ---------------------------------------------------------------- ledger rows\n# tuple fields: when, who, type, event, round, plow, phigh, cash, formality, cond,\n#               count, exitreason, inferred, note, quote(raw), page, flag,\n#               sort(y,m,d), dfrom or None, dto or None\nD = datetime.date\nR = []\ndef row(when, who, typ, event, rnd, plow=None, phigh=None, cash=None, form=None,\n        cond=None, count=None, exitr=None, inferred=None, note='', quote='',\n        page='', flag=None, sort=None, dfrom=None, dto=None):\n    R.append(dict(when=when, who=who, typ=typ, event=event, rnd=rnd,\n                  plow=plow, phigh=phigh, cash=cash, form=form, cond=cond,\n                  count=count, exitr=exitr, inferred=inferred, note=note,\n                  quote=quote, page=page, flag=flag, sort=sort,\n                  dfrom=dfrom, dto=dto))\n\n# ---- round 0 --------------------------------------------------------------\nrow('06/18/2014', 'Wachtell Lipton', '', 'Adviser', 0, note=\n    \"Target's outside legal advisor; first seen acting at the June 18 board meeting and present at board and committee meetings through signing.\",\n    quote='At a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (“Wachtell Lipton”), its legal advisor',\n    page='p. 21', sort=D(2014,6,18), dfrom=D(2014,6,18), dto=D(2014,6,18))\n\nrow('07/03/2014', 'JANA Partners', '', 'Activist', 0, note=\n    \"Disclosed 9.9% stake and intent to discuss alternatives including a sale; met the Company on 07/10/2014 advocating a sale; filed amendments and public letters through August 2014.\",\n    quote='JANA intended to engage in discussions with management and the board with respect to a review of strategic alternatives, including a sale of the Company',\n    page='p. 22', sort=D(2014,7,3), dfrom=D(2014,7,3), dto=D(2014,7,3))\n\nrow('07/07/2014', 'Longview', '', 'Activist', 0, note=\n    \"Public letter urged the board to consider a sale and offered to roll part or all of its holdings into acquirer equity if needed; reiterated advocacy in a 07/10/2014 call with the Company.\",\n    quote='Longview made public a letter to the board in which Longview stated that the board should consider the a sale of the Company',\n    page='p. 22', sort=D(2014,7,7), dfrom=D(2014,7,7), dto=D(2014,7,7))\n\nrow('July 2014', 'J.P. Morgan', '', 'Adviser', 0, note=\n    \"Financial advisor; retained in July after the Company interviewed several candidates; engagement letter effective 08/21/2014; served through signing.\",\n    quote='In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor',\n    page='p. 22', sort=D(2014,7,16), dfrom=D(2014,7,1), dto=D(2014,7,31))\n\nrow('08/07/2014', 'Industry Participant', 'Strategic', 'Bidder interest', 0, count=1, note=\n    \"Approached J.P. Morgan about revisiting a combination if PetSmart pursued alternatives; no price; reported to the ad hoc committee; never admitted to the process.\",\n    quote='Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies',\n    page='p. 22', sort=D(2014,8,7), dfrom=D(2014,8,7), dto=D(2014,8,7))\n\nrow('08/13/2014', 'PetSmart (target)', '', 'Target sale decision', 0, note=\n    \"Board determined to explore strategic alternatives including a possible sale; authorized ad hoc committee oversight; planned J.P. Morgan outreach in late September–early October and a public announcement.\",\n    quote='determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders',\n    page='p. 22', sort=D(2014,8,13), dfrom=D(2014,8,13), dto=D(2014,8,13))\n\nrow('08/19/2014', 'PetSmart (target)', '', 'Sale process announced', 0, note=\n    \"Press release concurrent with second-quarter earnings announced exploration of strategic alternatives including a possible sale; interested parties could contact J.P. Morgan directly.\",\n    quote='the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company',\n    page='p. 23', sort=D(2014,8,19), dfrom=D(2014,8,19), dto=D(2014,8,19))\n\nrow('08/22/2014–08/27/2014', 'PetSmart (target)', '', 'Other material event', 0, note=\n    \"Decided Industry Participant would not be invited into the exploratory process (antitrust concerns); communicated via J.P. Morgan calls 08/22 and 08/27; Industry Participant restated interest; no contact since.\",\n    quote='The J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process',\n    page='p. 23', sort=D(2014,8,27), dfrom=D(2014,8,22), dto=D(2014,8,27))\n\nrow('middle of August–end of October 2014', 'Strategic parties (potential participants)', 'Strategic', 'Contact', 0, count=3, note=\n    \"Inbound contacts to J.P. Morgan during process preparation; three strategic parties, not counting Industry Participant; no individual names or outcomes reported.\",\n    quote='including three strategic parties (not counting Industry Participant) and 24 financial participants',\n    page='p. 23', sort=D(2014,9,20), dfrom=D(2014,8,11), dto=D(2014,10,31))\n\nrow('middle of August–end of October 2014', 'Financial parties (potential participants)', 'Financial', 'Contact', 0, count=24, note=\n    \"Inbound contacts during process preparation; includes potential lead buyers and large suppliers of equity capital; the 15 October NDA signers are a subset.\",\n    quote='24 financial participants (including potential lead buyers as well as large suppliers of equity capital to lead buyers)',\n    page='p. 23', sort=D(2014,9,20), dfrom=D(2014,8,11), dto=D(2014,10,31))\n\n# ---- round 1 --------------------------------------------------------------\nrow('first week of October 2014', 'PetSmart (target)', '', 'Round opened', 1, note=\n    \"Process 1 round 1 opened as the Company began confidentiality/standstill agreements and October diligence; non-binding preliminary indications due 10/30.\",\n    quote='In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers',\n    page='p. 23', flag='Q1', sort=D(2014,10,4), dfrom=D(2014,10,1), dto=D(2014,10,7))\n\nrow('first week of October 2014', '15 financial buyers', 'Financial', 'NDA signed', 1, count=15, note=\n    \"Cohort of 15 financial buyers; all received management presentations, detailed financials and Profit Improvement Plan and cost-savings information; no individual names given.\",\n    quote=\"all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company's senior-most management, and received detailed financial and business plan information\",\n    page='p. 23', sort=D(2014,10,4), dfrom=D(2014,10,1), dto=D(2014,10,7))\n\nrow('October 2014', 'PetSmart (target)', '', 'Deadline set', 1, note=\n    \"Informed bidders that non-binding preliminary indications of interest would be due 10/30/2014.\",\n    quote='During October, the potential bidders were informed that non-binding preliminary indications of interest would be due on October 30, 2014',\n    page='p. 23', sort=D(2014,10,16), dfrom=D(2014,10,1), dto=D(2014,10,31))\n\nrow('October 2014', 'Longview', '', 'Other material event', 1, note=\n    \"Told bidders Longview was willing to roll over up to 7.5 million shares on acceptable terms; bidders asked whether interested; participation not a condition.\",\n    quote='Longview had informed the Company that it would be willing to “roll-over” up to 7.5 million shares on terms and price acceptable to Longview',\n    page='p. 23', sort=D(2014,10,16), dfrom=D(2014,10,1), dto=D(2014,10,31))\n\nrow('10/30/2014', 'Buyer Group', 'Financial', 'Bid', 1, plow=81.00, phigh=83.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\n    \"Indication of interest; range $81.00–$83.00; one of three initial indications at or above $80.00; advanced 11/03; consideration form not stated.\",\n    quote='the Buyer Group, which indicated a range of $81.00 to $83.00 per share',\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', 'Unnamed financial bidder 1', 'Financial', 'Bid', 1, plow=80.00, phigh=85.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\n    \"Indication of interest; range $80.00–$85.00; one of three initial indications at or above $80.00; advanced 11/03; consideration form not stated.\",\n    quote='another bidder, which suggested a range of $80.00 to $85.00 per share',\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', 'Unnamed financial bidder 2', 'Financial', 'Bid', 1, cash='Not stated', form='Informal', cond='Light', count=1, inferred='Y', note=\n    \"Identified as the third of the three initial indications at or above $80.00 after the Buyer Group and Unnamed financial bidder 1; price not stated; advanced 11/03.\",\n    quote='Three bidders initially indicated price ranges that reached at least $80.00 per share',\n    page='p. 24', flag='Q4', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', 'Bidder 2', 'Financial', 'Bid', 1, plow=78.00, phigh=78.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\n    \"Initial indication of $78.00; raised after J.P. Morgan's 10/30–11/02 calls; advanced 11/03; bid again 12/10 and 12/12.\",\n    quote='another bidder (which we refer to as “Bidder 2”), which had initially indicated a price of $78.00',\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', '2 other indication submitters', 'Financial', 'Bid', 1, cash='Not stated', form='Informal', cond='Unclear', count=2, inferred='Y', note=\n    \"Residual of six 10/30 submitters after the Buyer Group, Bidder 2 and the two individually recorded unnamed indications; prices not stated; both below $80.00.\",\n    quote='six of the potentially interested parties submitted indications of interest',\n    page='p. 24', flag='Q3', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', 'PetSmart (target)', '', 'Deadline', 1, note=\n    \"Due date for preliminary indications; six submitted (rows #15–#19).\",\n    quote='non-binding preliminary indications of interest would be due on October 30, 2014',\n    page='p. 23', flag='Q2', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014', '9 financial NDA signers', 'Financial', 'Did not submit', 1, count=9, exitr='Not stated', inferred='Y', note=\n    \"15 NDA signers − 6 submitters = 9; no submissions or reasons reported; closed at the due date.\",\n    quote='six of the potentially interested parties submitted indications of interest',\n    page='p. 24', flag='Q3', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\n\nrow('10/30/2014–11/02/2014', 'Bidder 2', 'Financial', 'Bid', 1, plow=81.00, phigh=84.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\n    \"Raised from $78.00 to $81.00–$84.00 during J.P. Morgan's 10/30–11/02 rationale calls; helped qualify it for the final round; late relative to the 10/30 due date.\",\n    quote='increased its indication to a range of $81.00 to $84.00 per share',\n    page='p. 24', flag='Q2', sort=D(2014,10,31), dfrom=D(2014,10,30), dto=D(2014,11,2))\n\n# ---- round 2 --------------------------------------------------------------\nrow('11/03/2014', 'PetSmart (target)', '', 'Round opened', 2, note=\n    \"Board advanced the four bidders at or above $80.00 to the final round; eliminated parties notified; November diligence, form merger agreement and FY2014 projection updates followed.\",\n    quote='determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process',\n    page='p. 24', flag='Q1', sort=D(2014,11,3), dfrom=D(2014,11,3), dto=D(2014,11,3))\n\nrow('11/03/2014', '2 eliminated indication submitters', 'Financial', 'Dropped by target', 2, count=2, exitr='Lower offer than rivals', inferred='Y', note=\n    \"6 submitters − 4 advanced = 2; indications below $80.00; notified by J.P. Morgan; none sought to remain above its respective initial indication.\",\n    quote='representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process',\n    page='p. 24', sort=D(2014,11,3), dfrom=D(2014,11,3), dto=D(2014,11,3))\n\nrow('November 2014', 'Bidder 3', 'Financial', 'Bidding group changed', 2, count=2, note=\n    \"Two finalists permitted to work together and named Bidder 3 (one wanted an equity partner; one would drop out otherwise); members not identified (likely Unnamed financial bidders 1–2, see Q4); each leaves independent bidding.\",\n    quote='the ad hoc committee authorized these two bidders to work together. We refer to these two bidders together as “Bidder 3.”',\n    page='p. 24', flag='Q4', sort=D(2014,11,16), dfrom=D(2014,11,3), dto=D(2014,11,30))\n\nrow('12/04/2014–12/05/2014', 'PetSmart (target)', '', 'Deadline set', 2, note=\n    \"Ad hoc committee set the evening of 12/10 for final bids (moved up from the initial 12/05 plan, citing leak risk); asked for markups and financing commitments in advance.\",\n    quote='set the evening of Wednesday, December 10 (five days, rather than 10 days prior to the anticipated December 15 completion date) as the deadline for submission of final bids',\n    page='p. 25', sort=D(2014,12,4), dfrom=D(2014,12,4), dto=D(2014,12,5))\n\nrow('12/10/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=80.70, phigh=80.70, cash='Yes', form='Formal', cond='Light', count=1, note=\n    \"Final bid with revised merger agreement/documents; financing commitment documents provided 12/06; documentation less conditional and more favorable than Bidder 2's; not dependent on a Longview rollover.\",\n    quote='The Buyer Group offered $80.70 per share, in cash',\n    page='p. 25', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\n\nrow('12/10/2014', 'Bidder 2', 'Financial', 'Bid', 2, plow=80.35, phigh=80.35, cash='Yes', form='Formal', cond='Light', count=1, note=\n    \"Final bid with revised merger agreement/documents; rollover accommodation would not affect price and only after a signed agreement; bid again 12/12.\",\n    quote='Bidder 2 offered $80.35 per share, in cash',\n    page='p. 25', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\n\nrow('12/10/2014', 'Bidder 3', 'Financial', 'Did not submit', 2, count=2, exitr='Value at or below market price', note=\n    \"Verbal valuation not above ~$78 current stock price; J.P. Morgan called it unlikely to be competitive; no written offer submitted.\",\n    quote='Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share',\n    page='p. 25', flag='Q4', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\n\nrow('12/10/2014', 'PetSmart (target)', '', 'Deadline', 2, note=\n    \"Final bids due; Buyer Group and Bidder 2 submitted; extended the same evening to 12/12.\",\n    quote='as the deadline for submission of final bids',\n    page='p. 25', flag='Q2', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\n\nrow('12/10/2014', 'PetSmart (target)', '', 'Deadline revised', 2, note=\n    \"Same bidders asked to improve; new due date 12/12; an extension of the final round, not a new round.\",\n    quote='instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014',\n    page='p. 25', flag='Q2', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\n\nrow('12/12/2014', 'Buyer Group and Longview', '', 'Other material event', 2, note=\n    \"Approved Buyer Group's request to include a Longview rollover; Longview and Buyer Group signed a confidentiality agreement allowing exchange of detailed information, including bid price; voting-agreement form instructed.\",\n    quote='Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price',\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\n\nrow('12/12/2014', 'Bidder 2', 'Financial', 'Bid', 2, plow=81.50, phigh=81.50, cash='Yes', form='Formal', cond='Light', count=1, note=\n    \"Best and final; revised merger agreement and financing commitment documents submitted; $81.50 confirmed as best and final.\",\n    quote='During the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash',\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\n\nrow('12/12/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=82.50, phigh=82.50, cash='Yes', form='Formal', cond='Light', count=1, note=\n    \"Oral offer; bidder working to increase within hours; increased to $83.00 same evening.\",\n    quote='The Buyer Group initially submitted an oral offer of $82.50 per share, in cash, but stated that it was working to increase the offer within the next few hours',\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\n\nrow('12/12/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=83.00, phigh=83.00, cash='Yes', form='Formal', cond='Light', count=1, note=\n    \"Best and final; revised drafts in substantially executable form; financing commitments provided; $250 million Longview rollover included.\",\n    quote='Later in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash',\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\n\nrow('12/12/2014', 'PetSmart (target)', '', 'Deadline', 2, note=\n    \"Improved bids due; Bidder 2 $81.50 and Buyer Group $83.00 received; board acted the next day.\",\n    quote='instruct the bidders to submit improved bids on December 12, 2014',\n    page='p. 25', flag='Q2', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\n\nrow('12/13/2014', 'PetSmart (target)', '', 'Other material event', 2, note=\n    \"Board unanimously approved the merger with the Buyer Group and recommended adoption, subject to resolving remaining open points; J.P. Morgan oral fairness opinion; reconvene if needed.\",\n    quote='the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders',\n    page='p. 26', sort=D(2014,12,13), dfrom=D(2014,12,13), dto=D(2014,12,13))\n\nrow('12/14/2014', 'PetSmart, Argos Holdings and Merger Sub', '', 'Merger agreement signed', 2, count=1, note=\n    \"Agreed price $83.00 per share cash; Longview rolls 3,012,050 shares (~$250 million) into Parent equity; equity commitments up to $1.83 billion and $6.95 billion debt financing.\",\n    quote='On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements',\n    page='p. 26', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\n\nrow('12/14/2014', 'PetSmart', '', 'Merger announced', 'post', note=\n    \"Public announcement of the transaction on the signing date.\",\n    quote='issued a press release announcing the transaction',\n    page='p. 26', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\n\nrow('12/14/2014', 'Bidder 2', 'Financial', 'Not selected at signing', 2, count=1, exitr='Lower offer than rivals', note=\n    \"Target chose Buyer Group; Bidder 2's $81.50 best and final was below the $83.00 winning price; still live at signing.\",\n    quote='neither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group',\n    page='p. 27', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\n\nrow('by 12/14/2014', 'Simpson Thacher and Bartlett LLP', '', 'Adviser', 0, inferred='Y', note=\n    \"First seen acting in the merger agreement notices; counsel to Parent/Merger Sub; exact retention date not shown.\",\n    quote='with a copy to: Simpson Thacher and Bartlett LLP',\n    page='p. A-46', sort=D(2014,12,14), dfrom=None, dto=D(2014,12,14))\n\n# check ordering: sort non-decreasing and within [dfrom,dto]\nprev = None\nfor i, r in enumerate(R, 1):\n    s = r['sort']\n    if prev is not None and s < prev:\n        raise SystemExit('sort decreases at row %d: %s < %s' % (i, s, prev))\n    prev = s\n    if r['dfrom'] is not None and not (r['dfrom'] <= s <= (r['dto'] or r['dfrom'])):\n        raise SystemExit('sort outside window at row %d' % i)\n    if r['dto'] is not None and s > r['dto']:\n        raise SystemExit('sort after dto at row %d' % i)\nfor i, r in enumerate(R, 1):\n    for f in ('when', 'who', 'event', 'note', 'quote', 'page'):\n        if not r[f]:\n            raise SystemExit('missing %s at row %d' % (f, i))\n    if wc(r['quote']) > 30:\n        raise SystemExit('quote too long at row %d (%d words)' % (i, wc(r['quote'])))\n    if wc(r['note']) > 40:\n        raise SystemExit('note too long at row %d (%d words)' % (i, wc(r['note'])))\n    r['quote_exact'] = extract_quote(r['quote'])\n\nprint('rows ok:', len(R))\n\n# ---------------------------------------------------------------- workbook\nwb = Workbook()\nhdr_font = Font(bold=True, color='FFFFFF')\nhdr_fill = PatternFill('solid', fgColor='1F4E78')\nwrap = Alignment(wrap_text=True, vertical='top')\nthin = Side(style='thin', color='D9D9D9')\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\n\ndef style_sheet(ws, widths):\n    for j, w in enumerate(widths, 1):\n        ws.column_dimensions[get_column_letter(j)].width = w\n    for c in ws[1]:\n        c.font = hdr_font\n        c.fill = hdr_fill\n        c.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\n    for r in ws.iter_rows(min_row=2):\n        for c in r:\n            c.alignment = wrap\n            c.border = border\n    ws.freeze_panes = 'A2'\n    ws.auto_filter.ref = ws.dimensions\n    ws.row_dimensions[1].height = 30\n\n# --- Deal ledger\nws = wb.active\nws.title = 'Deal ledger'\nhdr = ['#','When','Who','Type','Event','Process','Round','Price low','Price high','All cash',\n       'Formality','Conditions','Count','Exit reason','Inferred','Note','Quote and page','Flag',\n       'Reviewer note','Sort date','Date from','Date to']\nws.append(hdr)\nfor i, r in enumerate(R, 1):\n    ws.append([i, r['when'], r['who'], r['typ'], r['event'], 1, r['rnd'], r['plow'], r['phigh'],\n               r['cash'], r['form'], r['cond'], r['count'], r['exitr'], r['inferred'],\n               r['note'], '%s (%s)' % (r['quote_exact'], r['page'].replace('p. ', '')),\n               r['flag'], None, r['sort'], r['dfrom'], r['dto']])\nstyle_sheet(ws, [4,20,22,10,20,8,6,9,9,10,10,10,7,18,8,60,60,6,14,11,11,11])\nfor row_i in range(2, ws.max_row+1):\n    for col in ('T','U','V'):\n        ws['%s%d' % (col, row_i)].number_format = 'MM/DD/YYYY'\n    # price columns\n    for col in ('H','I'):\n        cell = ws['%s%d' % (col, row_i)]\n        if cell.value is not None:\n            cell.number_format = '0.00'\n\n# --- Rounds\nws2 = wb.create_sheet('Rounds')\nws2.append(['Process','Round','Opened','How opened','Who was in','Due dates','Deadline outcome','Finality','Bids received','How it ended'])\nws2.append([1,1,D(2014,10,4),\n    'Company entered confidentiality and standstill agreements with 15 financial buyers; October diligence and management presentations began',\n    '15 financial buyers (all NDA signers; due diligence and management presentations)',\n    '10/30/2014',\n    'Late bids accepted',\n    'Not final',\n    '6 submitters: Buyer Group ($81.00–$83.00); Unnamed financial bidder 1 ($80.00–$85.00); Bidder 2 ($78.00); Unnamed financial bidder 2 (price not stated); 2 others (prices not stated)',\n    'four advanced at 11/03 (Buyer Group, Bidder 2, Unnamed financial bidders 1 and 2); 2 submitters eliminated; 9 signers did not submit'])\nws2.append([1,2,D(2014,11,3),\n    'Board advanced the four bidders at or above $80.00 to the final round; eliminated parties notified; merger-agreement form and FY2014 projection updates circulated',\n    '4 financial bidders: Buyer Group, Bidder 2, Unnamed financial bidders 1 and 2 (the latter two later combined as Bidder 3)',\n    '12/10/2014 → 12/12/2014',\n    'Extended; Enforced',\n    'Announced as final',\n    'Buyer Group ($80.70, then $82.50 → $83.00); Bidder 2 ($80.35, then $81.50); Bidder 3 gave a verbal valuation only, no written offer',\n    'signing with Buyer Group (12/14/2014)'])\nstyle_sheet(ws2, [8,7,11,45,45,22,20,16,60,45])\nfor row_i in (2,3):\n    ws2['C%d' % row_i].number_format = 'MM/DD/YYYY'\n\n# --- Questions\nws3 = wb.create_sheet('Questions')\nws3.append(['Q','Question','Recommended answer','Why, with page','Rows affected','What changes if answered differently','Reviewer note'])\nqs = [\n ['Q1',\n  \"Round map: one process; Round 1 opens with the first-week-of-October 2014 confidentiality-agreement wave (no dated outreach before it); Round 2 opens 11/03/2014 when four bidders advance to the 'final round'; the 12/10 request to improve by 12/12 is a deadline revision inside Round 2, not a new round. Is this right?\",\n  'Keep it: Round 1 = October solicitation (due 10/30); Round 2 = final round from 11/03 (due 12/10, revised 12/12).',\n  'No target outreach is dated before the October NDA wave (pp. 22–23); the filing calls 11/03 the final round and the December bids final/best-and-final (pp. 24–26); C8 excludes a further improvement request to the same finalists.',\n  '#11, #12, #23; the alternative opening moves #5–#10 into round 1; a Round 3 alternative moves #31–#36.',\n  'Alternative opening moves the round-0 rows into round 1; a third round changes Round 2\\u2019s deadline outcome and the round labels on #31–#36.',\n  None],\n ['Q2',\n  \"Deadline outcomes: Round 1 (due 10/30) — Late bids accepted, because Bidder 2 raised $78.00 to $81.00–$84.00 after the due date, during J.P. Morgan's 10/30–11/02 calls, and the board advanced it; Round 2 — 12/10 Extended, 12/12 Enforced. Correct?\",\n  'Yes, as recorded.',\n  'The revised Bidder 2 indication postdates the 10/30 due date and was considered (p. 24); the committee moved the final-bid date from 12/10 to 12/12 (p. 25); the board acted on the 12/12 bids (p. 26).',\n  '#20, #22; #30, #31, #36.',\n  'If 10/30 were Enforced, #22 is an on-time submission; if 12/12 were not Enforced, only the Rounds sheet changes.',\n  None],\n ['Q3',\n  \"First-round count: the background says six parties submitted indications of interest on 10/30, while the Reasons section says the Company 'received first round indications of interest from 5 bidder groups.' Which count should the ledger use?\",\n  \"Six submitters, following the background's detailed chronology.\",\n  'Six is stated in the operative narrative (p. 24); the reasons-page figure is a summary (p. 27) and the two are not reconciled anywhere in the filing.',\n  '#19, #21.',\n  \"With five submitters, #19's cohort becomes 1 and #21 becomes 15 − 5 = 10.\",\n  None],\n ['Q4',\n  \"Bidder 3's two members are unnamed. Should they be recorded as the two unnamed finalists (Unnamed financial bidders 1 and 2), with Buyer Group and Bidder 2 continuing separately?\",\n  'Yes — of the four finalists, only those two can have combined; the filing never identifies them.',\n  'Four advanced at or above $80.00: Buyer Group, Bidder 2 and the two unnamed indications (p. 24); Buyer Group and Bidder 2 bid separately on 12/10 and 12/12 (pp. 25–26).',\n  '#17, #25, #29.',\n  'If Bidder 3 included a different bidder, the count of independent bidders in the final stage changes (three bidding units either way).',\n  None],\n ['Q5',\n  \"One process or two? PetSmart's spring-2014 contacts with Industry Participant concerned PetSmart buying it, and Industry Participant was never admitted; the sell-side process ran from 08/13/2014 to signing. Should Number of processes stay 1?\",\n  'Yes — one process (Process 1); the spring episode is not a sell-side process.',\n  'C1: a target\\u2019s attempt to buy another company is not its sale process; the filing reports no abandoned sell-side attempt or restart (pp. 21–23).',\n  'Deal facts only; no ledger rows.',\n  'If two processes, a Process terminated/Process restarted pair and spring contact rows would be added.',\n  None],\n]\nfor q in qs:\n    ws3.append(q)\nstyle_sheet(ws3, [6,60,45,60,45,55,14])\n\n# --- Deal facts\nws4 = wb.create_sheet('Deal facts')\nws4.append(['Field','Value'])\nfacts = [\n ['Target', 'PetSmart, Inc., a Delaware corporation (NASDAQ: PETM); 99,455,151 shares outstanding on the 01/29/2015 record date.'],\n ['Acquirer', 'Argos Holdings Inc. (Parent) and Argos Merger Sub Inc., to be owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP, and (after 12/12/2014) Longview Asset Management, LLC.'],\n ['Acquirer type', 'Financial — private-equity/sponsor consortium (with a Longview rollover); no strategic bidder reached the final round.'],\n ['Agreed price and consideration', '$83.00 per share in cash; Longview contributes 3,012,050 shares (~$250 million) to Parent as rollover equity. Parent estimates ~$8.4 billion total funds required, with $6.95 billion debt commitments and up to $1.83 billion cash equity commitments.'],\n ['Merger agreement signed', D(2014,12,14)],\n ['Merger announced', D(2014,12,14)],\n ['Filing type and date', 'DEFM14A definitive proxy statement dated 02/02/2015 (special meeting 03/06/2015).'],\n ['Background pages', '21–26'],\n ['Initiation', 'Activist-influenced — JANA Partners\\u2019 13D and Longview\\u2019s public advocacy preceded the board\\u2019s 08/13/2014 decision to explore a sale; Industry Participant also re-approached J.P. Morgan on 08/07/2014.'],\n ['Number of processes', '1'],\n ['Auction screen (C1)', 'Met — 15 independent prospective acquirers (all financial buyers) executed confidentiality and standstill agreements with the Company in the process.'],\n ['Whole-company bids', 'Yes — all indications and bids were for the whole company (e.g., Buyer Group $83.00 per share in cash).'],\n ['Currency and units of bid prices', 'US dollars, per share of common stock (all bids were cash; October indications did not state form).'],\n ['Target financial advisers', 'J.P. Morgan Securities LLC (sole financial advisor; engagement letter effective 08/21/2014).'],\n ['Target legal advisers', 'Wachtell, Lipton, Rosen & Katz.'],\n ['Account', \"\\\"PetSmart's board began reviewing alternatives in early 2014 and, after JANA Partners disclosed a 9.9% stake on July 3, 2014 and Longview publicly urged a sale, decided on August 13 to explore a sale and announced it on August 19. A private strategic suitor, Industry Participant, re-approached J.P. Morgan on August 7 but was told it would not be invited, because of antitrust-timing risk. During mid-August to end-October J.P. Morgan was contacted by 27 potential participants (three strategic, 24 financial); 15 financial buyers signed confidentiality and standstill agreements in the first week of October, received diligence and management presentations, and submitted one of six non-binding indications of interest due October 30. On November 3 the board advanced the four bidders at or above $80.00 to the final round; two of them combined as Bidder 3, which then valued the company at or below the market price and submitted nothing. Buyer Group bid $80.70 and Bidder 2 $80.35 on December 10; after the committee demanded improvement, their best-and-final bids on December 12 were $83.00 and $81.50, and the board approved the Buyer Group deal on December 13. The parties executed on December 14, 2014: $83.00 per share in cash, with Longview rolling 3,012,050 shares (~$250 million) into the buyer and no strategic acquirer reaching the final round.\\\"\"],\n]\nfor f in facts:\n    ws4.append(f)\nstyle_sheet(ws4, [32, 120])\nfor row_i in (5,6):\n    ws4['B%d' % row_i].number_format = 'MM/DD/YYYY'\n\nwb.save(OUT)\nprint('saved', OUT)\n"},"output":"Created file successfully: /tmp/opencode/petsmart/build.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/petsmart/build.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/petsmart/build.py\", \"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build petsmart.xlsx deal ledger from the DEFM14A background.\\\"\\\"\\\"\\nimport re, datetime\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\n\\nFILING = '/tmp/opencode/petsmart/filing.txt'\\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\\n\\n# ---------------------------------------------------------------- text matching\\nraw = open(FILING, encoding='utf-8').read()\\n\\ndef norm_char(c):\\n    return {\\n        '\\\\u2019': \\\"'\\\", '\\\\u2018': \\\"'\\\", '\\\\u201c': '\\\"', '\\\\u201d': '\\\"',\\n        '\\\\u2013': '-', '\\\\u2014': '-', '\\\\u2018': \\\"'\\\",\\n    }.get(c, c)\\n\\ntokens = [(m.group(0), m.start(), m.end()) for m in re.finditer(r'\\\\S+', raw)]\\nnorm_toks = []\\nfor t, s, e in tokens:\\n    nt = ''.join(norm_char(c) for c in t)\\n    nt = nt.replace('\\\\u200b', '')\\n    norm_toks.append(nt)\\n\\ndef extract_quote(q):\\n    \\\"\\\"\\\"Find q in the filing by token sequence; return the exact filing text with runs of whitespace collapsed to one space.\\\"\\\"\\\"\\n    qn = ''.join(norm_char(c) for c in q)\\n    qn = qn.replace('\\\\u200b', '')\\n    qs = qn.split()\\n    n = len(qs)\\n    for i in range(len(norm_toks) - n + 1):\\n        if norm_toks[i:i+n] == qs:\\n            start = tokens[i][1]\\n            end = tokens[i+n-1][2]\\n            text = raw[start:end]\\n            text = re.sub(r'\\\\s+', ' ', text)\\n            return text\\n    raise SystemExit('QUOTE NOT FOUND: %r' % q)\\n\\ndef wc(s):\\n    return len(s.split())\\n\\n# ---------------------------------------------------------------- ledger rows\\n# tuple fields: when, who, type, event, round, plow, phigh, cash, formality, cond,\\n#               count, exitreason, inferred, note, quote(raw), page, flag,\\n#               sort(y,m,d), dfrom or None, dto or None\\nD = datetime.date\\nR = []\\ndef row(when, who, typ, event, rnd, plow=None, phigh=None, cash=None, form=None,\\n        cond=None, count=None, exitr=None, inferred=None, note='', quote='',\\n        page='', flag=None, sort=None, dfrom=None, dto=None):\\n    R.append(dict(when=when, who=who, typ=typ, event=event, rnd=rnd,\\n                  plow=plow, phigh=phigh, cash=cash, form=form, cond=cond,\\n                  count=count, exitr=exitr, inferred=inferred, note=note,\\n                  quote=quote, page=page, flag=flag, sort=sort,\\n                  dfrom=dfrom, dto=dto))\\n\\n# ---- round 0 --------------------------------------------------------------\\nrow('06/18/2014', 'Wachtell Lipton', '', 'Adviser', 0, note=\\n    \\\"Target's outside legal advisor; first seen acting at the June 18 board meeting and present at board and committee meetings through signing.\\\",\\n    quote='At a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (“Wachtell Lipton”), its legal advisor',\\n    page='p. 21', sort=D(2014,6,18), dfrom=D(2014,6,18), dto=D(2014,6,18))\\n\\nrow('07/03/2014', 'JANA Partners', '', 'Activist', 0, note=\\n    \\\"Disclosed 9.9% stake and intent to discuss alternatives including a sale; met the Company on 07/10/2014 advocating a sale; filed amendments and public letters through August 2014.\\\",\\n    quote='JANA intended to engage in discussions with management and the board with respect to a review of strategic alternatives, including a sale of the Company',\\n    page='p. 22', sort=D(2014,7,3), dfrom=D(2014,7,3), dto=D(2014,7,3))\\n\\nrow('07/07/2014', 'Longview', '', 'Activist', 0, note=\\n    \\\"Public letter urged the board to consider a sale and offered to roll part or all of its holdings into acquirer equity if needed; reiterated advocacy in a 07/10/2014 call with the Company.\\\",\\n    quote='Longview made public a letter to the board in which Longview stated that the board should consider the a sale of the Company',\\n    page='p. 22', sort=D(2014,7,7), dfrom=D(2014,7,7), dto=D(2014,7,7))\\n\\nrow('July 2014', 'J.P. Morgan', '', 'Adviser', 0, note=\\n    \\\"Financial advisor; retained in July after the Company interviewed several candidates; engagement letter effective 08/21/2014; served through signing.\\\",\\n    quote='In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor',\\n    page='p. 22', sort=D(2014,7,16), dfrom=D(2014,7,1), dto=D(2014,7,31))\\n\\nrow('08/07/2014', 'Industry Participant', 'Strategic', 'Bidder interest', 0, count=1, note=\\n    \\\"Approached J.P. Morgan about revisiting a combination if PetSmart pursued alternatives; no price; reported to the ad hoc committee; never admitted to the process.\\\",\\n    quote='Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies',\\n    page='p. 22', sort=D(2014,8,7), dfrom=D(2014,8,7), dto=D(2014,8,7))\\n\\nrow('08/13/2014', 'PetSmart (target)', '', 'Target sale decision', 0, note=\\n    \\\"Board determined to explore strategic alternatives including a possible sale; authorized ad hoc committee oversight; planned J.P. Morgan outreach in late September–early October and a public announcement.\\\",\\n    quote='determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders',\\n    page='p. 22', sort=D(2014,8,13), dfrom=D(2014,8,13), dto=D(2014,8,13))\\n\\nrow('08/19/2014', 'PetSmart (target)', '', 'Sale process announced', 0, note=\\n    \\\"Press release concurrent with second-quarter earnings announced exploration of strategic alternatives including a possible sale; interested parties could contact J.P. Morgan directly.\\\",\\n    quote='the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company',\\n    page='p. 23', sort=D(2014,8,19), dfrom=D(2014,8,19), dto=D(2014,8,19))\\n\\nrow('08/22/2014–08/27/2014', 'PetSmart (target)', '', 'Other material event', 0, note=\\n    \\\"Decided Industry Participant would not be invited into the exploratory process (antitrust concerns); communicated via J.P. Morgan calls 08/22 and 08/27; Industry Participant restated interest; no contact since.\\\",\\n    quote='The J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process',\\n    page='p. 23', sort=D(2014,8,27), dfrom=D(2014,8,22), dto=D(2014,8,27))\\n\\nrow('middle of August–end of October 2014', 'Strategic parties (potential participants)', 'Strategic', 'Contact', 0, count=3, note=\\n    \\\"Inbound contacts to J.P. Morgan during process preparation; three strategic parties, not counting Industry Participant; no individual names or outcomes reported.\\\",\\n    quote='including three strategic parties (not counting Industry Participant) and 24 financial participants',\\n    page='p. 23', sort=D(2014,9,20), dfrom=D(2014,8,11), dto=D(2014,10,31))\\n\\nrow('middle of August–end of October 2014', 'Financial parties (potential participants)', 'Financial', 'Contact', 0, count=24, note=\\n    \\\"Inbound contacts during process preparation; includes potential lead buyers and large suppliers of equity capital; the 15 October NDA signers are a subset.\\\",\\n    quote='24 financial participants (including potential lead buyers as well as large suppliers of equity capital to lead buyers)',\\n    page='p. 23', sort=D(2014,9,20), dfrom=D(2014,8,11), dto=D(2014,10,31))\\n\\n# ---- round 1 --------------------------------------------------------------\\nrow('first week of October 2014', 'PetSmart (target)', '', 'Round opened', 1, note=\\n    \\\"Process 1 round 1 opened as the Company began confidentiality/standstill agreements and October diligence; non-binding preliminary indications due 10/30.\\\",\\n    quote='In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers',\\n    page='p. 23', flag='Q1', sort=D(2014,10,4), dfrom=D(2014,10,1), dto=D(2014,10,7))\\n\\nrow('first week of October 2014', '15 financial buyers', 'Financial', 'NDA signed', 1, count=15, note=\\n    \\\"Cohort of 15 financial buyers; all received management presentations, detailed financials and Profit Improvement Plan and cost-savings information; no individual names given.\\\",\\n    quote=\\\"all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company's senior-most management, and received detailed financial and business plan information\\\",\\n    page='p. 23', sort=D(2014,10,4), dfrom=D(2014,10,1), dto=D(2014,10,7))\\n\\nrow('October 2014', 'PetSmart (target)', '', 'Deadline set', 1, note=\\n    \\\"Informed bidders that non-binding preliminary indications of interest would be due 10/30/2014.\\\",\\n    quote='During October, the potential bidders were informed that non-binding preliminary indications of interest would be due on October 30, 2014',\\n    page='p. 23', sort=D(2014,10,16), dfrom=D(2014,10,1), dto=D(2014,10,31))\\n\\nrow('October 2014', 'Longview', '', 'Other material event', 1, note=\\n    \\\"Told bidders Longview was willing to roll over up to 7.5 million shares on acceptable terms; bidders asked whether interested; participation not a condition.\\\",\\n    quote='Longview had informed the Company that it would be willing to “roll-over” up to 7.5 million shares on terms and price acceptable to Longview',\\n    page='p. 23', sort=D(2014,10,16), dfrom=D(2014,10,1), dto=D(2014,10,31))\\n\\nrow('10/30/2014', 'Buyer Group', 'Financial', 'Bid', 1, plow=81.00, phigh=83.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\\n    \\\"Indication of interest; range $81.00–$83.00; one of three initial indications at or above $80.00; advanced 11/03; consideration form not stated.\\\",\\n    quote='the Buyer Group, which indicated a range of $81.00 to $83.00 per share',\\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', 'Unnamed financial bidder 1', 'Financial', 'Bid', 1, plow=80.00, phigh=85.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\\n    \\\"Indication of interest; range $80.00–$85.00; one of three initial indications at or above $80.00; advanced 11/03; consideration form not stated.\\\",\\n    quote='another bidder, which suggested a range of $80.00 to $85.00 per share',\\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', 'Unnamed financial bidder 2', 'Financial', 'Bid', 1, cash='Not stated', form='Informal', cond='Light', count=1, inferred='Y', note=\\n    \\\"Identified as the third of the three initial indications at or above $80.00 after the Buyer Group and Unnamed financial bidder 1; price not stated; advanced 11/03.\\\",\\n    quote='Three bidders initially indicated price ranges that reached at least $80.00 per share',\\n    page='p. 24', flag='Q4', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', 'Bidder 2', 'Financial', 'Bid', 1, plow=78.00, phigh=78.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\\n    \\\"Initial indication of $78.00; raised after J.P. Morgan's 10/30–11/02 calls; advanced 11/03; bid again 12/10 and 12/12.\\\",\\n    quote='another bidder (which we refer to as “Bidder 2”), which had initially indicated a price of $78.00',\\n    page='p. 24', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', '2 other indication submitters', 'Financial', 'Bid', 1, cash='Not stated', form='Informal', cond='Unclear', count=2, inferred='Y', note=\\n    \\\"Residual of six 10/30 submitters after the Buyer Group, Bidder 2 and the two individually recorded unnamed indications; prices not stated; both below $80.00.\\\",\\n    quote='six of the potentially interested parties submitted indications of interest',\\n    page='p. 24', flag='Q3', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', 'PetSmart (target)', '', 'Deadline', 1, note=\\n    \\\"Due date for preliminary indications; six submitted (rows #15–#19).\\\",\\n    quote='non-binding preliminary indications of interest would be due on October 30, 2014',\\n    page='p. 23', flag='Q2', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014', '9 financial NDA signers', 'Financial', 'Did not submit', 1, count=9, exitr='Not stated', inferred='Y', note=\\n    \\\"15 NDA signers − 6 submitters = 9; no submissions or reasons reported; closed at the due date.\\\",\\n    quote='six of the potentially interested parties submitted indications of interest',\\n    page='p. 24', flag='Q3', sort=D(2014,10,30), dfrom=D(2014,10,30), dto=D(2014,10,30))\\n\\nrow('10/30/2014–11/02/2014', 'Bidder 2', 'Financial', 'Bid', 1, plow=81.00, phigh=84.00, cash='Not stated', form='Informal', cond='Light', count=1, note=\\n    \\\"Raised from $78.00 to $81.00–$84.00 during J.P. Morgan's 10/30–11/02 rationale calls; helped qualify it for the final round; late relative to the 10/30 due date.\\\",\\n    quote='increased its indication to a range of $81.00 to $84.00 per share',\\n    page='p. 24', flag='Q2', sort=D(2014,10,31), dfrom=D(2014,10,30), dto=D(2014,11,2))\\n\\n# ---- round 2 --------------------------------------------------------------\\nrow('11/03/2014', 'PetSmart (target)', '', 'Round opened', 2, note=\\n    \\\"Board advanced the four bidders at or above $80.00 to the final round; eliminated parties notified; November diligence, form merger agreement and FY2014 projection updates followed.\\\",\\n    quote='determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process',\\n    page='p. 24', flag='Q1', sort=D(2014,11,3), dfrom=D(2014,11,3), dto=D(2014,11,3))\\n\\nrow('11/03/2014', '2 eliminated indication submitters', 'Financial', 'Dropped by target', 2, count=2, exitr='Lower offer than rivals', inferred='Y', note=\\n    \\\"6 submitters − 4 advanced = 2; indications below $80.00; notified by J.P. Morgan; none sought to remain above its respective initial indication.\\\",\\n    quote='representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process',\\n    page='p. 24', sort=D(2014,11,3), dfrom=D(2014,11,3), dto=D(2014,11,3))\\n\\nrow('November 2014', 'Bidder 3', 'Financial', 'Bidding group changed', 2, count=2, note=\\n    \\\"Two finalists permitted to work together and named Bidder 3 (one wanted an equity partner; one would drop out otherwise); members not identified (likely Unnamed financial bidders 1–2, see Q4); each leaves independent bidding.\\\",\\n    quote='the ad hoc committee authorized these two bidders to work together. We refer to these two bidders together as “Bidder 3.”',\\n    page='p. 24', flag='Q4', sort=D(2014,11,16), dfrom=D(2014,11,3), dto=D(2014,11,30))\\n\\nrow('12/04/2014–12/05/2014', 'PetSmart (target)', '', 'Deadline set', 2, note=\\n    \\\"Ad hoc committee set the evening of 12/10 for final bids (moved up from the initial 12/05 plan, citing leak risk); asked for markups and financing commitments in advance.\\\",\\n    quote='set the evening of Wednesday, December 10 (five days, rather than 10 days prior to the anticipated December 15 completion date) as the deadline for submission of final bids',\\n    page='p. 25', sort=D(2014,12,4), dfrom=D(2014,12,4), dto=D(2014,12,5))\\n\\nrow('12/10/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=80.70, phigh=80.70, cash='Yes', form='Formal', cond='Light', count=1, note=\\n    \\\"Final bid with revised merger agreement/documents; financing commitment documents provided 12/06; documentation less conditional and more favorable than Bidder 2's; not dependent on a Longview rollover.\\\",\\n    quote='The Buyer Group offered $80.70 per share, in cash',\\n    page='p. 25', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\\n\\nrow('12/10/2014', 'Bidder 2', 'Financial', 'Bid', 2, plow=80.35, phigh=80.35, cash='Yes', form='Formal', cond='Light', count=1, note=\\n    \\\"Final bid with revised merger agreement/documents; rollover accommodation would not affect price and only after a signed agreement; bid again 12/12.\\\",\\n    quote='Bidder 2 offered $80.35 per share, in cash',\\n    page='p. 25', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\\n\\nrow('12/10/2014', 'Bidder 3', 'Financial', 'Did not submit', 2, count=2, exitr='Value at or below market price', note=\\n    \\\"Verbal valuation not above ~$78 current stock price; J.P. Morgan called it unlikely to be competitive; no written offer submitted.\\\",\\n    quote='Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share',\\n    page='p. 25', flag='Q4', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\\n\\nrow('12/10/2014', 'PetSmart (target)', '', 'Deadline', 2, note=\\n    \\\"Final bids due; Buyer Group and Bidder 2 submitted; extended the same evening to 12/12.\\\",\\n    quote='as the deadline for submission of final bids',\\n    page='p. 25', flag='Q2', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\\n\\nrow('12/10/2014', 'PetSmart (target)', '', 'Deadline revised', 2, note=\\n    \\\"Same bidders asked to improve; new due date 12/12; an extension of the final round, not a new round.\\\",\\n    quote='instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014',\\n    page='p. 25', flag='Q2', sort=D(2014,12,10), dfrom=D(2014,12,10), dto=D(2014,12,10))\\n\\nrow('12/12/2014', 'Buyer Group and Longview', '', 'Other material event', 2, note=\\n    \\\"Approved Buyer Group's request to include a Longview rollover; Longview and Buyer Group signed a confidentiality agreement allowing exchange of detailed information, including bid price; voting-agreement form instructed.\\\",\\n    quote='Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price',\\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\\n\\nrow('12/12/2014', 'Bidder 2', 'Financial', 'Bid', 2, plow=81.50, phigh=81.50, cash='Yes', form='Formal', cond='Light', count=1, note=\\n    \\\"Best and final; revised merger agreement and financing commitment documents submitted; $81.50 confirmed as best and final.\\\",\\n    quote='During the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash',\\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\\n\\nrow('12/12/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=82.50, phigh=82.50, cash='Yes', form='Formal', cond='Light', count=1, note=\\n    \\\"Oral offer; bidder working to increase within hours; increased to $83.00 same evening.\\\",\\n    quote='The Buyer Group initially submitted an oral offer of $82.50 per share, in cash, but stated that it was working to increase the offer within the next few hours',\\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\\n\\nrow('12/12/2014', 'Buyer Group', 'Financial', 'Bid', 2, plow=83.00, phigh=83.00, cash='Yes', form='Formal', cond='Light', count=1, note=\\n    \\\"Best and final; revised drafts in substantially executable form; financing commitments provided; $250 million Longview rollover included.\\\",\\n    quote='Later in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash',\\n    page='p. 26', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\\n\\nrow('12/12/2014', 'PetSmart (target)', '', 'Deadline', 2, note=\\n    \\\"Improved bids due; Bidder 2 $81.50 and Buyer Group $83.00 received; board acted the next day.\\\",\\n    quote='instruct the bidders to submit improved bids on December 12, 2014',\\n    page='p. 25', flag='Q2', sort=D(2014,12,12), dfrom=D(2014,12,12), dto=D(2014,12,12))\\n\\nrow('12/13/2014', 'PetSmart (target)', '', 'Other material event', 2, note=\\n    \\\"Board unanimously approved the merger with the Buyer Group and recommended adoption, subject to resolving remaining open points; J.P. Morgan oral fairness opinion; reconvene if needed.\\\",\\n    quote='the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders',\\n    page='p. 26', sort=D(2014,12,13), dfrom=D(2014,12,13), dto=D(2014,12,13))\\n\\nrow('12/14/2014', 'PetSmart, Argos Holdings and Merger Sub', '', 'Merger agreement signed', 2, count=1, note=\\n    \\\"Agreed price $83.00 per share cash; Longview rolls 3,012,050 shares (~$250 million) into Parent equity; equity commitments up to $1.83 billion and $6.95 billion debt financing.\\\",\\n    quote='On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements',\\n    page='p. 26', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\\n\\nrow('12/14/2014', 'PetSmart', '', 'Merger announced', 'post', note=\\n    \\\"Public announcement of the transaction on the signing date.\\\",\\n    quote='issued a press release announcing the transaction',\\n    page='p. 26', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\\n\\nrow('12/14/2014', 'Bidder 2', 'Financial', 'Not selected at signing', 2, count=1, exitr='Lower offer than rivals', note=\\n    \\\"Target chose Buyer Group; Bidder 2's $81.50 best and final was below the $83.00 winning price; still live at signing.\\\",\\n    quote='neither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group',\\n    page='p. 27', sort=D(2014,12,14), dfrom=D(2014,12,14), dto=D(2014,12,14))\\n\\nrow('by 12/14/2014', 'Simpson Thacher and Bartlett LLP', '', 'Adviser', 0, inferred='Y', note=\\n    \\\"First seen acting in the merger agreement notices; counsel to Parent/Merger Sub; exact retention date not shown.\\\",\\n    quote='with a copy to: Simpson Thacher and Bartlett LLP',\\n    page='p. A-46', sort=D(2014,12,14), dfrom=None, dto=D(2014,12,14))\\n\\n# check ordering: sort non-decreasing and within [dfrom,dto]\\nprev = None\\nfor i, r in enumerate(R, 1):\\n    s = r['sort']\\n    if prev is not None and s < prev:\\n        raise SystemExit('sort decreases at row %d: %s < %s' % (i, s, prev))\\n    prev = s\\n    if r['dfrom'] is not None and not (r['dfrom'] <= s <= (r['dto'] or r['dfrom'])):\\n        raise SystemExit('sort outside window at row %d' % i)\\n    if r['dto'] is not None and s > r['dto']:\\n        raise SystemExit('sort after dto at row %d' % i)\\nfor i, r in enumerate(R, 1):\\n    for f in ('when', 'who', 'event', 'note', 'quote', 'page'):\\n        if not r[f]:\\n            raise SystemExit('missing %s at row %d' % (f, i))\\n    if wc(r['quote']) > 30:\\n        raise SystemExit('quote too long at row %d (%d words)' % (i, wc(r['quote'])))\\n    if wc(r['note']) > 40:\\n        raise SystemExit('note too long at row %d (%d words)' % (i, wc(r['note'])))\\n    r['quote_exact'] = extract_quote(r['quote'])\\n\\nprint('rows ok:', len(R))\\n\\n# ---------------------------------------------------------------- workbook\\nwb = Workbook()\\nhdr_font = Font(bold=True, color='FFFFFF')\\nhdr_fill = PatternFill('solid', fgColor='1F4E78')\\nwrap = Alignment(wrap_text=True, vertical='top')\\nthin = Side(style='thin', color='D9D9D9')\\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\\n\\ndef style_sheet(ws, widths):\\n    for j, w in enumerate(widths, 1):\\n        ws.column_dimensions[get_column_letter(j)].width = w\\n    for c in ws[1]:\\n        c.font = hdr_font\\n        c.fill = hdr_fill\\n        c.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\\n    for r in ws.iter_rows(min_row=2):\\n        for c in r:\\n            c.alignment = wrap\\n            c.border = border\\n    ws.freeze_panes = 'A2'\\n    ws.auto_filter.ref = ws.dimensions\\n    ws.row_dimensions[1].height = 30\\n\\n# --- Deal ledger\\nws = wb.active\\nws.title = 'Deal ledger'\\nhdr = ['#','When','Who','Type','Event','Process','Round','Price low','Price high','All cash',\\n       'Formality','Conditions','Count','Exit reason','Inferred','Note','Quote and page','Flag',\\n       'Reviewer note','Sort date','Date from','Date to']\\nws.append(hdr)\\nfor i, r in enumerate(R, 1):\\n    ws.append([i, r['when'], r['who'], r['typ'], r['event'], 1, r['rnd'], r['plow'], r['phigh'],\\n               r['cash'], r['form'], r['cond'], r['count'], r['exitr'], r['inferred'],\\n               r['note'], '%s (%s)' % (r['quote_exact'], r['page'].replace('p. ', '')),\\n               r['flag'], None, r['sort'], r['dfrom'], r['dto']])\\nstyle_sheet(ws, [4,20,22,10,20,8,6,9,9,10,10,10,7,18,8,60,60,6,14,11,11,11])\\nfor row_i in range(2, ws.max_row+1):\\n    for col in ('T','U','V'):\\n        ws['%s%d' % (col, row_i)].number_format = 'MM/DD/YYYY'\\n    # price columns\\n    for col in ('H','I'):\\n        cell = ws['%s%d' % (col, row_i)]\\n        if cell.value is not None:\\n            cell.number_format = '0.00'\\n\\n# --- Rounds\\nws2 = wb.create_sheet('Rounds')\\nws2.append(['Process','Round','Opened','How opened','Who was in','Due dates','Deadline outcome','Finality','Bids received','How it ended'])\\nws2.append([1,1,D(2014,10,4),\\n    'Company entered confidentiality and standstill agreements with 15 financial buyers; October diligence and management presentations began',\\n    '15 financial buyers (all NDA signers; due diligence and management presentations)',\\n    '10/30/2014',\\n    'Late bids accepted',\\n    'Not final',\\n    '6 submitters: Buyer Group ($81.00–$83.00); Unnamed financial bidder 1 ($80.00–$85.00); Bidder 2 ($78.00); Unnamed financial bidder 2 (price not stated); 2 others (prices not stated)',\\n    'four advanced at 11/03 (Buyer Group, Bidder 2, Unnamed financial bidders 1 and 2); 2 submitters eliminated; 9 signers did not submit'])\\nws2.append([1,2,D(2014,11,3),\\n    'Board advanced the four bidders at or above $80.00 to the final round; eliminated parties notified; merger-agreement form and FY2014 projection updates circulated',\\n    '4 financial bidders: Buyer Group, Bidder 2, Unnamed financial bidders 1 and 2 (the latter two later combined as Bidder 3)',\\n    '12/10/2014 → 12/12/2014',\\n    'Extended; Enforced',\\n    'Announced as final',\\n    'Buyer Group ($80.70, then $82.50 → $83.00); Bidder 2 ($80.35, then $81.50); Bidder 3 gave a verbal valuation only, no written offer',\\n    'signing with Buyer Group (12/14/2014)'])\\nstyle_sheet(ws2, [8,7,11,45,45,22,20,16,60,45])\\nfor row_i in (2,3):\\n    ws2['C%d' % row_i].number_format = 'MM/DD/YYYY'\\n\\n# --- Questions\\nws3 = wb.create_sheet('Questions')\\nws3.append(['Q','Question','Recommended answer','Why, with page','Rows affected','What changes if answered differently','Reviewer note'])\\nqs = [\\n ['Q1',\\n  \\\"Round map: one process; Round 1 opens with the first-week-of-October 2014 confidentiality-agreement wave (no dated outreach before it); Round 2 opens 11/03/2014 when four bidders advance to the 'final round'; the 12/10 request to improve by 12/12 is a deadline revision inside Round 2, not a new round. Is this right?\\\",\\n  'Keep it: Round 1 = October solicitation (due 10/30); Round 2 = final round from 11/03 (due 12/10, revised 12/12).',\\n  'No target outreach is dated before the October NDA wave (pp. 22–23); the filing calls 11/03 the final round and the December bids final/best-and-final (pp. 24–26); C8 excludes a further improvement request to the same finalists.',\\n  '#11, #12, #23; the alternative opening moves #5–#10 into round 1; a Round 3 alternative moves #31–#36.',\\n  'Alternative opening moves the round-0 rows into round 1; a third round changes Round 2\\\\u2019s deadline outcome and the round labels on #31–#36.',\\n  None],\\n ['Q2',\\n  \\\"Deadline outcomes: Round 1 (due 10/30) — Late bids accepted, because Bidder 2 raised $78.00 to $81.00–$84.00 after the due date, during J.P. Morgan's 10/30–11/02 calls, and the board advanced it; Round 2 — 12/10 Extended, 12/12 Enforced. Correct?\\\",\\n  'Yes, as recorded.',\\n  'The revised Bidder 2 indication postdates the 10/30 due date and was considered (p. 24); the committee moved the final-bid date from 12/10 to 12/12 (p. 25); the board acted on the 12/12 bids (p. 26).',\\n  '#20, #22; #30, #31, #36.',\\n  'If 10/30 were Enforced, #22 is an on-time submission; if 12/12 were not Enforced, only the Rounds sheet changes.',\\n  None],\\n ['Q3',\\n  \\\"First-round count: the background says six parties submitted indications of interest on 10/30, while the Reasons section says the Company 'received first round indications of interest from 5 bidder groups.' Which count should the ledger use?\\\",\\n  \\\"Six submitters, following the background's detailed chronology.\\\",\\n  'Six is stated in the operative narrative (p. 24); the reasons-page figure is a summary (p. 27) and the two are not reconciled anywhere in the filing.',\\n  '#19, #21.',\\n  \\\"With five submitters, #19's cohort becomes 1 and #21 becomes 15 − 5 = 10.\\\",\\n  None],\\n ['Q4',\\n  \\\"Bidder 3's two members are unnamed. Should they be recorded as the two unnamed finalists (Unnamed financial bidders 1 and 2), with Buyer Group and Bidder 2 continuing separately?\\\",\\n  'Yes — of the four finalists, only those two can have combined; the filing never identifies them.',\\n  'Four advanced at or above $80.00: Buyer Group, Bidder 2 and the two unnamed indications (p. 24); Buyer Group and Bidder 2 bid separately on 12/10 and 12/12 (pp. 25–26).',\\n  '#17, #25, #29.',\\n  'If Bidder 3 included a different bidder, the count of independent bidders in the final stage changes (three bidding units either way).',\\n  None],\\n ['Q5',\\n  \\\"One process or two? PetSmart's spring-2014 contacts with Industry Participant concerned PetSmart buying it, and Industry Participant was never admitted; the sell-side process ran from 08/13/2014 to signing. Should Number of processes stay 1?\\\",\\n  'Yes — one process (Process 1); the spring episode is not a sell-side process.',\\n  'C1: a target\\\\u2019s attempt to buy another company is not its sale process; the filing reports no abandoned sell-side attempt or restart (pp. 21–23).',\\n  'Deal facts only; no ledger rows.',\\n  'If two processes, a Process terminated/Process restarted pair and spring contact rows would be added.',\\n  None],\\n]\\nfor q in qs:\\n    ws3.append(q)\\nstyle_sheet(ws3, [6,60,45,60,45,55,14])\\n\\n# --- Deal facts\\nws4 = wb.create_sheet('Deal facts')\\nws4.append(['Field','Value'])\\nfacts = [\\n ['Target', 'PetSmart, Inc., a Delaware corporation (NASDAQ: PETM); 99,455,151 shares outstanding on the 01/29/2015 record date.'],\\n ['Acquirer', 'Argos Holdings Inc. (Parent) and Argos Merger Sub Inc., to be owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP, and (after 12/12/2014) Longview Asset Management, LLC.'],\\n ['Acquirer type', 'Financial — private-equity/sponsor consortium (with a Longview rollover); no strategic bidder reached the final round.'],\\n ['Agreed price and consideration', '$83.00 per share in cash; Longview contributes 3,012,050 shares (~$250 million) to Parent as rollover equity. Parent estimates ~$8.4 billion total funds required, with $6.95 billion debt commitments and up to $1.83 billion cash equity commitments.'],\\n ['Merger agreement signed', D(2014,12,14)],\\n ['Merger announced', D(2014,12,14)],\\n ['Filing type and date', 'DEFM14A definitive proxy statement dated 02/02/2015 (special meeting 03/06/2015).'],\\n ['Background pages', '21–26'],\\n ['Initiation', 'Activist-influenced — JANA Partners\\\\u2019 13D and Longview\\\\u2019s public advocacy preceded the board\\\\u2019s 08/13/2014 decision to explore a sale; Industry Participant also re-approached J.P. Morgan on 08/07/2014.'],\\n ['Number of processes', '1'],\\n ['Auction screen (C1)', 'Met — 15 independent prospective acquirers (all financial buyers) executed confidentiality and standstill agreements with the Company in the process.'],\\n ['Whole-company bids', 'Yes — all indications and bids were for the whole company (e.g., Buyer Group $83.00 per share in cash).'],\\n ['Currency and units of bid prices', 'US dollars, per share of common stock (all bids were cash; October indications did not state form).'],\\n ['Target financial advisers', 'J.P. Morgan Securities LLC (sole financial advisor; engagement letter effective 08/21/2014).'],\\n ['Target legal advisers', 'Wachtell, Lipton, Rosen & Katz.'],\\n ['Account', \\\"\\\\\\\"PetSmart's board began reviewing alternatives in early 2014 and, after JANA Partners disclosed a 9.9% stake on July 3, 2014 and Longview publicly urged a sale, decided on August 13 to explore a sale and announced it on August 19. A private strategic suitor, Industry Participant, re-approached J.P. Morgan on August 7 but was told it would not be invited, because of antitrust-timing risk. During mid-August to end-October J.P. Morgan was contacted by 27 potential participants (three strategic, 24 financial); 15 financial buyers signed confidentiality and standstill agreements in the first week of October, received diligence and management presentations, and submitted one of six non-binding indications of interest due October 30. On November 3 the board advanced the four bidders at or above $80.00 to the final round; two of them combined as Bidder 3, which then valued the company at or below the market price and submitted nothing. Buyer Group bid $80.70 and Bidder 2 $80.35 on December 10; after the committee demanded improvement, their best-and-final bids on December 12 were $83.00 and $81.50, and the board approved the Buyer Group deal on December 13. The parties executed on December 14, 2014: $83.00 per share in cash, with Longview rolling 3,012,050 shares (~$250 million) into the buyer and no strategic acquirer reaching the final round.\\\\\\\"\\\"],\\n]\\nfor f in facts:\\n    ws4.append(f)\\nstyle_sheet(ws4, [32, 120])\\nfor row_i in (5,6):\\n    ws4['B%d' % row_i].number_format = 'MM/DD/YYYY'\\n\\nwb.save(OUT)\\nprint('saved', OUT)\\n\"}"},"time":{"start":1789825476621,"end":1789825505304}}}}
