x='Not stated', ob='Inferred: identity')\\nq, m, off = quotes(('P-014', 'G&W submitted an LOI on July 21, 2016', 'South Quay property'),\\n                   ('P-014', 'G&W also provided a mark-up of the disclosure letter', 'disclosure letter'))\\nadd(when='07/21/2016', who='G&W', what='Bid', rnd='2', typ='Strategic',\\n    terms='LOI at $21.15 per share (as-converted; point) = $20.02 cash at closing plus a $1.13 contingent value right tied to the subsequent sale of the Company\\\\u2019s South Quay property (cash-settled CVR; payoff uncertain), subject to a three-week exclusive diligence period; also returned a mark-up of the disclosure letter; submitted one day after the 07/20/2016 due date.',\\n    why='Bid (stated; unitemized payment split preserved). Quotes: \\\\u201c'+q[0]+'\\\\u201d / \\\\u201c'+q[1]+'\\\\u201d Formality: returned transaction-document markup plus definitive-terms engagement \\\\u2192 Formal. Conditions: stated three-week exclusive diligence period \\\\u2192 Heavy. All cash: Yes (cash plus a contingent cash payment).',\\n    src=['P-014'], review='Q6; Q8', count=1, df='2016-07-21', dt='2016-07-21', wa='2016-07-21',\\n    basis='Reported day', method='Reported', pl=21.15, ph=21.15, kind='Point', origin='Stated',\\n    curr='USD', cash='Yes', cclose=20.02,\\n    cdetail='Fin: not stated; DD required: substantive (3 wks); DD open: yes; Excl: requested (3 wks)',\\n    rel='revised by R037')\\nq, m, off = quotes(('P-014', 'On July 26, 2016', '$22.15 per share'))\\nadd(when='07/26/2016', who='G&W', what='Bid', rnd='2', typ='Strategic',\\n    terms='Revised LOI at $22.15 per share (as-converted; point) = $21.02 cash plus the unchanged $1.13 South Quay CVR, submitted after GHF feedback that its price and CVR structure were not competitive; second G&W bid in Round 2, so Count 0.',\\n    why='Bid (stated price revision; section 9.1 keeps revisions as Bid rows). Quote: \\\\u201c'+q+'\\\\u201d Conditions unchanged: three-week exclusive diligence period \\\