{"type":"tool_use","timestamp":1789825085199,"sessionID":"ses_f4628b113ffe9gyXGlLM5DZwK2","part":{"partID":"prt_0b9e1d5d4001ycq7qWyReju47g","sessionID":"ses_f4628b113ffe9gyXGlLM5DZwK2","messageID":"msg_0b9e0aeb0001Oie8WW948N6KAO","type":"tool","id":"call_00_EiQpQav06SMjLzSVlKcA4252","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/build_workbook.py","content":"#!/usr/bin/env python3\n\"\"\"Build providence-worcester.xlsx deal ledger from the PWRR DEFM14A (2016-09-20).\"\"\"\nimport re, json, bisect, os\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.utils import get_column_letter\n\nTXT = '/tmp/opencode/pxw_text.txt'\nOUT = '/home/uctpiaj/work/extraction/providence-worcester.xlsx'\nlines = open(TXT, encoding='utf-8').read().split('\\n')\n\n# ---------------------------------------------------------------- page map\npm = json.load(open('/tmp/opencode/pagemap.json'))\nmpos, mval = pm['mpos'], pm['mval']\ndef page_for(i):\n    j = bisect.bisect_left(mpos, i)\n    return mval[j] if j < len(mval) else None\n\ndef clean(s):\n    return re.sub(r'\\s+', ' ', s).strip()\n\nclass Source:\n    \"\"\"A source text row with char->line mapping for page lookup.\"\"\"\n    def __init__(self, sid, section, ranges):\n        self.sid, self.section = sid, section\n        chunks, lmap = [], []\n        for (a, b) in ranges:              # 1-based inclusive\n            for ln in range(a - 1, b):\n                t = lines[ln]\n                if not t.strip():\n                    continue\n                if chunks:\n                    chunks.append(' ')\n                    lmap.append(ln)\n                chunks.append(t)\n                lmap.extend([ln] * len(t))\n        self.text = clean(''.join(chunks))\n        # lmap currently indexes raw chunks incl. spaces; rebuild consistent:\n        self.lmap = []\n        self.text = ''\n        for (a, b) in ranges:\n            for ln in range(a - 1, b):\n                t = clean(lines[ln])\n                if not t:\n                    continue\n                if self.text:\n                    self.text += ' '\n                    self.lmap.append(ln)\n                self.text += t\n                self.lmap.extend([ln] * len(t))\n        self.start_line = ranges[0][0] - 1\n\n    def page(self, offset=0):\n        ln = self.lmap[min(offset, len(self.lmap) - 1)]\n        return page_for(ln)\n\n# ---------------------------------------------------------------- source rows\nBG_SECTION = 'Proposal No. 1\\u2014The Merger \\u2014 Background of the Merger'\nbg_segments = [\n    (1161,1171),(1172,1184),(1185,1186),(1187,1193),(1194,1196),(1197,1201),\n    (1202,1208),(1209,1213),(1214,1217),(1218,1220),(1221,1226),(1227,1229),\n    (1230,1231),(1232,1235),(1238,1239),(1240,1241),(1242,1243),(1244,1245),\n    (1246,1247),(1248,1255),(1256,1262),(1263,1271),(1272,1278),(1279,1285),\n    (1286,1293),(1294,1303),(1304,1313),(1314,1316),(1317,1320),\n]\nP_ROWS = []\nfor i, seg in enumerate(bg_segments, 1):\n    P_ROWS.append(Source(f'P-{i:03d}', BG_SECTION, [seg]))\n\nX_DEFS = [\n    ('X-001', 'Annex A \\u2014 Merger Agreement, Art. 1 (Definitions: Confidentiality Agreement)', [(4681,4682)]),\n    ('X-002', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger', [(1338,1339)]),\n    ('X-003', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger', [(1344,1348)]),\n    ('X-004', 'Summary \\u2014 Market Price of Our Common Stock', [(667,670)]),\n    ('X-005', 'Market Price of Common Stock', [(2739,2740)]),\n    ('X-006', 'Summary \\u2014 Record Date; Outstanding Shares; Shares Entitled to Vote', [(377,381)]),\n    ('X-007', 'Proposal No. 1\\u2014The Merger \\u2014 General', [(1154,1159)]),\n    ('X-008', 'Summary \\u2014 Treatment of Equity and Equity-Based Awards', [(459,465)]),\n    ('X-009', 'The Merger Agreement \\u2014 Regulatory Approvals Required for the Merger', [(2463,2469)]),\n    ('X-010', 'The Merger Agreement \\u2014 Termination of the Merger Agreement (outside date)', [(556,559)]),\n    ('X-011', 'The Merger Agreement \\u2014 Transaction Litigation', [(2470,2479)]),\n    ('X-012', 'The Voting Agreement', [(2750,2752)]),\n    ('X-013', 'Questions and Answers about the Merger and the Special Meeting', [(786,789)]),\n    ('X-014', \"Proposal No. 1\\u2014The Merger \\u2014 Opinion of the Company's Financial Advisor\", [(1447,1452)]),\n    ('X-015', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Miscellaneous (fees)', [(1672,1674)]),\n    ('X-016', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Miscellaneous (relationships)', [(1679,1681)]),\n    ('X-017', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Selected Publicly Traded Companies Analysis', [(1540,1545),(1582,1593)]),\n    ('X-018', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Analysis of Selected Precedent Transactions', [(1597,1600),(1648,1653)]),\n    ('X-019', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Discounted Cash Flow Analysis', [(1660,1668)]),\n    ('X-020', 'The Parties to the Merger Agreement \\u2014 Providence and Worcester Railroad Company', [(966,976)]),\n    ('X-021', 'The Parties to the Merger Agreement \\u2014 Genesee & Wyoming Inc.', [(978,985)]),\n    ('X-022', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger (likelihood of completion)', [(1381,1384)]),\n    ('X-023', 'Annex A \\u2014 Merger Agreement, Art. 1 (Definitions: Company Termination Fee)', [(4677,4677)]),\n    ('X-024', 'Summary \\u2014 Voting Agreement', [(431,434)]),\n]\nX_ROWS = [Source(sid, sec, rngs) for sid, sec, rngs in X_DEFS]\nSRC = {s.sid: s for s in P_ROWS + X_ROWS}\n\ndef quote(sid, start, end):\n    s = SRC[sid]\n    i = s.text.find(start)\n    if i < 0:\n        raise SystemExit(f'START not found in {sid}: {start[:60]}')\n    j = s.text.find(end, i)\n    if j < 0:\n        raise SystemExit(f'END not found in {sid}: {end[:60]}')\n    j += len(end)\n    return s.text[i:j], s, i\n\ndef quotes(*specs):\n    out, main, off = [], None, None\n    for sid, a, b in specs:\n        q, s, i = quote(sid, a, b)\n        out.append(q)\n        if main is None:\n            main, off = s, i\n    return out, main, off\n\n# ---------------------------------------------------------------- ledger rows\nCOLS = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome',\n        'Formality','Conditions level','Why and evidence','Source','Review','Reviewer note',\n        'Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\n        'Price low','Price high','Price kind','Price origin','Currency','All cash','Cash at closing',\n        'Conditions detail','Due date','Deadline treatment','Round finality','Decided by','Exit reason',\n        'Outcome basis','Page','Related rows','Deal']\nDEAL = 'PWRR-G&W 2016'\n\nUNKNOWN_NOTE = 'Type: Unknown \\u2014 unsplit population of mixed types (note, not Mixed).'\n\ndef R(when, who, what, rnd, typ, terms, why, src, review, count=None, df=None, dt=None,\n      wa=None, basis=None, method=None, pl=None, ph=None, kind=None, origin=None, curr=None,\n      cash=None, cclose=None, cdetail=None, due=None, dlm=None, rfin=None, dec=None, ex=None,\n      ob=None, rel=None, price_note=False):\n    return dict(when=when, who=who, what=what, rnd=rnd, typ=typ, terms=terms, why=why, src=src,\n                review=review, count=count, df=df, dt=dt, wa=wa, basis=basis, method=method,\n                pl=pl, ph=ph, kind=kind, origin=origin, curr=curr, cash=cash, cclose=cclose,\n                cdetail=cdetail, due=due, dlm=dlm, rfin=rfin, dec=dec, ex=ex, ob=ob, rel=rel)\n\nrows = []\ndef add(**kw):\n    rows.append(R(**kw))\n\n# --- Round 0\nq, m, off = quotes(('P-001', 'In the fourth quarter of 2015', 'enhance regional connectivity'))\nadd(when='Q4 2015 (calendar quarter)', who='Party A (one of the Company\\u2019s Class I rail partners)',\n    what='Bidder interest', rnd='0', typ='Strategic',\n    terms='Unpriced approach: Party A suggested possible joint venture arrangements and expressed interest in acquiring equity in the Company to develop strategic opportunities and enhance regional connectivity; scope as to control not specified (not a whole-company bid); first sale-related contact, bidder-initiated, with the Chairman/CEO and the VP & Chief Commercial Officer; prompted the Board to form an investment-banker subcommittee. Count 1 = new first-contact party (a Bidder interest row carries the contact fact; see Summary contact tally).',\n    why='Bidder interest (stated): the filing reports an unpriced expression of interest in acquiring equity, not a priced proposal; no per-share or value figures exist for it. Direction: bidder-to-target. Quote: \\u201c'+q+'\\u201d',\n    src=['P-001'], review='Q5', count=1, df='2015-10-01', dt='2015-12-31', wa='2015-11-15',\n    basis='Reported interval', method='Assigned: midpoint')\nq, m, off = quotes(('P-001', 'the subcommittee recommended to the Board that the Company retain GHF', 'the Company engaged GHF'),\n                   ('P-001', 'GHF represented to the Company that it would not represent any potential buyer', 'in connection with such an offer'))\nadd(when='01/27/2016', who='GHF (Greene Holcomb & Fisher LLC) \\u2014 Company financial adviser; later BMO',\n    what='Adviser engaged', rnd='0', typ=None,\n    terms=\"Engaged as the Company's investment banking firm: subcommittee recommendation approved at the 01/27/2016 executive session (Director Smith absent); GHF presented qualifications and a proposed change-in-control process; represented it would not represent any potential buyer of the Company or any person proposing financing for such an offer; engagement followed the late-2015 banker interviews. GHF's business was acquired by BMO Capital Markets Corp. on 08/01/2016 \\u2014 the same adviser relationship continued as BMO (no second adviser row); aggregate fee ~$2.52 million.\",\n    why='Adviser engaged (stated): engagement approval on the stated day; the engagement-letter date is not disclosed. The GHF-to-BMO acquisition is a firm change, not a new mandate (section 5.4). Quotes: \\u201c'+q[0]+'\\u201d / \\u201c'+q[1]+'\\u201d',\n    src=['P-001','X-015'], review=None, df='2016-01-27', dt='2016-01-27', wa='2016-01-27',\n    basis='Reported day', method='Reported', rel='R003; mandate continued by BMO from 08/01/2016 (R052 source)')\nq, m, off = quotes(('P-002', 'Representatives of GHF then proposed a process', 'regarding a change in control transaction'),\n                   ('P-002', 'the Board appointed a special committee', 'a recommendation to the full Board'))\nadd(when='03/14/2016', who='Board of Directors (special meeting)',\n    what='Target sale decision', rnd='0', typ=None,\n    terms='Decided to proceed with GHF\\u2019s proposed process: discussions with Party A plus solicitation of other third parties regarding a change in control transaction; qualified as an exploratory strategy, not a commitment to sell; appointed the Transaction Committee (Barrett (Chair), Anderson, Garvey) to supervise the process and recommend to the full Board; the Committee could not itself approve a change of control.',\n    why='Target sale decision (stated): \\u201c'+q[0]+'\\u201d The qualification (exploratory strategy) is preserved. Committee appointment: \\u201c'+q[1]+'\\u201d',\n    src=['P-002'], review='Q1', df='2016-03-14', dt='2016-03-14', wa='2016-03-14',\n    basis='Reported day', method='Reported', rel='candidate R1 anchor (rejected)')\nq, m, off = quotes(('P-003', 'On March 22, 2016 and March 23, 2016', 'met with various representatives of Party A'),\n                   ('P-004', 'met with various representatives of Party A on March 22 and 23, 2016', 'informed Party A of GHF\\u2019s engagement'))\nadd(when='03/22/2016\\u201303/23/2016', who='Party A', what='Contact', rnd='0', typ='Strategic',\n    terms='Management (CFO/Treasurer Noreck and other senior managers) met Party A representatives and informed Party A of GHF\\u2019s engagement. Repeat contact: Party A was already in contact from Q4 2015, so Count 0 (no double counting).',\n    why='Contact (stated), repeat. Quotes: \\u201c'+q[0]+'\\u201d / \\u201c'+q[1]+'\\u201d Two-day series of meetings takes its first day as the Working date.',\n    src=['P-003','P-004'], review=None, count=0, df='2016-03-22', dt='2016-03-23', wa='2016-03-22',\n    basis='Reported interval', method='Assigned: bound')\nq, m, off = quotes(('P-004', 'The Transaction Committee authorized GHF to contact Party A', 'change in control transaction'))\nadd(when='03/24/2016', who='Transaction Committee', what='Target decision', rnd='0', typ=None,\n    terms='Authorized GHF to contact Party A and other potential buyers to determine their interest in a change in control transaction. Candidate anchor for Round 1, rejected: an authorization to approach firms is not the completed outreach (the actual first wave is R007).',\n    why='Target decision (stated): \\u201c'+q+'\\u201d Kept as a rejected R1 anchor row so the boundary can be moved.',\n    src=['P-004'], review='Q1', df='2016-03-24', dt='2016-03-24', wa='2016-03-24',\n    basis='Reported day', method='Reported', rel='candidate R1 anchor (rejected); R008')\nq, m, off = quotes(('P-004', 'representatives of each of GHF and the Company\\u2019s legal counsel', 'participated in all meetings of the Transaction Committee'))\nadd(when='03/24/2016', who='Hinckley, Allen & Snyder LLP (Hinckley Allen) \\u2014 Company legal counsel',\n    what='Adviser service observed', rnd='0', typ=None,\n    terms='Company legal counsel; participated in all Transaction Committee meetings; engagement date not disclosed; first shown acting 03/24/2016.',\n    why='Adviser service observed (stated): the filing shows Hinckley Allen already providing services on 03/24/2016; no selection or engagement date is disclosed, so the Working date is the earliest date shown acting. Quote: \\u201c'+q+'\\u201d',\n    src=['P-004'], review=None, df='2016-03-24', dt='2016-03-24', wa='2016-03-24',\n    basis='Reported day', method='Reported')\n# --- Round 1\nq, m, off = quotes(('P-004', 'During the week of March 28, 2016', '18 potential financial buyers'))\nadd(when='week of 03/28/2016', who='29 potential buyers (11 strategic incl. Party A; 18 financial)',\n    what='Contact', rnd='1', typ='Unknown',\n    terms='First outreach wave: GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers in accordance with the Transaction Committee\\u2019s directives; Count 29 = disclosed cohort size (includes Party A, already in contact since Q4 2015). Type: Unknown \\u2014 cohort mixes strategic and financial (split supplied only for the signing wave, R009\\u2013R011).',\n    why='Contact (stated cohort, executed outreach). Quote: \\u201c'+q+'\\u201d This is the R1 anchor event (see R008).',\n    src=['P-004'], review='Q1', count=29, df='2016-03-28', dt='2016-04-03', wa='2016-03-28',\n    basis='Reported interval', method='Assigned: bound', rel='R008 (anchor event)')\nq, m, off = quotes(('P-004', 'During the week of March 28, 2016', '18 potential financial buyers'))\nadd(when='week of 03/28/2016', who='Process (Round 1)', what='Round opened', rnd='1', typ=None,\n    terms='R1 anchor: first outreach wave \\u2014 GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers (R007); candidate anchors: R003 (03/14/2016 sale-strategy decision), R005 (03/24/2016 authorization to contact). Objective: solicit change-in-control interest and confirm continuing interest of NDA signers; the round runs through the IOI stage to the 06/01/2016 advancement decision. Round finality: Not final \\u2014 no final/binding/best-and-final announcement and no move to definitive negotiation; the stage closed by selection to management presentations (R021).',\n    why='Round opened (convention/analytical). First outreach wave chosen under section 6.3(1); R003 and R005 are the retained rejected candidates. Quote: \\u201c'+q+'\\u201d',\n    src=['P-004'], review='Q1', df='2016-03-28', dt='2016-04-03', wa='2016-03-28',\n    basis='Reported interval', method='Assigned: bound', rfin='Not final', rel='anchor R007; candidates R003, R005')\nqs, m, off = quotes(('P-004', 'Each of the potential strategic buyers', 'subsequently executed confidentiality agreements'),\n                    ('P-004', 'did not contain any', 'acquire the Company'))\nadd(when='from the week of 03/28/2016; by 04/22/2016', who='10 remaining potential strategic buyers (11 contacted less G&W)',\n    what='NDA signed', rnd='1', typ='Strategic',\n    terms='Confidentiality agreements signed by the potential strategic buyers of the outreach wave less G&W (recorded individually at R011); no \\u201cstandstill\\u201d or similar provision prohibiting a proposal or offer; the wave\\u2019s memorandum was distributed to signers including Party A, Party B and G&W.',\n    why='NDA signed (stated cohort; residual after G&W\\u2019s individual row, section 5.2). Base: \\u201c'+qs[0]+'\\u201d / \\u201c'+qs[1]+'\\u201d Signing wave spans the reported period; Working date takes its first day. The memorandum distribution (R015 source) bounds the old-wave signings.',\n    src=['P-004','P-007'], review='Q3', count=10, df='2016-03-28', dt='2016-04-22', wa='2016-03-28',\n    basis='Relative only', method='Assigned: bound', rel='R011 (G&W); R010 (financial residual)')\nadd(when='from the week of 03/28/2016; by 04/22/2016', who='14 potential financial buyers (of 18 contacted)',\n    what='NDA signed', rnd='1', typ='Financial',\n    terms='Confidentiality agreements signed by 14 of the 18 potential financial buyers contacted in the outreach wave; same no-standstill terms and memorandum distribution.',\n    why='NDA signed (stated cohort). Quote: \\u201c'+qs[0]+'\\u201d / \\u201c'+qs[1]+'\\u201d',\n    src=['P-004','P-007'], review='Q3', count=14, df='2016-03-28', dt='2016-04-22', wa='2016-03-28',\n    basis='Relative only', method='Assigned: bound', rel='R009 (strategic residual)')\nq1a, m, off = quotes(('X-001', 'shall mean the Confidentiality Agreement between the Company and Parent', 'April 3, 2016'))\nq1b, m2, off2 = quotes(('P-007', 'including Party A, Party B and G&W', 'that had executed confidentiality agreements'))\nadd(when='04/03/2016', who='G&W (Genesee & Wyoming Inc.)', what='NDA signed', rnd='1', typ='Strategic',\n    terms='Acquisition-related confidentiality agreement between the Company and G&W dated 04/03/2016 (the merger agreement\\u2019s defined \\u201cConfidentiality Agreement\\u201d); G&W also met management at the 2016 Connections Convention (04/03\\u201304/06) and received the memorandum.',\n    why='NDA signed (stated): the merger agreement definition fixes G&W\\u2019s individual date; the wave cohort rows (R009\\u2013R010) exclude it. Quotes: \\u201c'+q1a+'\\u201d / \\u201c'+q1b+'\\u201d',\n    src=['X-001','P-012'], review='Q3', count=1, df='2016-04-03', dt='2016-04-03', wa='2016-04-03',\n    basis='Reported day', method='Reported', rel='R009/R010 (wave cohorts)')\nq, m, off = quotes(('P-005', 'held a series of introductory meetings with five potential strategic buyers', '2016 Connections Convention'))\nadd(when='04/03/2016\\u201304/06/2016', who='Five unnamed potential strategic buyers (incl. G&W)',\n    what='Information access changed', rnd='1', typ='Strategic',\n    terms='GHF and Company management held a series of introductory management meetings with five potential strategic buyers (incl. G&W) at the American Short Line and Regional Railroad Association\\u2019s 2016 Connections Convention; the 14 financial-signer bidders and other NDA signers received no comparable management meetings at that time; venue-based opportunity (no selection reason stated for the five). Count blank (access row).',\n    why='Information access changed (classification): management meetings given to some live bidders and not others, recorded once for the access decision (not per meeting). Quote: \\u201c'+q+'\\u201d',\n    src=['P-005'], review='Q1', df='2016-04-03', dt='2016-04-06', wa='2016-04-03',\n    basis='Reported interval', method='Assigned: bound')\nq, m, off = quotes(('P-006', 'the Transaction Committee authorized representatives of GHF, on behalf of', 'to confirm their continuing interest'))\nadd(when='04/07/2016', who='Transaction Committee', what='Target decision', rnd='1', typ=None,\n    terms='Authorized GHF to contact the five convention parties, other potential strategic buyers (including certain Class I railroads) and private equity firms under NDA to confirm their continuing interest.',\n    why='Target decision (stated). Quote: \\u201c'+q+'\\u201d',\n    src=['P-006'], review=None, df='2016-04-07', dt='2016-04-07', wa='2016-04-07',\n    basis='Reported day', method='Reported')\nq, m, off = quotes(('P-006', 'Mr. Noreck reported', 'in a possible transaction'))\nadd(when='by 04/07/2016; day not disclosed', who='Two unnamed additional Class I railroads',\n    what='Contact', rnd='1', typ='Strategic',\n    terms='Approached by the Company (management) before the 04/07/2016 committee report to gauge interest in a possible transaction; no NDA, bid or further participation reported; they never entered the process (no outcome row). Count 2 = cohort size.',\n    why='Contact (stated): \\u201c'+q+'\\u201d Direction: target-to-bidder; approach precedes the 04/07/2016 meeting (day not disclosed), so the lower bound is the report date.',\n    src=['P-006'], review=None, count=2, df=None, dt='2016-04-07', wa='2016-04-07',\n    basis='Relative only', method='Assigned: bound')\nq, m, off = quotes(('P-006', 'Subsequently, on April 21, 2016', 'another potential strategic buyer'))\nadd(when='04/21/2016', who='Party B', what='Contact', rnd='1', typ='Strategic',\n    terms='Introductory meeting held by the Company and GHF with Party B; first individually recorded meeting for Party B. Repeat contact: Party B is treated as one of the contacted NDA signers of the March wave (R007/R009), so Count 0; the alternative reading is flagged in Q5.',\n    why='Contact (stated), repeat within the wave. Quote: \\u201c'+q+'\\u201d',\n    src=['P-006'], review='Q5', count=0, df='2016-04-21', dt='2016-04-21', wa='2016-04-21',\n    basis='Reported day', method='Reported')\nq, m, off = quotes(('P-007', 'each potential buyer had been advised', 'May 10, 2016'))\nadd(when='by 04/27/2016; IOI deadline 05/10/2016', who='Process (all potential buyers)',\n    what='Deadline set', rnd='1', typ=None,\n    terms='Each potential buyer advised to submit a non-binding indication of interest by 05/10/2016; advice reported at the 04/27/2016 executive session of the Board; deadline version 1 (later revised, R017). Communicating day not disclosed.',\n    why='Deadline set (stated); known only by the 04/27/2016 report. Quote: \\u201c'+q+'\\u201d This date was superseded before arrival, so it stays in the set/revised history without a milestone row.',\n    src=['P-007'], review='Q2', due='2016-05-10', df=None, dt='2016-04-27', wa='2016-04-27',\n    basis='Relative only', method='Assigned: bound')\nq, m, off = quotes(('P-007', 'which deadline was subsequently postponed to May 19, 2016', 'most compelling offers'))\nadd(when='after 04/27/2016; day not disclosed (new deadline 05/19/2016)', who='Process (all potential buyers)',\n    what='Deadline revised', rnd='1', typ=None,\n    terms='IOI deadline postponed from 05/10/2016 to 05/19/2016 to ensure potential buyers had sufficient time to formulate their most compelling offers; requester not disclosed; a