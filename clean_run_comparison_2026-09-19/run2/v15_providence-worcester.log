{"type":"tool_use","timestamp":1789825209831,"sessionID":"ses_f4628b113ffe9gyXGlLM5DZwK2","part":{"partID":"prt_0b9e413de001lnJQ6V1SFSW4Zc","sessionID":"ses_f4628b113ffe9gyXGlLM5DZwK2","messageID":"msg_0b9e3f59b001S7rGfBPwlJq0UP","type":"tool","id":"call_00_jUKUjEOEVjEpituJXOYD4569","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Build /home/uctpiaj/work/extraction/providence-worcester.xlsx (PWRR x G&W 2016 deal ledger).\"\"\"\nimport re, json, bisect, os\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.utils import get_column_letter\n\nTXT = '/tmp/opencode/pxw_text.txt'\nOUT = '/home/uctpiaj/work/extraction/providence-worcester.xlsx'\nlines = open(TXT, encoding='utf-8').read().split('\\n')\n\npm = json.load(open('/tmp/opencode/pagemap.json'))\nmpos, mval = pm['mpos'], pm['mval']\ndef page_for(i):\n    j = bisect.bisect_left(mpos, i)\n    return mval[j] if j < len(mval) else None\n\ndef clean(s):\n    return re.sub(r'\\s+', ' ', s).strip()\n\nclass Source:\n    def __init__(self, sid, section, ranges):\n        self.sid, self.section, self.ranges = sid, section, ranges\n        self.text, self.lmap = '', []\n        for (a, b) in ranges:\n            for ln in range(a - 1, b):\n                t = clean(lines[ln])\n                if not t:\n                    continue\n                if self.text:\n                    self.text += ' '\n                    self.lmap.append(ln)\n                self.text += t\n                self.lmap.extend([ln] * len(t))\n    def page(self, offset=0):\n        ln = self.lmap[min(offset, len(self.lmap) - 1)]\n        return page_for(ln)\n\nBG = 'Proposal No. 1\\u2014The Merger \\u2014 Background of the Merger'\nbg_segments = [\n    (1161,1171),(1172,1184),(1185,1186),(1187,1193),(1194,1196),(1197,1201),\n    (1202,1208),(1209,1213),(1214,1217),(1218,1220),(1221,1226),(1227,1229),\n    (1230,1231),(1232,1235),(1238,1239),(1240,1241),(1242,1243),(1244,1245),\n    (1246,1247),(1248,1255),(1256,1262),(1263,1271),(1272,1278),(1279,1285),\n    (1286,1293),(1294,1303),(1304,1313),(1314,1316),(1317,1320),\n]\nP_ROWS = [Source(f'P-{i:03d}', BG, [seg]) for i, seg in enumerate(bg_segments, 1)]\nX_DEFS = [\n    ('X-001', 'Annex A \\u2014 Merger Agreement, Art. 1 (Definitions: Confidentiality Agreement)', [(4681,4682)]),\n    ('X-002', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger', [(1338,1339)]),\n    ('X-003', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger', [(1344,1348)]),\n    ('X-004', 'Summary \\u2014 Market Price of Our Common Stock', [(667,670)]),\n    ('X-005', 'Market Price of Common Stock', [(2735,2740)]),\n    ('X-006', 'Summary \\u2014 Record Date; Outstanding Shares; Shares Entitled to Vote', [(377,381)]),\n    ('X-007', 'Proposal No. 1\\u2014The Merger \\u2014 General', [(1154,1159)]),\n    ('X-008', 'Summary \\u2014 Treatment of Equity and Equity-Based Awards', [(459,465)]),\n    ('X-009', 'The Merger Agreement \\u2014 Regulatory Approvals Required for the Merger', [(2463,2469)]),\n    ('X-010', 'The Merger Agreement \\u2014 Termination of the Merger Agreement (outside date)', [(556,559)]),\n    ('X-011', 'The Merger Agreement \\u2014 Transaction Litigation', [(2470,2479)]),\n    ('X-012', 'The Voting Agreement', [(2750,2752)]),\n    ('X-013', 'Questions and Answers about the Merger and the Special Meeting', [(786,789)]),\n    ('X-014', \"Proposal No. 1\\u2014The Merger \\u2014 Opinion of the Company's Financial Advisor\", [(1447,1452)]),\n    ('X-015', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Miscellaneous (fees)', [(1672,1674)]),\n    ('X-016', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Miscellaneous (relationships)', [(1679,1681)]),\n    ('X-017', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Selected Publicly Traded Companies Analysis', [(1540,1545),(1582,1593)]),\n    ('X-018', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Analysis of Selected Precedent Transactions', [(1597,1600),(1648,1654)]),\n    ('X-019', 'Summary of Financial Analysis of BMO Capital Markets Corp. \\u2014 Discounted Cash Flow Analysis', [(1660,1668)]),\n    ('X-020', 'The Parties to the Merger Agreement \\u2014 Providence and Worcester Railroad Company', [(966,976)]),\n    ('X-021', 'The Parties to the Merger Agreement \\u2014 Genesee & Wyoming Inc.', [(978,985)]),\n    ('X-022', 'Proposal No. 1\\u2014The Merger \\u2014 Recommendation of the Board of Directors and Reasons for the Merger (likelihood of completion)', [(1381,1384)]),\n    ('X-023', 'Annex A \\u2014 Merger Agreement, Art. 1 (Definitions: Company Termination Fee)', [(4677,4677)]),\n    ('X-024', 'Summary \\u2014 Voting Agreement', [(431,434)]),\n]\nX_ROWS = [Source(sid, sec, rngs) for sid, sec, rngs in X_DEFS]\nSRC = {s.sid: s for s in P_ROWS + X_ROWS}\nSRC_ROW = {s.sid: i + 2 for i, s in enumerate(P_ROWS + X_ROWS)}\n\nLAST_PAGE = [None]\ndef quotes(*specs):\n    out, main, off = [], None, None\n    for sid, a, b in specs:\n        s = SRC[sid]\n        i = s.text.find(a)\n        if i < 0:\n            raise SystemExit(f'START not found in {sid}: {a[:70]}')\n        j = s.text.find(b, i)\n        if j < 0:\n            raise SystemExit(f'END not found in {sid}: {b[:70]}')\n        out.append(s.text[i:j + len(b)])\n        if main is None:\n            main, off = s, i\n    LAST_PAGE[0] = main.page(off)\n    return out\n\n# ---------------------------------------------------------------- rows\nrows = []\ndef add(when, who, what, rnd, typ=None, terms='', why='', src=(), review=None, count=None,\n        df=None, dt=None, wa=None, basis=None, method=None, formality=None, cond=None,\n        pl=None, ph=None, kind=None, origin=None, curr=None, cash=None, cclose=None,\n        cdetail=None, due=None, dlm=None, rfin=None, dec=None, ex=None, ob=None,\n        rel=None, page=None):\n    rows.append(dict(when=when, who=who, what=what, rnd=rnd, typ=typ, terms=terms, why=why,\n                     src=list(src), review=review, count=count, df=df, dt=dt, wa=wa, basis=basis,\n                     method=method, formality=formality, cond=cond, pl=pl, ph=ph, kind=kind,\n                     origin=origin, curr=curr, cash=cash, cclose=cclose, cdetail=cdetail,\n                     due=due, dlm=dlm, rfin=rfin, dec=dec, ex=ex, ob=ob, rel=rel,\n                     page=(page if page is not None else LAST_PAGE[0])))\n\n# ---- Round 0\nq = quotes(('P-001', 'In the fourth quarter of 2015', 'enhance regional connectivity'))\nadd('Q4 2015 (calendar quarter)', 'Party A (one of the Company\\u2019s Class I rail partners)', 'Bidder interest', '0',\n    'Strategic',\n    'Unpriced approach: Party A suggested possible joint venture arrangements and expressed interest in acquiring equity in the Company to develop strategic opportunities and enhance regional connectivity; scope as to control not specified (not treated as a whole-company bid); first sale-related contact, bidder-initiated, with the Chairman/CEO and the VP & Chief Commercial Officer; prompted the Board to form an investment-banker subcommittee. Count 1 = newly represented first-contact party (the contact fact is carried here; see Summary contact tally).',\n    'Bidder interest (stated): the filing reports an unpriced expression of interest in acquiring equity, not a priced proposal, and no per-share or aggregate value exists for it. Direction: bidder-to-target. Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-001'], 'Q5', count=1, df='2015-10-01', dt='2015-12-31', wa='2015-11-15',\n    basis='Reported interval', method='Assigned: midpoint')\nq = quotes(('P-001', 'the subcommittee recommended to the Board that the Company retain GHF', 'the Company engaged GHF'),\n           ('P-001', 'GHF represented to the Company that it would not represent any potential buyer', 'in connection with such an offer'))\nadd('01/27/2016', 'GHF (Greene Holcomb & Fisher LLC) \\u2014 Company financial adviser; later BMO', 'Adviser engaged', '0',\n    None,\n    'Engaged as the Company\\u2019s investment banking firm: subcommittee recommendation approved at the 01/27/2016 executive session (Director Smith absent); GHF presented its qualifications and a proposed change-in-control process; represented it would not represent any potential buyer of the Company or any person proposing financing for such an offer; engagement followed the late-2015 banker interviews. GHF\\u2019s business was acquired by BMO Capital Markets Corp. on 08/01/2016 \\u2014 the same adviser relationship continued as BMO (no second adviser row); aggregate fee ~$2.52 million.',\n    'Adviser engaged (stated): engagement approval on the stated day; the engagement-letter date is not disclosed. The GHF-to-BMO acquisition is a firm change, not a new mandate (section 5.4). Quotes: \\u201c' + q[0] + '\\u201d / \\u201c' + q[1] + '\\u201d',\n    ['P-001', 'X-015'], None, df='2016-01-27', dt='2016-01-27', wa='2016-01-27',\n    basis='Reported day', method='Reported',\n    rel='mandate continued as BMO from 08/01/2016 (Summary advisers)')\nq = quotes(('P-002', 'Representatives of GHF then proposed a process', 'regarding a change in control transaction'),\n           ('P-002', 'the Board appointed a special committee', 'a recommendation to the full Board'))\nadd('03/14/2016', 'Board of Directors (special meeting)', 'Target sale decision', '0', None,\n    'Decided to proceed with GHF\\u2019s proposed process: discussions with Party A plus solicitation of other third parties regarding a change in control transaction; qualified as an exploratory strategy, not a commitment to sell; appointed the Transaction Committee (Barrett (Chair), Anderson, Garvey) to supervise the process and recommend to the full Board; the Committee could not itself approve a change of control.',\n    'Target sale decision (stated): \\u201c' + q[0] + '\\u201d The qualification (exploratory strategy) is preserved. Committee appointment: \\u201c' + q[1] + '\\u201d',\n    ['P-002'], 'Q1', df='2016-03-14', dt='2016-03-14', wa='2016-03-14',\n    basis='Reported day', method='Reported', rel='candidate R1 anchor (rejected); R005')\nq = quotes(('P-003', 'On March 22, 2016 and March 23, 2016', 'met with various representatives of Party A'),\n           ('P-004', 'met with various representatives of Party A on March 22 and 23, 2016', 'informed Party A of GHF\\u2019s engagement'))\nadd('03/22/2016\\u201303/23/2016', 'Party A', 'Contact', '0', 'Strategic',\n    'Management (CFO/Treasurer Noreck and other senior managers) met Party A representatives and informed Party A of GHF\\u2019s engagement. Repeat contact: Party A was already in contact from Q4 2015, so Count 0 (no double counting).',\n    'Contact (stated), repeat within the process. Quotes: \\u201c' + q[0] + '\\u201d / \\u201c' + q[1] + '\\u201d A two-day series of meetings takes its first day as the Working date.',\n    ['P-003', 'P-004'], None, count=0, df='2016-03-22', dt='2016-03-23', wa='2016-03-22',\n    basis='Reported interval', method='Assigned: bound', rel='first contact R001')\nq = quotes(('P-004', 'The Transaction Committee authorized GHF to contact Party A', 'change in control transaction'))\nadd('03/24/2016', 'Transaction Committee', 'Target decision', '0', None,\n    'Authorized GHF to contact Party A and other potential buyers to determine their interest in a change in control transaction. Candidate anchor for Round 1, rejected: an authorization to approach firms is not the completed outreach (the actual first wave is R007).',\n    'Target decision (stated): \\u201c' + q[0] + '\\u201d Kept as a rejected R1 anchor row so the boundary can be moved.',\n    ['P-004'], 'Q1', df='2016-03-24', dt='2016-03-24', wa='2016-03-24',\n    basis='Reported day', method='Reported', rel='candidate R1 anchor (rejected); R007; R008')\nq = quotes(('P-004', 'representatives of each of GHF and the Company\\u2019s legal counsel', 'participated in all meetings of the Transaction Committee'))\nadd('03/24/2016', 'Hinckley, Allen & Snyder LLP (Hinckley Allen) \\u2014 Company legal counsel',\n    'Adviser service observed', '0', None,\n    'Company legal counsel; participated in all Transaction Committee meetings; engagement date not disclosed; first shown acting 03/24/2016.',\n    'Adviser service observed (stated): the filing shows Hinckley Allen already providing services on 03/24/2016; no selection or engagement date is disclosed, so the Working date is the earliest date shown acting. Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-004'], None, df='2016-03-24', dt='2016-03-24', wa='2016-03-24',\n    basis='Reported day', method='Reported')\n# ---- Round 1\nq = quotes(('P-004', 'During the week of March 28, 2016', '18 potential financial buyers'))\nadd('week of 03/28/2016', '29 potential buyers (11 strategic incl. Party A; 18 financial)', 'Contact', '1',\n    'Unknown',\n    'First outreach wave: GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers in accordance with the Transaction Committee\\u2019s directives; Count 29 = disclosed cohort size (includes Party A, already in contact since Q4 2015). Type: Unknown \\u2014 the cohort mixes strategic and financial buyers (split supplied only for the signing wave, R009\\u2013R011).',\n    'Contact (stated cohort, executed outreach). Quote: \\u201c' + q[0] + '\\u201d This is the R1 anchor event (see R008).',\n    ['P-004'], 'Q1', count=29, df='2016-03-28', dt='2016-04-03', wa='2016-03-28',\n    basis='Reported interval', method='Assigned: bound', rel='R008 (anchor event)')\nadd('week of 03/28/2016', 'Process (Round 1)', 'Round opened', '1', None,\n    'R1 anchor: first outreach wave \\u2014 GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers (R007); candidate anchors: R003 (03/14/2016 sale-strategy decision), R005 (03/24/2016 authorization to contact). Objective: solicit change-in-control interest and confirm the continuing interest of NDA signers; the round runs through the IOI stage to the 06/01/2016 advancement decision. Round finality: Not final \\u2014 no final/binding/best-and-final announcement and no move to definitive negotiation; the stage closed by selection to management presentations (R021).',\n    'Round opened (convention/analytical). First outreach wave chosen under section 6.3(1); R003 and R005 are the retained rejected candidate anchors. Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-004'], 'Q1', df='2016-03-28', dt='2016-04-03', wa='2016-03-28',\n    basis='Reported interval', method='Assigned: bound', rfin='Not final',\n    rel='anchor R007; candidates R003, R005')\nqs = quotes(('P-004', 'Each of the potential strategic buyers', 'subsequently executed confidentiality agreements'),\n            ('P-004', 'did not contain any', 'acquire the Company'))\nadd('from the week of 03/28/2016; by 04/22/2016', '10 remaining potential strategic buyers (11 contacted less G&W)',\n    'NDA signed', '1', 'Strategic',\n    'Confidentiality agreements signed by the potential strategic buyers of the outreach wave less G&W (recorded individually at R011); the agreements contained no \\u201cstandstill\\u201d or similar provision prohibiting a proposal or offer; the wave\\u2019s memorandum was later distributed to signers including Party A, Party B and G&W.',\n    'NDA signed (stated cohort; residual after G&W\\u2019s individual row, section 5.2). Base: \\u201c' + qs[0] + '\\u201d / \\u201c' + qs[1] + '\\u201d The signing wave spans the reported period, so the Working date takes its first day; the memorandum distribution (R015 source, P-007) bounds the signings.',\n    ['P-004', 'P-007'], 'Q3', count=10, df='2016-03-28', dt='2016-04-22', wa='2016-03-28',\n    basis='Relative only', method='Assigned: bound', rel='R011 (G&W); R010 (financial residual)')\nadd('from the week of 03/28/2016; by 04/22/2016', '14 potential financial buyers (of 18 contacted)',\n    'NDA signed', '1', 'Financial',\n    'Confidentiality agreements signed by 14 of the 18 potential financial buyers contacted in the outreach wave; same no-standstill terms and memorandum distribution.',\n    'NDA signed (stated cohort). Quotes: \\u201c' + qs[0] + '\\u201d / \\u201c' + qs[1] + '\\u201d',\n    ['P-004', 'P-007'], 'Q3', count=14, df='2016-03-28', dt='2016-04-22', wa='2016-03-28',\n    basis='Relative only', method='Assigned: bound', rel='R009 (strategic residual)')\nqa = quotes(('X-001', 'shall mean the Confidentiality Agreement between the Company and Parent', 'April 3, 2016'))\nqb = quotes(('P-007', 'including Party A, Party B and G&W', 'that had executed confidentiality agreements'))\nadd('04/03/2016', 'G&W (Genesee & Wyoming Inc.)', 'NDA signed', '1', 'Strategic',\n    'Acquisition-related confidentiality agreement between the Company and G&W dated 04/03/2016 (the merger agreement\\u2019s defined \\u201cConfidentiality Agreement\\u201d); G&W also met management at the 2016 Connections Convention (04/03\\u201304/06) and received the memorandum.',\n    'NDA signed (stated): the merger agreement definition fixes G&W\\u2019s individual date and the wave cohort rows (R009\\u2013R010) exclude it. Quotes: \\u201c' + qa[0] + '\\u201d / \\u201c' + qb[0] + '\\u201d',\n    ['X-001', 'P-007'], 'Q3', count=1, df='2016-04-03', dt='2016-04-03', wa='2016-04-03',\n    basis='Reported day', method='Reported', rel='R009/R010 (wave cohorts)')\nq = quotes(('P-005', 'held a series of introductory meetings with five potential strategic buyers', '2016 Connections Convention'))\nadd('04/03/2016\\u201304/06/2016', 'Five unnamed potential strategic buyers (incl. G&W)',\n    'Information access changed', '1', 'Strategic',\n    'GHF and Company management held a series of introductory management meetings with five potential strategic buyers (incl. G&W) at the American Short Line and Regional Railroad Association\\u2019s 2016 Connections Convention; the 14 financial-signer bidders and other NDA signers received no comparable management meetings at that time; the meetings were venue-based (no selection reason stated for the five). Count blank (access row).',\n    'Information access changed (classification): management meetings given to some live bidders and not others, recorded once for the access decision (not per meeting). Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-005'], 'Q1', df='2016-04-03', dt='2016-04-06', wa='2016-04-03',\n    basis='Reported interval', method='Assigned: bound')\nq = quotes(('P-006', 'the Transaction Committee authorized representatives of GHF, on behalf of', 'to confirm their continuing interest'))\nadd('04/07/2016', 'Transaction Committee', 'Target decision', '1', None,\n    'Authorized GHF to contact the five convention parties, other potential strategic buyers (including certain Class I railroads) and private equity firms under NDA to confirm their continuing interest.',\n    'Target decision (stated). Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-006'], None, df='2016-04-07', dt='2016-04-07', wa='2016-04-07',\n    basis='Reported day', method='Reported')\nq = quotes(('P-006', 'Mr. Noreck reported', 'in a possible transaction'))\nadd('by 04/07/2016; day not disclosed', 'Two unnamed additional Class I railroads', 'Contact', '1', 'Strategic',\n    'Approached by the Company (management) before the 04/07/2016 committee report to gauge interest in a possible transaction; no NDA, bid or further participation reported; they never entered the process (no outcome row). Count 2 = cohort size.',\n    'Contact (stated): \\u201c' + q[0] + '\\u201d Direction: target-to-bidder; the approach precedes the 04/07/2016 meeting (day not disclosed), so the bound is the report date.',\n    ['P-006'], None, count=2, df=None, dt='2016-04-07', wa='2016-04-07',\n    basis='Relative only', method='Assigned: bound')\nq = quotes(('P-006', 'Subsequently, on April 21, 2016', 'another potential strategic buyer'))\nadd('04/21/2016', 'Party B', 'Contact', '1', 'Strategic',\n    'Introductory meeting held by the Company and GHF with Party B; first individually recorded meeting for Party B. Repeat contact: Party B is treated as one of the contacted NDA signers of the March wave (R007/R009), so Count 0; the alternative reading is flagged in Q5.',\n    'Contact (stated), repeat within the wave. Quote: \\u201c' + q[0] + '\\u201d',\n    ['P-006'], 'Q5', count=0, df='2016-04-21', dt='2016-04-21', wa='2016-04-21',\n    basis='Reported day', method='Reported')\nq = quotes(('P-007', 'each potential buyer had been advised', 'May 10, 2016'))\nadd('by 04/27/2016; IOI deadline 05/10/2016', 'Process (all potential buyers)', 'Deadline set', '1', None,\n    'Each potential buyer advised to submit a non-binding indication of interest by 05/10/2016; the advice is reported at the 04/27/2016 executive session of the Board; deadline version 1 (later revised, R017). Communication day not disclosed.',\n    'Deadline set (stated); known only by the 04/27/2016 report. Quote: \\u201c' + q[0] + '\\u201d This date was superseded before arrival, so it stays in the set/revised history with no milestone row.',\n    ['P-007'], 'Q2', due='2016-05-10', df=None, dt='2016-04-27', wa='2016-04-27',\n    basis='Relative only', method='Assigned: bound')\nq = quotes(('P-007', 'which deadline was subsequently postponed to May 19, 2016', 'most compelling offers'))\nadd('after 04/27/2016; day not disclosed (new deadline 05/19/2016)', 'Process (all potential buyers)',\n    'Deadline revised', '1', None,\n    'IOI deadline postponed from 05/10/2016 to 05/19/2016 to ensure potential buyers had sufficient time to formulate their most compelling offers; requester not disclosed; all potential buyers affected. Treatment: Extended \\u2014 this row moved the 05/10/2016 due date (recorded here and in the Summary map).',\n    'Deadline revised (stated). Quote: \\u201c' + q[0] + '\\u201d Revision day not disclosed; window 04/27\\u201305/19 bounded by the 04/27 report and the new due date; midpoint assigned.',\n    ['P-007'], 'Q2', due='2016-05-19', dlm='Extended', df='2016-04-27', dt='2016-05-19',\n    wa='2016-05-08', basis='Relative only', method='Assigned: midpoint', rel='moves R016 (05/10) to 05/19')\nq = quotes(('P-008', 'Between May 19, 2016 and June 1, 2016', 'nine written indications of interest'),\n           ('P-008', 'the Transaction Committee concluded that the two low bidders should be excluded', 'remaining seven potential buyers'))\nadd('05/19/2016', 'Process (all potential buyers)', 'Deadline', '1', None,\n    'IOI deadline reached while operative; nine IOIs were received between 05/19 and 06/01 (a window that straddles the due date, so no submission is treated as late) and the committee took its next step on the bids in hand (05/23 and 06/01 reviews; exclusions and advancement). Treatment: Enforced.',\n    'Deadline (stated milestone; treatment convention). Quotes: \\u201c' + q[0] + '\\u201d / \\u201c' + q[1] + '\\u201d',\n    ['P-008'], 'Q2', due='2016-05-19', dlm='Enforced', df='2016-05-19', dt='2016-05-19',\n    wa='2016-05-19', basis='Reported day', method='Reported')\nq = quotes(('P-008', 'Between May 19, 2016 and June 1, 2016', 'equity values of $90 million to $134 million'))\nadd('05/19/2016\\u201306/01/2016', 'Nine IOI submitters (anonymous cohort)', 'Bid', '1', 'Unknown',\n    'Nine written non-binding indications of interest at $17.93\\u2013$26.50 per share (as-converted; group envelope across the cohort, not any member\\u2019s price), implying equity values of $90\\u2013134 million; made before substantive diligence access (no data site before the 06/01/2016 advancement), so Heavy by context. Parties B, D, E, F and G&W and the two excluded low bidders fall within this cohort\\u2