{"type":"tool_use","timestamp":1789825011518,"sessionID":"ses_f4628fb5effez2Rp2Ib8TcXtcB","part":{"partID":"prt_0b9e15eda0016Ul6us6sJpKQSq","sessionID":"ses_f4628fb5effez2Rp2Ib8TcXtcB","messageID":"msg_0b9e14d3c001KQ4jgQ1PHnnCfB","type":"tool","id":"call_00_bLuBSV9uGacOhN0ZGTzw5673","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/build_petsmart.py","content":"#!/usr/bin/env python3\n# Build PetSmart deal ledger workbook (SEC_Deal_Ledger_Extraction_Instruction, rev 19 Sep 2026).\nimport json, re, datetime as dt\nfrom collections import OrderedDict\n\nCORPUS = [json.loads(l) for l in open('/tmp/opencode/corpus.jsonl')]\nUNIT = {(r['pi'], r['ui']): r for r in CORPUS}\n\n# ---------------------------------------------------------------- source registry\nP_ITEMS = [\n    ('P-001', 27, 6,  'Background of the Merger', False),\n    ('P-002', 27, 7,  'Background of the Merger', False),\n    ('P-003', 27, 8,  'Background of the Merger', False),\n    ('P-004', 27, 9,  'Background of the Merger', True),\n    ('P-005', 28, 1,  'Background of the Merger', True),\n    ('P-006', 28, 2,  'Background of the Merger', False),\n    ('P-007', 28, 3,  'Background of the Merger', False),\n    ('P-008', 28, 4,  'Background of the Merger', True),\n    ('P-009', 29, 1,  'Background of the Merger', True),\n    ('P-010', 29, 2,  'Background of the Merger', False),\n    ('P-011', 29, 3,  'Background of the Merger', False),\n    ('P-012', 29, 4,  'Background of the Merger', False),\n    ('P-013', 29, 5,  'Background of the Merger', False),\n    ('P-014', 29, 6,  'Background of the Merger', False),\n    ('P-015', 30, 1,  'Background of the Merger', True),\n    ('P-016', 30, 2,  'Background of the Merger', False),\n    ('P-017', 30, 3,  'Background of the Merger', False),\n    ('P-018', 30, 4,  'Background of the Merger', False),\n    ('P-019', 30, 5,  'Background of the Merger', False),\n    ('P-020', 30, 6,  'Background of the Merger', False),\n    ('P-021', 31, 1,  'Background of the Merger', True),\n    ('P-022', 31, 2,  'Background of the Merger', False),\n    ('P-023', 31, 3,  'Background of the Merger', False),\n    ('P-024', 31, 4,  'Background of the Merger', False),\n    ('P-025', 31, 5,  'Background of the Merger', False),\n    ('P-026', 31, 6,  'Background of the Merger', False),\n    ('P-027', 31, 7,  'Background of the Merger', False),\n    ('P-028', 32, 1,  'Background of the Merger', True),\n    ('P-029', 32, 2,  'Background of the Merger', False),\n    ('P-030', 32, 3,  'Background of the Merger', False),\n    ('P-031', 32, 4,  'Background of the Merger', False),\n]\nX_ITEMS = [\n    ('X-001', 7, 9,  'Summary — Definitions'),\n    ('X-002', 8, 10, 'Summary — Effect of Merger'),\n    ('X-003', 8, 12, 'Summary — Record Date and Quorum'),\n    ('X-004', 9, 18, 'Summary — Voting Support Agreement'),\n    ('X-005', 10, 14, 'Questions and Answers'),\n    ('X-006', 11, 17, 'Questions and Answers'),\n    ('X-007', 22, 5, 'The Parties to the Merger Agreement'),\n    ('X-008', 33, 3, 'Reasons for the Merger'),\n    ('X-009', 34, 13, 'Reasons for the Merger'),\n    ('X-010', 34, 17, 'Reasons for the Merger'),\n    ('X-011', 40, 3, 'Financing'),\n    ('X-012', 40, 5, 'Financing — Debt'),\n    ('X-013', 40, 7, 'Financing — Equity'),\n    ('X-014', 40, 9, 'Financing'),\n    ('X-015', 41, 2, 'Financing — Equity'),\n    ('X-016', 41, 11, 'Financing — Equity'),\n    ('X-017', 41, 13, 'Financing — Debt'),\n    ('X-018', 58, 3, 'Regulatory Approvals'),\n    ('X-019', 58, 6, 'Regulatory Approvals'),\n    ('X-020', 58, 8, 'Litigation'),\n    ('X-021', 82, 74, 'Market Price of the Company\\u2019s Common Stock'),\n    ('X-022', 83, 26, 'Security Ownership of Certain Beneficial Owners and Management'),\n    ('X-023', 26, 7, 'Solicitation of Proxies'),\n    ('X-024', 2, 8, 'Proxy Statement — Date'),\n    ('X-025', 23, 4, 'The Special Meeting'),\n    ('X-026', 32, 8, 'Reasons for the Merger'),\n    ('X-027', 34, 6, 'Reasons for the Merger — Likelihood of Completion'),\n    ('X-028', 143, 7, 'The Merger Agreement — Notices (Annex A)'),\n]\n\ndef split_unit_text(text, cut_points):\n    \"\"\"Split a long unit at cut-point snippets; returns list of parts.\"\"\"\n    norm = normalize(text)\n    idxs = []\n    for cp in cut_points:\n        n = normalize(cp)\n        i = norm.find(n)\n        if i < 0:\n            raise ValueError('cut point not found: ' + cp[:40])\n        idxs.append(i)\n    parts, prev = [], 0\n    # convert normalized index back to original: normalized replaces same-length chars\n    # our normalize is 1:1 per char (quote chars + dashes), so indices align\n    for i in idxs:\n        parts.append(text[prev:i].strip())\n        prev = i\n    parts.append(text[prev:].strip())\n    return parts\n\ndef normalize(s):\n    s = s.replace('\\u2019', \"'\").replace('\\u2018', \"'\")\n    s = s.replace('\\u201c', '\"').replace('\\u201d', '\"')\n    s = s.replace('\\u2013', '-').replace('\\u2014', '-')\n    s = s.replace('\\u00a0', ' ')\n    return s\n\nREG = OrderedDict()   # id -> dict(text, page, section, pi, ui)\nfor pid, pi, ui, sec, cont in P_ITEMS:\n    t = UNIT[(pi, ui)]['text']\n    REG[pid] = {'text': t, 'page': UNIT[(pi, ui)]['page'], 'section': sec, 'pi': pi, 'ui': ui, 'cont': cont}\nfor xid, pi, ui, sec in X_ITEMS:\n    t = UNIT[(pi, ui)]['text']\n    if xid == 'X-008':\n        parts = split_unit_text(t, ['The board noted that Bidder 2', 'Among other things, the Buyer Group informed'])\n        for i, ch in enumerate(['a', 'b', 'c']):\n            REG[f'X-008{ch}'] = {'text': parts[i], 'page': '27', 'section': sec, 'pi': pi, 'ui': ui, 'cont': i > 0}\n    else:\n        REG[xid] = {'text': t, 'page': UNIT[(pi, ui)]['page'], 'section': sec, 'pi': pi, 'ui': ui, 'cont': False}\n\n# ---------------------------------------------------------------- quote extraction\ndef toks(s):\n    out = []\n    for m in re.finditer(r'\\S+', s):\n        out.append((normalize(m.group(0)).lower(), m.start(), m.end()))\n    return out\n\ndef find_quote(src_id, start, end):\n    text = REG[src_id]['text']\n    tt = toks(text)\n    st = toks(start); et = toks(end)\n    sn = [x[0] for x in st]; en = [x[0] for x in et]\n    wn = [x[0] for x in tt]\n    # find start token sequence\n    si = None\n    for i in range(len(wn) - len(sn) + 1):\n        if wn[i:i+len(sn)] == sn:\n            si = i; break\n    if si is None:\n        raise ValueError(f'[{src_id}] start not found: {start[:60]!r}')\n    # find end token sequence at/after start\n    ei = None\n    for j in range(si + len(sn) - 1, len(wn) - len(en) + 1):\n        if wn[j:j+len(en)] == en:\n            ei = j + len(en) - 1; break\n    if ei is None:\n        raise ValueError(f'[{src_id}] end not found: {end[:60]!r}')\n    return text[tt[si][1]:tt[ei][2]]\n\ndef make_why(reason, quotes):\n    parts = [reason]\n    for qid, s, e in quotes:\n        q = find_quote(qid, s, e)\n        parts.append(f'\\u201c{q}\\u201d (p.{REG[qid][\"page\"]}).')\n    return ' '.join(parts)\n\n# ---------------------------------------------------------------- ledger rows\nD = dt.date\ndef d(y, m, dd): return D(y, m, dd)\n\nROWS = [\n dict(id='R001', when='06/18/2014', who='PetSmart board (with management, a financial advisor and Wachtell Lipton)',\n   what='Material process update', round=0,\n   terms='Board reviewed strategic and financial alternatives; determined to explore capital-structure changes with a focus on returning capital to stockholders; established the ad hoc committee (Chairman Gregory Josefowicz, Rakesh Gangwal, Thomas Stemberg); authorized the vetting and retention of a financial advisor.',\n   reason='Stated. First board step in the exploration that became the sale process; not itself a sale decision.',\n   quotes=[('P-004', 'At a meeting on June 18, 2014', 'focus on returning capital to stockholders'),\n           ('P-005', 'Chairman Gregory Josefowicz', 'to assist in the review')],\n   src=['P-004','P-005'], review='Q1', count=None,\n   df=d(2014,6,18), dt=d(2014,6,18), wd=d(2014,6,18), basis='Reported day', method='Reported',\n   page=21, related='', deal='PetSmart'),\n dict(id='R002', when='06/18/2014', who='Wachtell, Lipton, Rosen & Katz (adviser)',\n   what='Adviser service observed', round=0,\n   terms='Client: PetSmart (Company). Role: legal advisor. Shown acting at the June 18, 2014 board meeting; engagement date not disclosed.',\n   reason='Stated (earliest supported service date). A first narrative mention alone is not proof of retention on that date; the filing shows Wachtell advising the board on this mandate.',\n   quotes=[('P-004','the board reviewed, together with a financial advisor','its legal advisor')],\n   src=['P-004'], review=None, count=None,\n   df=d(2014,6,18), dt=d(2014,6,18), wd=d(2014,6,18), basis='Reported day', method='Reported',\n   page=21, related='', deal='PetSmart'),\n dict(id='R003', when='July 2014 (day not disclosed)', who='J.P. Morgan Securities LLC (adviser)',\n   what='Adviser engaged', round=0,\n   terms='Client: PetSmart (Company). Role: financial advisor and process bank (the only named target financial advisor; fairness opinion rendered 12/13/2014, confirmed in writing 12/14/2014). Retained in July 2014 after interviewing several potential financial advisors.',\n   reason='Stated engagement; month stated without a day. Convention: Working date assigned to 07/01 to preserve reading order ahead of the dated July 3 JANA filing; the retention day is not disclosed (also see Q8).',\n   quotes=[('P-005','In July, after interviewing several potential financial advisors','its familiarity with the Company')],\n   src=['P-005'], review='Q8', count=None,\n   df=d(2014,7,1), dt=d(2014,7,31), wd=d(2014,7,1), basis='Reported interval', method='Assigned: sequence',\n   page=22, related='', deal='PetSmart'),\n dict(id='R004', when='07/03/2014', who='JANA Partners LLC (activist)',\n   what='Activist pressure', round=0,\n   terms='JANA disclosed a 9.9% stake and intent to engage management and the board on a review of strategic alternatives, including a sale; over July–August JANA filed further Schedule 13D amendments and public letters advocating a sale.',\n   reason='Stated. Sale advocacy (not a bid).',\n   quotes=[('P-006','On July 3, 2014, JANA Partners filed a Schedule 13D','including a sale of the Company')],\n   src=['P-006'], review=None, count=None,\n   df=d(2014,7,3), dt=d(2014,7,3), wd=d(2014,7,3), basis='Reported day', method='Reported',\n   page=22, related='', deal='PetSmart'),\n dict(id='R005', when='07/07/2014', who='Longview Asset Management, LLC (activist / later rollover investor)',\n   what='Activist pressure', round=0,\n   terms='Longview publicly urged the board to consider a sale and said it would consider rolling part or all of its holdings into acquiring-entity equity rather than cash if needed to enable a transaction.',\n   reason='Stated. Earliest disclosed Longview rollover willingness; the rollover-support relationship is recorded once when permitted/formed (R043).',\n   quotes=[('P-006','On July 7, 2014, Longview made public a letter','enable the Company to complete a transaction')],\n   src=['P-006'], review=None, count=None,\n   df=d(2014,7,7), dt=d(2014,7,7), wd=d(2014,7,7), basis='Reported day', method='Reported',\n   page=22, related='R043', deal='PetSmart'),\n dict(id='R006', when='07/10/2014', who='JANA Partners LLC (activist)',\n   what='Activist pressure', round=0,\n   terms='JANA representatives met in person with Company representatives and advocated for a sale.',\n   reason='Stated.',\n   quotes=[('P-006','On July 10, 2014, representatives of JANA met in person','advocated for a sale of the Company')],\n   src=['P-006'], review=None, count=None,\n   df=d(2014,7,10), dt=d(2014,7,10), wd=d(2014,7,10), basis='Reported day', method='Reported',\n   page=22, related='', deal='PetSmart'),\n dict(id='R007', when='07/10/2014', who='Longview Asset Management, LLC (activist)',\n   what='Activist pressure', round=0,\n   terms='Company representatives spoke with Longview, which reiterated its advocacy for a sale.',\n   reason='Stated.',\n   quotes=[('P-006','representatives of the Company also spoke to representatives of Longview','reiterated its advocacy for a sale of the Company')],\n   src=['P-006'], review=None, count=None,\n   df=d(2014,7,10), dt=d(2014,7,10), wd=d(2014,7,10), basis='Reported day', method='Reported',\n   page=22, related='', deal='PetSmart'),\n dict(id='R008', when='08/07/2014', who='Industry Participant (strategic party)',\n   what='Bidder interest', round=0,\n   terms='Industry Participant contacted J.P. Morgan: if PetSmart pursued strategic alternatives, it might be interested in revisiting a possible combination; J.P. Morgan reported the conversation to the ad hoc committee. Unpriced. Count 1 (Industry Participant\\u2019s first contact representation).',\n   reason='Stated. Inbound unpriced approach; Industry Participant never entered the process and is not closed out (see R010, R014 and Q5).',\n   quotes=[('P-007','a representative of Industry Participant contacted a representative of J.P. Morgan','possible combination of the two Companies')],\n   src=['P-007'], review='Q5', count=1,\n   df=d(2014,8,7), dt=d(2014,8,7), wd=d(2014,8,7), basis='Reported day', method='Reported',\n   page=22, related='R010; R014; R015', deal='PetSmart', type='Strategic'),\n dict(id='R009', when='08/13/2014', who='PetSmart board (with management, J.P. Morgan and Wachtell Lipton)',\n   what='Target sale decision', round=0,\n   terms='Board determined to explore strategic alternatives, including a possible sale of the Company, to maximize stockholder value; instructed management to plan the Profit Improvement Plan; authorized the ad hoc committee to oversee the sale exploration, direct advisers and lead negotiations; planned J.P. Morgan outreach to financial and strategic parties in the second half of September or early October and a public announcement to draw inbound interest.',\n   reason='Stated. Target-led exploration decision; the filing does not report the planned outreach as beginning within about a week, so this is not the Round 1 anchor (see R016 and Q1).',\n   quotes=[('P-008','determined to explore strategic alternatives (including a possible sale of the Company)','maximize value for stockholders')],\n   src=['P-008'], review='Q1', count=None,\n   df=d(2014,8,13), dt=d(2014,8,13), wd=d(2014,8,13), basis='Reported day', method='Reported',\n   page=22, related='R016; R017', deal='PetSmart'),\n dict(id='R010', when='08/13/2014', who='PetSmart board (re Industry Participant)',\n   what='Target decision', round=0,\n   terms='Board determined not to invite Industry Participant to the exploratory sale process after weighing the very high antitrust-clearance risk (likely \\u201csecond request\\u201d, eight months to a year or longer, no assurance of success), the risk of giving it diligence information, and process disruption/delay risk.',\n   reason='Stated. Exclusion of a party that never entered; no participation-outcome row (see Q5).',\n   quotes=[('P-008','the very high risk that an acquisition by or a combination with Industry Participant','imposition by governmental authorities of unacceptable conditions'),\n           ('P-010','Industry Participant would not be invited into the exploratory process','the board would consider it')],\n   src=['P-008','P-010'], review='Q5', count=None,\n   df=d(2014,8,13), dt=d(2014,8,13), wd=d(2014,8,13), basis='Reported day', method='Reported',\n   page=22, related='R008; R014; R015', deal='PetSmart'),\n dict(id='R011', when='mid-August to end-October 2014', who='Three strategic parties (cohort; excluding Industry Participant)',\n   what='Contact', round=0, type='Strategic',\n   terms='J.P. Morgan was contacted by three strategic parties (not counting Industry Participant) while the Company prepared for a sale process; unpriced. None proceeded to a confidentiality agreement (the 15 signers were all financial buyers). Count 3.',\n   reason='Stated (split by type). Inferred that the three strategic parties did not sign non-disclosure agreements: the filing describes the signer cohort as 15 financial buyers.',\n   quotes=[('P-011','J.P. Morgan was contacted by 27 potential participants in a sale process','three strategic parties (not counting Industry Participant) and 24 financial participants'),\n           ('P-013','confidentiality and standstill agreements with 15 potentially interested financial buyers','detailed information concerning the Profit Improvement Plan')],\n   src=['P-011','P-013'], review='Q4', count=3,\n   df=d(2014,8,13), dt=d(2014,10,31), wd=d(2014,8,13), basis='Reported interval', method='Assigned: bound',\n   page=23, related='R012; R017', deal='PetSmart'),\n dict(id='R012', when='mid-August to end-October 2014', who='24 financial parties (cohort)',\n   what='Contact', round=0, type='Financial',\n   terms='J.P. Morgan was contacted by 24 financial participants (including potential lead buyers and large suppliers of equity capital to lead buyers); 15 later signed confidentiality agreements and entered the process; 9 did not sign. Count 24. Contacts continued through end-October and span the Round 1 opening.',\n   reason='Stated (split by type). One disclosed aggregate; the 15 signers are a subset of these 24.',\n   quotes=[('P-011','including three strategic parties (not counting Industry Participant) and 24 financial participants','large suppliers of equity capital to lead buyers')],\n   src=['P-011'], review='Q4', count=24,\n   df=d(2014,8,13), dt=d(2014,10,31), wd=d(2014,8,13), basis='Reported interval', method='Assigned: bound',\n   page=23, related='R011; R017', deal='PetSmart'),\n dict(id='R013', when='08/19/2014', who='PetSmart, Inc. (issuer)',\n   what='Sale process announced', round=0,\n   terms='Press release (concurrent with PetSmart\\u2019s second-quarter earnings announcement) disclosing the determination to explore strategic alternatives, including a possible sale, to maximize stockholder value.',\n   reason='Stated. Publicity made parties not contacted aware of the process and able to approach J.P. Morgan.',\n   quotes=[('P-009','On August 19, 2014, concurrent with its second quarter earnings announcement','including a possible sale of the Company')],\n   src=['P-009'], review='Q1', count=None,\n   df=d(2014,8,19), dt=d(2014,8,19), wd=d(2014,8,19), basis='Reported day', method='Reported',\n   page=23, related='R009; R016', deal='PetSmart'),\n dict(id='R014', when='08/22/2014', who='J.P. Morgan (target side) / Industry Participant',\n   what='Contact', round=0,\n   terms='J.P. Morgan called Industry Participant\\u2019s representative: confirmed Industry Participant was aware of the August 19 announcement and informed it of the board\\u2019s concerns; the parties agreed to speak again. Count 0 (Industry Participant already represented by R008).',\n   reason='Stated. Direction: target to bidder; implementing the exclusion decision.',\n   quotes=[('P-010','On August 22, 2014, a representative of J.P. Morgan contacted by telephone','The parties agreed to speak again in a few days')],\n   src=['P-010'], review=None, count=0,\n   df=d(2014,8,22), dt=d(2014,8,22), wd=d(2014,8,22), basis='Reported day', method='Reported',\n   page=23, related='R008; R010', deal='PetSmart'),\n dict(id='R015', when='08/27/2014', who='Industry Participant (bidder side) / J.P. Morgan (target side)',\n   what='Contact', round=0,\n   terms='Industry Participant called J.P. Morgan stating it would have interest in discussing a combination; J.P. Morgan reiterated the board\\u2019s concerns and said Industry Participant would not be invited into the exploratory process, but any proposal or communication it submitted would be considered by the board. No contact between PetSmart and Industry Participant since. Count 0.',\n   reason='Stated. Final exclusion position; Industry Participant never entered and has no outcome row.',\n   quotes=[('P-010','Industry Participant would have interest in discussing the possibility of a combination','the board would consider it')],\n   src=['P-010'], review='Q5', count=0,\n   df=d(2014,8,27), dt=d(2014,8,27), wd=d(2014,8,27), basis='Reported day', method='Reported',\n   page=23, related='R008; R010', deal='PetSmart'),\n dict(id='R016', when='first week of October 2014', who='PetSmart / J.P. Morgan (process)',\n   what='Round opened', round=1,\n   terms='R1 anchor: confidentiality and standstill agreements with 15 financial buyers, first week of October 2014. Rejected candidate anchors: R009 (08/13 sale decision), R013 (08/19 press release), R008/R015 (Industry Participant contacts), R019–R020 (10/30 IOI deadline). No target outreach wave is reported (parties came to the target after the 08/19 announcement), so Round 1 opens at the first target-organized step that admits participants. Round finality: Not final — only non-binding preliminary indications of interest were solicited; no finality announcement.',\n   reason='Convention (boundary): per section 6.3 anchor order. The NDA wave is the earliest target-organized admission step (the October process letter carrying the IOI deadline came later).',\n   quotes=[('P-013','In the first week of October 2014, the Company entered into confidentiality and standstill agreements','management presentations involving the Company\\u2019s senior-most management'),\n           ('P-011','J.P. Morgan was contacted by 27 potential participants in a sale process','and 24 financial participants')],\n   src=['P-013','P-011'], review='Q1', count=None,\n   df=d(2014,10,1), dt=d(2014,10,7), wd=d(2014,10,1), basis='Reported interval', method='Assigned: bound',\n   finality='Not final', page=23, related='R009; R013; R019; R020', deal='PetSmart'),\n dict(id='R017', when='first week of October 2014', who='15 potentially interested financial buyers (cohort)',\n   what='NDA signed', round=1, type='Financial',\n   terms='15 financial buyers executed confidentiality and standstill agreements with the Company (new signatures; no reused agreements identified). All 15 engaged in due diligence during October, received management presentations involving senior-most management, and received detailed financial and business plan information including the Profit Improvement Plan and cost-saving plans. Standstills prevent them from submitting (or seeking permission to submit) a higher bid once the Company entered a definitive agreement with the winning process participant. Count 15.',\n   reason='Stated. Uniform stage access is stated on this admission row, not as separate information-access rows. Auction screen: more than one independent prospective acquiring bidder unit signed (met).',\n   quotes=[('P-013','all 15 of which, during the month of October engaged in due diligence','detailed information concerning the Profit Improvement Plan and associated cost-saving plans and opportunities'),\n           ('X-009','standstill provisions that prevent those parties from submitting','once the Company entered into a definitive transaction agreement with the winning sale process participant')],\n   src=['P-013','X-009'], review='Q4', count=15,\n   df=d(2014,10,1), dt=d(2014,10,7), wd=d(2014,10,1), basis='Reported interval', method='Assigned: bound',\n   page=23, related='R016; R021', deal='PetSmart'),\n dict(id='R018', when='10/03/2014', who='PetSmart board (with management, J.P. Morgan and Wachtell Lipton)',\n   what='Target decision', round=1,\n   terms='Board received a process update: approximately 15 parties had expressed interest; reviewed communications with the 27 potential participants and Industry Participant; reaffirmed the determination not to invite Industry Participant to the process.',\n   reason='Stated. The relative order of this meeting and the NDA wave start is not stated; the NDA-wave rows are placed first under the section 8.1 order convention (see Q8).',\n   quotes=[('P-012','the board was informed that approximately 15 parties had expressed interest in participating in the process','reaffirmed the determination not to invite Industry Participant to participate in the sale process')],\n   src=['P-012'], review='Q8', count=None,\n   df=d(2014,10,3), dt=d(2014,10,3), wd=d(2014,10,3), basis='Reported day', method='Reported',\n   page=23, related='R010; R015; R016', deal='PetSmart'),\n dict(id='R019', when='during October 2014 (day not disclosed)', who='PetSmart / J.P. Morgan (process)',\n   what='Deadline set', round=1,\n   terms='Potential bidders were informed that non-binding preliminary indications of interest were due on 10/30/2014. They were also informed Longview would be willing to \\u201croll-over\\u201d up to 7.5 million shares on terms and price acceptable to Longview, and were asked to indicate their interest in Longview participation; such interest was not a condition to participation. Due date 10/30/2014.',\n   reason='Stated. Communication day not disclosed; assigned the period midpoint (see Q8). The Longview rollover availability is folded into this process communication; the rollover relationship itself is recorded once at R043.',\n   quotes=[('P-014','During October, the potential bidders were informed that non-binding preliminary indications of interest would be due on October 30, 2014','up to 7.5 million shares on terms and price acceptable to Longview'),\n           ('P-015','such interest was not a condition to participation in the process','not a condition to participation in the process')],\n   src=['P-014','P-015'], review='Q8', count=None,\n   df=d(2014,10,1), dt=d(2014,10,30), wd=d(2014,10,15), basis='Reported interval', method='Assigned: midpoint',\n   due=d(2014,10,30), page=23, related='R020', deal='PetSmart'),\n dict(id='R020', when='10/30/2014', who='PetSmart (process deadline)',\n   what='Deadline', round=1,\n   terms='Due date for non-binding preliminary indications of interest. Si