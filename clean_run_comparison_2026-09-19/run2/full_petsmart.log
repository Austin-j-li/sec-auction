{"type":"tool_use","timestamp":1789825159421,"sessionID":"ses_f4628fb5effez2Rp2Ib8TcXtcB","part":{"partID":"prt_0b9e3e37e001hGbIhYFa21isur","sessionID":"ses_f4628fb5effez2Rp2Ib8TcXtcB","messageID":"msg_0b9e378a1001tuoC8sJiFCoC61","type":"tool","id":"call_00_p24hdsjyeIy3Riuobfw49255","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n# Build the PetSmart deal-ledger workbook from the validated payload.\nimport json, datetime as dt, math, re\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, PatternFill, Alignment, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.formatting.rule import FormulaRule\n\nP = json.load(open('/tmp/opencode/payload.json'))\nROWS = P['rows']; SRC = P['source']\nSRC_BY_ID = {s['id']: s for s in SRC}\n\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\nDEAL = 'PetSmart'\n\nthin = Side(style='thin', color='BFBFBF')\nBORDER = Border(left=thin, right=thin, top=thin, bottom=thin)\nHDR_FILL = PatternFill('solid', fgColor='1F4E79')\nHDR_FONT = Font(bold=True, color='FFFFFF', size=10)\nBODY_FONT = Font(size=10)\nSECT_FONT = Font(bold=True, color='1F4E79', size=11)\nTITLE_FONT = Font(bold=True, size=14, color='1F4E79')\nWRAP = Alignment(wrap_text=True, vertical='top')\nWRAP_C = Alignment(wrap_text=True, vertical='center')\nREDBOLD = Font(color='FFFF0000', bold=True, size=10)\n\nwb = Workbook()\nws = wb.active; ws.title = 'Deal ledger'\n\n# ---------------- Deal ledger ----------------\nLED_COLS = [\n    ('A', '#', 6), ('B', 'When', 17), ('C', 'Who', 27), ('D', 'What happened', 19),\n    ('E', 'Process', 9), ('F', 'Round', 8), ('G', 'Type', 11), ('H', 'Terms or outcome', 62),\n    ('I', 'Formality', 13), ('J', 'Conditions level', 15), ('K', 'Why and evidence', 85),\n    ('L', 'Source', 20), ('M', 'Review', 11), ('N', 'Reviewer note', 16),\n    ('O', 'Row id', 9), ('P', 'Include', 9), ('Q', 'Count', 8),\n    ('R', 'Date from', 11), ('S', 'Date to', 11), ('T', 'Working date', 12), ('U', 'Date basis', 14), ('V', 'Date method', 17),\n    ('W', 'Price low', 10), ('X', 'Price high', 10), ('Y', 'Price kind', 13), ('Z', 'Price origin', 13), ('AA', 'Currency', 9),\n    ('AB', 'All cash', 10), ('AC', 'Cash at closing', 12), ('AD', 'Conditions detail', 62),\n    ('AE', 'Due date', 11), ('AF', 'Deadline treatment', 15), ('AG', 'Round finality', 15),\n    ('AH', 'Decided by', 11), ('AI', 'Exit reason', 22), ('AJ', 'Outcome basis', 17),\n    ('AK', 'Page', 8), ('AL', 'Related rows', 24), ('AM', 'Deal', 10),\n]\nfor col, title, width in LED_COLS:\n    ws.column_dimensions[col].width = width\n    c = ws[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL\n    c.alignment = WRAP_C; c.border = BORDER\nws.row_dimensions[1].height = 26\n\ndef iso(x):\n    if not x: return None\n    return dt.date.fromisoformat(x)\n\nfirst_data_row = 2\nfor i, r in enumerate(ROWS):\n    row = first_data_row + i\n    vals = {\n        'A': i + 1,\n        'B': r.get('when'), 'C': r.get('who'), 'D': r.get('what'), 'E': 1, 'F': r.get('round'),\n        'G': r.get('type'), 'H': r.get('terms'), 'I': r.get('formality'), 'J': r.get('cond'),\n        'K': r.get('why'), 'L': '; '.join(r['src']), 'M': r.get('review'), 'N': None,\n        'O': r['id'], 'P': 'Yes', 'Q': r.get('count'),\n        'R': iso(r.get('df')), 'S': iso(r.get('dt')), 'T': iso(r.get('wd')),\n        'U': r.get('basis'), 'V': r.get('method'),\n        'W': r.get('plow'), 'X': r.get('phigh'), 'Y': r.get('kind'), 'Z': r.get('origin'), 'AA': r.get('currency'),\n        'AB': r.get('allcash'), 'AC': r.get('cash'), 'AD': r.get('conddetail'),\n        'AE': iso(r.get('due')), 'AF': r.get('treatment'), 'AG': r.get('finality'),\n        'AH': r.get('decided'), 'AI': r.get('exit'), 'AJ': r.get('obasis'),\n        'AK': r.get('page'), 'AL': r.get('related'), 'AM': DEAL,\n    }\n    for col, v in vals.items():\n        c = ws[f'{col}{row}']\n        c.value = v\n        c.font = BODY_FONT\n        c.border = BORDER\n        c.alignment = WRAP\n    for col in ('R', 'S', 'T', 'AE'):\n        ws[f'{col}{row}'].number_format = 'mm/dd/yyyy'\n    for col in ('Q',):\n        ws[f'{col}{row}'].number_format = '0'\n    for col in ('W', 'X', 'AC'):\n        ws[f'{col}{row}'].number_format = '#,##0.00'\n    # source hyperlink to main paragraph on Source text sheet\n    main_id = r['src'][0]\n    c = ws[f'L{row}']\n    c.hyperlink = f\"#'Source text'!A{SRC.index(SRC_BY_ID[main_id]) + 3}\" if False else None\n    ws[f'L{row}'].font = Font(size=10, color='0563C1', underline='single')\n\nlast_row = first_data_row + len(ROWS) - 1\nws.auto_filter.ref = f'A1:AM{last_row}'\nws.freeze_panes = 'D2'\n\n# column groups (collapsed expandable)\nfor start, end in [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),\n                   ('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]:\n    ws.column_dimensions.group(start, end, outline_level=1, hidden=True)\n\n# ---------------- Lists (hidden) ----------------\nls = wb.create_sheet('Lists')\nLISTS = {\n 'A': ('What happened', ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement',\n    'Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised',\n    'Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update',\n    'Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused',\n    'Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed',\n    'Process terminated','Process restarted','Agreement terminated','Closed']),\n 'B': ('Type', ['Strategic','Financial','Mixed','Unknown']),\n 'C': ('Formality', ['Formal','Informal','Insufficient evidence','Varies']),\n 'D': ('Conditions level', ['None','Light','Heavy','Insufficient evidence','Varies']),\n 'E': ('Include', ['Yes','No']),\n 'F': ('Date basis', ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated']),\n 'G': ('Date method', ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence']),\n 'H': ('Price kind', ['Point','Bidder range','Group envelope','Bound only','Undisclosed']),\n 'I': ('Price origin', ['Stated','Carried forward','Inferred']),\n 'J': ('All cash', ['Yes','No','Not stated']),\n 'K': ('Deadline treatment', ['Enforced','Extended','Late bids accepted','Extended; Late bids accepted','Passed without action','Unclear','No deadline stated']),\n 'L': ('Round finality', ['Announced as final','Inferred final','Not final']),\n 'M': ('Decided by', ['Bidder','Target','Both','Unknown']),\n 'N': ('Exit reason', ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\n    'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated']),\n 'O': ('Outcome basis', ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity']),\n}\nfor col, (title, values) in LISTS.items():\n    ls[f'{col}1'].value = title\n    ls[f'{col}1'].font = HDR_FONT; ls[f'{col}1'].fill = HDR_FILL\n    for j, v in enumerate(values):\n        ls[f'{col}{j+2}'].value = v\n    ls.column_dimensions[col].width = max(len(title) + 2, 30)\nls.sheet_state = 'hidden'\n\n# ---------------- Source text ----------------\nst = wb.create_sheet('Source text')\nfor col, title, width in [('A','Paragraph',12),('B','Section',34),('C','Page',8),('D','Text',150)]:\n    c = st[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\n    st.column_dimensions[col].width = width\nst.row_dimensions[1].height = 20\nst.freeze_panes = 'A2'\nr = 2\nnote = ('Declared layout normalization: text extracted from the filed HTML; whitespace collapsed; punctuation as filed (including smart quotes); '\n        'printed page labels used. P-001..P-031 are the complete Background of the Merger in source order (continuations marked \"(cont.)\"); '\n        'X-001.. are additional passages used in the ledger or Summary.')\nst.cell(row=r, column=1, value='Note').font = Font(size=10, italic=True)\nst.cell(row=r, column=2, value='Layout').font = Font(size=10, italic=True)\nst.cell(row=r, column=4, value=note).font = Font(size=10, italic=True)\nst.cell(row=r, column=4).alignment = WRAP\nr += 1\nSRC_CELL = {}\nfor s in SRC:\n    st.cell(row=r, column=1, value=s['id'] + (' (cont.)' if s.get('cont') else ''))\n    st.cell(row=r, column=2, value=s['section'])\n    st.cell(row=r, column=3, value=s['page'])\n    c = st.cell(row=r, column=4, value=s['text'])\n    for col in 'ABCD':\n        cc = st[f'{col}{r}']; cc.font = BODY_FONT; cc.alignment = WRAP; cc.border = BORDER\n    SRC_CELL[s['id']] = r\n    r += 1\nRESOLVED_ROW = {k: v + 1 for k, v in SRC_CELL.items()}  # +1 for the note row offset applied when writing\n\n# fix Deal ledger source hyperlinks now that we know rows\nfor i, rr in enumerate(ROWS):\n    row = first_data_row + i\n    main_id = rr['src'][0]\n    ws[f'L{row}'].hyperlink = f\"#\\'Source text\\'!A{SRC_CELL[main_id]}\"\n\n# ---------------- data validation on ledger ----------------\nDV_MAP = {'D':'What happened','G':'Type','I':'Formality','J':'Conditions level','P':'Include','U':'Date basis','V':'Date method',\n          'Y':'Price kind','Z':'Price origin','AB':'All cash','AF':'Deadline treatment','AG':'Round finality','AH':'Decided by',\n          'AI':'Exit reason','AJ':'Outcome basis'}\nlist_col = {v[0]: k for k, v in LISTS.items()}\nfor col, cat in DV_MAP.items():\n    lc = list_col[cat]\n    last = max(len(LISTS[lc][1]) + 1, 2)\n    dv = DataValidation(type='list', formula1=f\"'Lists'!${lc}$2:${lc}${last}\", allow_blank=True)\n    dv.error = 'Use a value from the Lists sheet.'\n    dv.promptTitle = cat\n    ws.add_data_validation(dv)\n    dv.add(f'{col}2:{col}{last_row + 30}')\n\n# ---------------- AI original (hidden, values baseline) ----------------\nai = wb.create_sheet('AI original')\nfor col, title, width in LED_COLS:\n    c = ai[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\n    ai.column_dimensions[col].width = width\nfor i, rr in enumerate(ROWS):\n    row = first_data_row + i\n    for col, title, width in LED_COLS:\n        src_cell = ws[f'{col}{row}']\n        c = ai[f'{col}{row}']\n        c.value = src_cell.value\n        c.font = BODY_FONT; c.border = BORDER; c.alignment = WRAP\n        c.number_format = src_cell.number_format\nai.cell(row=last_row + 2, column=1,\n        value=('Baseline: values-only copy of the delivered Deal ledger (all expandable fields and Row ids). '\n               'Corrections are made on the Deal ledger; cells that no longer match this baseline by Row id + column '\n               'are highlighted red bold by conditional formatting. Do not edit this sheet.')).font = Font(size=9, italic=True)\nai.sheet_state = 'hidden'\n\n# ---------------- conditional formatting: baseline comparison ----------------\nfor ci in range(2, len(LED_COLS) + 1):   # columns B..AM\n    col = get_column_letter(ci)\n    if col == 'P':\n        continue  # Include is a control flag, not baseline content to flag\n    formula = (f\"AND($O2<>\\\"\\\",SUMPRODUCT(('AI original'!$O$2:$O${last_row}=$O2)*\"\n               f\"(EXACT('AI original'!{col}$2:{col}${last_row}&\\\"\\\",{col}2&\\\"\\\")))=0)\")\n    ws.conditional_formatting.add(f'{col}2:{col}{last_row + 30}',\n                                  FormulaRule(formula=[formula], font=REDBOLD, stopIfTrue=False))\n\n# ---------------- Questions ----------------\nqs = wb.create_sheet('Questions')\nQCOLS = [('A','Q',7),('B','Review topic',26),('C','Recommended answer',62),('D','Why and source',62),\n         ('E','Affected rows/fields',30),('F','Consequence of changing it',42),('G','Status',10),('H','Reviewer note',26)]\nfor col, title, width in QCOLS:\n    c = qs[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\n    qs.column_dimensions[col].width = width\nqs.row_dimensions[1].height = 22\n\nQUESTIONS = [\n ('Q1','Process and round map; rejected boundaries',\n  'Adopt one process (Process 1) with two analytical rounds: R1 opened at the first-week-of-October 2014 confidentiality/standstill wave (Not final; preliminary IOI stage) and R2 the final round opened 11/03/2014 (Announced as final). Keep round 0 for pre-opening approaches. Reject a separate R3 for the November request for final bids: it is the continuing purpose of R2 and the smallest map preserving real transitions. Reject the 08/13 sale decision, 08/19 press release, Industry Participant contacts and the 10/30 deadline as the R1 anchor (no target outreach wave is reported; the NDA wave is the first target-organized admission step). No go-shop; no post-signing solicitation; no process termination/restart.',\n  'Instruction 6.3 anchor order and round rules; P-011 (\"J.P. Morgan was contacted by 27 potential participants\"), P-013 (NDA wave), P-017 (four to the final round), P-020/P-021 (final-bid timetable), P-034 future — see Source text. The reasons describe the same process (X-008a).',\n  'R016, R028, R009, R013, R008/R015, R019/R020',\n  'If a third round were adopted, R2 finality and round-bidder tallies split and the 12/10 bids would need re-rounding; if the anchor moved to 08/13, R1 scope would include parties that never signed and R1 bidder counts would not match the 15-signer base.'),\n ('Q2','Deadline history and treatments',\n  'Keep: 10/30/2014 IOI deadline — Enforced; 12/05/2014 final-bid date — superseded before arrival by the 12/04–05 revision (remains in history; no milestone row; treated Extended on the revised row); 12/10/2014 final-bid deadline — Extended (improved bids requested for 12/12); 12/12/2014 — Enforced. No \"Late bids accepted\": Bidder 2\\u2019s increase after 10/30 was target-solicited continuing negotiation, not late acceptance.',\n  'P-014/P-016 (IOIs due and submitted), P-017 (advancement on the bids in hand), P-020/P-021 (revision 12/05→12/10), P-026 (improvement to 12/12), P-029 (bids), P-030 (selection).',\n  'R019, R020, R034, R036, R041, R042 (Due date / Deadline treatment fields; Summary deadline map)',\n  'Different labels change the Summary deadline map; marking 10/30 \"Late bids accepted\" would wrongly reclassify the target-solicited Bidder 2 revision.'),\n ('Q3','Bidder 3 membership and unit reconciliation',\n  'Recommended reading: Bidder 3 was formed by the two final-round bidders other than the Buyer Group and Bidder 2 (Unnamed financial bidders A and B; R024/R025). This is the only reading that reconciles the four invited bidders to the three bidding units active in December and the Reasons\\u2019 statement that the Company \"negotiated with the Buyer Group as well as two other bidding groups\". The filing does not name the members; keep R031/R032 as Count-0 \"Inferred: identity\" rows and do not treat the names as settled.',\n  'P-016 (four bidders at/above $80; specific prices for Buyer Group and the $80–85 bidder), P-017 (four allowed to proceed; two eliminated), P-018 (two requested to work together; \"Bidder 3\"), P-025 (December record: Buyer Group, Bidder 2 and a verbal indication from Bidder 3 only), X-008a (\"two other bidding groups\").',\n  'R030, R031, R032, R024, R025, R028, R036',\n  'If the pair instead included an eliminated below-$80 bidder, an invited bidder would have disappeared without a disclosed outcome and the three-unit December record would not reconcile; the Unit-count statements in Summary would need rework.'),\n ('Q4','NDA quantities, overlap, type splits and the 6-vs-5 conflict',\n  'Keep: 15 new NDA signers, all financial buyers (auction screen MET); 27 contacts split 3 strategic + 24 financial; six submitting parties in Round 1 (Background p.24) as the primary count, with the Reasons\\u2019 \"5 bidder groups\" (p.27) preserved as a conflicting group-basis statement (two combining bidders counted as one group, or drafting variance); nine non-submitters as the residual 15 − 6 with the base assumption stated. Note: the six submitters are assumed to be among the 15 signers; if not, the residual rises.',\n  'P-011, P-013, P-016, P-017; X-008a (\"5 bidder groups\"); X-009 (standstills); P-021 arithmetic.',\n  'R011, R012, R017, R021, R022–R027',\n  'Changing the submitting count to five would make the residual ten and alter the R1 stage balance; changing the NDA base would alter the auction-screen statement and Summary totals.'),\n ('Q5','Participation outcomes, agency and inferred closings',\n  'Adopt: 9 non-submitters — Did not submit (Inferred: residual; Unknown / Not stated; assigned to the 10/30/2014 deadline). Two below-$80 submitters — Dropped by target (Stated; Target; Lower offer than rivals). Bidder 3 — Did not submit (Stated; Both — target discouragement before non-submission; Value at or below market price). Bidder 2 — Not selected at signing (Stated; Target; Lower offer than rivals). Unnamed financial bidders A and B — Count-0 Inferred: identity rows. Industry Participant never entered: contacts and target decisions only, no outcome row.',\n  'P-013/P-016 (base and six submitters), P-017 (eliminations), P-025 (verbal indication; no written offer), X-008a/b ($81.50 best and final vs $83.00), P-010/P-012 (Industry Participant exclusion).',\n  'R021, R029, R040, R049, R031, R032, R008–R015',\n  'Agency labels feed the outcome tallies and the Summary balance; converting the residual to individual exits is not supported and would fabricate identities; treating Industry Participant as entered would require an invented outcome.'),\n ('Q6','Formality and conditions levels',\n  'Keep: IOIs Informal (preliminary non-binding indications; no supported formal signal) with Conditions level Insufficient evidence (price only; October diligence access existed but no conditions are stated). Final bids: Buyer Group Formal/Light (returned agreement markups; financing commitment documents 12/06; no diligence condition stated); Bidder 2 Formal with 12/10 Insufficient evidence and 12/12 Light (financing commitment documents submitted); Bidder 3 Informal with a bound-only price and Insufficient evidence. The 12/06 markups and 12/08 revised drafts belong to the 12/10 bids (no separate rows). No None, no Heavy, and no late-reconfirmation rows are created.',\n  'P-016 (IOIs), P-017 (advancement), P-022 (12/06 comments and financing documents), P-025 (final bids; comparative conditionality), P-029 (revised drafts and financing documents), P-021 (documents \"in advance\"), X-027 (committed debt/equity financing).',\n  'R022–R027, R037, R038, R039, R044, R045, R046 (Formality / Conditions level / Conditions detail)',\n  'Reclassifying the IOIs as Heavy by context would contradict the instruction (substantive diligence access had preceded them); moving the 12/06 markups into their own rows would create duplicate draft events.'),\n ('Q7','Scope, currency, price interpretation and normalization',\n  'Keep: no other-scope proposals (all whole-company); all amounts USD, no conversions; Bidder 3\\u2019s \"not above approximately $78\" recorded as a Bound-only price (Price high 78.00; approximate, based on the then-current stock price — flagged). Unnamed financial bidder B\\u2019s \"range reached at least $80.00\" is ambiguous (floor on the range vs level reached); endpoints left blank and kept in text. Longview\\u2019s rollover is equity in Parent, not public consideration — all other shares receive $83.00 cash; the ~$8.25bn equity value is an outstanding-basis calculation (83.00 × 99,455,151), not a filing-stated total.',\n  'P-016 (ranges), P-025 (verbal indication), X-002/X-003 (consideration; shares), X-013 (rollover $250m), X-015 (3,012,050 shares), X-011–X-014 (funds).',\n  'R024, R025, R039, R043, R046; Summary comparability inputs',\n  'Reading B as a floor would add a Bound-only row and change the R1 price display; blanking Bidder 3\\u2019s Price high would lose a disclosed bound; adding the rollover to public consideration would misstate per-share cash.'),\n ('Q8','Dates, assigned Working dates and same-day order',\n  'Keep the disclosed conventions: NDA wave Working date 10/01 (first day of the \"first week of October\"; the relative order with the 10/03 board meeting is not stated — display convention); J.P. Morgan retention 07/01 (Assigned: sequence, to preserve reading order ahead of the dated 07/03 JANA filing); November projections update 11/15 (period midpoint); Bidder 3 formation 11/04 (first admissible day after 11/03); the Bidder 3 non-submission assigned to the 12/10 deadline; same-day sequences 12/10 (deadline → bids → improvement revision) and 12/12 (deadline → rollover approval → Bidder 2 → Buyer Group $82.50 → $83.00); 12/13 approval before 12/14 signing and announcement.',\n  'Instruction 8.1 rules; P-013 (first week of October), P-012 (10/03 meeting), P-005 (July retention), P-019 (November projections), P-018 (formation after 11/03), P-025/P-026/P-029 (December sequence), P-030/P-031.',\n  'R003, R016–R018, R033, R030–R032, R040, R036–R041, R045–R050',\n  'These choices affect only display order and the sort key, never the source facts; moving a Working date could reorder same-date rows within a round (relevant to the December sequence and the R1/R2 boundary).'),\n]\nqr = 2\nfor q in QUESTIONS:\n    for j, v in enumerate(q):\n        c = qs.cell(row=qr, column=j+1, value=v)\n        c.font = SECT_FONT if j == 0 else BODY_FONT\n        c.alignment = WRAP; c.border = BORDER\n    qr += 1\nqr += 1\nc = qs.cell(row=qr, column=1, value='Check results (instruction section 13) — run at build, 09/19/2026')\nc.font = Font(bold=True, size=11, color='1F4E79'); qr += 1\nCHECKS = [\n ('1. Coverage and materiality','Passed',\n  'All disclosed core offers, contacts/NDAs, information/selection changes, participation outcomes, process transitions, signing and publicity are represented. Routine 12/06 comments and 12/08 draft exchanges are deliberately folded into the 12/10 bids; inferred closing rows are explicit (R021, R031, R032).'),\n ('2. Counts and population','Qualified',\n  'Summary arithmetic matches included ledger contributions (NDA 15; contacts 28 incl. Industry Participant; R1 submissions 6; R2 units 3). Source qualifiers preserved: the Reasons\\u2019 \"5 bidder groups\" conflicts with the Background\\u2019s six submitters; the 9-residual assumes all six submitters were signers; the Bidder 3 identity reading affects the unit break-down (see Q3/Q4).'),\n ('3. Participation continuity','Passed',\n  'Every participant that entered is closed: 9 inferred non-submitters; 2 dropped; 2 joined-group Count-0 identity rows; 1 did not submit; 1 not selected at signing; the Buyer Group remains as winner. Entrant stock never negative; Industry Participant never entered and has no outcome row. The closure mechanism for Unnamed financial bidders A/B depends on the Q3 reading.'),\n ('4. Dates and order','Passed',\n  'Programmatic checks: every row has a Working date and Date method; sorting by Working date with # as tie-breaker reproduces the ledger order (non-decreasing); Working dates lie within their Date from/Date to windows; Date basis/method pairs are valid (Reported day = Reported; Inferred day = Inferred); deadline communication, due dates and signing are kept distinct. Based on the filing text; not externally validated.'),\n ('5. Offers and classifications','Qualified',\n  'Formality and conditions assessments are reasoned; Conditions detail strings use the fixed format on every Bid/Bid reaffirmed row. Insufficient-evidence levels remain for the preliminary IOIs and Bidder 2\\u2019s first final bid; Bidder 3 is a Bound-only price; no Heavy or None classifications were required. Offer updates, groups, reaffirmations and signing are not mistaken for extra priced submissions.'),\n ('6. Structure and consistency','Passed',\n  'One Round opened row per round with a Round finality value; R1 anchor tag present with rejected candidates as rows; every Deadline row carries a treatment matching the Summary map; Page populated wherever Source is populated (R051 uses \"A-46\" for the annex); tags and structured fields agree; Row ids unique; Include defaults to Yes.'),\n ('7. Evidence','Passed',\n  'Every quotation in Why and evidence was programmatically recovered exactly from its cited Source text passage (token match, allowing only declared whitespace/quote normalization), and pages were carried from the filing. Interpretation validity was checked by reading (see Q3, Q5, Q8).'),\n ('8. Review and workbook operation','Qualified',\n  'Data validations, hidden sheets, column groups, autofilter and print-free-layout were created programmatically; formulas and dropdowns were recalculated in LibreOffice headless (values reconcile with hand arithmetic). Internal Source links and the AI-original baseline comparison (red-bold conditional formatting) were not tested in a desktop spreadsheet application; links are static and may need refreshing after sorting; the correction-highlighting baseline is a values-only snapshot.'),\n]\nfor name, res, note in CHECKS:\n    qs.cell(row=qr, column=1, value=name).font = BODY_FONT\n    qs.cell(row=qr, column=2, value=res).font = BODY_FONT\n    qs.cell(row=qr, column=3, value=note).font = BODY_FONT\n    for col in (1,2,3):\n        qs.cell(row=qr, column=col).alignment = WRAP\n        qs.cell(row=qr, column=col).border = BORDER\n    qr += 1\nfor col in ('E','F','H'):\n    pass\nqs.column_dimensions['D'].width = 62\n\n# ---------------- Summary ----------------\nsm = wb.create_sheet('Summary')\nsm.column_dimensions['A'].width = 40\nsm.column_dimensions['B'].width = 150\nsm.column_dimensions['C'].width = 30\nsm.column_dimensions['D'].width = 60\nsr = 1\ndef put(label, text, bold=False, title=False, height=None):\n    global sr\n    a = sm[f'A{sr}']; b = sm[f'B{sr}']\n    a.value = label; b.value = text\n    a.font = TITLE_FONT if title else (SECT_FONT if bold else Font(size=10, bold=True))\n    b.font = Font(size=10)\n    a.alignment = WRAP; b.alignment = WRAP\n    if height is None and text:\n        height = max(15, math.ceil(len(str(text)) / 148) * 15)\n    sm.row_dimensions[sr].height = height\n    sr += 1\n\nput('PetSmart, Inc. — sale process ledger', 'Deal short name: PetSmart  |  Ledger rows: 51  |  Process 1  |  Rounds 0–2  |  Delivered: 09/19/2026', title=True, height=24)\nput('Status', 'AI first pass; not human-approved. Instruction revision: 19 September 2026 (Pro). Source coverage: the complete supplied filing — PetSmart, Inc. Definitive Proxy Statement on Schedule 14A (DEFM14A), filed 02/02/2015 (raw_filing/petsmart_2015-02-02_DEFM14A.htm; ~163 pages including Annexes A–C). The ledger is built from the complete Background of the Merger (pp. 21–26) plus passages cited from the Summary, Q&A, Reasons, Financing, Regulatory, Litigation, Market Price and Security Ownership sections and the merger-agreement notices. Last recheck status: initial build only; no post-delivery recheck yet. Correction tracking: the hidden \"AI original\" sheet holds a values-only baseline of the Deal ledger; changed cells are highlighted red bold by Row id + column (programmatically simulated, not tested in Excel).')\nput('1. Commercial account', '', bold=True)\nput('Story', 'After a weak 05/21/2014 earnings release and public pressure from JANA Partners (9.9% Schedule 13D on 07/03/2014) and Longview (07/07/2014 letter advocating a sale), the PetSmart board decided on 08/13/2014 to explore strategic alternatives including a possible sale, publicly announced the exploration on 08/19/2014, and excluded antitrust-risky Industry Participant from the process. J.P. Morgan was contacted by 27 potential participants (3 strategic, 24 financial); 15 financial buyers signed confidentiality and standstill agreements in the first week of October 2014 and received uniform diligence access, management presentations and Profit Improvement Plan information.')\nput('', 'Six parties submitted non-binding indications of interest on 10/30/2014 (Buyer Group $81.00–$83.00; another bidder $80.00–$85.00; Bidder 2 $78.00 increased to $81.00–$84.00; an unnamed bidder whose range reached at least $80.00; and two submitters below $80.00). The board advanced the four at or above $80.00 to the final round on 11/03/2014; two of them combined as \"Bidder 3\" (units 4 → 3: Buyer Group, Bidder 2, Bidder 3).')\nput('', 'Final bids on 12/10/2014 were $80.70 (Buyer Group) and $80.35 (Bidder 2), with Bidder 3 giving only an uncompetitive verbal indication (not above approximately $78.00). The ad hoc committee extended bidding to 12/12/2014, when Bidder 2 confirmed $81.50 as best and final and the Buyer Group moved $82.50 → $83.00 best and final with committed financing and substantially executable documentation.')\nput('', 'The board approved the Buyer Group merger on 12/13/2014 and the parties signed on 12/14/2014 at $83.00 per share in cash — a 38.8% premium to the 07/02/2014 unaffected price and 6.9% above the 12/12/2014 close of $77.67 — with Longview rolling over 3,012,050 shares (about $250m) and voting 7,424,591 shares in favour. Observed outcome: signed with the Buyer Group; no post-signing competing proposal as of 02/02/2015; closing not observed in the filing (expected first half of 2015).')\nput('Initiation assessment', 'Mixed, with activist influence and substantial inbound interest: the board\\u2019s own alternatives review and Profit Improvement Plan planning (06/18/2014) preceded, but did not cause, a sale; the 08/13/2014 sale decision followed the JANA/Longview campaigns, and the process then ran largely on parties approaching J.P. Morgan after the 08/19/2014 publicity.')\nput('2. Deal facts', '', bold=True)\nput('Target', 'PetSmart, Inc. (Delaware; NASDAQ: PETM; 1,404 stores; 202 in-store boarding facilities in the U.S., Canada and Puerto Rico). [P-001, P-002, X-007]')\nput('Focal acquirer', 'Argos Holdings Inc. (\"Parent\") / Argos Merger Sub Inc., affiliates of funds advised by BC Partners, Inc.; Parent to be owned by the Buyer Group. Type: Financial (private-equity-led consortium; no strategic buyer advanced). [X-007, R048]')\nput('Buyer Group', 'Funds advised by BC Partners, Inc.; La Caisse de dépôt et placement du Québec; affiliates of GIC Special Investments Pte Ltd; affiliates of StepStone Group LP; and Longview Asset Management, LLC at all times after 12/12/2014. [X-001, X-007]')\nput('Agreed consideration', '$83.00 per share in cash; all cash; transaction not subject to a financing condition. [X-002, X-005, R046, R048]')\nput('Key dates', 'Merger agreement dated as of 12/14/2014; announced 12/14/2014. Special meeting 03/06/2015; record date 01/29/2015 (99,455,151 shares outstanding; majority of outstanding shares required). Expected closing first half of 2015 — not observed in the filing. [P-031, X-003, X-025, X-024, X-002]')\nput('Termination fees', '$255m company termination fee; $510m Parent reverse termination fee; expense reimbursement up to $15m. Legal terms recorded for context only (no ledger rows). [X proxy summary pp. 7–8]')\nput('Share counts / rollover', 'Record date shares 99,455,151; Longview rollover 3,012,050 shares ($250m worth) for Parent equity; Longview voting agreement 7,424,591 shares (~7.5%); Longview beneficial ownership 8,214,170 shares (8.3%) per its 12/19/2014 Schedule 13D/A. [X-003, X-015, X-004, X-022]')\nput('Financing inputs', 'Total funds required estimated at approximately $8.4bn: debt up to ~$6.2bn plus a $750m senior secured ABL revolver (aggregate debt facility up to $6.95bn; not all drawn), cash equity up to ~$1.83bn, Longview rollover $250m, and ~$425m cash on hand at closing. [X-011–X-015]')\nput('Filing', 'DEFM14A, filed 02/02/2015; source file: raw_filing/petsmart_2015-02-02_DEFM14A.htm (relative local link). Background pages 21–26. Full passages in the Source text sheet.')\nput('3. Process and round map', '', bold=True)\nput('Process 1', 'Only sale attempt observed: exploration decision 08/13/2014 → Round 1 (October NDA/IOI stage) → Round 2 final round 11/03/2014 → signing 12/14/2014. Outcome: signed with the Buyer Group; closing pending at the filing date. No process termination or restart. Post-signing: no go-shop; no-solicitation with fiduciary out; 15 signers\\u2019 standstills; no unsolicited proposal as of 02/02/2015. [R009; R016; R028; R048; X-009; X-010]')\nput('Round 0 (pre-opening)', 'No Round opened row. 06/18/2014 board review and committee formation [R001–R002]; J.P. Morgan retention (July) [R003]; JANA/Longview activism [R004–R007]; Industry Participant approaches and exclusion [R008–R015]; 27 contacts [R011–R012]; 08/19 announcement [R013].')\nput('Round 1 — Not final', 'Opened at the confidentiality/standstill wave, first week of October 2014 [R016] (R1 anchor; rejected candidates R009, R013, R008/R015, R019–R020). Scope: 15 financial signers [R017]. IOI deadline communicated during October, due 10/30/2014 — Enforced [R019–R020]. Submissions: Buyer Group $81–83 [R022]; Bidder 2 $78 [R023] revised to $81–84 [R027]; Unnamed financial bidder A $80–85 [R024]; Unnamed financial bidder B range reached ≥$80 [R025]; two other submitters, prices not disclosed [R026]; nine inferred non-submitters [R021]. Transition 11/03/2014 [R028]: four advanced; two eliminated [R029].')\nput('Round 2 — Announced as final', 'Opened 11/03/2014 [R028]. Units: 4 invited → two combine as Bidder 3 [R030–R032] → 3 independent units. November: further diligence; updated FY2014 projections [R033]. Deadlines: final-bid date set earlier for 12/05/2014, revised 12/04–05 to 12/10/2014 [R034] — Extended [R036]; improvement request 12/10 → 12/12/2014 [R041] — Extended [R042]. Bids: Buyer Group $80.70 [R037]; Bidder 2 $80.35 [R038]; Bidder 3 ≤~$78 verbal [R039] and no written offer [R040]. Longview introductory meetings 12/09 [R035]; rollover permitted/formed 12/12 [R043]. Improved/best and final: Bidder 2 $81.50 [R044]; Buyer Group $82.50 [R045] → $83.00 [R046]. Board approval 12/13 [R047]; signing and announcement 12/14 [R048–R050].')\nput('Deadline history', '10/30/2014 — Enforced (six IOIs; board advanced four). 12/05/2014 — superseded before arrival by the 12/04–05 revision (Extended; no milestone row). 12/10/2014 — Extended (improved bids to 12/12). 12/12/2014 — Enforced (bids received; selection and signing followed). No late bids accepted. [R019–R020, R034, R036, R041–R042]')\nput('Round-bidder tallies', 'Round 1: 6 submitting units. Round 2: 3 submitting/communicating units (Buyer Group, Bidder 2, Bidder 3). These are stage-specific units, not unique firms across the deal. [R022–R027; R037–R039, R044–R046]')\nput('4. Participants and advisers', '', bold=True)\nput('Buyer Group', 'Financial (PE-led consortium). Among the 15 signers (first week October); first recorded bid 10/30 $81–83 [R022]; advanced 11/03; final bid $80.70 [R037]; improved $82.50 → $83.00 best and final [R045–R046]; winner — no exit row; closing pending at the filing date. Longview admitted to the group after 12/12/2014 (rollover, not a membership change).')\nput('Bidder 2', 'Financial. IOI $78.00 [R023] revised to $81–84 [R027]; advanced; final bid $80.35 [R038]; improved best and final $81.50 [R044]; Not selected at signing (Stated; Target; Lower offer than rivals) [R049].')\nput('Bidder 3', 'Financial. Formed early November 2014 from two unnamed final-round bidders [R030]; verbal indication not above approximately $78 [R039]; Did not submit (Stated; Both; Value at or below market price) [R040].')\nput('Unnamed financial bidder A', 'Financial. IOI $80.00–$85.00 [R024]; final-round bidder; Joined group / Inferred: identity, Count 0 (closes independent bidding; may be one of Bidder 3\\u2019s members) [R031].')\nput('Unnamed financial bidder B', 'Financial. IOI with a range that reached at least $80.00, endpoints not disclosed [R025]; final-round bidder; Joined group / Inferred: identity, Count 0 [R032].')\nput('Other submitters / signers', 'Two further IOI submitters (cohort, prices not disclosed; Dropped by target 11/03) [R026, R029]; nine NDA signers (Did not submit at 10/30; Inferred: residual) [R021]; 3 strategic parties and 9 financial parties contacted but never admitted — no outcome rows.')\nput('Industry Participant', 'Strategic. Approaches 08/07/2014 and 08/27/2014; excluded from the process by target decision 08/13/2014, reaffirmed 10/03/2014; never entered — no outcome row. [R008, R010, R014, R015, R018]')\nput('Activists', 'JANA Partners (13D 9.9% on 07/03; in-person meeting 07/10; further amendments/letters through July–August) and Longview (public letter 07/07; call 07/10; later rollover investor and voting-agreement party). [R004–R007, R043, R048]')\nput('Advisers', 'J.P. Morgan Securities LLC — Company financial advisor and process bank (engaged July 2014; fairness opinion 12/13, confirmed 12/14) [R003, R047]. Wachtell, Lipton, Rosen & Katz — Company legal advisor (earliest supported service 06/18/2014) [R002]. Simpson Thacher & Bartlett LLP — Parent/Merger Sub legal counsel (earliest support: executed merger agreement, 12/14/2014) [R051]. Innisfree M&A Incorporated — Company proxy solicitor for the special meeting (~$182,725 paid by the record date; ~$240,000 expected through March 2015; engagement date not disclosed) — Summary only [X-023]. An unnamed financial advisor attended the 06/18/2014 board meeting and is not attributed to any named firm [P-004].')\nput('Financing sources', 'Debt financing lenders (not advisers): Citigroup Global Markets Inc., Barclays Bank PLC, Deutsche Bank AG New York Branch, Nomura Securities International, Inc., Jefferies Finance LLC; joined by RBC Capital Markets, Macquarie Capital (USA) Inc. and Natixis, New York Branch. [X-017]')\nput('5. Counts and auction screen', '', bold=True)\n# counts table with formulas\nCOUNT_ROWS = [\n ('Contacts (organisations approached)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Contact\",\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")+SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Bidder interest\",\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  '27 potential participants (3 strategic + 24 financial; p.23); \"more than 25\" (p.27)',\n  'Ledger 28 includes Industry Participant (carried on its Bidder interest row R008, Count 1) which the filing excludes from the 27. Scope: organisations, not bids.'),\n ('NDA signers (new)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"NDA signed\",\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  '15 potentially interested financial buyers (p.23)',\n  'All financial; no reused agreements identified. Auction screen (more than one independent prospective acquiring bidder unit with executed confidentiality agreements): MET.'),\n ('Round 1 submitting units', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Bid\",\\'Deal ledger\\'!$F$2:$F$52,1,\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  'Six parties submitted indications of interest (p.24); \"5 bidder groups\" (p.27)',\n  'Conflict preserved; preferred reading = six parties (background, specific); the reasons\\u2019 group-basis count may reflect the two combining bidders (see Q4).'),\n ('Round 2 submitting/communicating units', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Bid\",\\'Deal ledger\\'!$F$2:$F$52,2,\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  '\"negotiated with the Buyer Group as well as two other bidding groups\" (p.27)',\n  'Buyer Group, Bidder 2, Bidder 3.'),\n ('Inferred non-submitters (R1)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Did not submit\",\\'Deal ledger\\'!$AJ$2:$AJ$52,\"Inferred: residual\",\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  'Derived 15 signers \\u2212 6 submitters',\n  'Base assumption: all six submitters were among the 15 signers; if not, the residual rises (see Q4).'),\n ('Stated R1 exits (dropped)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$52,\\'Deal ledger\\'!$D$2:$D$52,\"Dropped by target\",\\'Deal ledger\\'!$AJ$2:$AJ$52,\"Stated\",\\'Deal ledger\\'!$P$2:$P$52,\"Yes\")',\n  'The eliminated parties were notified (p.24)',\n  'The two submitters below $80.00.'),\n]\nfor label, formula, assertion, note in COUNT_ROWS:\n    sm.cell(row=sr, column=1, value=label).font = Font(size=10, bold=True)\n    c = sm.cell(row=sr, column=2, value=formula); c.font = BODY_FONT\n    sm.cell(row=sr, column=3, value=assertion).font = BODY_FONT\n    sm.cell(row=sr, column=4, value=note).font = BODY_FONT\n    for col in (1,3,4):\n        sm.cell(row=sr, column=col).alignment = WRAP\n    sm.row_dimensions[sr].height = max(15, math.ceil(len(note)/40)*15)\n    sr += 1\nput('Stage balance (R1)', 'Entrants 15 (NDA signers) − stated exits 2 (dropped below-$80 submitters) − inferred exits 9 (non-submitters) = 4 continuing (the four bidders advanced to the final round). Inferred share of R1 exits: 9/11 (82%).')\nput('Stage balance (R2)', 'Opening units 4 (invited) + 1 unit formed (Bidder 3) = 5 unit-configurations; exits: 2 members joined group (Count-0 identity rows), Bidder 3 did not submit, Bidder 2 not selected = 4; remaining at signing: 1 — the Buyer Group (winner). Inferred share of R2 exits: 0 (all stated, except the two Count-0 identity rows).')\nput('Outcome tallies', 'Occurrences/affected units (not unique permanent exits): Dropped by target 2; Did not submit 10 (9 inferred + 1 stated); Not selected at signing 1; Joined group 2 members. Winner: Buyer Group. Organisations vs units: 15 NDA signer organisations; 6 R1 submitting parties; 3 R2 independent units; 1 winner.')\nput('6. Comparability and inputs', '', bold=True)\nput('Scope / currency', 'Other-scope proposals: none observed — all proposals were for whole-company equity. Currency: USD throughout; no conversions. Contingent consideration: none; no CVRs.')\nput('Unusual consideration', 'Longview rollover (equity in Parent for 3,012,050 shares, $250m worth) is not public consideration; all other Longview shares receive $83.00 cash. Standstill provisions limit post-signing bidding by the 15 signers. No go-shop. Reverse termination fee $510m.')\nput('Market benchmarks', 'Agreed price $83.00; premium 38.8% to the 07/02/2014 unaffected price (calculated implied unaffected price ≈ $59.80 = 83.00 / 1.388); 12/12/2014 close $77.67 (last trading day before announcement); 01/30/2015 close $81.71; 2014 Q4 high/low $81.97 / $63.21; 2015 Q1-through-01/30 high/low $81.95 / $81.00. [X-021, X-026]')\nput('Optional calculations', 'Equity value at $83.00 × 99,455,151 shares = $8,254,777,533 (outstanding-basis only; excludes options/RSUs/PSUs and any dilution; not a filing-stated total). Premium to 12/12/2014 close = 6.9% (83.00/77.67 − 1). [X-003, X-002]')\nput('Glossary', 'NDA = confidentiality/non-disclosure agreement. Standstill = contractual limit on acquiring shares/announcing bids (here, also barring higher bids after a definitive agreement). IOI = indication of interest. Rollover = holder contributes shares to the buyer\\u2019s vehicle instead of receiving cash. Go-shop = post-signing solicitation window (none here). HSR = U.S. Hart-Scott-Rodino antitrust waiting period (early termination 01/07/2015). ARC = Canada Advance Ruling Certificate (issued 01/14/2015). Bound only = one-sided communicated price limit, not a submitted level. Reverse termination fee = fee payable by the buyer/Parent ($510m here). [X-018, X-019]')\n\nwb.move_sheet('Summary', offset=-(len(wb.sheetnames)-2)) if False else None\n# reorder sheets: Deal ledger, Summary, Questions, Source text, (AI original, Lists hidden)\norder = ['Deal ledger','Summary','Questions','Source text','AI original','Lists']\nwb._sheets = [wb[n] for n in order]\nws.sheet_properties.tabColor = '1F4E79'\nsm.sheet_properties.tabColor = '2E75B6'\nqs.sheet_properties.tabColor = '2E75B6'\nst.sheet_properties.tabColor = '2E75B6'\n\nwb.save(OUT)\nprint('saved', OUT)\n","path":"/tmp/opencode/make_workbook.py"},"output":"Created file successfully: /tmp/opencode/make_workbook.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/make_workbook.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"#!/usr/bin/env python3\\n# Build the PetSmart deal-ledger workbook from the validated payload.\\nimport json, datetime as dt, math, re\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, PatternFill, Alignment, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.formatting.rule import FormulaRule\\n\\nP = json.load(open('/tmp/opencode/payload.json'))\\nROWS = P['rows']; SRC = P['source']\\nSRC_BY_ID = {s['id']: s for s in SRC}\\n\\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\\nDEAL = 'PetSmart'\\n\\nthin = Side(style='thin', color='BFBFBF')\\nBORDER = Border(left=thin, right=thin, top=thin, bottom=thin)\\nHDR_FILL = PatternFill('solid', fgColor='1F4E79')\\nHDR_FONT = Font(bold=True, color='FFFFFF', size=10)\\nBODY_FONT = Font(size=10)\\nSECT_FONT = Font(bold=True, color='1F4E79', size=11)\\nTITLE_FONT = Font(bold=True, size=14, color='1F4E79')\\nWRAP = Alignment(wrap_text=True, vertical='top')\\nWRAP_C = Alignment(wrap_text=True, vertical='center')\\nREDBOLD = Font(color='FFFF0000', bold=True, size=10)\\n\\nwb = Workbook()\\nws = wb.active; ws.title = 'Deal ledger'\\n\\n# ---------------- Deal ledger ----------------\\nLED_COLS = [\\n    ('A', '#', 6), ('B', 'When', 17), ('C', 'Who', 27), ('D', 'What happened', 19),\\n    ('E', 'Process', 9), ('F', 'Round', 8), ('G', 'Type', 11), ('H', 'Terms or outcome', 62),\\n    ('I', 'Formality', 13), ('J', 'Conditions level', 15), ('K', 'Why and evidence', 85),\\n    ('L', 'Source', 20), ('M', 'Review', 11), ('N', 'Reviewer note', 16),\\n    ('O', 'Row id', 9), ('P', 'Include', 9), ('Q', 'Count', 8),\\n    ('R', 'Date from', 11), ('S', 'Date to', 11), ('T', 'Working date', 12), ('U', 'Date basis', 14), ('V', 'Date method', 17),\\n    ('W', 'Price low', 10), ('X', 'Price high', 10), ('Y', 'Price kind', 13), ('Z', 'Price origin', 13), ('AA', 'Currency', 9),\\n    ('AB', 'All cash', 10), ('AC', 'Cash at closing', 12), ('AD', 'Conditions detail', 62),\\n    ('AE', 'Due date', 11), ('AF', 'Deadline treatment', 15), ('AG', 'Round finality', 15),\\n    ('AH', 'Decided by', 11), ('AI', 'Exit reason', 22), ('AJ', 'Outcome basis', 17),\\n    ('AK', 'Page', 8), ('AL', 'Related rows', 24), ('AM', 'Deal', 10),\\n]\\nfor col, title, width in LED_COLS:\\n    ws.column_dimensions[col].width = width\\n    c = ws[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL\\n    c.alignment = WRAP_C; c.border = BORDER\\nws.row_dimensions[1].height = 26\\n\\ndef iso(x):\\n    if not x: return None\\n    return dt.date.fromisoformat(x)\\n\\nfirst_data_row = 2\\nfor i, r in enumerate(ROWS):\\n    row = first_data_row + i\\n    vals = {\\n        'A': i + 1,\\n        'B': r.get('when'), 'C': r.get('who'), 'D': r.get('what'), 'E': 1, 'F': r.get('round'),\\n        'G': r.get('type'), 'H': r.get('terms'), 'I': r.get('formality'), 'J': r.get('cond'),\\n        'K': r.get('why'), 'L': '; '.join(r['src']), 'M': r.get('review'), 'N': None,\\n        'O': r['id'], 'P': 'Yes', 'Q': r.get('count'),\\n        'R': iso(r.get('df')), 'S': iso(r.get('dt')), 'T': iso(r.get('wd')),\\n        'U': r.get('basis'), 'V': r.get('method'),\\n        'W': r.get('plow'), 'X': r.get('phigh'), 'Y': r.get('kind'), 'Z': r.get('origin'), 'AA': r.get('currency'),\\n        'AB': r.get('allcash'), 'AC': r.get('cash'), 'AD': r.get('conddetail'),\\n        'AE': iso(r.get('due')), 'AF': r.get('treatment'), 'AG': r.get('finality'),\\n        'AH': r.get('decided'), 'AI': r.get('exit'), 'AJ': r.get('obasis'),\\n        'AK': r.get('page'), 'AL': r.get('related'), 'AM': DEAL,\\n    }\\n    for col, v in vals.items():\\n        c = ws[f'{col}{row}']\\n        c.value = v\\n        c.font = BODY_FONT\\n        c.border = BORDER\\n        c.alignment = WRAP\\n    for col in ('R', 'S', 'T', 'AE'):\\n        ws[f'{col}{row}'].number_format = 'mm/dd/yyyy'\\n    for col in ('Q',):\\n        ws[f'{col}{row}'].number_format = '0'\\n    for col in ('W', 'X', 'AC'):\\n        ws[f'{col}{row}'].number_format = '#,##0.00'\\n    # source hyperlink to main paragraph on Source text sheet\\n    main_id = r['src'][0]\\n    c = ws[f'L{row}']\\n    c.hyperlink = f\\\"#'Source text'!A{SRC.index(SRC_BY_ID[main_id]) + 3}\\\" if False else None\\n    ws[f'L{row}'].font = Font(size=10, color='0563C1', underline='single')\\n\\nlast_row = first_data_row + len(ROWS) - 1\\nws.auto_filter.ref = f'A1:AM{last_row}'\\nws.freeze_panes = 'D2'\\n\\n# column groups (collapsed expandable)\\nfor start, end in [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),\\n                   ('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]:\\n    ws.column_dimensions.group(start, end, outline_level=1, hidden=True)\\n\\n# ---------------- Lists (hidden) ----------------\\nls = wb.create_sheet('Lists')\\nLISTS = {\\n 'A': ('What happened', ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement',\\n    'Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised',\\n    'Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update',\\n    'Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused',\\n    'Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed',\\n    'Process terminated','Process restarted','Agreement terminated','Closed']),\\n 'B': ('Type', ['Strategic','Financial','Mixed','Unknown']),\\n 'C': ('Formality', ['Formal','Informal','Insufficient evidence','Varies']),\\n 'D': ('Conditions level', ['None','Light','Heavy','Insufficient evidence','Varies']),\\n 'E': ('Include', ['Yes','No']),\\n 'F': ('Date basis', ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated']),\\n 'G': ('Date method', ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence']),\\n 'H': ('Price kind', ['Point','Bidder range','Group envelope','Bound only','Undisclosed']),\\n 'I': ('Price origin', ['Stated','Carried forward','Inferred']),\\n 'J': ('All cash', ['Yes','No','Not stated']),\\n 'K': ('Deadline treatment', ['Enforced','Extended','Late bids accepted','Extended; Late bids accepted','Passed without action','Unclear','No deadline stated']),\\n 'L': ('Round finality', ['Announced as final','Inferred final','Not final']),\\n 'M': ('Decided by', ['Bidder','Target','Both','Unknown']),\\n 'N': ('Exit reason', ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\\n    'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated']),\\n 'O': ('Outcome basis', ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity']),\\n}\\nfor col, (title, values) in LISTS.items():\\n    ls[f'{col}1'].value = title\\n    ls[f'{col}1'].font = HDR_FONT; ls[f'{col}1'].fill = HDR_FILL\\n    for j, v in enumerate(values):\\n        ls[f'{col}{j+2}'].value = v\\n    ls.column_dimensions[col].width = max(len(title) + 2, 30)\\nls.sheet_state = 'hidden'\\n\\n# ---------------- Source text ----------------\\nst = wb.create_sheet('Source text')\\nfor col, title, width in [('A','Paragraph',12),('B','Section',34),('C','Page',8),('D','Text',150)]:\\n    c = st[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\n    st.column_dimensions[col].width = width\\nst.row_dimensions[1].height = 20\\nst.freeze_panes = 'A2'\\nr = 2\\nnote = ('Declared layout normalization: text extracted from the filed HTML; whitespace collapsed; punctuation as filed (including smart quotes); '\\n        'printed page labels used. P-001..P-031 are the complete Background of the Merger in source order (continuations marked \\\"(cont.)\\\"); '\\n        'X-001.. are additional passages used in the ledger or Summary.')\\nst.cell(row=r, column=1, value='Note').font = Font(size=10, italic=True)\\nst.cell(row=r, column=2, value='Layout').font = Font(size=10, italic=True)\\nst.cell(row=r, column=4, value=note).font = Font(size=10, italic=True)\\nst.cell(row=r, column=4).alignment = WRAP\\nr += 1\\nSRC_CELL = {}\\nfor s in SRC:\\n    st.cell(row=r, column=1, value=s['id'] + (' (cont.)' if s.get('cont') else ''))\\n    st.cell(row=r, column=2, value=s['section'])\\n    st.cell(row=r, column=3, value=s['page'])\\n    c = st.cell(row=r, column=4, value=s['text'])\\n    for col in 'ABCD':\\n        cc = st[f'{col}{r}']; cc.font = BODY_FONT; cc.alignment = WRAP; cc.border = BORDER\\n    SRC_CELL[s['id']] = r\\n    r += 1\\nRESOLVED_ROW = {k: v + 1 for k, v in SRC_CELL.items()}  # +1 for the note row offset applied when writing\\n\\n# fix Deal ledger source hyperlinks now that we know rows\\nfor i, rr in enumerate(ROWS):\\n    row = first_data_row + i\\n    main_id = rr['src'][0]\\n    ws[f'L{row}'].hyperlink = f\\\"#\\\\'Source text\\\\'!A{SRC_CELL[main_id]}\\\"\\n\\n# ---------------- data validation on ledger ----------------\\nDV_MAP = {'D':'What happened','G':'Type','I':'Formality','J':'Conditions level','P':'Include','U':'Date basis','V':'Date method',\\n          'Y':'Price kind','Z':'Price origin','AB':'All cash','AF':'Deadline treatment','AG':'Round finality','AH':'Decided by',\\n          'AI':'Exit reason','AJ':'Outcome basis'}\\nlist_col = {v[0]: k for k, v in LISTS.items()}\\nfor col, cat in DV_MAP.items():\\n    lc = list_col[cat]\\n    last = max(len(LISTS[lc][1]) + 1, 2)\\n    dv = DataValidation(type='list', formula1=f\\\"'Lists'!${lc}$2:${lc}${last}\\\", allow_blank=True)\\n    dv.error = 'Use a value from the Lists sheet.'\\n    dv.promptTitle = cat\\n    ws.add_data_validation(dv)\\n    dv.add(f'{col}2:{col}{last_row + 30}')\\n\\n# ---------------- AI original (hidden, values baseline) ----------------\\nai = wb.create_sheet('AI original')\\nfor col, title, width in LED_COLS:\\n    c = ai[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\n    ai.column_dimensions[col].width = width\\nfor i, rr in enumerate(ROWS):\\n    row = first_data_row + i\\n    for col, title, width in LED_COLS:\\n        src_cell = ws[f'{col}{row}']\\n        c = ai[f'{col}{row}']\\n        c.value = src_cell.value\\n        c.font = BODY_FONT; c.border = BORDER; c.alignment = WRAP\\n        c.number_format = src_cell.number_format\\nai.cell(row=last_row + 2, column=1,\\n        value=('Baseline: values-only copy of the delivered Deal ledger (all expandable fields and Row ids). '\\n               'Corrections are made on the Deal ledger; cells that no longer match this baseline by Row id + column '\\n               'are highlighted red bold by conditional formatting. Do not edit this sheet.')).font = Font(size=9, italic=True)\\nai.sheet_state = 'hidden'\\n\\n# ---------------- conditional formatting: baseline comparison ----------------\\nfor ci in range(2, len(LED_COLS) + 1):   # columns B..AM\\n    col = get_column_letter(ci)\\n    if col == 'P':\\n        continue  # Include is a control flag, not baseline content to flag\\n    formula = (f\\\"AND($O2<>\\\\\\\"\\\\\\\",SUMPRODUCT(('AI original'!$O$2:$O${last_row}=$O2)*\\\"\\n               f\\\"(EXACT('AI original'!{col}$2:{col}${last_row}&\\\\\\\"\\\\\\\",{col}2&\\\\\\\"\\\\\\\")))=0)\\\")\\n    ws.conditional_formatting.add(f'{col}2:{col}{last_row + 30}',\\n                                  FormulaRule(formula=[formula], font=REDBOLD, stopIfTrue=False))\\n\\n# ---------------- Questions ----------------\\nqs = wb.create_sheet('Questions')\\nQCOLS = [('A','Q',7),('B','Review topic',26),('C','Recommended answer',62),('D','Why and source',62),\\n         ('E','Affected rows/fields',30),('F','Consequence of changing it',42),('G','Status',10),('H','Reviewer note',26)]\\nfor col, title, width in QCOLS:\\n    c = qs[f'{col}1']; c.value = title; c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\n    qs.column_dimensions[col].width = width\\nqs.row_dimensions[1].height = 22\\n\\nQUESTIONS = [\\n ('Q1','Process and round map; rejected boundaries',\\n  'Adopt one process (Process 1) with two analytical rounds: R1 opened at the first-week-of-October 2014 confidentiality/standstill wave (Not final; preliminary IOI stage) and R2 the final round opened 11/03/2014 (Announced as final). Keep round 0 for pre-opening approaches. Reject a separate R3 for the November request for final bids: it is the continuing purpose of R2 and the smallest map preserving real transitions. Reject the 08/13 sale decision, 08/19 press release, Industry Participant contacts and the 10/30 deadline as the R1 anchor (no target outreach wave is reported; the NDA wave is the first target-organized admission step). No go-shop; no post-signing solicitation; no process termination/restart.',\\n  'Instruction 6.3 anchor order and round rules; P-011 (\\\"J.P. Morgan was contacted by 27 potential participants\\\"), P-013 (NDA wave), P-017 (four to the final round), P-020/P-021 (final-bid timetable), P-034 future — see Source text. The reasons describe the same process (X-008a).',\\n  'R016, R028, R009, R013, R008/R015, R019/R020',\\n  'If a third round were adopted, R2 finality and round-bidder tallies split and the 12/10 bids would need re-rounding; if the anchor moved to 08/13, R1 scope would include parties that never signed and R1 bidder counts would not match the 15-signer base.'),\\n ('Q2','Deadline history and treatments',\\n  'Keep: 10/30/2014 IOI deadline — Enforced; 12/05/2014 final-bid date — superseded before arrival by the 12/04–05 revision (remains in history; no milestone row; treated Extended on the revised row); 12/10/2014 final-bid deadline — Extended (improved bids requested for 12/12); 12/12/2014 — Enforced. No \\\"Late bids accepted\\\": Bidder 2\\\\u2019s increase after 10/30 was target-solicited continuing negotiation, not late acceptance.',\\n  'P-014/P-016 (IOIs due and submitted), P-017 (advancement on the bids in hand), P-020/P-021 (revision 12/05→12/10), P-026 (improvement to 12/12), P-029 (bids), P-030 (selection).',\\n  'R019, R020, R034, R036, R041, R042 (Due date / Deadline treatment fields; Summary deadline map)',\\n  'Different labels change the Summary deadline map; marking 10/30 \\\"Late bids accepted\\\" would wrongly reclassify the target-solicited Bidder 2 revision.'),\\n ('Q3','Bidder 3 membership and unit reconciliation',\\n  'Recommended reading: Bidder 3 was formed by the two final-round bidders other than the Buyer Group and Bidder 2 (Unnamed financial bidders A and B; R024/R025). This is the only reading that reconciles the four invited bidders to the three bidding units active in December and the Reasons\\\\u2019 statement that the Company \\\"negotiated with the Buyer Group as well as two other bidding groups\\\". The filing does not name the members; keep R031/R032 as Count-0 \\\"Inferred: identity\\\" rows and do not treat the names as settled.',\\n  'P-016 (four bidders at/above $80; specific prices for Buyer Group and the $80–85 bidder), P-017 (four allowed to proceed; two eliminated), P-018 (two requested to work together; \\\"Bidder 3\\\"), P-025 (December record: Buyer Group, Bidder 2 and a verbal indication from Bidder 3 only), X-008a (\\\"two other bidding groups\\\").',\\n  'R030, R031, R032, R024, R025, R028, R036',\\n  'If the pair instead included an eliminated below-$80 bidder, an invited bidder would have disappeared without a disclosed outcome and the three-unit December record would not reconcile; the Unit-count statements in Summary would need rework.'),\\n ('Q4','NDA quantities, overlap, type splits and the 6-vs-5 conflict',\\n  'Keep: 15 new NDA signers, all financial buyers (auction screen MET); 27 contacts split 3 strategic + 24 financial; six submitting parties in Round 1 (Background p.24) as the primary count, with the Reasons\\\\u2019 \\\"5 bidder groups\\\" (p.27) preserved as a conflicting group-basis statement (two combining bidders counted as one group, or drafting variance); nine non-submitters as the residual 15 − 6 with the base assumption stated. Note: the six submitters are assumed to be among the 15 signers; if not, the residual rises.',\\n  'P-011, P-013, P-016, P-017; X-008a (\\\"5 bidder groups\\\"); X-009 (standstills); P-021 arithmetic.',\\n  'R011, R012, R017, R021, R022–R027',\\n  'Changing the submitting count to five would make the residual ten and alter the R1 stage balance; changing the NDA base would alter the auction-screen statement and Summary totals.'),\\n ('Q5','Participation outcomes, agency and inferred closings',\\n  'Adopt: 9 non-submitters — Did not submit (Inferred: residual; Unknown / Not stated; assigned to the 10/30/2014 deadline). Two below-$80 submitters — Dropped by target (Stated; Target; Lower offer than rivals). Bidder 3 — Did not submit (Stated; Both — target discouragement before non-submission; Value at or below market price). Bidder 2 — Not selected at signing (Stated; Target; Lower offer than rivals). Unnamed financial bidders A and B — Count-0 Inferred: identity rows. Industry Participant never entered: contacts and target decisions only, no outcome row.',\\n  'P-013/P-016 (base and six submitters), P-017 (eliminations), P-025 (verbal indication; no written offer), X-008a/b ($81.50 best and final vs $83.00), P-010/P-012 (Industry Participant exclusion).',\\n  'R021, R029, R040, R049, R031, R032, R008–R015',\\n  'Agency labels feed the outcome tallies and the Summary balance; converting the residual to individual exits is not supported and would fabricate identities; treating Industry Participant as entered would require an invented outcome.'),\\n ('Q6','Formality and conditions levels',\\n  'Keep: IOIs Informal (preliminary non-binding indications; no supported formal signal) with Conditions level Insufficient evidence (price only; October diligence access existed but no conditions are stated). Final bids: Buyer Group Formal/Light (returned agreement markups; financing commitment documents 12/06; no diligence condition stated); Bidder 2 Formal with 12/10 Insufficient evidence and 12/12 Light (financing commitment documents submitted); Bidder 3 Informal with a bound-only price and Insufficient evidence. The 12/06 markups and 12/08 revised drafts belong to the 12/10 bids (no separate rows). No None, no Heavy, and no late-reconfirmation rows are created.',\\n  'P-016 (IOIs), P-017 (advancement), P-022 (12/06 comments and financing documents), P-025 (final bids; comparative conditionality), P-029 (revised drafts and financing documents), P-021 (documents \\\"in advance\\\"), X-027 (committed debt/equity financing).',\\n  'R022–R027, R037, R038, R039, R044, R045, R046 (Formality / Conditions level / Conditions detail)',\\n  'Reclassifying the IOIs as Heavy by context would contradict the instruction (substantive diligence access had preceded them); moving the 12/06 markups into their own rows would create duplicate draft events.'),\\n ('Q7','Scope, currency, price interpretation and normalization',\\n  'Keep: no other-scope proposals (all whole-company); all amounts USD, no conversions; Bidder 3\\\\u2019s \\\"not above approximately $78\\\" recorded as a Bound-only price (Price high 78.00; approximate, based on the then-current stock price — flagged). Unnamed financial bidder B\\\\u2019s \\\"range reached at least $80.00\\\" is ambiguous (floor on the range vs level reached); endpoints left blank and kept in text. Longview\\\\u2019s rollover is equity in Parent, not public consideration — all other shares receive $83.00 cash; the ~$8.25bn equity value is an outstanding-basis calculation (83.00 × 99,455,151), not a filing-stated total.',\\n  'P-016 (ranges), P-025 (verbal indication), X-002/X-003 (consideration; shares), X-013 (rollover $250m), X-015 (3,012,050 shares), X-011–X-014 (funds).',\\n  'R024, R025, R039, R043, R046; Summary comparability inputs',\\n  'Reading B as a floor would add a Bound-only row and change the R1 price display; blanking Bidder 3\\\\u2019s Price high would lose a disclosed bound; adding the rollover to public consideration would misstate per-share cash.'),\\n ('Q8','Dates, assigned Working dates and same-day order',\\n  'Keep the disclosed conventions: NDA wave Working date 10/01 (first day of the \\\"first week of October\\\"; the relative order with the 10/03 board meeting is not stated — display convention); J.P. Morgan retention 07/01 (Assigned: sequence, to preserve reading order ahead of the dated 07/03 JANA filing); November projections update 11/15 (period midpoint); Bidder 3 formation 11/04 (first admissible day after 11/03); the Bidder 3 non-submission assigned to the 12/10 deadline; same-day sequences 12/10 (deadline → bids → improvement revision) and 12/12 (deadline → rollover approval → Bidder 2 → Buyer Group $82.50 → $83.00); 12/13 approval before 12/14 signing and announcement.',\\n  'Instruction 8.1 rules; P-013 (first week of October), P-012 (10/03 meeting), P-005 (July retention), P-019 (November projections), P-018 (formation after 11/03), P-025/P-026/P-029 (December sequence), P-030/P-031.',\\n  'R003, R016–R018, R033, R030–R032, R040, R036–R041, R045–R050',\\n  'These choices affect only display order and the sort key, never the source facts; moving a Working date could reorder same-date rows within a round (relevant to the December sequence and the R1/R2 boundary).'),\\n]\\nqr = 2\\nfor q in QUESTIONS:\\n    for j, v in enumerate(q):\\n        c = qs.cell(row=qr, column=j+1, value=v)\\n        c.font = SECT_FONT if j == 0 else BODY_FONT\\n        c.alignment = WRAP; c.border = BORDER\\n    qr += 1\\nqr += 1\\nc = qs.cell(row=qr, column=1, value='Check results (instruction section 13) — run at build, 09/19/2026')\\nc.font = Font(bold=True, size=11, color='1F4E79'); qr += 1\\nCHECKS = [\\n ('1. Coverage and materiality','Passed',\\n  'All disclosed core offers, contacts/NDAs, information/selection changes, participation outcomes, process transitions, signing and publicity are represented. Routine 12/06 comments and 12/08 draft exchanges are deliberately folded into the 12/10 bids; inferred closing rows are explicit (R021, R031, R032).'),\\n ('2. Counts and population','Qualified',\\n  'Summary arithmetic matches included ledger contributions (NDA 15; contacts 28 incl. Industry Participant; R1 submissions 6; R2 units 3). Source qualifiers preserved: the Reasons\\\\u2019 \\\"5 bidder groups\\\" conflicts with the Background\\\\u2019s six submitters; the 9-residual assumes all six submitters were signers; the Bidder 3 identity reading affects the unit break-down (see Q3/Q4).'),\\n ('3. Participation continuity','Passed',\\n  'Every participant that entered is closed: 9 inferred non-submitters; 2 dropped; 2 joined-group Count-0 identity rows; 1 did not submit; 1 not selected at signing; the Buyer Group remains as winner. Entrant stock never negative; Industry Participant never entered and has no outcome row. The closure mechanism for Unnamed financial bidders A/B depends on the Q3 reading.'),\\n ('4. Dates and order','Passed',\\n  'Programmatic checks: every row has a Working date and Date method; sorting by Working date with # as tie-breaker reproduces the ledger order (non-decreasing); Working dates lie within their Date from/Date to windows; Date basis/method pairs are valid (Reported day = Reported; Inferred day = Inferred); deadline communication, due dates and signing are kept distinct. Based on the filing text; not externally validated.'),\\n ('5. Offers and classifications','Qualified',\\n  'Formality and conditions assessments are reasoned; Conditions detail strings use the fixed format on every Bid/Bid reaffirmed row. Insufficient-evidence levels remain for the preliminary IOIs and Bidder 2\\\\u2019s first final bid; Bidder 3 is a Bound-only price; no Heavy or None classifications were required. Offer updates, groups, reaffirmations and signing are not mistaken for extra priced submissions.'),\\n ('6. Structure and consistency','Passed',\\n  'One Round opened row per round with a Round finality value; R1 anchor tag present with rejected candidates as rows; every Deadline row carries a treatment matching the Summary map; Page populated wherever Source is populated (R051 uses \\\"A-46\\\" for the annex); tags and structured fields agree; Row ids unique; Include defaults to Yes.'),\\n ('7. Evidence','Passed',\\n  'Every quotation in Why and evidence was programmatically recovered exactly from its cited Source text passage (token match, allowing only declared whitespace/quote normalization), and pages were carried from the filing. Interpretation validity was checked by reading (see Q3, Q5, Q8).'),\\n ('8. Review and workbook operation','Qualified',\\n  'Data validations, hidden sheets, column groups, autofilter and print-free-layout were created programmatically; formulas and dropdowns were recalculated in LibreOffice headless (values reconcile with hand arithmetic). Internal Source links and the AI-original baseline comparison (red-bold conditional formatting) were not tested in a desktop spreadsheet application; links are static and may need refreshing after sorting; the correction-highlighting baseline is a values-only snapshot.'),\\n]\\nfor name, res, note in CHECKS:\\n    qs.cell(row=qr, column=1, value=name).font = BODY_FONT\\n    qs.cell(row=qr, column=2, value=res).font = BODY_FONT\\n    qs.cell(row=qr, column=3, value=note).font = BODY_FONT\\n    for col in (1,2,3):\\n        qs.cell(row=qr, column=col).alignment = WRAP\\n        qs.cell(row=qr, column=col).border = BORDER\\n    qr += 1\\nfor col in ('E','F','H'):\\n    pass\\nqs.column_dimensions['D'].width = 62\\n\\n# ---------------- Summary ----------------\\nsm = wb.create_sheet('Summary')\\nsm.column_dimensions['A'].width = 40\\nsm.column_dimensions['B'].width = 150\\nsm.column_dimensions['C'].width = 30\\nsm.column_dimensions['D'].width = 60\\nsr = 1\\ndef put(label, text, bold=False, title=False, height=None):\\n    global sr\\n    a = sm[f'A{sr}']; b = sm[f'B{sr}']\\n    a.value = label; b.value = text\\n    a.font = TITLE_FONT if title else (SECT_FONT if bold else Font(size=10, bold=True))\\n    b.font = Font(size=10)\\n    a.alignment = WRAP; b.alignment = WRAP\\n    if height is None and text:\\n        height = max(15, math.ceil(len(str(text)) / 148) * 15)\\n    sm.row_dimensions[sr].height = height\\n    sr += 1\\n\\nput('PetSmart, Inc. — sale process ledger', 'Deal short name: PetSmart  |  Ledger rows: 51  |  Process 1  |  Rounds 0–2  |  Delivered: 09/19/2026', title=True, height=24)\\nput('Status', 'AI first pass; not human-approved. Instruction revision: 19 September 2026 (Pro). Source coverage: the complete supplied filing — PetSmart, Inc. Definitive Proxy Statement on Schedule 14A (DEFM14A), filed 02/02/2015 (raw_filing/petsmart_2015-02-02_DEFM14A.htm; ~163 pages including Annexes A–C). The ledger is built from the complete Background of the Merger (pp. 21–26) plus passages cited from the Summary, Q&A, Reasons, Financing, Regulatory, Litigation, Market Price and Security Ownership sections and the merger-agreement notices. Last recheck status: initial build only; no post-delivery recheck yet. Correction tracking: the hidden \\\"AI original\\\" sheet holds a values-only baseline of the Deal ledger; changed cells are highlighted red bold by Row id + column (programmatically simulated, not tested in Excel).')\\nput('1. Commercial account', '', bold=True)\\nput('Story', 'After a weak 05/21/2014 earnings release and public pressure from JANA Partners (9.9% Schedule 13D on 07/03/2014) and Longview (07/07/2014 letter advocating a sale), the PetSmart board decided on 08/13/2014 to explore strategic alternatives including a possible sale, publicly announced the exploration on 08/19/2014, and excluded antitrust-risky Industry Participant from the process. J.P. Morgan was contacted by 27 potential participants (3 strategic, 24 financial); 15 financial buyers signed confidentiality and standstill agreements in the first week of October 2014 and received uniform diligence access, management presentations and Profit Improvement Plan information.')\\nput('', 'Six parties submitted non-binding indications of interest on 10/30/2014 (Buyer Group $81.00–$83.00; another bidder $80.00–$85.00; Bidder 2 $78.00 increased to $81.00–$84.00; an unnamed bidder whose range reached at least $80.00; and two submitters below $80.00). The board advanced the four at or above $80.00 to the final round on 11/03/2014; two of them combined as \\\"Bidder 3\\\" (units 4 → 3: Buyer Group, Bidder 2, Bidder 3).')\\nput('', 'Final bids on 12/10/2014 were $80.70 (Buyer Group) and $80.35 (Bidder 2), with Bidder 3 giving only an uncompetitive verbal indication (not above approximately $78.00). The ad hoc committee extended bidding to 12/12/2014, when Bidder 2 confirmed $81.50 as best and final and the Buyer Group moved $82.50 → $83.00 best and final with committed financing and substantially executable documentation.')\\nput('', 'The board approved the Buyer Group merger on 12/13/2014 and the parties signed on 12/14/2014 at $83.00 per share in cash — a 38.8% premium to the 07/02/2014 unaffected price and 6.9% above the 12/12/2014 close of $77.67 — with Longview rolling over 3,012,050 shares (about $250m) and voting 7,424,591 shares in favour. Observed outcome: signed with the Buyer Group; no post-signing competing proposal as of 02/02/2015; closing not observed in the filing (expected first half of 2015).')\\nput('Initiation assessment', 'Mixed, with activist influence and substantial inbound interest: the board\\\\u2019s own alternatives review and Profit Improvement Plan planning (06/18/2014) preceded, but did not cause, a sale; the 08/13/2014 sale decision followed the JANA/Longview campaigns, and the process then ran largely on parties approaching J.P. Morgan after the 08/19/2014 publicity.')\\nput('2. Deal facts', '', bold=True)\\nput('Target', 'PetSmart, Inc. (Delaware; NASDAQ: PETM; 1,404 stores; 202 in-store boarding facilities in the U.S., Canada and Puerto Rico). [P-001, P-002, X-007]')\\nput('Focal acquirer', 'Argos Holdings Inc. (\\\"Parent\\\") / Argos Merger Sub Inc., affiliates of funds advised by BC Partners, Inc.; Parent to be owned by the Buyer Group. Type: Financial (private-equity-led consortium; no strategic buyer advanced). [X-007, R048]')\\nput('Buyer Group', 'Funds advised by BC Partners, Inc.; La Caisse de dépôt et placement du Québec; affiliates of GIC Special Investments Pte Ltd; affiliates of StepStone Group LP; and Longview Asset Management, LLC at all times after 12/12/2014. [X-001, X-007]')\\nput('Agreed consideration', '$83.00 per share in cash; all cash; transaction not subject to a financing condition. [X-002, X-005, R046, R048]')\\nput('Key dates', 'Merger agreement dated as of 12/14/2014; announced 12/14/2014. Special meeting 03/06/2015; record date 01/29/2015 (99,455,151 shares outstanding; majority of outstanding shares required). Expected closing first half of 2015 — not observed in the filing. [P-031, X-003, X-025, X-024, X-002]')\\nput('Termination fees', '$255m company termination fee; $510m Parent reverse termination fee; expense reimbursement up to $15m. Legal terms recorded for context only (no ledger rows). [X proxy summary pp. 7–8]')\\nput('Share counts / rollover', 'Record date shares 99,455,151; Longview rollover 3,012,050 shares ($250m worth) for Parent equity; Longview voting agreement 7,424,591 shares (~7.5%); Longview beneficial ownership 8,214,170 shares (8.3%) per its 12/19/2014 Schedule 13D/A. [X-003, X-015, X-004, X-022]')\\nput('Financing inputs', 'Total funds required estimated at approximately $8.4bn: debt up to ~$6.2bn plus a $750m senior secured ABL revolver (aggregate debt facility up to $6.95bn; not all drawn), cash equity up to ~$1.83bn, Longview rollover $250m, and ~$425m cash on hand at closing. [X-011–X-015]')\\nput('Filing', 'DEFM14A, filed 02/02/2015; source file: raw_filing/petsmart_2015-02-02_DEFM14A.htm (relative local link). Background pages 21–26. Full passages in the Source text sheet.')\\nput('3. Process and round map', '', bold=True)\\nput('Process 1', 'Only sale attempt observed: exploration decision 08/13/2014 → Round 1 (October NDA/IOI stage) → Round 2 final round 11/03/2014 → signing 12/14/2014. Outcome: signed with the Buyer Group; closing pending at the filing date. No process termination or restart. Post-signing: no go-shop; no-solicitation with fiduciary out; 15 signers\\\\u2019 standstills; no unsolicited proposal as of 02/02/2015. [R009; R016; R028; R048; X-009; X-010]')\\nput('Round 0 (pre-opening)', 'No Round opened row. 06/18/2014 board review and committee formation [R001–R002]; J.P. Morgan retention (July) [R003]; JANA/Longview activism [R004–R007]; Industry Participant approaches and exclusion [R008–R015]; 27 contacts [R011–R012]; 08/19 announcement [R013].')\\nput('Round 1 — Not final', 'Opened at the confidentiality/standstill wave, first week of October 2014 [R016] (R1 anchor; rejected candidates R009, R013, R008/R015, R019–R020). Scope: 15 financial signers [R017]. IOI deadline communicated during October, due 10/30/2014 — Enforced [R019–R020]. Submissions: Buyer Group $81–83 [R022]; Bidder 2 $78 [R023] revised to $81–84 [R027]; Unnamed financial bidder A $80–85 [R024]; Unnamed financial bidder B range reached ≥$80 [R025]; two other submitters, prices not disclosed [R026]; nine inferred non-submitters [R021]. Transition 11/03/2014 [R028]: four advanced; two eliminated [R029].')\\nput('Round 2 — Announced as final', 'Opened 11/03/2014 [R028]. Units: 4 invited → two combine as Bidder 3 [R030–R032] → 3 independent units. November: further diligence; updated FY2014 projections [R033]. Deadlines: final-bid date set earlier for 12/05/2014, revised 12/04–05 to 12/10/2014 [R034] — Extended [R036]; improvement request 12/10 → 12/12/2014 [R041] — Extended [R042]. Bids: Buyer Group $80.70 [R037]; Bidder 2 $80.35 [R038]; Bidder 3 ≤~$78 verbal [R039] and no written offer [R040]. Longview introductory meetings 12/09 [R035]; rollover permitted/formed 12/12 [R043]. Improved/best and final: Bidder 2 $81.50 [R044]; Buyer Group $82.50 [R045] → $83.00 [R046]. Board approval 12/13 [R047]; signing and announcement 12/14 [R048–R050].')\\nput('Deadline history', '10/30/2014 — Enforced (six IOIs; board advanced four). 12/05/2014 — superseded before arrival by the 12/04–05 revision (Extended; no milestone row). 12/10/2014 — Extended (improved bids to 12/12). 12/12/2014 — Enforced (bids received; selection and signing followed). No late bids accepted. [R019–R020, R034, R036, R041–R042]')\\nput('Round-bidder tallies', 'Round 1: 6 submitting units. Round 2: 3 submitting/communicating units (Buyer Group, Bidder 2, Bidder 3). These are stage-specific units, not unique firms across the deal. [R022–R027; R037–R039, R044–R046]')\\nput('4. Participants and advisers', '', bold=True)\\nput('Buyer Group', 'Financial (PE-led consortium). Among the 15 signers (first week October); first recorded bid 10/30 $81–83 [R022]; advanced 11/03; final bid $80.70 [R037]; improved $82.50 → $83.00 best and final [R045–R046]; winner — no exit row; closing pending at the filing date. Longview admitted to the group after 12/12/2014 (rollover, not a membership change).')\\nput('Bidder 2', 'Financial. IOI $78.00 [R023] revised to $81–84 [R027]; advanced; final bid $80.35 [R038]; improved best and final $81.50 [R044]; Not selected at signing (Stated; Target; Lower offer than rivals) [R049].')\\nput('Bidder 3', 'Financial. Formed early November 2014 from two unnamed final-round bidders [R030]; verbal indication not above approximately $78 [R039]; Did not submit (Stated; Both; Value at or below market price) [R040].')\\nput('Unnamed financial bidder A', 'Financial. IOI $80.00–$85.00 [R024]; final-round bidder; Joined group / Inferred: identity, Count 0 (closes independent bidding; may be one of Bidder 3\\\\u2019s members) [R031].')\\nput('Unnamed financial bidder B', 'Financial. IOI with a range that reached at least $80.00, endpoints not disclosed [R025]; final-round bidder; Joined group / Inferred: identity, Count 0 [R032].')\\nput('Other submitters / signers', 'Two further IOI submitters (cohort, prices not disclosed; Dropped by target 11/03) [R026, R029]; nine NDA signers (Did not submit at 10/30; Inferred: residual) [R021]; 3 strategic parties and 9 financial parties contacted but never admitted — no outcome rows.')\\nput('Industry Participant', 'Strategic. Approaches 08/07/2014 and 08/27/2014; excluded from the process by target decision 08/13/2014, reaffirmed 10/03/2014; never entered — no outcome row. [R008, R010, R014, R015, R018]')\\nput('Activists', 'JANA Partners (13D 9.9% on 07/03; in-person meeting 07/10; further amendments/letters through July–August) and Longview (public letter 07/07; call 07/10; later rollover investor and voting-agreement party). [R004–R007, R043, R048]')\\nput('Advisers', 'J.P. Morgan Securities LLC — Company financial advisor and process bank (engaged July 2014; fairness opinion 12/13, confirmed 12/14) [R003, R047]. Wachtell, Lipton, Rosen & Katz — Company legal advisor (earliest supported service 06/18/2014) [R002]. Simpson Thacher & Bartlett LLP — Parent/Merger Sub legal counsel (earliest support: executed merger agreement, 12/14/2014) [R051]. Innisfree M&A Incorporated — Company proxy solicitor for the special meeting (~$182,725 paid by the record date; ~$240,000 expected through March 2015; engagement date not disclosed) — Summary only [X-023]. An unnamed financial advisor attended the 06/18/2014 board meeting and is not attributed to any named firm [P-004].')\\nput('Financing sources', 'Debt financing lenders (not advisers): Citigroup Global Markets Inc., Barclays Bank PLC, Deutsche Bank AG New York Branch, Nomura Securities International, Inc., Jefferies Finance LLC; joined by RBC Capital Markets, Macquarie Capital (USA) Inc. and Natixis, New York Branch. [X-017]')\\nput('5. Counts and auction screen', '', bold=True)\\n# counts table with formulas\\nCOUNT_ROWS = [\\n ('Contacts (organisations approached)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Contact\\\",\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")+SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Bidder interest\\\",\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  '27 potential participants (3 strategic + 24 financial; p.23); \\\"more than 25\\\" (p.27)',\\n  'Ledger 28 includes Industry Participant (carried on its Bidder interest row R008, Count 1) which the filing excludes from the 27. Scope: organisations, not bids.'),\\n ('NDA signers (new)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"NDA signed\\\",\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  '15 potentially interested financial buyers (p.23)',\\n  'All financial; no reused agreements identified. Auction screen (more than one independent prospective acquiring bidder unit with executed confidentiality agreements): MET.'),\\n ('Round 1 submitting units', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$52,1,\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  'Six parties submitted indications of interest (p.24); \\\"5 bidder groups\\\" (p.27)',\\n  'Conflict preserved; preferred reading = six parties (background, specific); the reasons\\\\u2019 group-basis count may reflect the two combining bidders (see Q4).'),\\n ('Round 2 submitting/communicating units', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$52,2,\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  '\\\"negotiated with the Buyer Group as well as two other bidding groups\\\" (p.27)',\\n  'Buyer Group, Bidder 2, Bidder 3.'),\\n ('Inferred non-submitters (R1)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$AJ$2:$AJ$52,\\\"Inferred: residual\\\",\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  'Derived 15 signers \\\\u2212 6 submitters',\\n  'Base assumption: all six submitters were among the 15 signers; if not, the residual rises (see Q4).'),\\n ('Stated R1 exits (dropped)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$52,\\\\'Deal ledger\\\\'!$D$2:$D$52,\\\"Dropped by target\\\",\\\\'Deal ledger\\\\'!$AJ$2:$AJ$52,\\\"Stated\\\",\\\\'Deal ledger\\\\'!$P$2:$P$52,\\\"Yes\\\")',\\n  'The eliminated parties were notified (p.24)',\\n  'The two submitters below $80.00.'),\\n]\\nfor label, formula, assertion, note in COUNT_ROWS:\\n    sm.cell(row=sr, column=1, value=label).font = Font(size=10, bold=True)\\n    c = sm.cell(row=sr, column=2, value=formula); c.font = BODY_FONT\\n    sm.cell(row=sr, column=3, value=assertion).font = BODY_FONT\\n    sm.cell(row=sr, column=4, value=note).font = BODY_FONT\\n    for col in (1,3,4):\\n        sm.cell(row=sr, column=col).alignment = WRAP\\n    sm.row_dimensions[sr].height = max(15, math.ceil(len(note)/40)*15)\\n    sr += 1\\nput('Stage balance (R1)', 'Entrants 15 (NDA signers) − stated exits 2 (dropped below-$80 submitters) − inferred exits 9 (non-submitters) = 4 continuing (the four bidders advanced to the final round). Inferred share of R1 exits: 9/11 (82%).')\\nput('Stage balance (R2)', 'Opening units 4 (invited) + 1 unit formed (Bidder 3) = 5 unit-configurations; exits: 2 members joined group (Count-0 identity rows), Bidder 3 did not submit, Bidder 2 not selected = 4; remaining at signing: 1 — the Buyer Group (winner). Inferred share of R2 exits: 0 (all stated, except the two Count-0 identity rows).')\\nput('Outcome tallies', 'Occurrences/affected units (not unique permanent exits): Dropped by target 2; Did not submit 10 (9 inferred + 1 stated); Not selected at signing 1; Joined group 2 members. Winner: Buyer Group. Organisations vs units: 15 NDA signer organisations; 6 R1 submitting parties; 3 R2 independent units; 1 winner.')\\nput('6. Comparability and inputs', '', bold=True)\\nput('Scope / currency', 'Other-scope proposals: none observed — all proposals were for whole-company equity. Currency: USD throughout; no conversions. Contingent consideration: none; no CVRs.')\\nput('Unusual consideration', 'Longview rollover (equity in Parent for 3,012,050 shares, $250m worth) is not public consideration; all other Longview shares receive $83.00 cash. Standstill provisions limit post-signing bidding by the 15 signers. No go-shop. Reverse termination fee $510m.')\\nput('Market benchmarks', 'Agreed price $83.00; premium 38.8% to the 07/02/2014 unaffected price (calculated implied unaffected price ≈ $59.80 = 83.00 / 1.388); 12/12/2014 close $77.67 (last trading day before announcement); 01/30/2015 close $81.71; 2014 Q4 high/low $81.97 / $63.21; 2015 Q1-through-01/30 high/low $81.95 / $81.00. [X-021, X-026]')\\nput('Optional calculations', 'Equity value at $83.00 × 99,455,151 shares = $8,254,777,533 (outstanding-basis only; excludes options/RSUs/PSUs and any dilution; not a filing-stated total). Premium to 12/12/2014 close = 6.9% (83.00/77.67 − 1). [X-003, X-002]')\\nput('Glossary', 'NDA = confidentiality/non-disclosure agreement. Standstill = contractual limit on acquiring shares/announcing bids (here, also barring higher bids after a definitive agreement). IOI = indication of interest. Rollover = holder contributes shares to the buyer\\\\u2019s vehicle instead of receiving cash. Go-shop = post-signing solicitation window (none here). HSR = U.S. Hart-Scott-Rodino antitrust waiting period (early termination 01/07/2015). ARC = Canada Advance Ruling Certificate (issued 01/14/2015). Bound only = one-sided communicated price limit, not a submitted level. Reverse termination fee = fee payable by the buyer/Parent ($510m here). [X-018, X-019]')\\n\\nwb.move_sheet('Summary', offset=-(len(wb.sheetnames)-2)) if False else None\\n# reorder sheets: Deal ledger, Summary, Questions, Source text, (AI original, Lists hidden)\\norder = ['Deal ledger','Summary','Questions','Source text','AI original','Lists']\\nwb._sheets = [wb[n] for n in order]\\nws.sheet_properties.tabColor = '1F4E79'\\nsm.sheet_properties.tabColor = '2E75B6'\\nqs.sheet_properties.tabColor = '2E75B6'\\nst.sheet_properties.tabColor = '2E75B6'\\n\\nwb.save(OUT)\\nprint('saved', OUT)\\n\", \"path\": \"/tmp/opencode/make_workbook.py\"}"},"time":{"start":1789825115006,"end":1789825159421}}}}
