rint('ledger rows:', ws.max_row-1, 'source rows:', src.max_row-1)\nprint('validations:', len(ws.data_validations.dataValidation))\nimport os\nprint('file size:', os.path.getsize('/home/uctpiaj/work/extraction/providence-worcester.xlsx'))\nEOF"},"output":"PAGE MISMATCH R028 30 P-012 29\npage mismatches: 1\nR019 related: R020 (non-submitter residual); R021 (two low bidders)\nP-002 matches block text: True\nX-008 matches block text: True\nP-034 matches block text: True\nsheets: [('Deal ledger', 'visible'), ('Summary', 'visible'), ('Questions', 'visible'), ('Source text', 'visible'), ('AI original', 'hidden'), ('Lists', 'hidden')]\nledger rows: 60 source rows: 50\nvalidations: 15\nfile size: 79986\n","title":"shell","metadata":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"PAGE MISMATCH R028 30 P-012 29\npage mismatches: 1\nR019 related: R020 (non-submitter residual); R021 (two low bidders)\nP-002 matches block text: True\nX-008 matches block text: True\nP-034 matches block text: True\nsheets: [('Deal ledger', 'visible'), ('Summary', 'visible'), ('Questions', 'visible'), ('Source text', 'visible'), ('AI original', 'hidden'), ('Lists', 'hidden')]\nledger rows: 60 source rows: 50\nvalidations: 15\nfile size: 79986\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /tmp/opencode && python3 - <<'EOF'\\nimport re\\nfrom openpyxl import load_workbook\\nwb = load_workbook('/home/uctpiaj/work/extraction/providence-worcester.xlsx')\\nws = wb['Deal ledger']; hdr=[c.value for c in ws[1]]; ci={h:i+1 for i,h in enumerate(hdr)}\\nsrc = wb['Source text']; spage = {src.cell(row=r,column=1).value: src.cell(row=r,column=3).value for r in range(2, src.max_row+1)}\\n# page consistency between ledger Page and main linked paragraph\\nbad=0\\nfor r in range(2, ws.max_row+1):\\n    pg = ws.cell(row=r, column=ci['Page']).value\\n    link = ws.cell(row=r, column=12).hyperlink\\n    if link and link.location:\\n        cellref = link.location.split('!')[-1].replace('$','')\\n        rownum = int(re.sub(r'[A-Z]','',cellref))\\n        pid = src.cell(row=rownum, column=1).value\\n        if spage.get(pid) != pg:\\n            bad+=1; print('PAGE MISMATCH', ws.cell(row=r, column=ci['Row id']).value, pg, pid, spage.get(pid))\\nprint('page mismatches:', bad)\\n# R019 related check\\nr19 = next(rr for rr in range(2, ws.max_row+1) if ws.cell(row=rr, column=ci['Row id']).value=='R019')\\nprint('R019 related:', ws.cell(row=r19, column=ci['Related rows']).value)\\n# spot-check source text fidelity vs original block\\nimport json\\nblocks = [t for p,t in json.load(open('blocks_pages.json'))]\\nchecks = [('P-002', 549), ('X-008', 870), ('P-034', 581)]\\nfor pid, bi in checks:\\n    row = next(rr for rr in range(2, src.max_row+1) if src.cell(row=rr,column=1).value==pid)\\n    same = src.cell(row=row, column=4).value == blocks[bi]\\n    print(pid, 'matches block text:', same)\\nprint('sheets:', [(s.title, s.sheet_state) for s in wb.worksheets])\\nprint('ledger rows:', ws.max_row-1, 'source rows:', src.max_row-1)\\nprint('validations:', len(ws.data_validations.dataValidation))\\nimport os\\nprint('file size:', os.path.getsize('/home/uctpiaj/work/extraction/providence-worcester.xlsx'))\\nEOF\"}"},"time":{"start":1789825193191,"end":1789825195388}}}}
