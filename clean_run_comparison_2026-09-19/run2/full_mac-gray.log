{"type":"tool_use","timestamp":1789824986447,"sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","part":{"partID":"prt_0b9e0de89001Qv0gR71thcNZSf","sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","messageID":"msg_0b9e05ac2001sCQ5xstscBXHNa","type":"tool","id":"call_00_WaM1UtOFN6BslH1zaNLR0108","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Build and verify the Mac-Gray deal-ledger data (rows, questions, summary, source text).\n\nOutputs /tmp/opencode/ledger_data.json with fully resolved quotes and dates.\n\"\"\"\nimport re, json, unicodedata, difflib\nfrom datetime import date\nfrom bs4 import BeautifulSoup\n\nSRC = 'raw_filing/mac-gray_2013-12-04_DEFM14A.htm'\nPAGES = '/tmp/opencode/filing_pages.txt'\nOUT = '/tmp/opencode/ledger_data.json'\n\n# ---------------------------------------------------------------- source loading\nhtml = open(SRC, encoding='utf-8', errors='replace').read()\nmarkers = list(re.finditer(r\"<!--\\s*ZEQ\\.=\\d+,SEQ=\\d+,.*?-->\", html))\nparts = re.split(r'<!--\\s*ZEQ\\.=\\d+,SEQ=\\d+,.*?-->', html)\nfolios = [re.search(r\"FOLIO='([^']*)'\", m.group(0)).group(1) for m in markers]\n\n# page texts from the pre-extracted file (line list per component)\nlines = open(PAGES, encoding='utf-8').read().split('\\n')\ncomp_text = []          # list of (folio, raw_text_joined_with_spaces)\ncurrent = None\nfor ln in lines:\n    m = re.match(r'<<<PAGE (\\d+) folio=(\\S+)>>>', ln)\n    if m:\n        current = []\n        comp_text.append((m.group(2), current))\n        continue\n    if current is not None and ln.strip():\n        current.append(ln.strip())\ncomp_text = [(f, ' '.join(ls)) for f, ls in comp_text]\nALL = ' '.join(t for _, t in comp_text)\n\n# background paragraphs (same logic as make_source.py)\ndef norm(s):\n    s = s.replace('\\xa0', ' ')\n    s = re.sub(r'\\s+', ' ', s)\n    return s.strip()\n\nstart_comp = end_comp = None\nfor i, p in enumerate(parts):\n    t = norm(re.sub(r'<[^>]+>', ' ', p))\n    if start_comp is None and 'Background of the Merger.' in t and i > 5:\n        start_comp = i\n    if 'Reasons for the Merger and Recommendation of our Board' in t and start_comp is not None:\n        end_comp = i\n        break\nraw = []\nfor ci in range(start_comp, end_comp + 1):\n    folio = folios[ci]\n    soup = BeautifulSoup(parts[ci], 'lxml')\n    for p in soup.find_all('p'):\n        t = norm(p.get_text(' '))\n        if not t or t == 'Table of Contents' or re.fullmatch(r'[\\d\\s]+', t):\n            continue\n        if 'Reasons for the Merger and Recommendation' in t:\n            break\n        if t in ('Background of the Merger', 'Background of the Merger.', 'THE MERGER'):\n            continue\n        raw.append({'page': folio, 'text': t})\nmerged = []\nfor item in raw:\n    if merged and re.match(r'^[a-z0-9$]', item['text']) and not merged[-1]['text'].rstrip().endswith(('.', ';', ':', ',')):\n        merged[-1]['text'] = merged[-1]['text'].rstrip() + ' ' + item['text']\n        if merged[-1]['page'] != item['page']:\n            merged[-1]['page'] = f\"{merged[-1]['page']}-{item['page']}\"\n    else:\n        merged.append(dict(item))\nPARAS = []\nfor i, item in enumerate(merged, 1):\n    PARAS.append({'id': f'P-{i:03d}', 'section': 'THE MERGER — Background of the Merger',\n                  'page': item['page'], 'text': item['text']})\n\n# ---------------------------------------------------------------- X passages\nX_DEFS = [\n ('X-001', 'Summary Term Sheet', 5,\n  'If the merger is completed, at the effective time of the merger, each outstanding share of Mac-Gray common stock',\n  'We refer to this amount in this proxy statement as the merger consideration.'),\n ('X-002', 'Questions and Answers', 13,\n  'The merger consideration of $21.25 per share to be received by Mac-Gray stockholders represents:',\n  'an approximately 44% premium to the $14.72 closing price of our common stock on October 11, 2013'),\n ('X-003', 'Summary Term Sheet', 5,\n  'The Mac-Gray Board of Directors formed a special committee of six disinterested and independent directors',\n  'recommends that Mac-Gray stockholders adopt the merger agreement.'),\n ('X-004', 'Summary Term Sheet', 6,\n  'The merger agreement does not contain any condition to the obligations of the Buyer Entities or Merger Subsidiary relating to the receipt of financing',\n  'dated as of October 14, 2013, which we refer to as the Pamplona commitment letter.'),\n ('X-005', 'Summary Term Sheet', 10,\n  'Mac-Gray has agreed to pay Parent $11 million upon the termination of the merger agreement under certain circumstances',\n  'which we refer to as the Parent termination fee.'),\n ('X-006', 'Summary Term Sheet', 11,\n  'As of November 27, 2013, the record date for the special meeting, the stockholders of Mac-Gray that entered into the voting agreements collectively owned approximately 15%',\n  'entitled to vote at the special meeting.'),\n ('X-007', 'Questions and Answers', 13,\n  'The closing sale price of a share of Mac-Gray common stock on the New York Stock Exchange on November 27, 2013 was $21.30.',\n  'was $21.30.'),\n ('X-008', 'Questions and Answers', 14,\n  'We currently expect the merger to be completed in January 2014.',\n  'we cannot assure you that we will complete the merger on this schedule or at all.'),\n ('X-009', 'Questions and Answers', 15,\n  'As of the record date, there were approximately 14,758,306 shares of Mac-Gray common stock issued and outstanding held collectively by approximately 104 stockholders of record.',\n  'stockholders of record.'),\n ('X-010', 'The Special Meeting — Solicitation of Proxies', 23,\n  'we expect to retain MacKenzie Partners, Inc. to assist in the solicitation for a fee of approximately $15,000',\n  'indemnification against certain losses, costs and expenses.'),\n ('X-011', 'Proposals Submitted to Mac-Gray Stockholders', 24,\n  'Under applicable law, we cannot complete the merger without the vote of a majority of the outstanding shares',\n  'it will have the same effect as a vote against the proposal to adopt the merger agreement.'),\n ('X-012', 'Proposals Submitted to Mac-Gray Stockholders', 24,\n  'Section 951 of the Dodd-Frank Act and Rule 14a-21(c) under the Exchange Act require that Mac-Gray seek a non-binding advisory vote',\n  'in connection with the merger.'),\n ('X-013', 'The Companies', 26,\n  'Mac-Gray Corporation is the second largest laundry facilities management contractor in the United States.',\n  'through our product sales division.'),\n ('X-014', 'The Merger — Reasons for the Merger', 43,\n  'the fact that the $21.25 per share to be paid as the consideration in the merger represents a premium of approximately 36%',\n  'the last trading day prior to the date our Board of Directors approved the merger agreement;'),\n ('X-015', 'The Merger — Reasons for the Merger', 43,\n  'the Pamplona commitment letter, pursuant to which Pamplona has committed to fund up to $594 million',\n  'awarded to Mac-Gray in certain circumstances involving litigation brought pursuant to the merger agreement;'),\n ('X-016', 'The Merger — Opinion of Mac-Gray\\u2019s Financial Advisor', 45,\n  'On October 14, 2013, at a meeting of the Special Committee held to evaluate the merger, BofA Merrill Lynch delivered to the Special Committee an oral opinion',\n  'was fair, from a financial point of view, to such holders.'),\n ('X-017', 'The Merger — Opinion of Mac-Gray\\u2019s Financial Advisor', 48,\n  'This analysis indicated the following approximate implied per share equity value reference ranges for Mac-Gray',\n  '21.25'),\n ('X-018', 'Projected Financial Information', 53,\n  'The Projections were prepared in June 2013 in the context of the business, economic, regulatory, market and financial conditions that existed at that time, and have not been updated',\n  'that was not anticipated at the time the projections were prepared.'),\n ('X-019', 'Financing of the Merger', 58,\n  'The merger agreement does not contain any condition to the obligations of the Buyer Entities or Merger Subsidiary relating to the receipt of financing by the Buyer Entities.',\n  'relating to the receipt of financing by the Buyer Entities.'),\n ('X-020', 'Financing of the Merger', 59,\n  'for purposes of funding the merger consideration an aggregate of $594 million of capital (the Pamplona commitment amount)',\n  'provided further that the liability of Buyer Entities shall be unlimited).'),\n ('X-021', 'The Merger Agreement — The Merger Consideration', 60,\n  'Immediately prior to the effective time of the merger, each share of Mac-Gray common stock outstanding immediately prior to the effective time of the merger will be canceled and converted into the right to receive $21.25 in cash, without interest, other than:',\n  'without interest, other than:'),\n ('X-022', 'The Merger Agreement — Non-Solicitation; Competing Acquisition Proposals', 69,\n  'Mac-Gray has agreed that neither Mac-Gray nor any of its subsidiaries will, nor will Mac-Gray authorize or knowingly permit',\n  'be returned or destroyed.'),\n ('X-023', 'The Merger Agreement — Non-Solicitation; Competing Acquisition Proposals', 69,\n  'Notwithstanding the restrictions described above, if, prior to the adoption of the merger agreement by Mac-Gray stockholders, Mac-Gray receives an unsolicited bona fide acquisition',\n  'the failure to take such action would be reasonably likely to be inconsistent with the directors\\u2019 fiduciary duties under applicable laws'),\n ('X-024', 'The Merger Agreement — Termination Fees and Expenses', 80,\n  'then Mac-Gray will pay to Parent the $11 million Mac-Gray termination fee',\n  'on the date that is the first to occur of Mac-Gray'),\n ('X-025', 'The Merger Agreement — Termination Fees and Expenses', 81,\n  'then Parent will pay Mac-Gray the $15 million Parent termination fee, by wire transfer of same-day funds on the first business day following such termination.',\n  'first business day following such termination.'),\n ('X-026', 'The Voting Agreements', 82,\n  'In connection with the execution of the merger agreement, certain stockholders entered into voting agreements with Parent. Approximately 15% of the outstanding Mac-Gray shares on the record date for the special meeting are subject to the voting agreements.',\n  'are subject to the voting agreements.'),\n ('X-027', 'Regulatory Matters', 85,\n  'Parent and Mac-Gray each filed pre-merger notifications with the U.S. antitrust authorities pursuant to the HSR Act on October 29, 2013',\n  'the waiting period expired on November 27, 2013.'),\n ('X-028', 'Litigation Related to the Merger', 85,\n  'On November 21, 2013, a putative class action lawsuit was filed',\n  'attorneys\\u2019 and expert fees and costs.'),\n ('X-029', 'Current Market Price of Common Stock', 89,\n  'The following table sets forth the closing sale prices per share of Mac-Gray common stock',\n  '21.30'),\n ('X-030', 'Security Ownership of Management and Certain Beneficial Owners', 91,\n  'Stewart G. MacDonald, Jr.(3)(4)(5)',\n  'Polaris Capital Management, Inc.(12) 918,488 6.22 %'),\n]\n\ndef find_passage(start, end):\n    for folio, text in comp_text:\n        i = text.find(start)\n        if i >= 0:\n            j = text.find(end, i + len(start))\n            if j >= 0:\n                return folio, text[i:j + len(end)]\n    return None, None\n\nXPASS = []\nfor xid, section, page, start, end in X_DEFS:\n    folio, txt = find_passage(start, end)\n    if txt is None:\n        print('X PASSAGE NOT FOUND:', xid, '| start:', start[:60], '| end:', end[:60])\n        continue\n    XPASS.append({'id': xid, 'section': section, 'page': page, 'text': txt})\n\n# ---------------------------------------------------------------- quote resolution\ndef ascii_norm(s):\n    s = s.replace('\\u2019', \"'\").replace('\\u2018', \"'\").replace('\\u201c', '\"').replace('\\u201d', '\"')\n    s = s.replace('\\u2014', '--').replace('\\u2013', '-').replace('\\xa0', ' ')\n    s = re.sub(r'\\s+', ' ', s)\n    return s.strip()\n\ndef build_index(text):\n    \"\"\"Map normalized positions to raw positions.\"\"\"\n    norm_chars, pos = [], []\n    i = 0\n    while i < len(text):\n        ch = text[i]\n        if ch.isspace():\n            j = i\n            while j < len(text) and text[j].isspace():\n                j += 1\n            norm_chars.append(' ')\n            pos.append((i, j))\n            i = j\n        else:\n            c = ch\n            if c in '\\u2019\\u2018':\n                c = \"'\"\n            elif c in '\\u201c\\u201d':\n                c = '\"'\n            elif c == '\\u2014':\n                c = '--'\n                pos.append((i, i + 1))\n                norm_chars.append('-')\n                pos[-1] = (i, i + 1)\n                norm_chars.append('-')\n                i += 1\n                continue\n            elif c == '\\u2013':\n                c = '-'\n            norm_chars.append(c)\n            pos.append((i, i + 1))\n            i += 1\n    return ''.join(norm_chars), pos\n\ndef resolve(raw_text, quote):\n    nq = ascii_norm(quote)\n    nt, pos = build_index(raw_text)\n    k = nt.find(nq)\n    if k < 0:\n        return None\n    start = pos[k][0]\n    end = pos[k + len(nq) - 1][1]\n    return raw_text[start:end]\n\nSOURCES = {p['id']: p for p in PARAS}\nfor x in XPASS:\n    SOURCES[x['id']] = x\n\ndef q(source_id, quote):\n    src = SOURCES.get(source_id)\n    if src is None:\n        return None, f'unknown source {source_id}'\n    raw = resolve(src['text'], quote)\n    if raw is None:\n        return None, f'quote not found in {source_id}: {quote[:90]}'\n    return raw, None\n\n# ---------------------------------------------------------------- ledger rows\nD = date\nROWS = []\nADD = ROWS.append\n\ndef row(key, when, who, what, process, round_, type_, terms, formality, cond_level,\n        why_parts, count=None, date_from=None, date_to=None, date_basis=None, date_method=None,\n        price_low=None, price_high=None, price_kind=None, price_origin=None, currency=None,\n        all_cash=None, cash_close=None, cond_detail=None, due_date=None, deadline_treatment=None,\n        round_finality=None, decided_by=None, exit_reason=None, outcome_basis=None, page=None,\n        related=None, review=None):\n    ADD(dict(key=key, when=when, who=who, what=what, process=process, round=round_, type=type_,\n             terms=terms, formality=formality, cond_level=cond_level, why_parts=why_parts,\n             count=count, date_from=date_from, date_to=date_to, date_basis=date_basis,\n             date_method=date_method, price_low=price_low, price_high=price_high,\n             price_kind=price_kind, price_origin=price_origin, currency=currency,\n             all_cash=all_cash, cash_close=cash_close, cond_detail=cond_detail,\n             due_date=due_date, deadline_treatment=deadline_treatment,\n             round_finality=round_finality, decided_by=decided_by, exit_reason=exit_reason,\n             outcome_basis=outcome_basis, page=page, related=related, review=review))\n\nCC = 'Fin: {}; DD required: {}; DD open: {}; Excl: {}'\n\n# 1\nrow('boA2012_engage', '10/23/2012', 'BofA Merrill Lynch (financial adviser, Mac-Gray)', 'Adviser engaged',\n    None, 0, None,\n    'Engaged by Mac-Gray for the 2011-2012 Discussions — the possible acquisition of CSC by Mac-Gray (target-as-acquirer mandate); pre-process context, not a sale of Mac-Gray.',\n    None, None,\n    [('Stated engagement', [('P-002', 'Mac-Gray engaged BofA Merrill Lynch on October 23, 2012')])],\n    date_from=D(2012,10,23), date_to=D(2012,10,23), date_basis='Reported day', date_method='Reported',\n    page=27, related='R006; R007 (later mandates)')\n\n# 2\nrow('apr5', '04/05/2013', 'Mac-Gray Board of Directors', 'Target sale decision', 1, 0, None,\n    'Board reviewed the completed CSC sale to Pamplona and industry M&A activity; authorized management to work with BofA Merrill Lynch on transactional opportunities, including with strategic party \"Party A\"; deferred further consideration to the 05/09/2013 meeting.',\n    None, None,\n    [('Stated decision', [('P-003', 'authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities that might be available to Mac-Gray, including opportunities with another strategic party, whom we refer to as Party A')]),\n     ('Deferral', [('P-003', 'The Board also determined to further consider Mac-Gray\\u2019s strategic alternatives at its meeting scheduled for May 9, 2013')])],\n    date_from=D(2013,4,5), date_to=D(2013,4,5), date_basis='Reported day', date_method='Reported',\n    page=27, related='R011 (rejected R1 boundary candidate)', review='Q1')\n\n# 3\nrow('apr8', '04/08/2013', 'Party A (potential strategic acquirer)', 'Target interest', 1, 0, 'Strategic',\n    'BofA Merrill Lynch, on the Board\\u2019s instruction, telephoned Party A about a possible business combination; Party A indicated it might consider one. First sale-related contact with Party A. Party A is inside the 15 potential strategic buyers contacted in the June 24 wave (R012, Count 15), which already counts it; Count 0 avoids double counting.',\n    None, None,\n    [('Stated contact and receptiveness', [('P-004', 'representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray. During this call, the representative of Party A indicated that Party A might consider a business combination with Mac-Gray')]),\n     ('Party A is one of the 15 strategic parties in the June 24 wave', [('P-022', '50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray, 15 of which were potential strategic buyers')])],\n    count=0, date_from=D(2013,4,8), date_to=D(2013,4,8), date_basis='Reported day', date_method='Reported',\n    page=27, related='R012 (cohort contains Party A); R009 (Party A June 21 proposal)', review='Q3')\n\n# 4\nrow('may9_board', '05/09/2013', 'Mac-Gray Board of Directors', 'Target decision', 1, 0, None,\n    'Board discussed whether to approach third parties about a potential sale; formed the Transaction Committee (Thomas Bullock and Paul Daoust) to recommend and engage a financial adviser; concluded to revisit the review at its next meeting.',\n    None, None,\n    [('Stated discussion', [('P-006', 'the Board engaged in a general discussion concerning whether it might be advisable to approach and discuss a potential sale transaction with third parties at this time as a means by which to deliver value to the stockholders of Mac-Gray')]),\n     ('Transaction Committee formed', [('P-007', 'the Board formed a transaction committee at this meeting, which we refer to as the Transaction Committee, and appointed Thomas Bullock and Paul Daoust, both independent directors, to serve as its members')]),\n     ('Deferral', [('P-007', 'The Board concluded that it would discuss the review of strategic alternatives, including engaging in a potential sale process, at its next meeting')])],\n    date_from=D(2013,5,9), date_to=D(2013,5,9), date_basis='Reported day', date_method='Reported',\n    page=28, related='R007', review='Q1')\n\n# 5\nrow('goodwin', '05/09/2013', 'Goodwin Procter LLP (outside legal counsel, Mac-Gray)', 'Adviser service observed',\n    1, 0, None,\n    'Goodwin Procter LLP, outside legal counsel to Mac-Gray, first shown acting on the strategic-alternatives mandate at the May 9, 2013 Board meeting (fiduciary-duty overview); engagement date and engagement letter not disclosed.',\n    None, None,\n    [('Earliest observed service', [('P-005', 'representatives from BofA Merrill Lynch and Goodwin Procter LLP, outside legal counsel to Mac-Gray, were also in attendance for all or portions of the meeting')]),\n     ('Fiduciary overview and further service', [('P-007', 'a representative of Goodwin Procter provided an overview of the Board\\u2019s fiduciary duties')])],\n    date_from=D(2013,5,9), date_to=D(2013,5,9), date_basis='Reported day', date_method='Reported',\n    page=27, related='R004')\n\n# 6\nrow('boA2012_end', '05/15/2013', 'BofA Merrill Lynch (financial adviser, Mac-Gray)', 'Adviser ended',\n    None, 0, None,\n    'Termination of the 10/23/2012 engagement for the 2011-2012 Discussions: Transaction Committee determined to terminate on 05/14/2013; letter sent 05/15/2013. BofA Merrill Lynch was simultaneously a candidate for the new strategic-alternatives mandate.',\n    None, None,\n    [('Stated determination and letter', [('P-009', 'the Transaction Committee determined to terminate BofA Merrill Lynch\\u2019s engagement letter entered into for purposes of the 2011-2012 Discussions'),\n                                          ('P-010', 'On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions')])],\n    date_from=D(2013,5,15), date_to=D(2013,5,15), date_basis='Reported day', date_method='Reported',\n    page=29, related='R001; R007')\n\n# 7\nrow('boA_engage', '05/30/2013 (Board approval) \\u2013 05/31/2013 (engagement letter)',\n    'BofA Merrill Lynch (financial adviser, Mac-Gray)', 'Adviser engaged', 1, 0, None,\n    'Board unanimously approved engaging BofA Merrill Lynch as financial adviser for the strategic-alternatives review (three banks invited 05/10/2013; presentations 05/22 and 05/29/2013); engagement letter entered 05/31/2013, including a restriction on BofA Merrill Lynch sourcing buyer acquisition financing without Mac-Gray\\u2019s prior written consent.',\n    None, None,\n    [('Selection process', [('P-008', 'determined to invite three nationally recognized investment banks to submit proposals')]),\n     ('Board approval', [('P-014', 'Based on the recommendation of the Transaction Committee, the Board unanimously approved the engagement of BofA Merrill Lynch on the terms discussed at this meeting')]),\n     ('Engagement letter and restriction', [('P-016', 'On May 31, 2013, Mac-Gray entered into an engagement letter with BofA Merrill Lynch with respect to the Board\\u2019s undertaking a review of strategic alternatives, including a potential sale process, and in which BofA Merrill Lynch agreed not to engage as a possible source of new acquisition financing for any potential buyers in connection with any such sale process without Mac-Gray\\u2019s prior written consent')])],\n    date_from=D(2013,5,30), date_to=D(2013,5,31), date_basis='Reported interval', date_method='Assigned: bound',\n    page=29, related='R004; R006', review='Q1')\n\n# 8\nrow('annual_mtg', '05/30/2013', 'Moab Partners, L.P. and affiliates (activist stockholder); Mac-Gray', 'Activist involvement',\n    1, 0, None,\n    'Moab\\u2019s proxy contest: Moab-nominated Michael M. Rothenberg (Moab co-founder and General Partner) and James E. Hyman elected as directors in place of incumbent nominees; Board size reduced to seven; Moab held approximately 9% of shares. Rothenberg was later excluded from the sale-process evaluation because Moab sought a possible equity rollover (R010, R016).',\n    None, None,\n    [('Stated election and proxy contest', [('P-015', 'the Mac-Gray stockholders elected as directors Michael M. Rothenberg and James E. Hyman, candidates nominated by Mac-Gray\\u2019s stockholder, Moab Partners, L.P. and certain of its affiliates, which we refer collectively to as Moab. Mac-Gray and Moab engaged in a proxy contest leading up to the annual meeting')]),\n     ('Moab stake at the June 12 orientation', [('P-017', 'At the time of this meeting, Moab beneficially owned approximately 9% of Mac-Gray\\u2019s outstanding common stock')])],\n    date_from=D(2013,5,30), date_to=D(2013,5,30), date_basis='Reported day', date_method='Reported',\n    page=29, related='R010; R016')\n\n# 9\nrow('partyA_jun21', '06/21/2013', 'Party A (potential strategic acquirer)', 'Bid', 1, 0, 'Strategic',\n    'Unsolicited all-cash proposal to purchase Mac-Gray at $17.00\\u2013$19.00 per share. Made before any NDA or substantive diligence access (NDA signed 08/05/2013, R027); first contact was the 04/08/2013 call (R003). Still standing when round 1 was evaluated, so Party A counts as a round-1 participant although this bid row sits in round 0.',\n    'Informal', 'Heavy',\n    [('Stated proposal', [('P-018', 'On June 21, 2013, Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share, which we refer to as the Party A June 21 proposal')]),\n     ('No formal signal and no substantive access yet', [('P-030', 'outside counsel to Party A and representatives of Goodwin Procter negotiated the terms of a confidentiality and standstill agreement, but did not come to agreement on the terms of the customer and employee non-solicitation provisions')])],\n    count=1, date_from=D(2013,6,21), date_to=D(2013,6,21), date_basis='Reported day', date_method='Reported',\n    price_low=17.0, price_high=19.0, price_kind='Bidder range', price_origin='Stated', currency='USD',\n    all_cash='Yes', cond_detail=CC.format('not stated','not stated','no','not stated'),\n    page=30, related='R003 (first contact); R012/R011 (round-1 participation); R027 (NDA)', review='Q4')\n\n# 10\nrow('jun24_board', '06/24/2013', 'Mac-Gray Board of Directors', 'Target decision', 1, 0, None,\n    'Board established the Special Committee of six independent and disinterested directors (Bullock, Daoust, Hyman, Meagher, Percelay, Robinson; Bullock chairman) and excluded Mr. MacDonald and Mr. Rothenberg from the Board\\u2019s evaluation of strategic alternatives because they could be asked to partner with a potential acquirer; Transaction Committee became a sub-committee.',\n    None, None,\n    [('Stated establishment', [('P-019', 'the Board then established the Special Committee, comprised of the six independent and disinterested members of the Board (namely, Mr. Bullock, Mr. Daoust, Mr. Hyman, William F. Meagher, Bruce A. Percelay and Alastair G. Robinson)')]),\n     ('Exclusions', [('P-019', 'the Board decided, and Mr. MacDonald and Mr. Rothenberg agreed, that it would be appropriate to exclude Mr. MacDonald and Mr. Rothenberg from the Board\\u2019s evaluation of strategic alternatives and any negotiations with third parties that might take place')])],\n    date_from=D(2013,6,24), date_to=D(2013,6,24), date_basis='Reported day', date_method='Reported',\n    page=30, related='R011', review='Q1')\n\n# 11\nrow('r1_open', '06/24/2013', 'Mac-Gray Special Committee', 'Round opened', 1, 1, None,\n    'R1 anchor: Special Committee\\u2019s 06/24/2013 determination to consider a potential sale and to approach 50 parties (15 potential strategic buyers; 35 potential financial buyers), executed by BofA Merrill Lynch outreach beginning within days (first NDA 06/28/2013). Other candidate anchors: R002 (04/05/2013 authorization), R003 (04/08/2013 Party A call), R007 (05/31/2013 engagement letter), R012\\u2013R013 (first outreach wave), R014 (06/28/2013 first NDA). Purpose: solicit preliminary indications of interest, with packages furnished to NDA signers and IOIs instructed by 07/23/2013 (R017). Round-1 participant set: Party A (round-0 proposal standing, R009), Party B, Party C, CSC/Pamplona.',\n    None, None,\n    [('Stated determination and approach scope', [('P-022', 'the Special Committee concluded that it would be in the best interests of stockholders to consider a potential sale of Mac-Gray'),\n       ('P-022', 'the Special Committee determined to approach a total of 50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray, 15 of which were potential strategic buyers and 35 of which were potential financial buyers, including private equity firms')])],\n    date_from=D(2013,6,24), date_to=D(2013,6,24), date_basis='Reported day', date_method='Reported',\n    round_finality='Not final',\n    page=31, related='R009; R010; R002; R003; R007; R012\\u2013R014', review='Q1')\n\n# 12\nrow('r1_contact_str', 'after 06/24/2013; late June through August 2013 (individual contact dates not disclosed)',\n    'Mac-Gray (via BofA Merrill Lynch) \\u2192 15 potential strategic buyers', 'Contact', 1, 1, 'Strategic',\n    'Outreach to the 15 potential strategic buyers identified at the June 24 Special Committee meeting, in accordance with its directives. Parties contacted include Party A (first contacted 04/08/2013, R003 \\u2014 Count 0 there) and CSC/Pamplona. Count 15 = the cohort as described; treated as a single contact wave.',\n    None, None,\n    [('Stated outreach', [('P-023', 'During the next several weeks, in accordance with the directives of the Special Committee, BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting')]),\n     ('Cohort size and composition', [('P-022', '15 of which were potential strategic buyers')])],\n    count=15, date_from=D(2013,6,24), date_to=D(2013,8,27), date_basis='Approximate window', date_method='Assigned: bound',\n    page=32, related='R003 (Party A, Count 0 there); R011; R013', review='Q3; Q7')\n\n# 13\nrow('r1_contact_fin', 'after 06/24/2013; late June through August 2013 (individual contact dates not disclosed)',\n    'Mac-Gray (via BofA Merrill Lynch) \\u2192 35 potential financial buyers', 'Contact', 1, 1, 'Financial',\n    'Outreach to the 35 potential financial buyers including private equity firms, in accordance with the Special Committee\\u2019s directives. Includes Party B and Party C, later recorded individually at the NDA stage. Count 35 = the cohort as described.',\n    None, None,\n    [('Stated outreach', [('P-023', 'BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting')]),\n     ('Cohort size and composition', [('P-022', '35 of which were potential financial buyers, including private equity firms')])],\n    count=35, date_from=D(2013,6,24), date_to=D(2013,8,27), date_basis='Approximate window', date_method='Assigned: bound',\n    page=32, related='R011; R012', review='Q3; Q7')\n\n# 14\nrow('nda_partyB', '06/28/2013', 'Party B (financial bidder)', 'NDA signed', 1, 1, 'Financial',\n    'Executed a confidentiality and standstill agreement with Mac-Gray on Mac-Gray\\u2019s form (individually negotiated; no material variances) and received the informational package; standstill carried a sunset allowing confidential proposals on announcement of a business combination or change of control.',\n    None, None,\n    [('Stated execution and package', [('P-026', 'Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party B with data to formulate a preliminary indication of interest')]),\n     ('Form and standstill terms', [('P-023', 'entered into confidentiality agreements with Mac-Gray on a form provided by Mac-Gray, the terms of which were individually negotiated with potential bidders, but did not vary materially from the form provided')])],\n    count=1, date_from=D(2013,6,28), date_to=D(2013,6,28), date_basis='Reported day', date_method='Reported',\n    page=32)\n\n# 15\nrow('nda_partyC', '06/30/2013', 'Party C (financial bidder)', 'NDA signed', 1, 1, 'Financial',\n    'Executed a confidentiality and standstill agreement with Mac-Gray and received the informational package on the same basis as the other signers.',\n    None, None,\n    [('Stated execution and package', [('P-027', 'On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party C with data to formulate a preliminary indication of interest')])],\n    count=1, date_from=D(2013,6,30), date_to=D(2013,6,30), date_basis='Reported day', date_method='Reported',\n    page=32)\n\n# 16\nrow('jul6_rollover', '07/06/2013', 'Mac-Gray Special Committee; Moab Partners (via Mr. Rothenberg); CSC/Pamplona', 'Material process update',\n    1, 1, None,\n    'Moab rollover request denied as premature: Mr. Rothenberg had asked that CSC/Pamplona be allowed to share bid and evaluation material with Moab, with Moab exclusively engaged with CSC/Pamplona; the Special Committee denied exclusivity so that Moab\\u2019s stake could remain available as capital for other bidders, and said rollover discussions would be permitted at a later stage.',\n    None, None,\n    [('Stated request', [('P-027', 'Mr. Rothenberg also informed Goodwin Procter that Pamplona would be requesting that any confidentiality agreement CSC/Pamplona execute with Mac-Gray permit CSC and Pamplona to discuss their bid and evaluation material with Moab, with Moab agreeing to exclusively engage with CSC/Pamplona')]),\n     ('Stated denial and rationale', [('P-028', 'the Special Committee decided to deny the exclusivity request at this stage of the process so that the potential equity rollover of Moab\\u2019s shares could be available as a source of capital for other potential bidders')]),\n     ('Deferral', [('P-028', 'it was premature for Mac-Gray to permit Moab to engage in equity rollover discussions with any party, including CSC/Pamplona, but that such discussions would be permitted at a later stage of the sale process')])],\n    date_from=D(2013,7,6), date_to=D(2013,7,6), date_basis='Reported day', date_method='Reported',\n    page=32, related='R049 (resolution); R010', review='Q6')\n\n# 17\nrow('deadline_set_0723', 'between 06/28/2013 and 07/23/2013 (communication date not disclosed)',\n    'Mac-Gray (informational package) \\u2192 NDA signers', 'Deadline set', 1, 1, None,\n    'Informational-package letter instructed NDA signers to submit preliminary indications of interest by 07/23/2013, addressing valuation, sources and structures of financing, material conditions (including required approvals) and due-diligence focus areas. Communication date not disclosed: the package was furnished to each party as it signed; first signer 06/28/2013.',\n    None, None,\n    [('Stated instruction', [('P-023', 'Parties that had entered into confidentiality and standstill agreements with Mac-Gray were furnished an informational package for the purpose of providing potential bidders with data to formulate a preliminary indication of interest, which they were instructed to submit by July 23, 2013')]),\n     ('Requested proposal content', [('P-023', 'The letter requested that the proposals address, among other things, valuation, sources and structures of financing, material conditions, including required approvals, and focus areas for due diligence')])],\n    date_from=D(2013,6,28), date_to=D(2013,7,23), date_basis='Approximate window', date_method='Assigned: midpoint',\n    due_date=D(2013,7,23), page=32, related='R020 (due date reached)', review='Q2; Q7')\n\n# 18\nrow('nda_csc', '07/11/2013', 'CSC/Pamplona (strategic bidder)', 'NDA signed', 1, 1, 'Strategic',\n    'CSC and Pamplona entered into a confidentiality and standstill agreement with Mac-Gray jointly (one bidder unit) and received the informational package.',\n    None, None,\n    [('Stated execution and package', [('P-029', 'On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package for the purpose of providing CSC/Pamplona with data to formulate a preliminary indication of interest')])],\n    count=1, date_from=D(2013,7,11), date_to=D(2013,7,11), date_basis='Reported day', date_method='Reported',\n    page=33)\n\n# 19 residual NDA cohort\nrow('nda_residual16', 'late June through late August 2013 (individual dates not disclosed)',\n    '16 remaining financial bidders (residual cohort)', 'NDA signed', 1, 1, 'Financial',\n    'Residual cohort: 20 potential bidders signed confidentiality and standstill agreements over roughly two months; four are individually recorded (Party A 08/05/2013, Party B 06/28/2013, Party C 06/30/2013, CSC/Pamplona 07/11/2013) and the remaining 16 signers are represented by this one cohort row. The cohort\\u2019s Working date is moved earlier to 07/23/2013 (inside its window) so that it precedes its inferred non-submission row (R021) \\u2014 Assigned: sequence.',\n    None, None,\n    [('Stated total and split', [('P-023', 'Over the next two months a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray')])],\n    count=16, date_from=D(2013,6,24), date_to=D(2013,8,27), date_basis='Approximate window', date_method='Assigned: sequence',\n    page=32, related='R014; R015; R018; R027; R021 (inferred non-submission)', review='Q3; Q7')\n\n# 20\nrow('deadline_0723', '07/23/2013', 'N/A \\u2014 solicitation deadline', 'Deadline', 1, 1, None,\n    'Preliminary-indication due date reached. CSC/Pamplona submitted on 07/23/2013; Party B submitted 07/24/2013 and Party C 07/24\\u201307/25/2013, and the Special Committee reviewed all of them on 07/25/2013 with no revision of the due date. Treatment: Late bids accepted.',\n    None, None,\n    [('Due date', [('P-023', 'instructed to submit by July 23, 2013')]),\n     ('Late submissions considered', [('P-033', 'On July 25, 2013, the Board held a regularly scheduled in-person meeting'),\n       ('P-034', 'representatives of BofA Merrill Lynch reviewed the preliminary indications of interest received from Party B, Party C and CSC/Pamplona as well as the Party A June 21 proposal')])],\n    date_from=D(2013,7,23), date_to=D(2013,7,23), date_basis='Reported day', date_method='Reported',\n    due_date=D(2013,7,23), deadline_treatment='Late bids accepted',\n    page=32, related='R017', review='Q2')\n\n# 21 residual did not submit\nrow('dns_residual16', 'by 07/23/2013 (solicitation due date passed with no submission)',\n    '16 remaining financial bidders (residual cohort)', 'Did not submit', 1, 1, 'Financial',\n    'Inferred: residual \\u2014 20 NDA signers \\u2212 4 individually recorded signers (Party A, Party B, Party C, CSC/Pamplona) = 16 remaining signers, all financial; none is reported to have submitted a July 23 indication. Base assumes each of the 20 signers was covered by the July 23 solicitation; if any signed later than that deadline, the non-submitting set is smaller (flagged in Q3). Inferred from arithmetic only \\u2014 no dates, motives or identities inferred.',\n    None, None,\n    [('Base population', [('P-023', 'a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray')]),\n     ('Continuing set named at the next transition', [('P-034', 'reach out to each of the four interested bidders and arrange management meetings')]),\n     ('Solicitation due date', [('P-023', 'instructed to submit by July 23, 2013')])],\n    count=16, date_from=None, date_to=D(2013,7,23), date_basis='Relative only', date_method='Assigned: deadline',\n    decided_by='Unknown', exit_reason='Not stated', outcome_basis='Inferred: residual',\n    page=32, related='R019 (entry); R020', review='Q3')\n\n# 22\nrow('bid_csc_jul23', '07/23/2013', 'CSC/Pamplona (strategic bidder)', 'Bid', 1, 1, 'Strategic',\n    'Preliminary indication of interest: all-cash $18.50 per share, submitted on the 07/23/2013 due date after a preliminary review (07/11\\u201307/23) but before data-room or management access; financing not described at this stage.',\n    'Informal', 'Heavy',\n    [('Stated indication', [('P-031', 'On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share')]),\n     ('Substantive access not yet given', [('P-030', 'Between July 11, 2013 and July 23, 2013, Party B, Party C and CSC/Pamplona engaged in a preliminary review of Mac-Gray and the potential acquisition opportunity')])],\n    count=1, date_from=D(2013,7,23), date_to=D(2013,7,23), date_basis='Reported day', date_method='Reported',\n    price_low=18.50, price_high=18.50, price_kind='Point', price_origin='Stated', currency='USD',\n    all_cash='Yes', cash_close=18.50, cond_detail=CC.format('not stated','not stated','yes','not stated'),\n    page=33, related='R030 (Sept 9 revision); R037; R042', review='Q4')\n\n# 23\nrow('bid_partyB_jul24', '07/24/2013', 'Party B (financial bidder)', 'Bid', 1, 1, 'Financial',\n    'Preliminary indication of interest: all-cash $17.00\\u2013$18.00 per share, submitted one day after the 07/23/2013 instruction and considered at the 07/25/2013 Special Committee meeting.',\n    'Informal', 'Heavy',\n    [('Stated indication', [('P-032', 'On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share')])],\n    count=1, date_from=D(2013,7,24), date_to=D(2013,7,24), date_basis='Reported day', date_method='Reported',\n    price_low=17.0, price_high=18.0, price_kind='Bidder range', price_origin='Stated', currency='USD',\n    all_cash='Yes', cond_detail=CC.format('not stated','not stated','yes','not stated'),\n    page=33, related='R031 (Sept 9 revision)', review='Q4')\n\n# 24\nrow('bid_partyC_jul24', '07/24/2013 (oral indication) \\u2013 07/25/2013 (written indication)',\n    'Party C (financial bidder)', 'Bid', 1, 1, 'Financial',\n    'One bid, two communications: an oral preliminary indication on 07/24/2013 at $15.00\\u2013$17.00 per share, then a written indication on 07/25/2013 at $16.00\\u2013$16.50 per share. Recorded as a single bid under the one-communication convention; the written range is recorded in the price cells and both values are stated here. All-cash; financing not described.',\n    'Informal', 'Heavy',\n    [('Oral indication', [('P-032', 'representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share')]),\n     ('Written indication', [('P-035', 'Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share')])],\n    count=1, date_from=D(2013,7,24), date_to=D(2013,7,25), date_basis='Reported interval', date_method='Assigned: bound',\n    price_low=16.0, price_high=16.50, price_kind='Bidder range', price_origin='Stated', currency='USD',\n    all_cash='Yes', cond_detail=CC.format('not stated','not stated','yes','not stated'),\n    page=33, related='R033 (Sept 10 revision)', review='Q5; Q7')\n\n# 25\nrow('jul25_decision', '07/25/2013', 'Mac-Gray Special Committee', 'Target decision', 1, 1, None,\n    'Preliminary indications judged lower than expected; the Special Committee advanced the four interested bidders (Party A, Party B, Party C, CSC/Pamplona) to a second stage \\u2014 staged information disclosure and management meetings \\u2014 to drive improved offers. The Special Committee also directed that Mr. Rothenberg recuse himself from Board meetings for the duration of the sale process (Moab rollover conflict).',\n    None, None,\n    [('Advancement decision', [('P-035', 'the Special Committee authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure as discussed at this meeting and to reach out to each of the four interested bidders and arrange management meetings')]),\n     ('Recusal', [('P-033', 'The Special Committee then discussed the potential conflict of interest arising from Moab\\u2019s continuing desire to consider an equity rollover and decided that Mr. Rothenberg should be asked to recuse himself from participating in Board meetings for the duration of the sale process')])],\n    date_from=D(2013,7,25), date_to=D(2013,7,25), date_basis='Reported day', date_method='Reported',\n    page=34, related='R026; R011', review='Q1')\n\n# 26\nrow('jul25_access', '07/25/2013 (decision); implemented 08/06/2013\\u201308/27/2013',\n    'Mac-Gray Special Committee; Party A, Party B, Party C, CSC/Pamplona', 'Information access changed',\n    1, 1, None,\n    'Differentiated (tiered) access among live bidders: Party B and Party C, as financial bidders, were given broad access to the electronic data site; Party A and CSC/Pamplona, as strategic bidders, were given somewhat limited access, with customer data (including customer locations) withheld until a later stage; management presentations were held for all four bidders (08/06, 08/08, 08/12, 08/14). Stated rationale: concern over access to and potential misuse of sensitive competitive information, especially by strategic bidders; staging by demonstrated seriousness.',\n    None, None,\n    [('Stated access split and withholding', [('P-042', 'Party B and Party C, in light of the fact that they were financial bidders, were given broad access to an electronic data site, and Party A and CSC/Pamplona, in light of the fact that they were strategic bidders, were given somewhat limited access to this electronic data site, with access to customer data, including customer locations, being reserved until later in the process as part of the staging discussed at the July 25 th Special Committee meeting')]),\n     ('Stated rationale', [('P-034', 'expressed concern over permitting access to and the potential misuse of sensitive and competitive information, including customer terms and locations, especially by strategic bidders')]),\n     ('Presentations for all four', [('P-036', 'On August 6, 2013, representatives of Party B attended a management presentation'),\n       ('P-040', 'On August 14, 2013, representatives of Party A attended a management presentation at the Boston office of Goodwin Procter')])],\n    date_from=D(2013,7,25), date_to=D(2013,7,25), date_basis='Reported day', date_method='Reported',\n    page=34, related='R025')\n\n# 27\nrow('nda_partyA', '08/05/2013', 'Party A (strategic bidder)', 'NDA signed', 1, 1, 'Strategic',\n    'Executed after NDA negotiations stalled over customer and employee non-solicitation provisions; discussions resumed 07/27/2013 (the filing states \"July 27, 2103\" \\u2014 source typo; intended 2013) and the agreement was executed 08/05/2013; informational package furnished so Party A could potentially improve its June 21 proposal.',\n    None, None,\n    [('Stated execution', [('P-036', 'On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package for the purpose of providing Party A with data to potentially improve the terms of the Party A June 21 proposal')]),\n     ('Stalled negotiation and source typo retained', [('P-036', 'Discussions with Party A resumed on July 27, 2103 and Party A and the Transaction Committee agreed to the terms of the customer and employee non-solicitation provisions'),\n       ('P-030', 'did not come to agreement on the terms of the customer and employee non-solicitation provisions')])],\n    count=1, date_from=D(2013,8,5), date_to=D(2013,8,5), date_basis='Reported day', date_method='Reported',\n    page=34)\n\n# 28\nrow('r2_open', '08/27/2013', 'Mac-Gray (BofA Merrill Lynch) \\u2192 Party A, Party B, Party C, CSC/Pamplona', 'Round opened',\n    1, 2, None,\n    'Second-stage solicitation: letter to all four bidders once all four\\u2019s diligence was substantially complete, instructing revised written proposals no later than 09/09/2013 to continue to in-depth evaluation and confirmatory due diligence, addressing valuation, financing, regulatory approvals, post-signing covenants and diligence focus. Authorized at the 08/15/2013 Special Committee meeting; same-day follow-up diligence call with Party B. Round finality: Not final.',\n    None, None,\n    [('Stated authorization', [('P-041', 'the Special Committee authorized and instructed BofA Merrill Lynch to send a letter to each of Party A, Party B, Party C and CSC/Pamplona once all four of the bidders\\u2019 due diligence was substantially complete requesting that, in light of the results of the respective party\\u2019s due diligence, such party submit a revised written proposal in order to continue in the process, including to engage in more in-depth and confirmatory due diligence of Mac-Gray')]),\n     ('Stated letter and deadline', [('P-043', 'On August 27, 2013, BofA Merrill Lynch, as instructed by the Special Committee, sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013 if such bidders wished to proceed further in the process to pursue an in-depth evaluation of Mac-Gray with the objective of making a revised offer')])],\n    date_from=D(2013,8,27), date_to=D(2013,8,27), date_basis='Reported day', date_method='Reported',\n    due_date=D(2013,9,9), round_finality='Not final',\n    page=35, related='R025; R029', review='Q1')\n\n# 29\nrow('deadline_0909', '09/09/2013', 'N/A \\u2014 solicitation deadline', 'Deadline', 1, 2, None,\n    'Revised-proposal due date reached. CSC/Pamplona and Party B submitted on 09/09/2013; Party A and Party C submitted revised indications on 09/10/2013 and were reviewed at the 09/11/2013 Special Committee meeting with no revision of the due date. Treatment: Late bids accepted.',\n    None, None,\n    [('Due date and on-time submissions', [('P-043', 'instructing such bidders to submit revised written proposals no later than September 9, 2013'),\n       ('P-047', 'On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share')]),\n     ('Late submissions reviewed', [('P-048', 'On September 10, 2013, Party A submitted a revised indication of interest'),\n       ('P-050', 'the Special Committee held a telephonic meeting to review the revised indications of interest submitted by Party A, Party B, Party C and CSC/Pamplona')])],\n    date_from=D(2013,9,9), date_to=D(2013,9,9), date_basis='Reported day', date_method='Reported',\n    due_date=D(2013,9,9), deadline_treatment='Late bids accepted',\n    page=35, related='R028', review='Q2')\n\n# 30\nrow('bid_csc_sep9', '09/09/2013', 'CSC/Pamplona (strategic bidder)', 'Bid', 1, 2, 'Strategic',\n    'Revised indication of interest: all-cash $19.50 per share; Pamplona indicated it was committed to provide 100% of the capital required; CSC/Pamplona requested a two-week exclusive negotiation.',\n    'Informal', 'Light',\n    [('Stated indication and committed capital', [('P-047', 'On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share, indicating that Pamplona was committed to provide 100% of the capital required to consummate the transaction and requesting that CSC/Pamplona and Mac-Gray agree to exclusive negotiations for two weeks')]),\n     ('Diligence still running', [('P-052', 'Between September 11, 2013 and September 18, 2013, Party A, Party B, Party C and CSC/Pamplona continued to conduct business and legal due diligence')])],\n    count=1, date_from=D(2013,9,9), date_to=D(2013,9,9), date_basis='Reported day', date_method='Reported',\n    price_low=19.50, price_high=19.50, price_kind='Point', price_origin='Stated', currency='USD',\n    all_cash='Yes', cash_close=19.50, cond_detail=CC.format('committed','not stated','yes','requested (2 wks)'),\n    page=35, related='R037 (Sept 18 revision)', review='Q4')\n\n# 31\nrow('bid_partyB_sep9', '09/09/2013', 'Party B (financial bidder)', 'Bid', 1, 2, 'Financial',\n    'Revised indication of interest: all-cash $18.50 per share, proposed to be financed with equity from