lace').read()\\nfolios = re.findall(r\\\"FOLIO='([^']*)'\\\", html)\\nprint(\\\"folio count:\\\", len(folios))\\nprint(collections.Counter(folios).most_common(20))\\n# Find SEQ and EFW patterns\\nseqs = re.findall(r\\\"ZEQ\\\\.=(\\\\d+),SEQ=(\\\\d+)\\\", html)\\nprint(\\\"seq samples:\\\", seqs[:5], seqs[-5:], len(seqs))\\nEOF\", \"workdir\": \"/home/uctpiaj/work\"}"},"time":{"start":1789824276569,"end":1789824277148}}}}
