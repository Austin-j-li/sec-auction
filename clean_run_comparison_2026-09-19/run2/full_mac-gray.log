{"type":"tool_use","timestamp":1789825198633,"sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","part":{"partID":"prt_0b9e448f8001df8arBWqQLp5vp","sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","messageID":"msg_0b9e393da001m1sk4t9Bak1cdt","type":"tool","id":"call_00_f4lkt7TZgtiLPNnVNHFj7957","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Write extraction/mac-gray.xlsx from /tmp/opencode/ledger_data.json.\"\"\"\nimport json, re\nfrom datetime import date, datetime, timedelta\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.properties import WorksheetProperties  # noqa\n\nDATA = json.load(open('/tmp/opencode/ledger_data.json'))\nROWS = DATA['rows']\nPARAS = DATA['paras']\nXPASS = DATA['xpass']\nOUT = 'extraction/mac-gray.xlsx'\n\n# ------------------------------------------------------------------ helpers\ndef d(s):\n    if not s:\n        return None\n    y, m, dd = [int(x) for x in str(s)[:10].split('-')]\n    return date(y, m, dd)\n\nWORKING = {\n 'boA2012_engage': (date(2012,10,23), 'Reported'),\n 'apr5': (date(2013,4,5), 'Reported'),\n 'apr8': (date(2013,4,8), 'Reported'),\n 'may9_board': (date(2013,5,9), 'Reported'),\n 'goodwin': (date(2013,5,9), 'Reported'),\n 'boA2012_end': (date(2013,5,15), 'Reported'),\n 'boA_engage': (date(2013,5,30), 'Assigned: bound'),\n 'annual_mtg': (date(2013,5,30), 'Reported'),\n 'partyA_jun21': (date(2013,6,21), 'Reported'),\n 'jun24_board': (date(2013,6,24), 'Reported'),\n 'r1_open': (date(2013,6,24), 'Reported'),\n 'r1_contact_str': (date(2013,6,24), 'Assigned: bound'),\n 'r1_contact_fin': (date(2013,6,24), 'Assigned: bound'),\n 'nda_partyB': (date(2013,6,28), 'Reported'),\n 'nda_partyC': (date(2013,6,30), 'Reported'),\n 'jul6_rollover': (date(2013,7,6), 'Reported'),\n 'deadline_set_0723': (date(2013,7,10), 'Assigned: midpoint'),\n 'nda_csc': (date(2013,7,11), 'Reported'),\n 'nda_residual16': (date(2013,7,23), 'Assigned: sequence'),\n 'deadline_0723': (date(2013,7,23), 'Reported'),\n 'dns_residual16': (date(2013,7,23), 'Assigned: deadline'),\n 'bid_csc_jul23': (date(2013,7,23), 'Reported'),\n 'bid_partyB_jul24': (date(2013,7,24), 'Reported'),\n 'bid_partyC_jul24': (date(2013,7,24), 'Assigned: bound'),\n 'jul25_decision': (date(2013,7,25), 'Reported'),\n 'jul25_access': (date(2013,7,25), 'Reported'),\n 'nda_partyA': (date(2013,8,5), 'Reported'),\n 'r2_open': (date(2013,8,27), 'Reported'),\n 'deadline_0909': (date(2013,9,9), 'Reported'),\n 'bid_csc_sep9': (date(2013,9,9), 'Reported'),\n 'bid_partyB_sep9': (date(2013,9,9), 'Reported'),\n 'bid_partyA_sep10': (date(2013,9,10), 'Reported'),\n 'bid_partyC_sep10': (date(2013,9,10), 'Reported'),\n 'macdonald_brief': (date(2013,9,11), 'Assigned: bound'),\n 'r3_open': (date(2013,9,11), 'Reported'),\n 'deadline_0918': (date(2013,9,18), 'Reported'),\n 'bid_csc_sep18': (date(2013,9,18), 'Reported'),\n 'bid_partyA_sep18': (date(2013,9,18), 'Reported'),\n 'bid_partyB_sep18': (date(2013,9,18), 'Reported'),\n 'dns_partyC': (date(2013,9,18), 'Assigned: deadline'),\n 'sep19_decision': (date(2013,9,19), 'Reported'),\n 'bid_csc_sep21': (date(2013,9,21), 'Reported'),\n 'sep23_excl_auth': (date(2013,9,23), 'Reported'),\n 'sep24_excl_exec': (date(2013,9,24), 'Reported'),\n 'dropped_partyA': (date(2013,9,24), 'Assigned: decision day'),\n 'dropped_partyB': (date(2013,9,24), 'Assigned: decision day'),\n 'r4_open': (date(2013,9,24), 'Reported'),\n 'kirkland': (date(2013,9,25), 'Reported'),\n 'rollover_resolve': (date(2013,10,7), 'Assigned: bound'),\n 'oct9_excl_auth': (date(2013,10,9), 'Reported'),\n 'oct12_excl_ext': (date(2013,10,12), 'Reported'),\n 'oct14_decision': (date(2013,10,14), 'Reported'),\n 'signed': (date(2013,10,14), 'Reported'),\n 'announced': (date(2013,10,15), 'Reported'),\n 'mackenzie': (date(2013,12,4), 'Reported'),\n}\n\nBASIS_NOTES = {\n 'boA_engage': 'Engagement timing: Board approval 05/30/2013; engagement letter 05/31/2013 (Working date assigned to the first day; Assigned: bound).',\n 'partyA_jun21': 'Formality: preliminary exploratory proposal, no supported formal signal \\u2014 Informal. Conditions: Heavy by context \\u2014 made before any NDA or substantive diligence access.',\n 'r1_contact_str': 'Working date convention: the wave began after the 06/24/2013 directive; individual contact dates are not disclosed (Assigned: bound to the first day of the reported window).',\n 'r1_contact_fin': 'Working date convention: the wave began after the 06/24/2013 directive; individual contact dates are not disclosed (Assigned: bound to the first day of the reported window).',\n 'deadline_set_0723': 'Working date convention: communication window 06/28\\u201307/23/2013; midpoint used as a sort key (Assigned: midpoint).',\n 'nda_residual16': 'Working date convention: the cohort\\u2019s signing window (late June to late August) straddles the 07/23/2013 solicitation; the date was moved earlier inside that window so the entry row precedes its inferred non-submission outcome (Assigned: sequence).',\n 'dns_residual16': 'Outcome basis: arithmetic residual only \\u2014 no dates, motives, identities or voluntary withdrawal inferred. Count = stated base \\u2212 accounted participants.',\n 'bid_csc_jul23': 'Conditions: Heavy by context \\u2014 preliminary indication made before data-room or management access; financing not yet described.',\n 'bid_partyB_jul24': 'Conditions: Heavy by context \\u2014 preliminary indication before substantive diligence access, and no financing commitment reported.',\n 'bid_partyC_jul24': 'Conditions: Heavy by context \\u2014 preliminary indication before substantive diligence access. One bid, two communications (see Terms or outcome).',\n 'bid_csc_sep9': 'Conditions: Light \\u2014 committed financing reported (Pamplona, 100% of required capital) and no diligence condition attached to the bid; diligence remained open on the narrative.',\n 'bid_partyB_sep9': 'Conditions: Heavy \\u2014 no firm financing commitment reported; third-party debt contemplated.',\n 'bid_partyA_sep10': 'Conditions: Heavy \\u2014 no firm financing commitment reported.',\n 'bid_partyC_sep10': 'Conditions: Heavy \\u2014 no firm financing commitment reported.',\n 'macdonald_brief': 'Working date convention: reported interval 09/11\\u201309/12/2013; first day used (Assigned: bound).',\n 'bid_csc_sep18': 'Formality: Formal \\u2014 response on the requested basis to the target\\u2019s final-indications request (signal 2). Conditions: Light \\u2014 committed financing, no diligence condition attached; diligence still open.',\n 'bid_partyA_sep18': 'Formality: Formal \\u2014 supported best-and-final response (signal 2; oral confirmation). Conditions: Heavy \\u2014 carried financing basis with no firm commitment at this date (see R032).',\n 'bid_partyB_sep18': 'Formality: Formal \\u2014 final-solicitation response (signal 2). Conditions: Heavy \\u2014 no firm financing commitment; option consideration adds contingency. Price: package value, not guaranteed cash.',\n 'dns_partyC': 'Outcome basis: Stated \\u2014 the filing directly reports the non-submission and that no reasons were given.',\n 'bid_csc_sep21': 'Formality: carries forward from R037 (continuing proposal; no return to a preliminary basis). Conditions: Light \\u2014 Pamplona committed 100% of closing capital; no financing contingency.',\n 'dropped_partyA': 'Outcome basis and agency: Inferred solely from the exclusivity execution; Decided by Target for the transition; the filing states no reason or notice.',\n 'dropped_partyB': 'Outcome basis and agency: Inferred solely from the exclusivity execution; Decided by Target for the transition; the filing states no reason or notice.',\n 'rollover_resolve': 'Working date convention: the determination date is not disclosed; it is reported at the 10/07/2013 Special Committee meeting (Assigned: bound to the report).',\n}\n\ndef why_text(row):\n    parts = []\n    seen_labels = []\n    for item in row.get('resolved', []):\n        label, q, p = item['label'], item['quote'], item['page']\n        if label not in seen_labels:\n            parts.append(f'\\u2014 {label}: ')\n            seen_labels.append(label)\n        else:\n            parts.append(' ')\n        parts.append(f'\"{q}\" (p.{p}).')\n    txt = ''.join(parts).strip()\n    note = BASIS_NOTES.get(row['key'])\n    if note:\n        txt += ' ' + note\n    return txt\n\ndef src_text(row):\n    ids = []\n    for item in row.get('resolved', []):\n        if item['source'] not in ids:\n            ids.append(item['source'])\n    return '; '.join(ids)\n\ndef page_of(row):\n    if row.get('page'):\n        return row['page']\n    for item in row.get('resolved', []):\n        p = item['page']\n        if isinstance(p, str) and p.strip().isdigit():\n            return int(p)\n    return None\n\n# ------------------------------------------------------------------ ledger headers\nVISIBLE = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome',\n           'Formality','Conditions level','Why and evidence','Source','Review','Reviewer note',\n           'Correction']\nGROUPED = ['Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\n           'Price low','Price high','Price kind','Price origin','Currency',\n           'All cash','Cash at closing','Conditions detail','Due date','Deadline treatment',\n           'Round finality','Decided by','Exit reason','Outcome basis','Page','Related rows','Deal']\nHEADERS = VISIBLE + GROUPED\nCOL = {h: get_column_letter(i+1) for i, h in enumerate(HEADERS)}\nCIDX = {h: i+1 for i, h in enumerate(HEADERS)}\nLASTCOL = get_column_letter(len(HEADERS))\n\nwb = Workbook()\nws = wb.active\nws.title = 'Deal ledger'\n\nhdr_fill = PatternFill('solid', fgColor='1F3864')\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\ngrp_fill = PatternFill('solid', fgColor='D9E2F3')\nthin = Side(style='thin', color='BFBFBF')\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\n\nfor i, h in enumerate(HEADERS, 1):\n    c = ws.cell(row=1, column=i, value=h)\n    c.font = hdr_font\n    c.fill = hdr_fill\n    c.alignment = Alignment(vertical='center', wrap_text=True)\n    c.border = border\nws.row_dimensions[1].height = 28\n\n# ------------------------------------------------------------------ ledger rows\nr = 1\nfor row in ROWS:\n    r += 1\n    wd, wdm = WORKING[row['key']]\n    n = r - 1\n    vals = {\n      '#': n,\n      'When': row['when'],\n      'Who': row['who'],\n      'What happened': row['what'],\n      'Process': row['process'],\n      'Round': row['round'],\n      'Type': row['type'],\n      'Terms or outcome': row['terms'],\n      'Formality': row['formality'],\n      'Conditions level': row['cond_level'],\n      'Why and evidence': why_text(row),\n      'Source': src_text(row),\n      'Review': row.get('review'),\n      'Reviewer note': None,\n      'Correction': None,\n      'Row id': f'R{n:03d}',\n      'Include': 'Yes',\n      'Count': row.get('count'),\n      'Date from': d(row.get('date_from')),\n      'Date to': d(row.get('date_to')),\n      'Working date': wd,\n      'Date basis': row.get('date_basis'),\n      'Date method': wdm,\n      'Price low': row.get('price_low'),\n      'Price high': row.get('price_high'),\n      'Price kind': row.get('price_kind'),\n      'Price origin': row.get('price_origin'),\n      'Currency': row.get('currency'),\n      'All cash': row.get('all_cash'),\n      'Cash at closing': row.get('cash_close'),\n      'Conditions detail': row.get('cond_detail'),\n      'Due date': d(row.get('due_date') and str(row['due_date'])),\n      'Deadline treatment': row.get('deadline_treatment'),\n      'Round finality': row.get('round_finality'),\n      'Decided by': row.get('decided_by'),\n      'Exit reason': row.get('exit_reason'),\n      'Outcome basis': row.get('outcome_basis'),\n      'Page': page_of(row),\n      'Related rows': row.get('related'),\n      'Deal': 'Mac-Gray/CSC',\n    }\n    for h, v in vals.items():\n        c = ws.cell(row=r, column=CIDX[h], value=v)\n        c.border = border\n        c.alignment = Alignment(vertical='top', wrap_text=True)\n        if h in ('Date from', 'Date to', 'Working date', 'Due date') and isinstance(v, date):\n            c.number_format = 'MM/DD/YYYY'\n        if h in ('Price low', 'Price high', 'Cash at closing') and v is not None:\n            c.number_format = '#,##0.00'\n        if h == 'Count' and isinstance(v, (int, float)):\n            c.number_format = '0'\n    ws.row_dimensions[r].height = None\n\nLASTROW = r\nws.auto_filter.ref = f'A1:{LASTCOL}{LASTROW}'\nws.freeze_panes = 'C2'\n\nwidths = {'#':5,'When':22,'Who':24,'What happened':19,'Process':7,'Round':6,'Type':10,\n          'Terms or outcome':60,'Formality':11,'Conditions level':11,'Why and evidence':70,\n          'Source':16,'Review':8,'Reviewer note':16,'Correction':14,'Row id':7,'Include':8,\n          'Count':7,'Date from':11,'Date to':11,'Working date':11,'Date basis':15,'Date method':16,\n          'Price low':9,'Price high':9,'Price kind':12,'Price origin':13,'Currency':8,\n          'All cash':9,'Cash at closing':11,'Conditions detail':58,'Due date':10,\n          'Deadline treatment':16,'Round finality':16,'Decided by':10,'Exit reason':13,\n          'Outcome basis':15,'Page':6,'Related rows':22,'Deal':12}\nfor h, w in widths.items():\n    ws.column_dimensions[COL[h]].width = w\n\n# group expandable columns (collapsed)\ngroups = [('Row id','Include'), ('Count','Count'), ('Date from','Date method'),\n          ('Price low','Currency'), ('All cash','Cash at closing'), ('Conditions detail','Conditions detail'),\n          ('Due date','Round finality'), ('Decided by','Outcome basis'), ('Page','Page'),\n          ('Related rows','Related rows'), ('Deal','Deal')]\nfor a, b in groups:\n    ws.column_dimensions.group(COL[a], COL[b], outline_level=1, hidden=True)\nws.sheet_properties.outlinePr.summaryRight = True\nws.sheet_properties.outlinePr.applyStyles = False\n\n# source hyperlinks (link Source cell to the main paragraph row in Source text)\ndef src_row_map():\n    m = {}\n    n = 1\n    for p in PARAS:\n        n += 1\n        m[p['id']] = n\n    for x in XPASS:\n        n += 1\n        m[x['id']] = n\n    return m\n\nSRCROWS = src_row_map()\nfor row in ROWS:\n    r = ROWS.index(row) + 2  # requires unique keys; rows are in order\nfor i, row in enumerate(ROWS):\n    rid = f'R{i+1:03d}'\n    main = None\n    for item in row.get('resolved', []):\n        main = item['source']; break\n    if main and main in SRCROWS:\n        cell = ws.cell(row=i+2, column=CIDX['Source'])\n        cell.hyperlink = f\"#'Source text'!A{SRCROWS[main]}\"\n        cell.font = Font(color='0563C1', underline='single', size=10)\n\n# ------------------------------------------------------------------ Lists sheet\nlists = {\n 'What happened': ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement',\n   'Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened',\n   'Deadline set','Deadline revised','Deadline','Target decision','Information access changed',\n   'Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid',\n   'Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit',\n   'Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced',\n   'Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted',\n   'Agreement terminated','Closed'],\n 'Type': ['Strategic','Financial','Mixed','Unknown'],\n 'Formality': ['Formal','Informal','Insufficient evidence','Varies'],\n 'Conditions level': ['None','Light','Heavy','Insufficient evidence','Varies'],\n 'Include': ['Yes','No'],\n 'Date basis': ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\n 'Date method': ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\n 'Price kind': ['Point','Bidder range','Group envelope','Bound only','Undisclosed'],\n 'Price origin': ['Stated','Carried forward','Inferred'],\n 'All cash': ['Yes','No','Not stated'],\n 'Deadline treatment': ['Enforced','Extended','Late bids accepted','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\n 'Round finality': ['Announced as final','Inferred final','Not final'],\n 'Decided by': ['Bidder','Target','Both','Unknown'],\n 'Exit reason': ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\n   'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\n 'Outcome basis': ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\n}\nlws = wb.create_sheet('Lists')\nlistcol = {}\nfor i, (name, vals) in enumerate(lists.items(), 1):\n    c = get_column_letter(i)\n    listcol[name] = c\n    lws.cell(row=1, column=i, value=name).font = Font(bold=True)\n    for j, v in enumerate(vals, 2):\n        lws.cell(row=j, column=i, value=v)\n    lws.column_dimensions[c].width = max(12, min(30, len(name)+4))\nlws.sheet_state = 'hidden'\n\n# data validation\ndef add_dv(col_letter, list_name, rows=500):\n    last = len(lists[list_name]) + 1\n    dv = DataValidation(type='list', formula1=f'=Lists!${listcol[list_name]}$2:${listcol[list_name]}${last}',\n                        allow_blank=True, showDropDown=False)\n    ws.add_data_validation(dv)\n    dv.add(f'{col_letter}2:{col_letter}{rows}')\n\nfor h, name in [('What happened','What happened'),('Type','Type'),('Formality','Formality'),\n                ('Conditions level','Conditions level'),('Include','Include'),('Date basis','Date basis'),\n                ('Date method','Date method'),('Price kind','Price kind'),('Price origin','Price origin'),\n                ('All cash','All cash'),('Deadline treatment','Deadline treatment'),\n                ('Round finality','Round finality'),('Decided by','Decided by'),('Exit reason','Exit reason'),\n                ('Outcome basis','Outcome basis')]:\n    add_dv(COL[h], name)\n\n# ------------------------------------------------------------------ AI original (values copy)\nai = wb.create_sheet('AI original')\nfor i, h in enumerate(HEADERS, 1):\n    ai.cell(row=1, column=i, value=h).font = Font(bold=True)\nfor i, row in enumerate(ROWS):\n    r = i + 2\n    wsrow = i + 2\n    for h in HEADERS:\n        ai.cell(row=r, column=CIDX[h], value=ws.cell(row=wsrow, column=CIDX[h]).value)\nai.sheet_state = 'hidden'\n\n# ------------------------------------------------------------------ Source text sheet\nst = wb.create_sheet('Source text')\nfor i, h in enumerate(['Paragraph','Section','Page','Text'], 1):\n    c = st.cell(row=1, column=i, value=h)\n    c.font = hdr_font; c.fill = hdr_fill\nst.column_dimensions['A'].width = 11\nst.column_dimensions['B'].width = 46\nst.column_dimensions['C'].width = 8\nst.column_dimensions['D'].width = 150\nr = 1\nfor p in PARAS:\n    r += 1\n    st.cell(row=r, column=1, value=p['id'])\n    st.cell(row=r, column=2, value=p['section'])\n    st.cell(row=r, column=3, value=p['page'])\n    c = st.cell(row=r, column=4, value=p['text']); c.alignment = Alignment(wrap_text=True, vertical='top')\nfor x in XPASS:\n    r += 1\n    st.cell(row=r, column=1, value=x['id'])\n    st.cell(row=r, column=2, value=x['section'])\n    st.cell(row=r, column=3, value=x['page'])\n    c = st.cell(row=r, column=4, value=x['text']); c.alignment = Alignment(wrap_text=True, vertical='top')\nst.freeze_panes = 'A2'\nSTLAST = r\n\n# ------------------------------------------------------------------ Summary sheet\nsm = wb.create_sheet('Summary')\nsm.column_dimensions['A'].width = 34\nsm.column_dimensions['B'].width = 150\n\ndef block(title, lines):\n    global smrow\n    c = sm.cell(row=smrow, column=1, value=title)\n    c.font = Font(bold=True, size=11, color='1F3864')\n    smrow += 1\n    for item, text in lines:\n        a = sm.cell(row=smrow, column=1, value=item)\n        a.alignment = Alignment(vertical='top', wrap_text=True)\n        a.font = Font(size=10, bold=True)\n        b = sm.cell(row=smrow, column=2, value=text)\n        b.alignment = Alignment(vertical='top', wrap_text=True)\n        smrow += 1\n\nsmrow = 1\nblock('1. STATUS AND COMMERCIAL ACCOUNT', [\n ('Status', 'AI first pass; not human-approved. Prepared under the instruction revision of 19 September 2026 (\"Reading a merger filing into a deal ledger\", Revision of 19 September 2026 \\u2014 Pro revision revised after audit against Alex Gorbenko\\u2019s collection instructions; the instruction text in this folder is 19 September 2026).'),\n ('Source coverage', 'Single supplied filing: mac-gray_2013-12-04_DEFM14A.htm \\u2014 Mac-Gray Corporation DEFM14A filed 12/04/2013 (177 component pages incl. Annexes A\\u2013D). Complete Background of the Merger (printed pp.27\\u201341) transcribed in Source text; every additional passage used is X-001\\u2013X-030. No outside sources, market data or third-party knowledge used.'),\n ('Account', 'Mac-Gray, a NYSE-listed laundry-facilities manager (NYSE: TUC), faced activist pressure from Moab Partners (a ~9% holder that elected two directors at the 05/30/2013 annual meeting) and began a target-led sale review in mid-2013 under a Special Committee of six independent directors formed to manage insider-conflict issues. BofA Merrill Lynch approached 50 potential buyers (15 strategic, 35 financial); 20 signed confidentiality agreements, and four bid: strategic Party A (an industry party), strategic CSC/Pamplona (CSC ServiceWorks, a Pamplona portfolio company), and financial bidders Party B and Party C. Party A\\u2019s early $17.00\\u2013$19.00 proposal (06/21/2013) was overtaken as CSC/Pamplona raised through $18.50 (07/23), $19.50 (09/09) and $20.75 (09/18); Party B\\u2019s final package (valued by Party B at $21.50 = $19.00 cash plus options) and Party A\\u2019s best-and-final $18.00\\u2013$19.00 were judged less certain, and Party C stopped bidding without explanation. On 09/21/2013 CSC/Pamplona confirmed $21.25 all-cash as its last and best offer in exchange for a two-week exclusivity, and on 10/14/2013 \\u2014 after negotiating the Mac-Gray termination fee down from $15 million to $11 million \\u2014 the parties signed a $21.25 all-cash merger agreement, announced 10/15/2013.'),\n ('Observed outcome', 'Signing, not closing. No post-signing competing proposal or go-shop activity is reported; HSR clearance was awaited (waiting period expired 11/27/2013), the special meeting was set for 01/08/2014 and closing was expected in January 2014 (first half of 2014 per the merger-agreement section).'),\n ('Last recheck status', 'First delivery; no reviewer edits yet. AI original is an exact values-only copy of this ledger at delivery. Changed-cell highlighting (red bold by Row id and column vs AI original) is not implemented \\u2014 an explicit Correction column is provided next to Reviewer note (see Questions, check 8).'),\n])\n\nblock('2. DEAL FACTS', [\n ('Target', 'Mac-Gray Corporation, 404 Wyman Street, Suite 400, Waltham, Massachusetts 02451 (Delaware corporation; NYSE symbol TUC). Second-largest US laundry facilities management contractor; sells/services commercial laundry equipment through its product sales division.'),\n ('Focal acquirer and type', 'CSC ServiceWorks, Inc. (CSC), a Delaware corporation and Pamplona Capital Partners III, L.P. portfolio company \\u2014 Strategic. Acquires through Spin Holdco Inc. (Parent, wholly owned by CSC), CSC Fenway, Inc. (Merger Subsidiary), with CSC ServiceWorks Holdings, Inc. (sole stockholder of CSC). Pamplona is the owner/financier of the acquirer, not a separate bidder; parent and acquisition shells are one bidder unit.'),\n ('Agreed consideration', '$21.25 per share in cash, without interest, less applicable withholding \\u2014 all cash; fixed cash payable at closing $21.25 (R053). Labelled calculation (not a filing-stated aggregate): 14,758,306 shares \\u00d7 $21.25 = $313,614,002.50.'),\n ('Signing / announcement / completion', 'Agreement and Plan of Merger dated as of 10/14/2013 (R053); joint announcement 10/15/2013 before market open (R054); completion not observed in this filing \\u2014 expected January 2014 (merger-agreement section: first half of 2014). Expected closing kept separate from the observed record.'),\n ('Filing identity', 'Mac-Gray Corporation DEFM14A, filed 12/04/2013; source file mac-gray_2013-12-04_DEFM14A.htm; Background of the Merger at printed pp.27\\u201341; merger agreement Annex A; BofA fairness opinion Annex B; DGCL \\u00a7262 Annex C; form of voting agreement Annex D.'),\n ('Vote and process protections', 'Merger agreement adoption requires a majority of outstanding shares; voting agreements covered \\u224815% of shares (Moab, Mr. MacDonald and family entities). Mac-Gray termination fee $11 million (\\u22483.2% of equity value per the filing); Parent termination fee $15 million (regulatory reverse fee); Pamplona damages liability capped at $50 million (Buyer Entities unlimited); no financing condition; no go-shop, with a fiduciary out for a superior proposal.'),\n ('Special meeting items', '01/08/2014 special meeting: (1) adopt the merger agreement; (2) advisory (non-binding) \"golden parachute\" compensation vote; (3) adjournment proposal.'),\n])\n\nblock('3. PROCESS AND ROUND MAP', [\n ('Process 1 outcome', 'One continuing Mac-Gray sale process (June 2013 \\u2192 signing 10/14/2013). The 2011-2012 Discussions were Mac-Gray\\u2019s own attempt to acquire CSC (R001, R006) \\u2014 retained only as mandate/initiation context, not a Mac-Gray sale process; no second sale attempt is observed.'),\n ('Round 0 (pre-opening)', 'Context only, no Round-opened row: 2011-2012 Discussions; 04/05/2013 Board authorization (R002); 04/08/2013 Party A contact (R003); 06/21/2013 Party A $17.00\\u2013$19.00 proposal (R009, still standing into round 1 \\u2014 Party A is a round-1 participant).'),\n ('Round 1 (06/24/2013 \\u2013 07/23/2013)', 'Opened on the Special Committee\\u2019s 06/24/2013 decision to consider a sale and approach 50 parties \\u2014 no outreach was reported before that directive, and execution began within days (first NDA 06/28/2013). Rejected boundary candidates preserved as rows: R002, R003, R007, R012\\u2013R013, R014. Purpose: preliminary indications of interest; deadline 07/23/2013 (set with the informational packages, R017) \\u2014 Late bids accepted (Party B 07/24; Party C 07/24\\u201307/25, considered 07/25). Round-1 bidders: 4 (three IOIs plus Party A\\u2019s standing proposal); 16 residual signers inferred non-submitters (R019, R021). Finality: Not final.'),\n ('Round 2 (08/27/2013 \\u2013 09/09/2013)', 'Opened on the 08/27/2013 letter requesting revised written proposals once all four bidders\\u2019 diligence was substantially complete (authorized 08/15/2013). Deadline 09/09/2013 \\u2014 Late bids accepted (Party A and Party C 09/10, reviewed 09/11). Round-2 bidders: 4. Finality: Not final.'),\n ('Round 3 (09/11/2013 \\u2013 09/18/2013)', 'Opened on the first request for final indications of interest (calls made 09/11/2013). Deadline 09/18/2013 \\u2014 Enforced (three responses; selection step 09/19). Round-3 bidders: 3 (CSC/Pamplona $20.75; Party A best-and-final reiteration; Party B $21.50 package); Party C did not submit (R040). CSC/Pamplona confirmed $21.25 last-and-best 09/21 (R042); exclusivity authorized 09/23 (R043). Finality: Announced as final.'),\n ('Round 4 (09/24/2013 \\u2013 10/14/2013)', 'Opened on the move to exclusive definitive negotiation with the selected bidder (exclusivity executed 09/24, R044; initial merger-agreement draft 09/25, R048). Round-4 bidders: 1 (CSC/Pamplona). Finality: Inferred final. Ends with signing 10/14/2013 (R053).'),\n ('Post-signing', 'No competing proposals or go-shop activity observed. Announcement 10/15/2013 (R054); proxy statement 12/04/2013 and special-meeting scheduling (R055). Signing is not treated as Process terminated.'),\n ('Exclusivity history', 'Requested with the 09/09 and 09/18 bids; authorized 09/23 (R043); executed 09/24 until 5 p.m. ET 10/12 (R044); extension authorized 10/09 (R050); letter agreement 10/12 extended to 11:59 p.m. ET 10/15 (R051).'),\n ('Deadline history', '07/23/2013 IOI deadline (set with the packages; R017/R020) \\u2014 Late bids accepted; 09/09/2013 revised-proposal deadline (R028/R029) \\u2014 Late bids accepted; 09/18/2013 final-indication deadline (R035/R036) \\u2014 Enforced. No bid deadline was revised or extended; the two exclusivity expiries are not bid deadlines.'),\n])\n\nblock('4. PARTICIPANTS AND ADVISERS', [\n ('Party A \\u2014 Strategic', 'Anonymized strategic party in the laundry facilities management industry. First contacted 04/08/2013 (R003); unsolicited all-cash $17.00\\u2013$19.00 proposal 06/21/2013 (R009, round 0; still standing into round 1); NDA 08/05/2013 after stalled non-solicitation terms (R027); revised IOI 09/10/2013 $18.00\\u2013$19.00 (R032); best-and-final reiteration 09/18/2013 (R038, Formal, Heavy). Closed: Dropped by target at the 09/24/2013 exclusivity execution (R045; Inferred: exclusivity; Decided by Target; reason not stated).'),\n ('Party B \\u2014 Financial', 'Anonymized financial bidder. NDA 06/28/2013 (R014); IOI 07/24/2013 $17.00\\u2013$18.00 (R023); revised IOI 09/09/2013 $18.50 with no firm financing commitment (R031); final package 09/18/2013 valued by Party B at $21.50 ($19.00 cash at closing plus options worth $2.50) (R039; Formal, Heavy). Closed: Dropped by target at the 09/24/2013 exclusivity execution (R046; Inferred: exclusivity; Decided by Target; reason not stated).'),\n ('Party C \\u2014 Financial', 'Anonymized financial bidder. NDA 06/30/2013 (R015); oral IOI 07/24/2013 $15.00\\u2013$17.00 and written indication 07/25/2013 $16.00\\u2013$16.50 (R024); revised oral IOI 09/10/2013 $16.00\\u2013$17.00 (R033); did not submit or reiterate in the final round and gave no reasons. Closed: Did not submit at the 09/18/2013 deadline (R040, stated).'),\n ('CSC/Pamplona \\u2014 Strategic (winner)', 'CSC ServiceWorks, Inc. with Pamplona Capital Partners III, L.P. (one bidder unit; filing treats them as a strategic bidder pair). NDA 07/11/2013 (R018); IOIs $18.50 07/23 (R022), $19.50 09/09 with 100% capital commitment (R030), $20.75 09/18 (R037), $21.25 last-and-best 09/21 conditional on two-week exclusivity (R042); exclusivity 09/24 (R044); signed 10/14/2013 (R053). No exit row \\u2014 the winner.'),\n ('Residual cohort', '16 remaining financial bidders (20 signers less the four individually recorded: 2 strategic + 18 financial per the filing; Party B and Party C are individually recorded). Entry at the NDA wave (R019, Count 16); inferred non-submitters at the 07/23/2013 solicitation (R021, Count 16).'),\n ('Non-entrants', '30 of the 50 approached parties did not sign confidentiality agreements or bid; no individual outcomes are disclosed and none are invented.'),\n ('Ownership / country attributes (disclosed)', 'Moab Capital Partners, LLC / Michael M. Rothenberg \\u22489.07% (1,338,127 shares); Stewart G. MacDonald, Jr. \\u224816.65% (2,456,568 shares, incl. trusts); Cynthia V. Doggett 16.65%; directors and executive officers as a group (14 persons) 35.04%; all entities Delaware/US unless stated. Mr. Rothenberg is Moab\\u2019s co-founder and General Partner; the board also included a Moab-nominated director (Mr. Hyman).'),\n ('Group / funding relationships', 'No bidding-group change occurred: no independent bidder joined (or left for) another\\u2019s bidding unit (no \"Bidding group changed\"/\"Joined group\" rows). Moab\\u2019s possible equity rollover with CSC/Pamplona was denied (07/06/2013), later permitted to be discussed and resolved without a rollover (10/07/2013) \\u2014 R016, R049. Pamplona\\u2019s $594 million commitment supports the CSC bid \\u2014 recorded on the bid/signing rows, not as a group change.'),\n ('Advisers', 'BofA Merrill Lynch \\u2014 financial adviser to Mac-Gray: engaged 10/23/2012 for the 2011-2012 Discussions (R001), terminated 05/15/2013 (R006), re-engaged for the strategic-alternatives review 05/30\\u201305/31/2013 (R007); fairness opinion 10/14/2013 (R052). Goodwin Procter LLP \\u2014 outside legal counsel to Mac-Gray; service observed from 05/09/2013; no engagement date disclosed (R005). Kirkland & Ellis LLP \\u2014 outside legal counsel to CSC/Pamplona; service observed from 09/25/2013 (R048). MacKenzie Partners, Inc. \\u2014 proxy solicitor; expected retention at \\u2248$15,000 reported 12/04/2013 (R055). No unclear client affiliations remain.'),\n])\n\nblock('5. COUNTS AND AUCTION SCREEN', [\n ('Contacts (filing assertion)', '50 parties contacted: 15 potential strategic buyers and 35 potential financial buyers (R012, R013). Ledger-derived contact tally (SUMIFS, Include = Yes): '),\n ('Contact total formula', \"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"Contact\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$Q:$Q,\\\"Yes\\\")\"),\n ('Contacts \\u2014 reconciliation', 'The SUMIFS = 50 (15 + 35). Row R003 (Party A first contact, 04/08/2013) carries Count 0 because Party A is already inside the 15-party strategic cohort \\u2014 it is a first-contact record, not an additive unit; do not sum to 51.'),\n ('NDAs (filing assertion)', '20 potential bidders signed confidentiality and standstill agreements: 2 strategic (Party A, CSC/Pamplona) and 18 financial (including Party B and Party C).'),\n ('NDA total formula', \"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"NDA signed\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$Q:$Q,\\\"Yes\\\")\"),\n ('NDAs \\u2014 reconciliation', 'The SUMIFS = 20: individually recorded R014 (Party B), R015 (Party C), R018 (CSC/Pamplona), R027 (Party A) + residual cohort R019 (16 financial signers) = 20. No double counting of named members.'),\n ('Round-bidder tallies (ledger)', 'Round 1: 3 Count units for round-1 submissions (R022\\u2013R024) + Party A\\u2019s standing round-0 proposal shown as a round-1 participant (R009/R011) = 4 bidders. Round 2: 4 (R030\\u2013R033). Round 3: 3 (R037, R038, R039; R042 is a Count-0 same-round increase). Round 4: 1 (selected definitive negotiator; no Bid rows).'),\n ('Round 2 formula', \"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"Bid\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$F:$F,2,'Deal ledger'!$Q:$Q,\\\"Yes\\\")\"),\n ('Round 3 formula', \"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"Bid\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$Q:$Q,\\\"Yes\\\")+SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"Bid reaffirmed\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$Q:$Q,\\\"Yes\\\")\"),\n ('Outcome tallies (affected units)', 'Dropped by target: '),\n ('Dropped formula', \"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\"Dropped by target\\\",'Deal ledger'!$Q:$Q,\\\"Yes\\\")\"),\n ('Did not submit', '=SUMIFS(\\'Deal ledger\\'!$R:$R,\\'Deal ledger\\'!$D:$D,\"Did not submit\",\\'Deal ledger\\'!$Q:$Q,\"Yes\")'),\n ('Per-stage balance (process 1)', 'Entered 20 (R014/R015/R018/R027 individually + R019 residual cohort = 20 signers, each counted once) \\u2212 stated exits 1 (Party C, Did not submit) \\u2212 inferred exits 18 (16 residual non-submitters + Party A and Party B dropped by exclusivity) = continuing 1 (CSC/Pamplona, the winner). Inferred share of exits: 18 of 19. No participant is left unclosed; the balance is exact because the filing states the signer population (20).'),\n ('Auction screen', 'Met. More than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for the process: 20 signers including at least four independently evidenced units (Party A, CSC/Pamplona, Party B, Party C). Lender-only, adviser and rollover-holder agreements excluded (none exist here). Sample eligibility remains a research decision.'),\n ('Do not add steps', 'Contacts (50 parties reached) \\u2260 submissions (round-1: 3; round-2: 4; round-3: 3) \\u2260 unique firms (20 entrants) \\u2260 outcomes (19 affected units) \\u2260 NDA signers (20). Different steps must not be summed.'),\n])\n\nblock('6. COMPARABILITY AND INPUTS', [\n ('Shares and ownership', '14,758,306 shares issued and outstanding (11/27/2013); \\u2248104 record holders; \\u224815% subject to voting agreements; Moab \\u22489.07%; Mr. S. MacDonald \\u224816.65%; directors and officers as a group 35.04%.'),\n ('Market prices and premiums', 'Closing prices: $14.72 on 10/11/2013 (last trading day before Board approval); $14.93 on 10/14/2013 (last full trading day before announcement); $21.30 on 11/27/2013. 52-week high for the period ending 10/11/2013: $15.61. Stated premiums vs $21.25: \\u224836% over the 52-week high and \\u224844% over the $14.72 close.'),\n ('Adviser analyses (not offers)', 'BofA implied per-share reference ranges from selected public companies: $13.50\\u2013$18.75 (2013E without acquisitions), $13.75\\u2013$19.00 (2013E with acquisitions), $13.75\\u2013$19.25 (2014E without), $12.75\\u2013$19.25 (2014E with) versus the $21.25 consideration; 20 selected precedent transactions included the May 1, 2013 Coinmach/Pamplona transaction. Analysis only \\u2014 not recorded as bids.'),\n ('Contingent / non-cash consideration', 'Party B\\u2019s 09/18/2013 package: $19.00 cash at closing plus options = 10% of new equity, strike equal to Party B\\u2019s initial cost basis, vesting over five years on achievement of base-case management projections (excluding future acquisitions); Party B valued the options at $2.50/share, for a stated package value of $21.50. All cash = No; Cash at closing = $19.00; the $2.50 option value is not guaranteed cash.'),\n ('Financing inputs', 'Pamplona commitment letter dated 10/14/2013: $594 million of capital; no financing condition to the Buyer Entities\\u2019 obligations; Pamplona and the Buyer Entities jointly and severally liable for damages, with Pamplona capped at $50 million (Buyer Entities unlimited); CSC reverse termination fee $15 million; Mac-Gray termination fee negotiated from $15 million (Kirkland\\u2019s 10/07 proposal, \\u22484.4% of equity value) to $11 million (\\u22483.2%).'),\n ('Projections', 'Management Projections prepared June 2013 (without-acquisitions and with-acquisitions cases; 2013\\u20132018), provided to the Special Committee and BofA; not updated for the merger. Used in the fairness opinion.'),\n ('Other-scope proposals', 'None disclosed. All four bids were for the whole company; no segment, asset, minority-stake or other-scope proposals appear. The 2011-2012 Discussions concerned Mac-Gray\\u2019s possible acquisition of CSC and are not an other-scope bid for Mac-Gray.'),\n ('Glossary', 'NDA = confidentiality/non-disclosure agreement; IOI = indication of interest; LOI = letter of intent (not used here); Party A/B/C = filing\\u2019s anonymized bidders; CSC/Pamplona = one bidder unit (CSC ServiceWorks with Pamplona as owner/financier); Round 0 = pre-opening approaches and standing proposals; Round finality = whether the round was announced/inferred final; Inferred closing = a participant closed by arithmetic/transition without a stated exit; Working date = assigned sort key with a stated method, not an observed date; Auction screen = whether >1 independent bidder unit signed bidder-target confidentiality agreements.'),\n])\nsm.freeze_panes = 'A2'\n\n# ------------------------------------------------------------------ Questions sheet\nqs = wb.create_sheet('Questions')\nqheaders = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields',\n            'Consequence of changing it','Status','Reviewer note']\nfor i, h in enumerate(qheaders, 1):\n    c = qs.cell(row=1, column=i, value=h)\n    c.font = hdr_font; c.fill = hdr_fill; c.alignment = Alignment(wrap_text=True, vertical='center')\nqs.column_dimensions['A'].width = 6\nqs.column_dimensions['B'].width = 26\nqs.column_dimensions['C'].width = 70\nqs.column_dimensions['D'].width = 70\nqs.column_dimensions['E'].width = 26\nqs.column_dimensions['F'].width = 40\nqs.column_dimensions['G'].width = 10\nqs.column_dimensions['H'].width = 20\n\nQUESTIONS = [\n (\"Q1\", \"Process and round map; Round-1 anchor and rejected boundaries\",\n  \"Adopt one process and four analytical rounds as recorded: R1 opens 06/24/2013 on the Special Committee\\u2019s decision to consider a sale and approach 50 parties (executed by BofA outreach within days; first NDA 06/28/2013); R2 opens 08/27/2013 on the revised-proposal letter; R3 opens 09/11/2013 on the first request for final indications of interest (Announced as final); R4 opens 09/24/2013 on the move to exclusive definitive negotiation with the selected bidder (Inferred final). Round 0 holds the 2011-2012 Discussions, the 04/05/2013 authorization, the 04/08/2013 Party A contact and the 06/21/2013 Party A proposal, with Party A shown as a round-1 participant because its proposal was standing when round 1 was evaluated. Alternative: the smallest map is three rounds, folding the definitive-negotiation phase into R3; if so, delete/Include=No R047 and move R044\\u2013R053 to R3.\",\n  \"Boundaries: the filing reports no target outreach before the 06/24/2013 directive, and BofA\\u2019s contacts began within days (background pp.31\\u201332); R3 is the first \\u201cfinal\\u201d request (p.36) and the exclusivity stage follows the final stage (pp.37\\u201338). Rejected R1 boundary candidates are preserved as their own rows: R002 (authorization), R003 (Party A call), R007 (engagement letter), R012\\u2013R013 (outreach wave), R014 (first NDA). R4 rests on the instruction\\u2019s trigger \\u201cmoves to definitive negotiation with selected bidders\\u201d and its \\u201cInferred final\\u201d definition; the counter-reading is that the exclusivity is \\u201cinside an established final negotiation stage\\u201d.\",\n  \"R010, R011 (R1); R028 (R2); R035 (R3); R043, R044, R047 (R4); boundary rows R002, R003, R007, R012\\u2013R014; Round fields and Round finality on all Round-opened rows\",\n  \"If R4 is folded into R3: round count 4 \\u2192 3; R3 gains the definitive-negotiation phase; the R4 round-bidder tally (1) disappears; no participant outcome changes. If the R1 anchor moves to 06/28\\u201307/23, Round 1\\u2019s opening date and some count context shift.\",\n  \"Pending\", None),\n (\"Q2\", \"Deadline history and treatments\",\n  \"Keep as recorded: IOI deadline 07/23/2013 (set with the informational packages between 06/28 and 07/23; estimated Working date 07/10) \\u2014 Late bids accepted (Party B 07/24; Party C 07/24\\u201307/25, both considered 07/25); revised-proposal deadline 09/09/2013 \\u2014 Late bids accepted (Party A and Party C 09/10, reviewed 09/11); final-indication deadline 09/18/2013 \\u2014 Enforced (three responses; selection step 09/19). The exclusivity expiries (10/12, 10/15) are not bid deadlines.\",\n  \"Deadline instructions at background pp.32 and p.35; late submissions and the meetings that considered them at pp.33\\u201336; the 09/19 selection step at pp.36\\u201337. No deadline revision is reported, so no Deadline revised row exists; the July 23 due date and its late acceptance are preserved in R017/R020.\",\n  \"R017, R020 (07/23); R028, R029 (09/09); R035, R036 (09/18); Deadline treatment fields and the Summary deadline map\",\n  \"Reclassifying 07/23 or 09/09 from Late bids accepted to Unclear/Enforced would change the deadline map and could move late bids out of their round\\u2019s submission count; the 09/18 treatment is robust unless the reviewer reads the 09/21 $21.25 confirmation as a new solicitation.\",\n  \"Pending\", None),\n (\"Q3\", \"Participants, NDA/contact counts, residual base and inferred closings\",\n  \"Accept the population: 50 parties contacted (15 + 35), 20 NDA signers (2 strategic + 18 financial), 4 individually recorded, residual cohort of 16 financial signers. Close-outs: 16 residual non-submitters at 07/23/2013 (Count 16; Inferred: residual \\u2014 20 \\u2212 4 = 16); Party C Did not submit at 09/18/2013 (stated, Count 1); Party A and Party B Dropped by target at the 09/24/2013 exclusivity execution (Inferred: exclusivity, Count 1 each). The 30 contacted non-signers never entered and get no outcome rows.\",\n  \"Base and continuing sets: p.32 (20 signers; 2 + 18 split) and p.34 (the four advanced at the 07/25/2013 meeting); Party C\\u2019s non-submission is expressly reported (p.36); exclusivity execution p.38 closes live rivals. Uncertainty: the base assumes all 20 signers were covered by the 07/23/2013 solicitation, but signings are described \\u201cover the next two months\\u201d (to late August) and Party A signed only on 08/05/2013 \\u2014 if some residual signers post-date 07/23, the non-submitting set is smaller (or some should be closed at a later transition). Party A\\u2019s 04/08/2013 contact carries Count 0 because it sits inside the 15-party strategic cohort (R012).\",\n  \"R003, R012\\u2013R013, R019, R021, R040, R045, R046; Count fields; Summary balance\",\n  \"Splitting or resizing the residual cohort changes the inferred-exit count and the per-stage balance; if any of the 16 later submitted an IOI not reported in the narrative, the residual overstates non-submission \\u2014 the filing\\u2019s exhaustive-sounding list (Party B, Party C, CSC/Pamplona and Party A\\u2019s standing proposal) argues against that.\",\n  \"Pending\", None),\n (\"Q4\", \"Formality and conditions borderlines\",\n  \"As recorded: July IOIs are Informal and Heavy by context (made before data-room/management access); September revised IOIs remain Informal except the three final-round responses, which are Formal (R037, R038, R039 \\u2014 responses on the requested basis to the 09/11/2013 final-indications request), with Party A Formal on an oral best-and-final price confirmation; conditions are Heavy for Party A and Party B (no firm financing commitment), Light for CSC/Pamplona (Pamplona committed 100% of capital; no diligence condition attached) and Light for the 09/21/2013 $21.25 confirmation (carried forward). No Conditions level turns on a stated diligence period, no row is None, and there is no late reconfirmation row (the winner\\u2019s latest priced bid is Formal and sits in an Announced-as-final round, so the section 9.1 late-reconfirmation test fails).\",\n  \"Formality signals: final-indications request p.36; responses p.36. Conditions: no firm commitment for Party B (p.35) and Party A/Party C (p.35); Pamplona commitment (pp.35\\u201336); pre-access IOIs (pp.33\\u201334 data-room staging). The winner reached signing with a Formal row (R037) \\u2014 no gap.\",\n  \"R009, R022\\u2013R024, R030\\u2013R033, R037\\u2013R039, R042; Formality, Conditions level and Conditions detail fields\",\n  \"Reclassifying any September IOI as Informal, or the final responses as Formal, changes the formality tallies and the Conditions detail strings; prices, outcomes and the round map are unaffected.\",\n  \"Pending\", None),\n (\"Q5\", \"Price and consideration conventions; scope\",\n  \"Keep as recorded: per-share cells in USD only; Party A\\u2019s ranges as Bidder range with Carried forward on the 09/18/2013 reaffirmation; Party B\\u2019s 09/18/2013 package entered as a Point at $21.50 (Party B\\u2019s stated value) with All cash = No and Cash at closing $19.00; Party C\\u2019s oral-to-written July indications treated as one bid with the written range recorded; no Bound only rows; no other-scope bids; signing row carries the agreed $21.25 in text only (no price cells).\",\n  \"Package value: p.36 (\\u201cParty B valued at $21.50 \\u2026 $19.00 of cash \\u2026 options \\u2026 valued the Party B options at $2.50\\u201d); carried price p.36 (reiteration of the previous $18.00\\u2013$19.00 indication); one-communication convention applied to Party C (pp.33\\u201334); no other-scope proposals appear anywhere in the filing.\",\n  \"R024, R032, R038, R039, R053; Price low/high/kind/origin, All cash, Cash at closing, Terms or outcome\",\n  \"If the reviewer prefers not to enter bidder-assigned package values in price cells, blank R039\\u2019s price cells and keep $21.50/$19.00/$2.50 in text; carried-forward vs restated on R038 changes Price origin only. No totals depend on these cells.\",\n  \"Pending\", None),\n (\"Q6\", \"Moab/MacDonald rollover rows and the two-row convention\",\n  \"Keep three rows: R016 (rollover denied as premature, 07/06/2013), R034 (Mr. MacDonald\\u2019s rollover question resolved and his support position, 09/11\\u201309/12/2013) and R049 (Moab discussions permitted 09/23/2013 and resolved without a rollover, reported 10/07/2013). No separate row for the 09/23/2013 permission, per the instruction\\u2019s \\u201cat most one row when permitted, denied or formed and one when resolved\\u201d convention for rollover relationships.\",\n  \"Denial and rationale p.32\\u201333; permission p.38; discussions and determination pp.38\\u201339; MacDonald\\u2019s position pp.35\\u201336. The filing never shows a formed rollover or any financing-support relationship between Moab and CSC/Pamplona, and no voting/group change results.\",\n  \"R016, R034, R049; Material process update rows; Summary group/funding note\",\n  \"Adding a fourth row for the 09/23/2013 permission changes row counts only; reclassifying these as Bidding group changed would be wrong (a rollover holder is not a bidding-unit member) and would distort the unit counts.\",\n  \"Pending\", None),\n (\"Q7\", \"Assigned Working dates and display order within rounds\",\n  \"Accept the disclosed conventions: R012/R013 (wave) use the first day of the reported window (06/24/2013); R017 uses the midpoint of 06/28\\u201307/23 (07/10/2013); R019 is moved earlier inside its window to 07/23/2013 (Assigned: sequence) so the residual cohort\\u2019s entry precedes its inferred non-submission; R024 and R034 use the first day of a reported interval; R045/R046 use the transition date (Assigned: decision day); R049 uses the 10/07/2013 report bound. Sorting by Working date with # as tiebreak reproduces the reading order; no Working date falls outside its own window. Source quirks retained: the filing\\u2019s \\u201cJuly 27, 2103\\u201d typo (R027; intended 2013) and a duplicated sentence in the informational-package paragraph (Source text P-023).\",\n  \"Rules applied from the instruction, section 8.1; the order constraint drove R019\\u2019s sequence assignment (entry must precede R021\\u2019s inferred closing); each affected row\\u2019s reason states its convention.\",\n  \"R012, R013, R017, R019, R024, R034, R045, R046, R049; Date from/to, Working date, Date basis/method fields\",\n  \"Changing any convention moves only display order (and possibly the entry-before-outcome check for R019/R021); facts, counts and outcomes are unaffected.\",\n  \"Pending\", None),\n (\"Q8\", \"Exclusivity row granularity\",\n  \"Keep four Exclusivity changed rows: authorized 09/23/2013 (R043), executed 09/24/2013 (R044), extension authorized 10/09/2013 (R050), extended by letter agreement 10/12/2013 (R051), each stating the actual vs scheduled state. Alternative: merge authorized+executed and authorized+extended into two rows (granted; extended).\",\n  \"Authorization p.38 and execution p.38; extension request and authorization pp.40\\u201341; letter agreement p.41. The instruction asks the row to state which state (requested/authorized/granted/extended/ended) it records.\",\n  \"R043, R044, R050, R051; Exclusivity changed rows and Summary exclusivity history\",\n  \"Merging to two rows changes row count and the exact timing record for the 09/23 authorization and 10/09 authorization; no bid, count or outcome changes.\",\n  \"Pending\", None),\n]\nr = 1\nfor q in QUESTIONS:\n    r += 1\n    for i, v in enumerate(q, 1):\n        c = qs.cell(row=r, column=i, value=v)\n        c.alignment = Alignment(vertical='top', wrap_text=True)\n        c.border = border\n\n# check results below\nr += 2\nc = qs.cell(row=r, column=1, value='CHECK RESULTS (instruction section 13) \\u2014 run on this delivered version')\nc.font = Font(bold=True, size=11, color='1F3864')\nr += 1\nchk_hdr = ['Check','Scope and method','Result','Notes / affected rows; consequences']\nfor i, h in enumerate(chk_hdr, 1):\n    c = qs.cell(row=r, column=min(i+1,8), value=h)\n    c.font = Font(bold=True)\n    c.fill = PatternFill('solid', fgColor='D9E2F3')\nCHECKS = [\n (\"1. Coverage and materiality\",\n  \"Reading the full filing against the ledger\",\n  \"Passed\",\n  \"All disclosed core proposals (11 priced Bid rows + R038 reaffirmation + R042 increase), contacts and NDAs (50 approached; 20 signed), the differentiated-access decision (R026), selection/exclusivity (R041\\u2013R047), signing (R053) and announcement (R054) are accounted for; regulatory/litigation facts are confined to Summary. Supplied-source limits (single filing; no post-DEC-2013 events) stated in Summary; inferred closings explicit.\"),\n (\"2. Counts and population\",\n  \"Formula/logic check and Sumary reconciliation\",\n  \"Qualified\",\n  \"Sums reconcile: contacts 50 (15+35; R003 Count 0), NDAs 20 (4 named + 16 residual), round bidders 4/4/3/1, outcomes 2 dropped + 17 did-not-submit + 1 winner = 20 entrants. Qualification: the residual base assumes all 20 signers were eligible for the 07/23/2013 solicitation (some signings may be later \\u2014 Q3); Party A contact overlap documented rather than silently zeroed.\"),\n (\"3. Participation continuity\",\n  \"Per-bidder history and per-stage stock\",\n  \"Passed\",\n  \"Each of the 20 entrants closes exactly once: Party C stated; 16 residual + Party A + Party B inferred; CSC/Pamplona signs. Stock never negative and only the winner remains after 09/24/2013. No bid, reaffirmation or resumed diligence follows a recorded outcome, so no Re-entered row is required.\"),\n (\"4. Dates and order\",\n  \"Programmatic check of ordering and windows; reading check of intervals\",\n  \"Qualified\",\n  \"All Working dates are filled and non-decreasing in # order; each lies inside its row\\u2019s Date from/to; Reported/Inferred methods pair exactly with their bases; assigned methods used elsewhere. Qualification: the conventions in Q7 (bounds, midpoints, sequence) are analytical; not recalculated in Excel (written formulas verified programmatically).\"),\n (\"5. Offers and classifications\",\n  \"Field-level review of all Bid/Bid reaffirmed rows\",\n  \"Qualified\",\n  \"Every Bid/Bid reaffirmed row has Formality, Conditions level and a fixed-format Conditions detail string; price kinds/origins/cash flags agree with the text; signing has no price/formality/conditions cells; Party B\\u2019s package is All cash = No with $19.00 closing cash. Qualification: the formality and Heavy-by-context calls are judgment (Q4); Party B\\u2019s bidder-assigned option value is recorded per the package convention (Q5).\"),\n (\"6. Structure and consistency\",\n  \"Structural audit across ledger and Summary\",\n  \"Passed\",\n  \"One Round opened row per round (R011, R028, R035, R047), each with Round finality; R011 carries the R1 anchor tag with candidate Row ids; each Deadline row\\u2019s treatment matches the Summary map; every inferred row opens with its Outcome basis; Related rows point to prior (not self/future) records; Page filled wherever Source is.\"),\n (\"7. Evidence\",\n  \"Programmatic quotation matching plus interpretation read\",\n  \"Passed\",\n  \"Every quotation used was matched to the cited passage in the source text (whitespace-normalized; filing typography preserved, including the \\u201cJuly 27, 2103\\u201d typo and the duplicated sentence in P-023); page citations verified against the printed-page map; cross-paragraph premises cited (e.g., formality signals and the residual base). Text matching alone does not validate interpretation \\u2014 judgment items are in Q1\\u2013Q8.\"),\n (\"8. Review and workbook operation\",\n  \"Workbook open/re-save text and structural inspection\",\n  \"Qualified\",\n  \"Question links and Affected-row references resolve to existing Row ids; drop-down lists written for all controlled columns; Source hyperlinks written and verified present after save; formulas written for the Summary tallies and verified by logic (not recalculated in Excel \\u2014 open/saved via LibreOffice for a structural check only where noted). Changed-cell highlighting is NOT implemented: AI original is retained as the values baseline and a Correction column is provided beside Reviewer note; no automatic baseline comparison or dependent-update mechanism is claimed.\"),\n]\nfor chk in CHECKS:\n    r += 1\n    for i, v in enumerate(chk, 1):\n        c = qs.cell(row=r, column=min(i+1, 8), value=v)\n        c.alignment = Alignment(vertical='top', wrap_text=True)\n        c.border = border\n\n# ------------------------------------------------------------------ sheet order and save\nwb.move_sheet('Deal ledger', offset=0)\norder = ['Deal ledger','Summary','Questions','Source text','AI original','Lists']\nwb._sheets = [wb[n] for n in order]\nprint('saving', OUT)\nwb.save(OUT)\nprint('saved. ledger rows:', len(ROWS), 'source rows:', STLAST)\n","path":"/tmp/opencode/build_xlsx.py"},"output":"Created file successfully: /tmp/opencode/build_xlsx.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/build_xlsx.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Write extraction/mac-gray.xlsx from /tmp/opencode/ledger_data.json.\\\"\\\"\\\"\\nimport json, re\\nfrom datetime import date, datetime, timedelta\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.properties import WorksheetProperties  # noqa\\n\\nDATA = json.load(open('/tmp/opencode/ledger_data.json'))\\nROWS = DATA['rows']\\nPARAS = DATA['paras']\\nXPASS = DATA['xpass']\\nOUT = 'extraction/mac-gray.xlsx'\\n\\n# ------------------------------------------------------------------ helpers\\ndef d(s):\\n    if not s:\\n        return None\\n    y, m, dd = [int(x) for x in str(s)[:10].split('-')]\\n    return date(y, m, dd)\\n\\nWORKING = {\\n 'boA2012_engage': (date(2012,10,23), 'Reported'),\\n 'apr5': (date(2013,4,5), 'Reported'),\\n 'apr8': (date(2013,4,8), 'Reported'),\\n 'may9_board': (date(2013,5,9), 'Reported'),\\n 'goodwin': (date(2013,5,9), 'Reported'),\\n 'boA2012_end': (date(2013,5,15), 'Reported'),\\n 'boA_engage': (date(2013,5,30), 'Assigned: bound'),\\n 'annual_mtg': (date(2013,5,30), 'Reported'),\\n 'partyA_jun21': (date(2013,6,21), 'Reported'),\\n 'jun24_board': (date(2013,6,24), 'Reported'),\\n 'r1_open': (date(2013,6,24), 'Reported'),\\n 'r1_contact_str': (date(2013,6,24), 'Assigned: bound'),\\n 'r1_contact_fin': (date(2013,6,24), 'Assigned: bound'),\\n 'nda_partyB': (date(2013,6,28), 'Reported'),\\n 'nda_partyC': (date(2013,6,30), 'Reported'),\\n 'jul6_rollover': (date(2013,7,6), 'Reported'),\\n 'deadline_set_0723': (date(2013,7,10), 'Assigned: midpoint'),\\n 'nda_csc': (date(2013,7,11), 'Reported'),\\n 'nda_residual16': (date(2013,7,23), 'Assigned: sequence'),\\n 'deadline_0723': (date(2013,7,23), 'Reported'),\\n 'dns_residual16': (date(2013,7,23), 'Assigned: deadline'),\\n 'bid_csc_jul23': (date(2013,7,23), 'Reported'),\\n 'bid_partyB_jul24': (date(2013,7,24), 'Reported'),\\n 'bid_partyC_jul24': (date(2013,7,24), 'Assigned: bound'),\\n 'jul25_decision': (date(2013,7,25), 'Reported'),\\n 'jul25_access': (date(2013,7,25), 'Reported'),\\n 'nda_partyA': (date(2013,8,5), 'Reported'),\\n 'r2_open': (date(2013,8,27), 'Reported'),\\n 'deadline_0909': (date(2013,9,9), 'Reported'),\\n 'bid_csc_sep9': (date(2013,9,9), 'Reported'),\\n 'bid_partyB_sep9': (date(2013,9,9), 'Reported'),\\n 'bid_partyA_sep10': (date(2013,9,10), 'Reported'),\\n 'bid_partyC_sep10': (date(2013,9,10), 'Reported'),\\n 'macdonald_brief': (date(2013,9,11), 'Assigned: bound'),\\n 'r3_open': (date(2013,9,11), 'Reported'),\\n 'deadline_0918': (date(2013,9,18), 'Reported'),\\n 'bid_csc_sep18': (date(2013,9,18), 'Reported'),\\n 'bid_partyA_sep18': (date(2013,9,18), 'Reported'),\\n 'bid_partyB_sep18': (date(2013,9,18), 'Reported'),\\n 'dns_partyC': (date(2013,9,18), 'Assigned: deadline'),\\n 'sep19_decision': (date(2013,9,19), 'Reported'),\\n 'bid_csc_sep21': (date(2013,9,21), 'Reported'),\\n 'sep23_excl_auth': (date(2013,9,23), 'Reported'),\\n 'sep24_excl_exec': (date(2013,9,24), 'Reported'),\\n 'dropped_partyA': (date(2013,9,24), 'Assigned: decision day'),\\n 'dropped_partyB': (date(2013,9,24), 'Assigned: decision day'),\\n 'r4_open': (date(2013,9,24), 'Reported'),\\n 'kirkland': (date(2013,9,25), 'Reported'),\\n 'rollover_resolve': (date(2013,10,7), 'Assigned: bound'),\\n 'oct9_excl_auth': (date(2013,10,9), 'Reported'),\\n 'oct12_excl_ext': (date(2013,10,12), 'Reported'),\\n 'oct14_decision': (date(2013,10,14), 'Reported'),\\n 'signed': (date(2013,10,14), 'Reported'),\\n 'announced': (date(2013,10,15), 'Reported'),\\n 'mackenzie': (date(2013,12,4), 'Reported'),\\n}\\n\\nBASIS_NOTES = {\\n 'boA_engage': 'Engagement timing: Board approval 05/30/2013; engagement letter 05/31/2013 (Working date assigned to the first day; Assigned: bound).',\\n 'partyA_jun21': 'Formality: preliminary exploratory proposal, no supported formal signal \\\\u2014 Informal. Conditions: Heavy by context \\\\u2014 made before any NDA or substantive diligence access.',\\n 'r1_contact_str': 'Working date convention: the wave began after the 06/24/2013 directive; individual contact dates are not disclosed (Assigned: bound to the first day of the reported window).',\\n 'r1_contact_fin': 'Working date convention: the wave began after the 06/24/2013 directive; individual contact dates are not disclosed (Assigned: bound to the first day of the reported window).',\\n 'deadline_set_0723': 'Working date convention: communication window 06/28\\\\u201307/23/2013; midpoint used as a sort key (Assigned: midpoint).',\\n 'nda_residual16': 'Working date convention: the cohort\\\\u2019s signing window (late June to late August) straddles the 07/23/2013 solicitation; the date was moved earlier inside that window so the entry row precedes its inferred non-submission outcome (Assigned: sequence).',\\n 'dns_residual16': 'Outcome basis: arithmetic residual only \\\\u2014 no dates, motives, identities or voluntary withdrawal inferred. Count = stated base \\\\u2212 accounted participants.',\\n 'bid_csc_jul23': 'Conditions: Heavy by context \\\\u2014 preliminary indication made before data-room or management access; financing not yet described.',\\n 'bid_partyB_jul24': 'Conditions: Heavy by context \\\\u2014 preliminary indication before substantive diligence access, and no financing commitment reported.',\\n 'bid_partyC_jul24': 'Conditions: Heavy by context \\\\u2014 preliminary indication before substantive diligence access. One bid, two communications (see Terms or outcome).',\\n 'bid_csc_sep9': 'Conditions: Light \\\\u2014 committed financing reported (Pamplona, 100% of required capital) and no diligence condition attached to the bid; diligence remained open on the narrative.',\\n 'bid_partyB_sep9': 'Conditions: Heavy \\\\u2014 no firm financing commitment reported; third-party debt contemplated.',\\n 'bid_partyA_sep10': 'Conditions: Heavy \\\\u2014 no firm financing commitment reported.',\\n 'bid_partyC_sep10': 'Conditions: Heavy \\\\u2014 no firm financing commitment reported.',\\n 'macdonald_brief': 'Working date convention: reported interval 09/11\\\\u201309/12/2013; first day used (Assigned: bound).',\\n 'bid_csc_sep18': 'Formality: Formal \\\\u2014 response on the requested basis to the target\\\\u2019s final-indications request (signal 2). Conditions: Light \\\\u2014 committed financing, no diligence condition attached; diligence still open.',\\n 'bid_partyA_sep18': 'Formality: Formal \\\\u2014 supported best-and-final response (signal 2; oral confirmation). Conditions: Heavy \\\\u2014 carried financing basis with no firm commitment at this date (see R032).',\\n 'bid_partyB_sep18': 'Formality: Formal \\\\u2014 final-solicitation response (signal 2). Conditions: Heavy \\\\u2014 no firm financing commitment; option consideration adds contingency. Price: package value, not guaranteed cash.',\\n 'dns_partyC': 'Outcome basis: Stated \\\\u2014 the filing directly reports the non-submission and that no reasons were given.',\\n 'bid_csc_sep21': 'Formality: carries forward from R037 (continuing proposal; no return to a preliminary basis). Conditions: Light \\\\u2014 Pamplona committed 100% of closing capital; no financing contingency.',\\n 'dropped_partyA': 'Outcome basis and agency: Inferred solely from the exclusivity execution; Decided by Target for the transition; the filing states no reason or notice.',\\n 'dropped_partyB': 'Outcome basis and agency: Inferred solely from the exclusivity execution; Decided by Target for the transition; the filing states no reason or notice.',\\n 'rollover_resolve': 'Working date convention: the determination date is not disclosed; it is reported at the 10/07/2013 Special Committee meeting (Assigned: bound to the report).',\\n}\\n\\ndef why_text(row):\\n    parts = []\\n    seen_labels = []\\n    for item in row.get('resolved', []):\\n        label, q, p = item['label'], item['quote'], item['page']\\n        if label not in seen_labels:\\n            parts.append(f'\\\\u2014 {label}: ')\\n            seen_labels.append(label)\\n        else:\\n            parts.append(' ')\\n        parts.append(f'\\\"{q}\\\" (p.{p}).')\\n    txt = ''.join(parts).strip()\\n    note = BASIS_NOTES.get(row['key'])\\n    if note:\\n        txt += ' ' + note\\n    return txt\\n\\ndef src_text(row):\\n    ids = []\\n    for item in row.get('resolved', []):\\n        if item['source'] not in ids:\\n            ids.append(item['source'])\\n    return '; '.join(ids)\\n\\ndef page_of(row):\\n    if row.get('page'):\\n        return row['page']\\n    for item in row.get('resolved', []):\\n        p = item['page']\\n        if isinstance(p, str) and p.strip().isdigit():\\n            return int(p)\\n    return None\\n\\n# ------------------------------------------------------------------ ledger headers\\nVISIBLE = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome',\\n           'Formality','Conditions level','Why and evidence','Source','Review','Reviewer note',\\n           'Correction']\\nGROUPED = ['Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\\n           'Price low','Price high','Price kind','Price origin','Currency',\\n           'All cash','Cash at closing','Conditions detail','Due date','Deadline treatment',\\n           'Round finality','Decided by','Exit reason','Outcome basis','Page','Related rows','Deal']\\nHEADERS = VISIBLE + GROUPED\\nCOL = {h: get_column_letter(i+1) for i, h in enumerate(HEADERS)}\\nCIDX = {h: i+1 for i, h in enumerate(HEADERS)}\\nLASTCOL = get_column_letter(len(HEADERS))\\n\\nwb = Workbook()\\nws = wb.active\\nws.title = 'Deal ledger'\\n\\nhdr_fill = PatternFill('solid', fgColor='1F3864')\\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\\ngrp_fill = PatternFill('solid', fgColor='D9E2F3')\\nthin = Side(style='thin', color='BFBFBF')\\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\\n\\nfor i, h in enumerate(HEADERS, 1):\\n    c = ws.cell(row=1, column=i, value=h)\\n    c.font = hdr_font\\n    c.fill = hdr_fill\\n    c.alignment = Alignment(vertical='center', wrap_text=True)\\n    c.border = border\\nws.row_dimensions[1].height = 28\\n\\n# ------------------------------------------------------------------ ledger rows\\nr = 1\\nfor row in ROWS:\\n    r += 1\\n    wd, wdm = WORKING[row['key']]\\n    n = r - 1\\n    vals = {\\n      '#': n,\\n      'When': row['when'],\\n      'Who': row['who'],\\n      'What happened': row['what'],\\n      'Process': row['process'],\\n      'Round': row['round'],\\n      'Type': row['type'],\\n      'Terms or outcome': row['terms'],\\n      'Formality': row['formality'],\\n      'Conditions level': row['cond_level'],\\n      'Why and evidence': why_text(row),\\n      'Source': src_text(row),\\n      'Review': row.get('review'),\\n      'Reviewer note': None,\\n      'Correction': None,\\n      'Row id': f'R{n:03d}',\\n      'Include': 'Yes',\\n      'Count': row.get('count'),\\n      'Date from': d(row.get('date_from')),\\n      'Date to': d(row.get('date_to')),\\n      'Working date': wd,\\n      'Date basis': row.get('date_basis'),\\n      'Date method': wdm,\\n      'Price low': row.get('price_low'),\\n      'Price high': row.get('price_high'),\\n      'Price kind': row.get('price_kind'),\\n      'Price origin': row.get('price_origin'),\\n      'Currency': row.get('currency'),\\n      'All cash': row.get('all_cash'),\\n      'Cash at closing': row.get('cash_close'),\\n      'Conditions detail': row.get('cond_detail'),\\n      'Due date': d(row.get('due_date') and str(row['due_date'])),\\n      'Deadline treatment': row.get('deadline_treatment'),\\n      'Round finality': row.get('round_finality'),\\n      'Decided by': row.get('decided_by'),\\n      'Exit reason': row.get('exit_reason'),\\n      'Outcome basis': row.get('outcome_basis'),\\n      'Page': page_of(row),\\n      'Related rows': row.get('related'),\\n      'Deal': 'Mac-Gray/CSC',\\n    }\\n    for h, v in vals.items():\\n        c = ws.cell(row=r, column=CIDX[h], value=v)\\n        c.border = border\\n        c.alignment = Alignment(vertical='top', wrap_text=True)\\n        if h in ('Date from', 'Date to', 'Working date', 'Due date') and isinstance(v, date):\\n            c.number_format = 'MM/DD/YYYY'\\n        if h in ('Price low', 'Price high', 'Cash at closing') and v is not None:\\n            c.number_format = '#,##0.00'\\n        if h == 'Count' and isinstance(v, (int, float)):\\n            c.number_format = '0'\\n    ws.row_dimensions[r].height = None\\n\\nLASTROW = r\\nws.auto_filter.ref = f'A1:{LASTCOL}{LASTROW}'\\nws.freeze_panes = 'C2'\\n\\nwidths = {'#':5,'When':22,'Who':24,'What happened':19,'Process':7,'Round':6,'Type':10,\\n          'Terms or outcome':60,'Formality':11,'Conditions level':11,'Why and evidence':70,\\n          'Source':16,'Review':8,'Reviewer note':16,'Correction':14,'Row id':7,'Include':8,\\n          'Count':7,'Date from':11,'Date to':11,'Working date':11,'Date basis':15,'Date method':16,\\n          'Price low':9,'Price high':9,'Price kind':12,'Price origin':13,'Currency':8,\\n          'All cash':9,'Cash at closing':11,'Conditions detail':58,'Due date':10,\\n          'Deadline treatment':16,'Round finality':16,'Decided by':10,'Exit reason':13,\\n          'Outcome basis':15,'Page':6,'Related rows':22,'Deal':12}\\nfor h, w in widths.items():\\n    ws.column_dimensions[COL[h]].width = w\\n\\n# group expandable columns (collapsed)\\ngroups = [('Row id','Include'), ('Count','Count'), ('Date from','Date method'),\\n          ('Price low','Currency'), ('All cash','Cash at closing'), ('Conditions detail','Conditions detail'),\\n          ('Due date','Round finality'), ('Decided by','Outcome basis'), ('Page','Page'),\\n          ('Related rows','Related rows'), ('Deal','Deal')]\\nfor a, b in groups:\\n    ws.column_dimensions.group(COL[a], COL[b], outline_level=1, hidden=True)\\nws.sheet_properties.outlinePr.summaryRight = True\\nws.sheet_properties.outlinePr.applyStyles = False\\n\\n# source hyperlinks (link Source cell to the main paragraph row in Source text)\\ndef src_row_map():\\n    m = {}\\n    n = 1\\n    for p in PARAS:\\n        n += 1\\n        m[p['id']] = n\\n    for x in XPASS:\\n        n += 1\\n        m[x['id']] = n\\n    return m\\n\\nSRCROWS = src_row_map()\\nfor row in ROWS:\\n    r = ROWS.index(row) + 2  # requires unique keys; rows are in order\\nfor i, row in enumerate(ROWS):\\n    rid = f'R{i+1:03d}'\\n    main = None\\n    for item in row.get('resolved', []):\\n        main = item['source']; break\\n    if main and main in SRCROWS:\\n        cell = ws.cell(row=i+2, column=CIDX['Source'])\\n        cell.hyperlink = f\\\"#'Source text'!A{SRCROWS[main]}\\\"\\n        cell.font = Font(color='0563C1', underline='single', size=10)\\n\\n# ------------------------------------------------------------------ Lists sheet\\nlists = {\\n 'What happened': ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement',\\n   'Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened',\\n   'Deadline set','Deadline revised','Deadline','Target decision','Information access changed',\\n   'Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid',\\n   'Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit',\\n   'Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced',\\n   'Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted',\\n   'Agreement terminated','Closed'],\\n 'Type': ['Strategic','Financial','Mixed','Unknown'],\\n 'Formality': ['Formal','Informal','Insufficient evidence','Varies'],\\n 'Conditions level': ['None','Light','Heavy','Insufficient evidence','Varies'],\\n 'Include': ['Yes','No'],\\n 'Date basis': ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\\n 'Date method': ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\\n 'Price kind': ['Point','Bidder range','Group envelope','Bound only','Undisclosed'],\\n 'Price origin': ['Stated','Carried forward','Inferred'],\\n 'All cash': ['Yes','No','Not stated'],\\n 'Deadline treatment': ['Enforced','Extended','Late bids accepted','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\\n 'Round finality': ['Announced as final','Inferred final','Not final'],\\n 'Decided by': ['Bidder','Target','Both','Unknown'],\\n 'Exit reason': ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\\n   'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\\n 'Outcome basis': ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\\n}\\nlws = wb.create_sheet('Lists')\\nlistcol = {}\\nfor i, (name, vals) in enumerate(lists.items(), 1):\\n    c = get_column_letter(i)\\n    listcol[name] = c\\n    lws.cell(row=1, column=i, value=name).font = Font(bold=True)\\n    for j, v in enumerate(vals, 2):\\n        lws.cell(row=j, column=i, value=v)\\n    lws.column_dimensions[c].width = max(12, min(30, len(name)+4))\\nlws.sheet_state = 'hidden'\\n\\n# data validation\\ndef add_dv(col_letter, list_name, rows=500):\\n    last = len(lists[list_name]) + 1\\n    dv = DataValidation(type='list', formula1=f'=Lists!${listcol[list_name]}$2:${listcol[list_name]}${last}',\\n                        allow_blank=True, showDropDown=False)\\n    ws.add_data_validation(dv)\\n    dv.add(f'{col_letter}2:{col_letter}{rows}')\\n\\nfor h, name in [('What happened','What happened'),('Type','Type'),('Formality','Formality'),\\n                ('Conditions level','Conditions level'),('Include','Include'),('Date basis','Date basis'),\\n                ('Date method','Date method'),('Price kind','Price kind'),('Price origin','Price origin'),\\n                ('All cash','All cash'),('Deadline treatment','Deadline treatment'),\\n                ('Round finality','Round finality'),('Decided by','Decided by'),('Exit reason','Exit reason'),\\n                ('Outcome basis','Outcome basis')]:\\n    add_dv(COL[h], name)\\n\\n# ------------------------------------------------------------------ AI original (values copy)\\nai = wb.create_sheet('AI original')\\nfor i, h in enumerate(HEADERS, 1):\\n    ai.cell(row=1, column=i, value=h).font = Font(bold=True)\\nfor i, row in enumerate(ROWS):\\n    r = i + 2\\n    wsrow = i + 2\\n    for h in HEADERS:\\n        ai.cell(row=r, column=CIDX[h], value=ws.cell(row=wsrow, column=CIDX[h]).value)\\nai.sheet_state = 'hidden'\\n\\n# ------------------------------------------------------------------ Source text sheet\\nst = wb.create_sheet('Source text')\\nfor i, h in enumerate(['Paragraph','Section','Page','Text'], 1):\\n    c = st.cell(row=1, column=i, value=h)\\n    c.font = hdr_font; c.fill = hdr_fill\\nst.column_dimensions['A'].width = 11\\nst.column_dimensions['B'].width = 46\\nst.column_dimensions['C'].width = 8\\nst.column_dimensions['D'].width = 150\\nr = 1\\nfor p in PARAS:\\n    r += 1\\n    st.cell(row=r, column=1, value=p['id'])\\n    st.cell(row=r, column=2, value=p['section'])\\n    st.cell(row=r, column=3, value=p['page'])\\n    c = st.cell(row=r, column=4, value=p['text']); c.alignment = Alignment(wrap_text=True, vertical='top')\\nfor x in XPASS:\\n    r += 1\\n    st.cell(row=r, column=1, value=x['id'])\\n    st.cell(row=r, column=2, value=x['section'])\\n    st.cell(row=r, column=3, value=x['page'])\\n    c = st.cell(row=r, column=4, value=x['text']); c.alignment = Alignment(wrap_text=True, vertical='top')\\nst.freeze_panes = 'A2'\\nSTLAST = r\\n\\n# ------------------------------------------------------------------ Summary sheet\\nsm = wb.create_sheet('Summary')\\nsm.column_dimensions['A'].width = 34\\nsm.column_dimensions['B'].width = 150\\n\\ndef block(title, lines):\\n    global smrow\\n    c = sm.cell(row=smrow, column=1, value=title)\\n    c.font = Font(bold=True, size=11, color='1F3864')\\n    smrow += 1\\n    for item, text in lines:\\n        a = sm.cell(row=smrow, column=1, value=item)\\n        a.alignment = Alignment(vertical='top', wrap_text=True)\\n        a.font = Font(size=10, bold=True)\\n        b = sm.cell(row=smrow, column=2, value=text)\\n        b.alignment = Alignment(vertical='top', wrap_text=True)\\n        smrow += 1\\n\\nsmrow = 1\\nblock('1. STATUS AND COMMERCIAL ACCOUNT', [\\n ('Status', 'AI first pass; not human-approved. Prepared under the instruction revision of 19 September 2026 (\\\"Reading a merger filing into a deal ledger\\\", Revision of 19 September 2026 \\\\u2014 Pro revision revised after audit against Alex Gorbenko\\\\u2019s collection instructions; the instruction text in this folder is 19 September 2026).'),\\n ('Source coverage', 'Single supplied filing: mac-gray_2013-12-04_DEFM14A.htm \\\\u2014 Mac-Gray Corporation DEFM14A filed 12/04/2013 (177 component pages incl. Annexes A\\\\u2013D). Complete Background of the Merger (printed pp.27\\\\u201341) transcribed in Source text; every additional passage used is X-001\\\\u2013X-030. No outside sources, market data or third-party knowledge used.'),\\n ('Account', 'Mac-Gray, a NYSE-listed laundry-facilities manager (NYSE: TUC), faced activist pressure from Moab Partners (a ~9% holder that elected two directors at the 05/30/2013 annual meeting) and began a target-led sale review in mid-2013 under a Special Committee of six independent directors formed to manage insider-conflict issues. BofA Merrill Lynch approached 50 potential buyers (15 strategic, 35 financial); 20 signed confidentiality agreements, and four bid: strategic Party A (an industry party), strategic CSC/Pamplona (CSC ServiceWorks, a Pamplona portfolio company), and financial bidders Party B and Party C. Party A\\\\u2019s early $17.00\\\\u2013$19.00 proposal (06/21/2013) was overtaken as CSC/Pamplona raised through $18.50 (07/23), $19.50 (09/09) and $20.75 (09/18); Party B\\\\u2019s final package (valued by Party B at $21.50 = $19.00 cash plus options) and Party A\\\\u2019s best-and-final $18.00\\\\u2013$19.00 were judged less certain, and Party C stopped bidding without explanation. On 09/21/2013 CSC/Pamplona confirmed $21.25 all-cash as its last and best offer in exchange for a two-week exclusivity, and on 10/14/2013 \\\\u2014 after negotiating the Mac-Gray termination fee down from $15 million to $11 million \\\\u2014 the parties signed a $21.25 all-cash merger agreement, announced 10/15/2013.'),\\n ('Observed outcome', 'Signing, not closing. No post-signing competing proposal or go-shop activity is reported; HSR clearance was awaited (waiting period expired 11/27/2013), the special meeting was set for 01/08/2014 and closing was expected in January 2014 (first half of 2014 per the merger-agreement section).'),\\n ('Last recheck status', 'First delivery; no reviewer edits yet. AI original is an exact values-only copy of this ledger at delivery. Changed-cell highlighting (red bold by Row id and column vs AI original) is not implemented \\\\u2014 an explicit Correction column is provided next to Reviewer note (see Questions, check 8).'),\\n])\\n\\nblock('2. DEAL FACTS', [\\n ('Target', 'Mac-Gray Corporation, 404 Wyman Street, Suite 400, Waltham, Massachusetts 02451 (Delaware corporation; NYSE symbol TUC). Second-largest US laundry facilities management contractor; sells/services commercial laundry equipment through its product sales division.'),\\n ('Focal acquirer and type', 'CSC ServiceWorks, Inc. (CSC), a Delaware corporation and Pamplona Capital Partners III, L.P. portfolio company \\\\u2014 Strategic. Acquires through Spin Holdco Inc. (Parent, wholly owned by CSC), CSC Fenway, Inc. (Merger Subsidiary), with CSC ServiceWorks Holdings, Inc. (sole stockholder of CSC). Pamplona is the owner/financier of the acquirer, not a separate bidder; parent and acquisition shells are one bidder unit.'),\\n ('Agreed consideration', '$21.25 per share in cash, without interest, less applicable withholding \\\\u2014 all cash; fixed cash payable at closing $21.25 (R053). Labelled calculation (not a filing-stated aggregate): 14,758,306 shares \\\\u00d7 $21.25 = $313,614,002.50.'),\\n ('Signing / announcement / completion', 'Agreement and Plan of Merger dated as of 10/14/2013 (R053); joint announcement 10/15/2013 before market open (R054); completion not observed in this filing \\\\u2014 expected January 2014 (merger-agreement section: first half of 2014). Expected closing kept separate from the observed record.'),\\n ('Filing identity', 'Mac-Gray Corporation DEFM14A, filed 12/04/2013; source file mac-gray_2013-12-04_DEFM14A.htm; Background of the Merger at printed pp.27\\\\u201341; merger agreement Annex A; BofA fairness opinion Annex B; DGCL \\\\u00a7262 Annex C; form of voting agreement Annex D.'),\\n ('Vote and process protections', 'Merger agreement adoption requires a majority of outstanding shares; voting agreements covered \\\\u224815% of shares (Moab, Mr. MacDonald and family entities). Mac-Gray termination fee $11 million (\\\\u22483.2% of equity value per the filing); Parent termination fee $15 million (regulatory reverse fee); Pamplona damages liability capped at $50 million (Buyer Entities unlimited); no financing condition; no go-shop, with a fiduciary out for a superior proposal.'),\\n ('Special meeting items', '01/08/2014 special meeting: (1) adopt the merger agreement; (2) advisory (non-binding) \\\"golden parachute\\\" compensation vote; (3) adjournment proposal.'),\\n])\\n\\nblock('3. PROCESS AND ROUND MAP', [\\n ('Process 1 outcome', 'One continuing Mac-Gray sale process (June 2013 \\\\u2192 signing 10/14/2013). The 2011-2012 Discussions were Mac-Gray\\\\u2019s own attempt to acquire CSC (R001, R006) \\\\u2014 retained only as mandate/initiation context, not a Mac-Gray sale process; no second sale attempt is observed.'),\\n ('Round 0 (pre-opening)', 'Context only, no Round-opened row: 2011-2012 Discussions; 04/05/2013 Board authorization (R002); 04/08/2013 Party A contact (R003); 06/21/2013 Party A $17.00\\\\u2013$19.00 proposal (R009, still standing into round 1 \\\\u2014 Party A is a round-1 participant).'),\\n ('Round 1 (06/24/2013 \\\\u2013 07/23/2013)', 'Opened on the Special Committee\\\\u2019s 06/24/2013 decision to consider a sale and approach 50 parties \\\\u2014 no outreach was reported before that directive, and execution began within days (first NDA 06/28/2013). Rejected boundary candidates preserved as rows: R002, R003, R007, R012\\\\u2013R013, R014. Purpose: preliminary indications of interest; deadline 07/23/2013 (set with the informational packages, R017) \\\\u2014 Late bids accepted (Party B 07/24; Party C 07/24\\\\u201307/25, considered 07/25). Round-1 bidders: 4 (three IOIs plus Party A\\\\u2019s standing proposal); 16 residual signers inferred non-submitters (R019, R021). Finality: Not final.'),\\n ('Round 2 (08/27/2013 \\\\u2013 09/09/2013)', 'Opened on the 08/27/2013 letter requesting revised written proposals once all four bidders\\\\u2019 diligence was substantially complete (authorized 08/15/2013). Deadline 09/09/2013 \\\\u2014 Late bids accepted (Party A and Party C 09/10, reviewed 09/11). Round-2 bidders: 4. Finality: Not final.'),\\n ('Round 3 (09/11/2013 \\\\u2013 09/18/2013)', 'Opened on the first request for final indications of interest (calls made 09/11/2013). Deadline 09/18/2013 \\\\u2014 Enforced (three responses; selection step 09/19). Round-3 bidders: 3 (CSC/Pamplona $20.75; Party A best-and-final reiteration; Party B $21.50 package); Party C did not submit (R040). CSC/Pamplona confirmed $21.25 last-and-best 09/21 (R042); exclusivity authorized 09/23 (R043). Finality: Announced as final.'),\\n ('Round 4 (09/24/2013 \\\\u2013 10/14/2013)', 'Opened on the move to exclusive definitive negotiation with the selected bidder (exclusivity executed 09/24, R044; initial merger-agreement draft 09/25, R048). Round-4 bidders: 1 (CSC/Pamplona). Finality: Inferred final. Ends with signing 10/14/2013 (R053).'),\\n ('Post-signing', 'No competing proposals or go-shop activity observed. Announcement 10/15/2013 (R054); proxy statement 12/04/2013 and special-meeting scheduling (R055). Signing is not treated as Process terminated.'),\\n ('Exclusivity history', 'Requested with the 09/09 and 09/18 bids; authorized 09/23 (R043); executed 09/24 until 5 p.m. ET 10/12 (R044); extension authorized 10/09 (R050); letter agreement 10/12 extended to 11:59 p.m. ET 10/15 (R051).'),\\n ('Deadline history', '07/23/2013 IOI deadline (set with the packages; R017/R020) \\\\u2014 Late bids accepted; 09/09/2013 revised-proposal deadline (R028/R029) \\\\u2014 Late bids accepted; 09/18/2013 final-indication deadline (R035/R036) \\\\u2014 Enforced. No bid deadline was revised or extended; the two exclusivity expiries are not bid deadlines.'),\\n])\\n\\nblock('4. PARTICIPANTS AND ADVISERS', [\\n ('Party A \\\\u2014 Strategic', 'Anonymized strategic party in the laundry facilities management industry. First contacted 04/08/2013 (R003); unsolicited all-cash $17.00\\\\u2013$19.00 proposal 06/21/2013 (R009, round 0; still standing into round 1); NDA 08/05/2013 after stalled non-solicitation terms (R027); revised IOI 09/10/2013 $18.00\\\\u2013$19.00 (R032); best-and-final reiteration 09/18/2013 (R038, Formal, Heavy). Closed: Dropped by target at the 09/24/2013 exclusivity execution (R045; Inferred: exclusivity; Decided by Target; reason not stated).'),\\n ('Party B \\\\u2014 Financial', 'Anonymized financial bidder. NDA 06/28/2013 (R014); IOI 07/24/2013 $17.00\\\\u2013$18.00 (R023); revised IOI 09/09/2013 $18.50 with no firm financing commitment (R031); final package 09/18/2013 valued by Party B at $21.50 ($19.00 cash at closing plus options worth $2.50) (R039; Formal, Heavy). Closed: Dropped by target at the 09/24/2013 exclusivity execution (R046; Inferred: exclusivity; Decided by Target; reason not stated).'),\\n ('Party C \\\\u2014 Financial', 'Anonymized financial bidder. NDA 06/30/2013 (R015); oral IOI 07/24/2013 $15.00\\\\u2013$17.00 and written indication 07/25/2013 $16.00\\\\u2013$16.50 (R024); revised oral IOI 09/10/2013 $16.00\\\\u2013$17.00 (R033); did not submit or reiterate in the final round and gave no reasons. Closed: Did not submit at the 09/18/2013 deadline (R040, stated).'),\\n ('CSC/Pamplona \\\\u2014 Strategic (winner)', 'CSC ServiceWorks, Inc. with Pamplona Capital Partners III, L.P. (one bidder unit; filing treats them as a strategic bidder pair). NDA 07/11/2013 (R018); IOIs $18.50 07/23 (R022), $19.50 09/09 with 100% capital commitment (R030), $20.75 09/18 (R037), $21.25 last-and-best 09/21 conditional on two-week exclusivity (R042); exclusivity 09/24 (R044); signed 10/14/2013 (R053). No exit row \\\\u2014 the winner.'),\\n ('Residual cohort', '16 remaining financial bidders (20 signers less the four individually recorded: 2 strategic + 18 financial per the filing; Party B and Party C are individually recorded). Entry at the NDA wave (R019, Count 16); inferred non-submitters at the 07/23/2013 solicitation (R021, Count 16).'),\\n ('Non-entrants', '30 of the 50 approached parties did not sign confidentiality agreements or bid; no individual outcomes are disclosed and none are invented.'),\\n ('Ownership / country attributes (disclosed)', 'Moab Capital Partners, LLC / Michael M. Rothenberg \\\\u22489.07% (1,338,127 shares); Stewart G. MacDonald, Jr. \\\\u224816.65% (2,456,568 shares, incl. trusts); Cynthia V. Doggett 16.65%; directors and executive officers as a group (14 persons) 35.04%; all entities Delaware/US unless stated. Mr. Rothenberg is Moab\\\\u2019s co-founder and General Partner; the board also included a Moab-nominated director (Mr. Hyman).'),\\n ('Group / funding relationships', 'No bidding-group change occurred: no independent bidder joined (or left for) another\\\\u2019s bidding unit (no \\\"Bidding group changed\\\"/\\\"Joined group\\\" rows). Moab\\\\u2019s possible equity rollover with CSC/Pamplona was denied (07/06/2013), later permitted to be discussed and resolved without a rollover (10/07/2013) \\\\u2014 R016, R049. Pamplona\\\\u2019s $594 million commitment supports the CSC bid \\\\u2014 recorded on the bid/signing rows, not as a group change.'),\\n ('Advisers', 'BofA Merrill Lynch \\\\u2014 financial adviser to Mac-Gray: engaged 10/23/2012 for the 2011-2012 Discussions (R001), terminated 05/15/2013 (R006), re-engaged for the strategic-alternatives review 05/30\\\\u201305/31/2013 (R007); fairness opinion 10/14/2013 (R052). Goodwin Procter LLP \\\\u2014 outside legal counsel to Mac-Gray; service observed from 05/09/2013; no engagement date disclosed (R005). Kirkland & Ellis LLP \\\\u2014 outside legal counsel to CSC/Pamplona; service observed from 09/25/2013 (R048). MacKenzie Partners, Inc. \\\\u2014 proxy solicitor; expected retention at \\\\u2248$15,000 reported 12/04/2013 (R055). No unclear client affiliations remain.'),\\n])\\n\\nblock('5. COUNTS AND AUCTION SCREEN', [\\n ('Contacts (filing assertion)', '50 parties contacted: 15 potential strategic buyers and 35 potential financial buyers (R012, R013). Ledger-derived contact tally (SUMIFS, Include = Yes): '),\\n ('Contact total formula', \\\"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"Contact\\\\\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")\\\"),\\n ('Contacts \\\\u2014 reconciliation', 'The SUMIFS = 50 (15 + 35). Row R003 (Party A first contact, 04/08/2013) carries Count 0 because Party A is already inside the 15-party strategic cohort \\\\u2014 it is a first-contact record, not an additive unit; do not sum to 51.'),\\n ('NDAs (filing assertion)', '20 potential bidders signed confidentiality and standstill agreements: 2 strategic (Party A, CSC/Pamplona) and 18 financial (including Party B and Party C).'),\\n ('NDA total formula', \\\"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"NDA signed\\\\\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")\\\"),\\n ('NDAs \\\\u2014 reconciliation', 'The SUMIFS = 20: individually recorded R014 (Party B), R015 (Party C), R018 (CSC/Pamplona), R027 (Party A) + residual cohort R019 (16 financial signers) = 20. No double counting of named members.'),\\n ('Round-bidder tallies (ledger)', 'Round 1: 3 Count units for round-1 submissions (R022\\\\u2013R024) + Party A\\\\u2019s standing round-0 proposal shown as a round-1 participant (R009/R011) = 4 bidders. Round 2: 4 (R030\\\\u2013R033). Round 3: 3 (R037, R038, R039; R042 is a Count-0 same-round increase). Round 4: 1 (selected definitive negotiator; no Bid rows).'),\\n ('Round 2 formula', \\\"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"Bid\\\\\\\",'Deal ledger'!$E:$E,1,'Deal ledger'!$F:$F,2,'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")\\\"),\\n ('Round 3 formula', \\\"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"Bid\\\\\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")+SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"Bid reaffirmed\\\\\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")\\\"),\\n ('Outcome tallies (affected units)', 'Dropped by target: '),\\n ('Dropped formula', \\\"=SUMIFS('Deal ledger'!$R:$R,'Deal ledger'!$D:$D,\\\\\\\"Dropped by target\\\\\\\",'Deal ledger'!$Q:$Q,\\\\\\\"Yes\\\\\\\")\\\"),\\n ('Did not submit', '=SUMIFS(\\\\'Deal ledger\\\\'!$R:$R,\\\\'Deal ledger\\\\'!$D:$D,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$Q:$Q,\\\"Yes\\\")'),\\n ('Per-stage balance (process 1)', 'Entered 20 (R014/R015/R018/R027 individually + R019 residual cohort = 20 signers, each counted once) \\\\u2212 stated exits 1 (Party C, Did not submit) \\\\u2212 inferred exits 18 (16 residual non-submitters + Party A and Party B dropped by exclusivity) = continuing 1 (CSC/Pamplona, the winner). Inferred share of exits: 18 of 19. No participant is left unclosed; the balance is exact because the filing states the signer population (20).'),\\n ('Auction screen', 'Met. More than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for the process: 20 signers including at least four independently evidenced units (Party A, CSC/Pamplona, Party B, Party C). Lender-only, adviser and rollover-holder agreements excluded (none exist here). Sample eligibility remains a research decision.'),\\n ('Do not add steps', 'Contacts (50 parties reached) \\\\u2260 submissions (round-1: 3; round-2: 4; round-3: 3) \\\\u2260 unique firms (20 entrants) \\\\u2260 outcomes (19 affected units) \\\\u2260 NDA signers (20). Different steps must not be summed.'),\\n])\\n\\nblock('6. COMPARABILITY AND INPUTS', [\\n ('Shares and ownership', '14,758,306 shares issued and outstanding (11/27/2013); \\\\u2248104 record holders; \\\\u224815% subject to voting agreements; Moab \\\\u22489.07%; Mr. S. MacDonald \\\\u224816.65%; directors and officers as a group 35.04%.'),\\n ('Market prices and premiums', 'Closing prices: $14.72 on 10/11/2013 (last trading day before Board approval); $14.93 on 10/14/2013 (last full trading day before announcement); $21.30 on 11/27/2013. 52-week high for the period ending 10/11/2013: $15.61. Stated premiums vs $21.25: \\\\u224836% over the 52-week high and \\\\u224844% over the $14.72 close.'),\\n ('Adviser analyses (not offers)', 'BofA implied per-share reference ranges from selected public companies: $13.50\\\\u2013$18.75 (2013E without acquisitions), $13.75\\\\u2013$19.00 (2013E with acquisitions), $13.75\\\\u2013$19.25 (2014E without), $12.75\\\\u2013$19.25 (2014E with) versus the $21.25 consideration; 20 selected precedent transactions included the May 1, 2013 Coinmach/Pamplona transaction. Analysis only \\\\u2014 not recorded as bids.'),\\n ('Contingent / non-cash consideration', 'Party B\\\\u2019s 09/18/2013 package: $19.00 cash at closing plus options = 10% of new equity, strike equal to Party B\\\\u2019s initial cost basis, vesting over five years on achievement of base-case management projections (excluding future acquisitions); Party B valued the options at $2.50/share, for a stated package value of $21.50. All cash = No; Cash at closing = $19.00; the $2.50 option value is not guaranteed cash.'),\\n ('Financing inputs', 'Pamplona commitment letter dated 10/14/2013: $594 million of capital; no financing condition to the Buyer Entities\\\\u2019 obligations; Pamplona and the Buyer Entities jointly and severally liable for damages, with Pamplona capped at $50 million (Buyer Entities unlimited); CSC reverse termination fee $15 million; Mac-Gray termination fee negotiated from $15 million (Kirkland\\\\u2019s 10/07 proposal, \\\\u22484.4% of equity value) to $11 million (\\\\u22483.2%).'),\\n ('Projections', 'Management Projections prepared June 2013 (without-acquisitions and with-acquisitions cases; 2013\\\\u20132018), provided to the Special Committee and BofA; not updated for the merger. Used in the fairness opinion.'),\\n ('Other-scope proposals', 'None disclosed. All four bids were for the whole company; no segment, asset, minority-stake or other-scope proposals appear. The 2011-2012 Discussions concerned Mac-Gray\\\\u2019s possible acquisition of CSC and are not an other-scope bid for Mac-Gray.'),\\n ('Glossary', 'NDA = confidentiality/non-disclosure agreement; IOI = indication of interest; LOI = letter of intent (not used here); Party A/B/C = filing\\\\u2019s anonymized bidders; CSC/Pamplona = one bidder unit (CSC ServiceWorks with Pamplona as owner/financier); Round 0 = pre-opening approaches and standing proposals; Round finality = whether the round was announced/inferred final; Inferred closing = a participant closed by arithmetic/transition without a stated exit; Working date = assigned sort key with a stated method, not an observed date; Auction screen = whether >1 independent bidder unit signed bidder-target confidentiality agreements.'),\\n])\\nsm.freeze_panes = 'A2'\\n\\n# ------------------------------------------------------------------ Questions sheet\\nqs = wb.create_sheet('Questions')\\nqheaders = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields',\\n            'Consequence of changing it','Status','Reviewer note']\\nfor i, h in enumerate(qheaders, 1):\\n    c = qs.cell(row=1, column=i, value=h)\\n    c.font = hdr_font; c.fill = hdr_fill; c.alignment = Alignment(wrap_text=True, vertical='center')\\nqs.column_dimensions['A'].width = 6\\nqs.column_dimensions['B'].width = 26\\nqs.column_dimensions['C'].width = 70\\nqs.column_dimensions['D'].width = 70\\nqs.column_dimensions['E'].width = 26\\nqs.column_dimensions['F'].width = 40\\nqs.column_dimensions['G'].width = 10\\nqs.column_dimensions['H'].width = 20\\n\\nQUESTIONS = [\\n (\\\"Q1\\\", \\\"Process and round map; Round-1 anchor and rejected boundaries\\\",\\n  \\\"Adopt one process and four analytical rounds as recorded: R1 opens 06/24/2013 on the Special Committee\\\\u2019s decision to consider a sale and approach 50 parties (executed by BofA outreach within days; first NDA 06/28/2013); R2 opens 08/27/2013 on the revised-proposal letter; R3 opens 09/11/2013 on the first request for final indications of interest (Announced as final); R4 opens 09/24/2013 on the move to exclusive definitive negotiation with the selected bidder (Inferred final). Round 0 holds the 2011-2012 Discussions, the 04/05/2013 authorization, the 04/08/2013 Party A contact and the 06/21/2013 Party A proposal, with Party A shown as a round-1 participant because its proposal was standing when round 1 was evaluated. Alternative: the smallest map is three rounds, folding the definitive-negotiation phase into R3; if so, delete/Include=No R047 and move R044\\\\u2013R053 to R3.\\\",\\n  \\\"Boundaries: the filing reports no target outreach before the 06/24/2013 directive, and BofA\\\\u2019s contacts began within days (background pp.31\\\\u201332); R3 is the first \\\\u201cfinal\\\\u201d request (p.36) and the exclusivity stage follows the final stage (pp.37\\\\u201338). Rejected R1 boundary candidates are preserved as their own rows: R002 (authorization), R003 (Party A call), R007 (engagement letter), R012\\\\u2013R013 (outreach wave), R014 (first NDA). R4 rests on the instruction\\\\u2019s trigger \\\\u201cmoves to definitive negotiation with selected bidders\\\\u201d and its \\\\u201cInferred final\\\\u201d definition; the counter-reading is that the exclusivity is \\\\u201cinside an established final negotiation stage\\\\u201d.\\\",\\n  \\\"R010, R011 (R1); R028 (R2); R035 (R3); R043, R044, R047 (R4); boundary rows R002, R003, R007, R012\\\\u2013R014; Round fields and Round finality on all Round-opened rows\\\",\\n  \\\"If R4 is folded into R3: round count 4 \\\\u2192 3; R3 gains the definitive-negotiation phase; the R4 round-bidder tally (1) disappears; no participant outcome changes. If the R1 anchor moves to 06/28\\\\u201307/23, Round 1\\\\u2019s opening date and some count context shift.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q2\\\", \\\"Deadline history and treatments\\\",\\n  \\\"Keep as recorded: IOI deadline 07/23/2013 (set with the informational packages between 06/28 and 07/23; estimated Working date 07/10) \\\\u2014 Late bids accepted (Party B 07/24; Party C 07/24\\\\u201307/25, both considered 07/25); revised-proposal deadline 09/09/2013 \\\\u2014 Late bids accepted (Party A and Party C 09/10, reviewed 09/11); final-indication deadline 09/18/2013 \\\\u2014 Enforced (three responses; selection step 09/19). The exclusivity expiries (10/12, 10/15) are not bid deadlines.\\\",\\n  \\\"Deadline instructions at background pp.32 and p.35; late submissions and the meetings that considered them at pp.33\\\\u201336; the 09/19 selection step at pp.36\\\\u201337. No deadline revision is reported, so no Deadline revised row exists; the July 23 due date and its late acceptance are preserved in R017/R020.\\\",\\n  \\\"R017, R020 (07/23); R028, R029 (09/09); R035, R036 (09/18); Deadline treatment fields and the Summary deadline map\\\",\\n  \\\"Reclassifying 07/23 or 09/09 from Late bids accepted to Unclear/Enforced would change the deadline map and could move late bids out of their round\\\\u2019s submission count; the 09/18 treatment is robust unless the reviewer reads the 09/21 $21.25 confirmation as a new solicitation.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q3\\\", \\\"Participants, NDA/contact counts, residual base and inferred closings\\\",\\n  \\\"Accept the population: 50 parties contacted (15 + 35), 20 NDA signers (2 strategic + 18 financial), 4 individually recorded, residual cohort of 16 financial signers. Close-outs: 16 residual non-submitters at 07/23/2013 (Count 16; Inferred: residual \\\\u2014 20 \\\\u2212 4 = 16); Party C Did not submit at 09/18/2013 (stated, Count 1); Party A and Party B Dropped by target at the 09/24/2013 exclusivity execution (Inferred: exclusivity, Count 1 each). The 30 contacted non-signers never entered and get no outcome rows.\\\",\\n  \\\"Base and continuing sets: p.32 (20 signers; 2 + 18 split) and p.34 (the four advanced at the 07/25/2013 meeting); Party C\\\\u2019s non-submission is expressly reported (p.36); exclusivity execution p.38 closes live rivals. Uncertainty: the base assumes all 20 signers were covered by the 07/23/2013 solicitation, but signings are described \\\\u201cover the next two months\\\\u201d (to late August) and Party A signed only on 08/05/2013 \\\\u2014 if some residual signers post-date 07/23, the non-submitting set is smaller (or some should be closed at a later transition). Party A\\\\u2019s 04/08/2013 contact carries Count 0 because it sits inside the 15-party strategic cohort (R012).\\\",\\n  \\\"R003, R012\\\\u2013R013, R019, R021, R040, R045, R046; Count fields; Summary balance\\\",\\n  \\\"Splitting or resizing the residual cohort changes the inferred-exit count and the per-stage balance; if any of the 16 later submitted an IOI not reported in the narrative, the residual overstates non-submission \\\\u2014 the filing\\\\u2019s exhaustive-sounding list (Party B, Party C, CSC/Pamplona and Party A\\\\u2019s standing proposal) argues against that.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q4\\\", \\\"Formality and conditions borderlines\\\",\\n  \\\"As recorded: July IOIs are Informal and Heavy by context (made before data-room/management access); September revised IOIs remain Informal except the three final-round responses, which are Formal (R037, R038, R039 \\\\u2014 responses on the requested basis to the 09/11/2013 final-indications request), with Party A Formal on an oral best-and-final price confirmation; conditions are Heavy for Party A and Party B (no firm financing commitment), Light for CSC/Pamplona (Pamplona committed 100% of capital; no diligence condition attached) and Light for the 09/21/2013 $21.25 confirmation (carried forward). No Conditions level turns on a stated diligence period, no row is None, and there is no late reconfirmation row (the winner\\\\u2019s latest priced bid is Formal and sits in an Announced-as-final round, so the section 9.1 late-reconfirmation test fails).\\\",\\n  \\\"Formality signals: final-indications request p.36; responses p.36. Conditions: no firm commitment for Party B (p.35) and Party A/Party C (p.35); Pamplona commitment (pp.35\\\\u201336); pre-access IOIs (pp.33\\\\u201334 data-room staging). The winner reached signing with a Formal row (R037) \\\\u2014 no gap.\\\",\\n  \\\"R009, R022\\\\u2013R024, R030\\\\u2013R033, R037\\\\u2013R039, R042; Formality, Conditions level and Conditions detail fields\\\",\\n  \\\"Reclassifying any September IOI as Informal, or the final responses as Formal, changes the formality tallies and the Conditions detail strings; prices, outcomes and the round map are unaffected.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q5\\\", \\\"Price and consideration conventions; scope\\\",\\n  \\\"Keep as recorded: per-share cells in USD only; Party A\\\\u2019s ranges as Bidder range with Carried forward on the 09/18/2013 reaffirmation; Party B\\\\u2019s 09/18/2013 package entered as a Point at $21.50 (Party B\\\\u2019s stated value) with All cash = No and Cash at closing $19.00; Party C\\\\u2019s oral-to-written July indications treated as one bid with the written range recorded; no Bound only rows; no other-scope bids; signing row carries the agreed $21.25 in text only (no price cells).\\\",\\n  \\\"Package value: p.36 (\\\\u201cParty B valued at $21.50 \\\\u2026 $19.00 of cash \\\\u2026 options \\\\u2026 valued the Party B options at $2.50\\\\u201d); carried price p.36 (reiteration of the previous $18.00\\\\u2013$19.00 indication); one-communication convention applied to Party C (pp.33\\\\u201334); no other-scope proposals appear anywhere in the filing.\\\",\\n  \\\"R024, R032, R038, R039, R053; Price low/high/kind/origin, All cash, Cash at closing, Terms or outcome\\\",\\n  \\\"If the reviewer prefers not to enter bidder-assigned package values in price cells, blank R039\\\\u2019s price cells and keep $21.50/$19.00/$2.50 in text; carried-forward vs restated on R038 changes Price origin only. No totals depend on these cells.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q6\\\", \\\"Moab/MacDonald rollover rows and the two-row convention\\\",\\n  \\\"Keep three rows: R016 (rollover denied as premature, 07/06/2013), R034 (Mr. MacDonald\\\\u2019s rollover question resolved and his support position, 09/11\\\\u201309/12/2013) and R049 (Moab discussions permitted 09/23/2013 and resolved without a rollover, reported 10/07/2013). No separate row for the 09/23/2013 permission, per the instruction\\\\u2019s \\\\u201cat most one row when permitted, denied or formed and one when resolved\\\\u201d convention for rollover relationships.\\\",\\n  \\\"Denial and rationale p.32\\\\u201333; permission p.38; discussions and determination pp.38\\\\u201339; MacDonald\\\\u2019s position pp.35\\\\u201336. The filing never shows a formed rollover or any financing-support relationship between Moab and CSC/Pamplona, and no voting/group change results.\\\",\\n  \\\"R016, R034, R049; Material process update rows; Summary group/funding note\\\",\\n  \\\"Adding a fourth row for the 09/23/2013 permission changes row counts only; reclassifying these as Bidding group changed would be wrong (a rollover holder is not a bidding-unit member) and would distort the unit counts.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q7\\\", \\\"Assigned Working dates and display order within rounds\\\",\\n  \\\"Accept the disclosed conventions: R012/R013 (wave) use the first day of the reported window (06/24/2013); R017 uses the midpoint of 06/28\\\\u201307/23 (07/10/2013); R019 is moved earlier inside its window to 07/23/2013 (Assigned: sequence) so the residual cohort\\\\u2019s entry precedes its inferred non-submission; R024 and R034 use the first day of a reported interval; R045/R046 use the transition date (Assigned: decision day); R049 uses the 10/07/2013 report bound. Sorting by Working date with # as tiebreak reproduces the reading order; no Working date falls outside its own window. Source quirks retained: the filing\\\\u2019s \\\\u201cJuly 27, 2103\\\\u201d typo (R027; intended 2013) and a duplicated sentence in the informational-package paragraph (Source text P-023).\\\",\\n  \\\"Rules applied from the instruction, section 8.1; the order constraint drove R019\\\\u2019s sequence assignment (entry must precede R021\\\\u2019s inferred closing); each affected row\\\\u2019s reason states its convention.\\\",\\n  \\\"R012, R013, R017, R019, R024, R034, R045, R046, R049; Date from/to, Working date, Date basis/method fields\\\",\\n  \\\"Changing any convention moves only display order (and possibly the entry-before-outcome check for R019/R021); facts, counts and outcomes are unaffected.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q8\\\", \\\"Exclusivity row granularity\\\",\\n  \\\"Keep four Exclusivity changed rows: authorized 09/23/2013 (R043), executed 09/24/2013 (R044), extension authorized 10/09/2013 (R050), extended by letter agreement 10/12/2013 (R051), each stating the actual vs scheduled state. Alternative: merge authorized+executed and authorized+extended into two rows (granted; extended).\\\",\\n  \\\"Authorization p.38 and execution p.38; extension request and authorization pp.40\\\\u201341; letter agreement p.41. The instruction asks the row to state which state (requested/authorized/granted/extended/ended) it records.\\\",\\n  \\\"R043, R044, R050, R051; Exclusivity changed rows and Summary exclusivity history\\\",\\n  \\\"Merging to two rows changes row count and the exact timing record for the 09/23 authorization and 10/09 authorization; no bid, count or outcome changes.\\\",\\n  \\\"Pending\\\", None),\\n]\\nr = 1\\nfor q in QUESTIONS:\\n    r += 1\\n    for i, v in enumerate(q, 1):\\n        c = qs.cell(row=r, column=i, value=v)\\n        c.alignment = Alignment(vertical='top', wrap_text=True)\\n        c.border = border\\n\\n# check results below\\nr += 2\\nc = qs.cell(row=r, column=1, value='CHECK RESULTS (instruction section 13) \\\\u2014 run on this delivered version')\\nc.font = Font(bold=True, size=11, color='1F3864')\\nr += 1\\nchk_hdr = ['Check','Scope and method','Result','Notes / affected rows; consequences']\\nfor i, h in enumerate(chk_hdr, 1):\\n    c = qs.cell(row=r, column=min(i+1,8), value=h)\\n    c.font = Font(bold=True)\\n    c.fill = PatternFill('solid', fgColor='D9E2F3')\\nCHECKS = [\\n (\\\"1. Coverage and materiality\\\",\\n  \\\"Reading the full filing against the ledger\\\",\\n  \\\"Passed\\\",\\n  \\\"All disclosed core proposals (11 priced Bid rows + R038 reaffirmation + R042 increase), contacts and NDAs (50 approached; 20 signed), the differentiated-access decision (R026), selection/exclusivity (R041\\\\u2013R047), signing (R053) and announcement (R054) are accounted for; regulatory/litigation facts are confined to Summary. Supplied-source limits (single filing; no post-DEC-2013 events) stated in Summary; inferred closings explicit.\\\"),\\n (\\\"2. Counts and population\\\",\\n  \\\"Formula/logic check and Sumary reconciliation\\\",\\n  \\\"Qualified\\\",\\n  \\\"Sums reconcile: contacts 50 (15+35; R003 Count 0), NDAs 20 (4 named + 16 residual), round bidders 4/4/3/1, outcomes 2 dropped + 17 did-not-submit + 1 winner = 20 entrants. Qualification: the residual base assumes all 20 signers were eligible for the 07/23/2013 solicitation (some signings may be later \\\\u2014 Q3); Party A contact overlap documented rather than silently zeroed.\\\"),\\n (\\\"3. Participation continuity\\\",\\n  \\\"Per-bidder history and per-stage stock\\\",\\n  \\\"Passed\\\",\\n  \\\"Each of the 20 entrants closes exactly once: Party C stated; 16 residual + Party A + Party B inferred; CSC/Pamplona signs. Stock never negative and only the winner remains after 09/24/2013. No bid, reaffirmation or resumed diligence follows a recorded outcome, so no Re-entered row is required.\\\"),\\n (\\\"4. Dates and order\\\",\\n  \\\"Programmatic check of ordering and windows; reading check of intervals\\\",\\n  \\\"Qualified\\\",\\n  \\\"All Working dates are filled and non-decreasing in # order; each lies inside its row\\\\u2019s Date from/to; Reported/Inferred methods pair exactly with their bases; assigned methods used elsewhere. Qualification: the conventions in Q7 (bounds, midpoints, sequence) are analytical; not recalculated in Excel (written formulas verified programmatically).\\\"),\\n (\\\"5. Offers and classifications\\\",\\n  \\\"Field-level review of all Bid/Bid reaffirmed rows\\\",\\n  \\\"Qualified\\\",\\n  \\\"Every Bid/Bid reaffirmed row has Formality, Conditions level and a fixed-format Conditions detail string; price kinds/origins/cash flags agree with the text; signing has no price/formality/conditions cells; Party B\\\\u2019s package is All cash = No with $19.00 closing cash. Qualification: the formality and Heavy-by-context calls are judgment (Q4); Party B\\\\u2019s bidder-assigned option value is recorded per the package convention (Q5).\\\"),\\n (\\\"6. Structure and consistency\\\",\\n  \\\"Structural audit across ledger and Summary\\\",\\n  \\\"Passed\\\",\\n  \\\"One Round opened row per round (R011, R028, R035, R047), each with Round finality; R011 carries the R1 anchor tag with candidate Row ids; each Deadline row\\\\u2019s treatment matches the Summary map; every inferred row opens with its Outcome basis; Related rows point to prior (not self/future) records; Page filled wherever Source is.\\\"),\\n (\\\"7. Evidence\\\",\\n  \\\"Programmatic quotation matching plus interpretation read\\\",\\n  \\\"Passed\\\",\\n  \\\"Every quotation used was matched to the cited passage in the source text (whitespace-normalized; filing typography preserved, including the \\\\u201cJuly 27, 2103\\\\u201d typo and the duplicated sentence in P-023); page citations verified against the printed-page map; cross-paragraph premises cited (e.g., formality signals and the residual base). Text matching alone does not validate interpretation \\\\u2014 judgment items are in Q1\\\\u2013Q8.\\\"),\\n (\\\"8. Review and workbook operation\\\",\\n  \\\"Workbook open/re-save text and structural inspection\\\",\\n  \\\"Qualified\\\",\\n  \\\"Question links and Affected-row references resolve to existing Row ids; drop-down lists written for all controlled columns; Source hyperlinks written and verified present after save; formulas written for the Summary tallies and verified by logic (not recalculated in Excel \\\\u2014 open/saved via LibreOffice for a structural check only where noted). Changed-cell highlighting is NOT implemented: AI original is retained as the values baseline and a Correction column is provided beside Reviewer note; no automatic baseline comparison or dependent-update mechanism is claimed.\\\"),\\n]\\nfor chk in CHECKS:\\n    r += 1\\n    for i, v in enumerate(chk, 1):\\n        c = qs.cell(row=r, column=min(i+1, 8), value=v)\\n        c.alignment = Alignment(vertical='top', wrap_text=True)\\n        c.border = border\\n\\n# ------------------------------------------------------------------ sheet order and save\\nwb.move_sheet('Deal ledger', offset=0)\\norder = ['Deal ledger','Summary','Questions','Source text','AI original','Lists']\\nwb._sheets = [wb[n] for n in order]\\nprint('saving', OUT)\\nwb.save(OUT)\\nprint('saved. ledger rows:', len(ROWS), 'source rows:', STLAST)\\n\", \"path\": \"/tmp/opencode/build_xlsx.py\"}"},"time":{"start":1789825140984,"end":1789825198633}}}}
