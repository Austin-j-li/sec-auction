    m = difflib.SequenceMatcher(None, qn, v).find_longest_match(0, len(qn), 0, len(v))\\n            if m.size > 60:\\n                print('    best in', k, '->', v[m.b:m.b+120])\\n                break\\nEOF\"}"},"time":{"start":1789824992500,"end":1789824995619}}}}
