{"type":"tool_use","timestamp":1789825257633,"sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","part":{"partID":"prt_0b9e5ea58001RWgP2pt8LXz1ul","sessionID":"ses_f46293753ffeU5Yf7iVUgOE0mm","messageID":"msg_0b9e5d60a001E65Y04vCn29ErW","type":"tool","id":"call_00_IXLuJdeGuR6mxNIfTkS77487","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n\"\"\"Independent verification of extraction/mac-gray.xlsx against the instruction's checks.\"\"\"\nimport json, re, sys\nfrom datetime import date, datetime\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook('extraction/mac-gray.xlsx')\nws = wb['Deal ledger']\nH = {ws.cell(row=1, column=i).value: i for i in range(1, ws.max_column+1)}\ndef cell(r, h): return ws.cell(row=r, column=H[h]).value\n\nproblems = []\ndef check(cond, msg):\n    if not cond: problems.append(msg)\n\nrows = list(range(2, ws.max_row+1))\n# --- 1. structural\ncheck(wb.sheetnames == ['Deal ledger','Summary','Questions','Source text','AI original','Lists'], 'sheet order/names')\ncheck(wb['AI original'].sheet_state == 'hidden' and wb['Lists'].sheet_state == 'hidden', 'hidden sheets')\n\n# --- 2. dates and order\nprev = None\nfor r in rows:\n    wd = cell(r, 'Working date')\n    check(wd is not None, f'row {r}: missing working date')\n    wd = wd.date() if isinstance(wd, datetime) else wd\n    if prev is not None:\n        check(wd >= prev, f'row {r}: working date decreases ({wd} < {prev})')\n    prev = wd\n    df, dt = cell(r,'Date from'), cell(r,'Date to')\n    if isinstance(df, datetime): df = df.date()\n    if isinstance(dt, datetime): dt = dt.date()\n    if df: check(df <= wd, f'row {r}: WD before Date from')\n    if dt: check(wd <= dt, f'row {r}: WD after Date to')\n    meth, basis = cell(r,'Date method'), cell(r,'Date basis')\n    check(bool(meth) and bool(basis), f'row {r}: missing date basis/method')\n    if basis == 'Reported day': check(meth == 'Reported', f'row {r}: Reported day with method {meth}')\n    if basis == 'Inferred day': check(meth == 'Inferred', f'row {r}: Inferred day with method {meth}')\n    if meth == 'Reported': check(basis == 'Reported day', f'row {r}: Reported method with basis {basis}')\n    if meth == 'Inferred': check(basis == 'Inferred day', f'row {r}: Inferred method with basis {basis}')\n    check(isinstance(cell(r,'Page'), int), f'row {r}: page not numeric')\n\n# --- 3. counts (emulate SUMIFS)\ndata = [dict(zip([ws.cell(row=1, column=c).value for c in range(1, ws.max_column+1)],\n                 [ws.cell(row=r, column=c).value for c in range(1, ws.max_column+1)])) for r in rows]\nOK = [d for d in data if d['Include'] == 'Yes']\ncontacts = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Contact' and d['Process'] == 1)\nndas = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'NDA signed' and d['Process'] == 1)\nr2 = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Bid' and d['Round'] == 2)\nr3 = sum(d['Count'] or 0 for d in OK if d['What happened'] in ('Bid','Bid reaffirmed') and d['Round'] == 3)\ndropped = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Dropped by target')\ndns = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Did not submit')\nprint('counts: contacts', contacts, '| NDAs', ndas, '| R2 bids', r2, '| R3 bidders', r3,\n      '| dropped', dropped, '| did-not-submit', dns)\ncheck(contacts == 50, 'contact sum != 50')\ncheck(ndas == 20, 'NDA sum != 20')\ncheck(r2 == 4 and r3 == 3, 'round bid sums')\ncheck(dropped == 2 and dns == 17, 'outcome sums')\n\n# --- 4. participation balance\nentrants = ndas\nexits = dropped + dns\nwinner_rows = [d for d in OK if d['What happened'] == 'Merger agreement signed']\ncheck(entrants - exits == 1, 'balance: entrants - exits != 1 (winner only)')\ncheck(len(winner_rows) == 1, 'signing rows != 1')\n\n# --- 5. offer rows fields\nfor d in OK:\n    if d['What happened'] in ('Bid','Bid reaffirmed'):\n        check(d['Formality'] in ('Formal','Informal','Insufficient evidence','Varies'), f\"row {d['Row id']}: bad formality\")\n        check(d['Conditions level'] in ('None','Light','Heavy','Insufficient evidence','Varies'), f\"row {d['Row id']}: bad conditions level\")\n        cd = d['Conditions detail'] or ''\n        check(re.match(r'^Fin: (committed|no contingency|not needed|represented|not committed|not stated); DD required: (none|confirmatory|substantive \\(\\d+ wks\\)|not stated); DD open: (yes|no|not disclosed); Excl: (requested \\(\\d+ wks\\)|granted|none|not stated)$', cd) is not None,\n              f\"row {d['Row id']}: conditions detail format: {cd}\")\n        check(d['Price kind'] in ('Point','Bidder range','Group envelope','Bound only','Undisclosed'), f\"row {d['Row id']}: bad price kind\")\n        check(d['Price origin'] in ('Stated','Carried forward','Inferred'), f\"row {d['Row id']}: bad price origin\")\n        if d['Price kind'] == 'Point':\n            check(d['Price low'] == d['Price high'], f\"row {d['Row id']}: point price mismatch\")\n        if d['Price kind'] == 'Undisclosed':\n            check(d['Price low'] is None and d['Price high'] is None, f\"row {d['Row id']}: undisclosed with price\")\n\n# --- 6. round opened / deadline / inferred rows\nrounds = [d for d in OK if d['What happened'] == 'Round opened']\ncheck(len([d for d in rounds if d['Round'] in (1,2,3,4)]) == 4, 'rounds != 4')\ncheck(all(d['Round finality'] for d in rounds), 'round opened missing finality')\nr1 = [d for d in rounds if d['Round'] == 1][0]\ncheck('R1 anchor:' in (r1['Terms or outcome'] or ''), 'R1 anchor tag missing')\ncheck('R002' in (r1['Terms or outcome'] or '') and 'R014' in (r1['Terms or outcome'] or ''), 'R1 anchor candidates not listed')\nfor d in [x for x in OK if x['What happened'] == 'Deadline']:\n    check(d['Deadline treatment'] in ('Enforced','Extended','Late bids accepted','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'),\n          f\"row {d['Row id']}: deadline treatment\")\n    check(d['Due date'] is not None, f\"row {d['Row id']}: deadline missing due date\")\nfor d in OK:\n    if d['What happened'] in ('Dropped by target','Withdrew','Did not submit','Participation paused','Not selected at signing'):\n        check(d['Outcome basis'] in ('Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'), f\"row {d['Row id']}: outcome basis\")\n        check(d['Decided by'] in ('Bidder','Target','Both','Unknown'), f\"row {d['Row id']}: decided by\")\n        check(d['Exit reason'] in ('Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'), f\"row {d['Row id']}: exit reason\")\n        if d['Outcome basis'].startswith('Inferred'):\n            check((d['Terms or outcome'] or '').startswith('Inferred:'), f\"row {d['Row id']}: inferred row lacks opener\")\n\n# --- 7. bid price cells not on signing row\nsgn = winner_rows[0]\ncheck(sgn['Price low'] is None and (sgn['Formality'] is None), 'signing row has price/formality')\n\n# --- 8. control-label compliance across all rows\nwhat_ok = {'Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'}\nfor d in data:\n    check(d['What happened'] in what_ok, f\"row {d['Row id']}: label {d['What happened']}\")\n    check(d['Type'] in (None,'Strategic','Financial','Mixed','Unknown'), f\"row {d['Row id']}: type {d['Type']}\")\n    if d['What happened'] in ('Round opened','Deadline','Bid','Bid reaffirmed','Target decision','Contact','NDA signed','Material process update','Information access changed','Exclusivity changed','Adviser engaged','Adviser service observed','Adviser ended','Target sale decision','Target interest','Activist involvement','Activist pressure','Dropped by target','Withdrew','Did not submit','Not selected at signing','Participation paused','Re-entered','Merger agreement signed','Merger announced','Other-scope bid','Offer update','Bidding group changed','Joined group','Deadline set'):\n        pass\n    else:\n        problems.append(f\"row {d['Row id']}: unhandled label {d['What happened']}\")\n\n# --- 9. related rows resolve\nids = {d['Row id'] for d in data}\nfor d in data:\n    rel = d['Related rows'] or ''\n    for m in re.findall(r'R\\d{3}', rel):\n        check(m in ids, f\"row {d['Row id']}: related {m} missing\")\n        check(m != d['Row id'], f\"row {d['Row id']}: self-reference\")\n\n# --- 10. source links resolve\nst = wb['Source text']\npara_ids = {}\nfor r in range(2, st.max_row+1):\n    para_ids[st.cell(row=r, column=1).value] = r\nfor r in rows:\n    c = ws.cell(row=r, column=H['Source'])\n    if c.hyperlink is not None:\n        loc = c.hyperlink.location\n        m = re.match(r\"^'Source text'!A(\\d+)$\", loc)\n        check(m is not None, f'row {r}: bad link {loc}')\n        if m:\n            check(int(m.group(1)) in para_ids.values(), f'row {r}: link target row missing')\n    src_ids = re.findall(r'[PX]-\\d{3}', c.value or '')\n    for sid in src_ids:\n        check(sid in para_ids, f'row {r}: source id {sid} not in Source text')\n\n# --- 11. quotes in the ledger recoverable from Source text / filing\ndef an(s):\n    s = s.replace('\\u2019',\"'\").replace('\\u2018',\"'\").replace('\\u201c','\"').replace('\\u201d','\"')\n    s = re.sub(r'\\s+',' ',s)\n    return s\nst_text = ' '.join(an(str(st.cell(row=r, column=4).value or '')) for r in range(2, st.max_row+1))\nmiss = 0\nfor d in data:\n    why = d['Why and evidence'] or ''\n    for q in re.findall(r'\"([^\"]{25,})\"', why):\n        if an(q) not in st_text:\n            miss += 1\n            problems.append(f\"row {d['Row id']}: quote not recoverable: {q[:70]}...\")\nprint('unrecoverable quotes:', miss)\n\n# --- 12. AI original equals ledger\nai = wb['AI original']\ndiff = 0\nfor r in range(1, ws.max_row+1):\n    for c in range(1, ws.max_column+1):\n        a = ws.cell(row=r, column=c).value\n        b = ai.cell(row=r, column=c).value\n        if (a or None) != (b or None):\n            diff += 1\n            if diff < 5: problems.append(f'AI original mismatch r{r}c{c}: {a!r} vs {b!r}')\nprint('AI original diffs:', diff)\n\nprint('problems:', len(problems))\nfor p in problems[:40]:\n    print(' *', p)\nsrn = wb['Summary']\nformulas = [(r, srn.cell(row=r, column=2).value) for r in range(1, srn.max_row+1)\n            if isinstance(srn.cell(row=r, column=2).value, str) and srn.cell(row=r, column=2).value.startswith('=')]\nprint('summary formulas:', len(formulas))\nfor r, f in formulas:\n    print('  row', r, ':', f[:100])\n","path":"/tmp/opencode/verify.py"},"output":"Created file successfully: /tmp/opencode/verify.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/verify.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Independent verification of extraction/mac-gray.xlsx against the instruction's checks.\\\"\\\"\\\"\\nimport json, re, sys\\nfrom datetime import date, datetime\\nimport openpyxl\\nfrom openpyxl.utils import get_column_letter\\n\\nwb = openpyxl.load_workbook('extraction/mac-gray.xlsx')\\nws = wb['Deal ledger']\\nH = {ws.cell(row=1, column=i).value: i for i in range(1, ws.max_column+1)}\\ndef cell(r, h): return ws.cell(row=r, column=H[h]).value\\n\\nproblems = []\\ndef check(cond, msg):\\n    if not cond: problems.append(msg)\\n\\nrows = list(range(2, ws.max_row+1))\\n# --- 1. structural\\ncheck(wb.sheetnames == ['Deal ledger','Summary','Questions','Source text','AI original','Lists'], 'sheet order/names')\\ncheck(wb['AI original'].sheet_state == 'hidden' and wb['Lists'].sheet_state == 'hidden', 'hidden sheets')\\n\\n# --- 2. dates and order\\nprev = None\\nfor r in rows:\\n    wd = cell(r, 'Working date')\\n    check(wd is not None, f'row {r}: missing working date')\\n    wd = wd.date() if isinstance(wd, datetime) else wd\\n    if prev is not None:\\n        check(wd >= prev, f'row {r}: working date decreases ({wd} < {prev})')\\n    prev = wd\\n    df, dt = cell(r,'Date from'), cell(r,'Date to')\\n    if isinstance(df, datetime): df = df.date()\\n    if isinstance(dt, datetime): dt = dt.date()\\n    if df: check(df <= wd, f'row {r}: WD before Date from')\\n    if dt: check(wd <= dt, f'row {r}: WD after Date to')\\n    meth, basis = cell(r,'Date method'), cell(r,'Date basis')\\n    check(bool(meth) and bool(basis), f'row {r}: missing date basis/method')\\n    if basis == 'Reported day': check(meth == 'Reported', f'row {r}: Reported day with method {meth}')\\n    if basis == 'Inferred day': check(meth == 'Inferred', f'row {r}: Inferred day with method {meth}')\\n    if meth == 'Reported': check(basis == 'Reported day', f'row {r}: Reported method with basis {basis}')\\n    if meth == 'Inferred': check(basis == 'Inferred day', f'row {r}: Inferred method with basis {basis}')\\n    check(isinstance(cell(r,'Page'), int), f'row {r}: page not numeric')\\n\\n# --- 3. counts (emulate SUMIFS)\\ndata = [dict(zip([ws.cell(row=1, column=c).value for c in range(1, ws.max_column+1)],\\n                 [ws.cell(row=r, column=c).value for c in range(1, ws.max_column+1)])) for r in rows]\\nOK = [d for d in data if d['Include'] == 'Yes']\\ncontacts = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Contact' and d['Process'] == 1)\\nndas = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'NDA signed' and d['Process'] == 1)\\nr2 = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Bid' and d['Round'] == 2)\\nr3 = sum(d['Count'] or 0 for d in OK if d['What happened'] in ('Bid','Bid reaffirmed') and d['Round'] == 3)\\ndropped = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Dropped by target')\\ndns = sum(d['Count'] or 0 for d in OK if d['What happened'] == 'Did not submit')\\nprint('counts: contacts', contacts, '| NDAs', ndas, '| R2 bids', r2, '| R3 bidders', r3,\\n      '| dropped', dropped, '| did-not-submit', dns)\\ncheck(contacts == 50, 'contact sum != 50')\\ncheck(ndas == 20, 'NDA sum != 20')\\ncheck(r2 == 4 and r3 == 3, 'round bid sums')\\ncheck(dropped == 2 and dns == 17, 'outcome sums')\\n\\n# --- 4. participation balance\\nentrants = ndas\\nexits = dropped + dns\\nwinner_rows = [d for d in OK if d['What happened'] == 'Merger agreement signed']\\ncheck(entrants - exits == 1, 'balance: entrants - exits != 1 (winner only)')\\ncheck(len(winner_rows) == 1, 'signing rows != 1')\\n\\n# --- 5. offer rows fields\\nfor d in OK:\\n    if d['What happened'] in ('Bid','Bid reaffirmed'):\\n        check(d['Formality'] in ('Formal','Informal','Insufficient evidence','Varies'), f\\\"row {d['Row id']}: bad formality\\\")\\n        check(d['Conditions level'] in ('None','Light','Heavy','Insufficient evidence','Varies'), f\\\"row {d['Row id']}: bad conditions level\\\")\\n        cd = d['Conditions detail'] or ''\\n        check(re.match(r'^Fin: (committed|no contingency|not needed|represented|not committed|not stated); DD required: (none|confirmatory|substantive \\\\(\\\\d+ wks\\\\)|not stated); DD open: (yes|no|not disclosed); Excl: (requested \\\\(\\\\d+ wks\\\\)|granted|none|not stated)$', cd) is not None,\\n              f\\\"row {d['Row id']}: conditions detail format: {cd}\\\")\\n        check(d['Price kind'] in ('Point','Bidder range','Group envelope','Bound only','Undisclosed'), f\\\"row {d['Row id']}: bad price kind\\\")\\n        check(d['Price origin'] in ('Stated','Carried forward','Inferred'), f\\\"row {d['Row id']}: bad price origin\\\")\\n        if d['Price kind'] == 'Point':\\n            check(d['Price low'] == d['Price high'], f\\\"row {d['Row id']}: point price mismatch\\\")\\n        if d['Price kind'] == 'Undisclosed':\\n            check(d['Price low'] is None and d['Price high'] is None, f\\\"row {d['Row id']}: undisclosed with price\\\")\\n\\n# --- 6. round opened / deadline / inferred rows\\nrounds = [d for d in OK if d['What happened'] == 'Round opened']\\ncheck(len([d for d in rounds if d['Round'] in (1,2,3,4)]) == 4, 'rounds != 4')\\ncheck(all(d['Round finality'] for d in rounds), 'round opened missing finality')\\nr1 = [d for d in rounds if d['Round'] == 1][0]\\ncheck('R1 anchor:' in (r1['Terms or outcome'] or ''), 'R1 anchor tag missing')\\ncheck('R002' in (r1['Terms or outcome'] or '') and 'R014' in (r1['Terms or outcome'] or ''), 'R1 anchor candidates not listed')\\nfor d in [x for x in OK if x['What happened'] == 'Deadline']:\\n    check(d['Deadline treatment'] in ('Enforced','Extended','Late bids accepted','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'),\\n          f\\\"row {d['Row id']}: deadline treatment\\\")\\n    check(d['Due date'] is not None, f\\\"row {d['Row id']}: deadline missing due date\\\")\\nfor d in OK:\\n    if d['What happened'] in ('Dropped by target','Withdrew','Did not submit','Participation paused','Not selected at signing'):\\n        check(d['Outcome basis'] in ('Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'), f\\\"row {d['Row id']}: outcome basis\\\")\\n        check(d['Decided by'] in ('Bidder','Target','Both','Unknown'), f\\\"row {d['Row id']}: decided by\\\")\\n        check(d['Exit reason'] in ('Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'), f\\\"row {d['Row id']}: exit reason\\\")\\n        if d['Outcome basis'].startswith('Inferred'):\\n            check((d['Terms or outcome'] or '').startswith('Inferred:'), f\\\"row {d['Row id']}: inferred row lacks opener\\\")\\n\\n# --- 7. bid price cells not on signing row\\nsgn = winner_rows[0]\\ncheck(sgn['Price low'] is None and (sgn['Formality'] is None), 'signing row has price/formality')\\n\\n# --- 8. control-label compliance across all rows\\nwhat_ok = {'Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'}\\nfor d in data:\\n    check(d['What happened'] in what_ok, f\\\"row {d['Row id']}: label {d['What happened']}\\\")\\n    check(d['Type'] in (None,'Strategic','Financial','Mixed','Unknown'), f\\\"row {d['Row id']}: type {d['Type']}\\\")\\n    if d['What happened'] in ('Round opened','Deadline','Bid','Bid reaffirmed','Target decision','Contact','NDA signed','Material process update','Information access changed','Exclusivity changed','Adviser engaged','Adviser service observed','Adviser ended','Target sale decision','Target interest','Activist involvement','Activist pressure','Dropped by target','Withdrew','Did not submit','Not selected at signing','Participation paused','Re-entered','Merger agreement signed','Merger announced','Other-scope bid','Offer update','Bidding group changed','Joined group','Deadline set'):\\n        pass\\n    else:\\n        problems.append(f\\\"row {d['Row id']}: unhandled label {d['What happened']}\\\")\\n\\n# --- 9. related rows resolve\\nids = {d['Row id'] for d in data}\\nfor d in data:\\n    rel = d['Related rows'] or ''\\n    for m in re.findall(r'R\\\\d{3}', rel):\\n        check(m in ids, f\\\"row {d['Row id']}: related {m} missing\\\")\\n        check(m != d['Row id'], f\\\"row {d['Row id']}: self-reference\\\")\\n\\n# --- 10. source links resolve\\nst = wb['Source text']\\npara_ids = {}\\nfor r in range(2, st.max_row+1):\\n    para_ids[st.cell(row=r, column=1).value] = r\\nfor r in rows:\\n    c = ws.cell(row=r, column=H['Source'])\\n    if c.hyperlink is not None:\\n        loc = c.hyperlink.location\\n        m = re.match(r\\\"^'Source text'!A(\\\\d+)$\\\", loc)\\n        check(m is not None, f'row {r}: bad link {loc}')\\n        if m:\\n            check(int(m.group(1)) in para_ids.values(), f'row {r}: link target row missing')\\n    src_ids = re.findall(r'[PX]-\\\\d{3}', c.value or '')\\n    for sid in src_ids:\\n        check(sid in para_ids, f'row {r}: source id {sid} not in Source text')\\n\\n# --- 11. quotes in the ledger recoverable from Source text / filing\\ndef an(s):\\n    s = s.replace('\\\\u2019',\\\"'\\\").replace('\\\\u2018',\\\"'\\\").replace('\\\\u201c','\\\"').replace('\\\\u201d','\\\"')\\n    s = re.sub(r'\\\\s+',' ',s)\\n    return s\\nst_text = ' '.join(an(str(st.cell(row=r, column=4).value or '')) for r in range(2, st.max_row+1))\\nmiss = 0\\nfor d in data:\\n    why = d['Why and evidence'] or ''\\n    for q in re.findall(r'\\\"([^\\\"]{25,})\\\"', why):\\n        if an(q) not in st_text:\\n            miss += 1\\n            problems.append(f\\\"row {d['Row id']}: quote not recoverable: {q[:70]}...\\\")\\nprint('unrecoverable quotes:', miss)\\n\\n# --- 12. AI original equals ledger\\nai = wb['AI original']\\ndiff = 0\\nfor r in range(1, ws.max_row+1):\\n    for c in range(1, ws.max_column+1):\\n        a = ws.cell(row=r, column=c).value\\n        b = ai.cell(row=r, column=c).value\\n        if (a or None) != (b or None):\\n            diff += 1\\n            if diff < 5: problems.append(f'AI original mismatch r{r}c{c}: {a!r} vs {b!r}')\\nprint('AI original diffs:', diff)\\n\\nprint('problems:', len(problems))\\nfor p in problems[:40]:\\n    print(' *', p)\\nsrn = wb['Summary']\\nformulas = [(r, srn.cell(row=r, column=2).value) for r in range(1, srn.max_row+1)\\n            if isinstance(srn.cell(row=r, column=2).value, str) and srn.cell(row=r, column=2).value.startswith('=')]\\nprint('summary formulas:', len(formulas))\\nfor r, f in formulas:\\n    print('  row', r, ':', f[:100])\\n\", \"path\": \"/tmp/opencode/verify.py\"}"},"time":{"start":1789825247832,"end":1789825257633}}}}
