EOF'\\nimport openpyxl\\nwb = openpyxl.load_workbook('extraction/mac-gray.xlsx')\\nprint('sheets:', wb.sheetnames)\\nfor ws in wb.worksheets:\\n    print(f\\\"  {ws.title:12s} state={ws.sheet_state:7s} dims={ws.dimensions} max_row={ws.max_row} max_col={ws.max_column}\\\")\\nws = wb['Deal ledger']\\nprint('headers:', [ws.cell(row=1, column=i).value for i in range(1, ws.max_column+1)])\\nprint('autofilter:', ws.auto_filter.ref, 'freeze:', ws.freeze_panes)\\nprint('dv count:', len(ws.data_validations.dataValidation))\\nfor dv in ws.data_validations.dataValidation:\\n    print('   ', dv.sqref, dv.formula1[:50])\\n# sample rows\\nfor r in (2, 12, 25, 44, 56):\\n    print('--- row', r, '|', ws.cell(row=r, column=1).value, '|', ws.cell(row=r, column=4).value, '|', ws.cell(row=r, column=2).value, '| WD', ws.cell(row=r, column=33).value)\\n# hyperlink check\\nlc = 0\\nfor r in range(2, ws.max_row+1):\\n    c = ws.cell(row=r, column=12)\\n    if c.hyperlink: lc += 1\\nprint('source links:', lc)\\nc = ws.cell(row=2, column=12)\\nprint('example link:', c.value, '->', c.hyperlink.location if c.hyperlink else None)\\n# group hidden check\\nhidden_groups = [k for k,v in ws.column_dimensions.items() if getattr(v,'hidden',False)]\\nprint('hidden column dims:', hidden_groups[:12], '...')\\nEOF\"}"},"time":{"start":1789825210672,"end":1789825212271}}}}
