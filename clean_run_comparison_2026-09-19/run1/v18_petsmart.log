if fo not in (\"Formal\",\"Informal\",\"Unclear\"): issues.append(f\"row {r}: bad formality {fo}\")\n        if co not in (\"None\",\"Light\",\"Heavy\",\"Unclear\"): issues.append(f\"row {r}: bad conditions {co}\")\n    if note and len(note.split())>40: issues.append(f\"row {r}: note {len(note.split())} words\")\n    if quote:\n        inner = quote.strip('“”')\n        inner = re.sub(r'\\s*\\(p\\. \\d+\\)$','',inner)\n        if len(inner.split())>30: issues.append(f\"row {r}: quote {len(inner.split())} words: {inner[:60]}\")\n\nprint(\"types:\", types)\nprint(\"events:\", sorted(events))\nprint(\"all cash:\", cash)\nprint(\"formality:\", form)\nprint(\"conditions:\", cond)\nprint(\"exit reasons:\", exitr)\nprint(\"rounds:\", rounds)\nprint(\"inferred:\", inf)\nprint(\"ISSUES:\")\nfor i in issues: print(\" -\", i)\nEOF"},"output":"sheets: ['Deal ledger', 'Rounds', 'Questions', 'Deal facts']\nledger header: ['#', 'When', 'Who', 'Type', 'Event', 'Process', 'Round', 'Price low', 'Price high', 'All cash', 'Formality', 'Conditions', 'Count', 'Exit reason', 'Inferred', 'Note', 'Quote and page', 'Flag', 'Reviewer note', 'Sort date', 'Date from', 'Date to']\nrows: 45 cols: 22\ntypes: {None, 'Financial', 'Strategic'}\nevents: ['Activist', 'Adviser', 'Bid', 'Bidder interest', 'Bidding group changed', 'Contact', 'Deadline', 'Deadline revised', 'Deadline set', 'Did not submit', 'Dropped by target', 'Merger agreement signed', 'Merger announced', 'NDA signed', 'Not selected at signing', 'Other material event', 'Round opened', 'Sale process announced', 'Target sale decision']\nall cash: {None, 'Not stated', 'Yes'}\nformality: {None, 'Formal', 'Informal'}\nconditions: {None, 'Light', 'Unclear'}\nexit reasons: {None, 'Not stated', 'Lower offer than rivals', 'Value at or below market price'}\nrounds: {0, 1, 2, 'post'}\ninferred: {None, 'Y'}\nISSUES:\n - row 12: quote 32 words: the ad hoc committee directed J.P. Morgan to communicate to \n - row 30: quote 31 words: the Company set th