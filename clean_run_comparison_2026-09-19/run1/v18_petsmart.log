value\n    if f: flags.setdefault(f,[]).append(ws.cell(r,1).value)\nprint(\"flags:\", flags)\nws3 = wb['Questions']\nprint(\"questions:\", ws3.max_row-1, [ws3.cell(r,1).value for r in range(2,ws3.max_row+1)])\nws2 = wb['Rounds']\nprint(\"rounds:\")\nfor r in range(2, ws2.max_row+1):\n    print(\"  \", [ws2.cell(r,c).value for c in range(1,11)])\nws4 = wb['Deal facts']\nprint(\"deal facts:\", ws4.max_row-1, \"fields\")\nfor r in range(2, ws4.max_row+1):\n    f=ws4.cell(r,1).value; v=ws4.cell(r,2).value\n    print(f\"   {f}: {str(v)[:90]}\")\n# filter/freeze check\nfor name in wb.sheetnames:\n    s=wb[name]\n    print(name, \"freeze:\", s.freeze_panes, \"filter:\", s.auto_filter.ref, \"merged:\", len(s.merged_cells.ranges))\nEOF"},"output":"saved /home/uctpiaj/work/extraction/petsmart.xlsx\nledger rows: 45\nquote check done, bad = 0\nflags: {'Q1': [13, 24], 'Q2': [17, 23], 'Q4': [21, 22], 'Q3': [28, 29, 36], 'Q5': [35]}\nquestions: 5 ['Q1', 'Q2', 'Q3', 'Q4', 'Q5']\nrounds:\n   [1, 1, datetime.datetime(2014, 10, 1, 0, 0), 'Confidentiality/standstill agreements signed with 15 financial buyers; diligence opened', '15, all Financial, incl. Buyer Group, Bidder 2 and unnamed financial bidder 1', '10/30/2014', 'Enforced', 'Not final', '6 of 15: Buyer Group ($81.00–$83.00); Bidder 2 ($78.00 then $81.00–$84.00); unnamed financial bidder 1 ($80.00–$85.00); 3 others (prices undisclosed)', 'four advanced (at or above $80.00), eleven out']\n   [1, 2, datetime.datetime(2014, 11, 3, 0, 0), 'Board advanced the four bidders at or above $80.00 and asked for final bids; eliminated bidders notified', '4, all Financial: Buyer Group, Bidder 2, unnamed financial bidder 1 and one further finalist (last two combined as Bidder 3)', '12/05/2014 → 12/10/2014 → 12/12/2014', 'Extended; Enforced', 'Announced as final', \"2 written: Buyer Group ($80.70 → $82.50 → $83.00); Bidder 2 ($80.35 → $81.50); plus Bidder 3's oral valuation (≤ ~$78.00, no written offer)\", 'signing with Buyer Group']\ndeal fac