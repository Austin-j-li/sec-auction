{"type":"text","timestamp":1789825532890,"sessionID":"ses_f461f6897ffeZJz46cQwZkb8iB","part":{"id":"prt_0b9e9db4a001wt7Xxnsy4AY2nZ","sessionID":"ses_f461f6897ffeZJz46cQwZkb8iB","messageID":"msg_0b9e8a6cb001xr9HdMKH2q9PyK","type":"text","text":"All quotations check out with their printed pages. Now let me build the workbook.","time":{"start":1789825506122,"end":1789825532890}}}
{"type":"tool_use","timestamp":1789825532904,"sessionID":"ses_f461f6897ffeZJz46cQwZkb8iB","part":{"partID":"prt_0b9e9dba7001Dlei96gOaJ6mir","sessionID":"ses_f461f6897ffeZJz46cQwZkb8iB","messageID":"msg_0b9e8a6cb001xr9HdMKH2q9PyK","type":"tool","id":"call_00_F4955ZA4fMGDkyZLQPcj5598","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/petsmart/build_ledger.py","content":"#!/usr/bin/env python3\n\"\"\"Build petsmart.xlsx deal ledger from the PetSmart 2015 DEFM14A.\"\"\"\nimport datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Alignment, Font\nfrom openpyxl.utils import get_column_letter\n\nD = dt.date\n\n# ---------------------------------------------------------------- Deal ledger\n# Columns: #, When, Who, Type, Event, Process, Round, Price low, Price high,\n# All cash, Formality, Conditions, Count, Exit reason, Inferred, Note,\n# Quote and page, Flag, Reviewer note, Sort date, Date from, Date to\nrows = [\n # 1\n (\"06/18/2014\",\"PetSmart (target)\",\"\",\"Other material event\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Board reviewed alternatives after May–June stockholder communications; chose to explore capital-structure changes (capital-return focus); created ad hoc committee; authorized financial-adviser search.\",\n  \"“determined to explore more intensively potential changes to the Company’s capital structure, with a focus on returning capital to stockholders (p. 21)\",\n  \"\", D(2014,6,18), D(2014,6,18), D(2014,6,18)),\n # 2\n (\"06/18/2014\",\"Wachtell, Lipton, Rosen & Katz\",\"\",\"Adviser\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Company's legal adviser; first seen acting 06/18/2014; represented the Company on the merger agreement.\",\n  \"“the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (“Wachtell Lipton”), its legal advisor (p. 21)\",\n  \"\", D(2014,6,18), D(2014,6,18), D(2014,6,18)),\n # 3\n (\"07/03/2014\",\"JANA Partners\",\"\",\"Activist\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Filed Schedule 13D disclosing 9.9% stake; sought review of strategic alternatives incl. sale; met the Company 07/10; 13D amendments and letters through August.\",\n  \"“JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company’s outstanding common stock (p. 22)\",\n  \"\", D(2014,7,3), D(2014,7,3), D(2014,7,3)),\n # 4\n (\"07/07/2014\",\"Longview Asset Management\",\"\",\"Activist\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Public letter urged board to consider a sale; willing to roll part of its holdings into an acquirer; met board/management in May; reiterated at 07/10 call.\",\n  \"“Longview made public a letter to the board in which Longview stated that the board should consider the a sale of the Company (p. 22)\",\n  \"\", D(2014,7,7), D(2014,7,7), D(2014,7,7)),\n # 5\n (\"July 2014\",\"J.P. Morgan Securities LLC\",\"\",\"Adviser\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Company's financial adviser (sole named; primary); retained after interviews; engagement letter effective 08/21/2014.\",\n  \"“In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor (p. 22)\",\n  \"\", D(2014,7,16), D(2014,7,1), D(2014,7,31)),\n # 6\n (\"08/07/2014\",\"Industry Participant\",\"Strategic\",\"Bidder interest\",1,0,\n  None,None,\"\",\"\",\"\",1,\"\",\"\",\n  \"Told JPM it might revisit Spring combination talks if the Company pursued alternatives; reported to the ad hoc committee; no price.\",\n  \"“if the Company were to pursue strategic alternatives, Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring (p. 22)\",\n  \"\", D(2014,8,7), D(2014,8,7), D(2014,8,7)),\n # 7\n (\"08/13/2014\",\"PetSmart (target)\",\"\",\"Target sale decision\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Board chose to explore strategic alternatives incl. a possible sale; authorized ad hoc committee to oversee; planned outreach for late September/early October; decided to announce publicly; reviewed Industry Participant risks.\",\n  \"“the board (1) determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders (p. 22)\",\n  \"\", D(2014,8,13), D(2014,8,13), D(2014,8,13)),\n # 8\n (\"mid-August–end of October 2014\",\"3 strategic parties (cohort)\",\"Strategic\",\"Contact\",1,0,\n  None,None,\"\",\"\",\"\",3,\"\",\"\",\n  \"Inbound contacts during sale-process preparation; not counting Industry Participant; none signed a confidentiality agreement or entered the process.\",\n  \"“including three strategic parties (not counting Industry Participant) and 24 financial participants (p. 23)\",\n  \"\", D(2014,8,13), D(2014,8,13), D(2014,10,31)),\n # 9\n (\"mid-August–end of October 2014\",\"24 financial participants (cohort)\",\"Financial\",\"Contact\",1,0,\n  None,None,\"\",\"\",\"\",24,\"\",\"\",\n  \"Inbound contacts incl. potential lead buyers and large suppliers of equity capital to lead buyers.\",\n  \"“24 financial participants (including potential lead buyers as well as large suppliers of equity capital to lead buyers) (p. 23)\",\n  \"\", D(2014,8,13), D(2014,8,13), D(2014,10,31)),\n # 10\n (\"08/19/2014\",\"PetSmart (target)\",\"\",\"Sale process announced\",1,0,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Press release, concurrent with Q2 earnings, announced exploration of strategic alternatives incl. a possible sale; interested parties could contact JPM.\",\n  \"“the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company (p. 23)\",\n  \"\", D(2014,8,19), D(2014,8,19), D(2014,8,19)),\n # 11\n (\"08/22/2014\",\"Industry Participant\",\"Strategic\",\"Other material event\",1,0,\n  None,None,\"\",\"\",\"\",1,\"\",\"\",\n  \"JPM conveyed the board's decision not to invite it into the exploratory process; IP confirmed awareness of the 08/19 announcement; agreed to speak again.\",\n  \"“the ad hoc committee directed J.P. Morgan to communicate to Industry Participant the board’s concerns as a result of which Industry Participant would not be invited to participate in the exploratory process (p. 23)\",\n  \"\", D(2014,8,22), D(2014,8,22), D(2014,8,22)),\n # 12\n (\"08/27/2014\",\"Industry Participant\",\"Strategic\",\"Other material event\",1,0,\n  None,None,\"\",\"\",\"\",1,\"\",\"\",\n  \"Reaffirmed interest; told again it would not be invited, but the board would consider any proposal it submitted; no contact since 08/27.\",\n  \"“if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it (p. 23)\",\n  \"\", D(2014,8,27), D(2014,8,27), D(2014,8,27)),\n # 13\n (\"first week of October 2014\",\"PetSmart (target)\",\"\",\"Round opened\",1,1,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Confidentiality and standstill agreements with 15 financial buyers began the solicitation; non-binding indications due 10/30.\",\n  \"“In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers (p. 23)\",\n  \"Q1\", D(2014,10,1), D(2014,10,1), D(2014,10,7)),\n # 14\n (\"first week of October 2014\",\"15 financial buyers (cohort)\",\"Financial\",\"NDA signed\",1,1,\n  None,None,\"\",\"\",\"\",15,\"\",\"\",\n  \"All 15 engaged in due diligence, got management presentations and detailed financial/business-plan information incl. the Profit Improvement Plan during October.\",\n  \"“all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company’s senior-most management, and received detailed financial and business plan information (p. 23)\",\n  \"\", D(2014,10,1), D(2014,10,1), D(2014,10,7)),\n # 15\n (\"October 2014\",\"PetSmart (target)\",\"\",\"Deadline set\",1,1,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Bidders informed non-binding preliminary indications of interest due 10/30/2014.\",\n  \"“the potential bidders were informed that non-binding preliminary indications of interest would be due on October 30, 2014 (p. 23)\",\n  \"\", D(2014,10,16), D(2014,10,1), D(2014,10,31)),\n # 16\n (\"October 2014\",\"Longview Asset Management\",\"\",\"Other material event\",1,1,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Willing to roll over up to 7.5M shares on terms/price acceptable to it; bidders asked to indicate interest; not a condition to participation.\",\n  \"“Longview had informed the Company that it would be willing to “roll-over” up to 7.5 million shares on terms and price acceptable to Longview (p. 23)\",\n  \"\", D(2014,10,16), D(2014,10,1), D(2014,10,31)),\n # 17\n (\"10/30/2014\",\"PetSmart (target)\",\"\",\"Deadline\",1,1,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Indication deadline reached; six of the 15 signed buyers submitted; JPM called all parties 10/30–11/02.\",\n  \"“On October 30, six of the potentially interested parties submitted indications of interest (p. 24)\",\n  \"Q2\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 18\n (\"10/30/2014\",\"Buyer Group\",\"Financial\",\"Bid\",1,1,\n  81.00,83.00,\"Not stated\",\"Informal\",\"Unclear\",1,\"\",\"\",\n  \"Non-binding preliminary indication of $81.00–$83.00 per share; among the three initial indications reaching at least $80.00.\",\n  \"“the Buyer Group, which indicated a range of $81.00 to $83.00 per share (p. 24)\",\n  \"\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 19\n (\"10/30/2014\",\"Unnamed financial bidder 1\",\"Financial\",\"Bid\",1,1,\n  80.00,85.00,\"Not stated\",\"Informal\",\"Unclear\",1,\"\",\"\",\n  \"Non-binding preliminary indication; one of the three initial indications reaching at least $80.00; later combined into Bidder 3.\",\n  \"“another bidder, which suggested a range of $80.00 to $85.00 per share (p. 24)\",\n  \"\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 20\n (\"10/30/2014\",\"Bidder 2\",\"Financial\",\"Bid\",1,1,\n  78.00,78.00,\"Not stated\",\"Informal\",\"Unclear\",1,\"\",\"\",\n  \"Initial non-binding indication of $78.00 per share.\",\n  \"“another bidder (which we refer to as “Bidder 2”), which had initially indicated a price of $78.00 (p. 24)\",\n  \"\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 21\n (\"10/30/2014\",\"3 further IOI submitters (cohort)\",\"Financial\",\"Bid\",1,1,\n  None,None,\"Not stated\",\"Informal\",\"Unclear\",3,\"\",\"\",\n  \"Three of the six submitters besides the individually recorded bidders; prices undisclosed; one later advanced to the final round.\",\n  \"“six of the potentially interested parties submitted indications of interest (p. 24)\",\n  \"Q4\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 22\n (\"10/30/2014\",\"9 non-submitting NDA signers (cohort)\",\"Financial\",\"Did not submit\",1,1,\n  None,None,\"\",\"\",\"\",9,\"Not stated\",\"Y\",\n  \"15 signers − 6 submitters = 9; eligible for the indication solicitation with no submission reported; out by 10/30.\",\n  \"“representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest (p. 24)\",\n  \"Q4\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\n # 23\n (\"10/30–11/02/2014\",\"Bidder 2\",\"Financial\",\"Bid\",1,1,\n  81.00,84.00,\"Not stated\",\"Informal\",\"Unclear\",1,\"\",\"\",\n  \"Raised its indication during JPM's 10/30–11/02 calls; part of the four indications at or above $80.00 advanced 11/03.\",\n  \"“increased its indication to a range of $81.00 to $84.00 per share (p. 24)\",\n  \"Q2\", D(2014,10,31), D(2014,10,30), D(2014,11,2)),\n # 24\n (\"11/03/2014\",\"PetSmart (target)\",\"\",\"Round opened\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Board advanced the four bidders at/above $80.00 to the final round; each indicated interest in a Longview rollover but not conditioned on it.\",\n  \"“The board determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round (p. 24)\",\n  \"Q1\", D(2014,11,3), D(2014,11,3), D(2014,11,3)),\n # 25\n (\"11/03/2014\",\"2 eliminated IOI submitters (cohort)\",\"Financial\",\"Dropped by target\",1,1,\n  None,None,\"\",\"\",\"\",2,\"Lower offer than rivals\",\"\",\n  \"Six submitters − four advanced = two; JPM notified the eliminated parties; none would go above their initial indications.\",\n  \"“representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications (p. 24)\",\n  \"\", D(2014,11,3), D(2014,11,3), D(2014,11,3)),\n # 26\n (\"November 2014\",\"Bidder 3 (two finalists combined)\",\"Financial\",\"Bidding group changed\",1,2,\n  None,None,\"\",\"\",\"\",2,\"\",\"\",\n  \"Two of the four finalists combined as 'Bidder 3' (one sought an equity partner; the other would drop out otherwise); unnamed financial bidder 1 is one of them.\",\n  \"“After deliberation and consultation with the Company’s financial and legal advisors, the ad hoc committee authorized these two bidders to work together (p. 24)\",\n  \"\", D(2014,11,16), D(2014,11,3), D(2014,11,30)),\n # 27\n (\"November 2014\",\"PetSmart (target)\",\"\",\"Other material event\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Circulated form of merger agreement with comments due alongside final bids; after Q3 earnings, JPM gave all bidders updated FY2014 projections.\",\n  \"“representatives of J.P. Morgan provided the bidders with updates to the Company’s fiscal year 2014 financial projections (p. 24)\",\n  \"\", D(2014,11,16), D(2014,11,1), D(2014,11,30)),\n # 28\n (\"by 12/03/2014\",\"PetSmart (target)\",\"\",\"Deadline set\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Board's initial plan: final bids due 12/05/2014; process completion targeted 12/15/2014; revised days later.\",\n  \"“The board had initially targeted Monday, December 15 for completion of the sale process, and had initially set Friday, December 5 as the date for submission of bids (p. 24)\",\n  \"Q3\", D(2014,12,3), None, D(2014,12,3)),\n # 29\n (\"12/04–12/05/2014\",\"PetSmart (target)\",\"\",\"Deadline revised\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Committee set 12/10 (was 12/05); asked for mark-ups and financing commitments in advance; shorter window to limit leak risk.\",\n  \"“the Company set the evening of Wednesday, December 10 (five days, rather than 10 days prior to the anticipated December 15 completion date) as the deadline for submission of final bids (p. 25)\",\n  \"Q3\", D(2014,12,4), D(2014,12,4), D(2014,12,5)),\n # 30\n (\"12/06/2014\",\"Buyer Group\",\"Financial\",\"Other material event\",1,2,\n  None,None,\"\",\"\",\"\",1,\"\",\"\",\n  \"Provided financing commitment documents with its merger-agreement comments; Bidder 2 submitted comments only.\",\n  \"“the Buyer Group and Bidder 2 submitted their respective comments on the draft merger agreement and other transaction documents, and the Buyer Group provided its financing commitment documents (p. 25)\",\n  \"\", D(2014,12,6), D(2014,12,6), D(2014,12,6)),\n # 31\n (\"12/09/2014\",\"Buyer Group; Bidder 2\",\"Financial\",\"Other material event\",1,2,\n  None,None,\"\",\"\",\"\",2,\"\",\"\",\n  \"JPM arranged introductory meetings with Longview for these two; bid prices could not be disclosed; Bidder 3 not included.\",\n  \"“J.P. Morgan arranged introductory meetings between Longview and the Buyer Group, and between Longview and Bidder 2 (p. 25)\",\n  \"\", D(2014,12,9), D(2014,12,9), D(2014,12,9)),\n # 32\n (\"12/10/2014\",\"PetSmart (target)\",\"\",\"Deadline\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Final bid letters with revised merger-agreement documents received from Buyer Group and Bidder 2; Bidder 3 gave only a verbal indication.\",\n  \"“PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 (p. 25)\",\n  \"\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\n # 33\n (\"12/10/2014\",\"Buyer Group\",\"Financial\",\"Bid\",1,2,\n  80.70,80.70,\"Yes\",\"Formal\",\"Light\",1,\"\",\"\",\n  \"Final bid letter; below its 10/30 indication ($81.00–$83.00); financing commitment documents provided 12/06; revised merger-agreement documents more favorable.\",\n  \"“The Buyer Group offered $80.70 per share, in cash (p. 25)\",\n  \"\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\n # 34\n (\"12/10/2014\",\"Bidder 2\",\"Financial\",\"Bid\",1,2,\n  80.35,80.35,\"Yes\",\"Formal\",\"Light\",1,\"\",\"\",\n  \"Final bid letter; below its revised indication ($81.00–$84.00); submitted revised merger-agreement documents.\",\n  \"“Bidder 2 offered $80.35 per share, in cash (p. 25)\",\n  \"\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\n # 35\n (\"12/10/2014\",\"Bidder 3\",\"Financial\",\"Did not submit\",1,2,\n  None,None,\"\",\"\",\"\",1,\"Value at or below market price\",\"\",\n  \"Verbal valuation only, not above the ~$78 stock price; told it was unlikely to be competitive; no written offer.\",\n  \"“Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share (p. 25)\",\n  \"Q5\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\n # 36\n (\"12/10/2014\",\"PetSmart (target)\",\"\",\"Deadline revised\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Committee found neither bid represented the bidders' best offers; directed each to increase; improved bids due 12/12.\",\n  \"“the ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids (p. 25)\",\n  \"Q3\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\n # 37\n (\"12/12/2014\",\"Buyer Group\",\"Financial\",\"Other material event\",1,2,\n  None,None,\"\",\"\",\"\",1,\"\",\"\",\n  \"Approved to include a Longview rollover; Longview–Buyer Group NDA lets them exchange detailed information incl. bid price; voting-agreement form provided; JPM had confirmed Longview's interest 12/11.\",\n  \"“later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price (p. 26)\",\n  \"\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\n # 38\n (\"12/12/2014\",\"PetSmart (target)\",\"\",\"Deadline\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Improved best-and-final bids received from both remaining bidders with revised drafts and financing commitments.\",\n  \"“each bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents (p. 26)\",\n  \"\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\n # 39\n (\"12/12/2014\",\"Bidder 2\",\"Financial\",\"Bid\",1,2,\n  81.50,81.50,\"Yes\",\"Formal\",\"Light\",1,\"\",\"\",\n  \"Best and final, confirmed by JPM the same evening; up from $80.35; lower than the Buyer Group's $83.00.\",\n  \"“Bidder 2 submitted an offer of $81.50 per share, in cash (p. 26)\",\n  \"\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\n # 40\n (\"12/12/2014\",\"Buyer Group\",\"Financial\",\"Bid\",1,2,\n  82.50,82.50,\"Yes\",\"Formal\",\"Light\",1,\"\",\"\",\n  \"Oral offer, stated it was working to increase within hours.\",\n  \"“The Buyer Group initially submitted an oral offer of $82.50 per share, in cash, but stated that it was working to increase the offer within the next few hours (p. 26)\",\n  \"\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\n # 41\n (\"12/12/2014\",\"Buyer Group\",\"Financial\",\"Bid\",1,2,\n  83.00,83.00,\"Yes\",\"Formal\",\"Light\",1,\"\",\"\",\n  \"Best and final; revised merger-agreement draft substantially executable; members unwilling/unable to offer more.\",\n  \"“the Buyer Group submitted a best and final offer of $83.00 per share, in cash (p. 26)\",\n  \"\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\n # 42\n (\"12/13/2014\",\"PetSmart (target)\",\"\",\"Other material event\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Board approved the merger with the Buyer Group subject to resolving remaining open points; JPM gave a fairness opinion; determined to reconvene if needed.\",\n  \"“the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders (p. 26)\",\n  \"\", D(2014,12,13), D(2014,12,13), D(2014,12,13)),\n # 43\n (\"12/14/2014\",\"PetSmart (target); Buyer Group\",\"\",\"Merger agreement signed\",1,2,\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"$83.00 per share in cash; voting agreement with Longview; rollover agreement (3,012,050 shares); equity and termination-fee commitment letters executed.\",\n  \"“On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements (p. 26)\",\n  \"\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\n # 44\n (\"12/14/2014\",\"PetSmart (target); Buyer Group\",\"\",\"Merger announced\",\"1\",\"post\",\n  None,None,\"\",\"\",\"\",None,\"\",\"\",\n  \"Press release announced the transaction on signing day.\",\n  \"“the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction (p. 26)\",\n  \"\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\n # 45\n (\"12/14/2014\",\"Bidder 2\",\"Financial\",\"Not selected at signing\",1,2,\n  None,None,\"\",\"\",\"\",1,\"Lower offer than rivals\",\"\",\n  \"Still bidding at $81.50 best and final; the target signed with the Buyer Group at $83.00.\",\n  \"“ultimately negotiated with the Buyer Group as well as two other bidding groups, neither of which was willing to make a definitive offer at a price above $81.50 (p. 27)\",\n  \"\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\n]\n\nledger_header = [\"#\",\"When\",\"Who\",\"Type\",\"Event\",\"Process\",\"Round\",\"Price low\",\"Price high\",\n \"All cash\",\"Formality\",\"Conditions\",\"Count\",\"Exit reason\",\"Inferred\",\"Note\",\n \"Quote and page\",\"Flag\",\"Reviewer note\",\"Sort date\",\"Date from\",\"Date to\"]\n\n# Fix row 44 process to int\nrows = [list(r) for r in rows]\nrows[43][4] = 1  # process of Merger announced row\n\nwb = Workbook()\n\n# ---------------------------------------------------------------- Deal ledger\nws = wb.active\nws.title = \"Deal ledger\"\nws.append(ledger_header)\nfor i, r in enumerate(rows, start=1):\n    (when, who, typ, ev, proc, rnd, plo, phi, cash, form, cond, cnt, exitr,\n     inf, note, quote, flag, sortd, dfrom, dto) = r\n    ws.append([i, when, who, typ, ev, proc, rnd, plo, phi, cash, form, cond,\n               cnt, exitr, inf, note, quote, flag, None, sortd, dfrom, dto])\n\nDATE_COLS = {\"Sort date\": 20, \"Date from\": 21, \"Date to\": 22}\nfor row in ws.iter_rows(min_row=2, max_row=ws.max_row):\n    for c in row:\n        c.alignment = Alignment(wrap_text=True, vertical=\"top\")\n        if c.column in (20, 21, 22) and isinstance(c.value, dt.date):\n            c.number_format = \"MM/DD/YYYY\"\nwidths = {1:5,2:20,3:28,4:11,5:20,6:8,7:6,8:10,9:10,10:10,11:10,12:11,13:7,\n          14:22,15:9,16:58,17:58,18:7,19:14,20:11,21:11,22:11}\nfor col, w in widths.items():\n    ws.column_dimensions[get_column_letter(col)].width = w\nws.freeze_panes = \"A2\"\nws.auto_filter.ref = f\"A1:{get_column_letter(ws.max_column)}{ws.max_row}\"\n\n# ---------------------------------------------------------------- Rounds\nws2 = wb.create_sheet(\"Rounds\")\nws2.append([\"Process\",\"Round\",\"Opened\",\"How opened\",\"Who was in\",\"Due dates\",\n            \"Deadline outcome\",\"Finality\",\"Bids received\",\"How it ended\"])\nws2.append([1,1,D(2014,10,1),\n \"Confidentiality/standstill agreements signed with 15 financial buyers; diligence opened\",\n \"15, all Financial, incl. Buyer Group, Bidder 2 and unnamed financial bidder 1\",\n \"10/30/2014\",\"Enforced\",\"Not final\",\n \"6 of 15: Buyer Group ($81.00–$83.00); Bidder 2 ($78.00 then $81.00–$84.00); unnamed financial bidder 1 ($80.00–$85.00); 3 others (prices undisclosed)\",\n \"four advanced (at or above $80.00), eleven out\"])\nws2.append([1,2,D(2014,11,3),\n \"Board advanced the four bidders at or above $80.00 and asked for final bids; eliminated bidders notified\",\n \"4, all Financial: Buyer Group, Bidder 2, unnamed financial bidder 1 and one further finalist (last two combined as Bidder 3)\",\n \"12/05/2014 → 12/10/2014 → 12/12/2014\",\"Extended; Enforced\",\"Announced as final\",\n \"2 written: Buyer Group ($80.70 → $82.50 → $83.00); Bidder 2 ($80.35 → $81.50); plus Bidder 3's oral valuation (≤ ~$78.00, no written offer)\",\n \"signing with Buyer Group\"])\nfor row in ws2.iter_rows(min_row=2, max_row=ws2.max_row):\n    for c in row:\n        c.alignment = Alignment(wrap_text=True, vertical=\"top\")\n        if c.column == 3 and isinstance(c.value, dt.date):\n            c.number_format = \"MM/DD/YYYY\"\nw2 = {1:8,2:6,3:11,4:42,5:52,6:30,7:20,8:18,9:60,10:28}\nfor col, w in w2.items():\n    ws2.column_dimensions[get_column_letter(col)].width = w\nws2.freeze_panes = \"A2\"\nws2.auto_filter.ref = f\"A1:{get_column_letter(ws2.max_column)}{ws2.max_row}\"\n\n# ---------------------------------------------------------------- Questions\nws3 = wb.create_sheet(\"Questions\")\nws3.append([\"Q\",\"Question\",\"Recommended answer\",\"Why, with page\",\"Rows affected\",\n            \"What changes if answered differently\",\"Reviewer note\"])\nq_rows = [\n (\"Q1\",\n  \"Process and round map: one process, Round 1 opened by the first-week-of-October confidentiality-agreement wave rather than by the earlier solicitation contacts, Round 2 opened 11/03 as the final round, and the 12/12 best-and-final call an extension rather than a new round?\",\n  \"Yes. The filing reports no target outreach wave — J.P. Morgan “was contacted by” the parties — so Round 1 opens at the NDA wave; 11/03 selects four and opens the final round; C11 makes the 12/12 improvement call a Deadline revised, not a new round.\",\n  \"Narrative pp. 23–26; “was contacted by 27 potential participants” p. 23; “proceed to the final round” p. 24.\",\n  \"#8, #9, #13 (Rounds sheet Round 1).\",\n  \"Opening Round 1 at the first substantive contacts (late September/early October) moves the 27-contact rows #8–#9 into Round 1 and shifts Round 1 “Opened” off 10/01.\"),\n (\"Q2\",\n  \"Round 1 deadline outcome: Enforced, or Late bids accepted because Bidder 2 raised its indication during the 10/30–11/02 calls after the 10/30 due date?\",\n  \"Enforced. Bidder 2's raise is dated from 10/30 (not after) and J.P. Morgan's calls sought rationales; the board selected on the bids in hand on 11/03.\",\n  \"“On October 30, six…” and “From October 30 to November 2…” p. 24.\",\n  \"#17, #23 (Rounds sheet Round 1).\",\n  \"If Late bids accepted, Round 1's Deadline outcome changes and Bidder 2's revised row #23 takes Date from 10/31, sorting after the deadline.\"),\n (\"Q3\",\n  \"Round 2 deadline outcomes: 12/05 superseded before arrival (no outcome recorded), 12/10 Extended, 12/12 Enforced — or should 12/05 count as Extended and 12/10 as Enforced (bids were received on it)?\",\n  \"As recorded. 12/05 never arrived — revised 12/04–12/05 — so no deadline row or outcome; 12/10 was reached and extended to 12/12; 12/12 was reached and signing followed with no further extension.\",\n  \"pp. 24–26; improvement request p. 25.\",\n  \"#28, #29, #36 (Rounds sheet Round 2).\",\n  \"Counting 12/05 gives “Extended; Extended; Enforced”; treating 12/10 as Enforced gives “Enforced; Enforced”.\"),\n (\"Q4\",\n  \"Indication count: six parties submitted indications of interest (p. 24), but the Reasons section counts “first round indications of interest from 5 bidder groups” (p. 27). Six or five?\",\n  \"Six. The narrative says six and the arithmetic reconciles (15 signers − 6 = 9 non-submitters; 6 − 4 advanced = 2 eliminated); “5 bidder groups” likely counts only priced or credible groups, or omits one submitter.\",\n  \"pp. 24 and 27.\",\n  \"#17, #21, #22 (Rounds sheet Round 1).\",\n  \"If five, the residual cohort #21 shrinks to 2, the non-submitter exit #22 becomes 15 − 5 = 10, and Round 1 “Bids received” becomes 5.\"),\n (\"Q5\",\n  \"Bidder 3's 12/10 verbal statement — valuation “would not be above” ~$78 with no written offer: a bid or a valuation statement?\",\n  \"Not a Bid (C12): a valuation statement without an offer, recorded in its exit row; the filing says Bidder 3 “did not submit a written offer.”\",\n  \"p. 25.\",\n  \"#35 (Rounds sheet Round 2).\",\n  \"If treated as a Bid, add a Bid row with Price high ≈$78.00 and change Round 2's “Bids received.”\"),\n]\nfor q in q_rows:\n    ws3.append(list(q) + [None])\nfor row in ws3.iter_rows(min_row=2, max_row=ws3.max_row):\n    for c in row:\n        c.alignment = Alignment(wrap_text=True, vertical=\"top\")\nw3 = {1:5,2:60,3:60,4:38,5:24,6:48,7:14}\nfor col, w in w3.items():\n    ws3.column_dimensions[get_column_letter(col)].width = w\nws3.freeze_panes = \"A2\"\nws3.auto_filter.ref = f\"A1:{get_column_letter(ws3.max_column)}{ws3.max_row}\"\n\n# ---------------------------------------------------------------- Deal facts\nws4 = wb.create_sheet(\"Deal facts\")\nws4.append([\"Field\",\"Value\"])\nfacts = [\n (\"Target\",\"PetSmart, Inc. (Delaware corporation; NASDAQ: PETM; 1,404 stores)\"),\n (\"Acquirer\",\"Argos Holdings Inc. (Parent) and Argos Merger Sub Inc.; Parent to be owned by the Buyer Group — funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP and Longview Asset Management, LLC\"),\n (\"Acquirer type\",\"Financial\"),\n (\"Agreed price and consideration\",\"$83.00 per share in cash (all-cash merger); total funds required estimated at approximately $8.4 billion\"),\n (\"Merger agreement signed\",D(2014,12,14)),\n (\"Merger announced\",D(2014,12,14)),\n (\"Filing type and date\",\"DEFM14A definitive proxy statement; dated 02/02/2015\"),\n (\"Background pages\",\"21–26\"),\n (\"Initiation\",\"Mixed — board-led review of strategic alternatives amid activist pressure from JANA Partners and Longview; Industry Participant also approached the Company\"),\n (\"Number of processes\",1),\n (\"Auction screen\",\"Met — 15 independent prospective acquirers (all financial buyers) executed confidentiality agreements with the target in the process\"),\n (\"Whole-company bids\",\"Yes — all-cash whole-company proposals: Buyer Group up to $83.00, Bidder 2 up to $81.50; first-round indications from $78.00 to $85.00\"),\n (\"Currency and units of bid prices\",\"US dollars per share of common stock\"),\n (\"Target financial advisers\",\"J.P. Morgan Securities LLC (sole named financial adviser; engagement letter effective 08/21/2014)\"),\n (\"Target legal advisers\",\"Wachtell, Lipton, Rosen & Katz\"),\n (\"Account\",\"PetSmart's board explored strategic alternatives during 2014 amid activist pressure from JANA Partners and Longview and after an approach from Industry Participant, which the board excluded on antitrust grounds. The board decided to explore a sale on August 13 and announced it publicly on August 19. In the first week of October, 15 financial buyers signed confidentiality and standstill agreements and received diligence; six submitted non-binding indications of interest by October 30, and on November 3 the board advanced the four bidders at or above $80.00 to a final round, where two of them combined as Bidder 3. Final bids on December 10 were $80.70 (Buyer Group) and $80.35 (Bidder 2); after the company demanded improvements, Bidder 2 gave a best-and-final $81.50 and the Buyer Group $83.00 on December 12 while Bidder 3 did not submit. The board approved the merger on December 13 and the parties signed on December 14 at $83.00 per share in cash, with Longview rolling 3,012,050 shares into the buyer.\"),\n]\nfor f, v in facts:\n    ws4.append([f, v])\nfor row in ws4.iter_rows(min_row=2, max_row=ws4.max_row):\n    for c in row:\n        c.alignment = Alignment(wrap_text=True, vertical=\"top\")\n        if c.column == 2 and isinstance(c.value, dt.date):\n            c.number_format = \"MM/DD/YYYY\"\nws4.column_dimensions[\"A\"].width = 32\nws4.column_dimensions[\"B\"].width = 110\nws4.freeze_panes = \"A2\"\nws4.auto_filter.ref = f\"A1:B{ws4.max_row}\"\n\nfor sheet in wb.worksheets:\n    for c in sheet[1]:\n        c.font = Font(bold=True)\n\nout = \"/home/uctpiaj/work/extraction/petsmart.xlsx\"\nwb.save(out)\nprint(\"saved\", out)\nprint(\"ledger rows:\", len(rows))\n"},"output":"Created file successfully: /tmp/opencode/petsmart/build_ledger.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/petsmart/build_ledger.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/petsmart/build_ledger.py\", \"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Build petsmart.xlsx deal ledger from the PetSmart 2015 DEFM14A.\\\"\\\"\\\"\\nimport datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Alignment, Font\\nfrom openpyxl.utils import get_column_letter\\n\\nD = dt.date\\n\\n# ---------------------------------------------------------------- Deal ledger\\n# Columns: #, When, Who, Type, Event, Process, Round, Price low, Price high,\\n# All cash, Formality, Conditions, Count, Exit reason, Inferred, Note,\\n# Quote and page, Flag, Reviewer note, Sort date, Date from, Date to\\nrows = [\\n # 1\\n (\\\"06/18/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Other material event\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Board reviewed alternatives after May–June stockholder communications; chose to explore capital-structure changes (capital-return focus); created ad hoc committee; authorized financial-adviser search.\\\",\\n  \\\"“determined to explore more intensively potential changes to the Company’s capital structure, with a focus on returning capital to stockholders (p. 21)\\\",\\n  \\\"\\\", D(2014,6,18), D(2014,6,18), D(2014,6,18)),\\n # 2\\n (\\\"06/18/2014\\\",\\\"Wachtell, Lipton, Rosen & Katz\\\",\\\"\\\",\\\"Adviser\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Company's legal adviser; first seen acting 06/18/2014; represented the Company on the merger agreement.\\\",\\n  \\\"“the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (“Wachtell Lipton”), its legal advisor (p. 21)\\\",\\n  \\\"\\\", D(2014,6,18), D(2014,6,18), D(2014,6,18)),\\n # 3\\n (\\\"07/03/2014\\\",\\\"JANA Partners\\\",\\\"\\\",\\\"Activist\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Filed Schedule 13D disclosing 9.9% stake; sought review of strategic alternatives incl. sale; met the Company 07/10; 13D amendments and letters through August.\\\",\\n  \\\"“JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company’s outstanding common stock (p. 22)\\\",\\n  \\\"\\\", D(2014,7,3), D(2014,7,3), D(2014,7,3)),\\n # 4\\n (\\\"07/07/2014\\\",\\\"Longview Asset Management\\\",\\\"\\\",\\\"Activist\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Public letter urged board to consider a sale; willing to roll part of its holdings into an acquirer; met board/management in May; reiterated at 07/10 call.\\\",\\n  \\\"“Longview made public a letter to the board in which Longview stated that the board should consider the a sale of the Company (p. 22)\\\",\\n  \\\"\\\", D(2014,7,7), D(2014,7,7), D(2014,7,7)),\\n # 5\\n (\\\"July 2014\\\",\\\"J.P. Morgan Securities LLC\\\",\\\"\\\",\\\"Adviser\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Company's financial adviser (sole named; primary); retained after interviews; engagement letter effective 08/21/2014.\\\",\\n  \\\"“In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor (p. 22)\\\",\\n  \\\"\\\", D(2014,7,16), D(2014,7,1), D(2014,7,31)),\\n # 6\\n (\\\"08/07/2014\\\",\\\"Industry Participant\\\",\\\"Strategic\\\",\\\"Bidder interest\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Told JPM it might revisit Spring combination talks if the Company pursued alternatives; reported to the ad hoc committee; no price.\\\",\\n  \\\"“if the Company were to pursue strategic alternatives, Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring (p. 22)\\\",\\n  \\\"\\\", D(2014,8,7), D(2014,8,7), D(2014,8,7)),\\n # 7\\n (\\\"08/13/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Target sale decision\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Board chose to explore strategic alternatives incl. a possible sale; authorized ad hoc committee to oversee; planned outreach for late September/early October; decided to announce publicly; reviewed Industry Participant risks.\\\",\\n  \\\"“the board (1) determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders (p. 22)\\\",\\n  \\\"\\\", D(2014,8,13), D(2014,8,13), D(2014,8,13)),\\n # 8\\n (\\\"mid-August–end of October 2014\\\",\\\"3 strategic parties (cohort)\\\",\\\"Strategic\\\",\\\"Contact\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",3,\\\"\\\",\\\"\\\",\\n  \\\"Inbound contacts during sale-process preparation; not counting Industry Participant; none signed a confidentiality agreement or entered the process.\\\",\\n  \\\"“including three strategic parties (not counting Industry Participant) and 24 financial participants (p. 23)\\\",\\n  \\\"\\\", D(2014,8,13), D(2014,8,13), D(2014,10,31)),\\n # 9\\n (\\\"mid-August–end of October 2014\\\",\\\"24 financial participants (cohort)\\\",\\\"Financial\\\",\\\"Contact\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",24,\\\"\\\",\\\"\\\",\\n  \\\"Inbound contacts incl. potential lead buyers and large suppliers of equity capital to lead buyers.\\\",\\n  \\\"“24 financial participants (including potential lead buyers as well as large suppliers of equity capital to lead buyers) (p. 23)\\\",\\n  \\\"\\\", D(2014,8,13), D(2014,8,13), D(2014,10,31)),\\n # 10\\n (\\\"08/19/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Sale process announced\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Press release, concurrent with Q2 earnings, announced exploration of strategic alternatives incl. a possible sale; interested parties could contact JPM.\\\",\\n  \\\"“the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company (p. 23)\\\",\\n  \\\"\\\", D(2014,8,19), D(2014,8,19), D(2014,8,19)),\\n # 11\\n (\\\"08/22/2014\\\",\\\"Industry Participant\\\",\\\"Strategic\\\",\\\"Other material event\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"JPM conveyed the board's decision not to invite it into the exploratory process; IP confirmed awareness of the 08/19 announcement; agreed to speak again.\\\",\\n  \\\"“the ad hoc committee directed J.P. Morgan to communicate to Industry Participant the board’s concerns as a result of which Industry Participant would not be invited to participate in the exploratory process (p. 23)\\\",\\n  \\\"\\\", D(2014,8,22), D(2014,8,22), D(2014,8,22)),\\n # 12\\n (\\\"08/27/2014\\\",\\\"Industry Participant\\\",\\\"Strategic\\\",\\\"Other material event\\\",1,0,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Reaffirmed interest; told again it would not be invited, but the board would consider any proposal it submitted; no contact since 08/27.\\\",\\n  \\\"“if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it (p. 23)\\\",\\n  \\\"\\\", D(2014,8,27), D(2014,8,27), D(2014,8,27)),\\n # 13\\n (\\\"first week of October 2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Round opened\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Confidentiality and standstill agreements with 15 financial buyers began the solicitation; non-binding indications due 10/30.\\\",\\n  \\\"“In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers (p. 23)\\\",\\n  \\\"Q1\\\", D(2014,10,1), D(2014,10,1), D(2014,10,7)),\\n # 14\\n (\\\"first week of October 2014\\\",\\\"15 financial buyers (cohort)\\\",\\\"Financial\\\",\\\"NDA signed\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",15,\\\"\\\",\\\"\\\",\\n  \\\"All 15 engaged in due diligence, got management presentations and detailed financial/business-plan information incl. the Profit Improvement Plan during October.\\\",\\n  \\\"“all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company’s senior-most management, and received detailed financial and business plan information (p. 23)\\\",\\n  \\\"\\\", D(2014,10,1), D(2014,10,1), D(2014,10,7)),\\n # 15\\n (\\\"October 2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline set\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Bidders informed non-binding preliminary indications of interest due 10/30/2014.\\\",\\n  \\\"“the potential bidders were informed that non-binding preliminary indications of interest would be due on October 30, 2014 (p. 23)\\\",\\n  \\\"\\\", D(2014,10,16), D(2014,10,1), D(2014,10,31)),\\n # 16\\n (\\\"October 2014\\\",\\\"Longview Asset Management\\\",\\\"\\\",\\\"Other material event\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Willing to roll over up to 7.5M shares on terms/price acceptable to it; bidders asked to indicate interest; not a condition to participation.\\\",\\n  \\\"“Longview had informed the Company that it would be willing to “roll-over” up to 7.5 million shares on terms and price acceptable to Longview (p. 23)\\\",\\n  \\\"\\\", D(2014,10,16), D(2014,10,1), D(2014,10,31)),\\n # 17\\n (\\\"10/30/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Indication deadline reached; six of the 15 signed buyers submitted; JPM called all parties 10/30–11/02.\\\",\\n  \\\"“On October 30, six of the potentially interested parties submitted indications of interest (p. 24)\\\",\\n  \\\"Q2\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 18\\n (\\\"10/30/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Bid\\\",1,1,\\n  81.00,83.00,\\\"Not stated\\\",\\\"Informal\\\",\\\"Unclear\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Non-binding preliminary indication of $81.00–$83.00 per share; among the three initial indications reaching at least $80.00.\\\",\\n  \\\"“the Buyer Group, which indicated a range of $81.00 to $83.00 per share (p. 24)\\\",\\n  \\\"\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 19\\n (\\\"10/30/2014\\\",\\\"Unnamed financial bidder 1\\\",\\\"Financial\\\",\\\"Bid\\\",1,1,\\n  80.00,85.00,\\\"Not stated\\\",\\\"Informal\\\",\\\"Unclear\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Non-binding preliminary indication; one of the three initial indications reaching at least $80.00; later combined into Bidder 3.\\\",\\n  \\\"“another bidder, which suggested a range of $80.00 to $85.00 per share (p. 24)\\\",\\n  \\\"\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 20\\n (\\\"10/30/2014\\\",\\\"Bidder 2\\\",\\\"Financial\\\",\\\"Bid\\\",1,1,\\n  78.00,78.00,\\\"Not stated\\\",\\\"Informal\\\",\\\"Unclear\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Initial non-binding indication of $78.00 per share.\\\",\\n  \\\"“another bidder (which we refer to as “Bidder 2”), which had initially indicated a price of $78.00 (p. 24)\\\",\\n  \\\"\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 21\\n (\\\"10/30/2014\\\",\\\"3 further IOI submitters (cohort)\\\",\\\"Financial\\\",\\\"Bid\\\",1,1,\\n  None,None,\\\"Not stated\\\",\\\"Informal\\\",\\\"Unclear\\\",3,\\\"\\\",\\\"\\\",\\n  \\\"Three of the six submitters besides the individually recorded bidders; prices undisclosed; one later advanced to the final round.\\\",\\n  \\\"“six of the potentially interested parties submitted indications of interest (p. 24)\\\",\\n  \\\"Q4\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 22\\n (\\\"10/30/2014\\\",\\\"9 non-submitting NDA signers (cohort)\\\",\\\"Financial\\\",\\\"Did not submit\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",9,\\\"Not stated\\\",\\\"Y\\\",\\n  \\\"15 signers − 6 submitters = 9; eligible for the indication solicitation with no submission reported; out by 10/30.\\\",\\n  \\\"“representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest (p. 24)\\\",\\n  \\\"Q4\\\", D(2014,10,30), D(2014,10,30), D(2014,10,30)),\\n # 23\\n (\\\"10/30–11/02/2014\\\",\\\"Bidder 2\\\",\\\"Financial\\\",\\\"Bid\\\",1,1,\\n  81.00,84.00,\\\"Not stated\\\",\\\"Informal\\\",\\\"Unclear\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Raised its indication during JPM's 10/30–11/02 calls; part of the four indications at or above $80.00 advanced 11/03.\\\",\\n  \\\"“increased its indication to a range of $81.00 to $84.00 per share (p. 24)\\\",\\n  \\\"Q2\\\", D(2014,10,31), D(2014,10,30), D(2014,11,2)),\\n # 24\\n (\\\"11/03/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Round opened\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Board advanced the four bidders at/above $80.00 to the final round; each indicated interest in a Longview rollover but not conditioned on it.\\\",\\n  \\\"“The board determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round (p. 24)\\\",\\n  \\\"Q1\\\", D(2014,11,3), D(2014,11,3), D(2014,11,3)),\\n # 25\\n (\\\"11/03/2014\\\",\\\"2 eliminated IOI submitters (cohort)\\\",\\\"Financial\\\",\\\"Dropped by target\\\",1,1,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",2,\\\"Lower offer than rivals\\\",\\\"\\\",\\n  \\\"Six submitters − four advanced = two; JPM notified the eliminated parties; none would go above their initial indications.\\\",\\n  \\\"“representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications (p. 24)\\\",\\n  \\\"\\\", D(2014,11,3), D(2014,11,3), D(2014,11,3)),\\n # 26\\n (\\\"November 2014\\\",\\\"Bidder 3 (two finalists combined)\\\",\\\"Financial\\\",\\\"Bidding group changed\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",2,\\\"\\\",\\\"\\\",\\n  \\\"Two of the four finalists combined as 'Bidder 3' (one sought an equity partner; the other would drop out otherwise); unnamed financial bidder 1 is one of them.\\\",\\n  \\\"“After deliberation and consultation with the Company’s financial and legal advisors, the ad hoc committee authorized these two bidders to work together (p. 24)\\\",\\n  \\\"\\\", D(2014,11,16), D(2014,11,3), D(2014,11,30)),\\n # 27\\n (\\\"November 2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Other material event\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Circulated form of merger agreement with comments due alongside final bids; after Q3 earnings, JPM gave all bidders updated FY2014 projections.\\\",\\n  \\\"“representatives of J.P. Morgan provided the bidders with updates to the Company’s fiscal year 2014 financial projections (p. 24)\\\",\\n  \\\"\\\", D(2014,11,16), D(2014,11,1), D(2014,11,30)),\\n # 28\\n (\\\"by 12/03/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline set\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Board's initial plan: final bids due 12/05/2014; process completion targeted 12/15/2014; revised days later.\\\",\\n  \\\"“The board had initially targeted Monday, December 15 for completion of the sale process, and had initially set Friday, December 5 as the date for submission of bids (p. 24)\\\",\\n  \\\"Q3\\\", D(2014,12,3), None, D(2014,12,3)),\\n # 29\\n (\\\"12/04–12/05/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline revised\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Committee set 12/10 (was 12/05); asked for mark-ups and financing commitments in advance; shorter window to limit leak risk.\\\",\\n  \\\"“the Company set the evening of Wednesday, December 10 (five days, rather than 10 days prior to the anticipated December 15 completion date) as the deadline for submission of final bids (p. 25)\\\",\\n  \\\"Q3\\\", D(2014,12,4), D(2014,12,4), D(2014,12,5)),\\n # 30\\n (\\\"12/06/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Other material event\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Provided financing commitment documents with its merger-agreement comments; Bidder 2 submitted comments only.\\\",\\n  \\\"“the Buyer Group and Bidder 2 submitted their respective comments on the draft merger agreement and other transaction documents, and the Buyer Group provided its financing commitment documents (p. 25)\\\",\\n  \\\"\\\", D(2014,12,6), D(2014,12,6), D(2014,12,6)),\\n # 31\\n (\\\"12/09/2014\\\",\\\"Buyer Group; Bidder 2\\\",\\\"Financial\\\",\\\"Other material event\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",2,\\\"\\\",\\\"\\\",\\n  \\\"JPM arranged introductory meetings with Longview for these two; bid prices could not be disclosed; Bidder 3 not included.\\\",\\n  \\\"“J.P. Morgan arranged introductory meetings between Longview and the Buyer Group, and between Longview and Bidder 2 (p. 25)\\\",\\n  \\\"\\\", D(2014,12,9), D(2014,12,9), D(2014,12,9)),\\n # 32\\n (\\\"12/10/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Final bid letters with revised merger-agreement documents received from Buyer Group and Bidder 2; Bidder 3 gave only a verbal indication.\\\",\\n  \\\"“PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 (p. 25)\\\",\\n  \\\"\\\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\\n # 33\\n (\\\"12/10/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Bid\\\",1,2,\\n  80.70,80.70,\\\"Yes\\\",\\\"Formal\\\",\\\"Light\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Final bid letter; below its 10/30 indication ($81.00–$83.00); financing commitment documents provided 12/06; revised merger-agreement documents more favorable.\\\",\\n  \\\"“The Buyer Group offered $80.70 per share, in cash (p. 25)\\\",\\n  \\\"\\\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\\n # 34\\n (\\\"12/10/2014\\\",\\\"Bidder 2\\\",\\\"Financial\\\",\\\"Bid\\\",1,2,\\n  80.35,80.35,\\\"Yes\\\",\\\"Formal\\\",\\\"Light\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Final bid letter; below its revised indication ($81.00–$84.00); submitted revised merger-agreement documents.\\\",\\n  \\\"“Bidder 2 offered $80.35 per share, in cash (p. 25)\\\",\\n  \\\"\\\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\\n # 35\\n (\\\"12/10/2014\\\",\\\"Bidder 3\\\",\\\"Financial\\\",\\\"Did not submit\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"Value at or below market price\\\",\\\"\\\",\\n  \\\"Verbal valuation only, not above the ~$78 stock price; told it was unlikely to be competitive; no written offer.\\\",\\n  \\\"“Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share (p. 25)\\\",\\n  \\\"Q5\\\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\\n # 36\\n (\\\"12/10/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline revised\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Committee found neither bid represented the bidders' best offers; directed each to increase; improved bids due 12/12.\\\",\\n  \\\"“the ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids (p. 25)\\\",\\n  \\\"Q3\\\", D(2014,12,10), D(2014,12,10), D(2014,12,10)),\\n # 37\\n (\\\"12/12/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Other material event\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Approved to include a Longview rollover; Longview–Buyer Group NDA lets them exchange detailed information incl. bid price; voting-agreement form provided; JPM had confirmed Longview's interest 12/11.\\\",\\n  \\\"“later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price (p. 26)\\\",\\n  \\\"\\\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\\n # 38\\n (\\\"12/12/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Deadline\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Improved best-and-final bids received from both remaining bidders with revised drafts and financing commitments.\\\",\\n  \\\"“each bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents (p. 26)\\\",\\n  \\\"\\\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\\n # 39\\n (\\\"12/12/2014\\\",\\\"Bidder 2\\\",\\\"Financial\\\",\\\"Bid\\\",1,2,\\n  81.50,81.50,\\\"Yes\\\",\\\"Formal\\\",\\\"Light\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Best and final, confirmed by JPM the same evening; up from $80.35; lower than the Buyer Group's $83.00.\\\",\\n  \\\"“Bidder 2 submitted an offer of $81.50 per share, in cash (p. 26)\\\",\\n  \\\"\\\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\\n # 40\\n (\\\"12/12/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Bid\\\",1,2,\\n  82.50,82.50,\\\"Yes\\\",\\\"Formal\\\",\\\"Light\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Oral offer, stated it was working to increase within hours.\\\",\\n  \\\"“The Buyer Group initially submitted an oral offer of $82.50 per share, in cash, but stated that it was working to increase the offer within the next few hours (p. 26)\\\",\\n  \\\"\\\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\\n # 41\\n (\\\"12/12/2014\\\",\\\"Buyer Group\\\",\\\"Financial\\\",\\\"Bid\\\",1,2,\\n  83.00,83.00,\\\"Yes\\\",\\\"Formal\\\",\\\"Light\\\",1,\\\"\\\",\\\"\\\",\\n  \\\"Best and final; revised merger-agreement draft substantially executable; members unwilling/unable to offer more.\\\",\\n  \\\"“the Buyer Group submitted a best and final offer of $83.00 per share, in cash (p. 26)\\\",\\n  \\\"\\\", D(2014,12,12), D(2014,12,12), D(2014,12,12)),\\n # 42\\n (\\\"12/13/2014\\\",\\\"PetSmart (target)\\\",\\\"\\\",\\\"Other material event\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Board approved the merger with the Buyer Group subject to resolving remaining open points; JPM gave a fairness opinion; determined to reconvene if needed.\\\",\\n  \\\"“the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders (p. 26)\\\",\\n  \\\"\\\", D(2014,12,13), D(2014,12,13), D(2014,12,13)),\\n # 43\\n (\\\"12/14/2014\\\",\\\"PetSmart (target); Buyer Group\\\",\\\"\\\",\\\"Merger agreement signed\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"$83.00 per share in cash; voting agreement with Longview; rollover agreement (3,012,050 shares); equity and termination-fee commitment letters executed.\\\",\\n  \\\"“On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements (p. 26)\\\",\\n  \\\"\\\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\\n # 44\\n (\\\"12/14/2014\\\",\\\"PetSmart (target); Buyer Group\\\",\\\"\\\",\\\"Merger announced\\\",\\\"1\\\",\\\"post\\\",\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",None,\\\"\\\",\\\"\\\",\\n  \\\"Press release announced the transaction on signing day.\\\",\\n  \\\"“the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction (p. 26)\\\",\\n  \\\"\\\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\\n # 45\\n (\\\"12/14/2014\\\",\\\"Bidder 2\\\",\\\"Financial\\\",\\\"Not selected at signing\\\",1,2,\\n  None,None,\\\"\\\",\\\"\\\",\\\"\\\",1,\\\"Lower offer than rivals\\\",\\\"\\\",\\n  \\\"Still bidding at $81.50 best and final; the target signed with the Buyer Group at $83.00.\\\",\\n  \\\"“ultimately negotiated with the Buyer Group as well as two other bidding groups, neither of which was willing to make a definitive offer at a price above $81.50 (p. 27)\\\",\\n  \\\"\\\", D(2014,12,14), D(2014,12,14), D(2014,12,14)),\\n]\\n\\nledger_header = [\\\"#\\\",\\\"When\\\",\\\"Who\\\",\\\"Type\\\",\\\"Event\\\",\\\"Process\\\",\\\"Round\\\",\\\"Price low\\\",\\\"Price high\\\",\\n \\\"All cash\\\",\\\"Formality\\\",\\\"Conditions\\\",\\\"Count\\\",\\\"Exit reason\\\",\\\"Inferred\\\",\\\"Note\\\",\\n \\\"Quote and page\\\",\\\"Flag\\\",\\\"Reviewer note\\\",\\\"Sort date\\\",\\\"Date from\\\",\\\"Date to\\\"]\\n\\n# Fix row 44 process to int\\nrows = [list(r) for r in rows]\\nrows[43][4] = 1  # process of Merger announced row\\n\\nwb = Workbook()\\n\\n# ---------------------------------------------------------------- Deal ledger\\nws = wb.active\\nws.title = \\\"Deal ledger\\\"\\nws.append(ledger_header)\\nfor i, r in enumerate(rows, start=1):\\n    (when, who, typ, ev, proc, rnd, plo, phi, cash, form, cond, cnt, exitr,\\n     inf, note, quote, flag, sortd, dfrom, dto) = r\\n    ws.append([i, when, who, typ, ev, proc, rnd, plo, phi, cash, form, cond,\\n               cnt, exitr, inf, note, quote, flag, None, sortd, dfrom, dto])\\n\\nDATE_COLS = {\\\"Sort date\\\": 20, \\\"Date from\\\": 21, \\\"Date to\\\": 22}\\nfor row in ws.iter_rows(min_row=2, max_row=ws.max_row):\\n    for c in row:\\n        c.alignment = Alignment(wrap_text=True, vertical=\\\"top\\\")\\n        if c.column in (20, 21, 22) and isinstance(c.value, dt.date):\\n            c.number_format = \\\"MM/DD/YYYY\\\"\\nwidths = {1:5,2:20,3:28,4:11,5:20,6:8,7:6,8:10,9:10,10:10,11:10,12:11,13:7,\\n          14:22,15:9,16:58,17:58,18:7,19:14,20:11,21:11,22:11}\\nfor col, w in widths.items():\\n    ws.column_dimensions[get_column_letter(col)].width = w\\nws.freeze_panes = \\\"A2\\\"\\nws.auto_filter.ref = f\\\"A1:{get_column_letter(ws.max_column)}{ws.max_row}\\\"\\n\\n# ---------------------------------------------------------------- Rounds\\nws2 = wb.create_sheet(\\\"Rounds\\\")\\nws2.append([\\\"Process\\\",\\\"Round\\\",\\\"Opened\\\",\\\"How opened\\\",\\\"Who was in\\\",\\\"Due dates\\\",\\n            \\\"Deadline outcome\\\",\\\"Finality\\\",\\\"Bids received\\\",\\\"How it ended\\\"])\\nws2.append([1,1,D(2014,10,1),\\n \\\"Confidentiality/standstill agreements signed with 15 financial buyers; diligence opened\\\",\\n \\\"15, all Financial, incl. Buyer Group, Bidder 2 and unnamed financial bidder 1\\\",\\n \\\"10/30/2014\\\",\\\"Enforced\\\",\\\"Not final\\\",\\n \\\"6 of 15: Buyer Group ($81.00–$83.00); Bidder 2 ($78.00 then $81.00–$84.00); unnamed financial bidder 1 ($80.00–$85.00); 3 others (prices undisclosed)\\\",\\n \\\"four advanced (at or above $80.00), eleven out\\\"])\\nws2.append([1,2,D(2014,11,3),\\n \\\"Board advanced the four bidders at or above $80.00 and asked for final bids; eliminated bidders notified\\\",\\n \\\"4, all Financial: Buyer Group, Bidder 2, unnamed financial bidder 1 and one further finalist (last two combined as Bidder 3)\\\",\\n \\\"12/05/2014 → 12/10/2014 → 12/12/2014\\\",\\\"Extended; Enforced\\\",\\\"Announced as final\\\",\\n \\\"2 written: Buyer Group ($80.70 → $82.50 → $83.00); Bidder 2 ($80.35 → $81.50); plus Bidder 3's oral valuation (≤ ~$78.00, no written offer)\\\",\\n \\\"signing with Buyer Group\\\"])\\nfor row in ws2.iter_rows(min_row=2, max_row=ws2.max_row):\\n    for c in row:\\n        c.alignment = Alignment(wrap_text=True, vertical=\\\"top\\\")\\n        if c.column == 3 and isinstance(c.value, dt.date):\\n            c.number_format = \\\"MM/DD/YYYY\\\"\\nw2 = {1:8,2:6,3:11,4:42,5:52,6:30,7:20,8:18,9:60,10:28}\\nfor col, w in w2.items():\\n    ws2.column_dimensions[get_column_letter(col)].width = w\\nws2.freeze_panes = \\\"A2\\\"\\nws2.auto_filter.ref = f\\\"A1:{get_column_letter(ws2.max_column)}{ws2.max_row}\\\"\\n\\n# ---------------------------------------------------------------- Questions\\nws3 = wb.create_sheet(\\\"Questions\\\")\\nws3.append([\\\"Q\\\",\\\"Question\\\",\\\"Recommended answer\\\",\\\"Why, with page\\\",\\\"Rows affected\\\",\\n            \\\"What changes if answered differently\\\",\\\"Reviewer note\\\"])\\nq_rows = [\\n (\\\"Q1\\\",\\n  \\\"Process and round map: one process, Round 1 opened by the first-week-of-October confidentiality-agreement wave rather than by the earlier solicitation contacts, Round 2 opened 11/03 as the final round, and the 12/12 best-and-final call an extension rather than a new round?\\\",\\n  \\\"Yes. The filing reports no target outreach wave — J.P. Morgan “was contacted by” the parties — so Round 1 opens at the NDA wave; 11/03 selects four and opens the final round; C11 makes the 12/12 improvement call a Deadline revised, not a new round.\\\",\\n  \\\"Narrative pp. 23–26; “was contacted by 27 potential participants” p. 23; “proceed to the final round” p. 24.\\\",\\n  \\\"#8, #9, #13 (Rounds sheet Round 1).\\\",\\n  \\\"Opening Round 1 at the first substantive contacts (late September/early October) moves the 27-contact rows #8–#9 into Round 1 and shifts Round 1 “Opened” off 10/01.\\\"),\\n (\\\"Q2\\\",\\n  \\\"Round 1 deadline outcome: Enforced, or Late bids accepted because Bidder 2 raised its indication during the 10/30–11/02 calls after the 10/30 due date?\\\",\\n  \\\"Enforced. Bidder 2's raise is dated from 10/30 (not after) and J.P. Morgan's calls sought rationales; the board selected on the bids in hand on 11/03.\\\",\\n  \\\"“On October 30, six…” and “From October 30 to November 2…” p. 24.\\\",\\n  \\\"#17, #23 (Rounds sheet Round 1).\\\",\\n  \\\"If Late bids accepted, Round 1's Deadline outcome changes and Bidder 2's revised row #23 takes Date from 10/31, sorting after the deadline.\\\"),\\n (\\\"Q3\\\",\\n  \\\"Round 2 deadline outcomes: 12/05 superseded before arrival (no outcome recorded), 12/10 Extended, 12/12 Enforced — or should 12/05 count as Extended and 12/10 as Enforced (bids were received on it)?\\\",\\n  \\\"As recorded. 12/05 never arrived — revised 12/04–12/05 — so no deadline row or outcome; 12/10 was reached and extended to 12/12; 12/12 was reached and signing followed with no further extension.\\\",\\n  \\\"pp. 24–26; improvement request p. 25.\\\",\\n  \\\"#28, #29, #36 (Rounds sheet Round 2).\\\",\\n  \\\"Counting 12/05 gives “Extended; Extended; Enforced”; treating 12/10 as Enforced gives “Enforced; Enforced”.\\\"),\\n (\\\"Q4\\\",\\n  \\\"Indication count: six parties submitted indications of interest (p. 24), but the Reasons section counts “first round indications of interest from 5 bidder groups” (p. 27). Six or five?\\\",\\n  \\\"Six. The narrative says six and the arithmetic reconciles (15 signers − 6 = 9 non-submitters; 6 − 4 advanced = 2 eliminated); “5 bidder groups” likely counts only priced or credible groups, or omits one submitter.\\\",\\n  \\\"pp. 24 and 27.\\\",\\n  \\\"#17, #21, #22 (Rounds sheet Round 1).\\\",\\n  \\\"If five, the residual cohort #21 shrinks to 2, the non-submitter exit #22 becomes 15 − 5 = 10, and Round 1 “Bids received” becomes 5.\\\"),\\n (\\\"Q5\\\",\\n  \\\"Bidder 3's 12/10 verbal statement — valuation “would not be above” ~$78 with no written offer: a bid or a valuation statement?\\\",\\n  \\\"Not a Bid (C12): a valuation statement without an offer, recorded in its exit row; the filing says Bidder 3 “did not submit a written offer.”\\\",\\n  \\\"p. 25.\\\",\\n  \\\"#35 (Rounds sheet Round 2).\\\",\\n  \\\"If treated as a Bid, add a Bid row with Price high ≈$78.00 and change Round 2's “Bids received.”\\\"),\\n]\\nfor q in q_rows:\\n    ws3.append(list(q) + [None])\\nfor row in ws3.iter_rows(min_row=2, max_row=ws3.max_row):\\n    for c in row:\\n        c.alignment = Alignment(wrap_text=True, vertical=\\\"top\\\")\\nw3 = {1:5,2:60,3:60,4:38,5:24,6:48,7:14}\\nfor col, w in w3.items():\\n    ws3.column_dimensions[get_column_letter(col)].width = w\\nws3.freeze_panes = \\\"A2\\\"\\nws3.auto_filter.ref = f\\\"A1:{get_column_letter(ws3.max_column)}{ws3.max_row}\\\"\\n\\n# ---------------------------------------------------------------- Deal facts\\nws4 = wb.create_sheet(\\\"Deal facts\\\")\\nws4.append([\\\"Field\\\",\\\"Value\\\"])\\nfacts = [\\n (\\\"Target\\\",\\\"PetSmart, Inc. (Delaware corporation; NASDAQ: PETM; 1,404 stores)\\\"),\\n (\\\"Acquirer\\\",\\\"Argos Holdings Inc. (Parent) and Argos Merger Sub Inc.; Parent to be owned by the Buyer Group — funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP and Longview Asset Management, LLC\\\"),\\n (\\\"Acquirer type\\\",\\\"Financial\\\"),\\n (\\\"Agreed price and consideration\\\",\\\"$83.00 per share in cash (all-cash merger); total funds required estimated at approximately $8.4 billion\\\"),\\n (\\\"Merger agreement signed\\\",D(2014,12,14)),\\n (\\\"Merger announced\\\",D(2014,12,14)),\\n (\\\"Filing type and date\\\",\\\"DEFM14A definitive proxy statement; dated 02/02/2015\\\"),\\n (\\\"Background pages\\\",\\\"21–26\\\"),\\n (\\\"Initiation\\\",\\\"Mixed — board-led review of strategic alternatives amid activist pressure from JANA Partners and Longview; Industry Participant also approached the Company\\\"),\\n (\\\"Number of processes\\\",1),\\n (\\\"Auction screen\\\",\\\"Met — 15 independent prospective acquirers (all financial buyers) executed confidentiality agreements with the target in the process\\\"),\\n (\\\"Whole-company bids\\\",\\\"Yes — all-cash whole-company proposals: Buyer Group up to $83.00, Bidder 2 up to $81.50; first-round indications from $78.00 to $85.00\\\"),\\n (\\\"Currency and units of bid prices\\\",\\\"US dollars per share of common stock\\\"),\\n (\\\"Target financial advisers\\\",\\\"J.P. Morgan Securities LLC (sole named financial adviser; engagement letter effective 08/21/2014)\\\"),\\n (\\\"Target legal advisers\\\",\\\"Wachtell, Lipton, Rosen & Katz\\\"),\\n (\\\"Account\\\",\\\"PetSmart's board explored strategic alternatives during 2014 amid activist pressure from JANA Partners and Longview and after an approach from Industry Participant, which the board excluded on antitrust grounds. The board decided to explore a sale on August 13 and announced it publicly on August 19. In the first week of October, 15 financial buyers signed confidentiality and standstill agreements and received diligence; six submitted non-binding indications of interest by October 30, and on November 3 the board advanced the four bidders at or above $80.00 to a final round, where two of them combined as Bidder 3. Final bids on December 10 were $80.70 (Buyer Group) and $80.35 (Bidder 2); after the company demanded improvements, Bidder 2 gave a best-and-final $81.50 and the Buyer Group $83.00 on December 12 while Bidder 3 did not submit. The board approved the merger on December 13 and the parties signed on December 14 at $83.00 per share in cash, with Longview rolling 3,012,050 shares into the buyer.\\\"),\\n]\\nfor f, v in facts:\\n    ws4.append([f, v])\\nfor row in ws4.iter_rows(min_row=2, max_row=ws4.max_row):\\n    for c in row:\\n        c.alignment = Alignment(wrap_text=True, vertical=\\\"top\\\")\\n        if c.column == 2 and isinstance(c.value, dt.date):\\n            c.number_format = \\\"MM/DD/YYYY\\\"\\nws4.column_dimensions[\\\"A\\\"].width = 32\\nws4.column_dimensions[\\\"B\\\"].width = 110\\nws4.freeze_panes = \\\"A2\\\"\\nws4.auto_filter.ref = f\\\"A1:B{ws4.max_row}\\\"\\n\\nfor sheet in wb.worksheets:\\n    for c in sheet[1]:\\n        c.font = Font(bold=True)\\n\\nout = \\\"/home/uctpiaj/work/extraction/petsmart.xlsx\\\"\\nwb.save(out)\\nprint(\\\"saved\\\", out)\\nprint(\\\"ledger rows:\\\", len(rows))\\n\"}"},"time":{"start":1789825506215,"end":1789825532904}}}}
