es_only=True)}\\ndef norm(s):\\n    s = s.replace('\\\\u2019',\\\"'\\\").replace('\\\\u2018',\\\"'\\\").replace('\\\\u201c','\\\"').replace('\\\\u201d','\\\"')\\n    s = s.replace('\\\\u2014','-').replace('\\\\u2013','-').replace('\\\\u00a0',' ')\\n    return re.sub(r'\\\\s+',' ',s).strip().lower()\\nsrcN = {k: norm(v) for k,v in src.items()}\\nbad = []\\nfor r in ws.iter_rows(min_row=2, values_only=True):\\n    rid, why = r[14], (r[10] or '')\\n    for m in re.finditer(r'\\\"([^\\\"]{8,})\\\"\\\\s*\\\\((P-\\\\d{3}|X-\\\\d{3})', why):\\n        q, sid = m.group(1), m.group(2)\\n        if norm(q) not in srcN.get(sid, ''):\\n            bad.append((rid, sid, q[:70]))\\nprint('quotes not found in the annotated source:', len(bad))\\nfor b in bad: print('  ', b)\\nEOF\"}"},"time":{"start":1789825173763,"end":1789825174931}}}}
