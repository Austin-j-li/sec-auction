{"type":"tool_use","timestamp":1789825008033,"sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","part":{"partID":"prt_0b9e1a8e4001NpqWfsDXkIRDZF","sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","messageID":"msg_0b9e16dab001xsuhn6q61SVeCm","type":"tool","id":"call_00_Mx6M9oZ7BAzKt582IgsR6608","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n# Build the xlsx deliverable from ledger.json + sources.json, with checks.\nimport json, re, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nL = json.load(open('/tmp/opencode/pw/ledger.json'))\nSRC = json.load(open('/tmp/opencode/pw/sources.json'))\nfor r in L:\n    for k in ('dfrom','dto','wdate','duedate'):\n        if r.get(k):\n            r[k] = dt.date.fromisoformat(r[k])\nSRC_ROW = {s['id']: i + 2 for i, s in enumerate(SRC)}\n\nMAIN = {'R024': 'P-016', 'R016': 'P-008', 'R046': 'P-025', 'R047': 'P-025', 'R002': 'P-001'}\n\n# ---------------------------------------------------------------- summary\ndef H(t): return ('H', t, '')\ndef KV(a, b): return ('KV', a, b)\ndef TXT(b): return ('TXT', '', b)\n\nCONTACTS = 29 + 2\nSUMMARY = [\n H('STATUS AND COMMERCIAL ACCOUNT'),\n KV('Pass status', 'AI first pass; not human-approved. Instruction revision: 19 September 2026 (short form). Supplied source: one filing \\u2014 DEFM14A for Providence and Worcester Railroad Company / Genesee & Wyoming Inc. (source file raw_filing/providence-worcester_2016-09-20_DEFM14A.htm; proxy statement dated 09/19/2016; background pages 27\\u201332). No other sources used.'),\n KV('Commercial account', \"Providence and Worcester Railroad Company (PWRR, NASDAQ: PWX), a regional freight railroad, moved from an unsolicited expression of interest by an unnamed Class I rail partner (Party A) in Q4 2015 to a banker-run sale process. GHF (later BMO) ran one process (rounds 0\\u20133): a 29-buyer outreach wave starting the week of 03/28/2016 produced 25 confidentiality agreements (plus late entrant Party C), nine non-binding indications of interest at $17.93\\u2013$26.50 per share by 06/01/2016, and six letters of intent at $19.20\\u2013$24.00 per share by late July 2016. The Transaction Committee advanced G&W and Party B ($24.00) to confirmatory diligence on 07/27/2016; Party D ($24.00 revised) and Party E ($23.81, with Party F financing) briefly re-engaged in early August 2016 but did not continue. On 08/12/2016 the Board determined G&W's revised $25.00 per-share all-cash offer (up from $21.15, then $22.15 with a CVR) was superior after Party B declined to improve, and PWRR signed the merger agreement that day; it was announced 08/15/2016. No competing proposal, go-shop activity or agreement termination is disclosed; completion was expected in Q4 2016 (not observed in this filing), subject to shareholder and STB approval.\"),\n H('DEAL FACTS'),\n KV('Target', 'Providence and Worcester Railroad Company (Rhode Island; NASDAQ: PWX; regional freight railroad; 4,866,593 common shares and 640 preferred shares outstanding as of the 09/16/2016 record date).'),\n KV('Focal acquirer and type', 'Genesee & Wyoming Inc. (Delaware; public; Strategic \\u2014 operating freight-railroad group owning/leasing 121 railroads; eight North American regions with 114 short-line and regional railroads; operations in Australia and the U.K./Europe).'),\n KV('Acquisition vehicle', 'Pullman Acquisition Sub Inc. (Rhode Island; wholly-owned G&W subsidiary formed 08/12/2016 solely for the merger).'),\n KV('Agreed consideration', '$25.00 in cash per common share, without interest, less withholding; each preferred share deemed automatically converted 100-for-1 (plus aggregate accrued/accumulated and unpaid dividends) into common stock before receiving $25.00 per share; all cash.'),\n KV('Signing', '08/12/2016 (merger agreement among the Company, G&W and Merger Sub; voting agreement with the Eder Trusts).'),\n KV('Announcement', '08/15/2016 press release before NASDAQ trading opened (R052).'),\n KV('Completion', 'Expected Q4 2016; not observed in this filing (conditions include majority-of-each-class shareholder approval and STB approval or exemption/voting-trust opinion).'),\n KV('Filing', 'DEFM14A definitive proxy statement, proxy dated 09/19/2016, first mailed on or about 09/21/2016; filed 09/20/2016 (per supplied filename); source file: raw_filing/providence-worcester_2016-09-20_DEFM14A.htm; background pages 27\\u201332.'),\n KV('Labelled calculation \\u2014 as-converted equity value', '(4,866,593 common + 640 preferred \\u00d7 100 conversion) = 4,930,593 shares \\u00d7 $25.00 = $123,264,825 (calculation from disclosed inputs X-004 and X-014; the filing states no total equity value).'),\n KV('Labelled note \\u2014 fee ratio', 'The $3,785,000 termination fee is stated as approximately 3% of the transaction value (X-008); at exactly 3% that implies about $126.2 million on the filing\\u2019s fully diluted basis (calculation; no filed total).'),\n H('PROCESS AND ROUND MAP'),\n KV('Processes', 'One sale process (Process 1). No abandonment, termination or restart observed; a single winner (G&W) signed.'),\n KV('Round 0 (before 03/28/2016)', \"Party A's Q4 2015 approach and interest (R001); GHF engagement 01/27/2016 (R002); Board decision to pursue a change in control strategy 03/14/2016 (R003); Committee authorization 03/24/2016 (R004).\"),\n KV('Round 1 (week of 03/28/2016; R006)', 'Opening: first outreach wave of 29 contacted buyers (R005). Scope: 25 confidentiality agreements (R007/R008); memorandum; IOI solicitation due 05/10/2016, revised to 05/19/2016 (R011\\u2013R013; treatments: Extended, then Enforced); nine IOIs $17.93\\u2013$26.50 (R014); two low bidders excluded and seven advanced with management presentations and data-site access (R017/R018); 16 residual non-submitters inferred (R015). Finality: Not final.'),\n KV('Round 2 (mid-June 2016; R019)', 'Opening: LOI and mark-up solicitation with due date 07/20/2016 (drafts posted 06/29, 06/30, 07/11). Scope: Party C late entry (R020\\u2013R023); six LOIs $19.20\\u2013$24.00 (R025\\u2013R029, R032\\u2013R033); two stated non-submitters (R030/R031). Deadline treatment: Late bids accepted (G&W LOI dated 07/21/2016). Finality: Not final.'),\n KV('Round 3 (07/27/2016; R034)', 'Opening: selection of G&W and Party B for confirmatory due diligence and definitive negotiation (R034); four named bidders dropped (R035\\u2013R038); D and E re-entered 08/01/2016 (R039\\u2013R043) and closed by 08/04/2016 (R044\\u2013R047); G&W final bid $25.00 cash 08/12/2016 (R049); signing (R050) and announcement (R052). Finality: Inferred final.'),\n KV('Post-signing', 'No competing proposal, go-shop or agreement termination disclosed (through the 09/19/2016 proxy). Regulatory status: G&W filed its STB petition for exemption on 09/01/2016 and submitted a voting-trust form to the STB on 09/14/2016 (X-022) \\u2014 context only, no ledger rows after signing.'),\n KV('Round-bidder tallies (submitting units)', 'R1: 9 (nine IOI submitters, R014). R2: 6 (B, C, D, E, F, G&W; Party C counted on R022). R3: 3 (D, E, G&W; Party B continued without a new priced submission). These are per-round submitting units, not unique firms across the deal.'),\n KV('Deadline history', 'IOI 05/10/2016 \\u2014 Extended (R011). IOI 05/19/2016 \\u2014 Enforced (R012/R013). LOI 07/20/2016 \\u2014 Late bids accepted (R024). No deadline stated for the R1 opening wave or the R3 final stage.'),\n H('PARTICIPANTS AND ADVISERS'),\n TXT('Named bidders (first activity; last activity; closing outcome and basis):'),\n KV('Party A (Strategic)', 'First: Q4 2015 approach (R001). Last: memorandum recipient (P-008). Closed by Inferred: identity row (R016, Count 0) mapping to the 16 non-submitting NDA signers (R015) \\u2014 see Q3.'),\n KV('Party B (Strategic)', 'First: 04/21/2016 introductory meeting (P-007/P-008); first ledger row: $24.00 LOI (R025). Advanced 07/27/2016 (R034). Not selected at signing 08/12/2016 (R051, Stated; Would not improve earlier offer).'),\n KV('Party C (Strategic; late entrant)', 'First: early July 2016 approach (R020); NDA (R021); IOI $21.00 (R022) then LOI $19.30 (R028); catch-up access (R023). Dropped 07/27/2016 (R035, Stated).'),\n KV('Party D (Financial)', 'First: $21.00 LOI (R027); $24.00 revised LOI 08/01/2016 (R040); paused 08/02/2016 (R044, own statement); closed Inferred: residual 08/04/2016 (R046).'),\n KV('Party E (Strategic)', 'First: $21.26 LOI (R026); $23.81 revised LOI with Party F financing 08/01/2016 (R042); withdrew the revision and confirmed $21.26 on 08/02/2016 (R043); closed Inferred: residual 08/04/2016 (R047).'),\n KV('Party F (Strategic)', 'First: $19.20 LOI (R029); dropped 07/27/2016 (R038); provided financing support to Party E from 08/01/2016 (R042) after its own exit \\u2014 no new row or re-entry for F.'),\n KV('G&W (Strategic)', 'First: contacted in the opening wave and met at the 2016 Connections Convention 04/03\\u201306 (R005, R010); LOIs $21.15 (R032) and $22.15 (R033); final $25.00 cash bid 08/12/2016 (R049) and signing (R050). Winner \\u2014 no exit row.'),\n KV('Cohorts (not extra parties)', '11 strategic NDA signers (R007); 14 financial NDA signers (R008); nine IOI submitters (R014); two low bidders excluded (R018); 16 residual non-submitters (R015); one unnamed strategic and one unnamed financial LOI non-submitter (R030/R031).'),\n KV('Advisers', 'GHF / BMO Capital Markets Corp. \\u2014 Company financial adviser (engaged 01/27/2016; BMO succession 08/01/2016; fairness opinion 08/12/2016; fee approximately $2.52 million; affiliate-lender conflict disclosed and reviewed 09/06/2016) \\u2014 R002. Hinckley, Allen & Snyder LLP \\u2014 Company legal counsel (first observed 03/24/2016, participating in all Transaction Committee meetings) \\u2014 P-005. Simpson Thacher & Bartlett LLP \\u2014 G&W legal counsel (first observed 08/10/2016) \\u2014 P-026. The Company\\u2019s STB counsel is unnamed in the filing; not recorded as an adviser.'),\n KV('Disclosed attributes', 'PWRR public (NASDAQ: PWX); G&W public (Delaware; non-U.S. operations). Ownership: Eder Trusts 842,742 common (~17.3%) and 500 preferred (~78.1%) \\u2014 voting agreement; GATX Corporation 4.92% of common; Director Alfred P. Smith (GATX Vice President and Group Executive) recused himself from the bidding-process meetings.'),\n H('COUNTS AND AUCTION SCREEN'),\n KV('Contacts', f\"Ledger Contact rows: {CONTACTS} target-initiated contacts (29 in the GHF wave + 2 additional Class I railroads, additive reading; overlap unresolved \\u2014 Q3). Bidder-initiated first contacts: 2 (Party A Q4 2015; Party C early July 2016), recorded as Bidder interest rows and included explicitly in the contact picture (a Contact tally does not capture them; see formulas below). Filing assertions: \\u201ccontacted 11 potential strategic buyers \\u2026 and 18 potential financial buyers\\u201d and \\u201calso approached two additional Class I railroads\\u201d (P-005, P-007).\"),\n KV('Confidentiality agreements', 'Ledger: 11 + 14 + 1 (Party C late entrant) = 26 bidder NDAs; the Board\\u2019s Reasons state \\u201c25 of whom entered into confidentiality agreements \\u2026 and six of whom submitted non-binding letters of intent\\u201d (X-005) \\u2014 reconciliation: the 25 are the opening-wave signers; Party C signed later and is the sixth LOI submitter (count difference flagged, Q3). No standstill provisions (P-005).'),\n KV('Auction screen', 'MET \\u2014 more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for this process (25 in the opening wave; 26 including the later late entrant). No lender-only, adviser or rollover-holder agreements are involved.'),\n KV('Submissions', 'IOI submitters: 9 (R014) \\u2014 matches the filing\\u2019s \\u201cnine written indications of interest.\\u201d LOI submitters: 6 (R025\\u2013R029, R032\\u2013R033; Party C counted on R022) \\u2014 matches \\u201csix LOIs\\u201d and \\u201csix \\u2026 submitted non-binding letters of intent.\\u201d Stated non-submitters at the LOI stage: 2 (one strategic, one financial \\u2014 R030/R031).'),\n KV('Ledger-derived totals (formulas, Include = Yes only)', 'The Summary cells below use SUMIFS over the ledger columns (What happened = column D, Round = F, Include = P, Count = Q: rows 2\\u201353): contacts; NDAs; bids by round; did-not-submit; dropped; re-entered; reaffirmed; not-selected. Each is a separate event tally and must not be added across steps; blank Count cells (adviser, decision, milestone, access rows) are excluded by construction.'),\n ('F', 'Contact rows total (target-initiated)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Contact\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Bidder interest rows total (bidder-initiated first contacts)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Bidder interest\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'NDA signed rows total', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"NDA signed\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Bid rows, Round 1', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Bid\",\\'Deal ledger\\'!$F$2:$F$53,1,\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Bid rows, Round 2', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Bid\",\\'Deal ledger\\'!$F$2:$F$53,2,\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Bid rows, Round 3', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Bid\",\\'Deal ledger\\'!$F$2:$F$53,3,\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Did not submit rows total (16 residual + 1 strategic + 1 financial)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Did not submit\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Dropped by target rows total (2 low bidders + C, D, E, F + D, E inferred)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Dropped by target\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Re-entered rows total (D, E)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Re-entered\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Bid reaffirmed rows total (Party E)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Bid reaffirmed\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n ('F', 'Not selected at signing rows total (Party B)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$53,\\'Deal ledger\\'!$D$2:$D$53,\"Not selected at signing\",\\'Deal ledger\\'!$P$2:$P$53,\"Yes\")'),\n KV('Per-stage balance (\\u00a710.2; units, not spreadsheets rows)', 'R1: 25 entrants (R007 + R008) \\u2212 18 exits (16 inferred R015 + 2 stated R018) = 7 continuing. R2: 7 + 1 entrant (R021 Party C) \\u2212 6 exits (2 stated R030/R031 + 4 stated R035\\u2013R038) = 2 continuing (B, G&W). R3: 2 + 2 re-entries (R039, R041) \\u2212 2 exits (inferred R046/R047) = 2 continuing; at signing, Party B closes (R051) = 1 (winner G&W). Inferred share: 18 of 27 exit events (16 residual + D/E at 08/04) are inferred; 9 are stated. Never negative; ends with the winner only.'),\n KV('Reconciliation notes', 'Outcome tallies are occurrences and affected units, not unique permanent exits (D and E are each closed twice, with a re-entry between). Round-bidder counts are not submissions or unique bidders across the deal. Source totals preserved: 29 wave contacts, 25 wave NDAs, nine IOIs, six LOIs, two LOI non-submitters, two low bidders excluded.'),\n H('COMPARABILITY AND INPUTS'),\n KV('Other-scope proposals', 'None observed \\u2014 all proposals concern acquisition of the whole company\\u2019s equity. Party F\\u2019s financing support to Party E is not a separate offer or a bidding group.'),\n KV('CVR (G&W July bids)', '$1.13 per share contingent value right, based on the subsequent sale of the Company\\u2019s South Quay property; recorded with $20.02 then $21.02 fixed cash at closing; excluded from the final $25.00 all-cash bid on 08/12/2016. Payment timing/formula beyond the sale trigger: not disclosed.'),\n KV('LOI comparability', 'LOI prices were \\u201cbased on different assumptions and requirements related to transaction expenses and change in control payments, which GHF and the Transaction Committee observed could affect the ultimate offer price\\u201d (P-021) \\u2014 not normalized here; treat cross-bidder price comparisons as approximate.'),\n KV('Share basis and counts', 'Stated price ranges and implied equity values assume conversion of preferred stock into common stock. Counts: 4,866,593 common and 640 preferred outstanding (09/16/2016 record date and 08/11/2016 measurement date); preferred convertible into 64,000 common shares. As-converted equity value calculation at $25.00 = $123,264,825 (labelled calculation above).'),\n KV('Market benchmarks', 'Closing price 08/12/2016 (last trading day before announcement): $16.30 \\u2014 the Board cites a 53% premium for the $25.00 consideration. Closing price 09/16/2016: $24.88. Q3 2016 trading range (through 09/16/2016): high $25.00, low $15.60 (p71).'),\n KV('Glossary', 'NDA \\u2014 confidentiality agreement. IOI \\u2014 written non-binding indication of interest. LOI \\u2014 non-binding letter of intent. Data site/data room \\u2014 internet data site for legal and financial due diligence. CVR \\u2014 contingent value right (here tied to the South Quay property sale). STB \\u2014 Surface Transportation Board; voting trust \\u2014 arrangement to insulate G&W from unauthorized control pending STB clearance. Fiduciary out \\u2014 the Board\\u2019s ability to change its recommendation or terminate for a superior proposal, with matching rights. Eder Trusts \\u2014 the Company\\u2019s controlling family trusts. Class I railroad \\u2014 largest U.S. freight railroads. Markup \\u2014 a bidder\\u2019s proposed edits to transaction documents (not a signed agreement).'),\n]\n\n# ---------------------------------------------------------------- questions\nQUESTIONS = [\n (\"Q1\", \"Process and round map; inferred starts; rejected boundary candidates\",\n  \"Keep one process (no termination or restart observed). R1 opens the week of 03/28/2016 at the first outreach wave (R005/R006); R2 opens mid-June 2016 at the LOI and mark-up solicitation due 07/20/2016 (R019); R3 opens 07/27/2016 on the selection of G&W and Party B for confirmatory and definitive negotiation (R034; Inferred final). Rejected boundaries to retain as their own rows: R003 (03/14/2016 Board decision \\u2014 outreach began about two weeks later, outside the \\u201cabout a week\\u201d execution test), R004 (03/24/2016 Committee authorization \\u2014 the alternative anchor under the decision rule), R017 (06/01/2016 advancement to presentations and data site \\u2014 no updated offers sought; folded into R1), R045 (08/04/2016 prioritization) and R049 (08/12/2016 final bid \\u2014 inside R3). Post-signing: no go-shop and no competing proposal observed.\",\n  \"P-005 (first contact wave); P-010 (advancement); P-011 (LOI instruction); P-022 (selection); P-027 (final bid). Smallest round map that preserves each substantive transition.\",\n  \"R003, R004, R005, R006, R017, R019, R034, R045, R049\",\n  \"Moving the R1 anchor to R003/R004 shifts the round 0/1 boundary and the round assignment of the NDA cohort rows; splitting 06/01/2016 into its own round renumbers R2/R3 and splits the LOI bidders\\u2019 round history; treating 08/04/2016 as a new round would move the D/E inferred closes and the G&W final bid.\",\n  \"Pending\", \"\"),\n (\"Q2\", \"Deadlines, the extension and elapsed-deadline treatments\",\n  \"05/10/2016 (IOI): Extended \\u2014 superseded by the 05/19/2016 postponement before arrival (R011/R012). 05/19/2016 (IOI): Enforced \\u2014 the target moved to selection on 06/01/2016 on the bids in hand; the receipt window (05/19\\u201306/01/2016) straddles the due date but no bid is shown dated after it, so \\u201cLate bids accepted\\u201d is not supported. 07/20/2016 (LOI): Late bids accepted \\u2014 G&W\\u2019s LOI is dated 07/21/2016 and was considered with no revision of the deadline; the other five LOIs are undated. No deadline stated for the R1 opening wave or the R3 final stage.\",\n  \"P-009 (advice and extension, purpose, no requester); P-010 (receipt window and 06/01/2016 selection); P-014/P-016 (six LOIs; G&W dated 07/21/2016). \\u00a78.3 tests.\",\n  \"R011, R012, R013, R024 (also R014, R032)\",\n  \"Reclassifying 05/19/2016 as Late bids accepted or Passed without action changes the Summary map and the Working date logic for R015 (16 residual non-submitters) and R014; adding a revision row for 07/20/2016 would imply an extension the filing does not state.\",\n  \"Pending\", \"\"),\n (\"Q3\", \"NDA/contact populations, count reconciliation and the Party A identity mapping\",\n  \"Record 25 opening-wave signers (11 strategic + 14 financial) plus Party C\\u2019s later NDA = 26 total bidder NDAs; the Board\\u2019s \\u201c25 of whom entered into confidentiality agreements \\u2026 and six of whom submitted non-binding letters of intent\\u201d (X-005) cannot have C inside the 25 and among six submitters; recommended reading: the 25 are the solicited wave and C is the sixth submitter added later. The two additional Class I railroads are recorded as additional contacts (+2), but may overlap the 11 strategic buyers \\u2014 if so, contacts total 29 and the Class I row becomes a duplicate. The two stated LOI non-submitters (one strategic, one financial) are treated as participants live at the LOI stage; the filing does not identify them or exclude overlap with the excluded low bidders. Party A\\u2019s Count-0 identity row maps it to the 16 non-submitting NDA signers (recommended) rather than the nine IOI submitters.\",\n  \"P-005 (11 + 14 signers), P-007 (two additional Class I railroads), P-010 (nine IOIs; seven advance), P-013 (Party C), P-014/P-021 (six LOIs; two non-submitters), X-005 (Board count 25/six). Arithmetic: 11 + 14 = 25; 25 + 1 = 26.\",\n  \"R005, R007, R008, R009, R014, R015, R016, R021, R030, R031\",\n  \"If the Class I railroads are inside the 11, the contact total falls to 29 and R009 should be folded; if Party C is inside the 25, the NDA total is 25 and R021 loses its Count 1; changing Party A\\u2019s covering cohort changes the identity row\\u2019s stated arithmetic but moves no count.\",\n  \"Pending\", \"\"),\n (\"Q4\", \"Formality and conditions levels; no late-reconfirmation rows\",\n  \"Keep: nine-IOI cohort Informal (non-binding solicitation; no markups at that stage); Party E Informal on the issues-list default, flagged as borderline (a documented response with proposed changes, but no returned agreement markup and no final/binding solicitation); Heavy conditions on G&W 07/21 and 07/26 (three-week exclusive diligence), Party D (four-week/30-day), Party C and Party F (30-day) and Party E (60-day exclusive) \\u2014 each turns on a stated diligence or exclusivity period; Party B Light (expedited diligence review); G&W\\u2019s 08/12/2016 final bid Light (diligence completed 08/11/2016; no financing condition reported, G&W financial-wherewithal representation). No None classifications. No late-reconfirmation row is created: G&W restated its position with a new priced bid on 08/12/2016 (R049), and the target never moved to finalize with Party B on its standing offer \\u2014 B declined to improve (R051).\",\n  \"P-010, P-014\\u2013P-020 (LOI terms), P-023 (D/E revisions), P-027 (final bid), X-007 (no financing condition). \\u00a79.2\\u20139.3 defaults; late-reconfirmation rule \\u00a79.1.\",\n  \"R014, R022, R025, R026, R027, R028, R029, R032, R033, R040, R042, R043, R049\",\n  \"Upgrading Party E to Formal would raise its documentation signal without changing its Heavy conditions; downgrading Party B or G&W would require a reported Heavy trigger; adding a late-reconfirmation row would duplicate an existing priced G&W bid and misstate its Formality origin.\",\n  \"Pending\", \"\"),\n (\"Q5\", \"Participation outcomes, agency/reasons and every inferred close\",\n  \"Keep the stated outcomes: C, D, E and F dropped 07/27/2016 (Decided by Target; Lower offer than rivals \\u2014 the Committee cited the finalists\\u2019 higher offers); D\\u2019s 08/02/2016 Participation paused (Decided by Bidder; Terms or process \\u2014 it stopped after the Company declined its requested no-signing commitment; a pause is not an exit); E\\u2019s 08/02/2016 withdrawal of its revised proposal and price confirmation (Bid reaffirmed; not an exit); Party B Not selected at signing 08/12/2016 (Stated; Target; Would not improve earlier offer); two low bidders dropped 06/01/2016 (Stated). Inferred closes to confirm: 16 residual non-submitters at 05/19/2016 (Inferred: residual; 25 \\u2212 9 = 16); Party A Count-0 identity row (Inferred: identity); D and E closed 08/04/2016 (Inferred: residual \\u2014 the 08/04/2016 continuing set, G&W and Party B, is named without them). Party F\\u2019s 08/01/2016 financing support to Party E gets no row of its own because F had already exited on 07/27/2016; it is carried on E\\u2019s bid (Support tag) with a Related link to F\\u2019s earlier bid.\",\n  \"P-010 (exclusions and advancement), P-014 (non-submitters), P-022 (07/27/2016 notice), P-023 (D pause; E revision/confirmation; F support), P-025 (08/04/2016 continuing set), P-030 (B declines to improve). \\u00a7\\u00a710.1\\u201310.2 arithmetic and transition logic.\",\n  \"R015, R016, R018, R030, R031, R035\\u2013R047, R051\",\n  \"Treating D\\u2019s pause as a withdrawal, or closing D/E at signing rather than 08/04/2016, changes the per-stage balance and the inferred share; giving F a re-entry or group row double-counts its exit; moving Party A\\u2019s identity row to another transition changes only its stated arithmetic, not any count.\",\n  \"Pending\", \"\"),\n (\"Q6\", \"Consideration comparability, the CVR and equity-value inputs\",\n  \"Keep G&W\\u2019s July bids with the $1.13 CVR (contingent on the subsequent sale of the South Quay property; fixed cash at closing $20.02, then $21.02) and the final 08/12/2016 bid at $25.00 all cash (CVR excluded). Do not normalize LOI prices for the disclosed differences in transaction-expense and change-in-control-payment assumptions (the Committee and GHF observed they could affect the ultimate offer price). Present the as-converted equity value only as a labelled calculation: (4,866,593 + 64,000) \\u00d7 $25.00 = $123,264,825 (inputs X-004, X-014); note separately that the approximately 3% termination fee implies about $126.2 million on the filing\\u2019s fully diluted basis. Market benchmarks: $16.30 (08/12/2016) and $24.88 (09/16/2016); 53% premium per the Board.\",\n  \"P-010 (share basis; implied equity values), P-014 (LOI range), P-016 (CVR, cash split), P-021 (expense/change-in-control caveat), X-004 (share counts), X-006 (premium), X-008 (fee ratio), X-012 (prices), X-014 ($25.00).\",\n  \"R014, R032, R033, R049, R050; Summary deal facts and comparability blocks\",\n  \"Adding the CVR to per-share cells would overstate guaranteed cash; converting the disclosed equity values into new per-share prices would invent observations; changing the share base alters only the labelled calculation (the filing states no total equity value).\",\n  \"Pending\", \"\"),\n (\"Q7\", \"Assigned Working dates and display order within stages\",\n  \"Confirm the conventions used as sort keys (never as observed dates): NDA cohorts at the contact-wave bound 03/28/2016 (R007/R008); Class I railroad contact by 04/07/2016 (R009); IOI deadline set by 04/27/2016 and revision at the 04/28\\u201305/19/2016 midpoint = 05/08/2016 (R011/R012); IOI-stage rows at the 05/19/2016 due date (R013\\u2013R016); R2 opening at the mid-June midpoint = 06/15/2016 (R019); Party C approach/NDA midpoints 07/05 and 07/06/2016 and catch-up access bound 07/14/2016 (R020/R021/R023); LOI-stage rows at the 07/20/2016 deadline (R024\\u2013R031); 07/27/2016 notices at the decision day (R035\\u2013R038); 08/04/2016 inferred closes at the decision day (R046/R047). Equal dates are ordered by # as a deterministic display convention.\",\n  \"P-005, P-009, P-011, P-013, P-014, P-022, P-025; \\u00a78.1 rules 2\\u20136 and the order constraint.\",\n  \"R007\\u2013R013, R015, R016, R019\\u2013R031, R035\\u2013R038, R044, R046, R047\",\n  \"Changing a convention (for example, using the late-July midpoint instead of the 07/20/2016 deadline) reorders rows within a round and can break the non-decreasing Working-date constraint against dated rows.\",\n  \"Pending\", \"\"),\n]\n\n# ---------------------------------------------------------------- workbook\nwb = Workbook()\nthin = Side(style='thin', color='D9D9D9')\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\nhdr_fill = PatternFill('solid', fgColor='1F3864')\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\ngrp_fill = PatternFill('solid', fgColor='D9E1F2')\nwrap_top = Alignment(wrap_text=True, vertical='top')\nwrap_ctr = Alignment(wrap_text=True, vertical='top', horizontal='center')\n\n# ---- Deal ledger\nws = wb.active; ws.title = 'Deal ledger'\ncols = [('#',7),('When',26),('Who',30),('What happened',20),('Process',8),('Round',7),('Type',12),\n        ('Terms or outcome',66),('Formality',12),('Conditions level',13),('Why and evidence',78),\n        ('Source',20),('Review',9),('Reviewer note',26),\n        ('Row id',8),('Include',8),('Count',7),('Date from',11),('Date to',11),('Working date',12),\n        ('Date basis',16),('Date method',20),('Price low',9),('Price high',9),('Price kind',12),\n        ('Price origin',13),('Currency',9),('All cash',10),('Cash at closing',12),('Conditions detail',50),\n        ('Due date',11),('Deadline treatment',16),('Round finality',14),('Decided by',10),('Exit reason',22),\n        ('Outcome basis',16),('Page',6),('Related rows',20),('Deal',12)]\nfor c,(name,w) in enumerate(cols, start=1):\n    cell = ws.cell(row=1, column=c, value=name)\n    cell.font = hdr_font; cell.fill = hdr_fill\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\n    ws.column_dimensions[get_column_letter(c)].width = w\nws.row_dimensions[1].height = 30\n\ndef dstr(d): return d\nfor i, r in enumerate(L):\n    rr = i + 2\n    main = MAIN.get(r['id']) or r['source'].split(';')[0].strip()\n    vals = [r['num'], r['when'], r['who'], r['what'], r['process'], r['round'], r['type'],\n            r['terms'], r['formality'], r['conditions'], r['why'], r['source'], r['review'], '',\n            r['id'], 'Yes', r['count'], r['dfrom'], r['dto'], r['wdate'], r['dbasis'], r['dmethod'],\n            r['plow'], r['phigh'], r['pkind'], r['porigin'], r['currency'], r['allcash'], r['cashclose'],\n            r['conddetail'], r['duedate'], r['dlteat'], r['finality'], r['decided'], r['exit'],\n            r['obasis'], r['page'], r['related'], r['deal']]\n    for c, v in enumerate(vals, start=1):\n        cell = ws.cell(row=rr, column=c, value=v)\n        cell.alignment = wrap_top\n        cell.border = border\n        if c in (1,5,6,15,17,37): cell.alignment = wrap_ctr\n        if c in (18,19,20,31) and isinstance(v, dt.date): cell.number_format = 'MM/DD/YYYY'\n        if c in (23,24,29) and isinstance(v,(int,float)): cell.number_format = '0.00'\n    # hyperlink on Source\n    sc = ws.cell(row=rr, column=12)\n    sc.hyperlink = Hyperlink(ref=sc.coordinate, location=f\"'Source text'!A{SRC_ROW[main]}\")\n    sc.font = Font(color='0563C1', underline='single', size=10)\n    ws.cell(row=rr, column=2).font = Font(size=10)\n\n# groups (collapsed)\ngroups = [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),\n          ('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]\nfor g in groups:\n    ws.column_dimensions.group(g[0], g[1], outline_level=1, hidden=True)\nws.sheet_properties.outlinePr.summaryRight = False\nws.freeze_panes = 'E2'\nws.auto_filter.ref = f'A1:AM{len(L)+1}'\n\n# validations\nlists = {\n 'A': ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'],\n 'B': ['Strategic','Financial','Mixed','Unknown'],\n 'C': ['Formal','Informal','Insufficient evidence','Varies'],\n 'D': ['None','Light','Heavy','Insufficient evidence','Varies'],\n 'E': ['Yes','No'],\n 'F': ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\n 'G': ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\n 'H': ['Point','Bidder range','Group envelope','Bound only','Undisclosed'],\n 'I': ['Stated','Carried forward','Inferred'],\n 'J': ['Yes','No','Not stated'],\n 'K': ['Extended','Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\n 'L': ['Announced as final','Inferred final','Not final'],\n 'M': ['Bidder','Target','Both','Unknown'],\n 'N': ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\n 'O': ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\n}\nvalidations = [\n ('D', 'A', 'D2:D200'), ('G', 'B', 'G2:G200'), ('I', 'C', 'I2:I200'), ('J', 'D', 'J2:J200'),\n ('P', 'E', 'P2:P200'), ('U', 'F', 'U2:U200'), ('V', 'G', 'V2:V200'), ('Y', 'H', 'Y2:Y200'),\n ('Z', 'I', 'Z2:Z200'), ('AB', 'J', 'AB2:AB200'), ('AF', 'K', 'AF2:AF200'),\n ('AG', 'L', 'AG2:AG200'), ('AH', 'M', 'AH2:AH200'), ('AI', 'N', 'AI2:AI200'),\n ('AJ', 'O', 'AJ2:AJ200'),\n]\ndv_objs = []\nfor col_letter, list_col, rng in validations:\n    n = len(lists[list_col])\n    dv = DataValidation(type='list', formula1=f'=Lists!${list_col}$2:${list_col}${n+1}',\n                        allow_blank=True, showErrorMessage=True)\n    dv.error = 'Use a value from the Lists sheet.'\n    dv.errorTitle = 'Controlled value'\n    ws.add_data_validation(dv)\n    dv.add(rng)\n    dv_objs.append(dv)\n\n# ---- Summary\nws2 = wb.create_sheet('Summary')\nws2.column_dimensions['A'].width = 42\nws2.column_dimensions['B'].width = 150\nt = ws2.cell(row=1, column=1, value='Summary \\u2014 Providence & Worcester Railroad Company / Genesee & Wyoming Inc. (PWRR-G&W) \\u2014 AI first pass (not human-approved)')\nt.font = Font(bold=True, size=12)\nrowi = 3\nfor kind, a, b in SUMMARY:\n    if kind == 'H':\n        c = ws2.cell(row=rowi, column=1, value=a); c.font = Font(bold=True, color='1F3864', size=11)\n        c.fill = grp_fill\n        ws2.cell(row=rowi, column=2).fill = grp_fill\n    elif kind == 'KV':\n        ca = ws2.cell(row=rowi, column=1, value=a); ca.font = Font(bold=True, size=10); ca.alignment = wrap_top\n        cb = ws2.cell(row=rowi, column=2, value=b); cb.alignment = wrap_top\n        if isinstance(b, str) and b.startswith('='):\n            cb.number_format = '0'\n    elif kind == 'F':\n        ca = ws2.cell(row=rowi, column=1, value=a); ca.font = Font(bold=True, size=10); ca.alignment = wrap_top\n        cb = ws2.cell(row=rowi, column=2, value=b); cb.alignment = wrap_top; cb.number_format = '0'\n    else:\n        ws2.cell(row=rowi, column=1, value=b).alignment = wrap_top\n    rowi += 1\nws2.freeze_panes = 'A3'\n\n# ---- Questions\nws3 = wb.create_sheet('Questions')\nqcols = [('Q',6),('Review topic',38),('Recommended answer',95),('Why and source',55),\n         ('Affected rows/fields',28),('Consequence of changing it',55),('Status',10),('Reviewer note',30)]\nfor c,(name,w) in enumerate(qcols, start=1):\n    cell = ws3.cell(row=1, column=c, value=name); cell.font = hdr_font; cell.fill = hdr_fill\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\n    ws3.column_dimensions[get_column_letter(c)].width = w\nws3.row_dimensions[1].height = 28\nfor i, q in enumerate(QUESTIONS):\n    rr = i + 2\n    for c, v in enumerate(q, start=1):\n        cell = ws3.cell(row=rr, column=c, value=v if v else None)\n        cell.alignment = wrap_top; cell.border = border\nws3.freeze_panes = 'B2'\nws3.auto_filter.ref = f'A1:H{len(QUESTIONS)+1}'\n\n# ---- Source text\nws4 = wb.create_sheet('Source text')\nfor c,(name,w) in enumerate([('Paragraph',12),('Section',64),('Page',7),('Text',170)], start=1):\n    cell = ws4.cell(row=1, column=c, value=name); cell.font = hdr_font; cell.fill = hdr_fill\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\n    ws4.column_dimensions[get_column_letter(c)].width = w\nfor i, s in enumerate(SRC):\n    rr = i + 2\n    ws4.cell(row=rr, column=1, value=s['id']).alignment = wrap_top\n    ws4.cell(row=rr, column=2, value=s['section']).alignment = wrap_top\n    pc = ws4.cell(row=rr, column=3, value=s['page']); pc.alignment = wrap_ctr\n    ws4.cell(row=rr, column=4, value=s['text']).alignment = wrap_top\nws4.freeze_panes = 'A2'\nws4.auto_filter.ref = f'A1:D{len(SRC)+1}'\n\n# ---- Lists (hidden)\nws5 = wb.create_sheet('Lists')\nfor col, vals in lists.items():\n    ws5.cell(row=1, column=ord(col)-64, value={'A':'What happened','B':'Type','C':'Formality','D':'Conditions level','E':'Include','F':'Date basis','G':'Date method','H':'Price kind','I':'Price origin','J':'All cash','K':'Deadline treatment','L':'Round finality','M':'Decided by','N':'Exit reason','O':'Outcome basis'}[col]).font = Font(bold=True)\n    for j, v in enumerate(vals):\n        ws5.cell(row=j+2, column=ord(col)-64, value=v)\nws5.sheet_state = 'hidden'\n\nimport os\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\nOUT = '/home/uctpiaj/work/extraction/providence-worcester.xlsx'\nwb.save(OUT)\nprint('saved', OUT)\n","path":"/tmp/opencode/pw/build2.py"},"output":"Created file successfully: /tmp/opencode/pw/build2.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/pw/build2.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"#!/usr/bin/env python3\\n# Build the xlsx deliverable from ledger.json + sources.json, with checks.\\nimport json, re, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nL = json.load(open('/tmp/opencode/pw/ledger.json'))\\nSRC = json.load(open('/tmp/opencode/pw/sources.json'))\\nfor r in L:\\n    for k in ('dfrom','dto','wdate','duedate'):\\n        if r.get(k):\\n            r[k] = dt.date.fromisoformat(r[k])\\nSRC_ROW = {s['id']: i + 2 for i, s in enumerate(SRC)}\\n\\nMAIN = {'R024': 'P-016', 'R016': 'P-008', 'R046': 'P-025', 'R047': 'P-025', 'R002': 'P-001'}\\n\\n# ---------------------------------------------------------------- summary\\ndef H(t): return ('H', t, '')\\ndef KV(a, b): return ('KV', a, b)\\ndef TXT(b): return ('TXT', '', b)\\n\\nCONTACTS = 29 + 2\\nSUMMARY = [\\n H('STATUS AND COMMERCIAL ACCOUNT'),\\n KV('Pass status', 'AI first pass; not human-approved. Instruction revision: 19 September 2026 (short form). Supplied source: one filing \\\\u2014 DEFM14A for Providence and Worcester Railroad Company / Genesee & Wyoming Inc. (source file raw_filing/providence-worcester_2016-09-20_DEFM14A.htm; proxy statement dated 09/19/2016; background pages 27\\\\u201332). No other sources used.'),\\n KV('Commercial account', \\\"Providence and Worcester Railroad Company (PWRR, NASDAQ: PWX), a regional freight railroad, moved from an unsolicited expression of interest by an unnamed Class I rail partner (Party A) in Q4 2015 to a banker-run sale process. GHF (later BMO) ran one process (rounds 0\\\\u20133): a 29-buyer outreach wave starting the week of 03/28/2016 produced 25 confidentiality agreements (plus late entrant Party C), nine non-binding indications of interest at $17.93\\\\u2013$26.50 per share by 06/01/2016, and six letters of intent at $19.20\\\\u2013$24.00 per share by late July 2016. The Transaction Committee advanced G&W and Party B ($24.00) to confirmatory diligence on 07/27/2016; Party D ($24.00 revised) and Party E ($23.81, with Party F financing) briefly re-engaged in early August 2016 but did not continue. On 08/12/2016 the Board determined G&W's revised $25.00 per-share all-cash offer (up from $21.15, then $22.15 with a CVR) was superior after Party B declined to improve, and PWRR signed the merger agreement that day; it was announced 08/15/2016. No competing proposal, go-shop activity or agreement termination is disclosed; completion was expected in Q4 2016 (not observed in this filing), subject to shareholder and STB approval.\\\"),\\n H('DEAL FACTS'),\\n KV('Target', 'Providence and Worcester Railroad Company (Rhode Island; NASDAQ: PWX; regional freight railroad; 4,866,593 common shares and 640 preferred shares outstanding as of the 09/16/2016 record date).'),\\n KV('Focal acquirer and type', 'Genesee & Wyoming Inc. (Delaware; public; Strategic \\\\u2014 operating freight-railroad group owning/leasing 121 railroads; eight North American regions with 114 short-line and regional railroads; operations in Australia and the U.K./Europe).'),\\n KV('Acquisition vehicle', 'Pullman Acquisition Sub Inc. (Rhode Island; wholly-owned G&W subsidiary formed 08/12/2016 solely for the merger).'),\\n KV('Agreed consideration', '$25.00 in cash per common share, without interest, less withholding; each preferred share deemed automatically converted 100-for-1 (plus aggregate accrued/accumulated and unpaid dividends) into common stock before receiving $25.00 per share; all cash.'),\\n KV('Signing', '08/12/2016 (merger agreement among the Company, G&W and Merger Sub; voting agreement with the Eder Trusts).'),\\n KV('Announcement', '08/15/2016 press release before NASDAQ trading opened (R052).'),\\n KV('Completion', 'Expected Q4 2016; not observed in this filing (conditions include majority-of-each-class shareholder approval and STB approval or exemption/voting-trust opinion).'),\\n KV('Filing', 'DEFM14A definitive proxy statement, proxy dated 09/19/2016, first mailed on or about 09/21/2016; filed 09/20/2016 (per supplied filename); source file: raw_filing/providence-worcester_2016-09-20_DEFM14A.htm; background pages 27\\\\u201332.'),\\n KV('Labelled calculation \\\\u2014 as-converted equity value', '(4,866,593 common + 640 preferred \\\\u00d7 100 conversion) = 4,930,593 shares \\\\u00d7 $25.00 = $123,264,825 (calculation from disclosed inputs X-004 and X-014; the filing states no total equity value).'),\\n KV('Labelled note \\\\u2014 fee ratio', 'The $3,785,000 termination fee is stated as approximately 3% of the transaction value (X-008); at exactly 3% that implies about $126.2 million on the filing\\\\u2019s fully diluted basis (calculation; no filed total).'),\\n H('PROCESS AND ROUND MAP'),\\n KV('Processes', 'One sale process (Process 1). No abandonment, termination or restart observed; a single winner (G&W) signed.'),\\n KV('Round 0 (before 03/28/2016)', \\\"Party A's Q4 2015 approach and interest (R001); GHF engagement 01/27/2016 (R002); Board decision to pursue a change in control strategy 03/14/2016 (R003); Committee authorization 03/24/2016 (R004).\\\"),\\n KV('Round 1 (week of 03/28/2016; R006)', 'Opening: first outreach wave of 29 contacted buyers (R005). Scope: 25 confidentiality agreements (R007/R008); memorandum; IOI solicitation due 05/10/2016, revised to 05/19/2016 (R011\\\\u2013R013; treatments: Extended, then Enforced); nine IOIs $17.93\\\\u2013$26.50 (R014); two low bidders excluded and seven advanced with management presentations and data-site access (R017/R018); 16 residual non-submitters inferred (R015). Finality: Not final.'),\\n KV('Round 2 (mid-June 2016; R019)', 'Opening: LOI and mark-up solicitation with due date 07/20/2016 (drafts posted 06/29, 06/30, 07/11). Scope: Party C late entry (R020\\\\u2013R023); six LOIs $19.20\\\\u2013$24.00 (R025\\\\u2013R029, R032\\\\u2013R033); two stated non-submitters (R030/R031). Deadline treatment: Late bids accepted (G&W LOI dated 07/21/2016). Finality: Not final.'),\\n KV('Round 3 (07/27/2016; R034)', 'Opening: selection of G&W and Party B for confirmatory due diligence and definitive negotiation (R034); four named bidders dropped (R035\\\\u2013R038); D and E re-entered 08/01/2016 (R039\\\\u2013R043) and closed by 08/04/2016 (R044\\\\u2013R047); G&W final bid $25.00 cash 08/12/2016 (R049); signing (R050) and announcement (R052). Finality: Inferred final.'),\\n KV('Post-signing', 'No competing proposal, go-shop or agreement termination disclosed (through the 09/19/2016 proxy). Regulatory status: G&W filed its STB petition for exemption on 09/01/2016 and submitted a voting-trust form to the STB on 09/14/2016 (X-022) \\\\u2014 context only, no ledger rows after signing.'),\\n KV('Round-bidder tallies (submitting units)', 'R1: 9 (nine IOI submitters, R014). R2: 6 (B, C, D, E, F, G&W; Party C counted on R022). R3: 3 (D, E, G&W; Party B continued without a new priced submission). These are per-round submitting units, not unique firms across the deal.'),\\n KV('Deadline history', 'IOI 05/10/2016 \\\\u2014 Extended (R011). IOI 05/19/2016 \\\\u2014 Enforced (R012/R013). LOI 07/20/2016 \\\\u2014 Late bids accepted (R024). No deadline stated for the R1 opening wave or the R3 final stage.'),\\n H('PARTICIPANTS AND ADVISERS'),\\n TXT('Named bidders (first activity; last activity; closing outcome and basis):'),\\n KV('Party A (Strategic)', 'First: Q4 2015 approach (R001). Last: memorandum recipient (P-008). Closed by Inferred: identity row (R016, Count 0) mapping to the 16 non-submitting NDA signers (R015) \\\\u2014 see Q3.'),\\n KV('Party B (Strategic)', 'First: 04/21/2016 introductory meeting (P-007/P-008); first ledger row: $24.00 LOI (R025). Advanced 07/27/2016 (R034). Not selected at signing 08/12/2016 (R051, Stated; Would not improve earlier offer).'),\\n KV('Party C (Strategic; late entrant)', 'First: early July 2016 approach (R020); NDA (R021); IOI $21.00 (R022) then LOI $19.30 (R028); catch-up access (R023). Dropped 07/27/2016 (R035, Stated).'),\\n KV('Party D (Financial)', 'First: $21.00 LOI (R027); $24.00 revised LOI 08/01/2016 (R040); paused 08/02/2016 (R044, own statement); closed Inferred: residual 08/04/2016 (R046).'),\\n KV('Party E (Strategic)', 'First: $21.26 LOI (R026); $23.81 revised LOI with Party F financing 08/01/2016 (R042); withdrew the revision and confirmed $21.26 on 08/02/2016 (R043); closed Inferred: residual 08/04/2016 (R047).'),\\n KV('Party F (Strategic)', 'First: $19.20 LOI (R029); dropped 07/27/2016 (R038); provided financing support to Party E from 08/01/2016 (R042) after its own exit \\\\u2014 no new row or re-entry for F.'),\\n KV('G&W (Strategic)', 'First: contacted in the opening wave and met at the 2016 Connections Convention 04/03\\\\u201306 (R005, R010); LOIs $21.15 (R032) and $22.15 (R033); final $25.00 cash bid 08/12/2016 (R049) and signing (R050). Winner \\\\u2014 no exit row.'),\\n KV('Cohorts (not extra parties)', '11 strategic NDA signers (R007); 14 financial NDA signers (R008); nine IOI submitters (R014); two low bidders excluded (R018); 16 residual non-submitters (R015); one unnamed strategic and one unnamed financial LOI non-submitter (R030/R031).'),\\n KV('Advisers', 'GHF / BMO Capital Markets Corp. \\\\u2014 Company financial adviser (engaged 01/27/2016; BMO succession 08/01/2016; fairness opinion 08/12/2016; fee approximately $2.52 million; affiliate-lender conflict disclosed and reviewed 09/06/2016) \\\\u2014 R002. Hinckley, Allen & Snyder LLP \\\\u2014 Company legal counsel (first observed 03/24/2016, participating in all Transaction Committee meetings) \\\\u2014 P-005. Simpson Thacher & Bartlett LLP \\\\u2014 G&W legal counsel (first observed 08/10/2016) \\\\u2014 P-026. The Company\\\\u2019s STB counsel is unnamed in the filing; not recorded as an adviser.'),\\n KV('Disclosed attributes', 'PWRR public (NASDAQ: PWX); G&W public (Delaware; non-U.S. operations). Ownership: Eder Trusts 842,742 common (~17.3%) and 500 preferred (~78.1%) \\\\u2014 voting agreement; GATX Corporation 4.92% of common; Director Alfred P. Smith (GATX Vice President and Group Executive) recused himself from the bidding-process meetings.'),\\n H('COUNTS AND AUCTION SCREEN'),\\n KV('Contacts', f\\\"Ledger Contact rows: {CONTACTS} target-initiated contacts (29 in the GHF wave + 2 additional Class I railroads, additive reading; overlap unresolved \\\\u2014 Q3). Bidder-initiated first contacts: 2 (Party A Q4 2015; Party C early July 2016), recorded as Bidder interest rows and included explicitly in the contact picture (a Contact tally does not capture them; see formulas below). Filing assertions: \\\\u201ccontacted 11 potential strategic buyers \\\\u2026 and 18 potential financial buyers\\\\u201d and \\\\u201calso approached two additional Class I railroads\\\\u201d (P-005, P-007).\\\"),\\n KV('Confidentiality agreements', 'Ledger: 11 + 14 + 1 (Party C late entrant) = 26 bidder NDAs; the Board\\\\u2019s Reasons state \\\\u201c25 of whom entered into confidentiality agreements \\\\u2026 and six of whom submitted non-binding letters of intent\\\\u201d (X-005) \\\\u2014 reconciliation: the 25 are the opening-wave signers; Party C signed later and is the sixth LOI submitter (count difference flagged, Q3). No standstill provisions (P-005).'),\\n KV('Auction screen', 'MET \\\\u2014 more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for this process (25 in the opening wave; 26 including the later late entrant). No lender-only, adviser or rollover-holder agreements are involved.'),\\n KV('Submissions', 'IOI submitters: 9 (R014) \\\\u2014 matches the filing\\\\u2019s \\\\u201cnine written indications of interest.\\\\u201d LOI submitters: 6 (R025\\\\u2013R029, R032\\\\u2013R033; Party C counted on R022) \\\\u2014 matches \\\\u201csix LOIs\\\\u201d and \\\\u201csix \\\\u2026 submitted non-binding letters of intent.\\\\u201d Stated non-submitters at the LOI stage: 2 (one strategic, one financial \\\\u2014 R030/R031).'),\\n KV('Ledger-derived totals (formulas, Include = Yes only)', 'The Summary cells below use SUMIFS over the ledger columns (What happened = column D, Round = F, Include = P, Count = Q: rows 2\\\\u201353): contacts; NDAs; bids by round; did-not-submit; dropped; re-entered; reaffirmed; not-selected. Each is a separate event tally and must not be added across steps; blank Count cells (adviser, decision, milestone, access rows) are excluded by construction.'),\\n ('F', 'Contact rows total (target-initiated)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Contact\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Bidder interest rows total (bidder-initiated first contacts)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Bidder interest\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'NDA signed rows total', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"NDA signed\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Bid rows, Round 1', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$53,1,\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Bid rows, Round 2', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$53,2,\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Bid rows, Round 3', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$53,3,\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Did not submit rows total (16 residual + 1 strategic + 1 financial)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Dropped by target rows total (2 low bidders + C, D, E, F + D, E inferred)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Dropped by target\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Re-entered rows total (D, E)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Re-entered\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Bid reaffirmed rows total (Party E)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Bid reaffirmed\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n ('F', 'Not selected at signing rows total (Party B)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$53,\\\\'Deal ledger\\\\'!$D$2:$D$53,\\\"Not selected at signing\\\",\\\\'Deal ledger\\\\'!$P$2:$P$53,\\\"Yes\\\")'),\\n KV('Per-stage balance (\\\\u00a710.2; units, not spreadsheets rows)', 'R1: 25 entrants (R007 + R008) \\\\u2212 18 exits (16 inferred R015 + 2 stated R018) = 7 continuing. R2: 7 + 1 entrant (R021 Party C) \\\\u2212 6 exits (2 stated R030/R031 + 4 stated R035\\\\u2013R038) = 2 continuing (B, G&W). R3: 2 + 2 re-entries (R039, R041) \\\\u2212 2 exits (inferred R046/R047) = 2 continuing; at signing, Party B closes (R051) = 1 (winner G&W). Inferred share: 18 of 27 exit events (16 residual + D/E at 08/04) are inferred; 9 are stated. Never negative; ends with the winner only.'),\\n KV('Reconciliation notes', 'Outcome tallies are occurrences and affected units, not unique permanent exits (D and E are each closed twice, with a re-entry between). Round-bidder counts are not submissions or unique bidders across the deal. Source totals preserved: 29 wave contacts, 25 wave NDAs, nine IOIs, six LOIs, two LOI non-submitters, two low bidders excluded.'),\\n H('COMPARABILITY AND INPUTS'),\\n KV('Other-scope proposals', 'None observed \\\\u2014 all proposals concern acquisition of the whole company\\\\u2019s equity. Party F\\\\u2019s financing support to Party E is not a separate offer or a bidding group.'),\\n KV('CVR (G&W July bids)', '$1.13 per share contingent value right, based on the subsequent sale of the Company\\\\u2019s South Quay property; recorded with $20.02 then $21.02 fixed cash at closing; excluded from the final $25.00 all-cash bid on 08/12/2016. Payment timing/formula beyond the sale trigger: not disclosed.'),\\n KV('LOI comparability', 'LOI prices were \\\\u201cbased on different assumptions and requirements related to transaction expenses and change in control payments, which GHF and the Transaction Committee observed could affect the ultimate offer price\\\\u201d (P-021) \\\\u2014 not normalized here; treat cross-bidder price comparisons as approximate.'),\\n KV('Share basis and counts', 'Stated price ranges and implied equity values assume conversion of preferred stock into common stock. Counts: 4,866,593 common and 640 preferred outstanding (09/16/2016 record date and 08/11/2016 measurement date); preferred convertible into 64,000 common shares. As-converted equity value calculation at $25.00 = $123,264,825 (labelled calculation above).'),\\n KV('Market benchmarks', 'Closing price 08/12/2016 (last trading day before announcement): $16.30 \\\\u2014 the Board cites a 53% premium for the $25.00 consideration. Closing price 09/16/2016: $24.88. Q3 2016 trading range (through 09/16/2016): high $25.00, low $15.60 (p71).'),\\n KV('Glossary', 'NDA \\\\u2014 confidentiality agreement. IOI \\\\u2014 written non-binding indication of interest. LOI \\\\u2014 non-binding letter of intent. Data site/data room \\\\u2014 internet data site for legal and financial due diligence. CVR \\\\u2014 contingent value right (here tied to the South Quay property sale). STB \\\\u2014 Surface Transportation Board; voting trust \\\\u2014 arrangement to insulate G&W from unauthorized control pending STB clearance. Fiduciary out \\\\u2014 the Board\\\\u2019s ability to change its recommendation or terminate for a superior proposal, with matching rights. Eder Trusts \\\\u2014 the Company\\\\u2019s controlling family trusts. Class I railroad \\\\u2014 largest U.S. freight railroads. Markup \\\\u2014 a bidder\\\\u2019s proposed edits to transaction documents (not a signed agreement).'),\\n]\\n\\n# ---------------------------------------------------------------- questions\\nQUESTIONS = [\\n (\\\"Q1\\\", \\\"Process and round map; inferred starts; rejected boundary candidates\\\",\\n  \\\"Keep one process (no termination or restart observed). R1 opens the week of 03/28/2016 at the first outreach wave (R005/R006); R2 opens mid-June 2016 at the LOI and mark-up solicitation due 07/20/2016 (R019); R3 opens 07/27/2016 on the selection of G&W and Party B for confirmatory and definitive negotiation (R034; Inferred final). Rejected boundaries to retain as their own rows: R003 (03/14/2016 Board decision \\\\u2014 outreach began about two weeks later, outside the \\\\u201cabout a week\\\\u201d execution test), R004 (03/24/2016 Committee authorization \\\\u2014 the alternative anchor under the decision rule), R017 (06/01/2016 advancement to presentations and data site \\\\u2014 no updated offers sought; folded into R1), R045 (08/04/2016 prioritization) and R049 (08/12/2016 final bid \\\\u2014 inside R3). Post-signing: no go-shop and no competing proposal observed.\\\",\\n  \\\"P-005 (first contact wave); P-010 (advancement); P-011 (LOI instruction); P-022 (selection); P-027 (final bid). Smallest round map that preserves each substantive transition.\\\",\\n  \\\"R003, R004, R005, R006, R017, R019, R034, R045, R049\\\",\\n  \\\"Moving the R1 anchor to R003/R004 shifts the round 0/1 boundary and the round assignment of the NDA cohort rows; splitting 06/01/2016 into its own round renumbers R2/R3 and splits the LOI bidders\\\\u2019 round history; treating 08/04/2016 as a new round would move the D/E inferred closes and the G&W final bid.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q2\\\", \\\"Deadlines, the extension and elapsed-deadline treatments\\\",\\n  \\\"05/10/2016 (IOI): Extended \\\\u2014 superseded by the 05/19/2016 postponement before arrival (R011/R012). 05/19/2016 (IOI): Enforced \\\\u2014 the target moved to selection on 06/01/2016 on the bids in hand; the receipt window (05/19\\\\u201306/01/2016) straddles the due date but no bid is shown dated after it, so \\\\u201cLate bids accepted\\\\u201d is not supported. 07/20/2016 (LOI): Late bids accepted \\\\u2014 G&W\\\\u2019s LOI is dated 07/21/2016 and was considered with no revision of the deadline; the other five LOIs are undated. No deadline stated for the R1 opening wave or the R3 final stage.\\\",\\n  \\\"P-009 (advice and extension, purpose, no requester); P-010 (receipt window and 06/01/2016 selection); P-014/P-016 (six LOIs; G&W dated 07/21/2016). \\\\u00a78.3 tests.\\\",\\n  \\\"R011, R012, R013, R024 (also R014, R032)\\\",\\n  \\\"Reclassifying 05/19/2016 as Late bids accepted or Passed without action changes the Summary map and the Working date logic for R015 (16 residual non-submitters) and R014; adding a revision row for 07/20/2016 would imply an extension the filing does not state.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q3\\\", \\\"NDA/contact populations, count reconciliation and the Party A identity mapping\\\",\\n  \\\"Record 25 opening-wave signers (11 strategic + 14 financial) plus Party C\\\\u2019s later NDA = 26 total bidder NDAs; the Board\\\\u2019s \\\\u201c25 of whom entered into confidentiality agreements \\\\u2026 and six of whom submitted non-binding letters of intent\\\\u201d (X-005) cannot have C inside the 25 and among six submitters; recommended reading: the 25 are the solicited wave and C is the sixth submitter added later. The two additional Class I railroads are recorded as additional contacts (+2), but may overlap the 11 strategic buyers \\\\u2014 if so, contacts total 29 and the Class I row becomes a duplicate. The two stated LOI non-submitters (one strategic, one financial) are treated as participants live at the LOI stage; the filing does not identify them or exclude overlap with the excluded low bidders. Party A\\\\u2019s Count-0 identity row maps it to the 16 non-submitting NDA signers (recommended) rather than the nine IOI submitters.\\\",\\n  \\\"P-005 (11 + 14 signers), P-007 (two additional Class I railroads), P-010 (nine IOIs; seven advance), P-013 (Party C), P-014/P-021 (six LOIs; two non-submitters), X-005 (Board count 25/six). Arithmetic: 11 + 14 = 25; 25 + 1 = 26.\\\",\\n  \\\"R005, R007, R008, R009, R014, R015, R016, R021, R030, R031\\\",\\n  \\\"If the Class I railroads are inside the 11, the contact total falls to 29 and R009 should be folded; if Party C is inside the 25, the NDA total is 25 and R021 loses its Count 1; changing Party A\\\\u2019s covering cohort changes the identity row\\\\u2019s stated arithmetic but moves no count.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q4\\\", \\\"Formality and conditions levels; no late-reconfirmation rows\\\",\\n  \\\"Keep: nine-IOI cohort Informal (non-binding solicitation; no markups at that stage); Party E Informal on the issues-list default, flagged as borderline (a documented response with proposed changes, but no returned agreement markup and no final/binding solicitation); Heavy conditions on G&W 07/21 and 07/26 (three-week exclusive diligence), Party D (four-week/30-day), Party C and Party F (30-day) and Party E (60-day exclusive) \\\\u2014 each turns on a stated diligence or exclusivity period; Party B Light (expedited diligence review); G&W\\\\u2019s 08/12/2016 final bid Light (diligence completed 08/11/2016; no financing condition reported, G&W financial-wherewithal representation). No None classifications. No late-reconfirmation row is created: G&W restated its position with a new priced bid on 08/12/2016 (R049), and the target never moved to finalize with Party B on its standing offer \\\\u2014 B declined to improve (R051).\\\",\\n  \\\"P-010, P-014\\\\u2013P-020 (LOI terms), P-023 (D/E revisions), P-027 (final bid), X-007 (no financing condition). \\\\u00a79.2\\\\u20139.3 defaults; late-reconfirmation rule \\\\u00a79.1.\\\",\\n  \\\"R014, R022, R025, R026, R027, R028, R029, R032, R033, R040, R042, R043, R049\\\",\\n  \\\"Upgrading Party E to Formal would raise its documentation signal without changing its Heavy conditions; downgrading Party B or G&W would require a reported Heavy trigger; adding a late-reconfirmation row would duplicate an existing priced G&W bid and misstate its Formality origin.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q5\\\", \\\"Participation outcomes, agency/reasons and every inferred close\\\",\\n  \\\"Keep the stated outcomes: C, D, E and F dropped 07/27/2016 (Decided by Target; Lower offer than rivals \\\\u2014 the Committee cited the finalists\\\\u2019 higher offers); D\\\\u2019s 08/02/2016 Participation paused (Decided by Bidder; Terms or process \\\\u2014 it stopped after the Company declined its requested no-signing commitment; a pause is not an exit); E\\\\u2019s 08/02/2016 withdrawal of its revised proposal and price confirmation (Bid reaffirmed; not an exit); Party B Not selected at signing 08/12/2016 (Stated; Target; Would not improve earlier offer); two low bidders dropped 06/01/2016 (Stated). Inferred closes to confirm: 16 residual non-submitters at 05/19/2016 (Inferred: residual; 25 \\\\u2212 9 = 16); Party A Count-0 identity row (Inferred: identity); D and E closed 08/04/2016 (Inferred: residual \\\\u2014 the 08/04/2016 continuing set, G&W and Party B, is named without them). Party F\\\\u2019s 08/01/2016 financing support to Party E gets no row of its own because F had already exited on 07/27/2016; it is carried on E\\\\u2019s bid (Support tag) with a Related link to F\\\\u2019s earlier bid.\\\",\\n  \\\"P-010 (exclusions and advancement), P-014 (non-submitters), P-022 (07/27/2016 notice), P-023 (D pause; E revision/confirmation; F support), P-025 (08/04/2016 continuing set), P-030 (B declines to improve). \\\\u00a7\\\\u00a710.1\\\\u201310.2 arithmetic and transition logic.\\\",\\n  \\\"R015, R016, R018, R030, R031, R035\\\\u2013R047, R051\\\",\\n  \\\"Treating D\\\\u2019s pause as a withdrawal, or closing D/E at signing rather than 08/04/2016, changes the per-stage balance and the inferred share; giving F a re-entry or group row double-counts its exit; moving Party A\\\\u2019s identity row to another transition changes only its stated arithmetic, not any count.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q6\\\", \\\"Consideration comparability, the CVR and equity-value inputs\\\",\\n  \\\"Keep G&W\\\\u2019s July bids with the $1.13 CVR (contingent on the subsequent sale of the South Quay property; fixed cash at closing $20.02, then $21.02) and the final 08/12/2016 bid at $25.00 all cash (CVR excluded). Do not normalize LOI prices for the disclosed differences in transaction-expense and change-in-control-payment assumptions (the Committee and GHF observed they could affect the ultimate offer price). Present the as-converted equity value only as a labelled calculation: (4,866,593 + 64,000) \\\\u00d7 $25.00 = $123,264,825 (inputs X-004, X-014); note separately that the approximately 3% termination fee implies about $126.2 million on the filing\\\\u2019s fully diluted basis. Market benchmarks: $16.30 (08/12/2016) and $24.88 (09/16/2016); 53% premium per the Board.\\\",\\n  \\\"P-010 (share basis; implied equity values), P-014 (LOI range), P-016 (CVR, cash split), P-021 (expense/change-in-control caveat), X-004 (share counts), X-006 (premium), X-008 (fee ratio), X-012 (prices), X-014 ($25.00).\\\",\\n  \\\"R014, R032, R033, R049, R050; Summary deal facts and comparability blocks\\\",\\n  \\\"Adding the CVR to per-share cells would overstate guaranteed cash; converting the disclosed equity values into new per-share prices would invent observations; changing the share base alters only the labelled calculation (the filing states no total equity value).\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n (\\\"Q7\\\", \\\"Assigned Working dates and display order within stages\\\",\\n  \\\"Confirm the conventions used as sort keys (never as observed dates): NDA cohorts at the contact-wave bound 03/28/2016 (R007/R008); Class I railroad contact by 04/07/2016 (R009); IOI deadline set by 04/27/2016 and revision at the 04/28\\\\u201305/19/2016 midpoint = 05/08/2016 (R011/R012); IOI-stage rows at the 05/19/2016 due date (R013\\\\u2013R016); R2 opening at the mid-June midpoint = 06/15/2016 (R019); Party C approach/NDA midpoints 07/05 and 07/06/2016 and catch-up access bound 07/14/2016 (R020/R021/R023); LOI-stage rows at the 07/20/2016 deadline (R024\\\\u2013R031); 07/27/2016 notices at the decision day (R035\\\\u2013R038); 08/04/2016 inferred closes at the decision day (R046/R047). Equal dates are ordered by # as a deterministic display convention.\\\",\\n  \\\"P-005, P-009, P-011, P-013, P-014, P-022, P-025; \\\\u00a78.1 rules 2\\\\u20136 and the order constraint.\\\",\\n  \\\"R007\\\\u2013R013, R015, R016, R019\\\\u2013R031, R035\\\\u2013R038, R044, R046, R047\\\",\\n  \\\"Changing a convention (for example, using the late-July midpoint instead of the 07/20/2016 deadline) reorders rows within a round and can break the non-decreasing Working-date constraint against dated rows.\\\",\\n  \\\"Pending\\\", \\\"\\\"),\\n]\\n\\n# ---------------------------------------------------------------- workbook\\nwb = Workbook()\\nthin = Side(style='thin', color='D9D9D9')\\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\\nhdr_fill = PatternFill('solid', fgColor='1F3864')\\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\\ngrp_fill = PatternFill('solid', fgColor='D9E1F2')\\nwrap_top = Alignment(wrap_text=True, vertical='top')\\nwrap_ctr = Alignment(wrap_text=True, vertical='top', horizontal='center')\\n\\n# ---- Deal ledger\\nws = wb.active; ws.title = 'Deal ledger'\\ncols = [('#',7),('When',26),('Who',30),('What happened',20),('Process',8),('Round',7),('Type',12),\\n        ('Terms or outcome',66),('Formality',12),('Conditions level',13),('Why and evidence',78),\\n        ('Source',20),('Review',9),('Reviewer note',26),\\n        ('Row id',8),('Include',8),('Count',7),('Date from',11),('Date to',11),('Working date',12),\\n        ('Date basis',16),('Date method',20),('Price low',9),('Price high',9),('Price kind',12),\\n        ('Price origin',13),('Currency',9),('All cash',10),('Cash at closing',12),('Conditions detail',50),\\n        ('Due date',11),('Deadline treatment',16),('Round finality',14),('Decided by',10),('Exit reason',22),\\n        ('Outcome basis',16),('Page',6),('Related rows',20),('Deal',12)]\\nfor c,(name,w) in enumerate(cols, start=1):\\n    cell = ws.cell(row=1, column=c, value=name)\\n    cell.font = hdr_font; cell.fill = hdr_fill\\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\\n    ws.column_dimensions[get_column_letter(c)].width = w\\nws.row_dimensions[1].height = 30\\n\\ndef dstr(d): return d\\nfor i, r in enumerate(L):\\n    rr = i + 2\\n    main = MAIN.get(r['id']) or r['source'].split(';')[0].strip()\\n    vals = [r['num'], r['when'], r['who'], r['what'], r['process'], r['round'], r['type'],\\n            r['terms'], r['formality'], r['conditions'], r['why'], r['source'], r['review'], '',\\n            r['id'], 'Yes', r['count'], r['dfrom'], r['dto'], r['wdate'], r['dbasis'], r['dmethod'],\\n            r['plow'], r['phigh'], r['pkind'], r['porigin'], r['currency'], r['allcash'], r['cashclose'],\\n            r['conddetail'], r['duedate'], r['dlteat'], r['finality'], r['decided'], r['exit'],\\n            r['obasis'], r['page'], r['related'], r['deal']]\\n    for c, v in enumerate(vals, start=1):\\n        cell = ws.cell(row=rr, column=c, value=v)\\n        cell.alignment = wrap_top\\n        cell.border = border\\n        if c in (1,5,6,15,17,37): cell.alignment = wrap_ctr\\n        if c in (18,19,20,31) and isinstance(v, dt.date): cell.number_format = 'MM/DD/YYYY'\\n        if c in (23,24,29) and isinstance(v,(int,float)): cell.number_format = '0.00'\\n    # hyperlink on Source\\n    sc = ws.cell(row=rr, column=12)\\n    sc.hyperlink = Hyperlink(ref=sc.coordinate, location=f\\\"'Source text'!A{SRC_ROW[main]}\\\")\\n    sc.font = Font(color='0563C1', underline='single', size=10)\\n    ws.cell(row=rr, column=2).font = Font(size=10)\\n\\n# groups (collapsed)\\ngroups = [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),\\n          ('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]\\nfor g in groups:\\n    ws.column_dimensions.group(g[0], g[1], outline_level=1, hidden=True)\\nws.sheet_properties.outlinePr.summaryRight = False\\nws.freeze_panes = 'E2'\\nws.auto_filter.ref = f'A1:AM{len(L)+1}'\\n\\n# validations\\nlists = {\\n 'A': ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'],\\n 'B': ['Strategic','Financial','Mixed','Unknown'],\\n 'C': ['Formal','Informal','Insufficient evidence','Varies'],\\n 'D': ['None','Light','Heavy','Insufficient evidence','Varies'],\\n 'E': ['Yes','No'],\\n 'F': ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\\n 'G': ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\\n 'H': ['Point','Bidder range','Group envelope','Bound only','Undisclosed'],\\n 'I': ['Stated','Carried forward','Inferred'],\\n 'J': ['Yes','No','Not stated'],\\n 'K': ['Extended','Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\\n 'L': ['Announced as final','Inferred final','Not final'],\\n 'M': ['Bidder','Target','Both','Unknown'],\\n 'N': ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\\n 'O': ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\\n}\\nvalidations = [\\n ('D', 'A', 'D2:D200'), ('G', 'B', 'G2:G200'), ('I', 'C', 'I2:I200'), ('J', 'D', 'J2:J200'),\\n ('P', 'E', 'P2:P200'), ('U', 'F', 'U2:U200'), ('V', 'G', 'V2:V200'), ('Y', 'H', 'Y2:Y200'),\\n ('Z', 'I', 'Z2:Z200'), ('AB', 'J', 'AB2:AB200'), ('AF', 'K', 'AF2:AF200'),\\n ('AG', 'L', 'AG2:AG200'), ('AH', 'M', 'AH2:AH200'), ('AI', 'N', 'AI2:AI200'),\\n ('AJ', 'O', 'AJ2:AJ200'),\\n]\\ndv_objs = []\\nfor col_letter, list_col, rng in validations:\\n    n = len(lists[list_col])\\n    dv = DataValidation(type='list', formula1=f'=Lists!${list_col}$2:${list_col}${n+1}',\\n                        allow_blank=True, showErrorMessage=True)\\n    dv.error = 'Use a value from the Lists sheet.'\\n    dv.errorTitle = 'Controlled value'\\n    ws.add_data_validation(dv)\\n    dv.add(rng)\\n    dv_objs.append(dv)\\n\\n# ---- Summary\\nws2 = wb.create_sheet('Summary')\\nws2.column_dimensions['A'].width = 42\\nws2.column_dimensions['B'].width = 150\\nt = ws2.cell(row=1, column=1, value='Summary \\\\u2014 Providence & Worcester Railroad Company / Genesee & Wyoming Inc. (PWRR-G&W) \\\\u2014 AI first pass (not human-approved)')\\nt.font = Font(bold=True, size=12)\\nrowi = 3\\nfor kind, a, b in SUMMARY:\\n    if kind == 'H':\\n        c = ws2.cell(row=rowi, column=1, value=a); c.font = Font(bold=True, color='1F3864', size=11)\\n        c.fill = grp_fill\\n        ws2.cell(row=rowi, column=2).fill = grp_fill\\n    elif kind == 'KV':\\n        ca = ws2.cell(row=rowi, column=1, value=a); ca.font = Font(bold=True, size=10); ca.alignment = wrap_top\\n        cb = ws2.cell(row=rowi, column=2, value=b); cb.alignment = wrap_top\\n        if isinstance(b, str) and b.startswith('='):\\n            cb.number_format = '0'\\n    elif kind == 'F':\\n        ca = ws2.cell(row=rowi, column=1, value=a); ca.font = Font(bold=True, size=10); ca.alignment = wrap_top\\n        cb = ws2.cell(row=rowi, column=2, value=b); cb.alignment = wrap_top; cb.number_format = '0'\\n    else:\\n        ws2.cell(row=rowi, column=1, value=b).alignment = wrap_top\\n    rowi += 1\\nws2.freeze_panes = 'A3'\\n\\n# ---- Questions\\nws3 = wb.create_sheet('Questions')\\nqcols = [('Q',6),('Review topic',38),('Recommended answer',95),('Why and source',55),\\n         ('Affected rows/fields',28),('Consequence of changing it',55),('Status',10),('Reviewer note',30)]\\nfor c,(name,w) in enumerate(qcols, start=1):\\n    cell = ws3.cell(row=1, column=c, value=name); cell.font = hdr_font; cell.fill = hdr_fill\\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\\n    ws3.column_dimensions[get_column_letter(c)].width = w\\nws3.row_dimensions[1].height = 28\\nfor i, q in enumerate(QUESTIONS):\\n    rr = i + 2\\n    for c, v in enumerate(q, start=1):\\n        cell = ws3.cell(row=rr, column=c, value=v if v else None)\\n        cell.alignment = wrap_top; cell.border = border\\nws3.freeze_panes = 'B2'\\nws3.auto_filter.ref = f'A1:H{len(QUESTIONS)+1}'\\n\\n# ---- Source text\\nws4 = wb.create_sheet('Source text')\\nfor c,(name,w) in enumerate([('Paragraph',12),('Section',64),('Page',7),('Text',170)], start=1):\\n    cell = ws4.cell(row=1, column=c, value=name); cell.font = hdr_font; cell.fill = hdr_fill\\n    cell.alignment = Alignment(wrap_text=True, vertical='center', horizontal='center')\\n    ws4.column_dimensions[get_column_letter(c)].width = w\\nfor i, s in enumerate(SRC):\\n    rr = i + 2\\n    ws4.cell(row=rr, column=1, value=s['id']).alignment = wrap_top\\n    ws4.cell(row=rr, column=2, value=s['section']).alignment = wrap_top\\n    pc = ws4.cell(row=rr, column=3, value=s['page']); pc.alignment = wrap_ctr\\n    ws4.cell(row=rr, column=4, value=s['text']).alignment = wrap_top\\nws4.freeze_panes = 'A2'\\nws4.auto_filter.ref = f'A1:D{len(SRC)+1}'\\n\\n# ---- Lists (hidden)\\nws5 = wb.create_sheet('Lists')\\nfor col, vals in lists.items():\\n    ws5.cell(row=1, column=ord(col)-64, value={'A':'What happened','B':'Type','C':'Formality','D':'Conditions level','E':'Include','F':'Date basis','G':'Date method','H':'Price kind','I':'Price origin','J':'All cash','K':'Deadline treatment','L':'Round finality','M':'Decided by','N':'Exit reason','O':'Outcome basis'}[col]).font = Font(bold=True)\\n    for j, v in enumerate(vals):\\n        ws5.cell(row=j+2, column=ord(col)-64, value=v)\\nws5.sheet_state = 'hidden'\\n\\nimport os\\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\\nOUT = '/home/uctpiaj/work/extraction/providence-worcester.xlsx'\\nwb.save(OUT)\\nprint('saved', OUT)\\n\", \"path\": \"/tmp/opencode/pw/build2.py\"}"},"time":{"start":1789824968932,"end":1789825008033}}}}
