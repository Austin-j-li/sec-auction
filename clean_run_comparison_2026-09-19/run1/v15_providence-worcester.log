ndstill\\\" \\\"South Quay\\\" \\\"premium\\\"; do echo \\\"##### $pat\\\"; grep -n -i \\\"$pat\\\" filing_text.txt | head -12; echo; done\"}"},"time":{"start":1789824555312,"end":1789824556202}}}}
