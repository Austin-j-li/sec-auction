{"type":"text","timestamp":1789824930112,"sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","part":{"id":"prt_0b9e03b50001dwIRz2rhXHiwhr","sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","messageID":"msg_0b9de31e2001IFyh5Iw8FgBAHr","type":"text","text":"I've now read the full filing. Before building the workbook, here is my proposed process/round structure (to be included in the Questions sheet):\n\n- **One process** (no abandonment/restart observed).\n- **R1** opens week of 03/28/2016 (first outreach wave: 11 strategic + 18 financial contacted; 25 NDAs; nine IOIs $17.93–$26.50; deadline 05/10 → 05/19). Rejected anchors: 03/14 Board decision, 03/24 Committee authorization (outreach wave preferred); 06/01 advancement folded into R1.\n- **R2** opens mid-June 2016 (LOI + mark-up solicitation, due 07/20/2016; six LOIs; Party C late entry).\n- **R3** opens 07/27/2016 (G&W and Party B to confirmatory/definitive stage; finality Inferred final), ending in the 08/12/2016 signing and 08/15 announcement.\n- Key uncertainties: 25-vs-26 NDA count (Party C late entrant), two additional Class I railroad contacts possibly overlapping the 11 strategic, deadline treatments, and inferred closes (16 residual non-submitters; Party D and E).\n\nNow I'll build the workbook.","time":{"start":1789824875344,"end":1789824930112}}}
{"type":"tool_use","timestamp":1789824930130,"sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","part":{"partID":"prt_0b9e0400f0015YEiG5C2nffh05","sessionID":"ses_f462b18a6ffeCc3FsyOAV29K5z","messageID":"msg_0b9de31e2001IFyh5Iw8FgBAHr","type":"tool","id":"call_00_FYFUc2NUvibfGHduOrhp4563","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/pw/build.py","content":"#!/usr/bin/env python3\n# Build providence-worcester.xlsx deal ledger from the DEFM14A (PWRR / G&W, Sept 2016).\nimport json, re, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nBLOCKS = {b['i']: b for b in json.load(open('/tmp/opencode/pw/blocks.json'))}\n\n# ---------------------------------------------------------------- source rows\nPIDX = [517,518,521,522,523,524,525,526,529,530,531,532,533,534,535,536,\n        539,540,541,542,543,544,545,546,549,550,551,552,553,556,557,558,559]\nPSEC = \"Background of the Merger\"\nP_rows = []\nfor n, bi in enumerate(PIDX, start=1):\n    b = BLOCKS[bi]\n    P_rows.append({'id': f'P-{n:03d}', 'section': PSEC, 'page': b['page'], 'text': b['text']})\n\nX_SPECS = [\n ('X-001', [428], \"The Parties to the Merger Agreement\", None),\n ('X-002', [431], \"The Parties to the Merger Agreement\", None),\n ('X-003', [434], \"The Parties to the Merger Agreement\", None),\n ('X-004', [450], \"The Special Meeting of the Shareholders\\u2014Record Date; Outstanding Shares; Shares Entitled to Vote\", None),\n ('X-005', [568], \"Proposal No. 1\\u2014The Merger\\u2014Recommendation of the Board of Directors and Reasons for the Merger\", None),\n ('X-006', [571], \"Proposal No. 1\\u2014The Merger\\u2014Recommendation of the Board of Directors and Reasons for the Merger\", None),\n ('X-007', [584], \"Proposal No. 1\\u2014The Merger\\u2014Recommendation of the Board of Directors and Reasons for the Merger\", None),\n ('X-008', [599], \"Proposal No. 1\\u2014The Merger\\u2014Recommendation of the Board of Directors and Reasons for the Merger\", None),\n ('X-009', [610], \"Proposal No. 1\\u2014The Merger\\u2014Opinion of the Company's Financial Advisor\", None),\n ('X-010', [701], \"Proposal No. 1\\u2014The Merger\\u2014Summary of Financial Analysis of BMO Capital Markets Corp.\\u2014Miscellaneous\", None),\n ('X-011', [702,705], \"Proposal No. 1\\u2014The Merger\\u2014Summary of Financial Analysis of BMO Capital Markets Corp.\\u2014Miscellaneous\", 42),\n ('X-012', [301], \"Summary\\u2014Market Price of Our Common Stock\", None),\n ('X-013', [808], \"The Merger Agreement\\u2014Merger Consideration\", None),\n ('X-014', [811], \"The Merger Agreement\\u2014Merger Consideration\", None),\n ('X-015', [831], \"The Merger Agreement\\u2014Conditions to the Merger\", None),\n ('X-016', [868], \"The Merger Agreement\\u2014Termination of the Merger Agreement\", None),\n ('X-017', [878], \"The Merger Agreement\\u2014Termination Fee\", None),\n ('X-018', [903], \"The Merger Agreement\\u2014Limitations on Considering Other Acquisition Proposals; Non-Solicitation Provisions and Exceptions\", None),\n ('X-019', [905], \"The Merger Agreement\\u2014Limitations on Considering Other Acquisition Proposals; Non-Solicitation Provisions and Exceptions\", None),\n ('X-020', [1106], \"The Voting Agreement\", None),\n ('X-021', [506], \"Summary\\u2014Voting Agreement\", None),\n ('X-022', [996], \"The Merger Agreement\\u2014Efforts to Complete the Merger\", None),\n]\nX_rows = []\nfor xid, bids, sec, pg in X_SPECS:\n    txt = ' '.join(BLOCKS[i]['text'] for i in bids)\n    page = pg if pg else BLOCKS[bids[0]]['page']\n    X_rows.append({'id': xid, 'section': sec, 'page': page, 'text': txt})\nSRC = P_rows + X_rows\nSRC_ROW = {r['id']: i + 2 for i, r in enumerate(SRC)}   # sheet row of each id\nSRC_TEXT = {r['id']: r['text'] for r in SRC}\n\n# ---------------------------------------------------------------- ledger rows\nD = dt.date\ndef row(**kw):\n    base = dict(id='', when='', who='', what='', process=1, round=0, type='', terms='',\n                formality='', conditions='', why='', source='', review='', count=None,\n                dfrom=None, dto=None, wdate=None, dbasis='', dmethod='', plow=None, phigh=None,\n                pkind='', porigin='', currency='', allcash='', cashclose=None, conddetail='',\n                duedate=None, dlteat='', finality='', decided='', exit='', obasis='', page=None,\n                related='', deal='PWRR-G&W')\n    base.update(kw)\n    return base\n\nL = []\nL.append(row(id='R001', when='Q4 2015 (day not disclosed)', who='Party A (unnamed Class I rail partner)',\n    what='Bidder interest', round=0, type='Strategic',\n    terms='Party A suggested possible joint venture arrangements and expressed interest in acquiring equity in the Company during a meeting with Chairman/CEO Eder and VP Rogers called to discuss joint commercial opportunities; bidder-initiated first contact; no price discussed. Led to the Board\\u2019s banker search (R002).',\n    why='Stated: the meeting, Party A\\u2019s suggestion and its interest; direction bidder\\u2192target; no price. Count 1 = newly represented individual (contact tally). Date: \"In the fourth quarter of 2015\" \\u2014 quarter interval, no day; Working date is the calendar midpoint (Convention; Assigned: midpoint). Quote: \"During the meeting, Party A suggested possible joint venture arrangements and expressed some interest in acquiring equity in the Company to further develop strategic opportunities and enhance regional connectivity.\" (P-001, p27)',\n    source='P-001', dfrom=D(2015,10,1), dto=D(2015,12,31), wdate=D(2015,11,15),\n    dbasis='Reported interval', dmethod='Assigned: midpoint', page=27, related='R002; R016'))\n\nL.append(row(id='R002', when='01/27/2016', who='Providence and Worcester Railroad Company (Board) / GHF',\n    what='Adviser engaged', round=0,\n    terms='Retained GHF (Greene Holcomb & Fisher LLC) as investment banking firm after a subcommittee of two independent directors (Barrett, Anderson) interviewed several firms; subcommittee recommended retention and the Board approved on 01/27/2016; GHF represented it would not represent any potential buyer of the Company or any person proposing financing; GHF\\u2019s business acquired by BMO Capital Markets Corp. on 08/01/2016 (successor \\u2014 one adviser relationship); rendered the 08/12/2016 fairness opinion (oral, confirmed in writing); fee approximately $2.52 million; on 09/06/2016 the Board reviewed BMO\\u2019s disclosure that a BMO affiliate holds an approximately 5% participation in G&W\\u2019s senior secured syndicated facility and confirmed it was not material to BMO\\u2019s independence.',\n    why='Stated: retention and approval on 01/27/2016; selection process; no-conflict representation; later dates (BMO succession, opinion, fee, conflict review). Quotes: \"During the executive session of the Board\\u2019s regular quarterly meeting held on January 27, 2016 (which Director Alfred P. Smith did not attend), the subcommittee recommended to the Board that the Company retain GHF as its investment banking firm.\" (P-001, p27); \"an affiliate of BMO is a lender with an approximately 5% participation in the syndicate\" (X-011, p42); \"the Company will pay BMO an aggregate fee of approximately $2.52 million\" (X-010, p41).',\n    source='P-001; X-009; X-010; X-011', wdate=D(2016,1,27), dbasis='Reported day', dmethod='Reported',\n    page=27, related='R003'))\n\nL.append(row(id='R003', when='03/14/2016', who='Board of Directors', what='Target sale decision', round=0,\n    terms='Special Board meeting: GHF presented its evaluation of the business and industry and proposed a process \\u2014 discussions with Party A plus solicitation of other potential third parties for a change in control transaction; Board concluded it was in the Company\\u2019s best interest to proceed and appointed the Transaction Committee (Barrett (Chair), Anderson, Garvey) to supervise the process and recommend to the full Board; the Committee could not approve or enter a change of control transaction (full-Board authority under Rhode Island law). Candidate R1 anchor (rejected \\u2014 R006).',\n    why='Stated: meeting, GHF proposal, Board conclusion, Committee appointment and its limits; Date: Reported day. Candidate R1 anchor rejected: the first outreach began the week of 03/28/2016, about two weeks later \\u2014 outside the \"about a week\" execution test (Convention). Quote: \"Representatives of GHF then proposed a process pursuant to which the Company would proceed with discussions with Party A and also solicit interest from other potential third parties regarding a change in control transaction.\" (P-002, p27)',\n    source='P-002; P-003', wdate=D(2016,3,14), dbasis='Reported day', dmethod='Reported', page=27,\n    related='R004; R006', review='Q1'))\n\nL.append(row(id='R004', when='03/24/2016', who='Transaction Committee', what='Target decision', round=0,\n    terms='Following management\\u2019s 03/22\\u201323/2016 meetings with Party A (Party A informed of GHF\\u2019s engagement), the Committee authorized GHF to contact Party A and other potential buyers to determine their interest in a change in control transaction. Candidate R1 anchor (rejected \\u2014 outreach wave preferred; R006).',\n    why='Stated: the meetings (03/22\\u201323), the authorization and its scope; Date: Reported day. Candidate anchor note: outreach began during the week of 03/28/2016, within about a week of this authorization, so it is the alternative anchor under the decision rule, but the first outreach wave takes precedence (Convention). Quotes: \"had met with various representatives of Party A on March 22 and 23, 2016 and had informed Party A of GHF\\u2019s engagement\" (P-005, p28); \"The Transaction Committee authorized GHF to contact Party A as well as other potential buyers to determine their level of interest in a change in control transaction.\" (P-005, p28)',\n    source='P-004; P-005', wdate=D(2016,3,24), dbasis='Reported day', dmethod='Reported', page=28,\n    related='R003; R006', review='Q1'))\n\nL.append(row(id='R005', when='week of 03/28/2016', who='GHF (for the Company)', what='Contact', round=1,\n    terms='Outreach wave: GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers to determine their interest in a change in control transaction; two additional Class I railroads approached by management are recorded separately (R009); five strategic buyers (including G&W) had introductory meetings at the 2016 Connections Convention 04/03\\u201304/06 (folded into R010).',\n    why='Stated: the wave, its sub-cohort sizes and purpose. Count 29 = 11 + 18 (single wave; the two sub-cohorts are disjoint as stated). Date: \"During the week of March 28, 2016\" \\u2014 the week\\u2019s first day is used as the sort key (Convention; Assigned: bound). Quote: \"During the week of March 28, 2016, in accordance with the Transaction Committee\\u2019s directives, representatives of GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers.\" (P-005, p28)',\n    source='P-005', count=29, dfrom=D(2016,3,28), dto=D(2016,4,3), wdate=D(2016,3,28),\n    dbasis='Reported interval', dmethod='Assigned: bound', page=28, related='R006; R007; R008; R009', review='Q3'))\n\nL.append(row(id='R006', when='week of 03/28/2016', who='Company / GHF', what='Round opened', round=1,\n    terms='R1 anchor: first outreach wave (week of 03/28/2016; R005) \\u2014 other candidate anchors: R003 (03/14/2016 Board decision to proceed; outreach began about two weeks later) and R004 (03/24/2016 Committee authorization; outreach began the following week); rejected because the first outreach wave takes precedence. Round finality: Not final \\u2014 the IOI solicitation was non-binding and no final or binding stage was announced.',\n    why='Convention: R1 opens at the first outreach wave (rule 1); candidate anchors retained as their own rows. Stated evidence: the contact wave and the subsequent confidentiality agreements and non-binding IOI solicitation (P-005; P-009). Round finality: Not final \\u2014 no announcement; a non-binding IOI stage (Convention). Date: week\\u2019s first day as sort key (Assigned: bound).',\n    source='P-005; P-009', wdate=D(2016,3,28), dbasis='Reported interval', dmethod='Assigned: bound',\n    finality='Not final', page=28, related='R003; R004; R005; R019; R034', review='Q1'))\n\nL.append(row(id='R007', when='after 03/28/2016 (exact dates not disclosed)', who='11 potential strategic buyers (cohort; incl. Party A and G&W)',\n    what='NDA signed', round=1, type='Strategic', count=11,\n    terms='All 11 contacted potential strategic buyers executed confidentiality agreements; agreements contained no standstill or similar provision; signers later received the Company memorandum and, when advanced, internet data-site access (R017). G&W, Party A and Party B are covered by this cohort (no separate NDA rows).',\n    why='Stated: cohort size (11), execution and no-standstill terms. Inferred/Convention: execution followed the contacts; no day disclosed; Working date = the lower bound of the contact wave (Assigned: bound). Count 11. Quote: \"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements. The confidentiality agreements did not contain any \\u201cstandstill\\u201d or similar provision that would prohibit a potential buyer from submitting a proposal or making an offer to acquire the Company.\" (P-005, p28)',\n    source='P-005', dfrom=D(2016,3,28), wdate=D(2016,3,28), dbasis='Relative only',\n    dmethod='Assigned: bound', page=28, related='R005; R008; R021', review='Q3'))\n\nL.append(row(id='R008', when='after 03/28/2016 (exact dates not disclosed)', who='14 potential financial buyers (cohort)',\n    what='NDA signed', round=1, type='Financial', count=14,\n    terms='14 of the 18 contacted potential financial buyers executed confidentiality agreements (four did not); agreements contained no standstill or similar provision; signers received the memorandum and, when advanced, data-site access.',\n    why='Stated: cohort size (14 of 18) and no-standstill terms. Inferred/Convention: execution followed the contacts; no day disclosed; Working date = the lower bound of the contact wave (Assigned: bound). Count 14. Quote: as at R007 (P-005, p28).',\n    source='P-005', dfrom=D(2016,3,28), wdate=D(2016,3,28), dbasis='Relative only',\n    dmethod='Assigned: bound', page=28, related='R005; R007', review='Q3'))\n\nL.append(row(id='R009', when='by 04/07/2016 (day not disclosed)', who='Two additional Class I railroads (unnamed)',\n    what='Contact', round=1, type='Strategic', count=2,\n    terms='Management also approached two additional Class I railroads to determine their interest in a possible transaction; treated as additive to the 29 GHF contacts (reading \"additional\"); possible overlap with the 11 contacted strategic buyers is unresolved (Q3).',\n    why='Stated: two unnamed Class I railroads approached and the purpose; date inferred as by the 04/07/2016 Committee report (upper bound; Assigned: bound). Reading \"additional\" = beyond the GHF wave is preferred; overlap with the 11 strategic buyers not stated (flagged, Q3). Quote: \"Mr. Noreck reported that the Company had also approached two additional Class I railroads to determine their interest in a possible transaction.\" (P-007, p28)',\n    source='P-007', count=2, dto=D(2016,4,7), wdate=D(2016,4,7), dbasis='Relative only',\n    dmethod='Assigned: bound', page=28, related='R005; R010', review='Q3'))\n\nL.append(row(id='R010', when='04/07/2016', who='Transaction Committee', what='Target decision', round=1,\n    terms='Committee discussed the process to date; authorized GHF to contact the five interested parties met at the 2016 Connections Convention (including G&W) plus other potential strategic buyers and NDA-holding private equity firms to confirm continuing interest; Party B\\u2019s introductory meeting followed on 04/21/2016.',\n    why='Stated: meeting date, authorization scope and purpose; Date: Reported day. Quote: \"After discussion, the Transaction Committee authorized representatives of GHF, on behalf of the Company, to contact each of the five interested parties with whom management had met at the 2016 Connections Convention, as well as other potential strategic buyers (including certain Class I railroads) and private equity firms who had entered into confidentiality agreements with the Company to confirm their continuing interest.\" (P-007, p28)',\n    source='P-007; P-008', wdate=D(2016,4,7), dbasis='Reported day', dmethod='Reported', page=28,\n    related='R009; R011'))\n\nL.append(row(id='R011', when='on or before 04/27/2016; due 05/10/2016', who='Company / Board of Directors',\n    what='Deadline set', round=1, count=None,\n    terms='IOI due date: each potential buyer was advised to submit a non-binding indication of interest by 05/10/2016; superseded by the 05/19/2016 postponement (R012). Due date 05/10/2016; treatment Extended (moved by a revision before arrival).',\n    why='Stated: the advice and the 05/10/2016 due date; advice date bounded by the 04/27/2016 Board discussion (Convention; Assigned: bound). Quote: \"each potential buyer had been advised to submit a non-binding indication of interest by May 10, 2016 (which deadline was subsequently postponed to May 19, 2016 to ensure the potential buyers had sufficient time to formulate their most compelling offers)\" (P-009, p29)',\n    source='P-009; P-008', dto=D(2016,4,27), wdate=D(2016,4,27), dbasis='Relative only',\n    dmethod='Assigned: bound', duedate=D(2016,5,10), dlteat='Extended', page=29,\n    related='R012; R013', review='Q2'))\n\nL.append(row(id='R012', when='after 04/27/2016; due date changed 05/10/2016 \\u2192 05/19/2016', who='Company',\n    what='Deadline revised', round=1,\n    terms='IOI deadline postponed from 05/10/2016 to 05/19/2016 \"to ensure the potential buyers had sufficient time to formulate their most compelling offers\"; requester not disclosed; new due date 05/19/2016 (treatment Enforced).',\n    why='Stated: old and new due dates and the purpose; no requester disclosed. Date: \"subsequently\" postponed \\u2014 bounded by the 04/27/2016 report and the 05/19/2016 new date; Working date is the window midpoint (Convention; Assigned: midpoint). Quote: as at R011 (P-009, p29).',\n    source='P-009', dfrom=D(2016,4,28), dto=D(2016,5,19), wdate=D(2016,5,8),\n    dbasis='Relative only', dmethod='Assigned: midpoint', duedate=D(2016,5,19), dlteat='Enforced',\n    page=29, related='R011; R013', review='Q2'))\n\nL.append(row(id='R013', when='05/19/2016', who='Company', what='Deadline', round=1,\n    terms='Scheduled IOI due date reached while operative; the target then considered the nine IOIs received 05/19\\u201306/01/2016 and moved to selection (06/01/2016) on the bids in hand \\u2014 no extension; treatment Enforced (no bid shown dated after the due date: the receipt window straddles it; Q2).',\n    why='Stated: due date and what followed (nine IOIs; exclusion and advancement decision). Late-bid note: individual IOI dates are not disclosed and the receipt window straddles 05/19/2016, so no bid is treated as late (Convention). Quote: \"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest\" (P-010, p29)',\n    source='P-010', wdate=D(2016,5,19), dbasis='Reported day', dmethod='Reported',\n    duedate=D(2016,5,19), dlteat='Enforced', page=29, related='R011; R012; R014', review='Q2'))\n\nL.append(row(id='R014', when='05/19/2016 \\u2013 06/01/2016 (received)', who='Nine IOI submitters (cohort; unnamed)',\n    what='Bid', round=1, type='Unknown', count=9, formality='Informal', conditions='Heavy',\n    terms='Nine written non-binding indications of interest with prices of $17.93\\u2013$26.50 per share (assuming conversion of preferred stock into common stock), implying equity values of $90\\u2013$134 million; group envelope only, not attributed to members; two lowest later excluded (R018) and seven advanced (R017).',\n    why='Stated: count, price range, equity-value range and share basis. Formality: Informal (Convention) \\u2014 non-binding indications to a non-binding solicitation; no markups reported at this stage. Conditions: Heavy by context (Convention) \\u2014 bids made before substantive diligence access (data-room and management access followed the 06/01/2016 advancement). Count 9 = submitting units; price cells hold the group envelope only. Date: due date inside the receipt window (Convention; Assigned: deadline). Quote: \"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest (\\u201cIOIs\\u201d) from potential buyers, with offer prices per share ranging from $17.93 to $26.50 (assuming the conversion of preferred stock into common stock), implying equity values of $90 million to $134 million.\" (P-010, p29)',\n    source='P-010; P-009', plow=17.93, phigh=26.50, pkind='Group envelope', porigin='Stated',\n    currency='USD', allcash='Not stated', conddetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n    dfrom=D(2016,5,19), dto=D(2016,6,1), wdate=D(2016,5,19), dbasis='Reported interval',\n    dmethod='Assigned: deadline', page=29, related='R016; R018', review='Q3; Q4; Q6'))\n\nL.append(row(id='R015', when='by 05/19/2016 (no submission reported; day of non-submission not disclosed)',\n    who='16 NDA signers (cohort; residual; unnamed)', what='Did not submit', round=1, type='Unknown', count=16,\n    terms='Inferred: residual \\u2014 25 NDA signers \\u2212 9 IOI submitters = 16 non-submitters; eligible participants were advised to submit by 05/19/2016; the filing identifies the nine submitters and the seven advanced (R017) without these 16; base assumes the 25 wave signers were the eligible population at that date (Party C entered later; the two additional Class I railroads are treated as contacts, not entrants) \\u2014 see Q3.',\n    why='Inferred: residual \\u2014 the 25-signer wave (P-005), the nine IOIs (P-010) and the seven continuing buyers (P-010) give 25 \\u2212 9 = 16. No decision date, motive or voluntary withdrawal is inferred; only that they did not submit by the due date. Working date = the solicitation due date (Convention; Assigned: deadline). Quotes: \"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements.\" (P-005, p28); \"the Transaction Committee concluded that the two low bidders should be excluded from that process. The Transaction Committee authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers\" (P-010, p29).',\n    source='P-005; P-010', dto=D(2016,5,19), wdate=D(2016,5,19), dbasis='Relative only',\n    dmethod='Assigned: deadline', decided='Unknown', exit='Not stated', obasis='Inferred: residual',\n    page=29, related='R007; R008; R014; R016', review='Q3; Q5'))\n\nL.append(row(id='R016', when='by 05/19/2016 (Party A\\u2019s last reported appearance; day not disclosed)', who='Party A',\n    what='Did not submit', round=1, type='Strategic', count=0,\n    terms='Inferred: identity \\u2014 Party A appears individually only through the opening wave and the memorandum distribution (P-008) and is never mentioned again; recommended reading: already counted within the 16 non-submitting NDA signers (R015, Did not submit 05/19/2016); alternative: within the nine IOI submitters (R014). No count is moved from the cohort (Count 0); see Q3.',\n    why='Inferred: identity \\u2014 covering rows and arithmetic as above; the filing gives no individual outcome for Party A. Working date set at the same transition as the covering cohort (Convention; Assigned: deadline). Quote: \"With the assistance of GHF, the Company prepared a memorandum concerning the Company and its prospects, which was distributed to the potential buyers, including Party A, Party B and G&W, that had executed confidentiality agreements.\" (P-008, p28)',\n    source='P-008; P-005; P-010', dto=D(2016,5,19), wdate=D(2016,5,19), dbasis='Relative only',\n    dmethod='Assigned: deadline', decided='Unknown', exit='Not stated', obasis='Inferred: identity',\n    page=28, related='R001; R015', review='Q3; Q5'))\n\nL.append(row(id='R017', when='05/23/2016 \\u2013 06/01/2016 (decision concluded at the 06/01/2016 meeting)',\n    who='Transaction Committee', what='Target decision', round=1,\n    terms='Committee considered the nine IOIs; excluded the two low bidders (R018) and authorized in-person management presentations for the remaining seven, permitting additional due diligence with access to an internet data site (access alike for the advancing set); over June\\u2013July each advancing buyer and its advisers conducted diligence, including management meetings.',\n    why='Stated: decision, rationale, meetings of 05/23 and 06/01/2016, access given alike. Date: decision concluded at the later meeting (Convention; Assigned: decision day). Quote: \"In view of the substantial amount of management time that would be required for management presentations, the Transaction Committee concluded that the two low bidders should be excluded from that process. The Transaction Committee authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers and allow these parties to conduct additional due diligence.\" (P-010, p29)',\n    source='P-010; P-013', dfrom=D(2016,5,23), dto=D(2016,6,1), wdate=D(2016,6,1),\n    dbasis='Reported interval', dmethod='Assigned: decision day', page=29, related='R014; R018', review='Q1'))\n\nL.append(row(id='R018', when='06/01/2016', who='Two low bidders (unnamed IOI submitters)', what='Dropped by target',\n    round=1, type='Unknown', count=2,\n    terms='Excluded from the management-presentation process as the two lowest IOI bidders; identities and prices not disclosed (within the R014 envelope); denied the management-presentation and data-room stage.',\n    why='Stated: exclusion, count (2) and rationale; Inferred: identities (unnamed). Decided by Target; Exit reason: Lower offer than rivals. Date: concluded at the later 06/01/2016 meeting (Convention; Assigned: decision day). Quote: \"the Transaction Committee concluded that the two low bidders should be excluded from that process\" (P-010, p29)',\n    source='P-010', dfrom=D(2016,5,23), dto=D(2016,6,1), wdate=D(2016,6,1), dbasis='Reported interval',\n    dmethod='Assigned: decision day', decided='Target', exit='Lower offer than rivals', obasis='Stated',\n    page=29, related='R014; R017', review='Q5'))\n\nL.append(row(id='R019', when='mid-June 2016 (drafts posted 06/29, 06/30 and 07/11/2016); due 07/20/2016',\n    who='Company / GHF', what='Round opened', round=2,\n    terms='R2 opens: Committee-directed instruction to all potential buyers to submit non-binding LOIs by 07/20/2016 together with mark-ups of the merger agreement, disclosure letter and voting agreement (initial drafts posted to the data site 06/29, 06/30 and 07/11/2016); buyers to value 100% of the outstanding common stock on a per-share basis (assuming preferred conversion) or give non-cash terms. Round finality: Not final (non-binding LOI stage).',\n    why='Stated: instruction, deadline, required mark-ups, postings and valuation basis. Date: \"mid-June 2016\" (Convention: 11\\u201319 band, midpoint 06/15/2016 as sort key; Assigned: midpoint). Round finality: Not final \\u2014 no announcement and no definitive-negotiation move yet (Convention). Quote: \"In mid-June 2016, at the direction of the Transaction Committee, representatives of GHF instructed all potential buyers to submit non-binding letters of intent (\\u201cLOIs\\u201d) by July 20, 2016, together with mark-ups of the forms of merger agreement, disclosure letter and voting agreement\" (P-011, p29)',\n    source='P-011; P-012', dfrom=D(2016,6,11), dto=D(2016,6,19), wdate=D(2016,6,15),\n    dbasis='Approximate window', dmethod='Assigned: midpoint', duedate=D(2016,7,20), finality='Not final',\n    page=29, related='R006; R034', review='Q1'))\n\nL.append(row(id='R020', when='early July 2016 (day not disclosed)', who='Party C (strategic buyer; late entrant)',\n    what='Bidder interest', round=2, type='Strategic', count=1,\n    terms='Party C approached Company management and expressed interest in acquiring the Company; not previously part of the process; bidder-initiated first contact; led to an NDA and catch-up access (R021, R023) and an IOI (R022).',\n    why='Stated: approach, acquisition interest and late-entrant status. Count 1 = newly represented individual (contact tally). Date: \"early July 2016\" (Convention: 1\\u201310 band, midpoint 07/05/2016 as sort key; Assigned: midpoint). Quote: \"In early July 2016, a potential strategic buyer that had not previously been part of the process (\\u201cParty C\\u201d) approached the Company\\u2019s management and expressed interest in acquiring the Company.\" (P-013, p29)',\n    source='P-013', dfrom=D(2016,7,1), dto=D(2016,7,10), wdate=D(2016,7,5),\n    dbasis='Approximate window', dmethod='Assigned: midpoint', page=29, related='R021; R022', review='Q7'))\n\nL.append(row(id='R021', when='early July 2016 (after the approach; before 07/12/2016)', who='Party C',\n    what='NDA signed', round=2, type='Strategic', count=1,\n    terms='Executed a confidentiality agreement, then was provided the memorandum given to the other potential buyers; late entrant tracked separately from the 25 opening-wave signers (Q3).',\n    why='Stated: NDA execution and memorandum; no day disclosed. Date: bounded by the early-July approach and the 07/12/2016 IOI; Working date is the window midpoint (Convention; Assigned: midpoint). Count 1 = new signer. Quote: \"After executing a confidentiality agreement, Party C was provided the memorandum concerning the Company provided to the other potential buyers.\" (P-013, p29)',\n    source='P-013', dfrom=D(2016,7,1), dto=D(2016,7,12), wdate=D(2016,7,6),\n    dbasis='Approximate window', dmethod='Assigned: midpoint', page=29, related='R020; R023', review='Q3; Q7'))\n\nL.append(row(id='R022', when='07/12/2016', who='Party C', what='Bid', round=2, type='Strategic', count=1,\n    formality='Informal', conditions='Heavy',\n    terms='IOI to acquire the Company at $21.00 per share (implying an equity value of $108 million); later revised in its LOI (R028); count 1 = Party C\\u2019s first R2 submission.',\n    why='Stated: date, price and implied equity value. Formality: Informal (Convention) \\u2014 non-binding IOI; no markups reported. Conditions: Heavy by context (Convention) \\u2014 bid made before data-room or management access (access followed, R023). Date: Reported day. Quote: \"On July 12, 2016, Party C submitted an IOI with an offer price per share of $21.00 (implying an equity value of $108 million).\" (P-013, p29)',\n    source='P-013', plow=21.00, phigh=21.00, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n    wdate=D(2016,7,12), dbasis='Reported day', dmethod='Reported', page=29,\n    related='R021; R023; R028', review='Q4'))\n\nL.append(row(id='R023', when='after 07/12/2016; presentation 07/14/2016', who='Party C', what='Information access changed',\n    round=2, type='Strategic',\n    terms='Late-entrant catch-up access: after its IOI, Party C was provided access to the internet data site used by the other advancing buyers and a telephone management presentation on 07/14/2016; access compressed into the LOI window relative to the others\\u2019 June\\u2013July access; Count blank (access decision).',\n    why='Stated: data-site access and the 07/14/2016 presentation, explicitly \"Subsequently\" to the IOI;\\u00a0Inferred: difference in access timing among live participants (late entrant). Working date = the stated presentation day as the upper bound (Assigned: bound). Quote: \"Subsequently, Party C was provided access to the internet data site and the Company\\u2019s management held a management presentation with Party C by telephone on July 14, 2016.\" (P-013, p29)',\n    source='P-013', dfrom=D(2016,7,13), dto=D(2016,7,14), wdate=D(2016,7,14), dbasis='Relative only',\n    dmethod='Assigned: bound', page=29, related='R020; R021', review='Q7'))\n\nL.append(row(id='R024', when='07/20/2016', who='Company', what='Deadline', round=2,\n    terms='Scheduled LOI due date reached; six LOIs received in late July 2016 and considered; one (G&W) dated 07/21/2016 after the due date, with no revision of the deadline \\u2014 treatment: Late bids accepted.',\n    why='Stated: due date; receipt of six LOIs and G&W\\u2019s 07/21/2016 date. Late-bid test: G&W\\u2019s date falls after the due date and the target considered it without a revision \\u2014 Late bids accepted; the other five LOIs are undated and no extension is recorded (Convention). Quotes: \"In late July 2016, the Company received six LOIs with offer prices per share ranging from $19.20 to $24.00\" (P-014, p29); \"G&W submitted an LOI on July 21, 2016\" (P-016, p29).',\n    source='P-014; P-016', wdate=D(2016,7,20), dbasis='Reported day', dmethod='Reported',\n    duedate=D(2016,7,20), dlteat='Late bids accepted', page=29, related='R019; R032; R033', review='Q2'))\n\nL.append(row(id='R025', when='by 07/20/2016 (late July; day not disclosed)', who='Party B', what='Bid', round=2,\n    type='Strategic', count=1, formality='Formal', conditions='Light',\n    terms='LOI to acquire the Company at $24.00 per share, subject to an expedited diligence review; provided mark-ups of the merger agreement and voting agreement; highest-priced offer at the LOI stage; advanced to confirmatory diligence with G&W (R034).',\n    why='Stated: price, diligence condition and markups. Formality: Formal \\u2014 signal 1, bidder-returned acquisition-agreement markups. Conditions: Light \\u2014 no Heavy trigger: expedited diligence review only; financing not addressed. Date: due date inside the \"late July\" receipt window (Convention; Assigned: deadline). Quotes: \"Party B submitted an LOI to acquire the Company for a price of $24.00 per share (subject to an expedited diligence review).\" (P-015, p29); \"Party B, G&W and another bidder (\\u201cParty D\\u201d) also provided mark-ups of the draft merger agreement and voting agreement.\" (P-014, p29)',\n    source='P-015; P-014', plow=24.00, phigh=24.00, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: confirmatory; DD open: yes; Excl: none',\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\n    dmethod='Assigned: deadline', page=29, related='R034; R051', review='Q4'))\n\nL.append(row(id='R026', when='by 07/20/2016 (late July; day not disclosed)', who='Party E', what='Bid', round=2,\n    type='Strategic', count=1, formality='Informal', conditions='Heavy',\n    terms='LOI at $21.26 per share, subject to a 60-day exclusivity period for due diligence and negotiation of definitive documentation; provided a summary of material issues and proposed changes to the merger agreement and voting agreement (an issues list, not a returned markup \\u2014 borderline formality, Q4).',\n    why='Stated: price, exclusivity period and the issues list. Formality: Informal \\u2014 working default for an issues list without another formal signal; flagged as borderline (Q4). Conditions: Heavy \\u2014 stated 60-day exclusive diligence period. Date: Assigned: deadline (Convention). Quotes: \"Party E (a strategic buyer) submitted an LOI to acquire the Company for a price of $21.26 per share (subject to a 60-day exclusivity period for due diligence and negotiation of definitive documentation).\" (P-017, p30); \"One bidder (\\u201cParty E\\u201d) provided a summary of material issues and proposed changes to the merger agreement and voting agreement with respect to those issues.\" (P-014, p29)',\n    source='P-017; P-014', plow=21.26, phigh=21.26, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (60 days); DD open: yes; Excl: requested (60 days)',\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\n    dmethod='Assigned: deadline', page=30, related='R041; R042; R043', review='Q4'))\n\nL.append(row(id='R027', when='by 07/20/2016 (late July; day not disclosed)', who='Party D', what='Bid', round=2,\n    type='Financial', count=1, formality='Formal', conditions='Heavy',\n    terms='LOI at $21.00 per share, subject to a four-week diligence period; provided mark-ups of the merger agreement and voting agreement.',\n    why='Stated: price, diligence period and markups. Formality: Formal \\u2014 signal 1, bidder-returned acquisition-agreement markups. Conditions: Heavy \\u2014 stated four-week diligence period. Date: Assigned: deadline (Convention). Quotes: \"Party D (a financial buyer) submitted an LOI to acquire the Company for a price of $21.00 per share (subject to a four-week diligence period).\" (P-018, p30); \"Party B, G&W and another bidder (\\u201cParty D\\u201d) also provided mark-ups of the draft merger agreement and voting agreement.\" (P-014, p29)',\n    source='P-018; P-014', plow=21.00, phigh=21.00, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (4 wks); DD open: yes; Excl: none',\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\n    dmethod='Assigned: deadline', page=30, related='R036; R040', review='Q4'))\n\nL.append(row(id='R028', when='by 07/20/2016 (late July; day not disclosed)', who='Party C', what='Bid', round=2,\n    type='Strategic', count=0, formality='Informal', conditions='Heavy',\n    terms='LOI at $19.30 per share, subject to a 30-day diligence period; lower than its $21.00 IOI (R022); no markup or formal signal reported. Count 0 \\u2014 Party C\\u2019s R2 bidder count is carried on R022.',\n    why='Stated: price and diligence period. Formality: Informal (Convention) \\u2014 no markup or other formal signal reported. Conditions: Heavy \\u2014 stated 30-day diligence period. Count 0 (same bidder, later row in R2; covering row R022). Date: Assigned: deadline (Convention). Quote: \"Party C submitted an LOI to acquire the Company for a price of $19.30 per share (subject to a 30-day diligence period).\" (P-019, p30)',\n    source='P-019', plow=19.30, phigh=19.30, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\n    dmethod='Assigned: deadline', page=30, related='R022; R035', review='Q4'))\n\nL.append(row(id='R029', when='by 07/20/2016 (late July; day not disclosed)', who='Party F', what='Bid', round=2,\n    type='Strategic', count=1, formality='Informal', conditions='Heavy',\n    terms='LOI at $19.20 per share, subject to a 30-day due diligence period; no markup or other formal signal reported.',\n    why='Stated: price and diligence period. Formality: Informal (Convention) \\u2014 no markup or other formal signal reported. Conditions: Heavy \\u2014 stated 30-day due diligence period. Date: Assigned: deadline (Convention). Quote: \"Party F (a strategic buyer) submitted an LOI to acquire the Company for a price of $19.20 per share (subject to a 30-day due diligence period).\" (P-020, p30)',\n    source='P-020', plow=19.20, phigh=19.20, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\n    dmethod='Assigned: deadline', page=30, related='R038; R042', review='Q4'))\n\nL.append(row(id='R030', when='by 07/20/2016 (day of election not disclosed)', who='Unnamed strategic bidder (LOI non-submitter)',\n    what='Did not submit', round=2, type='Strategic', count=1,\n    terms='Elected not to submit an LOI in the 07/20/2016 solicitation while in the process at that stage; identity not disclosed; may overlap other unnamed cohorts (Q3).',\n    why='Stated: the election and the type split (one strategic, one financial). Date: solicitation due date (Convention; Assigned: deadline). Decided by Bidder; Exit reason: Not stated. Quote: \"One strategic buyer and one financial buyer elected not to submit an LOI.\" (P-021, p30)',\n    source='P-021', dto=D(2016,7,20), wdate=D(2016,7,20), dbasis='Relative only',\n    dmethod='Assigned: deadline', decided='Bidder', exit='Not stated', obasis='Stated', page=30,\n    related='R031; R015', review='Q3'))\n\nL.append(row(id='R031', when='by 07/20/2016 (day of election not disclosed)', who='Unnamed financial bidder (LOI non-submitter)',\n    what='Did not submit', round=2, type='Financial', count=1,\n    terms='Elected not to submit an LOI in the 07/20/2016 solicitation while in the process at that stage; identity not disclosed; may overlap other unnamed cohorts (Q3).',\n    why='Stated: the election and the type split. Date: solicitation due date (Convention; Assigned: deadline). Decided by Bidder; Exit reason: Not stated. Quote: as at R030 (P-021, p30).',\n    source='P-021', dto=D(2016,7,20), wdate=D(2016,7,20), dbasis='Relative only',\n    dmethod='Assigned: deadline', decided='Bidder', exit='Not stated', obasis='Stated', page=30,\n    related='R030; R015', review='Q3'))\n\nL.append(row(id='R032', when='07/21/2016', who='G&W', what='Bid', round=2, type='Strategic', count=1,\n    formality='Formal', conditions='Heavy',\n    terms='LOI at $21.15 per share = $20.02 cash at closing + $1.13 CVR (contingent value right based on the subsequent sale of the South Quay property); subject to a three-week exclusive diligence period; provided a markup of the disclosure letter and (with its LOIs) mark-ups of the merger agreement and voting agreement; revised 07/26/2016 (R033).',\n    why='Stated: date, price split, CVR basis, diligence/exclusivity condition and markups. Formality: Formal \\u2014 signal 1, returned acquisition-agreement and voting-agreement markups. Conditions: Heavy \\u2014 stated three-week exclusive diligence period. Date: Reported day. Quote: \"G&W submitted an LOI on July 21, 2016 to acquire the Company for a price of $21.15 per share (subject to a three-week exclusive diligence period). The price included $20.02 cash at closing and $1.13 in the form of a contingent value right, the value of which was based on the subsequent sale of the Company\\u2019s South Quay property (\\u201cCVR\\u201d).\" (P-016, p29)',\n    source='P-016; P-014', plow=21.15, phigh=21.15, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Yes', cashclose=20.02, conddetail='Fin: not stated; DD required: substantive (3 wks); DD open: yes; Excl: requested (3 wks)',\n    wdate=D(2016,7,21), dbasis='Reported day', dmethod='Reported', page=29,\n    related='R033; R034; R049', review='Q4; Q6'))\n\nL.append(row(id='R033', when='07/26/2016', who='G&W', what='Bid', round=2, type='Strategic', count=0,\n    formality='Formal', conditions='Heavy',\n    terms='Revised LOI at $22.15 per share = $21.02 cash at closing + $1.13 CVR (unchanged), after GHF feedback that the price and CVR structure were not competitive. Count 0 \\u2014 second R2 submission by G&W; R032 carries its R2 bidder count.',\n    why='Stated: date, revised price split and the reason for the revision. Formality: Formal (carried forward from R032). Conditions: Heavy \\u2014 the three-week exclusive diligence period carries with the revision (no change reported). Count 0 (covering row R032). Date: Reported day. Quote: \"On July 26, 2016, in response to feedback from representatives of GHF indicating its price and CVR structure were not competitive, G&W submitted a revised LOI, which increased its offer to $22.15 per share (including $21.02 in cash and $1.13 CVR).\" (P-016, p29)',\n    source='P-016', plow=22.15, phigh=22.15, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Yes', cashclose=21.02, conddetail='Fin: not stated; DD required: substantive (3 wks); DD open: yes; Excl: requested (3 wks)',\n    wdate=D(2016,7,26), dbasis='Reported day', dmethod='Reported', page=29,\n    related='R032; R049', review='Q4; Q6'))\n\nL.append(row(id='R034', when='07/27/2016', who='Transaction Committee', what='Round opened', round=3,\n    terms='R3 opens: the Committee concluded to proceed with confirmatory due diligence and negotiations with G&W and Party B because of their higher offers relative to the other potential buyers; remaining bidders informed they were no longer involved (R035\\u2013R038); on-site financial, legal and environmental diligence and hi-rail inspections by both finalists 07/27\\u201308/11/2016 (access alike for the advancing set). Round finality: Inferred final (moved to definitive negotiation with selected bidders).',\n    why='Stated: the conclusion, rationale, notice to remaining bidders and the diligence period. Round finality: Inferred final \\u2014 no final/binding-stage announcement, but the target moved to definitive negotiation with selected bidders (Convention). Date: Reported day. Quote: \"The Transaction Committee concluded that the Company should proceed with confirmatory due diligence and negotiations with G&W and Party B because of the higher offers made by each of G&W and Party B relative to the other potential buyers.\" (P-022, p30)',\n    source='P-022; P-025', wdate=D(2016,7,27), dbasis='Reported day', dmethod='Reported', finality='Inferred final',\n    page=30, related='R019; R035; R036; R037; R038; R048', review='Q1'))\n\nfor rid, who, offer, rel in [\n    ('R035', 'Party C', '$19.30', 'R028'),\n    ('R036', 'Party D', '$21.00', 'R027; R039'),\n    ('R037', 'Party E', '$21.26', 'R026; R041'),\n    ('R038', 'Party F', '$19.20', 'R029; R042')]:\n    L.append(row(id=rid, when='07/27/2016 (notice day not disclosed; reported as \"subsequently\")', who=who,\n        what='Dropped by target', round=2, type=('Financial' if rid == 'R036' else 'Strategic'), count=1,\n        terms=f'Told no longer involved after the decision to proceed with G&W and Party B; offered {offer} at the LOI stage versus the finalists\\u2019 $24.00 and $22.15; denied the confirmatory and definitive stage (R3).',\n        why=f'Stated: notice to the remaining bidders and the exit; Inferred: the individual recipient (named non-finalist LOI submitter). Decided by Target; Exit reason: Lower offer than rivals. Date: the decision day (Convention; Assigned: decision day); the notice was given \"subsequently\". Quote: \"At the direction of the Transaction Committee, representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process.\" (P-022, p30)',\n        source='P-022', dfrom=D(2016,7,27), wdate=D(2016,7,27), dbasis='Relative only',\n        dmethod='Assigned: decision day', decided='Target', exit='Lower offer than rivals', obasis='Stated',\n        page=30, related=rel, review='Q5'))\n\nL.append(row(id='R039', when='08/01/2016', who='Party D', what='Re-entered', round=3, type='Financial', count=1,\n    terms='Renewed participation after its 07/27/2016 exclusion: D and E expressed interest in re-engaging on GHF\\u2019s 07/29/2016 calls and D submitted a revised LOI on 08/01/2016 (R040) \\u2014 actual renewed activity, not a mere request.',\n    why='Stated: the calls, renewed interest and the revised LOI; the re-entry day is the dated renewed activity. Date: Reported day. Quote: \"On July 29, 2016, representatives of GHF had calls with Party D and Party E. During those calls, Party D and Party E both expressed interest in reengaging and enhancing their offers.\" (P-023, p30)',\n    source='P-023', wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\n    related='R036; R040', review='Q5'))\n\nL.append(row(id='R040', when='08/01/2016', who='Party D', what='Bid', round=3, type='Financial', count=1,\n    formality='Formal', conditions='Heavy',\n    terms='Revised LOI at $24.00 per share (up from $21.00, R027), subject to a 30-day due diligence period; D asked the Company not to enter an agreement with another bidder during that period; the Company declined; D then indicated it would not proceed with further diligence at that time (R044).',\n    why='Stated: price, 30-day diligence condition, requested no-signing commitment, the Company\\u2019s refusal and D\\u2019s response. Formality: Formal (carried forward \\u2014 markups at the LOI stage). Conditions: Heavy \\u2014 30-day diligence period; the requested no-signing commitment is recorded under Excl. Date: Reported day. Quotes: \"Party D submitted a revised LOI at a price of $24.00 per share\" (P-023, p30); \"Party D declined to shorten its due diligence period and requested that the Company commit that it would not enter into an agreement with another bidder during its 30-day due diligence period\" (P-023, p30).',\n    source='P-023; P-025', plow=24.00, phigh=24.00, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (4 wks); DD open: yes; Excl: requested (4 wks)',\n    wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\n    related='R027; R039; R044; R046', review='Q4; Q5'))\n\nL.append(row(id='R041', when='08/01/2016', who='Party E', what='Re-entered', round=3, type='Strategic', count=1,\n    terms='Renewed participation after its 07/27/2016 exclusion: E expressed interest in re-engaging on GHF\\u2019s 07/29/2016 calls and submitted a revised LOI on 08/01/2016 (R042) \\u2014 actual renewed activity, not a mere request.',\n    why='Stated: the calls, renewed interest and the revised LOI; the re-entry day is the dated renewed activity. Date: Reported day. Quote: as at R039 (P-023, p30).',\n    source='P-023', wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\n    related='R037; R042', review='Q5'))\n\nL.append(row(id='R042', when='08/01/2016', who='Party E', what='Bid', round=3, type='Strategic', count=1,\n    formality='Informal', conditions='Heavy',\n    terms='Support: Party F (financing) \\u2014 revised LOI at $23.81 per share with financing support from Party F, subject to a 30-day due diligence period; F\\u2019s independent participation had ended on 07/27/2016 (R038), so F gets no new row and no re-entry; F\\u2019s earlier bid: R029.',\n    why='Stated: price, F\\u2019s financing support and the 30-day diligence period. Formality: Informal (issues-list history; no markups). Conditions: Heavy \\u2014 30-day diligence period. Support: financing support does not establish joint bidding (Convention) and the supporter had already exited, so it gets no new row (Convention). Date: Reported day. Quote: \"Party E submitted a revised LOI, along with financing support, from Party F, at a price of $23.81 per share. Both revised proposals contained a 30-day due diligence period.\" (P-023, p30)',\n    source='P-023', plow=23.81, phigh=23.81, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\n    wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\n    related='R026; R038; R041; R043', review='Q4; Q5'))\n\nL.append(row(id='R043', when='08/02/2016', who='Party E', what='Bid reaffirmed', round=3, type='Strategic',\n    count=0, formality='Informal', conditions='Heavy',\n    terms='Reaffirmed by: price confirmed \\u2014 withdrew its revised $23.81 proposal and confirmed its original proposal of $21.26 per share; the original terms (60-day exclusive diligence and negotiation period) carried forward; the revised proposal stands withdrawn.',\n    why='Stated: withdrawal of the revision and confirmation of the original price. Formality: Informal (carried from R026). Conditions: Heavy \\u2014 the confirmed original 60-day exclusive diligence and negotiation period. Price: carried forward from R026 (Convention). Count 0 \\u2014 no new unit; E\\u2019s R3 count is on R042. Date: Reported day. Quote: \"Party E withdrew its revised proposal on August 2, 2016 (but confirmed its original proposal of $21.26 per share)\" (P-023, p30)',\n    source='P-023', plow=21.26, phigh=21.26, pkind='Point', porigin='Carried forward', currency='USD',\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (60 days); DD open: not disclosed; Excl: requested (60 days)',\n    wdate=D(2016,8,2), dbasis='Reported day', dmethod='Reported', page=30,\n    related='R026; R042; R047', review='Q4; Q5'))\n\nL.append(row(id='R044', when='08/02/2016 (day inferred; reported with the 08/02/2016 events)',\n    who='Party D', what='Participation paused', round=3, type='Financial', count=1,\n    terms='D declined to shorten its 30-day diligence period and asked the Company not to sign with another bidder during it; the Company declined; D indicated it would not proceed with further due diligence \"at that time\" \\u2014 D\\u2019s own stated temporary stop, not a withdrawal; D remains live (closed at R046).',\n    why='Stated: the exchange and D\\u2019s own statement; Inferred: the day (reported with the 08/02/2016 withdrawal of E\\u2019s revised proposal and after the 08/01/2016 Committee meeting; no day stated) \\u2014 Inferred day. Decided by Bidder; Exit reason: Terms or process (the no-signing commitment D requested was not obtained). A pause does not close a participant (Convention). Quote: \"at which point Party D indicated that it would not proceed with further due diligence at that time\" (P-023, p30)',\n    source='P-023', dfrom=D(2016,8,2), dto=D(2016,8,2), wdate=D(2016,8,2), dbasis='Inferred day',\n    dmethod='Inferred', decided='Bidder', exit='Terms or process', obasis='Stated', page=30,\n    related='R040; R046', review='Q5'))\n\nL.append(row(id='R045', when='08/04/2016', who='Transaction Committee', what='Target decision', round=3,\n    terms='Committee directed continued diligence and negotiations with both G&W and Party B, but to prioritize Party B and complete the merger agreement with it, given Party B\\u2019s higher price; D and E are not in the continuing set (closes R046, R047).',\n    why='Stated: the direction and rationale. Date: Reported day. Quote: \"During that discussion, the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B, but given the higher price offered by Party B, to prioritize Party B and proceed to complete the negotiation of the merger agreement with Party B.\" (P-025, p31)',\n    source='P-025', wdate=D(2016,8,4), dbasis='Reported day', dmethod='Reported', page=31,\n    related='R034; R046; R047'))\n\nfor rid, who, rel in [('R046', 'Party D', 'R044; R045'), ('R047', 'Party E', 'R043; R045')]:\n    L.append(row(id=rid, when='by 08/04/2016', who=who, what='Dropped by target', round=3,\n        type=('Financial' if rid == 'R046' else 'Strategic'), count=1,\n        terms=f'Inferred: residual \\u2014 the 08/04/2016 decision names the continuing set (G&W and Party B) without {who.split()[-1]} and reports no notice to it; {who.split()[-1]} was out by this transition; the row does not say how or why.',\n        why=f'Inferred: residual \\u2014 continuing set named at R045; {who.split()[-1]}\\u2019s last appearance is {\"the pause\" if rid == \"R046\" else \"the withdrawn revision and price confirmation\"} (P-023). Count 1. Decided by Target; Exit reason: Not stated; Working date = the decision day (Convention; Assigned: decision day). Quotes: \"the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B\" (P-025, p31); \"at which point Party D indicated that it would not proceed with further due diligence at that time\" (P-023, p30).',\n        source='P-025; P-023', dto=D(2016,8,4), wdate=D(2016,8,4), dbasis='Relative only',\n        dmethod='Assigned: decision day', decided='Target', exit='Not stated', obasis='Inferred: residual',\n        page=31, related=rel, review='Q5'))\n\nL.append(row(id='R048', when='08/09/2016', who='Transaction Committee', what='Target decision', round=3,\n    terms='Directed BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder (Party B); G&W requested and was granted continued due diligence, including physical diligence on 08/10\\u201308/11/2016, to potentially facilitate an improved offer.',\n    why='Stated: direction, request and grant; the intended counterparty was Party B (R045, R050). Date: Reported day. Quote: \"Following that discussion, the Transaction Committee directed representatives of BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder. G&W requested that it be allowed to continue its due diligence, including physical due diligence on August 10 and August 11, 2016, to potentially facilitate an improved offer, which request was granted.\" (P-026, p31)',\n    source='P-026; P-025', wdate=D(2016,8,9), dbasis='Reported day', dmethod='Reported', page=31,\n    related='R045; R049'))\n\nL.append(row(id='R049', when='08/12/2016 (offer stated to expire 6:00 p.m. on 08/13/2016)', who='G&W',\n    what='Bid', round=3, type='Strategic', count=1, formality='Formal', conditions='Light',\n    terms='Revised LOI at $25.00 per share in cash, excluding the previously proposed CVR, with mark-ups of the merger agreement and voting agreement; submitted the morning of 08/12/2016 after G&W completed physical diligence (08/11/2016); offer stated to expire at 6:00 p.m. on 08/13/2016.',\n    why='Stated: price, cash form, CVR exclusion, markups, submission morning and expiry. Formality: Formal \\u2014 signal 1 (returned acquisition-agreement and voting-agreement markups; second return). Conditions: Light \\u2014 no Heavy trigger reported: diligence completed 08/11/2016; the executed agreement contains no financing condition and G&W represented its financial wherewithal (X-007, p34). Date: Reported day. Quote: \"G&W submitted a revised LOI to acquire the Company for a price of $25.00 per share in cash, which excluded the previously proposed CVR, together with mark-ups of the merger agreement and the voting agreement. G&W\\u2019s LOI further indicated that the offer would expire at 6:00 p.m. on the following day.\" (P-027, p31)',\n    source='P-027; X-007', plow=25.00, phigh=25.00, pkind='Point', porigin='Stated', currency='USD',\n    allcash='Yes', cashclose=25.00, conddetail='Fin: not stated; DD required: none; DD open: no; Excl: none',\n    wdate=D(2016,8,12), dbasis='Reported day', dmethod='Reported', page=31,\n    related='R032; R033; R048; R050', review='Q4; Q6'))\n\nL.append(row(id='R050', when='08/12/2016', who='Company and G&W (with the Eder Trusts)', what='Merger agreement signed',\n    round=3,\n    terms='Executed merger agreement (G&W, Pullman Acquisition Sub Inc., the Company): agreed consideration $25.00 cash per common share, without interest; preferred deemed converted 100-for-1 plus accrued and unpaid dividends before the $25.00; no financing condition and G&W representation as to financial wherewithal; termination fee $3,785,000 (approximately 3% of transaction value); outside date 12/31/2016 (02/28/2017 if STB approval is the only unsatisfied condition); non-solicitation with fiduciary out and 3-business-day matching right; no go-shop; G&W to seek STB approval or exemption and to use a voting trust if needed; voting agreement executed with the Eder Trusts (842,742 common; 500 preferred; approximately 17.3% and 78.1%).',\n    why='Stated: execution, agreed price, conversion mechanics, no financing condition, termination fee, outside dates, no go-shop; signing records agreed consideration only \\u2014 no bid-price, formality or conditions cells (Convention). Date: Reported day. Quotes: \"The Company and G&W executed the merger agreement, and the Company, G&W and the Eder Trusts executed the voting agreement.\" (P-032, p32); \"the absence of a financing condition in the merger agreement and the representation of G&W in the merger agreement as to its financial wherewithal\" (X-007, p34).',\n    source='P-032; X-007; X-013; X-014; X-016; X-017; X-020', wdate=D(2016,8,12), dbasis='Reported day',\n    dmethod='Reported', page=32, related='R049; R051', review='Q6'))\n\nL.append(row(id='R051', when='08/12/2016', who='Party B', what='Not selected at signing', round=3,\n    type='Strategic', count=1,\n    terms='Asked at the Board\\u2019s request whether it would increase its $24.00 offer; declined; the Board then determined the G&W offer was the superior proposal and signed with G&W \\u2014 B was still bidding when the target chose another, so no earlier exit is inferred (Stated).',\n    why='Stated: the inquiry, B\\u2019s refusal to improve and the Board\\u2019s determination. Decided by Target; Exit reason: Would not improve earlier offer (a bidder asked to improve that declines, even though the target then chose a rival). Date: Reported day. Quotes: \"At the request of the Board, representatives of BMO then contacted Party B to determine if it would increase its offer price. Party B indicated that it would not increase its price.\" (P-030, p32); \"The Board determined that the G&W offer represented the superior proposal.\" (P-031, p32)',\n    source='P-030; P-031', wdate=D(2016,8,12), dbasis='Reported day', dmethod='Reported',\n    decided='Target', exit='Would not improve earlier offer', obasis='Stated', page=32,\n    related='R025; R050', review='Q5'))\n\nL.append(row(id='R052', when='08/15/2016', who='Providence and Worcester Railroad Company',\n    what='Merger announced', round=3,\n    terms='PWRR issued a press release publicly announcing the transaction before the opening of NASDAQ trading on Monday 08/15/2016.',\n    why='Stated: issuer, medium, date and timing. Date: Reported day. Quote: \"The Company issued a press release publicly announcing the transaction on Monday, August 15, 2016 prior to the opening of trading of the Company\\u2019s common stock on the NASDAQ.\" (P-032, p32)',\n    source='P-032', wdate=D(2016,8,15), dbasis='Reported day', dmethod='Reported', page=32,\n    related='R050'))\n\n# assign # order\nfor i, r in enumerate(L, start=1):\n    r['num'] = i\n\nDEPTH = {  # page of the main source paragraph, sanity fallback\n}\n\n# ---------------------------------------------------------------- checks (pre-build)\ndef norm(s):\n    s = s.replace('\\u2019', \"'\").replace('\\u2018', \"'\").replace('\\u201c', '\"').replace('\\u201d', '\"')\n    s = s.replace('\\u2014', '-').replace('\\u2013', '-').replace('\\u00a0', ' ')\n    s = re.sub(r'\\s+', ' ', s)\n    return s.strip().lower()\n\nsrc_blob = {r['id']: norm(r['text']) for r in SRC}\nproblems = []\nfor r in L:\n    for q in re.findall(r'\"([^\"]{15,})\"', r['why']):\n        qn = norm(q)\n        if not any(qn in t for t in src_blob.values()):\n            problems.append((r['id'], q[:70]))\nprint('QUOTE PROBLEMS:', len(problems))\nfor p in problems:\n    print('  ', p)\n\n# working date monotonic\nprev = None\nfor r in L:\n    assert r['wdate'] is not None, r['id']\n    if prev and r['wdate'] < prev:\n        print('ORDER PROBLEM', r['id'], prev, r['wdate'])\n    prev = r['wdate']\n\nprint('rows:', len(L))\njson.dump(L, open('/tmp/opencode/pw/ledger.json', 'w'), default=str, indent=1)\njson.dump(SRC, open('/tmp/opencode/pw/sources.json', 'w'), indent=1)\n"},"output":"Created file successfully: /tmp/opencode/pw/build.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/pw/build.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/pw/build.py\", \"content\": \"#!/usr/bin/env python3\\n# Build providence-worcester.xlsx deal ledger from the DEFM14A (PWRR / G&W, Sept 2016).\\nimport json, re, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nBLOCKS = {b['i']: b for b in json.load(open('/tmp/opencode/pw/blocks.json'))}\\n\\n# ---------------------------------------------------------------- source rows\\nPIDX = [517,518,521,522,523,524,525,526,529,530,531,532,533,534,535,536,\\n        539,540,541,542,543,544,545,546,549,550,551,552,553,556,557,558,559]\\nPSEC = \\\"Background of the Merger\\\"\\nP_rows = []\\nfor n, bi in enumerate(PIDX, start=1):\\n    b = BLOCKS[bi]\\n    P_rows.append({'id': f'P-{n:03d}', 'section': PSEC, 'page': b['page'], 'text': b['text']})\\n\\nX_SPECS = [\\n ('X-001', [428], \\\"The Parties to the Merger Agreement\\\", None),\\n ('X-002', [431], \\\"The Parties to the Merger Agreement\\\", None),\\n ('X-003', [434], \\\"The Parties to the Merger Agreement\\\", None),\\n ('X-004', [450], \\\"The Special Meeting of the Shareholders\\\\u2014Record Date; Outstanding Shares; Shares Entitled to Vote\\\", None),\\n ('X-005', [568], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Recommendation of the Board of Directors and Reasons for the Merger\\\", None),\\n ('X-006', [571], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Recommendation of the Board of Directors and Reasons for the Merger\\\", None),\\n ('X-007', [584], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Recommendation of the Board of Directors and Reasons for the Merger\\\", None),\\n ('X-008', [599], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Recommendation of the Board of Directors and Reasons for the Merger\\\", None),\\n ('X-009', [610], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Opinion of the Company's Financial Advisor\\\", None),\\n ('X-010', [701], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Summary of Financial Analysis of BMO Capital Markets Corp.\\\\u2014Miscellaneous\\\", None),\\n ('X-011', [702,705], \\\"Proposal No. 1\\\\u2014The Merger\\\\u2014Summary of Financial Analysis of BMO Capital Markets Corp.\\\\u2014Miscellaneous\\\", 42),\\n ('X-012', [301], \\\"Summary\\\\u2014Market Price of Our Common Stock\\\", None),\\n ('X-013', [808], \\\"The Merger Agreement\\\\u2014Merger Consideration\\\", None),\\n ('X-014', [811], \\\"The Merger Agreement\\\\u2014Merger Consideration\\\", None),\\n ('X-015', [831], \\\"The Merger Agreement\\\\u2014Conditions to the Merger\\\", None),\\n ('X-016', [868], \\\"The Merger Agreement\\\\u2014Termination of the Merger Agreement\\\", None),\\n ('X-017', [878], \\\"The Merger Agreement\\\\u2014Termination Fee\\\", None),\\n ('X-018', [903], \\\"The Merger Agreement\\\\u2014Limitations on Considering Other Acquisition Proposals; Non-Solicitation Provisions and Exceptions\\\", None),\\n ('X-019', [905], \\\"The Merger Agreement\\\\u2014Limitations on Considering Other Acquisition Proposals; Non-Solicitation Provisions and Exceptions\\\", None),\\n ('X-020', [1106], \\\"The Voting Agreement\\\", None),\\n ('X-021', [506], \\\"Summary\\\\u2014Voting Agreement\\\", None),\\n ('X-022', [996], \\\"The Merger Agreement\\\\u2014Efforts to Complete the Merger\\\", None),\\n]\\nX_rows = []\\nfor xid, bids, sec, pg in X_SPECS:\\n    txt = ' '.join(BLOCKS[i]['text'] for i in bids)\\n    page = pg if pg else BLOCKS[bids[0]]['page']\\n    X_rows.append({'id': xid, 'section': sec, 'page': page, 'text': txt})\\nSRC = P_rows + X_rows\\nSRC_ROW = {r['id']: i + 2 for i, r in enumerate(SRC)}   # sheet row of each id\\nSRC_TEXT = {r['id']: r['text'] for r in SRC}\\n\\n# ---------------------------------------------------------------- ledger rows\\nD = dt.date\\ndef row(**kw):\\n    base = dict(id='', when='', who='', what='', process=1, round=0, type='', terms='',\\n                formality='', conditions='', why='', source='', review='', count=None,\\n                dfrom=None, dto=None, wdate=None, dbasis='', dmethod='', plow=None, phigh=None,\\n                pkind='', porigin='', currency='', allcash='', cashclose=None, conddetail='',\\n                duedate=None, dlteat='', finality='', decided='', exit='', obasis='', page=None,\\n                related='', deal='PWRR-G&W')\\n    base.update(kw)\\n    return base\\n\\nL = []\\nL.append(row(id='R001', when='Q4 2015 (day not disclosed)', who='Party A (unnamed Class I rail partner)',\\n    what='Bidder interest', round=0, type='Strategic',\\n    terms='Party A suggested possible joint venture arrangements and expressed interest in acquiring equity in the Company during a meeting with Chairman/CEO Eder and VP Rogers called to discuss joint commercial opportunities; bidder-initiated first contact; no price discussed. Led to the Board\\\\u2019s banker search (R002).',\\n    why='Stated: the meeting, Party A\\\\u2019s suggestion and its interest; direction bidder\\\\u2192target; no price. Count 1 = newly represented individual (contact tally). Date: \\\"In the fourth quarter of 2015\\\" \\\\u2014 quarter interval, no day; Working date is the calendar midpoint (Convention; Assigned: midpoint). Quote: \\\"During the meeting, Party A suggested possible joint venture arrangements and expressed some interest in acquiring equity in the Company to further develop strategic opportunities and enhance regional connectivity.\\\" (P-001, p27)',\\n    source='P-001', dfrom=D(2015,10,1), dto=D(2015,12,31), wdate=D(2015,11,15),\\n    dbasis='Reported interval', dmethod='Assigned: midpoint', page=27, related='R002; R016'))\\n\\nL.append(row(id='R002', when='01/27/2016', who='Providence and Worcester Railroad Company (Board) / GHF',\\n    what='Adviser engaged', round=0,\\n    terms='Retained GHF (Greene Holcomb & Fisher LLC) as investment banking firm after a subcommittee of two independent directors (Barrett, Anderson) interviewed several firms; subcommittee recommended retention and the Board approved on 01/27/2016; GHF represented it would not represent any potential buyer of the Company or any person proposing financing; GHF\\\\u2019s business acquired by BMO Capital Markets Corp. on 08/01/2016 (successor \\\\u2014 one adviser relationship); rendered the 08/12/2016 fairness opinion (oral, confirmed in writing); fee approximately $2.52 million; on 09/06/2016 the Board reviewed BMO\\\\u2019s disclosure that a BMO affiliate holds an approximately 5% participation in G&W\\\\u2019s senior secured syndicated facility and confirmed it was not material to BMO\\\\u2019s independence.',\\n    why='Stated: retention and approval on 01/27/2016; selection process; no-conflict representation; later dates (BMO succession, opinion, fee, conflict review). Quotes: \\\"During the executive session of the Board\\\\u2019s regular quarterly meeting held on January 27, 2016 (which Director Alfred P. Smith did not attend), the subcommittee recommended to the Board that the Company retain GHF as its investment banking firm.\\\" (P-001, p27); \\\"an affiliate of BMO is a lender with an approximately 5% participation in the syndicate\\\" (X-011, p42); \\\"the Company will pay BMO an aggregate fee of approximately $2.52 million\\\" (X-010, p41).',\\n    source='P-001; X-009; X-010; X-011', wdate=D(2016,1,27), dbasis='Reported day', dmethod='Reported',\\n    page=27, related='R003'))\\n\\nL.append(row(id='R003', when='03/14/2016', who='Board of Directors', what='Target sale decision', round=0,\\n    terms='Special Board meeting: GHF presented its evaluation of the business and industry and proposed a process \\\\u2014 discussions with Party A plus solicitation of other potential third parties for a change in control transaction; Board concluded it was in the Company\\\\u2019s best interest to proceed and appointed the Transaction Committee (Barrett (Chair), Anderson, Garvey) to supervise the process and recommend to the full Board; the Committee could not approve or enter a change of control transaction (full-Board authority under Rhode Island law). Candidate R1 anchor (rejected \\\\u2014 R006).',\\n    why='Stated: meeting, GHF proposal, Board conclusion, Committee appointment and its limits; Date: Reported day. Candidate R1 anchor rejected: the first outreach began the week of 03/28/2016, about two weeks later \\\\u2014 outside the \\\"about a week\\\" execution test (Convention). Quote: \\\"Representatives of GHF then proposed a process pursuant to which the Company would proceed with discussions with Party A and also solicit interest from other potential third parties regarding a change in control transaction.\\\" (P-002, p27)',\\n    source='P-002; P-003', wdate=D(2016,3,14), dbasis='Reported day', dmethod='Reported', page=27,\\n    related='R004; R006', review='Q1'))\\n\\nL.append(row(id='R004', when='03/24/2016', who='Transaction Committee', what='Target decision', round=0,\\n    terms='Following management\\\\u2019s 03/22\\\\u201323/2016 meetings with Party A (Party A informed of GHF\\\\u2019s engagement), the Committee authorized GHF to contact Party A and other potential buyers to determine their interest in a change in control transaction. Candidate R1 anchor (rejected \\\\u2014 outreach wave preferred; R006).',\\n    why='Stated: the meetings (03/22\\\\u201323), the authorization and its scope; Date: Reported day. Candidate anchor note: outreach began during the week of 03/28/2016, within about a week of this authorization, so it is the alternative anchor under the decision rule, but the first outreach wave takes precedence (Convention). Quotes: \\\"had met with various representatives of Party A on March 22 and 23, 2016 and had informed Party A of GHF\\\\u2019s engagement\\\" (P-005, p28); \\\"The Transaction Committee authorized GHF to contact Party A as well as other potential buyers to determine their level of interest in a change in control transaction.\\\" (P-005, p28)',\\n    source='P-004; P-005', wdate=D(2016,3,24), dbasis='Reported day', dmethod='Reported', page=28,\\n    related='R003; R006', review='Q1'))\\n\\nL.append(row(id='R005', when='week of 03/28/2016', who='GHF (for the Company)', what='Contact', round=1,\\n    terms='Outreach wave: GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers to determine their interest in a change in control transaction; two additional Class I railroads approached by management are recorded separately (R009); five strategic buyers (including G&W) had introductory meetings at the 2016 Connections Convention 04/03\\\\u201304/06 (folded into R010).',\\n    why='Stated: the wave, its sub-cohort sizes and purpose. Count 29 = 11 + 18 (single wave; the two sub-cohorts are disjoint as stated). Date: \\\"During the week of March 28, 2016\\\" \\\\u2014 the week\\\\u2019s first day is used as the sort key (Convention; Assigned: bound). Quote: \\\"During the week of March 28, 2016, in accordance with the Transaction Committee\\\\u2019s directives, representatives of GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers.\\\" (P-005, p28)',\\n    source='P-005', count=29, dfrom=D(2016,3,28), dto=D(2016,4,3), wdate=D(2016,3,28),\\n    dbasis='Reported interval', dmethod='Assigned: bound', page=28, related='R006; R007; R008; R009', review='Q3'))\\n\\nL.append(row(id='R006', when='week of 03/28/2016', who='Company / GHF', what='Round opened', round=1,\\n    terms='R1 anchor: first outreach wave (week of 03/28/2016; R005) \\\\u2014 other candidate anchors: R003 (03/14/2016 Board decision to proceed; outreach began about two weeks later) and R004 (03/24/2016 Committee authorization; outreach began the following week); rejected because the first outreach wave takes precedence. Round finality: Not final \\\\u2014 the IOI solicitation was non-binding and no final or binding stage was announced.',\\n    why='Convention: R1 opens at the first outreach wave (rule 1); candidate anchors retained as their own rows. Stated evidence: the contact wave and the subsequent confidentiality agreements and non-binding IOI solicitation (P-005; P-009). Round finality: Not final \\\\u2014 no announcement; a non-binding IOI stage (Convention). Date: week\\\\u2019s first day as sort key (Assigned: bound).',\\n    source='P-005; P-009', wdate=D(2016,3,28), dbasis='Reported interval', dmethod='Assigned: bound',\\n    finality='Not final', page=28, related='R003; R004; R005; R019; R034', review='Q1'))\\n\\nL.append(row(id='R007', when='after 03/28/2016 (exact dates not disclosed)', who='11 potential strategic buyers (cohort; incl. Party A and G&W)',\\n    what='NDA signed', round=1, type='Strategic', count=11,\\n    terms='All 11 contacted potential strategic buyers executed confidentiality agreements; agreements contained no standstill or similar provision; signers later received the Company memorandum and, when advanced, internet data-site access (R017). G&W, Party A and Party B are covered by this cohort (no separate NDA rows).',\\n    why='Stated: cohort size (11), execution and no-standstill terms. Inferred/Convention: execution followed the contacts; no day disclosed; Working date = the lower bound of the contact wave (Assigned: bound). Count 11. Quote: \\\"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements. The confidentiality agreements did not contain any \\\\u201cstandstill\\\\u201d or similar provision that would prohibit a potential buyer from submitting a proposal or making an offer to acquire the Company.\\\" (P-005, p28)',\\n    source='P-005', dfrom=D(2016,3,28), wdate=D(2016,3,28), dbasis='Relative only',\\n    dmethod='Assigned: bound', page=28, related='R005; R008; R021', review='Q3'))\\n\\nL.append(row(id='R008', when='after 03/28/2016 (exact dates not disclosed)', who='14 potential financial buyers (cohort)',\\n    what='NDA signed', round=1, type='Financial', count=14,\\n    terms='14 of the 18 contacted potential financial buyers executed confidentiality agreements (four did not); agreements contained no standstill or similar provision; signers received the memorandum and, when advanced, data-site access.',\\n    why='Stated: cohort size (14 of 18) and no-standstill terms. Inferred/Convention: execution followed the contacts; no day disclosed; Working date = the lower bound of the contact wave (Assigned: bound). Count 14. Quote: as at R007 (P-005, p28).',\\n    source='P-005', dfrom=D(2016,3,28), wdate=D(2016,3,28), dbasis='Relative only',\\n    dmethod='Assigned: bound', page=28, related='R005; R007', review='Q3'))\\n\\nL.append(row(id='R009', when='by 04/07/2016 (day not disclosed)', who='Two additional Class I railroads (unnamed)',\\n    what='Contact', round=1, type='Strategic', count=2,\\n    terms='Management also approached two additional Class I railroads to determine their interest in a possible transaction; treated as additive to the 29 GHF contacts (reading \\\"additional\\\"); possible overlap with the 11 contacted strategic buyers is unresolved (Q3).',\\n    why='Stated: two unnamed Class I railroads approached and the purpose; date inferred as by the 04/07/2016 Committee report (upper bound; Assigned: bound). Reading \\\"additional\\\" = beyond the GHF wave is preferred; overlap with the 11 strategic buyers not stated (flagged, Q3). Quote: \\\"Mr. Noreck reported that the Company had also approached two additional Class I railroads to determine their interest in a possible transaction.\\\" (P-007, p28)',\\n    source='P-007', count=2, dto=D(2016,4,7), wdate=D(2016,4,7), dbasis='Relative only',\\n    dmethod='Assigned: bound', page=28, related='R005; R010', review='Q3'))\\n\\nL.append(row(id='R010', when='04/07/2016', who='Transaction Committee', what='Target decision', round=1,\\n    terms='Committee discussed the process to date; authorized GHF to contact the five interested parties met at the 2016 Connections Convention (including G&W) plus other potential strategic buyers and NDA-holding private equity firms to confirm continuing interest; Party B\\\\u2019s introductory meeting followed on 04/21/2016.',\\n    why='Stated: meeting date, authorization scope and purpose; Date: Reported day. Quote: \\\"After discussion, the Transaction Committee authorized representatives of GHF, on behalf of the Company, to contact each of the five interested parties with whom management had met at the 2016 Connections Convention, as well as other potential strategic buyers (including certain Class I railroads) and private equity firms who had entered into confidentiality agreements with the Company to confirm their continuing interest.\\\" (P-007, p28)',\\n    source='P-007; P-008', wdate=D(2016,4,7), dbasis='Reported day', dmethod='Reported', page=28,\\n    related='R009; R011'))\\n\\nL.append(row(id='R011', when='on or before 04/27/2016; due 05/10/2016', who='Company / Board of Directors',\\n    what='Deadline set', round=1, count=None,\\n    terms='IOI due date: each potential buyer was advised to submit a non-binding indication of interest by 05/10/2016; superseded by the 05/19/2016 postponement (R012). Due date 05/10/2016; treatment Extended (moved by a revision before arrival).',\\n    why='Stated: the advice and the 05/10/2016 due date; advice date bounded by the 04/27/2016 Board discussion (Convention; Assigned: bound). Quote: \\\"each potential buyer had been advised to submit a non-binding indication of interest by May 10, 2016 (which deadline was subsequently postponed to May 19, 2016 to ensure the potential buyers had sufficient time to formulate their most compelling offers)\\\" (P-009, p29)',\\n    source='P-009; P-008', dto=D(2016,4,27), wdate=D(2016,4,27), dbasis='Relative only',\\n    dmethod='Assigned: bound', duedate=D(2016,5,10), dlteat='Extended', page=29,\\n    related='R012; R013', review='Q2'))\\n\\nL.append(row(id='R012', when='after 04/27/2016; due date changed 05/10/2016 \\\\u2192 05/19/2016', who='Company',\\n    what='Deadline revised', round=1,\\n    terms='IOI deadline postponed from 05/10/2016 to 05/19/2016 \\\"to ensure the potential buyers had sufficient time to formulate their most compelling offers\\\"; requester not disclosed; new due date 05/19/2016 (treatment Enforced).',\\n    why='Stated: old and new due dates and the purpose; no requester disclosed. Date: \\\"subsequently\\\" postponed \\\\u2014 bounded by the 04/27/2016 report and the 05/19/2016 new date; Working date is the window midpoint (Convention; Assigned: midpoint). Quote: as at R011 (P-009, p29).',\\n    source='P-009', dfrom=D(2016,4,28), dto=D(2016,5,19), wdate=D(2016,5,8),\\n    dbasis='Relative only', dmethod='Assigned: midpoint', duedate=D(2016,5,19), dlteat='Enforced',\\n    page=29, related='R011; R013', review='Q2'))\\n\\nL.append(row(id='R013', when='05/19/2016', who='Company', what='Deadline', round=1,\\n    terms='Scheduled IOI due date reached while operative; the target then considered the nine IOIs received 05/19\\\\u201306/01/2016 and moved to selection (06/01/2016) on the bids in hand \\\\u2014 no extension; treatment Enforced (no bid shown dated after the due date: the receipt window straddles it; Q2).',\\n    why='Stated: due date and what followed (nine IOIs; exclusion and advancement decision). Late-bid note: individual IOI dates are not disclosed and the receipt window straddles 05/19/2016, so no bid is treated as late (Convention). Quote: \\\"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest\\\" (P-010, p29)',\\n    source='P-010', wdate=D(2016,5,19), dbasis='Reported day', dmethod='Reported',\\n    duedate=D(2016,5,19), dlteat='Enforced', page=29, related='R011; R012; R014', review='Q2'))\\n\\nL.append(row(id='R014', when='05/19/2016 \\\\u2013 06/01/2016 (received)', who='Nine IOI submitters (cohort; unnamed)',\\n    what='Bid', round=1, type='Unknown', count=9, formality='Informal', conditions='Heavy',\\n    terms='Nine written non-binding indications of interest with prices of $17.93\\\\u2013$26.50 per share (assuming conversion of preferred stock into common stock), implying equity values of $90\\\\u2013$134 million; group envelope only, not attributed to members; two lowest later excluded (R018) and seven advanced (R017).',\\n    why='Stated: count, price range, equity-value range and share basis. Formality: Informal (Convention) \\\\u2014 non-binding indications to a non-binding solicitation; no markups reported at this stage. Conditions: Heavy by context (Convention) \\\\u2014 bids made before substantive diligence access (data-room and management access followed the 06/01/2016 advancement). Count 9 = submitting units; price cells hold the group envelope only. Date: due date inside the receipt window (Convention; Assigned: deadline). Quote: \\\"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest (\\\\u201cIOIs\\\\u201d) from potential buyers, with offer prices per share ranging from $17.93 to $26.50 (assuming the conversion of preferred stock into common stock), implying equity values of $90 million to $134 million.\\\" (P-010, p29)',\\n    source='P-010; P-009', plow=17.93, phigh=26.50, pkind='Group envelope', porigin='Stated',\\n    currency='USD', allcash='Not stated', conddetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n    dfrom=D(2016,5,19), dto=D(2016,6,1), wdate=D(2016,5,19), dbasis='Reported interval',\\n    dmethod='Assigned: deadline', page=29, related='R016; R018', review='Q3; Q4; Q6'))\\n\\nL.append(row(id='R015', when='by 05/19/2016 (no submission reported; day of non-submission not disclosed)',\\n    who='16 NDA signers (cohort; residual; unnamed)', what='Did not submit', round=1, type='Unknown', count=16,\\n    terms='Inferred: residual \\\\u2014 25 NDA signers \\\\u2212 9 IOI submitters = 16 non-submitters; eligible participants were advised to submit by 05/19/2016; the filing identifies the nine submitters and the seven advanced (R017) without these 16; base assumes the 25 wave signers were the eligible population at that date (Party C entered later; the two additional Class I railroads are treated as contacts, not entrants) \\\\u2014 see Q3.',\\n    why='Inferred: residual \\\\u2014 the 25-signer wave (P-005), the nine IOIs (P-010) and the seven continuing buyers (P-010) give 25 \\\\u2212 9 = 16. No decision date, motive or voluntary withdrawal is inferred; only that they did not submit by the due date. Working date = the solicitation due date (Convention; Assigned: deadline). Quotes: \\\"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements.\\\" (P-005, p28); \\\"the Transaction Committee concluded that the two low bidders should be excluded from that process. The Transaction Committee authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers\\\" (P-010, p29).',\\n    source='P-005; P-010', dto=D(2016,5,19), wdate=D(2016,5,19), dbasis='Relative only',\\n    dmethod='Assigned: deadline', decided='Unknown', exit='Not stated', obasis='Inferred: residual',\\n    page=29, related='R007; R008; R014; R016', review='Q3; Q5'))\\n\\nL.append(row(id='R016', when='by 05/19/2016 (Party A\\\\u2019s last reported appearance; day not disclosed)', who='Party A',\\n    what='Did not submit', round=1, type='Strategic', count=0,\\n    terms='Inferred: identity \\\\u2014 Party A appears individually only through the opening wave and the memorandum distribution (P-008) and is never mentioned again; recommended reading: already counted within the 16 non-submitting NDA signers (R015, Did not submit 05/19/2016); alternative: within the nine IOI submitters (R014). No count is moved from the cohort (Count 0); see Q3.',\\n    why='Inferred: identity \\\\u2014 covering rows and arithmetic as above; the filing gives no individual outcome for Party A. Working date set at the same transition as the covering cohort (Convention; Assigned: deadline). Quote: \\\"With the assistance of GHF, the Company prepared a memorandum concerning the Company and its prospects, which was distributed to the potential buyers, including Party A, Party B and G&W, that had executed confidentiality agreements.\\\" (P-008, p28)',\\n    source='P-008; P-005; P-010', dto=D(2016,5,19), wdate=D(2016,5,19), dbasis='Relative only',\\n    dmethod='Assigned: deadline', decided='Unknown', exit='Not stated', obasis='Inferred: identity',\\n    page=28, related='R001; R015', review='Q3; Q5'))\\n\\nL.append(row(id='R017', when='05/23/2016 \\\\u2013 06/01/2016 (decision concluded at the 06/01/2016 meeting)',\\n    who='Transaction Committee', what='Target decision', round=1,\\n    terms='Committee considered the nine IOIs; excluded the two low bidders (R018) and authorized in-person management presentations for the remaining seven, permitting additional due diligence with access to an internet data site (access alike for the advancing set); over June\\\\u2013July each advancing buyer and its advisers conducted diligence, including management meetings.',\\n    why='Stated: decision, rationale, meetings of 05/23 and 06/01/2016, access given alike. Date: decision concluded at the later meeting (Convention; Assigned: decision day). Quote: \\\"In view of the substantial amount of management time that would be required for management presentations, the Transaction Committee concluded that the two low bidders should be excluded from that process. The Transaction Committee authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers and allow these parties to conduct additional due diligence.\\\" (P-010, p29)',\\n    source='P-010; P-013', dfrom=D(2016,5,23), dto=D(2016,6,1), wdate=D(2016,6,1),\\n    dbasis='Reported interval', dmethod='Assigned: decision day', page=29, related='R014; R018', review='Q1'))\\n\\nL.append(row(id='R018', when='06/01/2016', who='Two low bidders (unnamed IOI submitters)', what='Dropped by target',\\n    round=1, type='Unknown', count=2,\\n    terms='Excluded from the management-presentation process as the two lowest IOI bidders; identities and prices not disclosed (within the R014 envelope); denied the management-presentation and data-room stage.',\\n    why='Stated: exclusion, count (2) and rationale; Inferred: identities (unnamed). Decided by Target; Exit reason: Lower offer than rivals. Date: concluded at the later 06/01/2016 meeting (Convention; Assigned: decision day). Quote: \\\"the Transaction Committee concluded that the two low bidders should be excluded from that process\\\" (P-010, p29)',\\n    source='P-010', dfrom=D(2016,5,23), dto=D(2016,6,1), wdate=D(2016,6,1), dbasis='Reported interval',\\n    dmethod='Assigned: decision day', decided='Target', exit='Lower offer than rivals', obasis='Stated',\\n    page=29, related='R014; R017', review='Q5'))\\n\\nL.append(row(id='R019', when='mid-June 2016 (drafts posted 06/29, 06/30 and 07/11/2016); due 07/20/2016',\\n    who='Company / GHF', what='Round opened', round=2,\\n    terms='R2 opens: Committee-directed instruction to all potential buyers to submit non-binding LOIs by 07/20/2016 together with mark-ups of the merger agreement, disclosure letter and voting agreement (initial drafts posted to the data site 06/29, 06/30 and 07/11/2016); buyers to value 100% of the outstanding common stock on a per-share basis (assuming preferred conversion) or give non-cash terms. Round finality: Not final (non-binding LOI stage).',\\n    why='Stated: instruction, deadline, required mark-ups, postings and valuation basis. Date: \\\"mid-June 2016\\\" (Convention: 11\\\\u201319 band, midpoint 06/15/2016 as sort key; Assigned: midpoint). Round finality: Not final \\\\u2014 no announcement and no definitive-negotiation move yet (Convention). Quote: \\\"In mid-June 2016, at the direction of the Transaction Committee, representatives of GHF instructed all potential buyers to submit non-binding letters of intent (\\\\u201cLOIs\\\\u201d) by July 20, 2016, together with mark-ups of the forms of merger agreement, disclosure letter and voting agreement\\\" (P-011, p29)',\\n    source='P-011; P-012', dfrom=D(2016,6,11), dto=D(2016,6,19), wdate=D(2016,6,15),\\n    dbasis='Approximate window', dmethod='Assigned: midpoint', duedate=D(2016,7,20), finality='Not final',\\n    page=29, related='R006; R034', review='Q1'))\\n\\nL.append(row(id='R020', when='early July 2016 (day not disclosed)', who='Party C (strategic buyer; late entrant)',\\n    what='Bidder interest', round=2, type='Strategic', count=1,\\n    terms='Party C approached Company management and expressed interest in acquiring the Company; not previously part of the process; bidder-initiated first contact; led to an NDA and catch-up access (R021, R023) and an IOI (R022).',\\n    why='Stated: approach, acquisition interest and late-entrant status. Count 1 = newly represented individual (contact tally). Date: \\\"early July 2016\\\" (Convention: 1\\\\u201310 band, midpoint 07/05/2016 as sort key; Assigned: midpoint). Quote: \\\"In early July 2016, a potential strategic buyer that had not previously been part of the process (\\\\u201cParty C\\\\u201d) approached the Company\\\\u2019s management and expressed interest in acquiring the Company.\\\" (P-013, p29)',\\n    source='P-013', dfrom=D(2016,7,1), dto=D(2016,7,10), wdate=D(2016,7,5),\\n    dbasis='Approximate window', dmethod='Assigned: midpoint', page=29, related='R021; R022', review='Q7'))\\n\\nL.append(row(id='R021', when='early July 2016 (after the approach; before 07/12/2016)', who='Party C',\\n    what='NDA signed', round=2, type='Strategic', count=1,\\n    terms='Executed a confidentiality agreement, then was provided the memorandum given to the other potential buyers; late entrant tracked separately from the 25 opening-wave signers (Q3).',\\n    why='Stated: NDA execution and memorandum; no day disclosed. Date: bounded by the early-July approach and the 07/12/2016 IOI; Working date is the window midpoint (Convention; Assigned: midpoint). Count 1 = new signer. Quote: \\\"After executing a confidentiality agreement, Party C was provided the memorandum concerning the Company provided to the other potential buyers.\\\" (P-013, p29)',\\n    source='P-013', dfrom=D(2016,7,1), dto=D(2016,7,12), wdate=D(2016,7,6),\\n    dbasis='Approximate window', dmethod='Assigned: midpoint', page=29, related='R020; R023', review='Q3; Q7'))\\n\\nL.append(row(id='R022', when='07/12/2016', who='Party C', what='Bid', round=2, type='Strategic', count=1,\\n    formality='Informal', conditions='Heavy',\\n    terms='IOI to acquire the Company at $21.00 per share (implying an equity value of $108 million); later revised in its LOI (R028); count 1 = Party C\\\\u2019s first R2 submission.',\\n    why='Stated: date, price and implied equity value. Formality: Informal (Convention) \\\\u2014 non-binding IOI; no markups reported. Conditions: Heavy by context (Convention) \\\\u2014 bid made before data-room or management access (access followed, R023). Date: Reported day. Quote: \\\"On July 12, 2016, Party C submitted an IOI with an offer price per share of $21.00 (implying an equity value of $108 million).\\\" (P-013, p29)',\\n    source='P-013', plow=21.00, phigh=21.00, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n    wdate=D(2016,7,12), dbasis='Reported day', dmethod='Reported', page=29,\\n    related='R021; R023; R028', review='Q4'))\\n\\nL.append(row(id='R023', when='after 07/12/2016; presentation 07/14/2016', who='Party C', what='Information access changed',\\n    round=2, type='Strategic',\\n    terms='Late-entrant catch-up access: after its IOI, Party C was provided access to the internet data site used by the other advancing buyers and a telephone management presentation on 07/14/2016; access compressed into the LOI window relative to the others\\\\u2019 June\\\\u2013July access; Count blank (access decision).',\\n    why='Stated: data-site access and the 07/14/2016 presentation, explicitly \\\"Subsequently\\\" to the IOI;\\\\u00a0Inferred: difference in access timing among live participants (late entrant). Working date = the stated presentation day as the upper bound (Assigned: bound). Quote: \\\"Subsequently, Party C was provided access to the internet data site and the Company\\\\u2019s management held a management presentation with Party C by telephone on July 14, 2016.\\\" (P-013, p29)',\\n    source='P-013', dfrom=D(2016,7,13), dto=D(2016,7,14), wdate=D(2016,7,14), dbasis='Relative only',\\n    dmethod='Assigned: bound', page=29, related='R020; R021', review='Q7'))\\n\\nL.append(row(id='R024', when='07/20/2016', who='Company', what='Deadline', round=2,\\n    terms='Scheduled LOI due date reached; six LOIs received in late July 2016 and considered; one (G&W) dated 07/21/2016 after the due date, with no revision of the deadline \\\\u2014 treatment: Late bids accepted.',\\n    why='Stated: due date; receipt of six LOIs and G&W\\\\u2019s 07/21/2016 date. Late-bid test: G&W\\\\u2019s date falls after the due date and the target considered it without a revision \\\\u2014 Late bids accepted; the other five LOIs are undated and no extension is recorded (Convention). Quotes: \\\"In late July 2016, the Company received six LOIs with offer prices per share ranging from $19.20 to $24.00\\\" (P-014, p29); \\\"G&W submitted an LOI on July 21, 2016\\\" (P-016, p29).',\\n    source='P-014; P-016', wdate=D(2016,7,20), dbasis='Reported day', dmethod='Reported',\\n    duedate=D(2016,7,20), dlteat='Late bids accepted', page=29, related='R019; R032; R033', review='Q2'))\\n\\nL.append(row(id='R025', when='by 07/20/2016 (late July; day not disclosed)', who='Party B', what='Bid', round=2,\\n    type='Strategic', count=1, formality='Formal', conditions='Light',\\n    terms='LOI to acquire the Company at $24.00 per share, subject to an expedited diligence review; provided mark-ups of the merger agreement and voting agreement; highest-priced offer at the LOI stage; advanced to confirmatory diligence with G&W (R034).',\\n    why='Stated: price, diligence condition and markups. Formality: Formal \\\\u2014 signal 1, bidder-returned acquisition-agreement markups. Conditions: Light \\\\u2014 no Heavy trigger: expedited diligence review only; financing not addressed. Date: due date inside the \\\"late July\\\" receipt window (Convention; Assigned: deadline). Quotes: \\\"Party B submitted an LOI to acquire the Company for a price of $24.00 per share (subject to an expedited diligence review).\\\" (P-015, p29); \\\"Party B, G&W and another bidder (\\\\u201cParty D\\\\u201d) also provided mark-ups of the draft merger agreement and voting agreement.\\\" (P-014, p29)',\\n    source='P-015; P-014', plow=24.00, phigh=24.00, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: confirmatory; DD open: yes; Excl: none',\\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\\n    dmethod='Assigned: deadline', page=29, related='R034; R051', review='Q4'))\\n\\nL.append(row(id='R026', when='by 07/20/2016 (late July; day not disclosed)', who='Party E', what='Bid', round=2,\\n    type='Strategic', count=1, formality='Informal', conditions='Heavy',\\n    terms='LOI at $21.26 per share, subject to a 60-day exclusivity period for due diligence and negotiation of definitive documentation; provided a summary of material issues and proposed changes to the merger agreement and voting agreement (an issues list, not a returned markup \\\\u2014 borderline formality, Q4).',\\n    why='Stated: price, exclusivity period and the issues list. Formality: Informal \\\\u2014 working default for an issues list without another formal signal; flagged as borderline (Q4). Conditions: Heavy \\\\u2014 stated 60-day exclusive diligence period. Date: Assigned: deadline (Convention). Quotes: \\\"Party E (a strategic buyer) submitted an LOI to acquire the Company for a price of $21.26 per share (subject to a 60-day exclusivity period for due diligence and negotiation of definitive documentation).\\\" (P-017, p30); \\\"One bidder (\\\\u201cParty E\\\\u201d) provided a summary of material issues and proposed changes to the merger agreement and voting agreement with respect to those issues.\\\" (P-014, p29)',\\n    source='P-017; P-014', plow=21.26, phigh=21.26, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (60 days); DD open: yes; Excl: requested (60 days)',\\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\\n    dmethod='Assigned: deadline', page=30, related='R041; R042; R043', review='Q4'))\\n\\nL.append(row(id='R027', when='by 07/20/2016 (late July; day not disclosed)', who='Party D', what='Bid', round=2,\\n    type='Financial', count=1, formality='Formal', conditions='Heavy',\\n    terms='LOI at $21.00 per share, subject to a four-week diligence period; provided mark-ups of the merger agreement and voting agreement.',\\n    why='Stated: price, diligence period and markups. Formality: Formal \\\\u2014 signal 1, bidder-returned acquisition-agreement markups. Conditions: Heavy \\\\u2014 stated four-week diligence period. Date: Assigned: deadline (Convention). Quotes: \\\"Party D (a financial buyer) submitted an LOI to acquire the Company for a price of $21.00 per share (subject to a four-week diligence period).\\\" (P-018, p30); \\\"Party B, G&W and another bidder (\\\\u201cParty D\\\\u201d) also provided mark-ups of the draft merger agreement and voting agreement.\\\" (P-014, p29)',\\n    source='P-018; P-014', plow=21.00, phigh=21.00, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (4 wks); DD open: yes; Excl: none',\\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\\n    dmethod='Assigned: deadline', page=30, related='R036; R040', review='Q4'))\\n\\nL.append(row(id='R028', when='by 07/20/2016 (late July; day not disclosed)', who='Party C', what='Bid', round=2,\\n    type='Strategic', count=0, formality='Informal', conditions='Heavy',\\n    terms='LOI at $19.30 per share, subject to a 30-day diligence period; lower than its $21.00 IOI (R022); no markup or formal signal reported. Count 0 \\\\u2014 Party C\\\\u2019s R2 bidder count is carried on R022.',\\n    why='Stated: price and diligence period. Formality: Informal (Convention) \\\\u2014 no markup or other formal signal reported. Conditions: Heavy \\\\u2014 stated 30-day diligence period. Count 0 (same bidder, later row in R2; covering row R022). Date: Assigned: deadline (Convention). Quote: \\\"Party C submitted an LOI to acquire the Company for a price of $19.30 per share (subject to a 30-day diligence period).\\\" (P-019, p30)',\\n    source='P-019', plow=19.30, phigh=19.30, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\\n    dmethod='Assigned: deadline', page=30, related='R022; R035', review='Q4'))\\n\\nL.append(row(id='R029', when='by 07/20/2016 (late July; day not disclosed)', who='Party F', what='Bid', round=2,\\n    type='Strategic', count=1, formality='Informal', conditions='Heavy',\\n    terms='LOI at $19.20 per share, subject to a 30-day due diligence period; no markup or other formal signal reported.',\\n    why='Stated: price and diligence period. Formality: Informal (Convention) \\\\u2014 no markup or other formal signal reported. Conditions: Heavy \\\\u2014 stated 30-day due diligence period. Date: Assigned: deadline (Convention). Quote: \\\"Party F (a strategic buyer) submitted an LOI to acquire the Company for a price of $19.20 per share (subject to a 30-day due diligence period).\\\" (P-020, p30)',\\n    source='P-020', plow=19.20, phigh=19.20, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\\n    dfrom=D(2016,7,20), dto=D(2016,7,31), wdate=D(2016,7,20), dbasis='Approximate window',\\n    dmethod='Assigned: deadline', page=30, related='R038; R042', review='Q4'))\\n\\nL.append(row(id='R030', when='by 07/20/2016 (day of election not disclosed)', who='Unnamed strategic bidder (LOI non-submitter)',\\n    what='Did not submit', round=2, type='Strategic', count=1,\\n    terms='Elected not to submit an LOI in the 07/20/2016 solicitation while in the process at that stage; identity not disclosed; may overlap other unnamed cohorts (Q3).',\\n    why='Stated: the election and the type split (one strategic, one financial). Date: solicitation due date (Convention; Assigned: deadline). Decided by Bidder; Exit reason: Not stated. Quote: \\\"One strategic buyer and one financial buyer elected not to submit an LOI.\\\" (P-021, p30)',\\n    source='P-021', dto=D(2016,7,20), wdate=D(2016,7,20), dbasis='Relative only',\\n    dmethod='Assigned: deadline', decided='Bidder', exit='Not stated', obasis='Stated', page=30,\\n    related='R031; R015', review='Q3'))\\n\\nL.append(row(id='R031', when='by 07/20/2016 (day of election not disclosed)', who='Unnamed financial bidder (LOI non-submitter)',\\n    what='Did not submit', round=2, type='Financial', count=1,\\n    terms='Elected not to submit an LOI in the 07/20/2016 solicitation while in the process at that stage; identity not disclosed; may overlap other unnamed cohorts (Q3).',\\n    why='Stated: the election and the type split. Date: solicitation due date (Convention; Assigned: deadline). Decided by Bidder; Exit reason: Not stated. Quote: as at R030 (P-021, p30).',\\n    source='P-021', dto=D(2016,7,20), wdate=D(2016,7,20), dbasis='Relative only',\\n    dmethod='Assigned: deadline', decided='Bidder', exit='Not stated', obasis='Stated', page=30,\\n    related='R030; R015', review='Q3'))\\n\\nL.append(row(id='R032', when='07/21/2016', who='G&W', what='Bid', round=2, type='Strategic', count=1,\\n    formality='Formal', conditions='Heavy',\\n    terms='LOI at $21.15 per share = $20.02 cash at closing + $1.13 CVR (contingent value right based on the subsequent sale of the South Quay property); subject to a three-week exclusive diligence period; provided a markup of the disclosure letter and (with its LOIs) mark-ups of the merger agreement and voting agreement; revised 07/26/2016 (R033).',\\n    why='Stated: date, price split, CVR basis, diligence/exclusivity condition and markups. Formality: Formal \\\\u2014 signal 1, returned acquisition-agreement and voting-agreement markups. Conditions: Heavy \\\\u2014 stated three-week exclusive diligence period. Date: Reported day. Quote: \\\"G&W submitted an LOI on July 21, 2016 to acquire the Company for a price of $21.15 per share (subject to a three-week exclusive diligence period). The price included $20.02 cash at closing and $1.13 in the form of a contingent value right, the value of which was based on the subsequent sale of the Company\\\\u2019s South Quay property (\\\\u201cCVR\\\\u201d).\\\" (P-016, p29)',\\n    source='P-016; P-014', plow=21.15, phigh=21.15, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Yes', cashclose=20.02, conddetail='Fin: not stated; DD required: substantive (3 wks); DD open: yes; Excl: requested (3 wks)',\\n    wdate=D(2016,7,21), dbasis='Reported day', dmethod='Reported', page=29,\\n    related='R033; R034; R049', review='Q4; Q6'))\\n\\nL.append(row(id='R033', when='07/26/2016', who='G&W', what='Bid', round=2, type='Strategic', count=0,\\n    formality='Formal', conditions='Heavy',\\n    terms='Revised LOI at $22.15 per share = $21.02 cash at closing + $1.13 CVR (unchanged), after GHF feedback that the price and CVR structure were not competitive. Count 0 \\\\u2014 second R2 submission by G&W; R032 carries its R2 bidder count.',\\n    why='Stated: date, revised price split and the reason for the revision. Formality: Formal (carried forward from R032). Conditions: Heavy \\\\u2014 the three-week exclusive diligence period carries with the revision (no change reported). Count 0 (covering row R032). Date: Reported day. Quote: \\\"On July 26, 2016, in response to feedback from representatives of GHF indicating its price and CVR structure were not competitive, G&W submitted a revised LOI, which increased its offer to $22.15 per share (including $21.02 in cash and $1.13 CVR).\\\" (P-016, p29)',\\n    source='P-016', plow=22.15, phigh=22.15, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Yes', cashclose=21.02, conddetail='Fin: not stated; DD required: substantive (3 wks); DD open: yes; Excl: requested (3 wks)',\\n    wdate=D(2016,7,26), dbasis='Reported day', dmethod='Reported', page=29,\\n    related='R032; R049', review='Q4; Q6'))\\n\\nL.append(row(id='R034', when='07/27/2016', who='Transaction Committee', what='Round opened', round=3,\\n    terms='R3 opens: the Committee concluded to proceed with confirmatory due diligence and negotiations with G&W and Party B because of their higher offers relative to the other potential buyers; remaining bidders informed they were no longer involved (R035\\\\u2013R038); on-site financial, legal and environmental diligence and hi-rail inspections by both finalists 07/27\\\\u201308/11/2016 (access alike for the advancing set). Round finality: Inferred final (moved to definitive negotiation with selected bidders).',\\n    why='Stated: the conclusion, rationale, notice to remaining bidders and the diligence period. Round finality: Inferred final \\\\u2014 no final/binding-stage announcement, but the target moved to definitive negotiation with selected bidders (Convention). Date: Reported day. Quote: \\\"The Transaction Committee concluded that the Company should proceed with confirmatory due diligence and negotiations with G&W and Party B because of the higher offers made by each of G&W and Party B relative to the other potential buyers.\\\" (P-022, p30)',\\n    source='P-022; P-025', wdate=D(2016,7,27), dbasis='Reported day', dmethod='Reported', finality='Inferred final',\\n    page=30, related='R019; R035; R036; R037; R038; R048', review='Q1'))\\n\\nfor rid, who, offer, rel in [\\n    ('R035', 'Party C', '$19.30', 'R028'),\\n    ('R036', 'Party D', '$21.00', 'R027; R039'),\\n    ('R037', 'Party E', '$21.26', 'R026; R041'),\\n    ('R038', 'Party F', '$19.20', 'R029; R042')]:\\n    L.append(row(id=rid, when='07/27/2016 (notice day not disclosed; reported as \\\"subsequently\\\")', who=who,\\n        what='Dropped by target', round=2, type=('Financial' if rid == 'R036' else 'Strategic'), count=1,\\n        terms=f'Told no longer involved after the decision to proceed with G&W and Party B; offered {offer} at the LOI stage versus the finalists\\\\u2019 $24.00 and $22.15; denied the confirmatory and definitive stage (R3).',\\n        why=f'Stated: notice to the remaining bidders and the exit; Inferred: the individual recipient (named non-finalist LOI submitter). Decided by Target; Exit reason: Lower offer than rivals. Date: the decision day (Convention; Assigned: decision day); the notice was given \\\"subsequently\\\". Quote: \\\"At the direction of the Transaction Committee, representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process.\\\" (P-022, p30)',\\n        source='P-022', dfrom=D(2016,7,27), wdate=D(2016,7,27), dbasis='Relative only',\\n        dmethod='Assigned: decision day', decided='Target', exit='Lower offer than rivals', obasis='Stated',\\n        page=30, related=rel, review='Q5'))\\n\\nL.append(row(id='R039', when='08/01/2016', who='Party D', what='Re-entered', round=3, type='Financial', count=1,\\n    terms='Renewed participation after its 07/27/2016 exclusion: D and E expressed interest in re-engaging on GHF\\\\u2019s 07/29/2016 calls and D submitted a revised LOI on 08/01/2016 (R040) \\\\u2014 actual renewed activity, not a mere request.',\\n    why='Stated: the calls, renewed interest and the revised LOI; the re-entry day is the dated renewed activity. Date: Reported day. Quote: \\\"On July 29, 2016, representatives of GHF had calls with Party D and Party E. During those calls, Party D and Party E both expressed interest in reengaging and enhancing their offers.\\\" (P-023, p30)',\\n    source='P-023', wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\\n    related='R036; R040', review='Q5'))\\n\\nL.append(row(id='R040', when='08/01/2016', who='Party D', what='Bid', round=3, type='Financial', count=1,\\n    formality='Formal', conditions='Heavy',\\n    terms='Revised LOI at $24.00 per share (up from $21.00, R027), subject to a 30-day due diligence period; D asked the Company not to enter an agreement with another bidder during that period; the Company declined; D then indicated it would not proceed with further diligence at that time (R044).',\\n    why='Stated: price, 30-day diligence condition, requested no-signing commitment, the Company\\\\u2019s refusal and D\\\\u2019s response. Formality: Formal (carried forward \\\\u2014 markups at the LOI stage). Conditions: Heavy \\\\u2014 30-day diligence period; the requested no-signing commitment is recorded under Excl. Date: Reported day. Quotes: \\\"Party D submitted a revised LOI at a price of $24.00 per share\\\" (P-023, p30); \\\"Party D declined to shorten its due diligence period and requested that the Company commit that it would not enter into an agreement with another bidder during its 30-day due diligence period\\\" (P-023, p30).',\\n    source='P-023; P-025', plow=24.00, phigh=24.00, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (4 wks); DD open: yes; Excl: requested (4 wks)',\\n    wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\\n    related='R027; R039; R044; R046', review='Q4; Q5'))\\n\\nL.append(row(id='R041', when='08/01/2016', who='Party E', what='Re-entered', round=3, type='Strategic', count=1,\\n    terms='Renewed participation after its 07/27/2016 exclusion: E expressed interest in re-engaging on GHF\\\\u2019s 07/29/2016 calls and submitted a revised LOI on 08/01/2016 (R042) \\\\u2014 actual renewed activity, not a mere request.',\\n    why='Stated: the calls, renewed interest and the revised LOI; the re-entry day is the dated renewed activity. Date: Reported day. Quote: as at R039 (P-023, p30).',\\n    source='P-023', wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\\n    related='R037; R042', review='Q5'))\\n\\nL.append(row(id='R042', when='08/01/2016', who='Party E', what='Bid', round=3, type='Strategic', count=1,\\n    formality='Informal', conditions='Heavy',\\n    terms='Support: Party F (financing) \\\\u2014 revised LOI at $23.81 per share with financing support from Party F, subject to a 30-day due diligence period; F\\\\u2019s independent participation had ended on 07/27/2016 (R038), so F gets no new row and no re-entry; F\\\\u2019s earlier bid: R029.',\\n    why='Stated: price, F\\\\u2019s financing support and the 30-day diligence period. Formality: Informal (issues-list history; no markups). Conditions: Heavy \\\\u2014 30-day diligence period. Support: financing support does not establish joint bidding (Convention) and the supporter had already exited, so it gets no new row (Convention). Date: Reported day. Quote: \\\"Party E submitted a revised LOI, along with financing support, from Party F, at a price of $23.81 per share. Both revised proposals contained a 30-day due diligence period.\\\" (P-023, p30)',\\n    source='P-023', plow=23.81, phigh=23.81, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (30 days); DD open: yes; Excl: not stated',\\n    wdate=D(2016,8,1), dbasis='Reported day', dmethod='Reported', page=30,\\n    related='R026; R038; R041; R043', review='Q4; Q5'))\\n\\nL.append(row(id='R043', when='08/02/2016', who='Party E', what='Bid reaffirmed', round=3, type='Strategic',\\n    count=0, formality='Informal', conditions='Heavy',\\n    terms='Reaffirmed by: price confirmed \\\\u2014 withdrew its revised $23.81 proposal and confirmed its original proposal of $21.26 per share; the original terms (60-day exclusive diligence and negotiation period) carried forward; the revised proposal stands withdrawn.',\\n    why='Stated: withdrawal of the revision and confirmation of the original price. Formality: Informal (carried from R026). Conditions: Heavy \\\\u2014 the confirmed original 60-day exclusive diligence and negotiation period. Price: carried forward from R026 (Convention). Count 0 \\\\u2014 no new unit; E\\\\u2019s R3 count is on R042. Date: Reported day. Quote: \\\"Party E withdrew its revised proposal on August 2, 2016 (but confirmed its original proposal of $21.26 per share)\\\" (P-023, p30)',\\n    source='P-023', plow=21.26, phigh=21.26, pkind='Point', porigin='Carried forward', currency='USD',\\n    allcash='Not stated', conddetail='Fin: not stated; DD required: substantive (60 days); DD open: not disclosed; Excl: requested (60 days)',\\n    wdate=D(2016,8,2), dbasis='Reported day', dmethod='Reported', page=30,\\n    related='R026; R042; R047', review='Q4; Q5'))\\n\\nL.append(row(id='R044', when='08/02/2016 (day inferred; reported with the 08/02/2016 events)',\\n    who='Party D', what='Participation paused', round=3, type='Financial', count=1,\\n    terms='D declined to shorten its 30-day diligence period and asked the Company not to sign with another bidder during it; the Company declined; D indicated it would not proceed with further due diligence \\\"at that time\\\" \\\\u2014 D\\\\u2019s own stated temporary stop, not a withdrawal; D remains live (closed at R046).',\\n    why='Stated: the exchange and D\\\\u2019s own statement; Inferred: the day (reported with the 08/02/2016 withdrawal of E\\\\u2019s revised proposal and after the 08/01/2016 Committee meeting; no day stated) \\\\u2014 Inferred day. Decided by Bidder; Exit reason: Terms or process (the no-signing commitment D requested was not obtained). A pause does not close a participant (Convention). Quote: \\\"at which point Party D indicated that it would not proceed with further due diligence at that time\\\" (P-023, p30)',\\n    source='P-023', dfrom=D(2016,8,2), dto=D(2016,8,2), wdate=D(2016,8,2), dbasis='Inferred day',\\n    dmethod='Inferred', decided='Bidder', exit='Terms or process', obasis='Stated', page=30,\\n    related='R040; R046', review='Q5'))\\n\\nL.append(row(id='R045', when='08/04/2016', who='Transaction Committee', what='Target decision', round=3,\\n    terms='Committee directed continued diligence and negotiations with both G&W and Party B, but to prioritize Party B and complete the merger agreement with it, given Party B\\\\u2019s higher price; D and E are not in the continuing set (closes R046, R047).',\\n    why='Stated: the direction and rationale. Date: Reported day. Quote: \\\"During that discussion, the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B, but given the higher price offered by Party B, to prioritize Party B and proceed to complete the negotiation of the merger agreement with Party B.\\\" (P-025, p31)',\\n    source='P-025', wdate=D(2016,8,4), dbasis='Reported day', dmethod='Reported', page=31,\\n    related='R034; R046; R047'))\\n\\nfor rid, who, rel in [('R046', 'Party D', 'R044; R045'), ('R047', 'Party E', 'R043; R045')]:\\n    L.append(row(id=rid, when='by 08/04/2016', who=who, what='Dropped by target', round=3,\\n        type=('Financial' if rid == 'R046' else 'Strategic'), count=1,\\n        terms=f'Inferred: residual \\\\u2014 the 08/04/2016 decision names the continuing set (G&W and Party B) without {who.split()[-1]} and reports no notice to it; {who.split()[-1]} was out by this transition; the row does not say how or why.',\\n        why=f'Inferred: residual \\\\u2014 continuing set named at R045; {who.split()[-1]}\\\\u2019s last appearance is {\\\"the pause\\\" if rid == \\\"R046\\\" else \\\"the withdrawn revision and price confirmation\\\"} (P-023). Count 1. Decided by Target; Exit reason: Not stated; Working date = the decision day (Convention; Assigned: decision day). Quotes: \\\"the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B\\\" (P-025, p31); \\\"at which point Party D indicated that it would not proceed with further due diligence at that time\\\" (P-023, p30).',\\n        source='P-025; P-023', dto=D(2016,8,4), wdate=D(2016,8,4), dbasis='Relative only',\\n        dmethod='Assigned: decision day', decided='Target', exit='Not stated', obasis='Inferred: residual',\\n        page=31, related=rel, review='Q5'))\\n\\nL.append(row(id='R048', when='08/09/2016', who='Transaction Committee', what='Target decision', round=3,\\n    terms='Directed BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder (Party B); G&W requested and was granted continued due diligence, including physical diligence on 08/10\\\\u201308/11/2016, to potentially facilitate an improved offer.',\\n    why='Stated: direction, request and grant; the intended counterparty was Party B (R045, R050). Date: Reported day. Quote: \\\"Following that discussion, the Transaction Committee directed representatives of BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder. G&W requested that it be allowed to continue its due diligence, including physical due diligence on August 10 and August 11, 2016, to potentially facilitate an improved offer, which request was granted.\\\" (P-026, p31)',\\n    source='P-026; P-025', wdate=D(2016,8,9), dbasis='Reported day', dmethod='Reported', page=31,\\n    related='R045; R049'))\\n\\nL.append(row(id='R049', when='08/12/2016 (offer stated to expire 6:00 p.m. on 08/13/2016)', who='G&W',\\n    what='Bid', round=3, type='Strategic', count=1, formality='Formal', conditions='Light',\\n    terms='Revised LOI at $25.00 per share in cash, excluding the previously proposed CVR, with mark-ups of the merger agreement and voting agreement; submitted the morning of 08/12/2016 after G&W completed physical diligence (08/11/2016); offer stated to expire at 6:00 p.m. on 08/13/2016.',\\n    why='Stated: price, cash form, CVR exclusion, markups, submission morning and expiry. Formality: Formal \\\\u2014 signal 1 (returned acquisition-agreement and voting-agreement markups; second return). Conditions: Light \\\\u2014 no Heavy trigger reported: diligence completed 08/11/2016; the executed agreement contains no financing condition and G&W represented its financial wherewithal (X-007, p34). Date: Reported day. Quote: \\\"G&W submitted a revised LOI to acquire the Company for a price of $25.00 per share in cash, which excluded the previously proposed CVR, together with mark-ups of the merger agreement and the voting agreement. G&W\\\\u2019s LOI further indicated that the offer would expire at 6:00 p.m. on the following day.\\\" (P-027, p31)',\\n    source='P-027; X-007', plow=25.00, phigh=25.00, pkind='Point', porigin='Stated', currency='USD',\\n    allcash='Yes', cashclose=25.00, conddetail='Fin: not stated; DD required: none; DD open: no; Excl: none',\\n    wdate=D(2016,8,12), dbasis='Reported day', dmethod='Reported', page=31,\\n    related='R032; R033; R048; R050', review='Q4; Q6'))\\n\\nL.append(row(id='R050', when='08/12/2016', who='Company and G&W (with the Eder Trusts)', what='Merger agreement signed',\\n    round=3,\\n    terms='Executed merger agreement (G&W, Pullman Acquisition Sub Inc., the Company): agreed consideration $25.00 cash per common share, without interest; preferred deemed converted 100-for-1 plus accrued and unpaid dividends before the $25.00; no financing condition and G&W representation as to financial wherewithal; termination fee $3,785,000 (approximately 3% of transaction value); outside date 12/31/2016 (02/28/2017 if STB approval is the only unsatisfied condition); non-solicitation with fiduciary out and 3-business-day matching right; no go-shop; G&W to seek STB approval or exemption and to use a voting trust if needed; voting agreement executed with the Eder Trusts (842,742 common; 500 preferred; approximately 17.3% and 78.1%).',\\n    why='Stated: execution, agreed price, conversion mechanics, no financing condition, termination fee, outside dates, no go-shop; signing records agreed consideration only \\\\u2014 no bid-price, formality or conditions cells (Convention). Date: Reported day. Quotes: \\\"The Company and G&W executed the merger agreement, and the Company, G&W and the Eder Trusts executed the voting agreement.\\\" (P-032, p32); \\\"the absence of a financing condition in the merger agreement and the representation of G&W in the merger agreement as to its financial wherewithal\\\" (X-007, p34).',\\n    source='P-032; X-007; X-013; X-014; X-016; X-017; X-020', wdate=D(2016,8,12), dbasis='Reported day',\\n    dmethod='Reported', page=32, related='R049; R051', review='Q6'))\\n\\nL.append(row(id='R051', when='08/12/2016', who='Party B', what='Not selected at signing', round=3,\\n    type='Strategic', count=1,\\n    terms='Asked at the Board\\\\u2019s request whether it would increase its $24.00 offer; declined; the Board then determined the G&W offer was the superior proposal and signed with G&W \\\\u2014 B was still bidding when the target chose another, so no earlier exit is inferred (Stated).',\\n    why='Stated: the inquiry, B\\\\u2019s refusal to improve and the Board\\\\u2019s determination. Decided by Target; Exit reason: Would not improve earlier offer (a bidder asked to improve that declines, even though the target then chose a rival). Date: Reported day. Quotes: \\\"At the request of the Board, representatives of BMO then contacted Party B to determine if it would increase its offer price. Party B indicated that it would not increase its price.\\\" (P-030, p32); \\\"The Board determined that the G&W offer represented the superior proposal.\\\" (P-031, p32)',\\n    source='P-030; P-031', wdate=D(2016,8,12), dbasis='Reported day', dmethod='Reported',\\n    decided='Target', exit='Would not improve earlier offer', obasis='Stated', page=32,\\n    related='R025; R050', review='Q5'))\\n\\nL.append(row(id='R052', when='08/15/2016', who='Providence and Worcester Railroad Company',\\n    what='Merger announced', round=3,\\n    terms='PWRR issued a press release publicly announcing the transaction before the opening of NASDAQ trading on Monday 08/15/2016.',\\n    why='Stated: issuer, medium, date and timing. Date: Reported day. Quote: \\\"The Company issued a press release publicly announcing the transaction on Monday, August 15, 2016 prior to the opening of trading of the Company\\\\u2019s common stock on the NASDAQ.\\\" (P-032, p32)',\\n    source='P-032', wdate=D(2016,8,15), dbasis='Reported day', dmethod='Reported', page=32,\\n    related='R050'))\\n\\n# assign # order\\nfor i, r in enumerate(L, start=1):\\n    r['num'] = i\\n\\nDEPTH = {  # page of the main source paragraph, sanity fallback\\n}\\n\\n# ---------------------------------------------------------------- checks (pre-build)\\ndef norm(s):\\n    s = s.replace('\\\\u2019', \\\"'\\\").replace('\\\\u2018', \\\"'\\\").replace('\\\\u201c', '\\\"').replace('\\\\u201d', '\\\"')\\n    s = s.replace('\\\\u2014', '-').replace('\\\\u2013', '-').replace('\\\\u00a0', ' ')\\n    s = re.sub(r'\\\\s+', ' ', s)\\n    return s.strip().lower()\\n\\nsrc_blob = {r['id']: norm(r['text']) for r in SRC}\\nproblems = []\\nfor r in L:\\n    for q in re.findall(r'\\\"([^\\\"]{15,})\\\"', r['why']):\\n        qn = norm(q)\\n        if not any(qn in t for t in src_blob.values()):\\n            problems.append((r['id'], q[:70]))\\nprint('QUOTE PROBLEMS:', len(problems))\\nfor p in problems:\\n    print('  ', p)\\n\\n# working date monotonic\\nprev = None\\nfor r in L:\\n    assert r['wdate'] is not None, r['id']\\n    if prev and r['wdate'] < prev:\\n        print('ORDER PROBLEM', r['id'], prev, r['wdate'])\\n    prev = r['wdate']\\n\\nprint('rows:', len(L))\\njson.dump(L, open('/tmp/opencode/pw/ledger.json', 'w'), default=str, indent=1)\\njson.dump(SRC, open('/tmp/opencode/pw/sources.json', 'w'), indent=1)\\n\"}"},"time":{"start":1789824876559,"end":1789824930130}}}}
