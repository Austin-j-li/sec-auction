{"type":"tool_use","timestamp":1789824972780,"sessionID":"ses_f462b3faeffehKvke01c5BeJ5s","part":{"partID":"prt_0b9e10a61001Jx1itew48frvPi","sessionID":"ses_f462b3faeffehKvke01c5BeJ5s","messageID":"msg_0b9e0ae30001GCAddkncHxZfbt","type":"tool","id":"call_00_QsWn5iGurpz9ghw4Ggmv3305","tool":"write","state":{"status":"completed","input":{"content":"# -*- coding: utf-8 -*-\n\"\"\"Build mac-gray.xlsx (Deal ledger / Summary / Questions / Source text / Lists).\"\"\"\nimport sys, datetime\nsys.path.insert(0, '/tmp/opencode')\nimport ledger_data as LD\nimport ledger_rows as LR\n\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\nD = datetime.date\n\nBOLD = Font(bold=True)\nHDRFILL = PatternFill(\"solid\", fgColor=\"D9E1F2\")\nWRAP = Alignment(wrap_text=True, vertical=\"top\")\nWRAPC = Alignment(wrap_text=True, vertical=\"top\", horizontal=\"center\")\nLINKFONT = Font(color=\"0563C1\", underline=\"single\")\nTHIN = Side(style=\"thin\", color=\"B0B0B0\")\nBOX = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)\n\nwb = Workbook()\n\n# ============================================================ Lists (hidden)\nlists_ws = wb.create_sheet(\"Lists\")\nLISTS = {\n    \"A\": (\"What happened\", [\n        \"Target interest\", \"Bidder interest\", \"Target sale decision\", \"Activist pressure\",\n        \"Activist involvement\", \"Adviser engaged\", \"Adviser service observed\", \"Adviser ended\",\n        \"Contact\", \"NDA signed\", \"Round opened\", \"Deadline set\", \"Deadline revised\", \"Deadline\",\n        \"Target decision\", \"Information access changed\", \"Material process update\",\n        \"Exclusivity changed\", \"Bid\", \"Bid reaffirmed\", \"Offer update\", \"Other-scope bid\",\n        \"Valuation statement\", \"Bidding group changed\", \"Joined group\", \"Dropped by target\",\n        \"Withdrew\", \"Did not submit\", \"Participation paused\", \"Re-entered\",\n        \"Not selected at signing\", \"Sale process announced\", \"Bid announced\", \"Merger announced\",\n        \"Merger agreement signed\", \"Go-shop changed\", \"Process terminated\", \"Process restarted\",\n        \"Agreement terminated\", \"Closed\"]),\n    \"B\": (\"Type\", [\"Strategic\", \"Financial\", \"Mixed\", \"Unknown\"]),\n    \"C\": (\"Formality\", [\"Formal\", \"Informal\", \"Insufficient evidence\", \"Varies\"]),\n    \"D\": (\"Conditions level\", [\"None\", \"Light\", \"Heavy\", \"Insufficient evidence\", \"Varies\"]),\n    \"E\": (\"Include\", [\"Yes\", \"No\"]),\n    \"F\": (\"Date basis\", [\"Reported day\", \"Inferred day\", \"Reported interval\", \"Approximate window\",\n                         \"Relative only\", \"Undated\"]),\n    \"G\": (\"Date method\", [\"Reported\", \"Inferred\", \"Assigned: deadline\", \"Assigned: decision day\",\n                          \"Assigned: midpoint\", \"Assigned: bound\", \"Assigned: sequence\"]),\n    \"H\": (\"Price kind\", [\"Point\", \"Bidder range\", \"Group envelope\", \"Bound only\", \"Undisclosed\"]),\n    \"I\": (\"Price origin\", [\"Stated\", \"Carried forward\", \"Inferred\"]),\n    \"J\": (\"All cash\", [\"Yes\", \"No\", \"Not stated\"]),\n    \"K\": (\"Deadline treatment\", [\"Extended\", \"Late bids accepted\", \"Enforced\", \"Passed without action\",\n                                 \"Unclear\", \"No deadline stated\", \"Extended; Late bids accepted\"]),\n    \"L\": (\"Round finality\", [\"Announced as final\", \"Inferred final\", \"Not final\"]),\n    \"M\": (\"Decided by\", [\"Bidder\", \"Target\", \"Both\", \"Unknown\"]),\n    \"N\": (\"Exit reason\", [\"Value below market price\", \"Value at or below market price\",\n                          \"Value below earlier offer\", \"Value at earlier offer\",\n                          \"Would not improve earlier offer\", \"Lower offer than rivals\",\n                          \"Terms or process\", \"Other stated reason\", \"Not stated\"]),\n    \"O\": (\"Outcome basis\", [\"Stated\", \"Inferred: residual\", \"Inferred: exclusivity\",\n                            \"Inferred: silent\", \"Inferred: identity\"]),\n}\nfor col, (name, vals) in LISTS.items():\n    lists_ws[f\"{col}1\"] = name\n    for i, v in enumerate(vals, start=2):\n        lists_ws[f\"{col}{i}\"] = v\nlists_ws.column_dimensions['A'].width = 32\nfor c in \"BCDEFGHIJKLMNO\":\n    lists_ws.column_dimensions[c].width = 30\nlists_ws.sheet_state = 'hidden'\n\n# ============================================================ Source text\nsrc_ws = wb.create_sheet(\"Source text\")\nsrc_ws.append([\"Paragraph\", \"Section\", \"Page\", \"Text\"])\nfor c in range(1, 5):\n    src_ws.cell(row=1, column=c).font = BOLD\n    src_ws.cell(row=1, column=c).fill = HDRFILL\nsrc_row_of = {}          # source id -> row number\nr = 1\nfor pid, sec, pg, text in LD.P_ROWS:\n    r += 1\n    src_ws.cell(row=r, column=1, value=pid)\n    src_ws.cell(row=r, column=2, value=sec)\n    src_ws.cell(row=r, column=3, value=pg)\n    src_ws.cell(row=r, column=4, value=text)\n    src_row_of[pid] = r\nfor xid, sec, pg, text in LD.X_ROWS:\n    r += 1\n    src_ws.cell(row=r, column=1, value=xid)\n    src_ws.cell(row=r, column=2, value=sec)\n    src_ws.cell(row=r, column=3, value=pg)\n    src_ws.cell(row=r, column=4, value=text)\n    src_row_of[xid] = r\nfor rr in range(2, r + 1):\n    for cc in range(1, 5):\n        src_ws.cell(row=rr, column=cc).alignment = WRAP\nsrc_ws.column_dimensions['A'].width = 12\nsrc_ws.column_dimensions['B'].width = 46\nsrc_ws.column_dimensions['C'].width = 7\nsrc_ws.column_dimensions['D'].width = 150\nsrc_ws.freeze_panes = \"A2\"\nsrc_ws.auto_filter.ref = f\"A1:D{r}\"\n\n# ============================================================ Deal ledger\nled = wb.create_sheet(\"Deal ledger\", 0)\nVIS = [\"#\", \"When\", \"Who\", \"What happened\", \"Process\", \"Round\", \"Type\", \"Terms or outcome\",\n       \"Formality\", \"Conditions level\", \"Why and evidence\", \"Source\", \"Review\", \"Reviewer note\"]\nEXP = [(\"Row id\", 9), (\"Include\", 9), (\"Count\", 7),\n       (\"Date from\", 11), (\"Date to\", 11), (\"Working date\", 12), (\"Date basis\", 16),\n       (\"Date method\", 18),\n       (\"Price low\", 10), (\"Price high\", 10), (\"Price kind\", 13), (\"Price origin\", 14),\n       (\"Currency\", 9),\n       (\"All cash\", 9), (\"Cash at closing\", 14),\n       (\"Conditions detail\", 60),\n       (\"Due date\", 11), (\"Deadline treatment\", 18), (\"Round finality\", 18),\n       (\"Decided by\", 11), (\"Exit reason\", 26), (\"Outcome basis\", 18),\n       (\"Page\", 7), (\"Related rows\", 34), (\"Deal\", 10)]\nheaders = VIS + [h for h, _ in EXP]\nfor c, h in enumerate(headers, start=1):\n    cell = led.cell(row=1, column=c, value=h)\n    cell.font = BOLD\n    cell.fill = HDRFILL\n    cell.alignment = Alignment(wrap_text=True, vertical=\"center\", horizontal=\"center\")\nwidths = [5, 26, 26, 20, 8, 7, 10, 70, 11, 13, 90, 18, 8, 22] + [w for _, w in EXP]\nfor c, w in enumerate(widths, start=1):\n    led.column_dimensions[get_column_letter(c)].width = w\n\ndef setv(ws, row, col, val, fmt=None):\n    cell = ws.cell(row=row, column=col, value=val)\n    cell.alignment = WRAP\n    if fmt:\n        cell.number_format = fmt\n    return cell\n\nDATE_FMT = \"MM/DD/YYYY\"\nrow_records = []\nfor i, rec in enumerate(LR.ROWS, start=1):\n    rr = i + 1\n    rid = f\"R{i:03d}\"\n    row_records.append((rid, rec))\n    # visible\n    setv(led, rr, 1, i, \"0\")\n    setv(led, rr, 2, rec.get('when'))\n    setv(led, rr, 3, rec.get('who'))\n    setv(led, rr, 4, rec.get('what'))\n    setv(led, rr, 5, rec.get('process', 1))\n    setv(led, rr, 6, rec.get('round'))\n    setv(led, rr, 7, rec.get('type_'))\n    setv(led, rr, 8, rec.get('terms'))\n    setv(led, rr, 9, rec.get('formality'))\n    setv(led, rr, 10, rec.get('cond'))\n    setv(led, rr, 11, rec.get('why'))\n    # Source: ids + hyperlink to main\n    ids = [LD.BID2ID[b] for b in rec['src']]\n    main_id = LD.BID2ID[rec['main']]\n    ordered = [main_id] + [x for x in ids if x != main_id]\n    src_text = \"; \".join(ordered)\n    csrc = setv(led, rr, 12, src_text)\n    tgt_row = src_row_of[main_id]\n    csrc.hyperlink = Hyperlink(ref=csrc.coordinate, location=f\"'Source text'!A{tgt_row}\",\n                               tooltip=f\"Go to {main_id}\")\n    csrc.font = LINKFONT\n    setv(led, rr, 13, rec.get('review'))\n    setv(led, rr, 14, None)\n    # expandable\n    setv(led, rr, 15, rid)\n    setv(led, rr, 16, \"Yes\")\n    setv(led, rr, 17, rec.get('count'))\n    setv(led, rr, 18, rec.get('dfrom'), DATE_FMT)\n    setv(led, rr, 19, rec.get('dto'), DATE_FMT)\n    setv(led, rr, 20, rec.get('working'), DATE_FMT)\n    setv(led, rr, 21, rec.get('basis'))\n    setv(led, rr, 22, rec.get('method'))\n    setv(led, rr, 23, rec.get('plow'))\n    setv(led, rr, 24, rec.get('phigh'))\n    setv(led, rr, 25, rec.get('pkind'))\n    setv(led, rr, 26, rec.get('porigin'))\n    setv(led, rr, 27, rec.get('curr'))\n    setv(led, rr, 28, rec.get('allcash'))\n    setv(led, rr, 29, rec.get('cashclose'))\n    setv(led, rr, 30, rec.get('cond_detail'))\n    setv(led, rr, 31, rec.get('due'), DATE_FMT)\n    setv(led, rr, 32, rec.get('dtreat'))\n    setv(led, rr, 33, rec.get('finality'))\n    setv(led, rr, 34, rec.get('decided'))\n    setv(led, rr, 35, rec.get('exitr'))\n    setv(led, rr, 36, rec.get('obasis'))\n    setv(led, rr, 37, rec.get('page'))\n    setv(led, rr, 38, rec.get('related'))\n    setv(led, rr, 39, rec.get('deal', 'Mac-Gray'))\n    for cc in range(1, 40):\n        led.cell(row=rr, column=cc).border = BOX\n\nlast = len(LR.ROWS) + 1\nled.auto_filter.ref = f\"A1:AM{last}\"\nled.freeze_panes = \"E2\"\n\n# collapse + outline the expandable fields (O..AM)\nfor c in range(15, 40):\n    L = get_column_letter(c)\n    led.column_dimensions[L].hidden = True\n    led.column_dimensions[L].outlineLevel = 1\n\n# data validations\ndef dv(col, listcol, title):\n    d = DataValidation(type=\"list\", formula1=f\"=Lists!${listcol}$2:${listcol}${len(LISTS[listcol][1])+1}\",\n                       allow_blank=True, showDropDown=False)\n    d.promptTitle = title\n    d.prompt = \"Choose a value from the Lists sheet.\"\n    led.add_data_validation(d)\n    d.add(f\"{col}2:{col}{last}\")\n\ndv('D', 'A', 'What happened')\ndv('G', 'B', 'Type')\ndv('I', 'C', 'Formality')\ndv('J', 'D', 'Conditions level')\ndv('P', 'E', 'Include')\ndv('U', 'F', 'Date basis')\ndv('V', 'G', 'Date method')\ndv('Y', 'H', 'Price kind')\ndv('Z', 'I', 'Price origin')\ndv('AB', 'J', 'All cash')\ndv('AF', 'K', 'Deadline treatment')\ndv('AG', 'L', 'Round finality')\ndv('AH', 'M', 'Decided by')\ndv('AI', 'N', 'Exit reason')\ndv('AJ', 'O', 'Outcome basis')\n\n# ============================================================ Summary\nsum_ws = wb.create_sheet(\"Summary\", 1)\nsum_ws.column_dimensions['A'].width = 34\nsum_ws.column_dimensions['B'].width = 150\n\nsrow = 0\ndef s_head(t):\n    global srow\n    srow += 1\n    c = sum_ws.cell(row=srow, column=1, value=t)\n    c.font = Font(bold=True, size=12)\n    sum_ws.cell(row=srow, column=2, value=None)\n\ndef s_pair(label, text):\n    global srow\n    srow += 1\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\n    b = sum_ws.cell(row=srow, column=2, value=text); b.alignment = WRAP\n\ndef s_text(text):\n    global srow\n    srow += 1\n    b = sum_ws.cell(row=srow, column=2, value=text); b.alignment = WRAP\n\ndef s_formula(label, formula, note=None):\n    global srow\n    srow += 1\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\n    b = sum_ws.cell(row=srow, column=2, value=formula); b.alignment = WRAP\n    if note:\n        srow += 1\n        sum_ws.cell(row=srow, column=2, value=note).alignment = WRAP\n\ndef s_count(label, value):\n    global srow\n    srow += 1\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\n    b = sum_ws.cell(row=srow, column=2, value=value); b.alignment = WRAP\n\nc = sum_ws.cell(row=1, column=1, value=\"MAC-GRAY / CSC SERVICEWORKS - DEAL LEDGER SUMMARY\")\nc.font = Font(bold=True, size=14)\nsrow = 1\ns_head(\"1. Status and commercial account\")\ns_pair(\"AI status\", \"AI first pass; not human-approved. Instruction: revision of 19 September 2026 (short form).\")\ns_pair(\"Source coverage\", \"DEFM14A filed 12/04/2013; work only from this filing and the instruction. Complete Background of the Merger selected and reproduced on the Source text sheet in source order (P-001 to P-088, printed pages 27-41); other filing passages used are X-001 to X-031. Source text is HTML-derived: whitespace normalized, page-break artifacts and repeated 'Table of Contents' headers removed; paragraphs split by printed page breaks appear as separate '(cont.)' rows; no wording changes. Local source filename: raw_filing/mac-gray_2013-12-04_DEFM14A.htm.\")\ns_pair(\"Commercial account\", \"Initiation: after CSC's sale to Pamplona closed in May 2013, Mac-Gray's board explored strategic alternatives, and on June 24, 2013 the Special Committee concluded a sale was in stockholders' best interests and authorized its banker to solicit 50 parties (15 strategic, 35 financial); Party A had already made an unsolicited $17.00-$19.00 all-cash proposal on June 21, 2013. Competition: four bidder units - Party A (strategic), Party B and Party C (unnamed financial sponsors) and CSC/Pamplona (operating buyer CSC funded by sponsor Pamplona) - were individually recorded among 20 NDA signers and advanced through management meetings and two rounds of revised and final indications, while 16 other signers never submitted. Price path: CSC/Pamplona moved $18.50 (07/23) to $19.50 (09/09) to $20.75 (09/18) and to $21.25 last and best (09/21); Party B peaked at a $21.50-valued package ($19.00 cash plus options) whose cash and certainty lagged; Party A held at $18.00-$19.00 as best and final; Party C stopped at $16.00-$17.00 and did not respond to the final solicitation. Selection: on 09/19 the Special Committee found CSC/Pamplona's proposal most valuable with greater certainty and authorized exclusivity at $21.25; exclusivity was executed 09/24/2013 (to 5 p.m. ET 10/12, extended to 11:59 p.m. ET 10/15) with a $15 million reverse termination fee and no financing contingency, Pamplona committed $594 million, and Moab and Mr. MacDonald did not roll over shares. Signing and publicity: the merger agreement was signed 10/14/2013 and announced 10/15/2013; voting agreements covered about 15% of shares; the proxy shows no competing proposal or go-shop and sets the special meeting for 01/08/2014. Observed outcome: signed, not closed - completion expected in the first half of 2014, the HSR waiting period expired 11/27/2013, and a putative class action was filed 11/21/2013.\")\ns_head(\"2. Deal facts\")\ns_pair(\"Target\", \"Mac-Gray Corporation (Delaware; NYSE-listed; Waltham, Massachusetts), second largest U.S. laundry facilities management contractor. [X-002]\")\ns_pair(\"Focal acquirer and type\", \"CSC/Pamplona - the acquisition unit of CSC ServiceWorks, Inc. (operating acquirer; the filing calls Party A and CSC/Pamplona its two 'strategic bidders') with equity capital committed by Pamplona Capital Partners III, L.P., part of Pamplona Capital Management, which bought CSC in May 2013. Acquisition chain: Parent = Spin Holdco Inc. (wholly owned by CSC); Merger Subsidiary = CSC Fenway, Inc.; Holdings = CSC ServiceWorks Holdings, Inc. Type = Strategic (operating-company acquisition role); sponsor ownership and sponsor financing do not make it Financial, and it is not Mixed. [P-002, P-034, X-001, X-003, X-005, X-006]\")\ns_pair(\"Agreed consideration\", \"$21.25 per share in cash, without interest; all-cash; all outstanding shares converted at the effective time; no financing condition. Cash at closing: $21.25 per share. [X-009, X-010, X-013, X-029]\")\ns_pair(\"Signing / announcement / completion\", \"Merger agreement signed 10/14/2013; jointly announced 10/15/2013 before market open; completion expected in the first half of 2014 and NOT observed in the filing (no closed-transaction row). End date 03/31/2014, extendable to 07/31/2014 if only the HSR condition remains. [P-101, P-102, X-016, X-028]\")\ns_pair(\"Filing identity\", \"DEFM14A, Mac-Gray Corporation, filed 12/04/2013; source file raw_filing/mac-gray_2013-12-04_DEFM14A.htm; Background of the Merger at printed pages 27-41; record date 11/27/2013; special meeting 01/08/2014 at 10:00 a.m. Boston. [X-007, X-008]\")\ns_pair(\"Market benchmarks (dates)\", \"Unaffected reference close $14.72 on 10/11/2013 (last trading day before board approval); 52-week high $15.61 for the period ending 10/11/2013; market close $21.30 on 11/27/2013. Agreed price represents approximately 36% premium to the 52-week high and approximately 44% to the 10/11/2013 close. [X-010, X-011, X-012, X-027]\")\ns_pair(\"Shares and ownership\", \"14,758,306 shares outstanding and entitled to vote as of 11/27/2013; voting agreements covered approximately 15% of shares (2,697,484 shares per the 10/23/2013 Schedule 13D, beneficial ownership disclaimed by Parent, Merger Subsidiary, Holdings, CSC, Pamplona and Pamplona Capital Management entities). Moab held approximately 9% in June 2013. [X-007, X-019, X-030]\")\ns_pair(\"Financing\", \"$594 million committed by Pamplona Capital Partners III, L.P. under a commitment letter dated 10/14/2013 for closing funding and related obligations; no financing condition to closing; Pamplona and the Buyer Entities jointly and severally liable for breaches with Pamplona's damages liability capped at $50 million (Buyer Entities unlimited). [X-013, X-031]\")\ns_pair(\"Termination fees\", \"$11 million payable by Mac-Gray (as finally agreed 10/11/2013; earlier proposals were $15 million and $10.5 million); $15 million Parent termination fee. Deal-protection terms are not separate ledger rows per instruction; the fee history appears in the Background (P-079 to P-095). [X-017]\")\ns_pair(\"Optional labelled calculation\", \"Equity value at the record-date share count = 14,758,306 x $21.25 = formula below (calculation, not a filing assertion; the filing does not state a total equity value, and the termination-fee percentage statements imply larger totals of roughly $341-$350 million on a different share base). No net debt, option, RSU or dilution adjustments are assumed.\")\ns_formula(\"Equity value (optional; ledger input)\", \"=14758306*21.25\",\n          \"Sources for inputs: X-007 (shares outstanding) and X-009 (price per share). Excluded from bid-count formulas; flagged as a derived calculation.\")\ns_head(\"3. Process and round map\")\ns_pair(\"Process map\", \"One sale process (Process 1). Earlier context: the 2011-2012 Discussions were Mac-Gray's prospective acquisition of CSC, not a Mac-Gray sale process (no Process terminated/restarted rows). No separate post-signing stage opened: the proxy discloses no competing proposal, no go-shop and no agreement termination as of 12/04/2013.\")\ns_pair(\"Round 0 (pre-opening)\", \"No organized round and no Round opened row. Party A contact 04/08/2013 (R003) and unsolicited pre-NDA proposal 06/21/2013 $17.00-$19.00 (R008), standing when round 1 began. Adviser and activist context rows (R001-R007).\")\ns_pair(\"Round 1 (R009, opens 06/24/2013)\", \"R1 anchor: 06/24/2013 Special Committee decision to consider a sale and authorize solicitation of 50 parties; rejected candidate anchors R008 (06/21 proposal) and R012 (06/28 first NDA); first outreach-wave date not disclosed. Objective: initial outreach and preliminary IOIs. Participants: 50 parties approached (15 strategic, 35 financial); 20 NDA signers entered (R012, R013, R015, R016). Deadline 07/23/2013, treatment Late bids accepted (on-time CSC/Pamplona R018; Party B 07/24 R020; Party C 07/24-25 R021, R023). Finality Not final. Round bidders 4: CSC/Pamplona $18.50, Party B $17.00-$18.00, Party C $15.00-$17.00 (oral), plus Party A's standing $17.00-$19.00 from R008 (explicit inclusion). Ending: 16 residual signers closed as non-submitters (R019); four bidders advanced.\")\ns_pair(\"Round 2 (R022, opens 07/25/2013)\", \"Objective: staged information access and management meetings, then revised indications. Participants: Party A, Party B, Party C, CSC/Pamplona (R023 written IOI; NDA R024). Differential access row R025 (financial bidders broad data-site access; strategic bidders limited, customer data withheld). Deadline set 08/27/2013 for 09/09/2013 (R026); treatment Late bids accepted (CSC/Pamplona and Party B 09/09 R028-R029; Party A and Party C 09/10 R030-R031; reviewed 09/11). Finality Not final. Round bidders 4: CSC/Pamplona $19.50, Party B $18.50, Party A $18.00-$19.00, Party C $16.00-$17.00. Alternative anchor candidate (rejected): R026 (08/27 letter).\")\ns_pair(\"Round 3 (R033, opens 09/11/2013)\", \"Objective: first request for final indications of interest, with possible short exclusive negotiation. Participants: the same four. Deadline 09/18/2013 (R034), treatment Enforced (target's next step 09/19). Finality Announced as final. Round bidders 3: CSC/Pamplona $20.75 (R035), Party B $21.50-valued package (R037), Party A reaffirmed $18.00-$19.00 best and final (R036); Party C did not submit (R038). Selection 09/19 (R039); final price $21.25 agreed 09/21 (R040).\")\ns_pair(\"Round 4 (R042, opens 09/24/2013)\", \"Objective: exclusive negotiation and definitive agreement with selected bidder CSC/Pamplona, beginning on execution of the exclusivity agreement (R041). Participants: CSC/Pamplona only; Party A and Party B closed the same day by exclusivity (R043, R044). No bid-submission deadline; exclusivity expiry 5 p.m. ET 10/12/2013 was extended to 11:59 p.m. ET 10/15/2013 (R047). Finality Inferred final. Signing R048 (10/14) and announcement R049 (10/15). Alternative treatment (fold into round 3) flagged in Q1.\")\ns_pair(\"Post-signing\", \"No competing proposal, go-shop start/change or agreement termination is disclosed as of 12/04/2013. Regulatory: HSR filings 10/29/2013, early termination not granted, waiting period expired 11/27/2013 [X-021]. Litigation: putative class action filed 11/21/2013 [X-022]. These belong here, not as ledger rows.\")\ns_head(\"4. Participants and advisers\")\ns_pair(\"Party A (strategic; unnamed)\", \"First observed 04/08/2013 contact (R003); pre-NDA proposal 06/21/2013 (R008); NDA 08/05/2013 (R024); revised indication 09/10/2013 (R030); best-and-final reaffirmation 09/18/2013 (R036); closed Dropped by target on 09/24/2013 by exclusivity (R043; inferred; exit reason Would not improve earlier offer). Type basis: laundry-industry strategic party, one of the filing's two named strategic bidders [P-034].\")\ns_pair(\"Party B (financial; unnamed)\", \"First observed NDA 06/28/2013 (R012); IOIs 07/24, 09/09 and the $21.50-valued cash-plus-options proposal 09/18/2013 (R020, R029, R037); closed Dropped by target on 09/24/2013 by exclusivity (R044; inferred; exit reason Terms or process). Type basis: one of the 18 financial bidders, with affiliated-fund equity [P-034, P-052].\")\ns_pair(\"Party C (financial; unnamed)\", \"First observed NDA 06/30/2013 (R013); oral and written IOIs 07/24-25 (R021, R023) and revised oral indication 09/10/2013 (R031); did not submit at the final-indications solicitation and gave no reasons; closed Did not submit on 09/18/2013 (R038; stated; agency Unknown). Type basis: one of the financial bidders [P-034].\")\ns_pair(\"CSC/Pamplona (strategic; winner)\", \"First observed contact 06/28/2013 (R011); NDA 07/11/2013 (R015); bids 07/23 $18.50, 09/09 $19.50, 09/18 $20.75 and 09/21 $21.25 last and best (R018, R028, R035, R040); exclusivity 09/24/2013 (R041); signing 10/14/2013 (R048). No exit row (winner). Unit composition: CSC ServiceWorks, Inc. (operating acquirer) and Pamplona (equity capital commitment); Pamplona's funding is support, not a membership change or joint-bidder formation.\")\ns_pair(\"16 residual NDA signers (financial)\", \"Entered as residual cohort of 20 signers less the four recorded individually (R016; count 16); closed Did not submit by 07/23/2013 (R019; inferred residual; base assumes all 20 were eligible - flagged Q3).\")\ns_pair(\"Moab Partners, L.P. (shareholder, approximately 9%)\", \"Not a bidder. Proxy contest and two directors elected 05/30/2013 (R007); rollover request denied 07/06/2013 (R014) and resolved without a rollover by 10/07/2013 (R046); voting agreement at signing (R048).\")\ns_pair(\"Stewart G. MacDonald, Jr. (CEO; significant holder)\", \"Not a bidder. Excluded from sale-process evaluation 06/24/2013 (R009); declined a share rollover 09/11/2013 and wanted a higher value (R032); supportive of $21.25 (R039); voting agreement effective at signing (R048).\")\ns_pair(\"Advisers\", \"BofA Merrill Lynch (Merrill Lynch, Pierce, Fenner & Smith Incorporated) - Mac-Gray's financial advisor: 2011-2012 Discussions engagement 10/23/2012 (R001), terminated 05/15/2013 (R005), re-engaged for the sale process by Board approval 05/30/2013 with engagement letter 05/31/2013 (R006); delivered the fairness opinion dated 10/14/2013 [X-026]. Goodwin Procter LLP - outside legal counsel to Mac-Gray (observed acting from 05/09/2013, R004; drafted the merger agreement and advised the Special Committee throughout). Kirkland & Ellis LLP - outside legal counsel to CSC/Pamplona from 09/25/2013 (R042 note). Clients are as stated by the filing; no unclear client affiliations identified.\")\ns_head(\"5. Counts and auction screen\")\ns_formula(\"NDA signers (ledger)\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$D:$D,\\\"NDA signed\\\")\",\n          \"Filing assertion: 20 (two strategic bidders - Party A and CSC/Pamplona - and 18 financial bidders, including Party B and Party C) [P-034]. Ledger = 4 individually recorded signers + 16 residual cohort = 20; reconciles exactly. Residual dates and eligibility are uncertain (Q3).\")\ns_formula(\"First sale-related contacts (ledger)\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$D:$D,\\\"Contact\\\")\",\n          \"Filing process-level assertion: 50 parties approached (15 strategic, 35 financial) [P-032, P-033]. Only Party A (04/08/2013) and CSC/Pamplona (06/28/2013) are individually dated; the other contacts are not individually reported, so no exact reconciliation is claimed.\")\ns_formula(\"Round-1 round bidders (submissions)\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,1,'Deal ledger'!$D:$D,\\\"Bid\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,1,'Deal ledger'!$D:$D,\\\"Bid reaffirmed\\\")\",\n          \"Explicit inclusion: + 1 standing round-0 proposal (Party A, R008, whose Bid row sits in round 0 but who participated in round 1) = 4 round bidders. Units, not submissions or unique firms.\")\ns_formula(\"Round-2 round bidders\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,2,'Deal ledger'!$D:$D,\\\"Bid\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,2,'Deal ledger'!$D:$D,\\\"Bid reaffirmed\\\")\",\n          \"Four units: CSC/Pamplona, Party B, Party A, Party C. Not a submission count (Party C has two rows in round 1 and one in round 2; revisions carry Count 0).\")\ns_formula(\"Round-3 round bidders\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$D:$D,\\\"Bid\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$D:$D,\\\"Bid reaffirmed\\\")\",\n          \"Three units (CSC/Pamplona, Party B, Party A); Party C did not submit and is an outcome row (R038), not a round bidder. Round 4 has no bid rows: one unit continued in exclusive definitive negotiation.\")\ns_formula(\"Outcome tallies (affected units)\",\n          \"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\"Yes\\\",'Deal ledger'!$D:$D,\\\"Dropped by target\\\")\",\n          \"Dropped by target = 2 units (Party A, Party B at 09/24). Did not submit: 16 residual at 07/23 (R019) + Party C at 09/18 (R038) = 17 units; formula above shows only the Dropped tally; totals are occurrences/affected units, not unique permanent exits. Winner CSC/Pamplona has no exit row.\")\ns_pair(\"Auction screen\", \"Met: more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for this process - four units are individually recorded (Party A, Party B, Party C, CSC/Pamplona) among 20 signers total. Excluded: no lender-only, adviser or rollover-holder agreements reported; no agreements expressly reused from an earlier attempt (the 2011-2012 Discussions produced no reused NDA).\")\ns_pair(\"Per-stage balance (participants)\", \"R0: entrants 1 (Party A) - exits 0 = 1 live. R1: entrants +19 (16 cohort + Party B + Party C + CSC/Pamplona; Party A already in) = 20; exits -16 (residual non-submitters, R019) = 4. R2: exits 0 = 4. R3: exits -1 (Party C, R038) = 3. R4: exits -2 (Party A and Party B by exclusivity, R043-R044) = 1 = winner at signing (R048); no participant left open. Inferred share of exits: 18 of 19 (the 16 residual plus the two exclusivity drops); Party C's exit is stated. Counts are tally contributions, not population balances.\")\ns_head(\"6. Comparability and inputs\")\ns_pair(\"Other-scope proposals\", \"None: every recorded proposal concerns acquisition of the whole company's equity. No segment, asset, minority or other-scope bids and no group price envelopes.\")\ns_pair(\"Unusual consideration\", \"Party B's 09/18/2013 cash-plus-options package: $19.00 cash at closing plus options it valued at $2.50 per share (10% of new equity, strike at its initial cost basis, vesting over five years on base-case projections). Recorded as All cash = No; structured price cells show the cash component and the bidder's stated total ($19.00-$21.50) and are flagged as a package representation (Q7). No CVR or earnout in the signed deal.\")\ns_pair(\"Currency and units\", \"All amounts USD per share; no currency conversion performed. Agreed consideration and all recorded bid prices are per share of Mac-Gray common stock.\")\ns_pair(\"Stated deal inputs\", \"Shares outstanding 14,758,306 at 11/27/2013 [X-007]; market close $21.30 on 11/27/2013 [X-012]; unaffected close $14.72 and 52-week high $15.61 on 10/11/2013 [X-010, X-011, X-027]; $594 million Pamplona commitment [X-013, X-031]; $11 million / $15 million termination fees [X-017]; voting agreements approximately 15% [X-019, X-030]. No net debt, dilution, preferred or rollover conversion is assumed anywhere.\")\ns_pair(\"Glossary\", \"NDA = confidentiality agreement (here, confidentiality and standstill agreements). IOI = indication of interest; LOI = letter of intent. Due diligence = investigation of the target. Formality: documentation/solicitation assessment (Formal/Informal), separate from Conditions level (financing and diligence conditions the bid carries). Round = target-organized solicitation, evaluation or negotiation stage (0 = before the opening; 'post' = outside an identified round). Working date = assigned sort key, not an observed date. Reverse termination fee = fee payable by the buyer side on specified termination (here $15 million). Standstill/sunset = bidder restrictions that lapse to permit proposals. HSR = Hart-Scott-Rodino antitrust waiting period. Exclusivity = period of exclusive negotiation. Rollover = shareholder contributing shares into the buyer instead of cashing out.\")\ns_text(\"Prepared from the supplied filing only. All quotations on the Deal ledger sheet appear verbatim on the Source text sheet; tags in Terms or outcome repeat the structured fields (R1 anchor, Inferred, Bound, Support). Reviewer corrections are expected: see Questions.\")\n\n# ============================================================ Questions\nq_ws = wb.create_sheet(\"Questions\", 2)\nQCOLS = [\"Q\", \"Review topic\", \"Recommended answer\", \"Why and source\", \"Affected rows/fields\",\n         \"Consequence of changing it\", \"Status\", \"Reviewer note\"]\nfor i, h in enumerate(QCOLS, start=1):\n    c = q_ws.cell(row=1, column=i, value=h); c.font = BOLD; c.fill = HDRFILL; c.alignment = WRAPC\nQW = [6, 30, 70, 80, 26, 46, 11, 26]\nfor i, w in enumerate(QW, start=1):\n    q_ws.column_dimensions[get_column_letter(i)].width = w\n\nQUESTIONS = [\n (\"Q1\", \"Process and round map; inferred starts; rejected boundary candidates\",\n  \"Keep one process and the four rounds as built: R1 06/24/2013 (sale decision/50-party solicitation; rejected anchors R008 and R012); R2 07/25/2013 (staged access and revised-IOI stage; rejected alternative R026, the 08/27/2013 letter); R3 09/11/2013 (first final-indications request; Announced as final); R4 09/24/2013 (executed exclusivity and definitive negotiation; Inferred final; alternative = fold into R3). Treat the 2011-2012 Discussions as context, not a second process.\",\n  \"Anchors follow the instruction's opening rules: R1 uses the launching decision because the first outreach wave is undated (outreach executed within days; first NDA 06/28). R2 uses the selection of advancing participants plus a stage-linked offer request (authorization R021 quote: 'authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure... and to reach out to each of the four interested bidders'); the 08/27 letter only communicated the deadline. R3 is the target's first request for final indications (R032 quote). R4 applies the 'moves to definitive negotiation with selected bidders' trigger; exclusivity inside an already-established final negotiation stage would not open a round. Sources: P-028 (R009), P-046/P-047 (R022), P-055 (R033), P-073 (R041-R042).\",\n  \"R008, R009, R012, R022, R026, R033, R040, R041, R042; rounds/finality fields on R009/R022/R033/R042\",\n  \"Dating R2 at 08/27 moves the start of the staged-access stage and its access row (R025); merging R4 into R3 would put exclusivity, the two closures and signing in R3 and delete the Inferred-final row; treating R1 as opening at the 06/21 proposal would pull Party A's bid out of round 0.\",\n  \"Pending\", None),\n (\"Q2\", \"Deadline changes and elapsed-deadline treatments\",\n  \"Keep: 07/23/2013 Late bids accepted; 09/09/2013 Late bids accepted; 09/18/2013 Enforced. No bid deadline was revised; the 10/12/2013 exclusivity expiry was extended (recorded on R047, not as a bid Deadline row).\",\n  \"07/23: Party B (07/24) and Party C (07/24-25) were considered by the Special Committee on 07/25 without revision. 09/09: Party A and Party C submitted 09/10 and were reviewed 09/11 without extension; the target itself later solicited CSC/Pamplona's 09/21 price revision, which belongs to continuing negotiation and is not late acceptance. 09/18: the next step was selection (09/19), so Enforced. Sources: P-034, P-043, P-044, P-046 (Late bids); P-053 to P-056 (09/09); P-063 to P-066 (09/18 selection); P-095 to P-097 (extension).\",\n  \"R010, R017, R019, R026, R027, R034, R044, R047; Deadline treatment and Due date fields\",\n  \"Re-labelling 07/23 or 09/09 as Enforced, or 09/18 as Unclear, changes the term the target applied to its stage and implies (unsupported) formal revision or inaction.\",\n  \"Pending\", None),\n (\"Q3\", \"Inferred residual rows and NDA population uncertainty\",\n  \"Retain the 16-person residual for the NDA cohort (R016) and for the 07/23 non-submission (R019), base = 20 signers. Keep the caveat that only the four individually dated signers are certain; all eligibility arithmetic uses the filing's stated totals.\",\n  \"Base and split: P-034 ('a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders'). Accounting at the first transition: P-045 names only Party B, Party C, CSC/Pamplona and Party A's standing proposal. Arithmetic: 20 - 4 = 16. Uncertainty: the 16 signers' dates are unstated and signers whose NDAs postdate 07/23 would reduce the residual; Party A signed only on 08/05 but is shown continuing, so it is not in the residual.\",\n  \"R012, R013, R015, R016, R019, R020, R021, R022, R024; Count/Dates fields on R016 and R019\",\n  \"Changing the base or the accounted-for set changes both inferred Counts and the per-stage balance; adding individual rows for anonymous members would invent identities.\",\n  \"Pending\", None),\n (\"Q4\", \"Participation outcomes and agency (including every inferred closing row)\",\n  \"Keep: Party A and Party B Dropped by target on 09/24/2013 (Inferred: exclusivity; Decided by Target; reasons Would not improve earlier offer and Terms or process); Party C Did not submit on 09/18/2013 (stated; Decided by Unknown; Not stated); winner no exit row. No participant left open.\",\n  \"Exclusivity was executed 09/24/2013 with CSC/Pamplona with no notice to Party A or Party B reported (P-073; Party A's last act P-064). Party C's non-submission and absence of reasons are stated in P-064/P-065; the filing reports no notice or discouragement, so agency is left Unknown. Convention: every participant that entered is closed once.\",\n  \"R019, R038, R043, R044; Decided by / Exit reason / Outcome basis fields\",\n  \"Assigning withdrawals or bidder agency without notice evidence would misstate participation; failing to close A and B would break the per-stage balance at signing.\",\n  \"Pending\", None),\n (\"Q5\", \"Formality of the final-stage indications (borderline Formal calls)\",\n  \"Keep Formal for the 09/18/2013 responses (CSC/Pamplona $20.75; Party B $21.50 package) and for Party A's best-and-final reaffirmation, carried to CSC/Pamplona's 09/21/2013 last-and-best. Alternative for Party A: Informal if a phone reiteration is judged not to be a response on the requested written basis. Earlier IOIs remain Informal.\",\n  \"Formality signal 2: 'a response on the requested basis to a genuine final, binding or best-and-final solicitation'; a non-binding IOI can be Formal; no retrospective upgrading of earlier offers. Sources: P-064 (09/18 responses), P-055 (final request), P-067 (09/21 confirmation). Party A's call is the borderline case and is flagged here rather than upgraded silently.\",\n  \"R035, R036, R037, R040; Formality fields; context rows R008, R018, R020, R021, R023, R028-R031\",\n  \"Downgrading Party A changes only its row label (its exit basis is unaffected); upgrading earlier IOIs would contradict the no-retrospective-upgrade rule.\",\n  \"Pending\", None),\n (\"Q6\", \"Conditions levels that turn on diligence or financing statements\",\n  \"Keep Heavy for pre-substantive-diligence IOIs (R008, R018, R020, R021, R023) and for Party B's later bids (R029, R037 - reported absence of a firm financing commitment). Keep Light for CSC/Pamplona's 09/09 and later bids (R028, R035, R040 - committed sponsor financing, no stated diligence condition). Keep Insufficient evidence for Party C's 09/10/2013 revised indication (R031 - price only, financing silence).\",\n  \"Heavy-by-context applies to preliminary indications made before data-room or management access; 'less conditional' comparisons were not converted into absolute levels; silence neither raises nor lowers a level. Sources: P-034, P-043 to P-045 (pre-DD IOIs), P-054 (CSC/Pamplona committed funding; Party B no firm commitment), P-055 (Party C silence), P-040 (access staging).\",\n  \"R008, R018, R020, R021, R023, R028-R031, R035-R037, R040; Conditions level and Conditions detail fields\",\n  \"Reassigning a level changes the comparable conditionality of final offers and the four documented Heavy-by-context calls at the first stage.\",\n  \"Pending\", None),\n (\"Q7\", \"Price representation for Party B's cash-plus-options package and related conventions\",\n  \"Keep Price low 19.00 / Price high 21.50 with Price kind Bidder range, All cash No and Cash at closing 19.00, with Terms stating that the cells show the cash component and the bidder's stated total valuation - a package, not a submitted range. Alternative: blank the structured price cells and keep the package only in Terms.\",\n  \"The filing gives $19.00 cash at closing plus options valued at $2.50 (total $21.50) (P-064); the instruction directs that package values be attributed, not treated as guaranteed cash, and that the contingent part stay in Terms. Sources: P-064, P-066 (Special Committee risk view).\",\n  \"R037; Price low/high/kind/origin, All cash, Cash at closing fields; comparability note in Summary section 6\",\n  \"Blank cells reduce structured comparability but avoid any reading of $21.50 as cash; leaving as recorded preserves the bidder's own valuation with an explicit flag.\",\n  \"Pending\", None),\n (\"Q8\", \"Date conventions and record-keeping items\",\n  \"Accept the assigned Working dates and their methods: residual NDA midpoint 07/17/2013 (R016); 07/23/2013 deadline-set row by sequence (R010); Moab resolution bounded to 10/07/2013 (R046); inferred closures assigned to deadline/decision days (R019, R038, R043, R044). Accept the preserved source typo 'July 27, 2103' with the proposed correction to 2013 (R024), and the structural choices: one row each for the Moab and MacDonald rollover relationships, adviser rows for BofA (old and new mandates) and Goodwin Procter service, and no rows for termination/reverse fees, liability caps, voting agreements, post-signing covenants or successive drafts (folded into R040, R041, R047, R048).\",\n  \"All are instruction conventions (sections 5.4, 8.1, 10.2) or explicit materiality exclusions (section 4); quotations on the Source text sheet preserve wording and qualification, and no working date falls outside its Date from/Date to or contradicts the filing's before/after bounds.\",\n  \"R001, R005, R006, R010, R014, R016, R019, R024, R032, R038, R043, R044, R046, R047, R048; Date from/to, Working date, Date basis, Date method, Page fields\",\n  \"Changing conventions reorders display or shifts assigned dates but not the underlying facts; moving the typo correction or rollover rows would affect only those rows' framing.\",\n  \"Pending\", None),\n]\nfor i, q in enumerate(QUESTIONS, start=2):\n    for j, v in enumerate(q, start=1):\n        c = q_ws.cell(row=i, column=j, value=v); c.alignment = WRAP; c.border = BOX\nq_ws.freeze_panes = \"A2\"\nq_ws.auto_filter.ref = f\"A1:H{len(QUESTIONS)+1}\"\n\nwb.save(OUT)\nprint(\"saved\", OUT)\n","path":"/tmp/opencode/make_workbook.py"},"output":"Created file successfully: /tmp/opencode/make_workbook.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/make_workbook.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build mac-gray.xlsx (Deal ledger / Summary / Questions / Source text / Lists).\\\"\\\"\\\"\\nimport sys, datetime\\nsys.path.insert(0, '/tmp/opencode')\\nimport ledger_data as LD\\nimport ledger_rows as LR\\n\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\\nD = datetime.date\\n\\nBOLD = Font(bold=True)\\nHDRFILL = PatternFill(\\\"solid\\\", fgColor=\\\"D9E1F2\\\")\\nWRAP = Alignment(wrap_text=True, vertical=\\\"top\\\")\\nWRAPC = Alignment(wrap_text=True, vertical=\\\"top\\\", horizontal=\\\"center\\\")\\nLINKFONT = Font(color=\\\"0563C1\\\", underline=\\\"single\\\")\\nTHIN = Side(style=\\\"thin\\\", color=\\\"B0B0B0\\\")\\nBOX = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)\\n\\nwb = Workbook()\\n\\n# ============================================================ Lists (hidden)\\nlists_ws = wb.create_sheet(\\\"Lists\\\")\\nLISTS = {\\n    \\\"A\\\": (\\\"What happened\\\", [\\n        \\\"Target interest\\\", \\\"Bidder interest\\\", \\\"Target sale decision\\\", \\\"Activist pressure\\\",\\n        \\\"Activist involvement\\\", \\\"Adviser engaged\\\", \\\"Adviser service observed\\\", \\\"Adviser ended\\\",\\n        \\\"Contact\\\", \\\"NDA signed\\\", \\\"Round opened\\\", \\\"Deadline set\\\", \\\"Deadline revised\\\", \\\"Deadline\\\",\\n        \\\"Target decision\\\", \\\"Information access changed\\\", \\\"Material process update\\\",\\n        \\\"Exclusivity changed\\\", \\\"Bid\\\", \\\"Bid reaffirmed\\\", \\\"Offer update\\\", \\\"Other-scope bid\\\",\\n        \\\"Valuation statement\\\", \\\"Bidding group changed\\\", \\\"Joined group\\\", \\\"Dropped by target\\\",\\n        \\\"Withdrew\\\", \\\"Did not submit\\\", \\\"Participation paused\\\", \\\"Re-entered\\\",\\n        \\\"Not selected at signing\\\", \\\"Sale process announced\\\", \\\"Bid announced\\\", \\\"Merger announced\\\",\\n        \\\"Merger agreement signed\\\", \\\"Go-shop changed\\\", \\\"Process terminated\\\", \\\"Process restarted\\\",\\n        \\\"Agreement terminated\\\", \\\"Closed\\\"]),\\n    \\\"B\\\": (\\\"Type\\\", [\\\"Strategic\\\", \\\"Financial\\\", \\\"Mixed\\\", \\\"Unknown\\\"]),\\n    \\\"C\\\": (\\\"Formality\\\", [\\\"Formal\\\", \\\"Informal\\\", \\\"Insufficient evidence\\\", \\\"Varies\\\"]),\\n    \\\"D\\\": (\\\"Conditions level\\\", [\\\"None\\\", \\\"Light\\\", \\\"Heavy\\\", \\\"Insufficient evidence\\\", \\\"Varies\\\"]),\\n    \\\"E\\\": (\\\"Include\\\", [\\\"Yes\\\", \\\"No\\\"]),\\n    \\\"F\\\": (\\\"Date basis\\\", [\\\"Reported day\\\", \\\"Inferred day\\\", \\\"Reported interval\\\", \\\"Approximate window\\\",\\n                         \\\"Relative only\\\", \\\"Undated\\\"]),\\n    \\\"G\\\": (\\\"Date method\\\", [\\\"Reported\\\", \\\"Inferred\\\", \\\"Assigned: deadline\\\", \\\"Assigned: decision day\\\",\\n                          \\\"Assigned: midpoint\\\", \\\"Assigned: bound\\\", \\\"Assigned: sequence\\\"]),\\n    \\\"H\\\": (\\\"Price kind\\\", [\\\"Point\\\", \\\"Bidder range\\\", \\\"Group envelope\\\", \\\"Bound only\\\", \\\"Undisclosed\\\"]),\\n    \\\"I\\\": (\\\"Price origin\\\", [\\\"Stated\\\", \\\"Carried forward\\\", \\\"Inferred\\\"]),\\n    \\\"J\\\": (\\\"All cash\\\", [\\\"Yes\\\", \\\"No\\\", \\\"Not stated\\\"]),\\n    \\\"K\\\": (\\\"Deadline treatment\\\", [\\\"Extended\\\", \\\"Late bids accepted\\\", \\\"Enforced\\\", \\\"Passed without action\\\",\\n                                 \\\"Unclear\\\", \\\"No deadline stated\\\", \\\"Extended; Late bids accepted\\\"]),\\n    \\\"L\\\": (\\\"Round finality\\\", [\\\"Announced as final\\\", \\\"Inferred final\\\", \\\"Not final\\\"]),\\n    \\\"M\\\": (\\\"Decided by\\\", [\\\"Bidder\\\", \\\"Target\\\", \\\"Both\\\", \\\"Unknown\\\"]),\\n    \\\"N\\\": (\\\"Exit reason\\\", [\\\"Value below market price\\\", \\\"Value at or below market price\\\",\\n                          \\\"Value below earlier offer\\\", \\\"Value at earlier offer\\\",\\n                          \\\"Would not improve earlier offer\\\", \\\"Lower offer than rivals\\\",\\n                          \\\"Terms or process\\\", \\\"Other stated reason\\\", \\\"Not stated\\\"]),\\n    \\\"O\\\": (\\\"Outcome basis\\\", [\\\"Stated\\\", \\\"Inferred: residual\\\", \\\"Inferred: exclusivity\\\",\\n                            \\\"Inferred: silent\\\", \\\"Inferred: identity\\\"]),\\n}\\nfor col, (name, vals) in LISTS.items():\\n    lists_ws[f\\\"{col}1\\\"] = name\\n    for i, v in enumerate(vals, start=2):\\n        lists_ws[f\\\"{col}{i}\\\"] = v\\nlists_ws.column_dimensions['A'].width = 32\\nfor c in \\\"BCDEFGHIJKLMNO\\\":\\n    lists_ws.column_dimensions[c].width = 30\\nlists_ws.sheet_state = 'hidden'\\n\\n# ============================================================ Source text\\nsrc_ws = wb.create_sheet(\\\"Source text\\\")\\nsrc_ws.append([\\\"Paragraph\\\", \\\"Section\\\", \\\"Page\\\", \\\"Text\\\"])\\nfor c in range(1, 5):\\n    src_ws.cell(row=1, column=c).font = BOLD\\n    src_ws.cell(row=1, column=c).fill = HDRFILL\\nsrc_row_of = {}          # source id -> row number\\nr = 1\\nfor pid, sec, pg, text in LD.P_ROWS:\\n    r += 1\\n    src_ws.cell(row=r, column=1, value=pid)\\n    src_ws.cell(row=r, column=2, value=sec)\\n    src_ws.cell(row=r, column=3, value=pg)\\n    src_ws.cell(row=r, column=4, value=text)\\n    src_row_of[pid] = r\\nfor xid, sec, pg, text in LD.X_ROWS:\\n    r += 1\\n    src_ws.cell(row=r, column=1, value=xid)\\n    src_ws.cell(row=r, column=2, value=sec)\\n    src_ws.cell(row=r, column=3, value=pg)\\n    src_ws.cell(row=r, column=4, value=text)\\n    src_row_of[xid] = r\\nfor rr in range(2, r + 1):\\n    for cc in range(1, 5):\\n        src_ws.cell(row=rr, column=cc).alignment = WRAP\\nsrc_ws.column_dimensions['A'].width = 12\\nsrc_ws.column_dimensions['B'].width = 46\\nsrc_ws.column_dimensions['C'].width = 7\\nsrc_ws.column_dimensions['D'].width = 150\\nsrc_ws.freeze_panes = \\\"A2\\\"\\nsrc_ws.auto_filter.ref = f\\\"A1:D{r}\\\"\\n\\n# ============================================================ Deal ledger\\nled = wb.create_sheet(\\\"Deal ledger\\\", 0)\\nVIS = [\\\"#\\\", \\\"When\\\", \\\"Who\\\", \\\"What happened\\\", \\\"Process\\\", \\\"Round\\\", \\\"Type\\\", \\\"Terms or outcome\\\",\\n       \\\"Formality\\\", \\\"Conditions level\\\", \\\"Why and evidence\\\", \\\"Source\\\", \\\"Review\\\", \\\"Reviewer note\\\"]\\nEXP = [(\\\"Row id\\\", 9), (\\\"Include\\\", 9), (\\\"Count\\\", 7),\\n       (\\\"Date from\\\", 11), (\\\"Date to\\\", 11), (\\\"Working date\\\", 12), (\\\"Date basis\\\", 16),\\n       (\\\"Date method\\\", 18),\\n       (\\\"Price low\\\", 10), (\\\"Price high\\\", 10), (\\\"Price kind\\\", 13), (\\\"Price origin\\\", 14),\\n       (\\\"Currency\\\", 9),\\n       (\\\"All cash\\\", 9), (\\\"Cash at closing\\\", 14),\\n       (\\\"Conditions detail\\\", 60),\\n       (\\\"Due date\\\", 11), (\\\"Deadline treatment\\\", 18), (\\\"Round finality\\\", 18),\\n       (\\\"Decided by\\\", 11), (\\\"Exit reason\\\", 26), (\\\"Outcome basis\\\", 18),\\n       (\\\"Page\\\", 7), (\\\"Related rows\\\", 34), (\\\"Deal\\\", 10)]\\nheaders = VIS + [h for h, _ in EXP]\\nfor c, h in enumerate(headers, start=1):\\n    cell = led.cell(row=1, column=c, value=h)\\n    cell.font = BOLD\\n    cell.fill = HDRFILL\\n    cell.alignment = Alignment(wrap_text=True, vertical=\\\"center\\\", horizontal=\\\"center\\\")\\nwidths = [5, 26, 26, 20, 8, 7, 10, 70, 11, 13, 90, 18, 8, 22] + [w for _, w in EXP]\\nfor c, w in enumerate(widths, start=1):\\n    led.column_dimensions[get_column_letter(c)].width = w\\n\\ndef setv(ws, row, col, val, fmt=None):\\n    cell = ws.cell(row=row, column=col, value=val)\\n    cell.alignment = WRAP\\n    if fmt:\\n        cell.number_format = fmt\\n    return cell\\n\\nDATE_FMT = \\\"MM/DD/YYYY\\\"\\nrow_records = []\\nfor i, rec in enumerate(LR.ROWS, start=1):\\n    rr = i + 1\\n    rid = f\\\"R{i:03d}\\\"\\n    row_records.append((rid, rec))\\n    # visible\\n    setv(led, rr, 1, i, \\\"0\\\")\\n    setv(led, rr, 2, rec.get('when'))\\n    setv(led, rr, 3, rec.get('who'))\\n    setv(led, rr, 4, rec.get('what'))\\n    setv(led, rr, 5, rec.get('process', 1))\\n    setv(led, rr, 6, rec.get('round'))\\n    setv(led, rr, 7, rec.get('type_'))\\n    setv(led, rr, 8, rec.get('terms'))\\n    setv(led, rr, 9, rec.get('formality'))\\n    setv(led, rr, 10, rec.get('cond'))\\n    setv(led, rr, 11, rec.get('why'))\\n    # Source: ids + hyperlink to main\\n    ids = [LD.BID2ID[b] for b in rec['src']]\\n    main_id = LD.BID2ID[rec['main']]\\n    ordered = [main_id] + [x for x in ids if x != main_id]\\n    src_text = \\\"; \\\".join(ordered)\\n    csrc = setv(led, rr, 12, src_text)\\n    tgt_row = src_row_of[main_id]\\n    csrc.hyperlink = Hyperlink(ref=csrc.coordinate, location=f\\\"'Source text'!A{tgt_row}\\\",\\n                               tooltip=f\\\"Go to {main_id}\\\")\\n    csrc.font = LINKFONT\\n    setv(led, rr, 13, rec.get('review'))\\n    setv(led, rr, 14, None)\\n    # expandable\\n    setv(led, rr, 15, rid)\\n    setv(led, rr, 16, \\\"Yes\\\")\\n    setv(led, rr, 17, rec.get('count'))\\n    setv(led, rr, 18, rec.get('dfrom'), DATE_FMT)\\n    setv(led, rr, 19, rec.get('dto'), DATE_FMT)\\n    setv(led, rr, 20, rec.get('working'), DATE_FMT)\\n    setv(led, rr, 21, rec.get('basis'))\\n    setv(led, rr, 22, rec.get('method'))\\n    setv(led, rr, 23, rec.get('plow'))\\n    setv(led, rr, 24, rec.get('phigh'))\\n    setv(led, rr, 25, rec.get('pkind'))\\n    setv(led, rr, 26, rec.get('porigin'))\\n    setv(led, rr, 27, rec.get('curr'))\\n    setv(led, rr, 28, rec.get('allcash'))\\n    setv(led, rr, 29, rec.get('cashclose'))\\n    setv(led, rr, 30, rec.get('cond_detail'))\\n    setv(led, rr, 31, rec.get('due'), DATE_FMT)\\n    setv(led, rr, 32, rec.get('dtreat'))\\n    setv(led, rr, 33, rec.get('finality'))\\n    setv(led, rr, 34, rec.get('decided'))\\n    setv(led, rr, 35, rec.get('exitr'))\\n    setv(led, rr, 36, rec.get('obasis'))\\n    setv(led, rr, 37, rec.get('page'))\\n    setv(led, rr, 38, rec.get('related'))\\n    setv(led, rr, 39, rec.get('deal', 'Mac-Gray'))\\n    for cc in range(1, 40):\\n        led.cell(row=rr, column=cc).border = BOX\\n\\nlast = len(LR.ROWS) + 1\\nled.auto_filter.ref = f\\\"A1:AM{last}\\\"\\nled.freeze_panes = \\\"E2\\\"\\n\\n# collapse + outline the expandable fields (O..AM)\\nfor c in range(15, 40):\\n    L = get_column_letter(c)\\n    led.column_dimensions[L].hidden = True\\n    led.column_dimensions[L].outlineLevel = 1\\n\\n# data validations\\ndef dv(col, listcol, title):\\n    d = DataValidation(type=\\\"list\\\", formula1=f\\\"=Lists!${listcol}$2:${listcol}${len(LISTS[listcol][1])+1}\\\",\\n                       allow_blank=True, showDropDown=False)\\n    d.promptTitle = title\\n    d.prompt = \\\"Choose a value from the Lists sheet.\\\"\\n    led.add_data_validation(d)\\n    d.add(f\\\"{col}2:{col}{last}\\\")\\n\\ndv('D', 'A', 'What happened')\\ndv('G', 'B', 'Type')\\ndv('I', 'C', 'Formality')\\ndv('J', 'D', 'Conditions level')\\ndv('P', 'E', 'Include')\\ndv('U', 'F', 'Date basis')\\ndv('V', 'G', 'Date method')\\ndv('Y', 'H', 'Price kind')\\ndv('Z', 'I', 'Price origin')\\ndv('AB', 'J', 'All cash')\\ndv('AF', 'K', 'Deadline treatment')\\ndv('AG', 'L', 'Round finality')\\ndv('AH', 'M', 'Decided by')\\ndv('AI', 'N', 'Exit reason')\\ndv('AJ', 'O', 'Outcome basis')\\n\\n# ============================================================ Summary\\nsum_ws = wb.create_sheet(\\\"Summary\\\", 1)\\nsum_ws.column_dimensions['A'].width = 34\\nsum_ws.column_dimensions['B'].width = 150\\n\\nsrow = 0\\ndef s_head(t):\\n    global srow\\n    srow += 1\\n    c = sum_ws.cell(row=srow, column=1, value=t)\\n    c.font = Font(bold=True, size=12)\\n    sum_ws.cell(row=srow, column=2, value=None)\\n\\ndef s_pair(label, text):\\n    global srow\\n    srow += 1\\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\\n    b = sum_ws.cell(row=srow, column=2, value=text); b.alignment = WRAP\\n\\ndef s_text(text):\\n    global srow\\n    srow += 1\\n    b = sum_ws.cell(row=srow, column=2, value=text); b.alignment = WRAP\\n\\ndef s_formula(label, formula, note=None):\\n    global srow\\n    srow += 1\\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\\n    b = sum_ws.cell(row=srow, column=2, value=formula); b.alignment = WRAP\\n    if note:\\n        srow += 1\\n        sum_ws.cell(row=srow, column=2, value=note).alignment = WRAP\\n\\ndef s_count(label, value):\\n    global srow\\n    srow += 1\\n    a = sum_ws.cell(row=srow, column=1, value=label); a.font = BOLD; a.alignment = WRAP\\n    b = sum_ws.cell(row=srow, column=2, value=value); b.alignment = WRAP\\n\\nc = sum_ws.cell(row=1, column=1, value=\\\"MAC-GRAY / CSC SERVICEWORKS - DEAL LEDGER SUMMARY\\\")\\nc.font = Font(bold=True, size=14)\\nsrow = 1\\ns_head(\\\"1. Status and commercial account\\\")\\ns_pair(\\\"AI status\\\", \\\"AI first pass; not human-approved. Instruction: revision of 19 September 2026 (short form).\\\")\\ns_pair(\\\"Source coverage\\\", \\\"DEFM14A filed 12/04/2013; work only from this filing and the instruction. Complete Background of the Merger selected and reproduced on the Source text sheet in source order (P-001 to P-088, printed pages 27-41); other filing passages used are X-001 to X-031. Source text is HTML-derived: whitespace normalized, page-break artifacts and repeated 'Table of Contents' headers removed; paragraphs split by printed page breaks appear as separate '(cont.)' rows; no wording changes. Local source filename: raw_filing/mac-gray_2013-12-04_DEFM14A.htm.\\\")\\ns_pair(\\\"Commercial account\\\", \\\"Initiation: after CSC's sale to Pamplona closed in May 2013, Mac-Gray's board explored strategic alternatives, and on June 24, 2013 the Special Committee concluded a sale was in stockholders' best interests and authorized its banker to solicit 50 parties (15 strategic, 35 financial); Party A had already made an unsolicited $17.00-$19.00 all-cash proposal on June 21, 2013. Competition: four bidder units - Party A (strategic), Party B and Party C (unnamed financial sponsors) and CSC/Pamplona (operating buyer CSC funded by sponsor Pamplona) - were individually recorded among 20 NDA signers and advanced through management meetings and two rounds of revised and final indications, while 16 other signers never submitted. Price path: CSC/Pamplona moved $18.50 (07/23) to $19.50 (09/09) to $20.75 (09/18) and to $21.25 last and best (09/21); Party B peaked at a $21.50-valued package ($19.00 cash plus options) whose cash and certainty lagged; Party A held at $18.00-$19.00 as best and final; Party C stopped at $16.00-$17.00 and did not respond to the final solicitation. Selection: on 09/19 the Special Committee found CSC/Pamplona's proposal most valuable with greater certainty and authorized exclusivity at $21.25; exclusivity was executed 09/24/2013 (to 5 p.m. ET 10/12, extended to 11:59 p.m. ET 10/15) with a $15 million reverse termination fee and no financing contingency, Pamplona committed $594 million, and Moab and Mr. MacDonald did not roll over shares. Signing and publicity: the merger agreement was signed 10/14/2013 and announced 10/15/2013; voting agreements covered about 15% of shares; the proxy shows no competing proposal or go-shop and sets the special meeting for 01/08/2014. Observed outcome: signed, not closed - completion expected in the first half of 2014, the HSR waiting period expired 11/27/2013, and a putative class action was filed 11/21/2013.\\\")\\ns_head(\\\"2. Deal facts\\\")\\ns_pair(\\\"Target\\\", \\\"Mac-Gray Corporation (Delaware; NYSE-listed; Waltham, Massachusetts), second largest U.S. laundry facilities management contractor. [X-002]\\\")\\ns_pair(\\\"Focal acquirer and type\\\", \\\"CSC/Pamplona - the acquisition unit of CSC ServiceWorks, Inc. (operating acquirer; the filing calls Party A and CSC/Pamplona its two 'strategic bidders') with equity capital committed by Pamplona Capital Partners III, L.P., part of Pamplona Capital Management, which bought CSC in May 2013. Acquisition chain: Parent = Spin Holdco Inc. (wholly owned by CSC); Merger Subsidiary = CSC Fenway, Inc.; Holdings = CSC ServiceWorks Holdings, Inc. Type = Strategic (operating-company acquisition role); sponsor ownership and sponsor financing do not make it Financial, and it is not Mixed. [P-002, P-034, X-001, X-003, X-005, X-006]\\\")\\ns_pair(\\\"Agreed consideration\\\", \\\"$21.25 per share in cash, without interest; all-cash; all outstanding shares converted at the effective time; no financing condition. Cash at closing: $21.25 per share. [X-009, X-010, X-013, X-029]\\\")\\ns_pair(\\\"Signing / announcement / completion\\\", \\\"Merger agreement signed 10/14/2013; jointly announced 10/15/2013 before market open; completion expected in the first half of 2014 and NOT observed in the filing (no closed-transaction row). End date 03/31/2014, extendable to 07/31/2014 if only the HSR condition remains. [P-101, P-102, X-016, X-028]\\\")\\ns_pair(\\\"Filing identity\\\", \\\"DEFM14A, Mac-Gray Corporation, filed 12/04/2013; source file raw_filing/mac-gray_2013-12-04_DEFM14A.htm; Background of the Merger at printed pages 27-41; record date 11/27/2013; special meeting 01/08/2014 at 10:00 a.m. Boston. [X-007, X-008]\\\")\\ns_pair(\\\"Market benchmarks (dates)\\\", \\\"Unaffected reference close $14.72 on 10/11/2013 (last trading day before board approval); 52-week high $15.61 for the period ending 10/11/2013; market close $21.30 on 11/27/2013. Agreed price represents approximately 36% premium to the 52-week high and approximately 44% to the 10/11/2013 close. [X-010, X-011, X-012, X-027]\\\")\\ns_pair(\\\"Shares and ownership\\\", \\\"14,758,306 shares outstanding and entitled to vote as of 11/27/2013; voting agreements covered approximately 15% of shares (2,697,484 shares per the 10/23/2013 Schedule 13D, beneficial ownership disclaimed by Parent, Merger Subsidiary, Holdings, CSC, Pamplona and Pamplona Capital Management entities). Moab held approximately 9% in June 2013. [X-007, X-019, X-030]\\\")\\ns_pair(\\\"Financing\\\", \\\"$594 million committed by Pamplona Capital Partners III, L.P. under a commitment letter dated 10/14/2013 for closing funding and related obligations; no financing condition to closing; Pamplona and the Buyer Entities jointly and severally liable for breaches with Pamplona's damages liability capped at $50 million (Buyer Entities unlimited). [X-013, X-031]\\\")\\ns_pair(\\\"Termination fees\\\", \\\"$11 million payable by Mac-Gray (as finally agreed 10/11/2013; earlier proposals were $15 million and $10.5 million); $15 million Parent termination fee. Deal-protection terms are not separate ledger rows per instruction; the fee history appears in the Background (P-079 to P-095). [X-017]\\\")\\ns_pair(\\\"Optional labelled calculation\\\", \\\"Equity value at the record-date share count = 14,758,306 x $21.25 = formula below (calculation, not a filing assertion; the filing does not state a total equity value, and the termination-fee percentage statements imply larger totals of roughly $341-$350 million on a different share base). No net debt, option, RSU or dilution adjustments are assumed.\\\")\\ns_formula(\\\"Equity value (optional; ledger input)\\\", \\\"=14758306*21.25\\\",\\n          \\\"Sources for inputs: X-007 (shares outstanding) and X-009 (price per share). Excluded from bid-count formulas; flagged as a derived calculation.\\\")\\ns_head(\\\"3. Process and round map\\\")\\ns_pair(\\\"Process map\\\", \\\"One sale process (Process 1). Earlier context: the 2011-2012 Discussions were Mac-Gray's prospective acquisition of CSC, not a Mac-Gray sale process (no Process terminated/restarted rows). No separate post-signing stage opened: the proxy discloses no competing proposal, no go-shop and no agreement termination as of 12/04/2013.\\\")\\ns_pair(\\\"Round 0 (pre-opening)\\\", \\\"No organized round and no Round opened row. Party A contact 04/08/2013 (R003) and unsolicited pre-NDA proposal 06/21/2013 $17.00-$19.00 (R008), standing when round 1 began. Adviser and activist context rows (R001-R007).\\\")\\ns_pair(\\\"Round 1 (R009, opens 06/24/2013)\\\", \\\"R1 anchor: 06/24/2013 Special Committee decision to consider a sale and authorize solicitation of 50 parties; rejected candidate anchors R008 (06/21 proposal) and R012 (06/28 first NDA); first outreach-wave date not disclosed. Objective: initial outreach and preliminary IOIs. Participants: 50 parties approached (15 strategic, 35 financial); 20 NDA signers entered (R012, R013, R015, R016). Deadline 07/23/2013, treatment Late bids accepted (on-time CSC/Pamplona R018; Party B 07/24 R020; Party C 07/24-25 R021, R023). Finality Not final. Round bidders 4: CSC/Pamplona $18.50, Party B $17.00-$18.00, Party C $15.00-$17.00 (oral), plus Party A's standing $17.00-$19.00 from R008 (explicit inclusion). Ending: 16 residual signers closed as non-submitters (R019); four bidders advanced.\\\")\\ns_pair(\\\"Round 2 (R022, opens 07/25/2013)\\\", \\\"Objective: staged information access and management meetings, then revised indications. Participants: Party A, Party B, Party C, CSC/Pamplona (R023 written IOI; NDA R024). Differential access row R025 (financial bidders broad data-site access; strategic bidders limited, customer data withheld). Deadline set 08/27/2013 for 09/09/2013 (R026); treatment Late bids accepted (CSC/Pamplona and Party B 09/09 R028-R029; Party A and Party C 09/10 R030-R031; reviewed 09/11). Finality Not final. Round bidders 4: CSC/Pamplona $19.50, Party B $18.50, Party A $18.00-$19.00, Party C $16.00-$17.00. Alternative anchor candidate (rejected): R026 (08/27 letter).\\\")\\ns_pair(\\\"Round 3 (R033, opens 09/11/2013)\\\", \\\"Objective: first request for final indications of interest, with possible short exclusive negotiation. Participants: the same four. Deadline 09/18/2013 (R034), treatment Enforced (target's next step 09/19). Finality Announced as final. Round bidders 3: CSC/Pamplona $20.75 (R035), Party B $21.50-valued package (R037), Party A reaffirmed $18.00-$19.00 best and final (R036); Party C did not submit (R038). Selection 09/19 (R039); final price $21.25 agreed 09/21 (R040).\\\")\\ns_pair(\\\"Round 4 (R042, opens 09/24/2013)\\\", \\\"Objective: exclusive negotiation and definitive agreement with selected bidder CSC/Pamplona, beginning on execution of the exclusivity agreement (R041). Participants: CSC/Pamplona only; Party A and Party B closed the same day by exclusivity (R043, R044). No bid-submission deadline; exclusivity expiry 5 p.m. ET 10/12/2013 was extended to 11:59 p.m. ET 10/15/2013 (R047). Finality Inferred final. Signing R048 (10/14) and announcement R049 (10/15). Alternative treatment (fold into round 3) flagged in Q1.\\\")\\ns_pair(\\\"Post-signing\\\", \\\"No competing proposal, go-shop start/change or agreement termination is disclosed as of 12/04/2013. Regulatory: HSR filings 10/29/2013, early termination not granted, waiting period expired 11/27/2013 [X-021]. Litigation: putative class action filed 11/21/2013 [X-022]. These belong here, not as ledger rows.\\\")\\ns_head(\\\"4. Participants and advisers\\\")\\ns_pair(\\\"Party A (strategic; unnamed)\\\", \\\"First observed 04/08/2013 contact (R003); pre-NDA proposal 06/21/2013 (R008); NDA 08/05/2013 (R024); revised indication 09/10/2013 (R030); best-and-final reaffirmation 09/18/2013 (R036); closed Dropped by target on 09/24/2013 by exclusivity (R043; inferred; exit reason Would not improve earlier offer). Type basis: laundry-industry strategic party, one of the filing's two named strategic bidders [P-034].\\\")\\ns_pair(\\\"Party B (financial; unnamed)\\\", \\\"First observed NDA 06/28/2013 (R012); IOIs 07/24, 09/09 and the $21.50-valued cash-plus-options proposal 09/18/2013 (R020, R029, R037); closed Dropped by target on 09/24/2013 by exclusivity (R044; inferred; exit reason Terms or process). Type basis: one of the 18 financial bidders, with affiliated-fund equity [P-034, P-052].\\\")\\ns_pair(\\\"Party C (financial; unnamed)\\\", \\\"First observed NDA 06/30/2013 (R013); oral and written IOIs 07/24-25 (R021, R023) and revised oral indication 09/10/2013 (R031); did not submit at the final-indications solicitation and gave no reasons; closed Did not submit on 09/18/2013 (R038; stated; agency Unknown). Type basis: one of the financial bidders [P-034].\\\")\\ns_pair(\\\"CSC/Pamplona (strategic; winner)\\\", \\\"First observed contact 06/28/2013 (R011); NDA 07/11/2013 (R015); bids 07/23 $18.50, 09/09 $19.50, 09/18 $20.75 and 09/21 $21.25 last and best (R018, R028, R035, R040); exclusivity 09/24/2013 (R041); signing 10/14/2013 (R048). No exit row (winner). Unit composition: CSC ServiceWorks, Inc. (operating acquirer) and Pamplona (equity capital commitment); Pamplona's funding is support, not a membership change or joint-bidder formation.\\\")\\ns_pair(\\\"16 residual NDA signers (financial)\\\", \\\"Entered as residual cohort of 20 signers less the four recorded individually (R016; count 16); closed Did not submit by 07/23/2013 (R019; inferred residual; base assumes all 20 were eligible - flagged Q3).\\\")\\ns_pair(\\\"Moab Partners, L.P. (shareholder, approximately 9%)\\\", \\\"Not a bidder. Proxy contest and two directors elected 05/30/2013 (R007); rollover request denied 07/06/2013 (R014) and resolved without a rollover by 10/07/2013 (R046); voting agreement at signing (R048).\\\")\\ns_pair(\\\"Stewart G. MacDonald, Jr. (CEO; significant holder)\\\", \\\"Not a bidder. Excluded from sale-process evaluation 06/24/2013 (R009); declined a share rollover 09/11/2013 and wanted a higher value (R032); supportive of $21.25 (R039); voting agreement effective at signing (R048).\\\")\\ns_pair(\\\"Advisers\\\", \\\"BofA Merrill Lynch (Merrill Lynch, Pierce, Fenner & Smith Incorporated) - Mac-Gray's financial advisor: 2011-2012 Discussions engagement 10/23/2012 (R001), terminated 05/15/2013 (R005), re-engaged for the sale process by Board approval 05/30/2013 with engagement letter 05/31/2013 (R006); delivered the fairness opinion dated 10/14/2013 [X-026]. Goodwin Procter LLP - outside legal counsel to Mac-Gray (observed acting from 05/09/2013, R004; drafted the merger agreement and advised the Special Committee throughout). Kirkland & Ellis LLP - outside legal counsel to CSC/Pamplona from 09/25/2013 (R042 note). Clients are as stated by the filing; no unclear client affiliations identified.\\\")\\ns_head(\\\"5. Counts and auction screen\\\")\\ns_formula(\\\"NDA signers (ledger)\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$D:$D,\\\\\\\"NDA signed\\\\\\\")\\\",\\n          \\\"Filing assertion: 20 (two strategic bidders - Party A and CSC/Pamplona - and 18 financial bidders, including Party B and Party C) [P-034]. Ledger = 4 individually recorded signers + 16 residual cohort = 20; reconciles exactly. Residual dates and eligibility are uncertain (Q3).\\\")\\ns_formula(\\\"First sale-related contacts (ledger)\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$D:$D,\\\\\\\"Contact\\\\\\\")\\\",\\n          \\\"Filing process-level assertion: 50 parties approached (15 strategic, 35 financial) [P-032, P-033]. Only Party A (04/08/2013) and CSC/Pamplona (06/28/2013) are individually dated; the other contacts are not individually reported, so no exact reconciliation is claimed.\\\")\\ns_formula(\\\"Round-1 round bidders (submissions)\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,1,'Deal ledger'!$D:$D,\\\\\\\"Bid\\\\\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,1,'Deal ledger'!$D:$D,\\\\\\\"Bid reaffirmed\\\\\\\")\\\",\\n          \\\"Explicit inclusion: + 1 standing round-0 proposal (Party A, R008, whose Bid row sits in round 0 but who participated in round 1) = 4 round bidders. Units, not submissions or unique firms.\\\")\\ns_formula(\\\"Round-2 round bidders\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,2,'Deal ledger'!$D:$D,\\\\\\\"Bid\\\\\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,2,'Deal ledger'!$D:$D,\\\\\\\"Bid reaffirmed\\\\\\\")\\\",\\n          \\\"Four units: CSC/Pamplona, Party B, Party A, Party C. Not a submission count (Party C has two rows in round 1 and one in round 2; revisions carry Count 0).\\\")\\ns_formula(\\\"Round-3 round bidders\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$D:$D,\\\\\\\"Bid\\\\\\\")+SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$F:$F,3,'Deal ledger'!$D:$D,\\\\\\\"Bid reaffirmed\\\\\\\")\\\",\\n          \\\"Three units (CSC/Pamplona, Party B, Party A); Party C did not submit and is an outcome row (R038), not a round bidder. Round 4 has no bid rows: one unit continued in exclusive definitive negotiation.\\\")\\ns_formula(\\\"Outcome tallies (affected units)\\\",\\n          \\\"=SUMIFS('Deal ledger'!$Q:$Q,'Deal ledger'!$P:$P,\\\\\\\"Yes\\\\\\\",'Deal ledger'!$D:$D,\\\\\\\"Dropped by target\\\\\\\")\\\",\\n          \\\"Dropped by target = 2 units (Party A, Party B at 09/24). Did not submit: 16 residual at 07/23 (R019) + Party C at 09/18 (R038) = 17 units; formula above shows only the Dropped tally; totals are occurrences/affected units, not unique permanent exits. Winner CSC/Pamplona has no exit row.\\\")\\ns_pair(\\\"Auction screen\\\", \\\"Met: more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements for this process - four units are individually recorded (Party A, Party B, Party C, CSC/Pamplona) among 20 signers total. Excluded: no lender-only, adviser or rollover-holder agreements reported; no agreements expressly reused from an earlier attempt (the 2011-2012 Discussions produced no reused NDA).\\\")\\ns_pair(\\\"Per-stage balance (participants)\\\", \\\"R0: entrants 1 (Party A) - exits 0 = 1 live. R1: entrants +19 (16 cohort + Party B + Party C + CSC/Pamplona; Party A already in) = 20; exits -16 (residual non-submitters, R019) = 4. R2: exits 0 = 4. R3: exits -1 (Party C, R038) = 3. R4: exits -2 (Party A and Party B by exclusivity, R043-R044) = 1 = winner at signing (R048); no participant left open. Inferred share of exits: 18 of 19 (the 16 residual plus the two exclusivity drops); Party C's exit is stated. Counts are tally contributions, not population balances.\\\")\\ns_head(\\\"6. Comparability and inputs\\\")\\ns_pair(\\\"Other-scope proposals\\\", \\\"None: every recorded proposal concerns acquisition of the whole company's equity. No segment, asset, minority or other-scope bids and no group price envelopes.\\\")\\ns_pair(\\\"Unusual consideration\\\", \\\"Party B's 09/18/2013 cash-plus-options package: $19.00 cash at closing plus options it valued at $2.50 per share (10% of new equity, strike at its initial cost basis, vesting over five years on base-case projections). Recorded as All cash = No; structured price cells show the cash component and the bidder's stated total ($19.00-$21.50) and are flagged as a package representation (Q7). No CVR or earnout in the signed deal.\\\")\\ns_pair(\\\"Currency and units\\\", \\\"All amounts USD per share; no currency conversion performed. Agreed consideration and all recorded bid prices are per share of Mac-Gray common stock.\\\")\\ns_pair(\\\"Stated deal inputs\\\", \\\"Shares outstanding 14,758,306 at 11/27/2013 [X-007]; market close $21.30 on 11/27/2013 [X-012]; unaffected close $14.72 and 52-week high $15.61 on 10/11/2013 [X-010, X-011, X-027]; $594 million Pamplona commitment [X-013, X-031]; $11 million / $15 million termination fees [X-017]; voting agreements approximately 15% [X-019, X-030]. No net debt, dilution, preferred or rollover conversion is assumed anywhere.\\\")\\ns_pair(\\\"Glossary\\\", \\\"NDA = confidentiality agreement (here, confidentiality and standstill agreements). IOI = indication of interest; LOI = letter of intent. Due diligence = investigation of the target. Formality: documentation/solicitation assessment (Formal/Informal), separate from Conditions level (financing and diligence conditions the bid carries). Round = target-organized solicitation, evaluation or negotiation stage (0 = before the opening; 'post' = outside an identified round). Working date = assigned sort key, not an observed date. Reverse termination fee = fee payable by the buyer side on specified termination (here $15 million). Standstill/sunset = bidder restrictions that lapse to permit proposals. HSR = Hart-Scott-Rodino antitrust waiting period. Exclusivity = period of exclusive negotiation. Rollover = shareholder contributing shares into the buyer instead of cashing out.\\\")\\ns_text(\\\"Prepared from the supplied filing only. All quotations on the Deal ledger sheet appear verbatim on the Source text sheet; tags in Terms or outcome repeat the structured fields (R1 anchor, Inferred, Bound, Support). Reviewer corrections are expected: see Questions.\\\")\\n\\n# ============================================================ Questions\\nq_ws = wb.create_sheet(\\\"Questions\\\", 2)\\nQCOLS = [\\\"Q\\\", \\\"Review topic\\\", \\\"Recommended answer\\\", \\\"Why and source\\\", \\\"Affected rows/fields\\\",\\n         \\\"Consequence of changing it\\\", \\\"Status\\\", \\\"Reviewer note\\\"]\\nfor i, h in enumerate(QCOLS, start=1):\\n    c = q_ws.cell(row=1, column=i, value=h); c.font = BOLD; c.fill = HDRFILL; c.alignment = WRAPC\\nQW = [6, 30, 70, 80, 26, 46, 11, 26]\\nfor i, w in enumerate(QW, start=1):\\n    q_ws.column_dimensions[get_column_letter(i)].width = w\\n\\nQUESTIONS = [\\n (\\\"Q1\\\", \\\"Process and round map; inferred starts; rejected boundary candidates\\\",\\n  \\\"Keep one process and the four rounds as built: R1 06/24/2013 (sale decision/50-party solicitation; rejected anchors R008 and R012); R2 07/25/2013 (staged access and revised-IOI stage; rejected alternative R026, the 08/27/2013 letter); R3 09/11/2013 (first final-indications request; Announced as final); R4 09/24/2013 (executed exclusivity and definitive negotiation; Inferred final; alternative = fold into R3). Treat the 2011-2012 Discussions as context, not a second process.\\\",\\n  \\\"Anchors follow the instruction's opening rules: R1 uses the launching decision because the first outreach wave is undated (outreach executed within days; first NDA 06/28). R2 uses the selection of advancing participants plus a stage-linked offer request (authorization R021 quote: 'authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure... and to reach out to each of the four interested bidders'); the 08/27 letter only communicated the deadline. R3 is the target's first request for final indications (R032 quote). R4 applies the 'moves to definitive negotiation with selected bidders' trigger; exclusivity inside an already-established final negotiation stage would not open a round. Sources: P-028 (R009), P-046/P-047 (R022), P-055 (R033), P-073 (R041-R042).\\\",\\n  \\\"R008, R009, R012, R022, R026, R033, R040, R041, R042; rounds/finality fields on R009/R022/R033/R042\\\",\\n  \\\"Dating R2 at 08/27 moves the start of the staged-access stage and its access row (R025); merging R4 into R3 would put exclusivity, the two closures and signing in R3 and delete the Inferred-final row; treating R1 as opening at the 06/21 proposal would pull Party A's bid out of round 0.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q2\\\", \\\"Deadline changes and elapsed-deadline treatments\\\",\\n  \\\"Keep: 07/23/2013 Late bids accepted; 09/09/2013 Late bids accepted; 09/18/2013 Enforced. No bid deadline was revised; the 10/12/2013 exclusivity expiry was extended (recorded on R047, not as a bid Deadline row).\\\",\\n  \\\"07/23: Party B (07/24) and Party C (07/24-25) were considered by the Special Committee on 07/25 without revision. 09/09: Party A and Party C submitted 09/10 and were reviewed 09/11 without extension; the target itself later solicited CSC/Pamplona's 09/21 price revision, which belongs to continuing negotiation and is not late acceptance. 09/18: the next step was selection (09/19), so Enforced. Sources: P-034, P-043, P-044, P-046 (Late bids); P-053 to P-056 (09/09); P-063 to P-066 (09/18 selection); P-095 to P-097 (extension).\\\",\\n  \\\"R010, R017, R019, R026, R027, R034, R044, R047; Deadline treatment and Due date fields\\\",\\n  \\\"Re-labelling 07/23 or 09/09 as Enforced, or 09/18 as Unclear, changes the term the target applied to its stage and implies (unsupported) formal revision or inaction.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q3\\\", \\\"Inferred residual rows and NDA population uncertainty\\\",\\n  \\\"Retain the 16-person residual for the NDA cohort (R016) and for the 07/23 non-submission (R019), base = 20 signers. Keep the caveat that only the four individually dated signers are certain; all eligibility arithmetic uses the filing's stated totals.\\\",\\n  \\\"Base and split: P-034 ('a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders'). Accounting at the first transition: P-045 names only Party B, Party C, CSC/Pamplona and Party A's standing proposal. Arithmetic: 20 - 4 = 16. Uncertainty: the 16 signers' dates are unstated and signers whose NDAs postdate 07/23 would reduce the residual; Party A signed only on 08/05 but is shown continuing, so it is not in the residual.\\\",\\n  \\\"R012, R013, R015, R016, R019, R020, R021, R022, R024; Count/Dates fields on R016 and R019\\\",\\n  \\\"Changing the base or the accounted-for set changes both inferred Counts and the per-stage balance; adding individual rows for anonymous members would invent identities.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q4\\\", \\\"Participation outcomes and agency (including every inferred closing row)\\\",\\n  \\\"Keep: Party A and Party B Dropped by target on 09/24/2013 (Inferred: exclusivity; Decided by Target; reasons Would not improve earlier offer and Terms or process); Party C Did not submit on 09/18/2013 (stated; Decided by Unknown; Not stated); winner no exit row. No participant left open.\\\",\\n  \\\"Exclusivity was executed 09/24/2013 with CSC/Pamplona with no notice to Party A or Party B reported (P-073; Party A's last act P-064). Party C's non-submission and absence of reasons are stated in P-064/P-065; the filing reports no notice or discouragement, so agency is left Unknown. Convention: every participant that entered is closed once.\\\",\\n  \\\"R019, R038, R043, R044; Decided by / Exit reason / Outcome basis fields\\\",\\n  \\\"Assigning withdrawals or bidder agency without notice evidence would misstate participation; failing to close A and B would break the per-stage balance at signing.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q5\\\", \\\"Formality of the final-stage indications (borderline Formal calls)\\\",\\n  \\\"Keep Formal for the 09/18/2013 responses (CSC/Pamplona $20.75; Party B $21.50 package) and for Party A's best-and-final reaffirmation, carried to CSC/Pamplona's 09/21/2013 last-and-best. Alternative for Party A: Informal if a phone reiteration is judged not to be a response on the requested written basis. Earlier IOIs remain Informal.\\\",\\n  \\\"Formality signal 2: 'a response on the requested basis to a genuine final, binding or best-and-final solicitation'; a non-binding IOI can be Formal; no retrospective upgrading of earlier offers. Sources: P-064 (09/18 responses), P-055 (final request), P-067 (09/21 confirmation). Party A's call is the borderline case and is flagged here rather than upgraded silently.\\\",\\n  \\\"R035, R036, R037, R040; Formality fields; context rows R008, R018, R020, R021, R023, R028-R031\\\",\\n  \\\"Downgrading Party A changes only its row label (its exit basis is unaffected); upgrading earlier IOIs would contradict the no-retrospective-upgrade rule.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q6\\\", \\\"Conditions levels that turn on diligence or financing statements\\\",\\n  \\\"Keep Heavy for pre-substantive-diligence IOIs (R008, R018, R020, R021, R023) and for Party B's later bids (R029, R037 - reported absence of a firm financing commitment). Keep Light for CSC/Pamplona's 09/09 and later bids (R028, R035, R040 - committed sponsor financing, no stated diligence condition). Keep Insufficient evidence for Party C's 09/10/2013 revised indication (R031 - price only, financing silence).\\\",\\n  \\\"Heavy-by-context applies to preliminary indications made before data-room or management access; 'less conditional' comparisons were not converted into absolute levels; silence neither raises nor lowers a level. Sources: P-034, P-043 to P-045 (pre-DD IOIs), P-054 (CSC/Pamplona committed funding; Party B no firm commitment), P-055 (Party C silence), P-040 (access staging).\\\",\\n  \\\"R008, R018, R020, R021, R023, R028-R031, R035-R037, R040; Conditions level and Conditions detail fields\\\",\\n  \\\"Reassigning a level changes the comparable conditionality of final offers and the four documented Heavy-by-context calls at the first stage.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q7\\\", \\\"Price representation for Party B's cash-plus-options package and related conventions\\\",\\n  \\\"Keep Price low 19.00 / Price high 21.50 with Price kind Bidder range, All cash No and Cash at closing 19.00, with Terms stating that the cells show the cash component and the bidder's stated total valuation - a package, not a submitted range. Alternative: blank the structured price cells and keep the package only in Terms.\\\",\\n  \\\"The filing gives $19.00 cash at closing plus options valued at $2.50 (total $21.50) (P-064); the instruction directs that package values be attributed, not treated as guaranteed cash, and that the contingent part stay in Terms. Sources: P-064, P-066 (Special Committee risk view).\\\",\\n  \\\"R037; Price low/high/kind/origin, All cash, Cash at closing fields; comparability note in Summary section 6\\\",\\n  \\\"Blank cells reduce structured comparability but avoid any reading of $21.50 as cash; leaving as recorded preserves the bidder's own valuation with an explicit flag.\\\",\\n  \\\"Pending\\\", None),\\n (\\\"Q8\\\", \\\"Date conventions and record-keeping items\\\",\\n  \\\"Accept the assigned Working dates and their methods: residual NDA midpoint 07/17/2013 (R016); 07/23/2013 deadline-set row by sequence (R010); Moab resolution bounded to 10/07/2013 (R046); inferred closures assigned to deadline/decision days (R019, R038, R043, R044). Accept the preserved source typo 'July 27, 2103' with the proposed correction to 2013 (R024), and the structural choices: one row each for the Moab and MacDonald rollover relationships, adviser rows for BofA (old and new mandates) and Goodwin Procter service, and no rows for termination/reverse fees, liability caps, voting agreements, post-signing covenants or successive drafts (folded into R040, R041, R047, R048).\\\",\\n  \\\"All are instruction conventions (sections 5.4, 8.1, 10.2) or explicit materiality exclusions (section 4); quotations on the Source text sheet preserve wording and qualification, and no working date falls outside its Date from/Date to or contradicts the filing's before/after bounds.\\\",\\n  \\\"R001, R005, R006, R010, R014, R016, R019, R024, R032, R038, R043, R044, R046, R047, R048; Date from/to, Working date, Date basis, Date method, Page fields\\\",\\n  \\\"Changing conventions reorders display or shifts assigned dates but not the underlying facts; moving the typo correction or rollover rows would affect only those rows' framing.\\\",\\n  \\\"Pending\\\", None),\\n]\\nfor i, q in enumerate(QUESTIONS, start=2):\\n    for j, v in enumerate(q, start=1):\\n        c = q_ws.cell(row=i, column=j, value=v); c.alignment = WRAP; c.border = BOX\\nq_ws.freeze_panes = \\\"A2\\\"\\nq_ws.auto_filter.ref = f\\\"A1:H{len(QUESTIONS)+1}\\\"\\n\\nwb.save(OUT)\\nprint(\\\"saved\\\", OUT)\\n\", \"path\": \"/tmp/opencode/make_workbook.py\"}"},"time":{"start":1789824928353,"end":1789824972780}}}}
