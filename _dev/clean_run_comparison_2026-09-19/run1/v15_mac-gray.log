ook.xml').decode('utf-8')\\n    rels = zin.read('xl/_rels/workbook.xml.rels').decode('utf-8')\\n    rid = re.search(r'<sheet\\\\b[^>]*name=\\\"%s\\\"[^>]*r:id=\\\"([^\\\"]+)\\\"' % re.escape(sheet_name), wbxml).group(1)\\n    target = re.search(r'<Relationship[^>]*Id=\\\"%s\\\"[^>]*Target=\\\"([^\\\"]+)\\\"' % re.escape(rid), rels).group(1)\\n    if not target.startswith('xl/'):\\n        target = 'xl/' + target.lstrip('/')\\n    sheet_xml = zin.read(target).decode('utf-8')\\n    for ref, val in values.items():\\n        pat = re.compile(r'(<c r=\\\"%s\\\"[^>]*>)(<f>.*?</f>)(</c>)' % ref)\\n        sheet_xml, n = pat.subn(lambda mo: mo.group(1) + mo.group(2) + '<v>%s</v>' % val + mo.group(3), sheet_xml)\\n        assert n == 1, (ref, n)\\n    tmp = fn + '.tmp'\\n    with zipfile.ZipFile(tmp, 'w', zipfile.ZIP_DEFLATED) as zout:\\n        for item in zin.infolist():\\n            data = zin.read(item.filename)\\n            if item.filename == target:\\n                data = sheet_xml.encode('utf-8')\\n            zout.writestr(item, data)\\n    zin.close()\\n    shutil.move(tmp, fn)\\n\\ninject_cached(OUT, \\\"Summary\\\", CACHED)\\nprint(\\\"saved\\\", OUT)\", \"oldString\": \"# reorder + hide per specification and drop the default sheet\\norder = [\\\"Deal ledger\\\", \\\"Summary\\\", \\\"Questions\\\", \\\"Source text\\\", \\\"Lists\\\"]\\nfor name in wb.sheetnames:\\n    if name not in order:\\n        del wb[name]\\nwb._sheets = [wb[n] for n in order]\\nwb.active = 0\\nwb.save(OUT)\\nprint(\\\"saved\\\", OUT)\", \"path\": \"/tmp/opencode/make_workbook.py\"}"},"time":{"start":1789825075616,"end":1789825077580}}}}
