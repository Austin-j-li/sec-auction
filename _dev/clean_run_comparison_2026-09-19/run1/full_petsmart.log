olumn=H.index(name)+1).value\n        if v == 0 and name != 'Count': zeros.append((r,name))\nprint(\"unexpected zero numerics:\", zeros)\n# source sheet stats\nfrom collections import Counter\nsecs = Counter(wsx.cell(row=r, column=2).value for r in range(3, wsx.max_row+1))\nprint(\"Source text rows:\", wsx.max_row-2, \"| note row:\", wsx.cell(row=2, column=2).value[:40])\nprint(\"P rows:\", sum(1 for k in pos if k.startswith('P-')), \"X rows:\", sum(1 for k in pos if k.startswith('X-')))\n# validations target columns\nv = {}\nfor dv in ws.data_validations.dataValidation:\n    v[str(dv.sqref)] = dv.formula1\nprint(\"validations:\", v)\n# also confirm lists count\nwl = wb['Lists']\nprint(\"Lists columns:\", wl.max_column, \"| max rows:\", wl.max_row)\n# formulas in Summary\nwsm = wb['Summary']\nfs = [(c.coordinate, c.value) for row in wsm.iter_rows() for c in row if isinstance(c.value,str) and c.value.startswith('=')]\nprint(\"summary formulas:\", [f[0] for f in fs])\n# any text cell starting with '=' outside summary formulas?\nbad2 = [(r,c) for r in range(1, ws.max_row+1) for c in range(1,len(H)+1) if isinstance(ws.cell(row=r,column=c).value,str) and ws.cell(row=r,column=c).value.startswith(('=','+','@'))]\nprint(\"formula-like text in ledger:\", bad2[:5])\nEOF"},"output":"headers equal: True\nAI original diffs: 0\nhyperlink mismatches: 0\nunexpected zero numerics: []\nSource text rows: 81 | note row: Note\nP rows: 41 X rows: 40\nvalidations: {'D2:D46': 'Lists!$A$2:$A$41', 'G2:G46': 'Lists!$B$2:$B$5', 'I2:I46': 'Lists!$C$2:$C$5', 'J2:J46': 'Lists!$D$2:$D$6', 'P2:P46': 'Lists!$E$2:$E$3', 'U2:U46': 'Lists!$F$2:$F$7', 'V2:V46': 'Lists!$G$2:$G$8', 'Y2:Y46': 'Lists!$H$2:$H$6', 'Z2:Z46': 'Lists!$I$2:$I$4', 'AB2:AB46': 'Lists!$J$2:$J$4', 'AF2:AF46': 'Lists!$K$2:$K$7', 'AG2:AG46': 'Lists!$L$2:$L$4', 'AH2:AH46': 'Lists!$M$2:$M$5', 'AI2:AI46': 'Lists!$N$2:$N$10', 'AJ2:AJ46': 'Lists!$O$2:$O$6'}\nLists columns: 15 | max rows: 41\nsummary formulas: ['C37', 'C38', 'C39', 'C40', 'C