{"type":"tool_use","timestamp":1789825545302,"sessionID":"ses_f461fdda8ffepr1o7xqEzpCNdg","part":{"partID":"prt_0b9e9f7a3001IrTSuxtuxU5f0H","sessionID":"ses_f461fdda8ffepr1o7xqEzpCNdg","messageID":"msg_0b9e8b6d0001y5RZs6dIl0k6SL","type":"tool","id":"call_00_E3XKcrQP1VYOeMfhppwq1003","tool":"shell","state":{"status":"completed","input":{"command":"cd /tmp/opencode && cat > build_ledger.py <<'PYEOF'\n# -*- coding: utf-8 -*-\nimport re, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment\nfrom openpyxl.utils import get_column_letter\n\nD = dt.date\n\n# ---------- source text for quote validation ----------\nsrc = open('filing.txt', encoding='utf-8').read()\nqpat = lambda q: re.compile(r'\\s+'.join(re.escape(w) for w in q.split()))\n\ndef check_quote(q):\n    assert qpat(q).search(src), \"QUOTE NOT FOUND: \" + q[:80]\n\n# ---------- Deal ledger rows ----------\n# columns: #, When, Who, Type, Event, Process, Round, Price low, Price high, All cash,\n#          Formality, Conditions, Count, Exit reason, Inferred, Note, Quote and page, Flag,\n#          Reviewer note, Sort date, Date from, Date to\nrows = []\n\ndef R(when, who, typ, event, proc, rnd, plo, phi, cash, form, cond, count, exitr, inf, note, quote, page, flag, sort, dfrom, dto):\n    check_quote(quote)\n    rows.append([None, when, who, typ, event, proc, rnd, plo, phi, cash, form, cond, count, exitr, inf, note, quote + \" (p. \" + page + \")\", flag, None, sort, dfrom, dto])\n\n# 1\nR(\"fourth quarter of 2015\", \"Party A\", \"Strategic\", \"Bidder interest\", 1, 0, None, None, None, None, None, 1, None, None,\n  \"Party A suggested joint ventures and raised interest in acquiring equity; meeting was for joint commercial opportunities; no price.\",\n  \"During the meeting, Party A suggested possible joint venture arrangements and expressed some interest in acquiring equity in the Company to further develop strategic opportunities and enhance regional connectivity.\", \"27\", None, D(2015,11,15), D(2015,10,1), D(2015,12,31))\n# 2\nR(\"fourth quarter of 2015\", \"PWRR Board\", None, \"Target sale decision\", 1, 0, None, None, None, None, None, None, None, None,\n  \"Board appointed subcommittee (Barrett, Anderson) to interview bankers and evaluate strategic options, including potential change in control transactions, after Party A's interest.\",\n  \"the Board appointed a subcommittee of two independent directors, Frank W. Barrett and Richard W. Anderson, to interview potential investment bankers\", \"27\", None, D(2015,11,15), D(2015,10,1), D(2015,12,31))\n# 3\nR(\"01/27/2016\", \"GHF (Greene Holcomb & Fisher LLC)\", None, \"Adviser\", 1, 0, None, None, None, None, None, None, None, None,\n  \"Retained as the target's investment banking firm; would not represent any buyer or financing source; its business was acquired by BMO 08/01/2016 (same adviser, no new row).\",\n  \"the subcommittee recommended to the Board that the Company retain GHF as its investment banking firm\", \"27\", None, D(2016,1,27), D(2016,1,27), D(2016,1,27))\n# 4\nR(\"03/14/2016\", \"PWRR Board\", None, \"Target sale decision\", 1, 0, None, None, None, None, None, None, None, None,\n  \"Special meeting approved the process: discussions with Party A plus solicitation of other third parties; appointed three-director Transaction Committee (no deal authority).\",\n  \"Representatives of GHF then proposed a process pursuant to which the Company would proceed with discussions with Party A and also solicit interest from other potential third parties\", \"27\", None, D(2016,3,14), D(2016,3,14), D(2016,3,14))\n# 5\nR(\"03/24/2016\", \"Hinckley, Allen & Snyder LLP\", None, \"Adviser\", 1, 0, None, None, None, None, None, None, None, None,\n  \"Target's legal counsel; first seen acting at the 03/24/2016 Transaction Committee meeting; participated in all committee meetings.\",\n  \"representatives of each of GHF and the Company’s legal counsel, Hinckley, Allen & Snyder LLP (which we refer to as “Hinckley Allen”), participated in all meetings of the Transaction Committee\", \"28\", None, D(2016,3,24), D(2016,3,24), D(2016,3,24))\n# 6\nR(\"week of March 28, 2016\", \"PWRR\", None, \"Round opened\", 1, 1, None, None, None, None, None, None, None, None,\n  \"First outreach wave (opens round 1); committee authorized outreach 03/24; 29 contacted; five strategic buyers met management at the 2016 Connections Convention 04/03-06.\",\n  \"During the week of March 28, 2016, in accordance with the Transaction Committee’s directives, representatives of GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers.\", \"28\", None, D(2016,3,31), D(2016,3,28), D(2016,4,3))\n# 7\nR(\"week of March 28, 2016\", \"11 potential strategic buyers\", \"Strategic\", \"Contact\", 1, 1, None, None, None, None, None, 11, None, None,\n  \"GHF outreach to the strategic cohort; includes Party A; direction: target/banker to buyers; NDAs follow.\",\n  \"representatives of GHF contacted 11 potential strategic buyers (including Party A)\", \"28\", None, D(2016,3,31), D(2016,3,28), D(2016,4,3))\n# 8\nR(\"week of March 28, 2016\", \"18 potential financial buyers\", \"Financial\", \"Contact\", 1, 1, None, None, None, None, None, 18, None, None,\n  \"GHF outreach to the financial cohort; direction: target/banker to buyers; 14 of 18 later signed confidentiality agreements.\",\n  \"and 18 potential financial buyers\", \"28\", None, D(2016,3,31), D(2016,3,28), D(2016,4,3))\n# 9\nR(\"by 04/07/2016\", \"2 additional Class I railroads\", \"Strategic\", \"Contact\", 1, 1, None, None, None, None, None, 2, None, None,\n  \"Company management approached them to gauge interest; reported 04/07; never mentioned again; may sit inside signer cohorts (Q3).\",\n  \"the Company had also approached two additional Class I railroads to determine their interest in a possible transaction\", \"28\", \"Q3\", D(2016,4,7), None, D(2016,4,7))\n# 10\nR(\"by 04/22/2016\", \"11 potential strategic buyers\", \"Strategic\", \"NDA signed\", 1, 1, None, None, None, None, None, 11, None, None,\n  \"Subsequent to the 03/28 contact wave; all 11 strategic buyers signed; agreements had no standstill; memorandum later distributed to signers.\",\n  \"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements\", \"28\", None, D(2016,4,9), D(2016,3,28), D(2016,4,22))\n# 11\nR(\"by 04/22/2016\", \"14 potential financial buyers\", \"Financial\", \"NDA signed\", 1, 1, None, None, None, None, None, 14, None, None,\n  \"Subsequent to the 03/28 contact wave; 4 of 18 financial buyers did not sign; combined 25 signers as the filing cites.\",\n  \"and 14 potential financial buyers subsequently executed confidentiality agreements\", \"28\", None, D(2016,4,9), D(2016,3,28), D(2016,4,22))\n# 12\nR(\"by 04/27/2016\", \"PWRR\", None, \"Deadline set\", 1, 1, None, None, None, None, None, None, None, None,\n  \"Potential buyers advised to submit non-binding IOIs by 05/10; Board told on 04/27; later postponed to 05/19.\",\n  \"each potential buyer had been advised to submit a non-binding indication of interest by May 10, 2016\", \"29\", None, D(2016,4,27), None, D(2016,4,27))\n# 13\nR(\"by 05/10/2016\", \"PWRR\", None, \"Deadline revised\", 1, 1, None, None, None, None, None, None, None, None,\n  \"IOI deadline postponed from 05/10 to 05/19 to give buyers time to formulate their most compelling offers.\",\n  \"which deadline was subsequently postponed to May 19, 2016 to ensure the potential buyers had sufficient time to formulate their most compelling offers\", \"29\", \"Q2\", D(2016,5,3), D(2016,4,27), D(2016,5,10))\n# 14\nR(\"05/19/2016\", \"PWRR\", None, \"Deadline\", 1, 1, None, None, None, None, None, None, None, None,\n  \"Due date reached; nine IOIs received 05/19-06/01; two lowest excluded 06/01 (Q2).\",\n  \"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest (“IOIs”) from potential buyers\", \"29\", \"Q2\", D(2016,5,19), D(2016,5,19), D(2016,5,19))\n# 15\nR(\"between 05/19/2016 and 06/01/2016\", \"Nine potential buyers (unnamed)\", \"Unknown\", \"Bid\", 1, 1, 17.93, 26.50, \"Not stated\", \"Informal\", \"Heavy\", 9, None, None,\n  \"Range $17.93-$26.50 assuming preferred conversion; equity values $90M-$134M; pre-management-presentation indications; two lowest later excluded.\",\n  \"with offer prices per share ranging from $17.93 to $26.50 (assuming the conversion of preferred stock into common stock), implying equity values of $90 million to $134 million\", \"29\", None, D(2016,5,19), D(2016,5,19), D(2016,6,1))\n# 16\nR(\"05/19/2016\", \"16 NDA signers (no IOI)\", \"Unknown\", \"Did not submit\", 1, 1, None, None, None, None, None, 16, \"Not stated\", \"Y\",\n  \"25 signers - 9 IOI submitters = 16; no submission in the IOI solicitation; may include Party A (Q3, Q5).\",\n  \"25 of whom entered into confidentiality agreements with the Company and received information related to the Company\", \"33\", \"Q3, Q5\", D(2016,5,19), D(2016,5,19), D(2016,5,19))\n# 17\nR(\"06/01/2016\", \"Two low bidders (unnamed)\", \"Unknown\", \"Dropped by target\", 1, 1, None, None, None, None, None, 2, \"Lower offer than rivals\", None,\n  \"Excluded from management presentations to save management time; lowest of the nine IOIs; never named; may include Party A (Q5).\",\n  \"the Transaction Committee concluded that the two low bidders should be excluded from that process\", \"29\", \"Q5\", D(2016,6,1), D(2016,6,1), D(2016,6,1))\n# 18\nR(\"06/01/2016\", \"Transaction Committee\", None, \"Round opened\", 1, 2, None, None, None, None, None, None, None, None,\n  \"Seven of nine advanced to management presentations and equal data-site access; LOIs requested mid-June with mark-ups for 07/20.\",\n  \"The Transaction Committee authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers and allow these parties to conduct additional due diligence.\", \"29\", \"Q1\", D(2016,6,1), D(2016,6,1), D(2016,6,1))\n# 19\nR(\"mid-June 2016\", \"PWRR\", None, \"Deadline set\", 1, 2, None, None, None, None, None, None, None, None,\n  \"GHF instructed potential buyers to submit non-binding LOIs by 07/20 with mark-ups; valuation requested per share assuming preferred conversion.\",\n  \"representatives of GHF instructed all potential buyers to submit non-binding letters of intent (“LOIs”) by July 20, 2016\", \"29\", None, D(2016,6,15), D(2016,6,11), D(2016,6,19))\n# 20\nR(\"early July 2016\", \"Party C\", \"Strategic\", \"Bidder interest\", 1, 2, None, None, None, None, None, 1, None, None,\n  \"Late entrant approached management; no price; not previously part of the process.\",\n  \"In early July 2016, a potential strategic buyer that had not previously been part of the process (“Party C”) approached the Company’s management and expressed interest in acquiring the Company\", \"29\", None, D(2016,7,5), D(2016,7,1), D(2016,7,10))\n# 21\nR(\"early July 2016\", \"Party C\", \"Strategic\", \"NDA signed\", 1, 2, None, None, None, None, None, 1, None, None,\n  \"Signed confidentiality agreement and received the buyers' memorandum; a 26th signer if the Board's count of 25 excludes it (Q3).\",\n  \"After executing a confidentiality agreement, Party C was provided the memorandum concerning the Company provided to the other potential buyers\", \"29\", \"Q3\", D(2016,7,5), D(2016,7,1), D(2016,7,10))\n# 22\nR(\"07/12/2016\", \"Party C\", \"Strategic\", \"Bid\", 1, 2, 21.00, 21.00, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"IOI on memorandum only (no data room yet); equity value $108M; data-site access and management call followed 07/14.\",\n  \"On July 12, 2016, Party C submitted an IOI with an offer price per share of $21.00 (implying an equity value of $108 million)\", \"29\", None, D(2016,7,12), D(2016,7,12), D(2016,7,12))\n# 23\nR(\"07/14/2016\", \"Party C\", \"Strategic\", \"Other material event\", 1, 2, None, None, None, None, None, 1, None, None,\n  \"Provided catch-up data-site access and a telephone management presentation after its IOI; other buyers admitted to the data site in June.\",\n  \"Subsequently, Party C was provided access to the internet data site and the Company’s management held a management presentation with Party C by telephone on July 14, 2016\", \"29\", None, D(2016,7,14), D(2016,7,14), D(2016,7,14))\n# 24\nR(\"07/20/2016\", \"PWRR\", None, \"Deadline\", 1, 2, None, None, None, None, None, None, None, None,\n  \"Due date reached; G&W submitted its LOI on 07/21 and was considered; six LOIs received in late July.\",\n  \"In late July 2016, the Company received six LOIs with offer prices per share ranging from $19.20 to $24.00 (implying equity values of $96 million to $121 million)\", \"29\", \"Q2\", D(2016,7,20), D(2016,7,20), D(2016,7,20))\n# 25\nR(\"late July 2016\", \"Party B\", \"Strategic\", \"Bid\", 1, 2, 24.00, 24.00, \"Not stated\", \"Formal\", \"Light\", 1, None, None,\n  \"Highest of six LOIs; expedited diligence review; returned mark-ups of merger agreement and voting agreement (Formal); later declined to raise.\",\n  \"Party B submitted an LOI to acquire the Company for a price of $24.00 per share (subject to an expedited diligence review)\", \"29\", None, D(2016,7,20), D(2016,7,20), D(2016,7,27))\n# 26\nR(\"late July 2016\", \"Party E\", \"Strategic\", \"Bid\", 1, 2, 21.26, 21.26, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"60-day exclusivity for diligence and documentation; provided only a summary of issues on the drafts, no markup (Informal).\",\n  \"Party E (a strategic buyer) submitted an LOI to acquire the Company for a price of $21.26 per share\", \"30\", None, D(2016,7,20), D(2016,7,20), D(2016,7,27))\n# 27\nR(\"late July 2016\", \"Party D\", \"Financial\", \"Bid\", 1, 2, 21.00, 21.00, \"Not stated\", \"Formal\", \"Heavy\", 1, None, None,\n  \"Four-week diligence period; returned mark-ups of merger agreement and voting agreement (Formal).\",\n  \"Party D (a financial buyer) submitted an LOI to acquire the Company for a price of $21.00 per share (subject to a four-week diligence period)\", \"30\", None, D(2016,7,20), D(2016,7,20), D(2016,7,27))\n# 28\nR(\"late July 2016\", \"Party C\", \"Strategic\", \"Bid\", 1, 2, 19.30, 19.30, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"30-day diligence period; late entrant; no markup reported.\",\n  \"Party C submitted an LOI to acquire the Company for a price of $19.30 per share (subject to a 30-day diligence period)\", \"30\", None, D(2016,7,20), D(2016,7,20), D(2016,7,27))\n# 29\nR(\"late July 2016\", \"Party F\", \"Strategic\", \"Bid\", 1, 2, 19.20, 19.20, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"30-day due diligence period; lowest LOI; no markup reported.\",\n  \"Party F (a strategic buyer) submitted an LOI to acquire the Company for a price of $19.20 per share (subject to a 30-day due diligence period)\", \"30\", None, D(2016,7,20), D(2016,7,20), D(2016,7,27))\n# 30\nR(\"07/20/2016\", \"1 advanced strategic buyer (unnamed)\", \"Strategic\", \"Did not submit\", 1, 2, None, None, None, None, None, 1, \"Not stated\", None,\n  \"Elected not to submit an LOI; one of the seven advanced to management presentations (7 advanced + Party C - 6 submitters = 2). May include Party A.\",\n  \"One strategic buyer and one financial buyer elected not to submit an LOI\", \"30\", \"Q5\", D(2016,7,20), D(2016,7,20), D(2016,7,20))\n# 31\nR(\"07/20/2016\", \"1 advanced financial buyer (unnamed)\", \"Financial\", \"Did not submit\", 1, 2, None, None, None, None, None, 1, \"Not stated\", None,\n  \"Elected not to submit an LOI; one of the seven advanced to management presentations (7 advanced + Party C - 6 submitters = 2).\",\n  \"One strategic buyer and one financial buyer elected not to submit an LOI\", \"30\", None, D(2016,7,20), D(2016,7,20), D(2016,7,20))\n# 32\nR(\"07/21/2016\", \"G&W\", \"Strategic\", \"Bid\", 1, 2, 21.15, 21.15, \"Yes\", \"Formal\", \"Heavy\", 1, None, None,\n  \"$20.02 cash + $1.13 CVR (South Quay sale); three-week exclusive diligence; mark-ups of merger agreement, voting agreement, disclosure letter.\",\n  \"G&W submitted an LOI on July 21, 2016 to acquire the Company for a price of $21.15 per share (subject to a three-week exclusive diligence period)\", \"29\", None, D(2016,7,21), D(2016,7,21), D(2016,7,21))\n# 33\nR(\"07/26/2016\", \"G&W\", \"Strategic\", \"Bid\", 1, 2, 22.15, 22.15, \"Yes\", \"Formal\", \"Heavy\", 1, None, None,\n  \"Raised from $21.15 after GHF said price and CVR structure were not competitive; $21.02 cash + $1.13 CVR; exclusive diligence unchanged.\",\n  \"G&W submitted a revised LOI, which increased its offer to $22.15 per share (including $21.02 in cash and $1.13 CVR)\", \"29\", None, D(2016,7,26), D(2016,7,26), D(2016,7,26))\n# 34\nR(\"07/27/2016\", \"Transaction Committee\", None, \"Round opened\", 1, 3, None, None, None, None, None, None, None, None,\n  \"After LOI review, moved to confirmatory due diligence and definitive negotiation with G&W and Party B; other bidders told they were out.\",\n  \"The Transaction Committee concluded that the Company should proceed with confirmatory due diligence and negotiations with G&W and Party B\", \"30\", None, D(2016,7,27), D(2016,7,27), D(2016,7,27))\n# 35\nR(\"after 07/27/2016\", \"Party C\", \"Strategic\", \"Dropped by target\", 1, 2, None, None, None, None, None, 1, \"Lower offer than rivals\", \"Y\",\n  \"Among the 'remaining bidders' told they were no longer involved after the 07/27 selection; not named individually in that report.\",\n  \"representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process\", \"30\", None, D(2016,7,27), D(2016,7,27), None)\n# 36\nR(\"after 07/27/2016\", \"Party F\", \"Strategic\", \"Dropped by target\", 1, 2, None, None, None, None, None, 1, \"Lower offer than rivals\", \"Y\",\n  \"Among the 'remaining bidders' told they were no longer involved after the 07/27 selection; later provided financing support to Party E's revised bid.\",\n  \"representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process\", \"30\", None, D(2016,7,27), D(2016,7,27), None)\n# 37\nR(\"after 07/27/2016\", \"Party D\", \"Financial\", \"Dropped by target\", 1, 2, None, None, None, None, None, 1, \"Lower offer than rivals\", \"Y\",\n  \"'Reengaging' on 07/29 implies it was out; returned with a revised LOI 08/01 (see #39).\",\n  \"During those calls, Party D and Party E both expressed interest in reengaging and enhancing their offers\", \"30\", \"Q4\", D(2016,7,27), D(2016,7,27), D(2016,7,29))\n# 38\nR(\"after 07/27/2016\", \"Party E\", \"Strategic\", \"Dropped by target\", 1, 2, None, None, None, None, None, 1, \"Lower offer than rivals\", \"Y\",\n  \"'Reengaging' on 07/29 implies it was out; returned with a revised LOI 08/01 (see #40).\",\n  \"During those calls, Party D and Party E both expressed interest in reengaging and enhancing their offers\", \"30\", \"Q4\", D(2016,7,27), D(2016,7,27), D(2016,7,29))\n# 39\nR(\"08/01/2016\", \"Party D\", \"Financial\", \"Bid\", 1, 3, 24.00, 24.00, \"Not stated\", \"Formal\", \"Heavy\", 1, None, None,\n  \"Returned after exit #37; revised LOI up from $21.00; 30-day diligence period; mark-ups earlier (Formal carries).\",\n  \"On August 1, 2016, Party D submitted a revised LOI at a price of $24.00 per share\", \"30\", None, D(2016,8,1), D(2016,8,1), D(2016,8,1))\n# 40\nR(\"08/01/2016\", \"Party E\", \"Strategic\", \"Bid\", 1, 3, 23.81, 23.81, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"Returned after exit #38; revised LOI with financing support from Party F; 30-day diligence period.\",\n  \"Party E submitted a revised LOI, along with financing support, from Party F, at a price of $23.81 per share\", \"30\", None, D(2016,8,1), D(2016,8,1), D(2016,8,1))\n# 41\nR(\"08/02/2016\", \"Party E\", \"Strategic\", \"Bid\", 1, 3, 21.26, 21.26, \"Not stated\", \"Informal\", \"Heavy\", 1, None, None,\n  \"Reversion: withdrew the $23.81 revision and confirmed original $21.26 proposal (60-day exclusivity); not an exit.\",\n  \"Party E withdrew its revised proposal on August 2, 2016 (but confirmed its original proposal of $21.26 per share)\", \"30\", None, D(2016,8,2), D(2016,8,2), D(2016,8,2))\n# 42\nR(\"08/01/2016-08/02/2016\", \"Party D\", \"Financial\", \"Withdrew\", 1, 3, None, None, None, None, None, 1, \"Terms or process\", None,\n  \"Declined to shorten its 30-day diligence and asked the Company not to sign with a rival; Company refused; D would not proceed 'at that time'.\",\n  \"Party D indicated that it would not proceed with further due diligence at that time\", \"30\", None, D(2016,8,2), D(2016,8,1), D(2016,8,2))\n# 43\nR(\"08/04/2016\", \"Party E\", \"Strategic\", \"Dropped by target\", 1, 3, None, None, None, None, None, 1, \"Lower offer than rivals\", \"Y\",\n  \"Committee continued with only G&W and Party B; E's standing $21.26 was below both; filing does not say E was told.\",\n  \"the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B\", \"31\", \"Q4\", D(2016,8,4), D(2016,8,4), D(2016,8,4))\n# 44\nR(\"08/09/2016\", \"G&W\", \"Strategic\", \"Other material event\", 1, 3, None, None, None, None, None, 1, None, None,\n  \"Directed BMO to tell G&W the Company intended to sign with another bidder; G&W asked to continue diligence to facilitate an improved offer; request granted (08/10-08/11).\",\n  \"the Transaction Committee directed representatives of BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder\", \"31\", None, D(2016,8,9), D(2016,8,9), D(2016,8,9))\n# 45\nR(\"08/10/2016\", \"Simpson Thacher & Bartlett LLP\", None, \"Adviser\", 1, 3, None, None, None, None, None, None, None, None,\n  \"G&W's legal counsel; first seen acting 08/10/2016 negotiating merger agreement and disclosure letter revisions with Hinckley Allen.\",\n  \"representatives of Hinckley Allen and Simpson Thacher & Bartlett LLP (which we refer to as “Simpson Thacher”), G&W’s legal counsel, discussed various provisions of the draft merger agreement and voting agreement\", \"31\", None, D(2016,8,10), D(2016,8,10), D(2016,8,10))\n# 46\nR(\"08/12/2016\", \"G&W\", \"Strategic\", \"Bid\", 1, 3, 25.00, 25.00, \"Yes\", \"Formal\", \"Light\", 1, None, None,\n  \"Cash, no CVR; mark-ups of merger agreement and voting agreement; offer expiring 6:00 p.m. 08/13; physical diligence completed 08/11; winning bid.\",\n  \"G&W submitted a revised LOI to acquire the Company for a price of $25.00 per share in cash, which excluded the previously proposed CVR\", \"31\", None, D(2016,8,12), D(2016,8,12), D(2016,8,12))\n# 47\nR(\"08/12/2016\", \"PWRR and G&W\", None, \"Merger agreement signed\", 1, 3, None, None, None, None, None, 1, None, None,\n  \"Board chose G&W over Party B; $25.00 cash per common share; preferred converts into 100 common shares plus accrued dividends; Eder Trusts voting agreement signed.\",\n  \"the Company and G&W executed the merger agreement, and the Company, G&W and the Eder Trusts executed the voting agreement\", \"32\", None, D(2016,8,12), D(2016,8,12), D(2016,8,12))\n# 48\nR(\"08/12/2016\", \"Party B\", \"Strategic\", \"Not selected at signing\", 1, 3, None, None, None, None, None, 1, \"Would not improve earlier offer\", None,\n  \"Asked to raise its $24.00 offer; declined; Board then chose G&W's $25.00 cash proposal.\",\n  \"Party B indicated that it would not increase its price\", \"32\", None, D(2016,8,12), D(2016,8,12), D(2016,8,12))\n# 49\nR(\"08/15/2016\", \"PWRR\", None, \"Merger announced\", 1, \"post\", None, None, None, None, None, None, None, None,\n  \"Press release issued before the opening of NASDAQ trading.\",\n  \"The Company issued a press release publicly announcing the transaction on Monday, August 15, 2016 prior to the opening of trading of the Company’s common stock on the NASDAQ\", \"32\", None, D(2016,8,15), D(2016,8,15), D(2016,8,15))\n\nfor i, r in enumerate(rows, 1):\n    r[0] = i\n\n# ---------- validation ----------\nprev = None\nfor r in rows:\n    s, f, t = r[19], r[20], r[21]\n    if prev and s < prev:\n        raise SystemExit(f\"sort date decreases at #{r[0]}\")\n    prev = s\n    if f and t and not (f <= s <= t): raise SystemExit(f\"sort outside window #{r[0]}\")\n    if f and s < f: raise SystemExit(f\"sort before from #{r[0]}\")\n    if t and s > t: raise SystemExit(f\"sort after to #{r[0]}\")\n    # word counts\n    note = r[15]\n    if len(note.split()) > 40: raise SystemExit(f\"note too long #{r[0]}: {len(note.split())}\")\nprint(\"Rows:\", len(rows), \"- all checks passed\")\n\n# ---------- Rounds sheet ----------\nrounds = [\n [1, 1, D(2016,3,31),\n  \"Committee authorized GHF to contact Party A and other buyers (03/24); GHF contacted 29 buyers during the week of 03/28.\",\n  \"25 (11 strategic - incl. Party A, Party B, Party E, Party F, G&W; 14 financial - incl. Party D); Party A's round-0 interest carries.\",\n  \"05/10/2016 -> 05/19/2016\", \"Extended (05/10 -> 05/19); Late bids accepted\", \"Not final\",\n  \"9 unnamed (IOIs $17.93-$26.50; equity $90M-$134M)\",\n  \"nine bid; two low bidders excluded; seven advanced\"],\n [1, 2, D(2016,6,1),\n  \"Committee advanced seven IOI submitters to management presentations and data-site access; LOIs requested mid-June.\",\n  \"7 advanced (strategic: Party B, G&W, Party E, Party F + 1 unnamed; financial: Party D + 1 unnamed) + Party C (late entrant, early July).\",\n  \"07/20/2016\", \"Late bids accepted\", \"Not final\",\n  \"6 LOIs: Party B, G&W, Party E, Party D, Party C, Party F; Party C's 07/12 IOI ($21.00) also in round\",\n  \"six bid; G&W and Party B advanced; C, D, E, F told they were no longer involved (D, E briefly re-engaged)\"],\n [1, 3, D(2016,7,27),\n  \"Committee moved to confirmatory due diligence and definitive negotiations with G&W and Party B.\",\n  \"2 (G&W, Party B - both strategic); Party D and Party E re-engaged 07/29-08/01, then closed.\",\n  \"none stated\", \"No deadline stated\", \"Inferred final\",\n  \"3 bid: G&W $25.00 cash (08/12); Party D $24.00 (08/01); Party E $23.81 then $21.26 (08/01-02); Party B declined to improve\",\n  \"signing (G&W, $25.00 cash)\"],\n]\n\n# ---------- Questions ----------\nquestions = [\n [\"Q1\",\n  \"Round map: R1 opens with the week-of-03/28 outreach (IOIs due 05/19); R2 opens 06/01 when the Committee advanced seven and opened the presentation/data-site stage; R3 opens 07/27 on the move to definitive negotiation with G&W and Party B. Is the 06/01 R2 boundary right?\",\n  \"Keep as recorded. Most plausible alternative: R2 opens mid-June, when GHF instructed the LOIs; the 06/01 advancement would close R1 and the 'Round opened' row would move to mid-June; round membership of all bids is unchanged.\",\n  \"A round begins when the target selects who advances, opens a distinct information stage tied to new offers, or moves to definitive negotiation. Advancement/data site 06/01 (p. 29); LOI instruction mid-June (p. 29); definitive negotiation 07/27 (p. 30).\",\n  \"#18 (Round opened R2).\",\n  \"The R2 opening row's When, Sort date and position (after #19); no bid moves between rounds.\",\n  None],\n [\"Q2\",\n  \"Deadline outcomes: R1's 05/10 date was postponed to 05/19 (recorded as revised); its 05/19 outcome is 'Late bids accepted' (nine IOIs received 05/19-06/01). R2's 07/20 outcome is 'Late bids accepted' (G&W's dated 07/21 LOI was considered). Correct?\",\n  \"Keep both as 'Late bids accepted'. Alternatives: R1 'Enforced' if all nine IOIs arrived on 05/19 and the Committee then selected on bids in hand; R2 'Enforced' if the 07/21 LOI was treated as timely.\",\n  \"Nine IOIs received 05/19-06/01 (p. 29); G&W LOI dated 07/21, reviewed 07/22 and 07/27 (pp. 29-30); postponement to 05/19 (p. 29).\",\n  \"#13-#15 (deadline rows and IOI cohort); #24 (07/20 deadline); Rounds-sheet outcome cells.\",\n  \"The Deadline outcome cells and the Notes of the deadline rows; no bids or rounds move.\",\n  None],\n [\"Q3\",\n  \"Signer counts: the rows show 11 strategic + 14 financial confidentiality agreements (25) in the March-April wave plus Party C's later agreement (26); the Board states 25 signers. Also, two additional Class I railroads were approached (p. 28) and never mentioned again.\",\n  \"Keep the wave at 25 as filed and Party C as a separate, later signer (26 total); treat the two Class I railroads as non-entrants (no agreement shown). Alternative: Party C inside the 25 (wave 24) - contradicted by 'Each of the potential strategic buyers' executing (p. 28).\",\n  \"11 strategic + 14 financial signed (p. 28); Party C signed on entering in early July (p. 29); Board cites '25 of whom entered into confidentiality agreements' (p. 33); two Class I railroads approached (p. 28).\",\n  \"#9-#11, #16 (residual), #21 (Party C NDA).\",\n  \"Auction-screen count (Met either way); the 16-submitter residual arithmetic (base 25 vs 24/26).\",\n  None],\n [\"Q4\",\n  \"Party D and Party E were told they were 'no longer involved' after 07/27 and then 'reengaged' (07/29-08/01); the ledger closes both on 07/27 (Dropped by target) and records their 08/01 bids as returns. E is closed finally on 08/04, not left live to signing.\",\n  \"Keep exit-and-return: 'reengaging' implies they were out; close E on 08/04 when the Committee continued with only G&W and Party B (its $21.26 was below both). Alternative: treat both as continuously live (live count 4 from 08/01) or close E only at signing.\",\n  \"'no longer involved in the process' (p. 30); 'reengaging and enhancing their offers' (p. 30); 'continue diligence and negotiations with both G&W and Party B' (p. 31).\",\n  \"#37-#40, #43 (D/E exits and returns).\",\n  \"Live-bidder counts 07/27-08/12 (2 vs 4) and E's final exit label/date (Dropped 08/04 vs Not selected 08/12).\",\n  None],\n [\"Q5\",\n  \"Party A - the first counterparty (Q4 2015) - is never mentioned after the memorandum stage; it may sit in the 16 IOI non-submitters, the two excluded low bidders, or the two non-submitting LOI bidders. No separate exit row is written.\",\n  \"Keep no separate exit row; residual Notes say they may include Party A; treat Party A as exited by signing inside a residual (reason Not stated). All six LOI submitters are named, so Party A did not submit one.\",\n  \"Party A named through the memo distribution (p. 28); the nine IOIs are unnamed (p. 29); all six LOI submitters are named (pp. 29-30).\",\n  \"#16, #17, #30 (residuals that may include Party A).\",\n  \"Only the composition of anonymous residuals; no prices, rounds or named exits change.\",\n  None],\n]\n\n# ---------- Deal facts ----------\nfacts = [\n [\"Target\", \"Providence and Worcester Railroad Company (PWRR), a Rhode Island corporation; regional freight railroad in Massachusetts, Rhode Island, Connecticut and New York; NASDAQ ticker PWX.\"],\n [\"Acquirer\", \"Genesee & Wyoming Inc. (G&W), a Delaware corporation, through Pullman Acquisition Sub Inc., a wholly-owned subsidiary formed 08/12/2016.\"],\n [\"Acquirer type\", \"Strategic - an operating freight-railroad company (owns or leases 121 freight railroads worldwide).\"],\n [\"Agreed price and consideration\", \"$25.00 in cash per share of common stock, without interest; each preferred share converts automatically into 100 common shares (plus accrued/unpaid dividends) and then receives the same $25.00 cash; no financing condition.\"],\n [\"Merger agreement signed\", D(2016,8,12)],\n [\"Merger announced\", D(2016,8,15)],\n [\"Filing type and date\", \"DEFM14A (definitive proxy statement), dated 09/19/2016; first mailed to shareholders on or about 09/21/2016.\"],\n [\"Background pages\", \"27-31 (printed pages).\"],\n [\"Initiation\", \"Bidder-led - Party A raised acquisition interest in Q4 2015; the Board then organized the process.\"],\n [\"Number of processes\", \"1\"],\n [\"Auction screen\", \"Met - 25 confidentiality agreements in the March-April wave (11 strategic, 14 financial); Party C signed a later agreement (see Q3).\"],\n [\"Whole-company bids\", \"Yes - nine IOIs ($17.93-$26.50), six LOIs ($19.20-$24.00) and G&W's winning $25.00 cash bid; all were whole-company per-share bids.\"],\n [\"Currency and units of bid prices\", \"US dollars per share of common stock (the filing assumes conversion of preferred stock into common stock).\"],\n [\"Target financial advisers\", \"Greene Holcomb & Fisher LLC (GHF), engaged 01/27/2016; its business was acquired by BMO Capital Markets Corp. on 08/01/2016, which advised thereafter and delivered the fairness opinion (same adviser, no new row).\"],\n [\"Target legal advisers\", \"Hinckley, Allen & Snyder LLP (first seen acting 03/24/2016).\"],\n [\"Account\", \"PWRR, a New England regional freight railroad, explored a sale after Class I partner Party A raised acquisition interest in Q4 2015. The Board engaged GHF in January 2016 and in March approved a process combining discussions with Party A and a broad solicitation; 29 parties were contacted, 25 signed confidentiality agreements and nine submitted non-binding IOIs ($17.93-$26.50). Two low bidders were excluded and seven advanced to management presentations, producing six LOIs ($19.20-$24.00); G&W and Party B were selected for confirmatory diligence and definitive negotiation. G&W was told the Company intended to sign with Party B, then raised its all-cash offer to $25.00 per share on August 12; Party B declined to improve and the Board signed with G&W that day. The transaction was announced on August 15, 2016.\"],\n]\n\n# ---------- write workbook ----------\nwb = Workbook()\nwb.remove(wb.active)\nws1 = wb.create_sheet(\"Deal ledger\")\nws2 = wb.create_sheet(\"Rounds\")\nws3 = wb.create_sheet(\"Questions\")\nws4 = wb.create_sheet(\"Deal facts\")\n\nh1 = [\"#\",\"When\",\"Who\",\"Type\",\"Event\",\"Process\",\"Round\",\"Price low\",\"Price high\",\"All cash\",\"Formality\",\"Conditions\",\"Count\",\"Exit reason\",\"Inferred\",\"Note\",\"Quote and page\",\"Flag\",\"Reviewer note\",\"Sort date\",\"Date from\",\"Date to\"]\nh2 = [\"Process\",\"Round\",\"Opened\",\"How opened\",\"Who was in\",\"Due dates\",\"Deadline outcome\",\"Finality\",\"Bids received\",\"How it ended\"]\nh3 = [\"Q\",\"Question\",\"Recommended answer\",\"Why, with page\",\"Rows affected\",\"What changes if answered differently\",\"Reviewer note\"]\nh4 = [\"Field\",\"Value\"]\n\nfor ws, h, data in ((ws1,h1,rows),(ws2,h2,rounds),(ws3,h3,questions),(ws4,h4,facts)):\n    ws.append(h)\n    for r in data:\n        ws.append(r)\n    for c in range(1, len(h)+1):\n        cell = ws.cell(row=1, column=c)\n        cell.font = Font(bold=True)\n        cell.alignment = Alignment(wrap_text=True, vertical=\"top\")\n    for row in ws.iter_rows(min_row=2, max_row=ws.max_row, max_col=len(h)):\n        for cell in row:\n            cell.alignment = Alignment(wrap_text=True, vertical=\"top\")\n    ws.freeze_panes = \"A2\"\n    ws.auto_filter.ref = f\"A1:{get_column_letter(len(h))}{ws.max_row}\"\n\n# date formats\nfor row in ws1.iter_rows(min_row=2, max_row=ws1.max_row, min_col=20, max_col=22):\n    for cell in row:\n        if cell.value is not None:\n            cell.number_format = \"MM/DD/YYYY\"\nfor row in ws2.iter_rows(min_row=2, max_row=ws2.max_row, min_col=3, max_col=3):\n    for cell in row:\n        if cell.value is not None:\n            cell.number_format = \"MM/DD/YYYY\"\nfor row in ws4.iter_rows(min_row=2, max_row=ws4.max_row, min_col=2, max_col=2):\n    for cell in row:\n        if isinstance(cell.value, dt.date):\n            cell.number_format = \"MM/DD/YYYY\"\n# price number format\nfor row in ws1.iter_rows(min_row=2, max_row=ws1.max_row, min_col=8, max_col=9):\n    for cell in row:\n        if cell.value is not None:\n            cell.number_format = \"0.00\"\n# char widths\nwidths1 = {1:5,2:22,3:26,4:11,5:17,6:8,7:7,8:9,9:9,10:10,11:11,12:11,13:7,14:17,15:8,16:52,17:52,18:9,19:12,20:11,21:11,22:11}\nfor c,w in widths1.items(): ws1.column_dimensions[get_column_letter(c)].width = w\nwidths2 = {1:8,2:6,3:11,4:45,5:45,6:24,7:26,8:13,9:45,10:40}\nfor c,w in widths2.items(): ws2.column_dimensions[get_column_letter(c)].width = w\nwidths3 = {1:5,2:65,3:65,4:55,5:30,6:45,7:12}\nfor c,w in widths3.items(): ws3.column_dimensions[get_column_letter(c)].width = w\nwidths4 = {1:30,2:100}\nfor c,w in widths4.items(): ws4.column_dimensions[get_column_letter(c)].width = w\n\nimport os\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\nout = '/home/uctpiaj/work/extraction/providence-worcester.xlsx'\nwb.save(out)\nprint(\"saved\", out)\n\n# print ledger for review\nprint(\"\\n=== DEAL LEDGER ===\")\nfor r in rows:\n    print(r[0], \"|\", r[1], \"|\", r[2], \"|\", r[4], \"|\", r[5], r[6], \"|\", r[7], r[8], r[9], r[10], r[11], \"|\", r[12], \"|\", r[13], \"|\", (r[14] or ''), \"|\", (r[15][:70]+'...' if len(r[15])>70 else r[15]), \"|\", (r[17] or ''), \"|\", r[19])\nPYEOF\npython3 build_ledger.py"},"output":"Rows: 49 - all checks passed\nsaved /home/uctpiaj/work/extraction/providence-worcester.xlsx\n\n=== DEAL LEDGER ===\n1 | fourth quarter of 2015 | Party A | Bidder interest | 1 0 | None None None None None | 1 | None |  | Party A suggested joint ventures and raised interest in acquiring equi... |  | 2015-11-15\n2 | fourth quarter of 2015 | PWRR Board | Target sale decision | 1 0 | None None None None None | None | None |  | Board appointed subcommittee (Barrett, Anderson) to interview bankers ... |  | 2015-11-15\n3 | 01/27/2016 | GHF (Greene Holcomb & Fisher LLC) | Adviser | 1 0 | None None None None None | None | None |  | Retained as the target's investment banking firm; would no