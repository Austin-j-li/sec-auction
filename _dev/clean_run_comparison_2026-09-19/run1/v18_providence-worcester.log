y Allen”), participated in all meetings of the Transaction Committee\\\", \\\"28\\\"'\\nnew5 = '\\\"the Company’s legal counsel, Hinckley, Allen & Snyder LLP (which we refer to as “Hinckley Allen”)\\\", \\\"28\\\"'\\nassert old5 in s\\ns = s.replace(old5, new5)\\nold5n = '\\\"Target\\\\'s legal counsel; first seen acting at the 03/24/2016 Transaction Committee meeting; participated in all committee meetings.\\\"'\\nnew5n = '\\\"Target\\\\'s legal counsel; first seen acting at the 03/24/2016 Transaction Committee meeting; participated in committee meetings except as otherwise indicated.\\\"'\\nassert old5n in s\\ns = s.replace(old5n, new5n)\\n\\nopen(p, 'w', encoding='utf-8').write(s)\\nprint(\\\"patched\\\")\\nEOF\\npython3 build_ledger.py | head -3\\npython3 - <<'EOF'\\nfrom openpyxl import load_workbook\\nimport re\\nwb = load_workbook('/home/uctpiaj/work/extraction/providence-worcester.xlsx')\\nws = wb['Deal ledger']\\nbad=0\\nfor r in ws.iter_rows(min_row=2, values_only=True):\\n    q=r[16]; m=re.match(r'^(.*) \\\\(p\\\\. (\\\\d+)\\\\)$', q, re.S)\\n    if not m or len(m.group(1).split())>30: bad+=1; print(\\\"bad\\\",r[0])\\nprint(\\\"final quote check bad =\\\", bad)\\nfor r in ws.iter_rows(min_row=2, max_row=6, values_only=True):\\n    print(r[0], \\\"|\\\", r[15][:90], \\\"||\\\", r[16])\\nEOF\"}"},"time":{"start":1789825621143,"end":1789825623169}}}}
