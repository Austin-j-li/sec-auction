{"type":"tool_use","timestamp":1789825473542,"sessionID":"ses_f461fa331ffe0Vx8rAYcMiXg6i","part":{"partID":"prt_0b9e8ddd20017ywK0PezCYXcS5","sessionID":"ses_f461fa331ffe0Vx8rAYcMiXg6i","messageID":"msg_0b9e88d04001Oeb3xdepGwB5eX","type":"tool","id":"call_00_4KwcbXG6bSgatexIpl1Y8319","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/work/build_ledger.py","content":"#!/usr/bin/env python3\n\"\"\"Build mac-gray.xlsx deal ledger from the Mac-Gray DEFM14A (2013-12-04).\"\"\"\nimport re\nfrom datetime import date\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment\nfrom openpyxl.utils import get_column_letter\n\nFILING = '/tmp/opencode/work/filing_pages.txt'\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\n\ntext = open(FILING).read()\nnorm_filing = re.sub(r'\\s+', ' ', text)\n\ndef check_quote(q):\n    nq = re.sub(r'\\s+', ' ', q).strip()\n    assert nq in norm_filing, f\"QUOTE NOT FOUND: {nq[:80]}...\"\n    return len(nq.split())\n\ndef wc(s):\n    return 0 if not s else len(s.split())\n\nD = date\nrows = []\ndef R(**kw):\n    rows.append(kw)\n\n# ---------------------------------------------------------------- ledger rows\nR(when=\"10/23/2012\", who=\"BofA Merrill Lynch\", typ=None, event=\"Adviser\", proc=1, rnd=0,\n  note=\"Engaged by Mac-Gray for the 2011-2012 Discussions on a possible Mac-Gray acquisition of CSC (not a sale of Mac-Gray); mandate terminated 05/15/2013 and replaced by the 2013 sale-process engagement.\",\n  quote=\"In connection with Mac-Gray's consideration of a possible acquisition of CSC, which we refer to as the 2011-2012 Discussions, Mac-Gray engaged BofA Merrill Lynch on October 23, 2012\", page=\"27\",\n  sort=D(2012,10,23), dfrom=D(2012,10,23), dto=D(2012,10,23))\n\nR(when=\"04/08/2013\", who=\"Party A\", typ=\"Strategic\", event=\"Target interest\", proc=1, rnd=0,\n  note=\"Following the April 5 Board authorization to explore transactional opportunities with BofA, BofA telephoned Party A, which indicated it might consider a business combination; no price discussed.\",\n  quote=\"representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray\", page=\"27\",\n  sort=D(2013,4,8), dfrom=D(2013,4,8), dto=D(2013,4,8))\n\nR(when=\"05/09/2013\", who=\"Goodwin Procter LLP\", typ=None, event=\"Adviser\", proc=1, rnd=0,\n  note=\"Outside legal counsel to Mac-Gray; first seen acting at the May 9, 2013 Board meeting; advised the Transaction and Special Committees through signing.\",\n  quote=\"Goodwin Procter LLP, outside legal counsel to Mac-Gray, were also in attendance for all or portions of the meeting\", page=\"27\",\n  sort=D(2013,5,9), dfrom=D(2013,5,9), dto=D(2013,5,9))\n\nR(when=\"05/15/2013\", who=\"BofA Merrill Lynch\", typ=None, event=\"Adviser ended\", proc=1, rnd=0,\n  note=\"Transaction Committee decided 05/14/2013 to terminate BofA's 2011-2012 engagement letter, given CSC's sale process had ended and BofA was a candidate for the new mandate; termination letter sent 05/15/2013.\",\n  quote=\"On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions\", page=\"29\",\n  sort=D(2013,5,15), dfrom=D(2013,5,15), dto=D(2013,5,15))\n\nR(when=\"05/30/2013\", who=\"Moab Partners, L.P. (Moab)\", typ=None, event=\"Activist\", proc=1, rnd=0,\n  note=\"Proxy contest leading up to the annual meeting; Moab's nominees Michael Rothenberg and James Hyman elected in place of two incumbents; Rothenberg later excluded from sale-process deliberations over a possible Moab rollover.\",\n  quote=\"Mac-Gray and Moab engaged in a proxy contest leading up to the annual meeting and Mr. Rothenberg and Mr. Hyman were elected in place of Mac-Gray's incumbent nominees\", page=\"29\",\n  sort=D(2013,5,30), dfrom=D(2013,5,30), dto=D(2013,5,30))\n\nR(when=\"05/31/2013\", who=\"BofA Merrill Lynch\", typ=None, event=\"Adviser\", proc=1, rnd=0,\n  note=\"Board approved the engagement 05/30/2013 after three banks presented; BofA agreed not to source acquisition financing for any buyer without Mac-Gray's prior written consent.\",\n  quote=\"On May 31, 2013, Mac-Gray entered into an engagement letter with BofA Merrill Lynch with respect to the Board's undertaking a review of strategic alternatives, including a potential sale process\", page=\"30\",\n  sort=D(2013,5,31), dfrom=D(2013,5,31), dto=D(2013,5,31))\n\nR(when=\"06/21/2013\", who=\"Party A\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=0,\n  plow=17.00, phigh=19.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Unsolicited first proposal, before any NDA or diligence access; all-cash range $17.00-$19.00; Conditions Heavy by context (no substantive diligence access yet).\",\n  quote=\"Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share\", page=\"30\",\n  sort=D(2013,6,21), dfrom=D(2013,6,21), dto=D(2013,6,21))\n\nR(when=\"06/24/2013\", who=\"Mac-Gray (Special Committee)\", typ=None, event=\"Target sale decision\", proc=1, rnd=1,\n  note=\"Special Committee of six independent directors formed (Bullock chairman) and concluded it was in stockholders' best interests to consider a potential sale, compared with continuing as a stand-alone company.\",\n  quote=\"it would be in the best interests of stockholders to consider a potential sale of Mac-Gray and to review this alternative as compared to Mac-Gray's continuing as a stand-alone company\", page=\"31\",\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=D(2013,6,24))\n\nR(when=\"06/24/2013\", who=\"Mac-Gray (Special Committee)\", typ=None, event=\"Round opened\", proc=1, rnd=1,\n  note=\"Round 1: approach 50 parties (15 potential strategic, 35 potential financial) to solicit preliminary indications, due 07/23/2013; outreach executed over the following weeks.\",\n  quote=\"50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray\", page=\"32\",\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=D(2013,6,24))\n\nR(when=\"after 06/24/2013\", who=\"15 potential strategic buyers\", typ=\"Strategic\", event=\"Contact\", proc=1, rnd=1, count=15,\n  note=\"First outreach wave by BofA for Mac-Gray; 15 of the 50 parties approached were potential strategic buyers; contacts continued over the following weeks.\",\n  quote=\"15 of which were potential strategic buyers and 35 of which were potential financial buyers\", page=\"32\",\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=None)\n\nR(when=\"after 06/24/2013\", who=\"35 potential financial buyers\", typ=\"Financial\", event=\"Contact\", proc=1, rnd=1, count=35,\n  note=\"First outreach wave by BofA for Mac-Gray; 35 of the 50 parties were potential financial buyers, including private equity firms.\",\n  quote=\"in accordance with the directives of the Special Committee, BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting\", page=\"32\",\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=None)\n\nR(when=\"06/28/2013\", who=\"Party B\", typ=\"Financial\", event=\"NDA signed\", proc=1, rnd=1, count=1,\n  note=\"Confidentiality and standstill agreement with Mac-Gray; informational package provided to formulate a preliminary indication of interest.\",\n  quote=\"Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\", page=\"32\",\n  sort=D(2013,6,28), dfrom=D(2013,6,28), dto=D(2013,6,28))\n\nR(when=\"06/30/2013\", who=\"Party C\", typ=\"Financial\", event=\"NDA signed\", proc=1, rnd=1, count=1,\n  note=\"Confidentiality and standstill agreement with Mac-Gray; informational package provided to formulate a preliminary indication of interest.\",\n  quote=\"On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\", page=\"32\",\n  sort=D(2013,6,30), dfrom=D(2013,6,30), dto=D(2013,6,30))\n\nR(when=\"07/06/2013\", who=\"Moab Partners, L.P. (Moab)\", typ=None, event=\"Other material event\", proc=1, rnd=1,\n  note=\"Denied Moab's request to negotiate exclusively with CSC/Pamplona over an equity rollover; Special Committee said it was premature but discussions would be permitted later.\",\n  quote=\"the Special Committee decided to deny the exclusivity request at this stage of the process\", page=\"33\",\n  sort=D(2013,7,6), dfrom=D(2013,7,6), dto=D(2013,7,6))\n\nR(when=\"07/11/2013\", who=\"CSC/Pamplona\", typ=\"Strategic\", event=\"NDA signed\", proc=1, rnd=1, count=1,\n  note=\"Confidentiality and standstill agreement with Mac-Gray; Pamplona said business and legal diligence would be minimal given its familiarity with Mac-Gray.\",\n  quote=\"On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package\", page=\"33\",\n  sort=D(2013,7,11), dfrom=D(2013,7,11), dto=D(2013,7,11))\n\nR(when=\"07/23/2013\", who=\"Mac-Gray (BofA Merrill Lynch)\", typ=None, event=\"Deadline\", proc=1, rnd=1, flag=\"Q2\",\n  note=\"Round 1 due date for preliminary indications. CSC/Pamplona bid on time; Party B and Party C indications arrived 07/24 and were considered.\",\n  quote=\"which they were instructed to submit by July 23, 2013\", page=\"32\",\n  sort=D(2013,7,23), dfrom=D(2013,7,23), dto=D(2013,7,23))\n\nR(when=\"07/23/2013\", who=\"CSC/Pamplona\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=1,\n  plow=18.50, phigh=18.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Preliminary indication of interest submitted on the 07/23 due date; no financing disclosure and no substantive diligence access yet, so Heavy by context.\",\n  quote=\"On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share\", page=\"33\",\n  sort=D(2013,7,23), dfrom=D(2013,7,23), dto=D(2013,7,23))\n\nR(when=\"by 07/23/2013\", who=\"16 financial NDA signers (residual)\", typ=\"Financial\", event=\"Did not submit\", proc=1, rnd=1,\n  count=16, exit=\"Not stated\", inferred=\"Y\", flag=\"Q4\",\n  note=\"Arithmetic: 20 signers less Party A (not yet signed) and the three submitters (CSC/Pamplona, Party B, Party C) leaves 16 financial signers with no indication by the 07/23 due date.\",\n  quote=\"a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray\", page=\"32\",\n  sort=D(2013,7,23), dfrom=None, dto=D(2013,7,23))\n\nR(when=\"07/24/2013\", who=\"Party B\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=1,\n  plow=17.00, phigh=18.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Preliminary indication one day after the 07/23 due date, accepted and reviewed at the 07/25 meeting; no substantive diligence access yet.\",\n  quote=\"On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share\", page=\"33\",\n  sort=D(2013,7,24), dfrom=D(2013,7,24), dto=D(2013,7,24))\n\nR(when=\"07/24/2013\", who=\"Party C\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=1,\n  plow=15.00, phigh=17.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Oral indication by telephone, one day after the due date; superseded by the written indication at #23; no substantive diligence access yet.\",\n  quote=\"representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share\", page=\"33\",\n  sort=D(2013,7,24), dfrom=D(2013,7,24), dto=D(2013,7,24))\n\nR(when=\"06/24/2013-08/24/2013 (over the next two months)\", who=\"16 financial NDA signers (residual)\", typ=\"Financial\", event=\"NDA signed\", proc=1, rnd=1,\n  count=16, flag=\"Q4\",\n  note=\"Residual of 18 financial confidentiality signers after Party B and Party C; 20 total signers including Party A and CSC/Pamplona, who have their own rows; signed over two months.\",\n  quote=\"entered into confidentiality agreements with Mac-Gray on a form provided by Mac-Gray, the terms of which were individually negotiated with potential bidders\", page=\"32\",\n  sort=D(2013,7,24), dfrom=D(2013,6,24), dto=D(2013,8,24))\n\nR(when=\"07/25/2013\", who=\"Mac-Gray (Special Committee)\", typ=None, event=\"Round opened\", proc=1, rnd=2,\n  note=\"Round 2: four bidders advanced to staged disclosure, management presentations and electronic data-site access; revised indications to follow, letters sent 08/27.\",\n  quote=\"the Special Committee authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure as discussed at this meeting\", page=\"34\",\n  sort=D(2013,7,25), dfrom=D(2013,7,25), dto=D(2013,7,25))\n\nR(when=\"07/25/2013\", who=\"Party C\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=1,\n  plow=16.00, phigh=16.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Written indication submitted later the same day, a late response to round 1 (nothing was due that day); revises #20; financing not addressed.\",\n  quote=\"Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share\", page=\"34\",\n  sort=D(2013,7,25), dfrom=D(2013,7,25), dto=D(2013,7,25))\n\nR(when=\"08/05/2013\", who=\"Party A\", typ=\"Strategic\", event=\"NDA signed\", proc=1, rnd=2, count=1,\n  note=\"Signed after non-solicitation terms were agreed 07/27; informational package provided so Party A could improve the terms of its 06/21 proposal.\",\n  quote=\"On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\", page=\"34\",\n  sort=D(2013,8,5), dfrom=D(2013,8,5), dto=D(2013,8,5))\n\nR(when=\"between 08/06/2013 and 08/27/2013\", who=\"Party A and CSC/Pamplona; Party B and Party C\", typ=None, event=\"Other material event\", proc=1, rnd=2,\n  note=\"Access difference: Party B and Party C (financial) received broad data-site access; Party A and CSC/Pamplona (strategic) received limited access, with customer data and locations reserved.\",\n  quote=\"Party B and Party C, in light of the fact that they were financial bidders, were given broad access to an electronic data site\", page=\"34\",\n  sort=D(2013,8,6), dfrom=D(2013,8,6), dto=D(2013,8,27))\n\nR(when=\"08/27/2013\", who=\"Mac-Gray (BofA Merrill Lynch)\", typ=None, event=\"Deadline set\", proc=1, rnd=2,\n  note=\"BofA sent letters to all four bidders, once their diligence was substantially complete, requesting revised written proposals by 09/09/2013.\",\n  quote=\"sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013\", page=\"35\",\n  sort=D(2013,8,27), dfrom=D(2013,8,27), dto=D(2013,8,27))\n\nR(when=\"09/09/2013\", who=\"Mac-Gray (BofA Merrill Lynch)\", typ=None, event=\"Deadline\", proc=1, rnd=2, flag=\"Q2\",\n  note=\"Round 2 due date. CSC/Pamplona and Party B submitted on time; Party A and Party C submitted 09/10 and were considered.\",\n  quote=\"instructing such bidders to submit revised written proposals no later than September 9, 2013\", page=\"35\",\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\n\nR(when=\"09/09/2013\", who=\"CSC/Pamplona\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=2,\n  plow=19.50, phigh=19.50, cash=\"Yes\", form=\"Informal\", cond=\"Light\", count=1,\n  note=\"Revised indication; Pamplona committed to provide 100% of capital; requested two weeks of exclusive negotiations; submitted on the due date.\",\n  quote=\"On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share\", page=\"35\",\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\n\nR(when=\"09/09/2013\", who=\"Party B\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=2,\n  plow=18.50, phigh=18.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Revised indication; equity from affiliated funds plus third-party debt; no firm financing commitment reported; submitted on the due date.\",\n  quote=\"On September 9, 2013, Party B also submitted a revised indication of interest with an all-cash purchase price of $18.50 per share\", page=\"35\",\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\n\nR(when=\"09/10/2013\", who=\"Party A\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=2,\n  plow=18.00, phigh=19.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"First submission under its NDA, one day after the due date; to be financed by outstanding credit facilities or affiliated equity sources; no firm financing commitment.\",\n  quote=\"On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share\", page=\"35\",\n  sort=D(2013,9,10), dfrom=D(2013,9,10), dto=D(2013,9,10))\n\nR(when=\"09/10/2013\", who=\"Party C\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=2,\n  plow=16.00, phigh=17.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1,\n  note=\"Revised oral indication, one day after the due date; no firm financing commitment; Party C's last priced bid.\",\n  quote=\"a representative of Party C indicated that it was submitting a revised oral indication of interest with an all-cash purchase price of $16.00 to $17.00 per share\", page=\"35\",\n  sort=D(2013,9,10), dfrom=D(2013,9,10), dto=D(2013,9,10))\n\nR(when=\"09/11/2013\", who=\"Stewart G. MacDonald, Jr. (CEO and stockholder)\", typ=None, event=\"Other material event\", proc=1, rnd=2,\n  note=\"Declined to roll over any shares after being briefed; the committee then agreed to brief him fully (09/12); his support was seen as critical, and he later backed $21.25.\",\n  quote=\"Mr. MacDonald indicated that he had decided that he was not interested in rolling over any of his shares in any transaction\", page=\"35\",\n  sort=D(2013,9,11), dfrom=D(2013,9,11), dto=D(2013,9,11))\n\nR(when=\"09/11/2013\", who=\"Mac-Gray (Special Committee)\", typ=None, event=\"Round opened\", proc=1, rnd=3,\n  note=\"Round 3: final indications requested from all four bidders by 09/18/2013; bidders told Mac-Gray would consider a short period of exclusive negotiation with one bidder.\",\n  quote=\"the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by September 18, 2013\", page=\"36\",\n  sort=D(2013,9,11), dfrom=D(2013,9,11), dto=D(2013,9,11))\n\nR(when=\"09/18/2013\", who=\"Mac-Gray (BofA Merrill Lynch)\", typ=None, event=\"Deadline\", proc=1, rnd=3, flag=\"Q2\",\n  note=\"Round 3 (final) due date. CSC/Pamplona, Party A and Party B responded; Party C made no submission; the Special Committee met 09/19 on the bids in hand.\",\n  quote=\"to request final indications of interest by September 18, 2013\", page=\"36\",\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\n\nR(when=\"09/18/2013\", who=\"CSC/Pamplona\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=3,\n  plow=20.75, phigh=20.75, cash=\"Yes\", form=\"Formal\", cond=\"Light\", count=1,\n  note=\"Final indication responding to the 09/18 final request; Pamplona reiterated its 100% capital commitment; requested two weeks of exclusive negotiations.\",\n  quote=\"On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share\", page=\"36\",\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\n\nR(when=\"09/18/2013\", who=\"Party A\", typ=\"Strategic\", event=\"Bid reaffirmed\", proc=1, rnd=3,\n  plow=18.00, phigh=19.00, cash=\"Yes\", form=\"Formal\", cond=\"Heavy\", count=1,\n  note=\"Reaffirmed by telephone that the standing $18.00-$19.00 indication (carried from #30) was its best and final offer; financing still not committed.\",\n  quote=\"that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer\", page=\"36\",\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\n\nR(when=\"09/18/2013\", who=\"Party B\", typ=\"Financial\", event=\"Bid\", proc=1, rnd=3,\n  plow=21.50, phigh=21.50, cash=\"No\", form=\"Formal\", cond=\"Heavy\", count=1,\n  note=\"Package valued at $21.50 per share: $19.00 cash at closing plus options valued at $2.50 (10% of new equity, vesting on base-case projections over five years); no firm financing commitment.\",\n  quote=\"Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share, including $19.00 of cash to be paid at closing\", page=\"36\",\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\n\nR(when=\"09/18/2013\", who=\"Party C\", typ=\"Financial\", event=\"Did not submit\", proc=1, rnd=3,\n  count=1, exit=\"Not stated\",\n  note=\"No submission in the final round and did not reiterate its $16.00-$17.00 indication; the filing gives no reasons.\",\n  quote=\"Party C did not submit a revised indication of interest or reiterate its prior indication of interest of an all-cash purchase price of $16.00 to $17.00 per share\", page=\"36\",\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\n\nR(when=\"09/19/2013\", who=\"Mac-Gray (Special Committee)\", typ=None, event=\"Round opened\", proc=1, rnd=4, flag=\"Q1\",\n  note=\"Round 4: Special Committee selected CSC/Pamplona as most valuable and authorized exclusivity at $21.25 per share; Mr. MacDonald indicated support at that price.\",\n  quote=\"The Special Committee then authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share\", page=\"37\",\n  sort=D(2013,9,19), dfrom=D(2013,9,19), dto=D(2013,9,19))\n\nR(when=\"09/21/2013\", who=\"CSC/Pamplona\", typ=\"Strategic\", event=\"Bid\", proc=1, rnd=4,\n  plow=21.25, phigh=21.25, cash=\"Yes\", form=\"Formal\", cond=\"Light\", count=1, flag=\"Q1\",\n  note=\"Last and best offer at the $21.25 price the Special Committee required, conditioned on a two-week exclusive negotiation; requested MacDonald voting agreements.\",\n  quote=\"CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer\", page=\"37\",\n  sort=D(2013,9,21), dfrom=D(2013,9,21), dto=D(2013,9,21))\n\nR(when=\"09/24/2013\", who=\"CSC/Pamplona and Mac-Gray\", typ=None, event=\"Exclusivity changed\", proc=1, rnd=4,\n  note=\"Executed with CSC/Pamplona until 5 p.m. ET 10/12/2013; included a $15 million reverse termination fee, no financing contingency and Pamplona funding of 100% of capital; auto-termination on adverse change.\",\n  quote=\"On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013\", page=\"38\",\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\n\nR(when=\"09/24/2013\", who=\"Party A\", typ=\"Strategic\", event=\"Dropped by target\", proc=1, rnd=3,\n  count=1, exit=\"Not stated\", inferred=\"Y\", flag=\"Q3\",\n  note=\"Live rival when Mac-Gray executed exclusivity with CSC/Pamplona; the filing reports no notice to Party A; dropped by the execution.\",\n  quote=\"the revised indication of interest submitted by CSC/Pamplona had the potential of delivering the most value to stockholders\", page=\"37\",\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\n\nR(when=\"09/24/2013\", who=\"Party B\", typ=\"Financial\", event=\"Dropped by target\", proc=1, rnd=3,\n  count=1, exit=\"Not stated\", inferred=\"Y\", flag=\"Q3\",\n  note=\"Live rival when Mac-Gray executed exclusivity with CSC/Pamplona; the filing reports no notice to Party B; dropped by the execution.\",\n  quote=\"On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013\", page=\"38\",\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\n\nR(when=\"09/25/2013\", who=\"Kirkland & Ellis LLP\", typ=None, event=\"Adviser\", proc=1, rnd=4,\n  note=\"Outside legal counsel to CSC/Pamplona; first seen acting when Goodwin Procter delivered the initial draft merger agreement; represented CSC/Pamplona through signing.\",\n  quote=\"Goodwin Procter delivered to Kirkland & Ellis LLP, outside legal counsel to CSC/Pamplona, whom we refer to as Kirkland, the initial draft of the merger agreement\", page=\"38\",\n  sort=D(2013,9,25), dfrom=D(2013,9,25), dto=D(2013,9,25))\n\nR(when=\"10/07/2013\", who=\"Moab Partners, L.P. (Moab)\", typ=None, event=\"Other material event\", proc=1, rnd=4,\n  note=\"No rollover: after Moab was allowed to resume discussions with Pamplona (09/23), it was determined Moab would not roll over any shares in the transaction.\",\n  quote=\"Mr. Daoust reported to the Special Committee that, after discussions between Moab and representatives of Pamplona, it was determined that Moab would not rollover any Moab shares in the transaction\", page=\"39\",\n  sort=D(2013,10,7), dfrom=D(2013,10,7), dto=D(2013,10,7))\n\nR(when=\"10/12/2013\", who=\"CSC/Pamplona and Mac-Gray\", typ=None, event=\"Exclusivity changed\", proc=1, rnd=4,\n  note=\"Extended, after CSC/Pamplona requested more time and agreed to an $11 million Mac-Gray termination fee, from 5 p.m. 10/12 to 11:59 p.m. ET 10/15/2013.\",\n  quote=\"On October 12, 2013, CSC, Pamplona and Mac-Gray executed a letter agreement extending exclusivity until 11:59 p.m. ET on October 15, 2013\", page=\"41\",\n  sort=D(2013,10,12), dfrom=D(2013,10,12), dto=D(2013,10,12))\n\nfor bank in [\"Morgan Stanley & Co. LLC\", \"Deutsche Bank Securities Inc.\", \"Evercore Group L.L.C.\"]:\n    R(when=\"10/14/2013\", who=bank, typ=None, event=\"Adviser\", proc=1, rnd=4,\n      note=\"Financial adviser to Parent (buyer side); first seen in the executed merger agreement; engagement date and role not disclosed.\",\n      quote=\"Except for Morgan Stanley & Co. LLC, Deutsche Bank Securities Inc. and Evercore Group L.L.C., there is no investment banker\", page=\"A-30\",\n      sort=D(2013,10,14), dfrom=D(2013,10,14), dto=D(2013,10,14))\n\nR(when=\"10/14/2013\", who=\"Mac-Gray and CSC/Pamplona\", typ=None, event=\"Merger agreement signed\", proc=1, rnd=\"post\",\n  note=\"Agreed price $21.25 per share in cash; no financing contingency; Pamplona commitment letter ($594 million) delivered; Moab and MacDonald voting agreements effective.\",\n  quote=\"on October 14, 2013, the merger agreement was executed, the Pamplona commitment letter was delivered, Moab and Parent executed the Moab voting agreement and the Mac-Donald voting agreements became effective\", page=\"41\",\n  sort=D(2013,10,14), dfrom=D(2013,10,14), dto=D(2013,10,14))\n\nR(when=\"10/15/2013\", who=\"Mac-Gray and CSC\", typ=None, event=\"Merger announced\", proc=1, rnd=\"post\",\n  note=\"Joint announcement of the executed merger agreement before the U.S. stock markets opened.\",\n  quote=\"On October 15, 2013, before the U.S. stock markets opened, Mac-Gray and CSC jointly announced the execution of the merger agreement\", page=\"41\",\n  sort=D(2013,10,15), dfrom=D(2013,10,15), dto=D(2013,10,15))\n\n# ---------------------------------------------------------------- validate\nfor i, r in enumerate(rows, start=1):\n    if r['note'] and wc(r['note']) > 40:\n        print(f\"NOTE TOO LONG row {i}: {wc(r['note'])}\")\n    if wc(r['quote']) > 30:\n        print(f\"QUOTE TOO LONG row {i}: {wc(r['quote'])}\")\n    check_quote(r['quote'])\n    if r['sort'] < (r['dfrom'] or r['sort']):\n        print(f\"SORT < FROM row {i}\")\n    if r['dto'] and r['sort'] > r['dto']:\n        print(f\"SORT > TO row {i}\")\nprev = None\nfor i, r in enumerate(rows, start=1):\n    if prev and r['sort'] < prev:\n        print(f\"SORT DECREASE at row {i}\")\n    prev = r['sort']\nprint(f\"rows={len(rows)}, quotes OK, notes/quotes within limits\")\n\n# ---------------------------------------------------------------- rounds sheet\nrounds = [\n dict(proc=1, rnd=1, opened=D(2013,6,24),\n      how=\"Special Committee advanced 50 parties (15 strategic, 35 financial) and began outreach; informational package asked for preliminary indications by 07/23\",\n      whoin=\"20 admitted: 2 strategic (Party A, CSC/Pamplona); 18 financial (incl. Party B, Party C)\",\n      due=\"07/23/2013\", outcome=\"Late bids accepted\", final=\"Not final\",\n      bids=\"4: CSC/Pamplona ($18.50); Party B ($17.00-18.00); Party C ($15.00-17.00); Party A (standing 06/21 proposal $17.00-19.00)\",\n      ended=\"Four advanced to management meetings and staged diligence\"),\n dict(proc=1, rnd=2, opened=D(2013,7,25),\n      how=\"Special Committee advanced four bidders to management presentations and staged data-site access; revised indications to follow\",\n      whoin=\"4: Party A, Party B, Party C, CSC/Pamplona\",\n      due=\"09/09/2013\", outcome=\"Late bids accepted\", final=\"Not final\",\n      bids=\"4: CSC/Pamplona ($19.50); Party B ($18.50); Party A ($18.00-19.00); Party C ($16.00-17.00)\",\n      ended=\"Four advanced to final indications\"),\n dict(proc=1, rnd=3, opened=D(2013,9,11),\n      how=\"Special Committee requested final indications by 09/18 and flagged a possible short exclusivity\",\n      whoin=\"4: Party A, Party B, Party C, CSC/Pamplona\",\n      due=\"09/18/2013\", outcome=\"Enforced\", final=\"Announced as final\",\n      bids=\"3: CSC/Pamplona ($20.75); Party B ($21.50 valued; $19.00 cash plus options); Party A ($18.00-19.00, best and final); Party C none\",\n      ended=\"CSC/Pamplona selected; Party C out\"),\n dict(proc=1, rnd=4, opened=D(2013,9,19),\n      how=\"Special Committee selected CSC/Pamplona and authorized exclusivity negotiations at $21.25 per share\",\n      whoin=\"1: CSC/Pamplona\",\n      due=\"none stated\", outcome=\"No deadline stated\", final=\"Inferred final\",\n      bids=\"1: CSC/Pamplona ($21.25)\",\n      ended=\"signing\"),\n]\n\n# ---------------------------------------------------------------- questions\nquestions = [\n dict(q=\"Q1\",\n   question=\"Round map: I read four rounds, with round 4 opening 09/19/2013 when the Special Committee selected CSC/Pamplona and moved to definitive negotiation; the 09/21 $21.25 last-and-best bid is round 4 (Inferred final). Alternative: three rounds - C8 says a further price-improvement request to the same finalists after a final solicitation, and exclusivity inside an established final stage, are not a new round - so the $21.25 bid sits in round 3 and no round-4 line exists. Which reading?\",\n   answer=\"Keep four rounds: C8 lists moving to definitive negotiation with selected bidders as a new-round trigger, and round 3's competitive solicitation ended when CSC/Pamplona was selected 09/19.\",\n   why=\"pp. 36-37: after the 09/18 final bids the committee judged CSC/Pamplona most valuable, required it to raise its price above $20.75 and authorized exclusivity at $21.25; exclusivity executed 09/24 (p. 38).\",\n   rows=\"#39, #40; Rounds sheet rounds 3-4\",\n   changes=\"The three-round reading deletes #39, moves the $21.25 bid into round 3, and changes round 3's 'How it ended' to signing; live-bidder counts are unaffected.\"),\n dict(q=\"Q2\",\n   question=\"Deadline outcomes. Round 1 (due 07/23): CSC/Pamplona bid on time, Party B and Party C arrived 07/24 and were reviewed 07/25 - I record 'Late bids accepted'. Round 2 (due 09/09): Party A and Party C submitted 09/10 and were reviewed 09/11 - also 'Late bids accepted'. Round 3 (due 09/18): three responded, Party C none, and the committee acted - 'Enforced'. Alternative: call all three deadlines Enforced?\",\n   answer=\"Keep as recorded. C11 makes 'Late bids accepted' the label when the target considered bids arriving after the due date with no revision; round 3 saw no late bid, so 'Enforced'.\",\n   why=\"pp. 33-34: 07/24-07/25 bids reviewed at the 07/25 meeting; pp. 35-36: 09/10 bids reviewed 09/11; 09/19 meeting acted on the 09/18 bids (p. 36).\",\n   rows=\"#16, #19, #20, #23, #27, #30, #31, #34; Rounds sheet 'Deadline outcome'\",\n   changes=\"Under 'Enforced', the Rounds sheet would show deadlines as strict and the late rows as unsolicited; live-bidder counts do not change.\"),\n dict(q=\"Q3\",\n   question=\"Party A's and Party B's exits: still live after the 09/18 final bids, they were displaced when Mac-Gray executed exclusivity with CSC/Pamplona 09/24; I date both exits 09/24 (inferred, 'Dropped by target'), as C16 directs. Alternative: date them at signing 10/14 as 'Not selected at signing', since the filing never says they were told they were out?\",\n   answer=\"Keep 09/24: the exclusive agreement with a rival displaced them on its execution date; no notice is reported, so mark inferred.\",\n   why=\"p. 37 (committee selected CSC/Pamplona); p. 38 (exclusivity executed 09/24/2013); the filing reports no notice to Party A or Party B.\",\n   rows=\"#42, #43\",\n   changes=\"Exits would move to 10/14 with reason 'Not selected at signing', leaving three live bidders from 09/24 to 10/14 instead of one.\"),\n dict(q=\"Q4\",\n   question=\"The 16 residual financial NDA signers exit as one inferred cohort 'Did not submit' at the 07/23/2013 due date (20 signers less Party A less 3 submitters = 16). Alternative: some of the residual may have signed after 07/23 and so were never solicited, making the count smaller?\",\n   answer=\"Keep 16 at 07/23: the filing reports one two-month wave of 20 signings; only Party A's is dated later (08/05) and its standing proposal keeps it accounted for.\",\n   why=\"p. 32: 'Over the next two months a total of 20 potential bidders... entered into confidentiality agreements'; p. 34: Party A's NDA 08/05/2013.\",\n   rows=\"#18, #21\",\n   changes=\"A smaller eligible base reduces the inferred exits and leaves unsolicited signers unaccounted; totals no longer reconcile to the stated 20.\"),\n]\n\n# ---------------------------------------------------------------- deal facts\nfacts = [\n (\"Target\", \"Mac-Gray Corporation (laundry facilities management contractor; NYSE-listed)\"),\n (\"Acquirer\", \"CSC ServiceWorks, Inc., with Spin Holdco Inc. (Parent), CSC ServiceWorks Holdings, Inc. and CSC Fenway, Inc.; backed by Pamplona Capital Partners III, L.P.\"),\n (\"Acquirer type\", \"Strategic (sponsor-owned operating company: CSC is an operating laundry-services company owned by the private-equity firm Pamplona)\"),\n (\"Agreed price and consideration\", \"$21.25 per share in cash at closing; no financing contingency; Pamplona committed $594 million\"),\n (\"Merger agreement signed\", D(2013,10,14)),\n (\"Merger announced\", D(2013,10,15)),\n (\"Filing type and date\", \"DEFM14A definitive proxy statement dated 12/04/2013\"),\n (\"Background pages\", \"27-41\"),\n (\"Initiation\", \"Mixed - Mac-Gray/BofA approached Party A on 04/08/2013, but Party A's unsolicited 06/21/2013 proposal and Moab's proxy activism also shaped the launch\"),\n (\"Number of processes\", 1),\n (\"Auction screen\", \"Met - 20 independent prospective acquirers executed confidentiality agreements (2 strategic, 18 financial)\"),\n (\"Whole-company bids\", \"Yes - all bids were for the whole company\"),\n (\"Currency and units of bid prices\", \"US dollars per share (Party B's 09/18/2013 bid valued at $21.50 per share included options it valued at $2.50)\"),\n (\"Target financial advisers\", \"BofA Merrill Lynch (primary; engaged 10/23/2012 for the 2011-2012 Discussions, terminated 05/15/2013, re-engaged 05/31/2013)\"),\n (\"Target legal advisers\", \"Goodwin Procter LLP\"),\n (\"Account\", \"Mac-Gray, a laundry facilities management contractor, reviewed strategic alternatives with BofA Merrill Lynch, and on April 8, 2013 BofA approached Party A about a possible combination. After Party A's unsolicited June 21 proposal of $17.00-$19.00 per share, the Special Committee decided on June 24 to explore a sale and BofA approached 50 parties (15 strategic, 35 financial); 20 signed confidentiality agreements. Four bidders emerged - CSC/Pamplona, Party A, Party B and Party C - whose July preliminary indications ranged from $15.00-$17.00 to $18.50. After management presentations and staged diligence, September revised indications were $19.50 (CSC/Pamplona), $18.50 (Party B), $18.00-$19.00 (Party A) and $16.00-$17.00 (Party C). A final round on September 18 brought $20.75 from CSC/Pamplona, a $21.50-valued cash-plus-options package from Party B and a best-and-final $18.00-$19.00 from Party A; Party C did not submit. The Special Committee chose CSC/Pamplona, secured a raise to $21.25, and signed on October 14, announcing October 15.\"),\n]\n\n# ---------------------------------------------------------------- workbook\nwb = Workbook()\nhdr_font = Font(bold=True)\nwrap = Alignment(wrap_text=True, vertical=\"top\")\n\ndef style_sheet(ws, headers, ncols, nrows):\n    ws.freeze_panes = \"A2\"\n    ws.auto_filter.ref = f\"A1:{get_column_letter(ncols)}{nrows}\"\n    for c in range(1, ncols+1):\n        cell = ws.cell(row=1, column=c)\n        cell.font = hdr_font\n        cell.alignment = wrap\n    for r in range(2, nrows+1):\n        for c in range(1, ncols+1):\n            ws.cell(row=r, column=c).alignment = wrap\n\n# --- Deal ledger\nws = wb.active\nws.title = \"Deal ledger\"\nheaders = [\"#\",\"When\",\"Who\",\"Type\",\"Event\",\"Process\",\"Round\",\"Price low\",\"Price high\",\"All cash\",\n           \"Formality\",\"Conditions\",\"Count\",\"Exit reason\",\"Inferred\",\"Note\",\"Quote and page\",\"Flag\",\n           \"Reviewer note\",\"Sort date\",\"Date from\",\"Date to\"]\nws.append(headers)\nfor i, r in enumerate(rows, start=1):\n    ws.append([i, r['when'], r['who'], r['typ'], r['event'], r['proc'], r['rnd'],\n               r['plow'], r['phigh'], r['cash'], r['form'], r['cond'], r['count'],\n               r['exit'], r['inferred'], r['note'],\n               f\"\\u201c{r['quote']}\\u201d (p. {r['page']})\", r['flag'], None,\n               r['sort'], r['dfrom'], r['dto']])\nstyle_sheet(ws, headers, len(headers), len(rows)+1)\nfor rr in range(2, len(rows)+2):\n    ws.cell(row=rr, column=20).number_format = \"MM/DD/YYYY\"\n    ws.cell(row=rr, column=21).number_format = \"MM/DD/YYYY\"\n    ws.cell(row=rr, column=22).number_format = \"MM/DD/YYYY\"\n    for c in (8, 9):\n        ws.cell(row=rr, column=c).number_format = \"0.00\"\nwidths = [4,17,24,10,16,8,6,9,9,8,10,10,6,14,8,60,60,6,12,11,11,11]\nfor c, w in enumerate(widths, start=1):\n    ws.column_dimensions[get_column_letter(c)].width = w\n\n# --- Rounds\nws = wb.create_sheet(\"Rounds\")\nheaders = [\"Process\",\"Round\",\"Opened\",\"How opened\",\"Who was in\",\"Due dates\",\"Deadline outcome\",\"Finality\",\"Bids received\",\"How it ended\"]\nws.append(headers)\nfor r in rounds:\n    ws.append([r['proc'], r['rnd'], r['opened'], r['how'], r['whoin'], r['due'], r['outcome'], r['final'], r['bids'], r['ended']])\nstyle_sheet(ws, headers, len(headers), len(rounds)+1)\nfor rr in range(2, len(rounds)+2):\n    ws.cell(row=rr, column=3).number_format = \"MM/DD/YYYY\"\nwidths = [8,6,11,48,40,13,17,15,55,32]\nfor c, w in enumerate(widths, start=1):\n    ws.column_dimensions[get_column_letter(c)].width = w\n\n# --- Questions\nws = wb.create_sheet(\"Questions\")\nheaders = [\"Q\",\"Question\",\"Recommended answer\",\"Why, with page\",\"Rows affected\",\"What changes if answered differently\",\"Reviewer note\"]\nws.append(headers)\nfor q in questions:\n    ws.append([q['q'], q['question'], q['answer'], q['why'], q['rows'], q['changes'], None])\nstyle_sheet(ws, headers, len(headers), len(questions)+1)\nwidths = [5,60,45,45,26,45,12]\nfor c, w in enumerate(widths, start=1):\n    ws.column_dimensions[get_column_letter(c)].width = w\n\n# --- Deal facts\nws = wb.create_sheet(\"Deal facts\")\nheaders = [\"Field\",\"Value\"]\nws.append(headers)\nfor f, v in facts:\n    ws.append([f, v])\nstyle_sheet(ws, headers, len(headers), len(facts)+1)\nfor rr in range(2, len(facts)+2):\n    if isinstance(ws.cell(row=rr, column=2).value, date):\n        ws.cell(row=rr, column=2).number_format = \"MM/DD/YYYY\"\nwidths = [30,110]\nfor c, w in enumerate(widths, start=1):\n    ws.column_dimensions[get_column_letter(c)].width = w\n\nimport os\nos.makedirs(os.path.dirname(OUT), exist_ok=True)\nwb.save(OUT)\nprint(\"saved\", OUT)\nprint(\"sheets:\", wb.sheetnames)\n"},"output":"Created file successfully: /tmp/opencode/work/build_ledger.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/work/build_ledger.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/work/build_ledger.py\", \"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Build mac-gray.xlsx deal ledger from the Mac-Gray DEFM14A (2013-12-04).\\\"\\\"\\\"\\nimport re\\nfrom datetime import date\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment\\nfrom openpyxl.utils import get_column_letter\\n\\nFILING = '/tmp/opencode/work/filing_pages.txt'\\nOUT = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\\n\\ntext = open(FILING).read()\\nnorm_filing = re.sub(r'\\\\s+', ' ', text)\\n\\ndef check_quote(q):\\n    nq = re.sub(r'\\\\s+', ' ', q).strip()\\n    assert nq in norm_filing, f\\\"QUOTE NOT FOUND: {nq[:80]}...\\\"\\n    return len(nq.split())\\n\\ndef wc(s):\\n    return 0 if not s else len(s.split())\\n\\nD = date\\nrows = []\\ndef R(**kw):\\n    rows.append(kw)\\n\\n# ---------------------------------------------------------------- ledger rows\\nR(when=\\\"10/23/2012\\\", who=\\\"BofA Merrill Lynch\\\", typ=None, event=\\\"Adviser\\\", proc=1, rnd=0,\\n  note=\\\"Engaged by Mac-Gray for the 2011-2012 Discussions on a possible Mac-Gray acquisition of CSC (not a sale of Mac-Gray); mandate terminated 05/15/2013 and replaced by the 2013 sale-process engagement.\\\",\\n  quote=\\\"In connection with Mac-Gray's consideration of a possible acquisition of CSC, which we refer to as the 2011-2012 Discussions, Mac-Gray engaged BofA Merrill Lynch on October 23, 2012\\\", page=\\\"27\\\",\\n  sort=D(2012,10,23), dfrom=D(2012,10,23), dto=D(2012,10,23))\\n\\nR(when=\\\"04/08/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"Target interest\\\", proc=1, rnd=0,\\n  note=\\\"Following the April 5 Board authorization to explore transactional opportunities with BofA, BofA telephoned Party A, which indicated it might consider a business combination; no price discussed.\\\",\\n  quote=\\\"representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray\\\", page=\\\"27\\\",\\n  sort=D(2013,4,8), dfrom=D(2013,4,8), dto=D(2013,4,8))\\n\\nR(when=\\\"05/09/2013\\\", who=\\\"Goodwin Procter LLP\\\", typ=None, event=\\\"Adviser\\\", proc=1, rnd=0,\\n  note=\\\"Outside legal counsel to Mac-Gray; first seen acting at the May 9, 2013 Board meeting; advised the Transaction and Special Committees through signing.\\\",\\n  quote=\\\"Goodwin Procter LLP, outside legal counsel to Mac-Gray, were also in attendance for all or portions of the meeting\\\", page=\\\"27\\\",\\n  sort=D(2013,5,9), dfrom=D(2013,5,9), dto=D(2013,5,9))\\n\\nR(when=\\\"05/15/2013\\\", who=\\\"BofA Merrill Lynch\\\", typ=None, event=\\\"Adviser ended\\\", proc=1, rnd=0,\\n  note=\\\"Transaction Committee decided 05/14/2013 to terminate BofA's 2011-2012 engagement letter, given CSC's sale process had ended and BofA was a candidate for the new mandate; termination letter sent 05/15/2013.\\\",\\n  quote=\\\"On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions\\\", page=\\\"29\\\",\\n  sort=D(2013,5,15), dfrom=D(2013,5,15), dto=D(2013,5,15))\\n\\nR(when=\\\"05/30/2013\\\", who=\\\"Moab Partners, L.P. (Moab)\\\", typ=None, event=\\\"Activist\\\", proc=1, rnd=0,\\n  note=\\\"Proxy contest leading up to the annual meeting; Moab's nominees Michael Rothenberg and James Hyman elected in place of two incumbents; Rothenberg later excluded from sale-process deliberations over a possible Moab rollover.\\\",\\n  quote=\\\"Mac-Gray and Moab engaged in a proxy contest leading up to the annual meeting and Mr. Rothenberg and Mr. Hyman were elected in place of Mac-Gray's incumbent nominees\\\", page=\\\"29\\\",\\n  sort=D(2013,5,30), dfrom=D(2013,5,30), dto=D(2013,5,30))\\n\\nR(when=\\\"05/31/2013\\\", who=\\\"BofA Merrill Lynch\\\", typ=None, event=\\\"Adviser\\\", proc=1, rnd=0,\\n  note=\\\"Board approved the engagement 05/30/2013 after three banks presented; BofA agreed not to source acquisition financing for any buyer without Mac-Gray's prior written consent.\\\",\\n  quote=\\\"On May 31, 2013, Mac-Gray entered into an engagement letter with BofA Merrill Lynch with respect to the Board's undertaking a review of strategic alternatives, including a potential sale process\\\", page=\\\"30\\\",\\n  sort=D(2013,5,31), dfrom=D(2013,5,31), dto=D(2013,5,31))\\n\\nR(when=\\\"06/21/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=0,\\n  plow=17.00, phigh=19.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Unsolicited first proposal, before any NDA or diligence access; all-cash range $17.00-$19.00; Conditions Heavy by context (no substantive diligence access yet).\\\",\\n  quote=\\\"Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share\\\", page=\\\"30\\\",\\n  sort=D(2013,6,21), dfrom=D(2013,6,21), dto=D(2013,6,21))\\n\\nR(when=\\\"06/24/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", typ=None, event=\\\"Target sale decision\\\", proc=1, rnd=1,\\n  note=\\\"Special Committee of six independent directors formed (Bullock chairman) and concluded it was in stockholders' best interests to consider a potential sale, compared with continuing as a stand-alone company.\\\",\\n  quote=\\\"it would be in the best interests of stockholders to consider a potential sale of Mac-Gray and to review this alternative as compared to Mac-Gray's continuing as a stand-alone company\\\", page=\\\"31\\\",\\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=D(2013,6,24))\\n\\nR(when=\\\"06/24/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", typ=None, event=\\\"Round opened\\\", proc=1, rnd=1,\\n  note=\\\"Round 1: approach 50 parties (15 potential strategic, 35 potential financial) to solicit preliminary indications, due 07/23/2013; outreach executed over the following weeks.\\\",\\n  quote=\\\"50 parties, including CSC and Pamplona, who together we refer to as CSC/Pamplona, and Party A, to solicit potential interest in a transaction with Mac-Gray\\\", page=\\\"32\\\",\\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=D(2013,6,24))\\n\\nR(when=\\\"after 06/24/2013\\\", who=\\\"15 potential strategic buyers\\\", typ=\\\"Strategic\\\", event=\\\"Contact\\\", proc=1, rnd=1, count=15,\\n  note=\\\"First outreach wave by BofA for Mac-Gray; 15 of the 50 parties approached were potential strategic buyers; contacts continued over the following weeks.\\\",\\n  quote=\\\"15 of which were potential strategic buyers and 35 of which were potential financial buyers\\\", page=\\\"32\\\",\\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=None)\\n\\nR(when=\\\"after 06/24/2013\\\", who=\\\"35 potential financial buyers\\\", typ=\\\"Financial\\\", event=\\\"Contact\\\", proc=1, rnd=1, count=35,\\n  note=\\\"First outreach wave by BofA for Mac-Gray; 35 of the 50 parties were potential financial buyers, including private equity firms.\\\",\\n  quote=\\\"in accordance with the directives of the Special Committee, BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting\\\", page=\\\"32\\\",\\n  sort=D(2013,6,24), dfrom=D(2013,6,24), dto=None)\\n\\nR(when=\\\"06/28/2013\\\", who=\\\"Party B\\\", typ=\\\"Financial\\\", event=\\\"NDA signed\\\", proc=1, rnd=1, count=1,\\n  note=\\\"Confidentiality and standstill agreement with Mac-Gray; informational package provided to formulate a preliminary indication of interest.\\\",\\n  quote=\\\"Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\\\", page=\\\"32\\\",\\n  sort=D(2013,6,28), dfrom=D(2013,6,28), dto=D(2013,6,28))\\n\\nR(when=\\\"06/30/2013\\\", who=\\\"Party C\\\", typ=\\\"Financial\\\", event=\\\"NDA signed\\\", proc=1, rnd=1, count=1,\\n  note=\\\"Confidentiality and standstill agreement with Mac-Gray; informational package provided to formulate a preliminary indication of interest.\\\",\\n  quote=\\\"On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\\\", page=\\\"32\\\",\\n  sort=D(2013,6,30), dfrom=D(2013,6,30), dto=D(2013,6,30))\\n\\nR(when=\\\"07/06/2013\\\", who=\\\"Moab Partners, L.P. (Moab)\\\", typ=None, event=\\\"Other material event\\\", proc=1, rnd=1,\\n  note=\\\"Denied Moab's request to negotiate exclusively with CSC/Pamplona over an equity rollover; Special Committee said it was premature but discussions would be permitted later.\\\",\\n  quote=\\\"the Special Committee decided to deny the exclusivity request at this stage of the process\\\", page=\\\"33\\\",\\n  sort=D(2013,7,6), dfrom=D(2013,7,6), dto=D(2013,7,6))\\n\\nR(when=\\\"07/11/2013\\\", who=\\\"CSC/Pamplona\\\", typ=\\\"Strategic\\\", event=\\\"NDA signed\\\", proc=1, rnd=1, count=1,\\n  note=\\\"Confidentiality and standstill agreement with Mac-Gray; Pamplona said business and legal diligence would be minimal given its familiarity with Mac-Gray.\\\",\\n  quote=\\\"On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package\\\", page=\\\"33\\\",\\n  sort=D(2013,7,11), dfrom=D(2013,7,11), dto=D(2013,7,11))\\n\\nR(when=\\\"07/23/2013\\\", who=\\\"Mac-Gray (BofA Merrill Lynch)\\\", typ=None, event=\\\"Deadline\\\", proc=1, rnd=1, flag=\\\"Q2\\\",\\n  note=\\\"Round 1 due date for preliminary indications. CSC/Pamplona bid on time; Party B and Party C indications arrived 07/24 and were considered.\\\",\\n  quote=\\\"which they were instructed to submit by July 23, 2013\\\", page=\\\"32\\\",\\n  sort=D(2013,7,23), dfrom=D(2013,7,23), dto=D(2013,7,23))\\n\\nR(when=\\\"07/23/2013\\\", who=\\\"CSC/Pamplona\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=1,\\n  plow=18.50, phigh=18.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Preliminary indication of interest submitted on the 07/23 due date; no financing disclosure and no substantive diligence access yet, so Heavy by context.\\\",\\n  quote=\\\"On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share\\\", page=\\\"33\\\",\\n  sort=D(2013,7,23), dfrom=D(2013,7,23), dto=D(2013,7,23))\\n\\nR(when=\\\"by 07/23/2013\\\", who=\\\"16 financial NDA signers (residual)\\\", typ=\\\"Financial\\\", event=\\\"Did not submit\\\", proc=1, rnd=1,\\n  count=16, exit=\\\"Not stated\\\", inferred=\\\"Y\\\", flag=\\\"Q4\\\",\\n  note=\\\"Arithmetic: 20 signers less Party A (not yet signed) and the three submitters (CSC/Pamplona, Party B, Party C) leaves 16 financial signers with no indication by the 07/23 due date.\\\",\\n  quote=\\\"a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders (including Party B and Party C), entered into confidentiality agreements with Mac-Gray\\\", page=\\\"32\\\",\\n  sort=D(2013,7,23), dfrom=None, dto=D(2013,7,23))\\n\\nR(when=\\\"07/24/2013\\\", who=\\\"Party B\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=1,\\n  plow=17.00, phigh=18.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Preliminary indication one day after the 07/23 due date, accepted and reviewed at the 07/25 meeting; no substantive diligence access yet.\\\",\\n  quote=\\\"On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share\\\", page=\\\"33\\\",\\n  sort=D(2013,7,24), dfrom=D(2013,7,24), dto=D(2013,7,24))\\n\\nR(when=\\\"07/24/2013\\\", who=\\\"Party C\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=1,\\n  plow=15.00, phigh=17.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Oral indication by telephone, one day after the due date; superseded by the written indication at #23; no substantive diligence access yet.\\\",\\n  quote=\\\"representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share\\\", page=\\\"33\\\",\\n  sort=D(2013,7,24), dfrom=D(2013,7,24), dto=D(2013,7,24))\\n\\nR(when=\\\"06/24/2013-08/24/2013 (over the next two months)\\\", who=\\\"16 financial NDA signers (residual)\\\", typ=\\\"Financial\\\", event=\\\"NDA signed\\\", proc=1, rnd=1,\\n  count=16, flag=\\\"Q4\\\",\\n  note=\\\"Residual of 18 financial confidentiality signers after Party B and Party C; 20 total signers including Party A and CSC/Pamplona, who have their own rows; signed over two months.\\\",\\n  quote=\\\"entered into confidentiality agreements with Mac-Gray on a form provided by Mac-Gray, the terms of which were individually negotiated with potential bidders\\\", page=\\\"32\\\",\\n  sort=D(2013,7,24), dfrom=D(2013,6,24), dto=D(2013,8,24))\\n\\nR(when=\\\"07/25/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", typ=None, event=\\\"Round opened\\\", proc=1, rnd=2,\\n  note=\\\"Round 2: four bidders advanced to staged disclosure, management presentations and electronic data-site access; revised indications to follow, letters sent 08/27.\\\",\\n  quote=\\\"the Special Committee authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure as discussed at this meeting\\\", page=\\\"34\\\",\\n  sort=D(2013,7,25), dfrom=D(2013,7,25), dto=D(2013,7,25))\\n\\nR(when=\\\"07/25/2013\\\", who=\\\"Party C\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=1,\\n  plow=16.00, phigh=16.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Written indication submitted later the same day, a late response to round 1 (nothing was due that day); revises #20; financing not addressed.\\\",\\n  quote=\\\"Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share\\\", page=\\\"34\\\",\\n  sort=D(2013,7,25), dfrom=D(2013,7,25), dto=D(2013,7,25))\\n\\nR(when=\\\"08/05/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"NDA signed\\\", proc=1, rnd=2, count=1,\\n  note=\\\"Signed after non-solicitation terms were agreed 07/27; informational package provided so Party A could improve the terms of its 06/21 proposal.\\\",\\n  quote=\\\"On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\\\", page=\\\"34\\\",\\n  sort=D(2013,8,5), dfrom=D(2013,8,5), dto=D(2013,8,5))\\n\\nR(when=\\\"between 08/06/2013 and 08/27/2013\\\", who=\\\"Party A and CSC/Pamplona; Party B and Party C\\\", typ=None, event=\\\"Other material event\\\", proc=1, rnd=2,\\n  note=\\\"Access difference: Party B and Party C (financial) received broad data-site access; Party A and CSC/Pamplona (strategic) received limited access, with customer data and locations reserved.\\\",\\n  quote=\\\"Party B and Party C, in light of the fact that they were financial bidders, were given broad access to an electronic data site\\\", page=\\\"34\\\",\\n  sort=D(2013,8,6), dfrom=D(2013,8,6), dto=D(2013,8,27))\\n\\nR(when=\\\"08/27/2013\\\", who=\\\"Mac-Gray (BofA Merrill Lynch)\\\", typ=None, event=\\\"Deadline set\\\", proc=1, rnd=2,\\n  note=\\\"BofA sent letters to all four bidders, once their diligence was substantially complete, requesting revised written proposals by 09/09/2013.\\\",\\n  quote=\\\"sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013\\\", page=\\\"35\\\",\\n  sort=D(2013,8,27), dfrom=D(2013,8,27), dto=D(2013,8,27))\\n\\nR(when=\\\"09/09/2013\\\", who=\\\"Mac-Gray (BofA Merrill Lynch)\\\", typ=None, event=\\\"Deadline\\\", proc=1, rnd=2, flag=\\\"Q2\\\",\\n  note=\\\"Round 2 due date. CSC/Pamplona and Party B submitted on time; Party A and Party C submitted 09/10 and were considered.\\\",\\n  quote=\\\"instructing such bidders to submit revised written proposals no later than September 9, 2013\\\", page=\\\"35\\\",\\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\\n\\nR(when=\\\"09/09/2013\\\", who=\\\"CSC/Pamplona\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=2,\\n  plow=19.50, phigh=19.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Light\\\", count=1,\\n  note=\\\"Revised indication; Pamplona committed to provide 100% of capital; requested two weeks of exclusive negotiations; submitted on the due date.\\\",\\n  quote=\\\"On September 9, 2013, CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share\\\", page=\\\"35\\\",\\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\\n\\nR(when=\\\"09/09/2013\\\", who=\\\"Party B\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=2,\\n  plow=18.50, phigh=18.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Revised indication; equity from affiliated funds plus third-party debt; no firm financing commitment reported; submitted on the due date.\\\",\\n  quote=\\\"On September 9, 2013, Party B also submitted a revised indication of interest with an all-cash purchase price of $18.50 per share\\\", page=\\\"35\\\",\\n  sort=D(2013,9,9), dfrom=D(2013,9,9), dto=D(2013,9,9))\\n\\nR(when=\\\"09/10/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=2,\\n  plow=18.00, phigh=19.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"First submission under its NDA, one day after the due date; to be financed by outstanding credit facilities or affiliated equity sources; no firm financing commitment.\\\",\\n  quote=\\\"On September 10, 2013, Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share\\\", page=\\\"35\\\",\\n  sort=D(2013,9,10), dfrom=D(2013,9,10), dto=D(2013,9,10))\\n\\nR(when=\\\"09/10/2013\\\", who=\\\"Party C\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=2,\\n  plow=16.00, phigh=17.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Revised oral indication, one day after the due date; no firm financing commitment; Party C's last priced bid.\\\",\\n  quote=\\\"a representative of Party C indicated that it was submitting a revised oral indication of interest with an all-cash purchase price of $16.00 to $17.00 per share\\\", page=\\\"35\\\",\\n  sort=D(2013,9,10), dfrom=D(2013,9,10), dto=D(2013,9,10))\\n\\nR(when=\\\"09/11/2013\\\", who=\\\"Stewart G. MacDonald, Jr. (CEO and stockholder)\\\", typ=None, event=\\\"Other material event\\\", proc=1, rnd=2,\\n  note=\\\"Declined to roll over any shares after being briefed; the committee then agreed to brief him fully (09/12); his support was seen as critical, and he later backed $21.25.\\\",\\n  quote=\\\"Mr. MacDonald indicated that he had decided that he was not interested in rolling over any of his shares in any transaction\\\", page=\\\"35\\\",\\n  sort=D(2013,9,11), dfrom=D(2013,9,11), dto=D(2013,9,11))\\n\\nR(when=\\\"09/11/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", typ=None, event=\\\"Round opened\\\", proc=1, rnd=3,\\n  note=\\\"Round 3: final indications requested from all four bidders by 09/18/2013; bidders told Mac-Gray would consider a short period of exclusive negotiation with one bidder.\\\",\\n  quote=\\\"the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest by September 18, 2013\\\", page=\\\"36\\\",\\n  sort=D(2013,9,11), dfrom=D(2013,9,11), dto=D(2013,9,11))\\n\\nR(when=\\\"09/18/2013\\\", who=\\\"Mac-Gray (BofA Merrill Lynch)\\\", typ=None, event=\\\"Deadline\\\", proc=1, rnd=3, flag=\\\"Q2\\\",\\n  note=\\\"Round 3 (final) due date. CSC/Pamplona, Party A and Party B responded; Party C made no submission; the Special Committee met 09/19 on the bids in hand.\\\",\\n  quote=\\\"to request final indications of interest by September 18, 2013\\\", page=\\\"36\\\",\\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\\n\\nR(when=\\\"09/18/2013\\\", who=\\\"CSC/Pamplona\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=3,\\n  plow=20.75, phigh=20.75, cash=\\\"Yes\\\", form=\\\"Formal\\\", cond=\\\"Light\\\", count=1,\\n  note=\\\"Final indication responding to the 09/18 final request; Pamplona reiterated its 100% capital commitment; requested two weeks of exclusive negotiations.\\\",\\n  quote=\\\"On September 18, 2013, CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share\\\", page=\\\"36\\\",\\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\\n\\nR(when=\\\"09/18/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"Bid reaffirmed\\\", proc=1, rnd=3,\\n  plow=18.00, phigh=19.00, cash=\\\"Yes\\\", form=\\\"Formal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Reaffirmed by telephone that the standing $18.00-$19.00 indication (carried from #30) was its best and final offer; financing still not committed.\\\",\\n  quote=\\\"that its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer\\\", page=\\\"36\\\",\\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\\n\\nR(when=\\\"09/18/2013\\\", who=\\\"Party B\\\", typ=\\\"Financial\\\", event=\\\"Bid\\\", proc=1, rnd=3,\\n  plow=21.50, phigh=21.50, cash=\\\"No\\\", form=\\\"Formal\\\", cond=\\\"Heavy\\\", count=1,\\n  note=\\\"Package valued at $21.50 per share: $19.00 cash at closing plus options valued at $2.50 (10% of new equity, vesting on base-case projections over five years); no firm financing commitment.\\\",\\n  quote=\\\"Party B also submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share, including $19.00 of cash to be paid at closing\\\", page=\\\"36\\\",\\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\\n\\nR(when=\\\"09/18/2013\\\", who=\\\"Party C\\\", typ=\\\"Financial\\\", event=\\\"Did not submit\\\", proc=1, rnd=3,\\n  count=1, exit=\\\"Not stated\\\",\\n  note=\\\"No submission in the final round and did not reiterate its $16.00-$17.00 indication; the filing gives no reasons.\\\",\\n  quote=\\\"Party C did not submit a revised indication of interest or reiterate its prior indication of interest of an all-cash purchase price of $16.00 to $17.00 per share\\\", page=\\\"36\\\",\\n  sort=D(2013,9,18), dfrom=D(2013,9,18), dto=D(2013,9,18))\\n\\nR(when=\\\"09/19/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", typ=None, event=\\\"Round opened\\\", proc=1, rnd=4, flag=\\\"Q1\\\",\\n  note=\\\"Round 4: Special Committee selected CSC/Pamplona as most valuable and authorized exclusivity at $21.25 per share; Mr. MacDonald indicated support at that price.\\\",\\n  quote=\\\"The Special Committee then authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share\\\", page=\\\"37\\\",\\n  sort=D(2013,9,19), dfrom=D(2013,9,19), dto=D(2013,9,19))\\n\\nR(when=\\\"09/21/2013\\\", who=\\\"CSC/Pamplona\\\", typ=\\\"Strategic\\\", event=\\\"Bid\\\", proc=1, rnd=4,\\n  plow=21.25, phigh=21.25, cash=\\\"Yes\\\", form=\\\"Formal\\\", cond=\\\"Light\\\", count=1, flag=\\\"Q1\\\",\\n  note=\\\"Last and best offer at the $21.25 price the Special Committee required, conditioned on a two-week exclusive negotiation; requested MacDonald voting agreements.\\\",\\n  quote=\\\"CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer\\\", page=\\\"37\\\",\\n  sort=D(2013,9,21), dfrom=D(2013,9,21), dto=D(2013,9,21))\\n\\nR(when=\\\"09/24/2013\\\", who=\\\"CSC/Pamplona and Mac-Gray\\\", typ=None, event=\\\"Exclusivity changed\\\", proc=1, rnd=4,\\n  note=\\\"Executed with CSC/Pamplona until 5 p.m. ET 10/12/2013; included a $15 million reverse termination fee, no financing contingency and Pamplona funding of 100% of capital; auto-termination on adverse change.\\\",\\n  quote=\\\"On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013\\\", page=\\\"38\\\",\\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\\n\\nR(when=\\\"09/24/2013\\\", who=\\\"Party A\\\", typ=\\\"Strategic\\\", event=\\\"Dropped by target\\\", proc=1, rnd=3,\\n  count=1, exit=\\\"Not stated\\\", inferred=\\\"Y\\\", flag=\\\"Q3\\\",\\n  note=\\\"Live rival when Mac-Gray executed exclusivity with CSC/Pamplona; the filing reports no notice to Party A; dropped by the execution.\\\",\\n  quote=\\\"the revised indication of interest submitted by CSC/Pamplona had the potential of delivering the most value to stockholders\\\", page=\\\"37\\\",\\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\\n\\nR(when=\\\"09/24/2013\\\", who=\\\"Party B\\\", typ=\\\"Financial\\\", event=\\\"Dropped by target\\\", proc=1, rnd=3,\\n  count=1, exit=\\\"Not stated\\\", inferred=\\\"Y\\\", flag=\\\"Q3\\\",\\n  note=\\\"Live rival when Mac-Gray executed exclusivity with CSC/Pamplona; the filing reports no notice to Party B; dropped by the execution.\\\",\\n  quote=\\\"On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013\\\", page=\\\"38\\\",\\n  sort=D(2013,9,24), dfrom=D(2013,9,24), dto=D(2013,9,24))\\n\\nR(when=\\\"09/25/2013\\\", who=\\\"Kirkland & Ellis LLP\\\", typ=None, event=\\\"Adviser\\\", proc=1, rnd=4,\\n  note=\\\"Outside legal counsel to CSC/Pamplona; first seen acting when Goodwin Procter delivered the initial draft merger agreement; represented CSC/Pamplona through signing.\\\",\\n  quote=\\\"Goodwin Procter delivered to Kirkland & Ellis LLP, outside legal counsel to CSC/Pamplona, whom we refer to as Kirkland, the initial draft of the merger agreement\\\", page=\\\"38\\\",\\n  sort=D(2013,9,25), dfrom=D(2013,9,25), dto=D(2013,9,25))\\n\\nR(when=\\\"10/07/2013\\\", who=\\\"Moab Partners, L.P. (Moab)\\\", typ=None, event=\\\"Other material event\\\", proc=1, rnd=4,\\n  note=\\\"No rollover: after Moab was allowed to resume discussions with Pamplona (09/23), it was determined Moab would not roll over any shares in the transaction.\\\",\\n  quote=\\\"Mr. Daoust reported to the Special Committee that, after discussions between Moab and representatives of Pamplona, it was determined that Moab would not rollover any Moab shares in the transaction\\\", page=\\\"39\\\",\\n  sort=D(2013,10,7), dfrom=D(2013,10,7), dto=D(2013,10,7))\\n\\nR(when=\\\"10/12/2013\\\", who=\\\"CSC/Pamplona and Mac-Gray\\\", typ=None, event=\\\"Exclusivity changed\\\", proc=1, rnd=4,\\n  note=\\\"Extended, after CSC/Pamplona requested more time and agreed to an $11 million Mac-Gray termination fee, from 5 p.m. 10/12 to 11:59 p.m. ET 10/15/2013.\\\",\\n  quote=\\\"On October 12, 2013, CSC, Pamplona and Mac-Gray executed a letter agreement extending exclusivity until 11:59 p.m. ET on October 15, 2013\\\", page=\\\"41\\\",\\n  sort=D(2013,10,12), dfrom=D(2013,10,12), dto=D(2013,10,12))\\n\\nfor bank in [\\\"Morgan Stanley & Co. LLC\\\", \\\"Deutsche Bank Securities Inc.\\\", \\\"Evercore Group L.L.C.\\\"]:\\n    R(when=\\\"10/14/2013\\\", who=bank, typ=None, event=\\\"Adviser\\\", proc=1, rnd=4,\\n      note=\\\"Financial adviser to Parent (buyer side); first seen in the executed merger agreement; engagement date and role not disclosed.\\\",\\n      quote=\\\"Except for Morgan Stanley & Co. LLC, Deutsche Bank Securities Inc. and Evercore Group L.L.C., there is no investment banker\\\", page=\\\"A-30\\\",\\n      sort=D(2013,10,14), dfrom=D(2013,10,14), dto=D(2013,10,14))\\n\\nR(when=\\\"10/14/2013\\\", who=\\\"Mac-Gray and CSC/Pamplona\\\", typ=None, event=\\\"Merger agreement signed\\\", proc=1, rnd=\\\"post\\\",\\n  note=\\\"Agreed price $21.25 per share in cash; no financing contingency; Pamplona commitment letter ($594 million) delivered; Moab and MacDonald voting agreements effective.\\\",\\n  quote=\\\"on October 14, 2013, the merger agreement was executed, the Pamplona commitment letter was delivered, Moab and Parent executed the Moab voting agreement and the Mac-Donald voting agreements became effective\\\", page=\\\"41\\\",\\n  sort=D(2013,10,14), dfrom=D(2013,10,14), dto=D(2013,10,14))\\n\\nR(when=\\\"10/15/2013\\\", who=\\\"Mac-Gray and CSC\\\", typ=None, event=\\\"Merger announced\\\", proc=1, rnd=\\\"post\\\",\\n  note=\\\"Joint announcement of the executed merger agreement before the U.S. stock markets opened.\\\",\\n  quote=\\\"On October 15, 2013, before the U.S. stock markets opened, Mac-Gray and CSC jointly announced the execution of the merger agreement\\\", page=\\\"41\\\",\\n  sort=D(2013,10,15), dfrom=D(2013,10,15), dto=D(2013,10,15))\\n\\n# ---------------------------------------------------------------- validate\\nfor i, r in enumerate(rows, start=1):\\n    if r['note'] and wc(r['note']) > 40:\\n        print(f\\\"NOTE TOO LONG row {i}: {wc(r['note'])}\\\")\\n    if wc(r['quote']) > 30:\\n        print(f\\\"QUOTE TOO LONG row {i}: {wc(r['quote'])}\\\")\\n    check_quote(r['quote'])\\n    if r['sort'] < (r['dfrom'] or r['sort']):\\n        print(f\\\"SORT < FROM row {i}\\\")\\n    if r['dto'] and r['sort'] > r['dto']:\\n        print(f\\\"SORT > TO row {i}\\\")\\nprev = None\\nfor i, r in enumerate(rows, start=1):\\n    if prev and r['sort'] < prev:\\n        print(f\\\"SORT DECREASE at row {i}\\\")\\n    prev = r['sort']\\nprint(f\\\"rows={len(rows)}, quotes OK, notes/quotes within limits\\\")\\n\\n# ---------------------------------------------------------------- rounds sheet\\nrounds = [\\n dict(proc=1, rnd=1, opened=D(2013,6,24),\\n      how=\\\"Special Committee advanced 50 parties (15 strategic, 35 financial) and began outreach; informational package asked for preliminary indications by 07/23\\\",\\n      whoin=\\\"20 admitted: 2 strategic (Party A, CSC/Pamplona); 18 financial (incl. Party B, Party C)\\\",\\n      due=\\\"07/23/2013\\\", outcome=\\\"Late bids accepted\\\", final=\\\"Not final\\\",\\n      bids=\\\"4: CSC/Pamplona ($18.50); Party B ($17.00-18.00); Party C ($15.00-17.00); Party A (standing 06/21 proposal $17.00-19.00)\\\",\\n      ended=\\\"Four advanced to management meetings and staged diligence\\\"),\\n dict(proc=1, rnd=2, opened=D(2013,7,25),\\n      how=\\\"Special Committee advanced four bidders to management presentations and staged data-site access; revised indications to follow\\\",\\n      whoin=\\\"4: Party A, Party B, Party C, CSC/Pamplona\\\",\\n      due=\\\"09/09/2013\\\", outcome=\\\"Late bids accepted\\\", final=\\\"Not final\\\",\\n      bids=\\\"4: CSC/Pamplona ($19.50); Party B ($18.50); Party A ($18.00-19.00); Party C ($16.00-17.00)\\\",\\n      ended=\\\"Four advanced to final indications\\\"),\\n dict(proc=1, rnd=3, opened=D(2013,9,11),\\n      how=\\\"Special Committee requested final indications by 09/18 and flagged a possible short exclusivity\\\",\\n      whoin=\\\"4: Party A, Party B, Party C, CSC/Pamplona\\\",\\n      due=\\\"09/18/2013\\\", outcome=\\\"Enforced\\\", final=\\\"Announced as final\\\",\\n      bids=\\\"3: CSC/Pamplona ($20.75); Party B ($21.50 valued; $19.00 cash plus options); Party A ($18.00-19.00, best and final); Party C none\\\",\\n      ended=\\\"CSC/Pamplona selected; Party C out\\\"),\\n dict(proc=1, rnd=4, opened=D(2013,9,19),\\n      how=\\\"Special Committee selected CSC/Pamplona and authorized exclusivity negotiations at $21.25 per share\\\",\\n      whoin=\\\"1: CSC/Pamplona\\\",\\n      due=\\\"none stated\\\", outcome=\\\"No deadline stated\\\", final=\\\"Inferred final\\\",\\n      bids=\\\"1: CSC/Pamplona ($21.25)\\\",\\n      ended=\\\"signing\\\"),\\n]\\n\\n# ---------------------------------------------------------------- questions\\nquestions = [\\n dict(q=\\\"Q1\\\",\\n   question=\\\"Round map: I read four rounds, with round 4 opening 09/19/2013 when the Special Committee selected CSC/Pamplona and moved to definitive negotiation; the 09/21 $21.25 last-and-best bid is round 4 (Inferred final). Alternative: three rounds - C8 says a further price-improvement request to the same finalists after a final solicitation, and exclusivity inside an established final stage, are not a new round - so the $21.25 bid sits in round 3 and no round-4 line exists. Which reading?\\\",\\n   answer=\\\"Keep four rounds: C8 lists moving to definitive negotiation with selected bidders as a new-round trigger, and round 3's competitive solicitation ended when CSC/Pamplona was selected 09/19.\\\",\\n   why=\\\"pp. 36-37: after the 09/18 final bids the committee judged CSC/Pamplona most valuable, required it to raise its price above $20.75 and authorized exclusivity at $21.25; exclusivity executed 09/24 (p. 38).\\\",\\n   rows=\\\"#39, #40; Rounds sheet rounds 3-4\\\",\\n   changes=\\\"The three-round reading deletes #39, moves the $21.25 bid into round 3, and changes round 3's 'How it ended' to signing; live-bidder counts are unaffected.\\\"),\\n dict(q=\\\"Q2\\\",\\n   question=\\\"Deadline outcomes. Round 1 (due 07/23): CSC/Pamplona bid on time, Party B and Party C arrived 07/24 and were reviewed 07/25 - I record 'Late bids accepted'. Round 2 (due 09/09): Party A and Party C submitted 09/10 and were reviewed 09/11 - also 'Late bids accepted'. Round 3 (due 09/18): three responded, Party C none, and the committee acted - 'Enforced'. Alternative: call all three deadlines Enforced?\\\",\\n   answer=\\\"Keep as recorded. C11 makes 'Late bids accepted' the label when the target considered bids arriving after the due date with no revision; round 3 saw no late bid, so 'Enforced'.\\\",\\n   why=\\\"pp. 33-34: 07/24-07/25 bids reviewed at the 07/25 meeting; pp. 35-36: 09/10 bids reviewed 09/11; 09/19 meeting acted on the 09/18 bids (p. 36).\\\",\\n   rows=\\\"#16, #19, #20, #23, #27, #30, #31, #34; Rounds sheet 'Deadline outcome'\\\",\\n   changes=\\\"Under 'Enforced', the Rounds sheet would show deadlines as strict and the late rows as unsolicited; live-bidder counts do not change.\\\"),\\n dict(q=\\\"Q3\\\",\\n   question=\\\"Party A's and Party B's exits: still live after the 09/18 final bids, they were displaced when Mac-Gray executed exclusivity with CSC/Pamplona 09/24; I date both exits 09/24 (inferred, 'Dropped by target'), as C16 directs. Alternative: date them at signing 10/14 as 'Not selected at signing', since the filing never says they were told they were out?\\\",\\n   answer=\\\"Keep 09/24: the exclusive agreement with a rival displaced them on its execution date; no notice is reported, so mark inferred.\\\",\\n   why=\\\"p. 37 (committee selected CSC/Pamplona); p. 38 (exclusivity executed 09/24/2013); the filing reports no notice to Party A or Party B.\\\",\\n   rows=\\\"#42, #43\\\",\\n   changes=\\\"Exits would move to 10/14 with reason 'Not selected at signing', leaving three live bidders from 09/24 to 10/14 instead of one.\\\"),\\n dict(q=\\\"Q4\\\",\\n   question=\\\"The 16 residual financial NDA signers exit as one inferred cohort 'Did not submit' at the 07/23/2013 due date (20 signers less Party A less 3 submitters = 16). Alternative: some of the residual may have signed after 07/23 and so were never solicited, making the count smaller?\\\",\\n   answer=\\\"Keep 16 at 07/23: the filing reports one two-month wave of 20 signings; only Party A's is dated later (08/05) and its standing proposal keeps it accounted for.\\\",\\n   why=\\\"p. 32: 'Over the next two months a total of 20 potential bidders... entered into confidentiality agreements'; p. 34: Party A's NDA 08/05/2013.\\\",\\n   rows=\\\"#18, #21\\\",\\n   changes=\\\"A smaller eligible base reduces the inferred exits and leaves unsolicited signers unaccounted; totals no longer reconcile to the stated 20.\\\"),\\n]\\n\\n# ---------------------------------------------------------------- deal facts\\nfacts = [\\n (\\\"Target\\\", \\\"Mac-Gray Corporation (laundry facilities management contractor; NYSE-listed)\\\"),\\n (\\\"Acquirer\\\", \\\"CSC ServiceWorks, Inc., with Spin Holdco Inc. (Parent), CSC ServiceWorks Holdings, Inc. and CSC Fenway, Inc.; backed by Pamplona Capital Partners III, L.P.\\\"),\\n (\\\"Acquirer type\\\", \\\"Strategic (sponsor-owned operating company: CSC is an operating laundry-services company owned by the private-equity firm Pamplona)\\\"),\\n (\\\"Agreed price and consideration\\\", \\\"$21.25 per share in cash at closing; no financing contingency; Pamplona committed $594 million\\\"),\\n (\\\"Merger agreement signed\\\", D(2013,10,14)),\\n (\\\"Merger announced\\\", D(2013,10,15)),\\n (\\\"Filing type and date\\\", \\\"DEFM14A definitive proxy statement dated 12/04/2013\\\"),\\n (\\\"Background pages\\\", \\\"27-41\\\"),\\n (\\\"Initiation\\\", \\\"Mixed - Mac-Gray/BofA approached Party A on 04/08/2013, but Party A's unsolicited 06/21/2013 proposal and Moab's proxy activism also shaped the launch\\\"),\\n (\\\"Number of processes\\\", 1),\\n (\\\"Auction screen\\\", \\\"Met - 20 independent prospective acquirers executed confidentiality agreements (2 strategic, 18 financial)\\\"),\\n (\\\"Whole-company bids\\\", \\\"Yes - all bids were for the whole company\\\"),\\n (\\\"Currency and units of bid prices\\\", \\\"US dollars per share (Party B's 09/18/2013 bid valued at $21.50 per share included options it valued at $2.50)\\\"),\\n (\\\"Target financial advisers\\\", \\\"BofA Merrill Lynch (primary; engaged 10/23/2012 for the 2011-2012 Discussions, terminated 05/15/2013, re-engaged 05/31/2013)\\\"),\\n (\\\"Target legal advisers\\\", \\\"Goodwin Procter LLP\\\"),\\n (\\\"Account\\\", \\\"Mac-Gray, a laundry facilities management contractor, reviewed strategic alternatives with BofA Merrill Lynch, and on April 8, 2013 BofA approached Party A about a possible combination. After Party A's unsolicited June 21 proposal of $17.00-$19.00 per share, the Special Committee decided on June 24 to explore a sale and BofA approached 50 parties (15 strategic, 35 financial); 20 signed confidentiality agreements. Four bidders emerged - CSC/Pamplona, Party A, Party B and Party C - whose July preliminary indications ranged from $15.00-$17.00 to $18.50. After management presentations and staged diligence, September revised indications were $19.50 (CSC/Pamplona), $18.50 (Party B), $18.00-$19.00 (Party A) and $16.00-$17.00 (Party C). A final round on September 18 brought $20.75 from CSC/Pamplona, a $21.50-valued cash-plus-options package from Party B and a best-and-final $18.00-$19.00 from Party A; Party C did not submit. The Special Committee chose CSC/Pamplona, secured a raise to $21.25, and signed on October 14, announcing October 15.\\\"),\\n]\\n\\n# ---------------------------------------------------------------- workbook\\nwb = Workbook()\\nhdr_font = Font(bold=True)\\nwrap = Alignment(wrap_text=True, vertical=\\\"top\\\")\\n\\ndef style_sheet(ws, headers, ncols, nrows):\\n    ws.freeze_panes = \\\"A2\\\"\\n    ws.auto_filter.ref = f\\\"A1:{get_column_letter(ncols)}{nrows}\\\"\\n    for c in range(1, ncols+1):\\n        cell = ws.cell(row=1, column=c)\\n        cell.font = hdr_font\\n        cell.alignment = wrap\\n    for r in range(2, nrows+1):\\n        for c in range(1, ncols+1):\\n            ws.cell(row=r, column=c).alignment = wrap\\n\\n# --- Deal ledger\\nws = wb.active\\nws.title = \\\"Deal ledger\\\"\\nheaders = [\\\"#\\\",\\\"When\\\",\\\"Who\\\",\\\"Type\\\",\\\"Event\\\",\\\"Process\\\",\\\"Round\\\",\\\"Price low\\\",\\\"Price high\\\",\\\"All cash\\\",\\n           \\\"Formality\\\",\\\"Conditions\\\",\\\"Count\\\",\\\"Exit reason\\\",\\\"Inferred\\\",\\\"Note\\\",\\\"Quote and page\\\",\\\"Flag\\\",\\n           \\\"Reviewer note\\\",\\\"Sort date\\\",\\\"Date from\\\",\\\"Date to\\\"]\\nws.append(headers)\\nfor i, r in enumerate(rows, start=1):\\n    ws.append([i, r['when'], r['who'], r['typ'], r['event'], r['proc'], r['rnd'],\\n               r['plow'], r['phigh'], r['cash'], r['form'], r['cond'], r['count'],\\n               r['exit'], r['inferred'], r['note'],\\n               f\\\"\\\\u201c{r['quote']}\\\\u201d (p. {r['page']})\\\", r['flag'], None,\\n               r['sort'], r['dfrom'], r['dto']])\\nstyle_sheet(ws, headers, len(headers), len(rows)+1)\\nfor rr in range(2, len(rows)+2):\\n    ws.cell(row=rr, column=20).number_format = \\\"MM/DD/YYYY\\\"\\n    ws.cell(row=rr, column=21).number_format = \\\"MM/DD/YYYY\\\"\\n    ws.cell(row=rr, column=22).number_format = \\\"MM/DD/YYYY\\\"\\n    for c in (8, 9):\\n        ws.cell(row=rr, column=c).number_format = \\\"0.00\\\"\\nwidths = [4,17,24,10,16,8,6,9,9,8,10,10,6,14,8,60,60,6,12,11,11,11]\\nfor c, w in enumerate(widths, start=1):\\n    ws.column_dimensions[get_column_letter(c)].width = w\\n\\n# --- Rounds\\nws = wb.create_sheet(\\\"Rounds\\\")\\nheaders = [\\\"Process\\\",\\\"Round\\\",\\\"Opened\\\",\\\"How opened\\\",\\\"Who was in\\\",\\\"Due dates\\\",\\\"Deadline outcome\\\",\\\"Finality\\\",\\\"Bids received\\\",\\\"How it ended\\\"]\\nws.append(headers)\\nfor r in rounds:\\n    ws.append([r['proc'], r['rnd'], r['opened'], r['how'], r['whoin'], r['due'], r['outcome'], r['final'], r['bids'], r['ended']])\\nstyle_sheet(ws, headers, len(headers), len(rounds)+1)\\nfor rr in range(2, len(rounds)+2):\\n    ws.cell(row=rr, column=3).number_format = \\\"MM/DD/YYYY\\\"\\nwidths = [8,6,11,48,40,13,17,15,55,32]\\nfor c, w in enumerate(widths, start=1):\\n    ws.column_dimensions[get_column_letter(c)].width = w\\n\\n# --- Questions\\nws = wb.create_sheet(\\\"Questions\\\")\\nheaders = [\\\"Q\\\",\\\"Question\\\",\\\"Recommended answer\\\",\\\"Why, with page\\\",\\\"Rows affected\\\",\\\"What changes if answered differently\\\",\\\"Reviewer note\\\"]\\nws.append(headers)\\nfor q in questions:\\n    ws.append([q['q'], q['question'], q['answer'], q['why'], q['rows'], q['changes'], None])\\nstyle_sheet(ws, headers, len(headers), len(questions)+1)\\nwidths = [5,60,45,45,26,45,12]\\nfor c, w in enumerate(widths, start=1):\\n    ws.column_dimensions[get_column_letter(c)].width = w\\n\\n# --- Deal facts\\nws = wb.create_sheet(\\\"Deal facts\\\")\\nheaders = [\\\"Field\\\",\\\"Value\\\"]\\nws.append(headers)\\nfor f, v in facts:\\n    ws.append([f, v])\\nstyle_sheet(ws, headers, len(headers), len(facts)+1)\\nfor rr in range(2, len(facts)+2):\\n    if isinstance(ws.cell(row=rr, column=2).value, date):\\n        ws.cell(row=rr, column=2).number_format = \\\"MM/DD/YYYY\\\"\\nwidths = [30,110]\\nfor c, w in enumerate(widths, start=1):\\n    ws.column_dimensions[get_column_letter(c)].width = w\\n\\nimport os\\nos.makedirs(os.path.dirname(OUT), exist_ok=True)\\nwb.save(OUT)\\nprint(\\\"saved\\\", OUT)\\nprint(\\\"sheets:\\\", wb.sheetnames)\\n\"}"},"time":{"start":1789825441234,"end":1789825473542}}}}
