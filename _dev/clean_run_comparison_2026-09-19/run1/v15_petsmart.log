{"type":"tool_use","timestamp":1789825021262,"sessionID":"ses_f462a6b74ffedf3OBDp51fgDmj","part":{"partID":"prt_0b9e1c9c40019iS406DhIeUudc","sessionID":"ses_f462a6b74ffedf3OBDp51fgDmj","messageID":"msg_0b9e14220001W4Qt9a0B0eZfRQ","type":"tool","id":"call_00_BeN3cjR02ORezcHOifH38653","tool":"write","state":{"status":"completed","input":{"content":"# -*- coding: utf-8 -*-\n\"\"\"Build the PetSmart deal ledger workbook.\"\"\"\nimport pickle, re, math, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nD = dt.date\ndata = pickle.load(open('/tmp/opencode/petsmart/data.pkl','rb'))\nR = data['rows']; SRC_ROWS = data['src_rows']\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\n\n# sanity: reload rows to confirm they are dicts with date objects\nassert isinstance(R[0]['wd'], dt.date)\n\nwb = Workbook()\n\nthin = Side(style='thin', color='BFBFBF')\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\nwrap = Alignment(vertical='top', wrap_text=True)\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\nhdr_fill = PatternFill('solid', fgColor='1F4E79')\nblock_fill = PatternFill('solid', fgColor='DDEBF7')\nnote_font = Font(italic=True, size=9, color='404040')\n\n# ============ Sheet 1: Deal ledger ============\nws = wb.active; ws.title = 'Deal ledger'\nheaders = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome','Formality','Conditions level',\n           'Why and evidence','Source','Review','Reviewer note',\n           'Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\n           'Price low','Price high','Price kind','Price origin','Currency','All cash','Cash at closing',\n           'Conditions detail','Due date','Deadline treatment','Round finality','Decided by','Exit reason','Outcome basis',\n           'Page','Related rows','Deal']\nfor c, h in enumerate(headers, 1):\n    cell = ws.cell(row=1, column=c, value=h)\n    cell.font = hdr_font; cell.fill = hdr_fill; cell.alignment = Alignment(vertical='center', wrap_text=True)\n    cell.border = border\n\nsrc_row_index = {pid: i+2 for i, (pid, sec, pg, txt) in enumerate(SRC_ROWS)}  # row on Source text sheet\n\ndef set_cell(r, c, v, fmt=None, wrap_text=True, link=None):\n    cell = ws.cell(row=r, column=c, value=v)\n    cell.alignment = wrap if wrap_text else Alignment(vertical='top')\n    cell.border = border\n    if fmt: cell.number_format = fmt\n    if link:\n        cell.hyperlink = Hyperlink(ref=cell.coordinate, location=link, tooltip='go to source paragraph')\n        cell.font = Font(color='0563C1', underline='single', size=10)\n    return cell\n\nfor i, row in enumerate(R):\n    r = i + 2\n    set_cell(r,1,i+1)\n    set_cell(r,2,row['when'])\n    set_cell(r,3,row['who'])\n    set_cell(r,4,row['what'])\n    set_cell(r,5,1)\n    set_cell(r,6,row['rnd'])\n    set_cell(r,7,row.get('typ','') or None)\n    set_cell(r,8,row['terms'])\n    set_cell(r,9,row.get('formality') or None)\n    set_cell(r,10,row.get('cond') or None)\n    set_cell(r,11,row['why'])\n    src_txt = '; '.join(row['src'])\n    link = f\"'Source text'!A{src_row_index[row['src'][0]]}\"\n    set_cell(r,12,src_txt,link=link)\n    set_cell(r,13,row.get('review') or None)\n    set_cell(r,14,None)\n    set_cell(r,15,f'R{i+1:03d}')\n    set_cell(r,16,'Yes')\n    set_cell(r,17,row.get('count'))\n    set_cell(r,18,row.get('from_'),'MM/DD/YYYY')\n    set_cell(r,19,row.get('to'),'MM/DD/YYYY')\n    set_cell(r,20,row.get('wd'),'MM/DD/YYYY')\n    set_cell(r,21,row.get('basis'))\n    set_cell(r,22,row.get('method'))\n    set_cell(r,23,row.get('p_low'))\n    set_cell(r,24,row.get('p_high'))\n    set_cell(r,25,row.get('p_kind'))\n    set_cell(r,26,row.get('p_origin'))\n    set_cell(r,27,row.get('currency'))\n    set_cell(r,28,row.get('all_cash'))\n    set_cell(r,29,row.get('cash_close'))\n    set_cell(r,30,row.get('cond_detail'))\n    set_cell(r,31,row.get('due'),'MM/DD/YYYY')\n    set_cell(r,32,row.get('treatment'))\n    set_cell(r,33,row.get('finality'))\n    set_cell(r,34,row.get('decided'))\n    set_cell(r,35,row.get('exit_reason'))\n    set_cell(r,36,row.get('outcome_basis'))\n    set_cell(r,37,row.get('page'))\n    set_cell(r,38,row.get('related') or None)\n    set_cell(r,39,'PetSmart')\n\n# widths\nwidths = {'A':5,'B':19,'C':28,'D':19,'E':8,'F':6,'G':11,'H':58,'I':12,'J':12,'K':72,'L':17,'M':10,'N':16,\n          'O':8,'P':8,'Q':7,'R':11,'S':11,'T':12,'U':17,'V':18,'W':9,'X':9,'Y':12,'Z':12,'AA':9,'AB':10,'AC':12,\n          'AD':46,'AE':11,'AF':14,'AG':15,'AH':10,'AI':22,'AJ':17,'AK':6,'AL':24,'AM':10}\nfor k,v in widths.items(): ws.column_dimensions[k].width = v\nws.row_dimensions[1].height = 30\n\n# rough row heights for wrapped columns H,K,AD\ndef est_height(texts, widths_chars):\n    lines = 1\n    for t, w in zip(texts, widths_chars):\n        t = '' if t is None else str(t)\n        n = 0\n        for seg in t.split('\\n'):\n            n += max(1, math.ceil(len(seg)/max(8,w)))\n        lines = max(lines, n)\n    return min(400, 14 + lines*12.5)\nfor i, row in enumerate(R):\n    ws.row_dimensions[i+2].height = est_height([row['terms'], row['why'], row.get('cond_detail')], [56, 70, 44])\n\n# column groups (collapsed)\ndef group_cols(ws, cols):\n    for c in cols:\n        cd = ws.column_dimensions[get_column_letter(c)]\n        cd.outlineLevel = 1\n        cd.hidden = True\ngroup_cols(ws, list(range(15,17)))    # Row id; Include\ngroup_cols(ws, [17])                  # Count\ngroup_cols(ws, list(range(18,23)))    # dates\ngroup_cols(ws, list(range(23,28)))    # prices\ngroup_cols(ws, list(range(28,30)))    # all cash / cash at closing\ngroup_cols(ws, [30])                  # conditions detail\ngroup_cols(ws, list(range(31,34)))    # due date/treatment/finality\ngroup_cols(ws, list(range(34,37)))    # outcomes\ngroup_cols(ws, [37])                  # page\ngroup_cols(ws, [38])                  # related\ngroup_cols(ws, [39])                  # deal\nws.freeze_panes = 'E2'\nws.auto_filter.ref = f'A1:AM{len(R)+1}'\n\n# ============ Sheet: Lists (hidden) ============\nwl = wb.create_sheet('Lists')\nlists = {\n 'A': ['What happened','Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged',\n       'Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline',\n       'Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update',\n       'Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit',\n       'Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced',\n       'Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'],\n 'B': ['Type','Strategic','Financial','Mixed','Unknown'],\n 'C': ['Formality','Formal','Informal','Insufficient evidence','Varies'],\n 'D': ['Conditions level','None','Light','Heavy','Insufficient evidence','Varies'],\n 'E': ['Include','Yes','No'],\n 'F': ['Date basis','Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\n 'G': ['Date method','Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\n 'H': ['Price kind','Point','Bidder range','Group envelope','Bound only','Undisclosed'],\n 'I': ['Price origin','Stated','Carried forward','Inferred'],\n 'J': ['All cash','Yes','No','Not stated'],\n 'K': ['Deadline treatment','Extended','Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\n 'L': ['Round finality','Announced as final','Inferred final','Not final'],\n 'M': ['Decided by','Bidder','Target','Both','Unknown'],\n 'N': ['Exit reason','Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\n       'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\n 'O': ['Outcome basis','Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\n}\nfor col, vals in lists.items():\n    for i, v in enumerate(vals, 1):\n        c = wl.cell(row=i, column=1+list(lists).index(col), value=v)\n        c.alignment = Alignment(vertical='top')\n        if i == 1: c.font = Font(bold=True)\nwl.sheet_state = 'hidden'\n\n# data validations\ndef add_dv(col_letter, list_letter, nvals):\n    dv = DataValidation(type='list', formula1=f'=Lists!${list_letter}$2:${list_letter}${nvals+1}', allow_blank=True)\n    ws.add_data_validation(dv)\n    dv.add(f'{col_letter}2:{col_letter}1000')\nadd_dv('D','A',40); add_dv('G','B',4); add_dv('I','C',4); add_dv('J','D',5); add_dv('P','E',2); add_dv('U','F',6)\nadd_dv('V','G',7); add_dv('Y','H',5); add_dv('Z','I',3); add_dv('AB','J',3); add_dv('AF','K',7); add_dv('AG','L',3)\nadd_dv('AH','M',4); add_dv('AI','N',9); add_dv('AJ','O',5)\n\n# ============ Sheet 2: Summary ============\nwsum = wb.create_sheet('Summary')\nwsum.column_dimensions['A'].width = 34\nwsum.column_dimensions['B'].width = 132\nwsum.column_dimensions['C'].width = 58\n\nsum_rows = []\ndef s(label, text, style='', c=None):\n    sum_rows.append((label, text, style, c))\n\ns('PetSmart, Inc. - deal ledger summary', '', 'title')\ns('Basis', \"AI first pass; not human-approved. Prepared from the single supplied filing (raw_filing/petsmart_2015-02-02_DEFM14A.htm) under 'Reading a merger filing into a deal ledger: extraction instruction' (revision of 19 September 2026, short form). No other source, example or workbook was used; the complete Background of the Merger (printed pp. 21-26) and every other passage used are reproduced on the 'Source text' sheet.\", 'note')\n# 1\ns('1. STATUS AND COMMERCIAL ACCOUNT', '', 'h')\ns('Commercial account', \"PetSmart's board reviewed strategic alternatives during 2014 after a weak 05/21/2014 first-quarter earnings release, stockholder communications and public activism by JANA Partners (9.9% stake) and Longview; the board's 08/13/2014 decision launched a sale process that was announced on 08/19/2014. Fifteen financial buyers signed confidentiality and standstill agreements in the first week of October and six submitted non-binding indications of interest by 10/30; the four bidders at or above $80.00 advanced to the final round on 11/03, and two of them combined as 'Bidder 3' (bidding units 4 to 3). On 12/10 the Buyer Group bid $80.70 and Bidder 2 $80.35, while Bidder 3 gave only a verbal indication below roughly the $78.00 market price and submitted no written offer; the ad hoc committee then required improved bids. On 12/12 the Buyer Group submitted a best-and-final $83.00 in cash - after an initial oral $82.50 - Bidder 2 confirmed $81.50 as its best and final, and Longview was approved to work with the Buyer Group on a share rollover. The board approved the merger on 12/13 and PetSmart signed the all-cash $83.00 merger on 12/14/2014 with Argos Holdings (a BC Partners-led consortium that includes Longview from 12/12), with Longview rolling over 3,012,050 shares (about $250 million) and voting 7,424,591 shares (about 7.5%) for the deal. Observed outcome: signing and announcement only - completion was expected in the first half of 2015 and is not observed in the supplied filing; there was no go-shop and no competing or unsolicited proposal reported through the 02/02/2015 proxy date.\", '')\ns('Initiation assessment', \"Mixed - target-led exploration by the board and the ad hoc committee, following activist pressure (JANA, Longview) and inbound interest (Industry Participant's 08/07/2014 approach and 27 contacts), with the 08/19/2014 public announcement deliberately used to widen the field. Sequence: R001-R012 (round 0), then R013 (round 1 opening).\", '')\n# 2\ns('2. DEAL FACTS', '', 'h')\ns('Target', \"PetSmart, Inc., a Delaware corporation; NASDAQ: PETM; 1,404 stores and 202 in-store dog and cat boarding facilities in the United States, Canada and Puerto Rico (p.16).\", '')\ns('Focal acquirer (winner)', \"Argos Holdings Inc. ('Parent') and Argos Merger Sub Inc., an acquisition vehicle affiliated with funds advised by BC Partners, Inc., to be owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de depot et placement du Quebec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP and (from 12/12/2014) Longview Asset Management, LLC. Type: Financial (sponsor-led consortium; no strategic operating acquirer).\", '')\ns('Agreed consideration', \"$83.00 per share in cash; all cash on the cashed-out shares. Equity value approximately $8.25 billion (labelled calculation in the inputs block below). Total funds required approximately $8.4 billion as disclosed: debt up to about $6.2 billion plus a $750 million asset-based revolver; cash equity up to about $1.83 billion; Longview rollover of $250 million of stock; about $425 million of Company cash on hand (pp.40-41).\", '')\ns('Signing / announcement / completion', \"Merger agreement dated and executed 12/14/2014; announced by press release the same day. Completion expected in the first half of 2015, subject to stockholder adoption and antitrust clearances; no completion is observed in the supplied filing (see 'Regulatory / litigation').\", '')\ns('Filing', \"DEFM14A definitive proxy statement, PetSmart, Inc., dated 02/02/2015; special meeting 03/06/2015; record date 01/29/2015. Source file: raw_filing/petsmart_2015-02-02_DEFM14A.htm. Background pages 21-26; annexes A (merger agreement), B (J.P. Morgan opinion) and C (DGCL s.262) were not extracted.\", '')\ns('Deal protection / termination', \"Company termination fee $255 million (superior-proposal/change-of-recommendation cases); Parent reverse termination fee $510 million (specified financing-failure cases), supported by termination fee commitment letters from Buyer Group members other than Longview; no go-shop; the 15 NDA signers' standstills bar post-signing higher bids. Terms are context only (no ledger rows for deal-protection negotiation).\", '')\ns('Regulatory / litigation', \"One Summary line: HSR filings 12/24/2014 with early termination granted 01/07/2015; Canadian Competition Act request 12/30/2014 with an Advance Ruling Certificate issued 01/14/2015; seven Delaware Court of Chancery class actions filed after the announcement (amended complaints 01/20/2015 and 01/30/2015; the Company says they are without merit).\", '')\n# 3\ns('3. PROCESS AND ROUND MAP - PROCESS 1 (2014 SALE PROCESS)', '', 'h')\ns('Process outcome', \"One continuing sale attempt: launched by the 08/13/2014 board decision, announced 08/19/2014, ended in a signed merger with the Buyer Group on 12/14/2014. No suspension, termination or restart; rounds numbered 1-3 plus round 0 (pre-launch).\", '')\ns('Round 1 (Round opened row R013) - Not final', \"Anchor: the confidentiality-agreement wave (R014); rejected candidate anchors kept as rows: R008 (08/13 decision), R009 (08/19 announcement), R012 (10/03 board update). Scope: 15 financial NDA signers; October diligence, management presentations and Profit Improvement Plan access; non-binding IOIs due 10/30/2014 (R015, R016). Round-bidder tally: 6 submitting units (R017-R020; Bidder 2's revision R022 carries Count 0).\", '')\ns('Round 2 (Round opened row R023) - Inferred final', \"Opened 11/03/2014: four bidders at or above $80.00 advance (Buyer Group R017, Bidder 2 R019/R022, and two unnamed finalists tracked in R020); two submitters eliminated (R024); final-round diligence and merger-agreement circulation; two finalists combine as Bidder 3, units 4 to 3 (R025).\", '')\ns('Round 3 (Round opened row R026) - Announced as final', \"Opened during November with the first request for 'final bids' (initial deadline 12/05). Final bids 12/10: Buyer Group $80.70 and Bidder 2 $80.35 written, Bidder 3 verbal with no written offer (R029-R033). Committee required improved bids (R035); best-and-final 12/12: Buyer Group $83.00, Bidder 2 $81.50 (R037, R038). Board approval 12/13 (R040); signing and announcement 12/14 (R041, R042); rollover resolution (R043); Bidder 2 closing outcome (R044).\", '')\ns('Deadline history and treatment', \"10/30/2014 IOIs (R016) - Enforced: six submissions, J.P. Morgan feedback calls 10/30-11/02, board advanced four on 11/03. 12/05/2014 final bids (on R026) - Extended: superseded 12/04-05 before arrival and moved by R028; no milestone row. 12/10/2014 final bids (R029) - Extended: bids received; committee moved the deadline to 12/12 by R035. 12/12/2014 improved bids (R036) - Enforced: best-and-final offers received; board acted 12/13. No 'Late bids accepted' case; round 2 has no submission deadline; 'No deadline stated' does not apply. Earlier R1 anchors rejected: R008, R009, R012.\", '')\ns('Endings and tallies', \"Winner: Buyer Group (no exit row). Stated outcomes: Bidder 3 Did not submit (R033; 1 unit), Bidder 2 Not selected at signing (R044; 1 unit). Inferred outcomes: 9 Did not submit (R021; residual), 2 Dropped by target (R024; residual); one Count-0 identity row (R034). Round-bidder tallies are scoped to each stage, not unique firms across the deal.\", '')\ns('Post-signing', \"No go-shop; standstills bar the 15 NDA parties from post-signing bids; no unsolicited proposal as of 02/02/2015; vote pending at the 03/06/2015 special meeting; closing not observed. No 'post' round rows exist because no competing proposal, go-shop activity, termination or closing is disclosed.\", '')\n# 4\ns('4. PARTICIPANTS AND ADVISERS', '', 'h')\ns('Buyer Group (winner)', \"Aliases: Parent/Argos; BC Partners consortium, Longview added to the defined group after 12/12/2014. Type Financial. First observed 10/30/2014 IOI at $81.00-$83.00 (R017); final $80.70 (R030); best-and-final $83.00 with Longview support (R037, R039, R043); closes as winner at signing (R041). Funding: member equity commitments up to about $1.83 billion; Longview rollover 3,012,050 shares. Ownership attributes: Delaware acquisition vehicles; consortium includes Quebec, Singapore and other institutional capital.\", '')\ns('Bidder 2', \"Unnamed financial bidder (the filing's alias). Type Financial (inferred: one of the 15 financial NDA signers / six first-round submitters). First observed 10/30/2014 at $78.00 (R019); raised to $81.00-$84.00 (R022); $80.35 final (R031); $81.50 best and final (R038); closed Not selected at signing, stated (R044).\", '')\ns('Bidder 3', \"The filing's alias for two final-round bidders authorized to work together after 11/03/2014 (R025); units 4 to 3. Type Financial (inferred). First observed as a combined unit 12/10/2014: verbal valuation not above about $78.00, no written offer (R032, R033); closed Did not submit (R033). Individual members are not identified by the filing.\", '')\ns('Unnamed financial bidder 1', \"Individually distinguishable by price only. 10/30/2014 IOI at $80.00-$85.00 (R018); advanced 11/03/2014; later path not individually identified - recommended reading: within Bidder 3; Count-0 identity row R034 (see Q5). Type Financial.\", '')\ns('Other first-round cohort', \"The third bidder initially at or above $80.00 is not individually distinguishable (tracked within R020, R023, R025); two submitters below the threshold were eliminated (R024, inferred residual); nine NDA signers did not submit IOIs (R021, inferred residual). These are scoped cohorts, not unique firms; one member of R020 advanced within the unnamed finalists.\", '')\ns('Longview Asset Management, LLC', \"Activist stockholder and rollover supporter (about 9% of shares; 8,214,170 shares per its 12/19/2014 13D/A). R006 (advocacy and rollover willingness); R015 (up to 7.5 million shares notice); R039 (approved to work with the Buyer Group); R043 (rollover agreement for 3,012,050 shares; voting agreement over 7,424,591 shares, X-023). Not a bidder and not a bidder-target NDA (auction screen unaffected).\", '')\ns('JANA Partners LLC', \"Activist stockholder: 9.9% Schedule 13D and public advocacy (R005); held 5,050,107 shares (5.1%) at the record date. No admission to the process is disclosed.\", '')\ns('Industry Participant', \"Unnamed privately held industry participant. PetSmart's own approach in Spring 2014 (R001); inbound approach 08/07/2014 (R007); excluded from the process on 08/22-27/2014, reaffirmed 10/03/2014 (R010, R012). Never entered - no NDA or bid; no outcome row.\", '')\ns('Advisers', \"J.P. Morgan Securities LLC - financial adviser to PetSmart; retained July 2014 (engagement letter effective 08/21/2014); oral fairness opinion 12/13/2014, written 12/14/2014; fee up to about $39 million, substantially contingent (R004). Wachtell, Lipton, Rosen & Katz - legal adviser to PetSmart; observed from 06/18/2014; engagement date not disclosed (R003). Innisfree M&A Incorporated - proxy solicitor for the special meeting (about $182,725 paid as of the record date; about $240,000 expected through March 2015); disclosed at p.20 but not a deal-adviser ledger row. Buyer-side financial or legal advisers are not disclosed; debt commitment from Citigroup, Barclays, Deutsche Bank, Nomura and Jefferies, with RBC, Macquarie and Natixis joinders (X-021).\", '')\n# 5\ns('5. COUNTS AND AUCTION SCREEN', '', 'h')\ns('NDA signers', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"NDA signed\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"Filing: 15 executed confidentiality/standstill agreements with financial buyers (p.23). Auction screen: MET - more than one independent prospective acquiring bidder unit under bidder-target confidentiality agreements; no reused earlier agreements reported. Excluded as not bidder-target contracts: none reported (no lender-only, adviser or rollover-holder NDAs).\"))\ns('Contacts', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Contact\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"Filing: 27 potential participants (3 strategic excluding Industry Participant; 24 financial) (p.23); the Reasons section says 'more than 25' (p.27) - a consistent lower-bound formulation.\"))\ns('Round 1 IOI submitting units', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Bid\",\\'Deal ledger\\'!$F:$F,1,\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"6 units: Buyer Group, Unnamed financial bidder 1, Bidder 2 (initial Count 1 + revision Count 0) and the 3-submitter residual cohort. Filing background: six submitters (p.24); the Reasons section says '5 bidder groups' (p.27) - conflict; the specific background count of six is preferred (Q3).\"))\ns('Round 3 written final bids', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Bid\",\\'Deal ledger\\'!$F:$F,3,\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"2 units (Buyer Group, Bidder 2); Bidder 3 gave a valuation statement and submitted no written offer (R032-R033). The 12/12 best-and-final revisions carry Count 0 because they are later rows for the same bidders.\"))\ns('Exits - Did not submit', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Did not submit\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"9 inferred residual non-submitters at 10/30 (R021) + 1 stated non-submission by Bidder 3 at 12/10 (R033) + Count-0 identity row R034 (not in the sum).\"))\ns('Exits - Dropped by target', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Dropped by target\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"2 eliminated submitters at the 11/03 advancement (R024, inferred residual).\"))\ns('Exits - Not selected at signing', '', 'kv', ('=SUMIFS(\\'Deal ledger\\'!$Q:$Q,\\'Deal ledger\\'!$D:$D,\"Not selected at signing\",\\'Deal ledger\\'!$P:$P,\"Yes\")',\n   \"1: Bidder 2 (R044, stated) - a live finalist when the target chose the Buyer Group.\"))\ns('Per-stage balance (units)', \"Entrants 15 (all unit exits and re-entries shown below; no re-entries). 15 - 9 (Did not submit, inferred) = 6 live; 6 - 2 (Dropped, inferred) = 4; 4 - 1 (Bidder 3 combination, 'units -1') = 3; 3 - 1 (Bidder 3 Did not submit, stated) = 2; 2 - 1 (Bidder 2 Not selected at signing, stated) = 1 - only the winner remains at signing. Inferred share: 11 of 13 unit exits (9 + 2) are inferred residuals, plus one Count-0 identity row (R034); stated exits: Bidder 3 and Bidder 2. Balance is never negative.\", '')\ns('Reconciliation caution', \"Do not sum across steps: contacts, NDA signatures, IOI units, advancement units, final-bid units and exits are different quantities, and Count is a scoped tally contribution. Bases are uncertain in two places: the assumption that all 15 NDA signers were eligible for the 10/30 IOI solicitation, and the 2 eliminees being a residual within the 3-submitter cohort R020 (Q3, Q4).\", '')\n# 6\ns('6. COMPARABILITY AND INPUTS', '', 'h')\ns('Other-scope proposals', \"None disclosed. Every communicated proposal concerned the whole company's equity; no segment, asset or minority-stake bids, and no unresolved scope. PetSmart's Spring 2014 approach to Industry Participant is context, not a bid in this process.\", '')\ns('Consideration and rollover', \"All cash (USD) at $83.00 per share on the cashed-out shares. Exception to cash: Longview's 3,012,050 rollover shares are contributed to Parent for equity instead of cash (about $250 million at $83.00); a majority of Longview's shares still receive $83.00 cash. Rollover is treated as support, not a bidding-group membership change; no CVRs, earnouts or share consideration are disclosed.\", '')\ns('Equity value (labelled calculation)', '', 'kv', ('=99455151*83', \"= 99,455,151 shares outstanding (01/29/2015, p.2) x $83.00 (p.1) = about $8.25 billion. Labelled calculation only; the filing states no total equity value. No net-debt, dilution, preferred conversion or rollover adjustments were assumed.\"))\ns('Market benchmarks', \"Closing price 12/12/2014 (last trading day before announcement) $77.67 (p.76); closing price 01/30/2015 $81.71; a board-cited premium of 38.8% to the 07/02/2014 stock price (p.26); Bidder 3's 12/10/2014 valuation referenced the then-current price of approximately $78.00 (p.25). Benchmarks are reference points, not offers.\", '')\ns('Funding inputs', \"Debt commitment up to $6.95 billion in aggregate ($4.3 billion term loan B, $750 million ABL, $1.9 billion bridge/notes; X-021); cash equity up to about $1.83 billion (X-018); rollover $250 million; about $425 million of Company cash. The merger is not subject to a financing condition.\", '')\ns('Currency and units', \"USD throughout; per-share amounts in dollars; share amounts as stated. No currency conversion performed. Per-share price cells are blank where no per-share bid amount exists (signing rows, valuation statement, outcome rows).\", '')\ns('Glossary', \"NDA = confidentiality agreement. IOI = indication of interest. DD = due diligence (investigation of the target). Rollover = contributing shares into the buyer's equity instead of receiving cash. 'Units -1' = the Bidder 3 combination reduces independent bidding units by one, stated in the Bidding group changed row. Formality and Conditions level are analytical assessments under the instruction, not filing labels. Inferred rows say only that a participant was out by that transition, not how or why.\", '')\ns('Source links', \"The ledger's Source column links to the main paragraph on the 'Source text' sheet (P-001 to P-025 for the complete background; X-001 to X-032 for other passages used). Static links and prose counts may need refreshing after sorting or corrections.\", 'note')\n\nr = 1\nfor label, text, style, extra in sum_rows:\n    a = wsum.cell(row=r, column=1, value=label)\n    a.alignment = wrap; a.border = border\n    if style == 'title':\n        a.font = Font(bold=True, size=13); a.fill = block_fill\n        wsum.row_dimensions[r].height = 22\n    elif style == 'h':\n        a.font = Font(bold=True, size=11); a.fill = block_fill\n        a2 = wsum.cell(row=r, column=2, value=''); a2.fill = block_fill\n        wsum.row_dimensions[r].height = 20\n    elif style == 'note':\n        a.font = note_font\n    if style == 'kv':\n        f, note = extra\n        b = wsum.cell(row=r, column=2, value=f); b.alignment = wrap; b.border = border; b.font = Font(bold=True)\n        c = wsum.cell(row=r, column=3, value=note); c.alignment = wrap; c.border = border\n        wsum.row_dimensions[r].height = est_height([note], [56])\n    elif text:\n        b = wsum.cell(row=r, column=2, value=text); b.alignment = wrap; b.border = border\n        wsum.row_dimensions[r].height = est_height([text], [128])\n    else:\n        b = wsum.cell(row=r, column=2, value=None); b.border = border\n    if style in ('title','h'):\n        pass\n    r += 1\n\n# ============ Sheet 3: Questions ============\nwq = wb.create_sheet('Questions')\nqheaders = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\nfor c, h in enumerate(qheaders, 1):\n    cell = wq.cell(row=1, column=c, value=h); cell.font = hdr_font; cell.fill = hdr_fill\n    cell.alignment = Alignment(vertical='center', wrap_text=True); cell.border = border\nq_widths = {'A':6,'B':26,'C':62,'D':62,'E':30,'F':46,'G':10,'H':18}\nfor k,v in q_widths.items(): wq.column_dimensions[k].width = v\nwq.row_dimensions[1].height = 30\n\nQs = [\n('Q1','Process and round map; R1 anchor and finality values',\n \"Recommended: one process (2014 sale process); R1 anchored on the first-week-of-October confidentiality wave (R014), not the 08/13 decision, 08/19 announcement or 10/03 board update (all retained as rows R008/R009/R012 so the boundary can move). R2 opens with the 11/03 advancement (Inferred final); R3 opens with the November request for 'final bids' (Announced as final); the 12/04-05 and 12/10-12 events are deadline revisions inside R3, not new rounds. Keep R1 'Not final' (preliminary IOI stage).\",\n \"The instruction prefers the first target-organized admission step when no dated first outreach wave exists; the filing reports contacts coming to J.P. Morgan ('J.P. Morgan was contacted by 27 potential participants', P-008) and dates the CA wave (P-010). The first final-offer request opens a round even with the same bidders (P-015; initial 12/05 date in P-016); the later improvement request is a deadline revision, not a round (P-021). Alternatives: anchor R1 at the 08/13 decision or 08/19 announcement; open R3 at the 12/10 deadline instead of the November request; merge R2 into R3.\",\n \"R013, R014, R015, R023, R025, R026, R028, R035; Summary process/round map\",\n \"Moving the R1 anchor changes the round-1 scope (e.g., an 08/13 anchor would pull pre-NDA contacts into R1). A separate final-solicitation round raised at 12/10 instead of November would shift the deadline history between rounds; merging R2/R3 would drop the advancement/Documentation transition, and the round-bidder tallies (6 IOI units; 4 advancing; 2 written finals) would need restating.\",\n 'Pending',''),\n('Q2','Deadline history and treatments',\n \"Recommended: 10/30/2014 IOI date - Enforced (R016; board advanced on 11/03 without revision). 12/05/2014 final-bid date - Extended; superseded on 12/04-05 before arrival, so it gets no milestone row and is recorded on the Deadline revised row R028. 12/10/2014 - Extended (R029; moved to 12/12 by R035). 12/12/2014 - Enforced (R036; best-and-final bids received and the board acted on 12/13). No deadline was 'Late bids accepted': Bidder 3's verbal valuation was received on the 12/10 date itself, and it then submitted nothing rather than a late bid.\",\n \"Dates and sequence in P-011, P-012, P-013, P-016, P-020, P-021, P-023, P-024. The instruction treats a post-deadline request for improved bids by a new date as a Deadline revised (extension), and a date superseded before arrival needs no milestone row. The 12/05 date was set but never reached; its replacement was decided 12/04-05.\",\n \"R016, R021, R028, R029, R035, R036; Summary deadline map\",\n \"If the 12/05 date were treated as reached (not superseded), it would need its own Deadline row/Enforced value; if the 12/10 improvement request were treated as a fresh Deadline set or new round, the R3 boundary and tallies change.\",\n 'Pending',''),\n('Q3','Count and population bases (conflicts and residuals)',\n \"Recommended readings: (a) six IOI submitters (background, p.24) over '5 bidder groups' (Reasons, p.27) - the background is specific and contemporaneous, and the six include the two below-$80 submitters; (b) all 15 NDA signers were eligible for the 10/30 solicitation (they had been told the due date), so the residual is 9 non-submitters (R021); (c) the two eliminees are the two residual submitters within R020 whose indications were below $80.00 - a count-based residual, not named identities; (d) 27 contacts (p.23) with the 'more than 25' wording (p.27) treated as a consistent lower bound; (e) Bidder 2, Bidder 3 and Unnamed financial bidder 1 are typed Financial by inference from the all-financial 15-signer cohort - the filing never states their type individually.\",\n \"Counts at P-008, P-010, P-012, P-013, P-014; conflict passages P-012 vs X-008; type basis P-010 ('15 potentially interested financial buyers'). The instruction requires residual cohorts to be disjoint from individually recorded members and counts to be scoped, with bases surfaced where uncertain.\",\n \"R011, R014, R017-R020, R022, R023, R024; Summary counts block\",\n \"If some signers were not eligible for the IOI solicitation, the 9-non-submitter residual shrinks; if '5 groups' were preferred, the round-1 tally falls by one (the six otherwise reconcile to 4 advancing + 2 eliminated). Any change to the R020/R024 split changes the inferred-elimination count.\",\n 'Pending',''),\n('Q4','Every inferred closing row (grouped by transition)',\n \"Recommended: (a) 10/30/2014 - 9 unnamed NDA signers Did not submit, Inferred: residual (15 NDA signers - 6 submitters), Count 9, Decided by Unknown, reason Not stated (R021); (b) 11/03/2014 - 2 unnamed submitters Dropped by target, Inferred: residual (6 submitters - 4 advancing), Count 2, Decided by Target, reason Lower offer than rivals (R024); (c) by 12/10/2014 - Unnamed financial bidder 1, Count-0 identity row (recommended reading: closed inside Bidder 3; R034). Stated comparators: Bidder 3 Did not submit (R033) and Bidder 2 Not selected at signing (R044). No identities, motives or permanent withdrawals are inferred.\",\n \"Instruction's closing rules: residual non-submissions by subtraction; eliminations by residual at the advancement; a named-but-silent party gets a Count-0 identity row naming the covering cohort; stated outcomes take no opener. Arithmetic and passages: P-010, P-012, P-013; covering rows R020, R025, R033.\",\n \"R021, R024, R034 (plus stated R033, R044); Summary balance\",\n \"Changing a base (e.g., fewer eligible signers) changes the residual counts and the inferred share of the per-stage balance; re-labelling the two eliminees as a different cohort changes the count of stated outcomes but not the total exits.\",\n 'Pending',''),\n('Q5','Anonymous identities and mappings (combining bidders; types)',\n \"Recommended: the two bidders that combined as Bidder 3 were two of the four finalists - necessarily the $80.00-$85.00 submitter (R018) and the third, otherwise unnamed, submitter initially at or above $80.00 - because the four advancing units are the Buyer Group, Bidder 2 and those two, and both combining members were invited to the final round. The ledger keeps the combination anonymous (R025), treats Unnamed financial bidder 1's exit as a Count-0 identity row (R034, recommended reading: inside Bidder 3), and does not move counts to a name. Types: Financial for both finalists and for Bidder 2/Bidder 3 by the cohort inference (Q3).\",\n \"Advancement arithmetic P-013 (four bidders at or above $80.00 = three initially at or above $80.00 per P-012 plus Bidder 2 after its raise) and the three December bidding units (P-020); combination facts P-014. The filing never identifies the members, so identity stays a hypothesis. Alternative: one combiner was not an invitee - rejected because the fourth finalist would then be unaccounted for among the December bidders.\",\n \"R018, R020, R023, R024, R025, R033, R034; Summary participants\",\n \"If a reviewer accepts a different mapping, R034's recommended reading changes but no count or balance changes (Count 0); if a combiner was not a finalist, the R2/R3 unit counts and R024's residual basis would need restating.\",\n 'Pending',''),\n('Q6','Formality and Conditions levels (borderline assessments)',\n \"Recommended: IOI rows (R017-R022, R020 cohort) Informal with Conditions 'Insufficient evidence' - preliminary non-binding indications after October diligence access, no formal signal and no stated financing/diligence condition; not Heavy by context because each bidder had substantive data-room and management access before indicating. Final-bid rows (R030, R031) and best-and-final rows (R037, R038) Formal (bidder-returned acquisition agreement/transaction documents; price confirmation for Bidder 2) with Light conditions (committed financing documented or confirmed; remaining matters were final documentation, as the 12/13 board approval was subject to resolving open points). Bidder 3's 12/10 communication is a Valuation statement, not a bid: per-share cells are blank and the value stays in text (R032). No LOIs, no 'None' levels, no late-reconfirmation rows, and the winner does have Formal rows.\",\n \"Signals in P-020, P-022, P-023; conditions facts in P-016, P-017, P-024; the instruction's formality signals and conditions tests (diligence-access context for preliminary indications; 'None' requires affirmative readiness). The 12/12 'substantially executable' formulation supports Light rather than None.\",\n \"R017-R022, R030-R038\",\n \"Reclassifying IOIs as Formal or Heavy would change the conditionality record but not counts; treating the valuation statement as a bid would create a bound price observation and a second bid row for Bidder 3; classifying the finals as 'None' would overstate readiness given the open points resolved only at signing.\",\n 'Pending',''),\n('Q7','Working dates and display order conventions',\n \"Recommended: NDA wave Working date 10/04/2014 (midpoint of 10/01-10/07) with the interval preserved; 27-contact Working date 09/22/2014 (midpoint of mid-August-end October); R3 and the projection-update rows 11/15/2014 (November midpoints); Bidder 3 formation 11/03/2014 (Assigned: bound - after the 11/03 meeting, day not disclosed); inferred closings use the deadline/decision day (10/30, 11/03, 12/10). Same-day blocks (10/30 deadline vs submissions; 12/10 bids, valuation, non-submission and revision; 12/14 signing, announcement, rollover resolution and Bidder 2's outcome) use a deterministic display order; the relative order within them is not established by the filing and the shared dates are a display convention. A reviewer may adopt the alternative first-day reading for the NDA wave (10/01) and the 10/30/2014 bound for the contact row.\",\n \"Instruction's date rules; intervals and relative expressions in P-008, P-010, P-014, P-015, P-021, P-022, P-023, P-025. Bounds are tightened where a later passage shows the event (e.g., the 11/03 board had the IOI set before it, so all submissions sit at 10/30).\",\n \"R011, R013, R014, R021, R022, R025, R026, R027, R034; Date fields\",\n \"Moving the NDA wave to 10/01 would place it before the 10/03 board update and might suggest NDAs preceded that update; moving R3's Working date later narrows the gap to the 12/04-05 revision but changes no facts. Any reassignment must keep Working dates non-decreasing and inside each row's own bounds.\",\n 'Pending',''),\n('Q8','Comparability, consideration and other-scope coverage',\n \"Recommended: no other-scope bids (nothing to exclude from core counts); single currency USD; the only non-cash element is Longview's rollover of 3,012,050 shares into Parent equity, treated as support rather than a bidding-group membership change or a partial-company offer; equity value is a labelled calculation (99,455,151 x $83.00 = about $8.25 billion), not a filing-stated total; market references ($77.67 close on 12/12/2014; 38.8% premium to 07/02/2014; about $78.00 reference on 12/10) are benchmarks, not offers; funding inputs (debt up to $6.95 billion, equity up to about $1.83 billion, rollover $250 million, ~$425 million cash) are as disclosed.\",\n \"P-001, P-011, P-022, X-007 (premium), X-008, X-017, X-019, X-020, X-026, X-029; instruction rules on per-share cells, rollover support and labelled conversions.\",\n \"R018, R032, R034, R037, R039, R043, R044; Summary deal facts and inputs\",\n \"Re-normalizing the rollover or adding net debt would be a new labelled calculation, not an observed price; treating the rollover as a membership change would alter the R039/R043 treatment and the unit-count narrative; treating the equity value as filing-stated would misstate its provenance.\",\n 'Pending',''),\n]\nr = 2\nfor q in Qs:\n    for c, v in enumerate(q, 1):\n        cell = wq.cell(row=r, column=c, value=v)\n        cell.alignment = wrap; cell.border = border\n        if c == 1: cell.font = Font(bold=True)\n    wq.row_dimensions[r].height = est_height([q[2], q[3], q[5]], [60,60,44])\n    r += 1\nwq.freeze_panes = 'A2'\n\n# ============ Sheet 4: Source text ============\nwt = wb.create_sheet('Source text')\nfor c, h in enumerate(['Paragraph','Section','Page','Text'], 1):\n    cell = wt.cell(row=1, column=c, value=h); cell.font = hdr_font; cell.fill = hdr_fill\n    cell.alignment = Alignment(vertical='center', wrap_text=True); cell.border = border\nwt.column_dimensions['A'].width = 11\nwt.column_dimensions['B'].width = 46\nwt.column_dimensions['C'].width = 6\nwt.column_dimensions['D'].width = 160\nwt.row_dimensions[1].height = 20\nfor i, (pid, sec, pg, txt) in enumerate(SRC_ROWS):\n    r = i + 2\n    for c, v in enumerate([pid, sec, pg, txt], 1):\n        cell = wt.cell(row=r, column=c, value=v)\n        cell.alignment = wrap; cell.border = border\n    wt.row_dimensions[r].height = est_height([txt], [158])\nwt.freeze_panes = 'A2'\nwt.auto_filter.ref = f'A1:D{len(SRC_ROWS)+1}'\n\n# ============ save ============\nimport os\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\nwb.save(OUT)\nprint('saved', OUT)\n","path":"/tmp/opencode/petsmart/build_xlsx.py"},"output":"Created file successfully: /tmp/opencode/petsmart/build_xlsx.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/petsmart/build_xlsx.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build the PetSmart deal ledger workbook.\\\"\\\"\\\"\\nimport pickle, re, math, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nD = dt.date\\ndata = pickle.load(open('/tmp/opencode/petsmart/data.pkl','rb'))\\nR = data['rows']; SRC_ROWS = data['src_rows']\\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\\n\\n# sanity: reload rows to confirm they are dicts with date objects\\nassert isinstance(R[0]['wd'], dt.date)\\n\\nwb = Workbook()\\n\\nthin = Side(style='thin', color='BFBFBF')\\nborder = Border(left=thin, right=thin, top=thin, bottom=thin)\\nwrap = Alignment(vertical='top', wrap_text=True)\\nhdr_font = Font(bold=True, color='FFFFFF', size=10)\\nhdr_fill = PatternFill('solid', fgColor='1F4E79')\\nblock_fill = PatternFill('solid', fgColor='DDEBF7')\\nnote_font = Font(italic=True, size=9, color='404040')\\n\\n# ============ Sheet 1: Deal ledger ============\\nws = wb.active; ws.title = 'Deal ledger'\\nheaders = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome','Formality','Conditions level',\\n           'Why and evidence','Source','Review','Reviewer note',\\n           'Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\\n           'Price low','Price high','Price kind','Price origin','Currency','All cash','Cash at closing',\\n           'Conditions detail','Due date','Deadline treatment','Round finality','Decided by','Exit reason','Outcome basis',\\n           'Page','Related rows','Deal']\\nfor c, h in enumerate(headers, 1):\\n    cell = ws.cell(row=1, column=c, value=h)\\n    cell.font = hdr_font; cell.fill = hdr_fill; cell.alignment = Alignment(vertical='center', wrap_text=True)\\n    cell.border = border\\n\\nsrc_row_index = {pid: i+2 for i, (pid, sec, pg, txt) in enumerate(SRC_ROWS)}  # row on Source text sheet\\n\\ndef set_cell(r, c, v, fmt=None, wrap_text=True, link=None):\\n    cell = ws.cell(row=r, column=c, value=v)\\n    cell.alignment = wrap if wrap_text else Alignment(vertical='top')\\n    cell.border = border\\n    if fmt: cell.number_format = fmt\\n    if link:\\n        cell.hyperlink = Hyperlink(ref=cell.coordinate, location=link, tooltip='go to source paragraph')\\n        cell.font = Font(color='0563C1', underline='single', size=10)\\n    return cell\\n\\nfor i, row in enumerate(R):\\n    r = i + 2\\n    set_cell(r,1,i+1)\\n    set_cell(r,2,row['when'])\\n    set_cell(r,3,row['who'])\\n    set_cell(r,4,row['what'])\\n    set_cell(r,5,1)\\n    set_cell(r,6,row['rnd'])\\n    set_cell(r,7,row.get('typ','') or None)\\n    set_cell(r,8,row['terms'])\\n    set_cell(r,9,row.get('formality') or None)\\n    set_cell(r,10,row.get('cond') or None)\\n    set_cell(r,11,row['why'])\\n    src_txt = '; '.join(row['src'])\\n    link = f\\\"'Source text'!A{src_row_index[row['src'][0]]}\\\"\\n    set_cell(r,12,src_txt,link=link)\\n    set_cell(r,13,row.get('review') or None)\\n    set_cell(r,14,None)\\n    set_cell(r,15,f'R{i+1:03d}')\\n    set_cell(r,16,'Yes')\\n    set_cell(r,17,row.get('count'))\\n    set_cell(r,18,row.get('from_'),'MM/DD/YYYY')\\n    set_cell(r,19,row.get('to'),'MM/DD/YYYY')\\n    set_cell(r,20,row.get('wd'),'MM/DD/YYYY')\\n    set_cell(r,21,row.get('basis'))\\n    set_cell(r,22,row.get('method'))\\n    set_cell(r,23,row.get('p_low'))\\n    set_cell(r,24,row.get('p_high'))\\n    set_cell(r,25,row.get('p_kind'))\\n    set_cell(r,26,row.get('p_origin'))\\n    set_cell(r,27,row.get('currency'))\\n    set_cell(r,28,row.get('all_cash'))\\n    set_cell(r,29,row.get('cash_close'))\\n    set_cell(r,30,row.get('cond_detail'))\\n    set_cell(r,31,row.get('due'),'MM/DD/YYYY')\\n    set_cell(r,32,row.get('treatment'))\\n    set_cell(r,33,row.get('finality'))\\n    set_cell(r,34,row.get('decided'))\\n    set_cell(r,35,row.get('exit_reason'))\\n    set_cell(r,36,row.get('outcome_basis'))\\n    set_cell(r,37,row.get('page'))\\n    set_cell(r,38,row.get('related') or None)\\n    set_cell(r,39,'PetSmart')\\n\\n# widths\\nwidths = {'A':5,'B':19,'C':28,'D':19,'E':8,'F':6,'G':11,'H':58,'I':12,'J':12,'K':72,'L':17,'M':10,'N':16,\\n          'O':8,'P':8,'Q':7,'R':11,'S':11,'T':12,'U':17,'V':18,'W':9,'X':9,'Y':12,'Z':12,'AA':9,'AB':10,'AC':12,\\n          'AD':46,'AE':11,'AF':14,'AG':15,'AH':10,'AI':22,'AJ':17,'AK':6,'AL':24,'AM':10}\\nfor k,v in widths.items(): ws.column_dimensions[k].width = v\\nws.row_dimensions[1].height = 30\\n\\n# rough row heights for wrapped columns H,K,AD\\ndef est_height(texts, widths_chars):\\n    lines = 1\\n    for t, w in zip(texts, widths_chars):\\n        t = '' if t is None else str(t)\\n        n = 0\\n        for seg in t.split('\\\\n'):\\n            n += max(1, math.ceil(len(seg)/max(8,w)))\\n        lines = max(lines, n)\\n    return min(400, 14 + lines*12.5)\\nfor i, row in enumerate(R):\\n    ws.row_dimensions[i+2].height = est_height([row['terms'], row['why'], row.get('cond_detail')], [56, 70, 44])\\n\\n# column groups (collapsed)\\ndef group_cols(ws, cols):\\n    for c in cols:\\n        cd = ws.column_dimensions[get_column_letter(c)]\\n        cd.outlineLevel = 1\\n        cd.hidden = True\\ngroup_cols(ws, list(range(15,17)))    # Row id; Include\\ngroup_cols(ws, [17])                  # Count\\ngroup_cols(ws, list(range(18,23)))    # dates\\ngroup_cols(ws, list(range(23,28)))    # prices\\ngroup_cols(ws, list(range(28,30)))    # all cash / cash at closing\\ngroup_cols(ws, [30])                  # conditions detail\\ngroup_cols(ws, list(range(31,34)))    # due date/treatment/finality\\ngroup_cols(ws, list(range(34,37)))    # outcomes\\ngroup_cols(ws, [37])                  # page\\ngroup_cols(ws, [38])                  # related\\ngroup_cols(ws, [39])                  # deal\\nws.freeze_panes = 'E2'\\nws.auto_filter.ref = f'A1:AM{len(R)+1}'\\n\\n# ============ Sheet: Lists (hidden) ============\\nwl = wb.create_sheet('Lists')\\nlists = {\\n 'A': ['What happened','Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged',\\n       'Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline',\\n       'Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update',\\n       'Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit',\\n       'Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced',\\n       'Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed'],\\n 'B': ['Type','Strategic','Financial','Mixed','Unknown'],\\n 'C': ['Formality','Formal','Informal','Insufficient evidence','Varies'],\\n 'D': ['Conditions level','None','Light','Heavy','Insufficient evidence','Varies'],\\n 'E': ['Include','Yes','No'],\\n 'F': ['Date basis','Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated'],\\n 'G': ['Date method','Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence'],\\n 'H': ['Price kind','Point','Bidder range','Group envelope','Bound only','Undisclosed'],\\n 'I': ['Price origin','Stated','Carried forward','Inferred'],\\n 'J': ['All cash','Yes','No','Not stated'],\\n 'K': ['Deadline treatment','Extended','Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated','Extended; Late bids accepted'],\\n 'L': ['Round finality','Announced as final','Inferred final','Not final'],\\n 'M': ['Decided by','Bidder','Target','Both','Unknown'],\\n 'N': ['Exit reason','Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer',\\n       'Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated'],\\n 'O': ['Outcome basis','Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity'],\\n}\\nfor col, vals in lists.items():\\n    for i, v in enumerate(vals, 1):\\n        c = wl.cell(row=i, column=1+list(lists).index(col), value=v)\\n        c.alignment = Alignment(vertical='top')\\n        if i == 1: c.font = Font(bold=True)\\nwl.sheet_state = 'hidden'\\n\\n# data validations\\ndef add_dv(col_letter, list_letter, nvals):\\n    dv = DataValidation(type='list', formula1=f'=Lists!${list_letter}$2:${list_letter}${nvals+1}', allow_blank=True)\\n    ws.add_data_validation(dv)\\n    dv.add(f'{col_letter}2:{col_letter}1000')\\nadd_dv('D','A',40); add_dv('G','B',4); add_dv('I','C',4); add_dv('J','D',5); add_dv('P','E',2); add_dv('U','F',6)\\nadd_dv('V','G',7); add_dv('Y','H',5); add_dv('Z','I',3); add_dv('AB','J',3); add_dv('AF','K',7); add_dv('AG','L',3)\\nadd_dv('AH','M',4); add_dv('AI','N',9); add_dv('AJ','O',5)\\n\\n# ============ Sheet 2: Summary ============\\nwsum = wb.create_sheet('Summary')\\nwsum.column_dimensions['A'].width = 34\\nwsum.column_dimensions['B'].width = 132\\nwsum.column_dimensions['C'].width = 58\\n\\nsum_rows = []\\ndef s(label, text, style='', c=None):\\n    sum_rows.append((label, text, style, c))\\n\\ns('PetSmart, Inc. - deal ledger summary', '', 'title')\\ns('Basis', \\\"AI first pass; not human-approved. Prepared from the single supplied filing (raw_filing/petsmart_2015-02-02_DEFM14A.htm) under 'Reading a merger filing into a deal ledger: extraction instruction' (revision of 19 September 2026, short form). No other source, example or workbook was used; the complete Background of the Merger (printed pp. 21-26) and every other passage used are reproduced on the 'Source text' sheet.\\\", 'note')\\n# 1\\ns('1. STATUS AND COMMERCIAL ACCOUNT', '', 'h')\\ns('Commercial account', \\\"PetSmart's board reviewed strategic alternatives during 2014 after a weak 05/21/2014 first-quarter earnings release, stockholder communications and public activism by JANA Partners (9.9% stake) and Longview; the board's 08/13/2014 decision launched a sale process that was announced on 08/19/2014. Fifteen financial buyers signed confidentiality and standstill agreements in the first week of October and six submitted non-binding indications of interest by 10/30; the four bidders at or above $80.00 advanced to the final round on 11/03, and two of them combined as 'Bidder 3' (bidding units 4 to 3). On 12/10 the Buyer Group bid $80.70 and Bidder 2 $80.35, while Bidder 3 gave only a verbal indication below roughly the $78.00 market price and submitted no written offer; the ad hoc committee then required improved bids. On 12/12 the Buyer Group submitted a best-and-final $83.00 in cash - after an initial oral $82.50 - Bidder 2 confirmed $81.50 as its best and final, and Longview was approved to work with the Buyer Group on a share rollover. The board approved the merger on 12/13 and PetSmart signed the all-cash $83.00 merger on 12/14/2014 with Argos Holdings (a BC Partners-led consortium that includes Longview from 12/12), with Longview rolling over 3,012,050 shares (about $250 million) and voting 7,424,591 shares (about 7.5%) for the deal. Observed outcome: signing and announcement only - completion was expected in the first half of 2015 and is not observed in the supplied filing; there was no go-shop and no competing or unsolicited proposal reported through the 02/02/2015 proxy date.\\\", '')\\ns('Initiation assessment', \\\"Mixed - target-led exploration by the board and the ad hoc committee, following activist pressure (JANA, Longview) and inbound interest (Industry Participant's 08/07/2014 approach and 27 contacts), with the 08/19/2014 public announcement deliberately used to widen the field. Sequence: R001-R012 (round 0), then R013 (round 1 opening).\\\", '')\\n# 2\\ns('2. DEAL FACTS', '', 'h')\\ns('Target', \\\"PetSmart, Inc., a Delaware corporation; NASDAQ: PETM; 1,404 stores and 202 in-store dog and cat boarding facilities in the United States, Canada and Puerto Rico (p.16).\\\", '')\\ns('Focal acquirer (winner)', \\\"Argos Holdings Inc. ('Parent') and Argos Merger Sub Inc., an acquisition vehicle affiliated with funds advised by BC Partners, Inc., to be owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de depot et placement du Quebec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP and (from 12/12/2014) Longview Asset Management, LLC. Type: Financial (sponsor-led consortium; no strategic operating acquirer).\\\", '')\\ns('Agreed consideration', \\\"$83.00 per share in cash; all cash on the cashed-out shares. Equity value approximately $8.25 billion (labelled calculation in the inputs block below). Total funds required approximately $8.4 billion as disclosed: debt up to about $6.2 billion plus a $750 million asset-based revolver; cash equity up to about $1.83 billion; Longview rollover of $250 million of stock; about $425 million of Company cash on hand (pp.40-41).\\\", '')\\ns('Signing / announcement / completion', \\\"Merger agreement dated and executed 12/14/2014; announced by press release the same day. Completion expected in the first half of 2015, subject to stockholder adoption and antitrust clearances; no completion is observed in the supplied filing (see 'Regulatory / litigation').\\\", '')\\ns('Filing', \\\"DEFM14A definitive proxy statement, PetSmart, Inc., dated 02/02/2015; special meeting 03/06/2015; record date 01/29/2015. Source file: raw_filing/petsmart_2015-02-02_DEFM14A.htm. Background pages 21-26; annexes A (merger agreement), B (J.P. Morgan opinion) and C (DGCL s.262) were not extracted.\\\", '')\\ns('Deal protection / termination', \\\"Company termination fee $255 million (superior-proposal/change-of-recommendation cases); Parent reverse termination fee $510 million (specified financing-failure cases), supported by termination fee commitment letters from Buyer Group members other than Longview; no go-shop; the 15 NDA signers' standstills bar post-signing higher bids. Terms are context only (no ledger rows for deal-protection negotiation).\\\", '')\\ns('Regulatory / litigation', \\\"One Summary line: HSR filings 12/24/2014 with early termination granted 01/07/2015; Canadian Competition Act request 12/30/2014 with an Advance Ruling Certificate issued 01/14/2015; seven Delaware Court of Chancery class actions filed after the announcement (amended complaints 01/20/2015 and 01/30/2015; the Company says they are without merit).\\\", '')\\n# 3\\ns('3. PROCESS AND ROUND MAP - PROCESS 1 (2014 SALE PROCESS)', '', 'h')\\ns('Process outcome', \\\"One continuing sale attempt: launched by the 08/13/2014 board decision, announced 08/19/2014, ended in a signed merger with the Buyer Group on 12/14/2014. No suspension, termination or restart; rounds numbered 1-3 plus round 0 (pre-launch).\\\", '')\\ns('Round 1 (Round opened row R013) - Not final', \\\"Anchor: the confidentiality-agreement wave (R014); rejected candidate anchors kept as rows: R008 (08/13 decision), R009 (08/19 announcement), R012 (10/03 board update). Scope: 15 financial NDA signers; October diligence, management presentations and Profit Improvement Plan access; non-binding IOIs due 10/30/2014 (R015, R016). Round-bidder tally: 6 submitting units (R017-R020; Bidder 2's revision R022 carries Count 0).\\\", '')\\ns('Round 2 (Round opened row R023) - Inferred final', \\\"Opened 11/03/2014: four bidders at or above $80.00 advance (Buyer Group R017, Bidder 2 R019/R022, and two unnamed finalists tracked in R020); two submitters eliminated (R024); final-round diligence and merger-agreement circulation; two finalists combine as Bidder 3, units 4 to 3 (R025).\\\", '')\\ns('Round 3 (Round opened row R026) - Announced as final', \\\"Opened during November with the first request for 'final bids' (initial deadline 12/05). Final bids 12/10: Buyer Group $80.70 and Bidder 2 $80.35 written, Bidder 3 verbal with no written offer (R029-R033). Committee required improved bids (R035); best-and-final 12/12: Buyer Group $83.00, Bidder 2 $81.50 (R037, R038). Board approval 12/13 (R040); signing and announcement 12/14 (R041, R042); rollover resolution (R043); Bidder 2 closing outcome (R044).\\\", '')\\ns('Deadline history and treatment', \\\"10/30/2014 IOIs (R016) - Enforced: six submissions, J.P. Morgan feedback calls 10/30-11/02, board advanced four on 11/03. 12/05/2014 final bids (on R026) - Extended: superseded 12/04-05 before arrival and moved by R028; no milestone row. 12/10/2014 final bids (R029) - Extended: bids received; committee moved the deadline to 12/12 by R035. 12/12/2014 improved bids (R036) - Enforced: best-and-final offers received; board acted 12/13. No 'Late bids accepted' case; round 2 has no submission deadline; 'No deadline stated' does not apply. Earlier R1 anchors rejected: R008, R009, R012.\\\", '')\\ns('Endings and tallies', \\\"Winner: Buyer Group (no exit row). Stated outcomes: Bidder 3 Did not submit (R033; 1 unit), Bidder 2 Not selected at signing (R044; 1 unit). Inferred outcomes: 9 Did not submit (R021; residual), 2 Dropped by target (R024; residual); one Count-0 identity row (R034). Round-bidder tallies are scoped to each stage, not unique firms across the deal.\\\", '')\\ns('Post-signing', \\\"No go-shop; standstills bar the 15 NDA parties from post-signing bids; no unsolicited proposal as of 02/02/2015; vote pending at the 03/06/2015 special meeting; closing not observed. No 'post' round rows exist because no competing proposal, go-shop activity, termination or closing is disclosed.\\\", '')\\n# 4\\ns('4. PARTICIPANTS AND ADVISERS', '', 'h')\\ns('Buyer Group (winner)', \\\"Aliases: Parent/Argos; BC Partners consortium, Longview added to the defined group after 12/12/2014. Type Financial. First observed 10/30/2014 IOI at $81.00-$83.00 (R017); final $80.70 (R030); best-and-final $83.00 with Longview support (R037, R039, R043); closes as winner at signing (R041). Funding: member equity commitments up to about $1.83 billion; Longview rollover 3,012,050 shares. Ownership attributes: Delaware acquisition vehicles; consortium includes Quebec, Singapore and other institutional capital.\\\", '')\\ns('Bidder 2', \\\"Unnamed financial bidder (the filing's alias). Type Financial (inferred: one of the 15 financial NDA signers / six first-round submitters). First observed 10/30/2014 at $78.00 (R019); raised to $81.00-$84.00 (R022); $80.35 final (R031); $81.50 best and final (R038); closed Not selected at signing, stated (R044).\\\", '')\\ns('Bidder 3', \\\"The filing's alias for two final-round bidders authorized to work together after 11/03/2014 (R025); units 4 to 3. Type Financial (inferred). First observed as a combined unit 12/10/2014: verbal valuation not above about $78.00, no written offer (R032, R033); closed Did not submit (R033). Individual members are not identified by the filing.\\\", '')\\ns('Unnamed financial bidder 1', \\\"Individually distinguishable by price only. 10/30/2014 IOI at $80.00-$85.00 (R018); advanced 11/03/2014; later path not individually identified - recommended reading: within Bidder 3; Count-0 identity row R034 (see Q5). Type Financial.\\\", '')\\ns('Other first-round cohort', \\\"The third bidder initially at or above $80.00 is not individually distinguishable (tracked within R020, R023, R025); two submitters below the threshold were eliminated (R024, inferred residual); nine NDA signers did not submit IOIs (R021, inferred residual). These are scoped cohorts, not unique firms; one member of R020 advanced within the unnamed finalists.\\\", '')\\ns('Longview Asset Management, LLC', \\\"Activist stockholder and rollover supporter (about 9% of shares; 8,214,170 shares per its 12/19/2014 13D/A). R006 (advocacy and rollover willingness); R015 (up to 7.5 million shares notice); R039 (approved to work with the Buyer Group); R043 (rollover agreement for 3,012,050 shares; voting agreement over 7,424,591 shares, X-023). Not a bidder and not a bidder-target NDA (auction screen unaffected).\\\", '')\\ns('JANA Partners LLC', \\\"Activist stockholder: 9.9% Schedule 13D and public advocacy (R005); held 5,050,107 shares (5.1%) at the record date. No admission to the process is disclosed.\\\", '')\\ns('Industry Participant', \\\"Unnamed privately held industry participant. PetSmart's own approach in Spring 2014 (R001); inbound approach 08/07/2014 (R007); excluded from the process on 08/22-27/2014, reaffirmed 10/03/2014 (R010, R012). Never entered - no NDA or bid; no outcome row.\\\", '')\\ns('Advisers', \\\"J.P. Morgan Securities LLC - financial adviser to PetSmart; retained July 2014 (engagement letter effective 08/21/2014); oral fairness opinion 12/13/2014, written 12/14/2014; fee up to about $39 million, substantially contingent (R004). Wachtell, Lipton, Rosen & Katz - legal adviser to PetSmart; observed from 06/18/2014; engagement date not disclosed (R003). Innisfree M&A Incorporated - proxy solicitor for the special meeting (about $182,725 paid as of the record date; about $240,000 expected through March 2015); disclosed at p.20 but not a deal-adviser ledger row. Buyer-side financial or legal advisers are not disclosed; debt commitment from Citigroup, Barclays, Deutsche Bank, Nomura and Jefferies, with RBC, Macquarie and Natixis joinders (X-021).\\\", '')\\n# 5\\ns('5. COUNTS AND AUCTION SCREEN', '', 'h')\\ns('NDA signers', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"NDA signed\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"Filing: 15 executed confidentiality/standstill agreements with financial buyers (p.23). Auction screen: MET - more than one independent prospective acquiring bidder unit under bidder-target confidentiality agreements; no reused earlier agreements reported. Excluded as not bidder-target contracts: none reported (no lender-only, adviser or rollover-holder NDAs).\\\"))\\ns('Contacts', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Contact\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"Filing: 27 potential participants (3 strategic excluding Industry Participant; 24 financial) (p.23); the Reasons section says 'more than 25' (p.27) - a consistent lower-bound formulation.\\\"))\\ns('Round 1 IOI submitting units', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F:$F,1,\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"6 units: Buyer Group, Unnamed financial bidder 1, Bidder 2 (initial Count 1 + revision Count 0) and the 3-submitter residual cohort. Filing background: six submitters (p.24); the Reasons section says '5 bidder groups' (p.27) - conflict; the specific background count of six is preferred (Q3).\\\"))\\ns('Round 3 written final bids', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F:$F,3,\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"2 units (Buyer Group, Bidder 2); Bidder 3 gave a valuation statement and submitted no written offer (R032-R033). The 12/12 best-and-final revisions carry Count 0 because they are later rows for the same bidders.\\\"))\\ns('Exits - Did not submit', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"9 inferred residual non-submitters at 10/30 (R021) + 1 stated non-submission by Bidder 3 at 12/10 (R033) + Count-0 identity row R034 (not in the sum).\\\"))\\ns('Exits - Dropped by target', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Dropped by target\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"2 eliminated submitters at the 11/03 advancement (R024, inferred residual).\\\"))\\ns('Exits - Not selected at signing', '', 'kv', ('=SUMIFS(\\\\'Deal ledger\\\\'!$Q:$Q,\\\\'Deal ledger\\\\'!$D:$D,\\\"Not selected at signing\\\",\\\\'Deal ledger\\\\'!$P:$P,\\\"Yes\\\")',\\n   \\\"1: Bidder 2 (R044, stated) - a live finalist when the target chose the Buyer Group.\\\"))\\ns('Per-stage balance (units)', \\\"Entrants 15 (all unit exits and re-entries shown below; no re-entries). 15 - 9 (Did not submit, inferred) = 6 live; 6 - 2 (Dropped, inferred) = 4; 4 - 1 (Bidder 3 combination, 'units -1') = 3; 3 - 1 (Bidder 3 Did not submit, stated) = 2; 2 - 1 (Bidder 2 Not selected at signing, stated) = 1 - only the winner remains at signing. Inferred share: 11 of 13 unit exits (9 + 2) are inferred residuals, plus one Count-0 identity row (R034); stated exits: Bidder 3 and Bidder 2. Balance is never negative.\\\", '')\\ns('Reconciliation caution', \\\"Do not sum across steps: contacts, NDA signatures, IOI units, advancement units, final-bid units and exits are different quantities, and Count is a scoped tally contribution. Bases are uncertain in two places: the assumption that all 15 NDA signers were eligible for the 10/30 IOI solicitation, and the 2 eliminees being a residual within the 3-submitter cohort R020 (Q3, Q4).\\\", '')\\n# 6\\ns('6. COMPARABILITY AND INPUTS', '', 'h')\\ns('Other-scope proposals', \\\"None disclosed. Every communicated proposal concerned the whole company's equity; no segment, asset or minority-stake bids, and no unresolved scope. PetSmart's Spring 2014 approach to Industry Participant is context, not a bid in this process.\\\", '')\\ns('Consideration and rollover', \\\"All cash (USD) at $83.00 per share on the cashed-out shares. Exception to cash: Longview's 3,012,050 rollover shares are contributed to Parent for equity instead of cash (about $250 million at $83.00); a majority of Longview's shares still receive $83.00 cash. Rollover is treated as support, not a bidding-group membership change; no CVRs, earnouts or share consideration are disclosed.\\\", '')\\ns('Equity value (labelled calculation)', '', 'kv', ('=99455151*83', \\\"= 99,455,151 shares outstanding (01/29/2015, p.2) x $83.00 (p.1) = about $8.25 billion. Labelled calculation only; the filing states no total equity value. No net-debt, dilution, preferred conversion or rollover adjustments were assumed.\\\"))\\ns('Market benchmarks', \\\"Closing price 12/12/2014 (last trading day before announcement) $77.67 (p.76); closing price 01/30/2015 $81.71; a board-cited premium of 38.8% to the 07/02/2014 stock price (p.26); Bidder 3's 12/10/2014 valuation referenced the then-current price of approximately $78.00 (p.25). Benchmarks are reference points, not offers.\\\", '')\\ns('Funding inputs', \\\"Debt commitment up to $6.95 billion in aggregate ($4.3 billion term loan B, $750 million ABL, $1.9 billion bridge/notes; X-021); cash equity up to about $1.83 billion (X-018); rollover $250 million; about $425 million of Company cash. The merger is not subject to a financing condition.\\\", '')\\ns('Currency and units', \\\"USD throughout; per-share amounts in dollars; share amounts as stated. No currency conversion performed. Per-share price cells are blank where no per-share bid amount exists (signing rows, valuation statement, outcome rows).\\\", '')\\ns('Glossary', \\\"NDA = confidentiality agreement. IOI = indication of interest. DD = due diligence (investigation of the target). Rollover = contributing shares into the buyer's equity instead of receiving cash. 'Units -1' = the Bidder 3 combination reduces independent bidding units by one, stated in the Bidding group changed row. Formality and Conditions level are analytical assessments under the instruction, not filing labels. Inferred rows say only that a participant was out by that transition, not how or why.\\\", '')\\ns('Source links', \\\"The ledger's Source column links to the main paragraph on the 'Source text' sheet (P-001 to P-025 for the complete background; X-001 to X-032 for other passages used). Static links and prose counts may need refreshing after sorting or corrections.\\\", 'note')\\n\\nr = 1\\nfor label, text, style, extra in sum_rows:\\n    a = wsum.cell(row=r, column=1, value=label)\\n    a.alignment = wrap; a.border = border\\n    if style == 'title':\\n        a.font = Font(bold=True, size=13); a.fill = block_fill\\n        wsum.row_dimensions[r].height = 22\\n    elif style == 'h':\\n        a.font = Font(bold=True, size=11); a.fill = block_fill\\n        a2 = wsum.cell(row=r, column=2, value=''); a2.fill = block_fill\\n        wsum.row_dimensions[r].height = 20\\n    elif style == 'note':\\n        a.font = note_font\\n    if style == 'kv':\\n        f, note = extra\\n        b = wsum.cell(row=r, column=2, value=f); b.alignment = wrap; b.border = border; b.font = Font(bold=True)\\n        c = wsum.cell(row=r, column=3, value=note); c.alignment = wrap; c.border = border\\n        wsum.row_dimensions[r].height = est_height([note], [56])\\n    elif text:\\n        b = wsum.cell(row=r, column=2, value=text); b.alignment = wrap; b.border = border\\n        wsum.row_dimensions[r].height = est_height([text], [128])\\n    else:\\n        b = wsum.cell(row=r, column=2, value=None); b.border = border\\n    if style in ('title','h'):\\n        pass\\n    r += 1\\n\\n# ============ Sheet 3: Questions ============\\nwq = wb.create_sheet('Questions')\\nqheaders = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\\nfor c, h in enumerate(qheaders, 1):\\n    cell = wq.cell(row=1, column=c, value=h); cell.font = hdr_font; cell.fill = hdr_fill\\n    cell.alignment = Alignment(vertical='center', wrap_text=True); cell.border = border\\nq_widths = {'A':6,'B':26,'C':62,'D':62,'E':30,'F':46,'G':10,'H':18}\\nfor k,v in q_widths.items(): wq.column_dimensions[k].width = v\\nwq.row_dimensions[1].height = 30\\n\\nQs = [\\n('Q1','Process and round map; R1 anchor and finality values',\\n \\\"Recommended: one process (2014 sale process); R1 anchored on the first-week-of-October confidentiality wave (R014), not the 08/13 decision, 08/19 announcement or 10/03 board update (all retained as rows R008/R009/R012 so the boundary can move). R2 opens with the 11/03 advancement (Inferred final); R3 opens with the November request for 'final bids' (Announced as final); the 12/04-05 and 12/10-12 events are deadline revisions inside R3, not new rounds. Keep R1 'Not final' (preliminary IOI stage).\\\",\\n \\\"The instruction prefers the first target-organized admission step when no dated first outreach wave exists; the filing reports contacts coming to J.P. Morgan ('J.P. Morgan was contacted by 27 potential participants', P-008) and dates the CA wave (P-010). The first final-offer request opens a round even with the same bidders (P-015; initial 12/05 date in P-016); the later improvement request is a deadline revision, not a round (P-021). Alternatives: anchor R1 at the 08/13 decision or 08/19 announcement; open R3 at the 12/10 deadline instead of the November request; merge R2 into R3.\\\",\\n \\\"R013, R014, R015, R023, R025, R026, R028, R035; Summary process/round map\\\",\\n \\\"Moving the R1 anchor changes the round-1 scope (e.g., an 08/13 anchor would pull pre-NDA contacts into R1). A separate final-solicitation round raised at 12/10 instead of November would shift the deadline history between rounds; merging R2/R3 would drop the advancement/Documentation transition, and the round-bidder tallies (6 IOI units; 4 advancing; 2 written finals) would need restating.\\\",\\n 'Pending',''),\\n('Q2','Deadline history and treatments',\\n \\\"Recommended: 10/30/2014 IOI date - Enforced (R016; board advanced on 11/03 without revision). 12/05/2014 final-bid date - Extended; superseded on 12/04-05 before arrival, so it gets no milestone row and is recorded on the Deadline revised row R028. 12/10/2014 - Extended (R029; moved to 12/12 by R035). 12/12/2014 - Enforced (R036; best-and-final bids received and the board acted on 12/13). No deadline was 'Late bids accepted': Bidder 3's verbal valuation was received on the 12/10 date itself, and it then submitted nothing rather than a late bid.\\\",\\n \\\"Dates and sequence in P-011, P-012, P-013, P-016, P-020, P-021, P-023, P-024. The instruction treats a post-deadline request for improved bids by a new date as a Deadline revised (extension), and a date superseded before arrival needs no milestone row. The 12/05 date was set but never reached; its replacement was decided 12/04-05.\\\",\\n \\\"R016, R021, R028, R029, R035, R036; Summary deadline map\\\",\\n \\\"If the 12/05 date were treated as reached (not superseded), it would need its own Deadline row/Enforced value; if the 12/10 improvement request were treated as a fresh Deadline set or new round, the R3 boundary and tallies change.\\\",\\n 'Pending',''),\\n('Q3','Count and population bases (conflicts and residuals)',\\n \\\"Recommended readings: (a) six IOI submitters (background, p.24) over '5 bidder groups' (Reasons, p.27) - the background is specific and contemporaneous, and the six include the two below-$80 submitters; (b) all 15 NDA signers were eligible for the 10/30 solicitation (they had been told the due date), so the residual is 9 non-submitters (R021); (c) the two eliminees are the two residual submitters within R020 whose indications were below $80.00 - a count-based residual, not named identities; (d) 27 contacts (p.23) with the 'more than 25' wording (p.27) treated as a consistent lower bound; (e) Bidder 2, Bidder 3 and Unnamed financial bidder 1 are typed Financial by inference from the all-financial 15-signer cohort - the filing never states their type individually.\\\",\\n \\\"Counts at P-008, P-010, P-012, P-013, P-014; conflict passages P-012 vs X-008; type basis P-010 ('15 potentially interested financial buyers'). The instruction requires residual cohorts to be disjoint from individually recorded members and counts to be scoped, with bases surfaced where uncertain.\\\",\\n \\\"R011, R014, R017-R020, R022, R023, R024; Summary counts block\\\",\\n \\\"If some signers were not eligible for the IOI solicitation, the 9-non-submitter residual shrinks; if '5 groups' were preferred, the round-1 tally falls by one (the six otherwise reconcile to 4 advancing + 2 eliminated). Any change to the R020/R024 split changes the inferred-elimination count.\\\",\\n 'Pending',''),\\n('Q4','Every inferred closing row (grouped by transition)',\\n \\\"Recommended: (a) 10/30/2014 - 9 unnamed NDA signers Did not submit, Inferred: residual (15 NDA signers - 6 submitters), Count 9, Decided by Unknown, reason Not stated (R021); (b) 11/03/2014 - 2 unnamed submitters Dropped by target, Inferred: residual (6 submitters - 4 advancing), Count 2, Decided by Target, reason Lower offer than rivals (R024); (c) by 12/10/2014 - Unnamed financial bidder 1, Count-0 identity row (recommended reading: closed inside Bidder 3; R034). Stated comparators: Bidder 3 Did not submit (R033) and Bidder 2 Not selected at signing (R044). No identities, motives or permanent withdrawals are inferred.\\\",\\n \\\"Instruction's closing rules: residual non-submissions by subtraction; eliminations by residual at the advancement; a named-but-silent party gets a Count-0 identity row naming the covering cohort; stated outcomes take no opener. Arithmetic and passages: P-010, P-012, P-013; covering rows R020, R025, R033.\\\",\\n \\\"R021, R024, R034 (plus stated R033, R044); Summary balance\\\",\\n \\\"Changing a base (e.g., fewer eligible signers) changes the residual counts and the inferred share of the per-stage balance; re-labelling the two eliminees as a different cohort changes the count of stated outcomes but not the total exits.\\\",\\n 'Pending',''),\\n('Q5','Anonymous identities and mappings (combining bidders; types)',\\n \\\"Recommended: the two bidders that combined as Bidder 3 were two of the four finalists - necessarily the $80.00-$85.00 submitter (R018) and the third, otherwise unnamed, submitter initially at or above $80.00 - because the four advancing units are the Buyer Group, Bidder 2 and those two, and both combining members were invited to the final round. The ledger keeps the combination anonymous (R025), treats Unnamed financial bidder 1's exit as a Count-0 identity row (R034, recommended reading: inside Bidder 3), and does not move counts to a name. Types: Financial for both finalists and for Bidder 2/Bidder 3 by the cohort inference (Q3).\\\",\\n \\\"Advancement arithmetic P-013 (four bidders at or above $80.00 = three initially at or above $80.00 per P-012 plus Bidder 2 after its raise) and the three December bidding units (P-020); combination facts P-014. The filing never identifies the members, so identity stays a hypothesis. Alternative: one combiner was not an invitee - rejected because the fourth finalist would then be unaccounted for among the December bidders.\\\",\\n \\\"R018, R020, R023, R024, R025, R033, R034; Summary participants\\\",\\n \\\"If a reviewer accepts a different mapping, R034's recommended reading changes but no count or balance changes (Count 0); if a combiner was not a finalist, the R2/R3 unit counts and R024's residual basis would need restating.\\\",\\n 'Pending',''),\\n('Q6','Formality and Conditions levels (borderline assessments)',\\n \\\"Recommended: IOI rows (R017-R022, R020 cohort) Informal with Conditions 'Insufficient evidence' - preliminary non-binding indications after October diligence access, no formal signal and no stated financing/diligence condition; not Heavy by context because each bidder had substantive data-room and management access before indicating. Final-bid rows (R030, R031) and best-and-final rows (R037, R038) Formal (bidder-returned acquisition agreement/transaction documents; price confirmation for Bidder 2) with Light conditions (committed financing documented or confirmed; remaining matters were final documentation, as the 12/13 board approval was subject to resolving open points). Bidder 3's 12/10 communication is a Valuation statement, not a bid: per-share cells are blank and the value stays in text (R032). No LOIs, no 'None' levels, no late-reconfirmation rows, and the winner does have Formal rows.\\\",\\n \\\"Signals in P-020, P-022, P-023; conditions facts in P-016, P-017, P-024; the instruction's formality signals and conditions tests (diligence-access context for preliminary indications; 'None' requires affirmative readiness). The 12/12 'substantially executable' formulation supports Light rather than None.\\\",\\n \\\"R017-R022, R030-R038\\\",\\n \\\"Reclassifying IOIs as Formal or Heavy would change the conditionality record but not counts; treating the valuation statement as a bid would create a bound price observation and a second bid row for Bidder 3; classifying the finals as 'None' would overstate readiness given the open points resolved only at signing.\\\",\\n 'Pending',''),\\n('Q7','Working dates and display order conventions',\\n \\\"Recommended: NDA wave Working date 10/04/2014 (midpoint of 10/01-10/07) with the interval preserved; 27-contact Working date 09/22/2014 (midpoint of mid-August-end October); R3 and the projection-update rows 11/15/2014 (November midpoints); Bidder 3 formation 11/03/2014 (Assigned: bound - after the 11/03 meeting, day not disclosed); inferred closings use the deadline/decision day (10/30, 11/03, 12/10). Same-day blocks (10/30 deadline vs submissions; 12/10 bids, valuation, non-submission and revision; 12/14 signing, announcement, rollover resolution and Bidder 2's outcome) use a deterministic display order; the relative order within them is not established by the filing and the shared dates are a display convention. A reviewer may adopt the alternative first-day reading for the NDA wave (10/01) and the 10/30/2014 bound for the contact row.\\\",\\n \\\"Instruction's date rules; intervals and relative expressions in P-008, P-010, P-014, P-015, P-021, P-022, P-023, P-025. Bounds are tightened where a later passage shows the event (e.g., the 11/03 board had the IOI set before it, so all submissions sit at 10/30).\\\",\\n \\\"R011, R013, R014, R021, R022, R025, R026, R027, R034; Date fields\\\",\\n \\\"Moving the NDA wave to 10/01 would place it before the 10/03 board update and might suggest NDAs preceded that update; moving R3's Working date later narrows the gap to the 12/04-05 revision but changes no facts. Any reassignment must keep Working dates non-decreasing and inside each row's own bounds.\\\",\\n 'Pending',''),\\n('Q8','Comparability, consideration and other-scope coverage',\\n \\\"Recommended: no other-scope bids (nothing to exclude from core counts); single currency USD; the only non-cash element is Longview's rollover of 3,012,050 shares into Parent equity, treated as support rather than a bidding-group membership change or a partial-company offer; equity value is a labelled calculation (99,455,151 x $83.00 = about $8.25 billion), not a filing-stated total; market references ($77.67 close on 12/12/2014; 38.8% premium to 07/02/2014; about $78.00 reference on 12/10) are benchmarks, not offers; funding inputs (debt up to $6.95 billion, equity up to about $1.83 billion, rollover $250 million, ~$425 million cash) are as disclosed.\\\",\\n \\\"P-001, P-011, P-022, X-007 (premium), X-008, X-017, X-019, X-020, X-026, X-029; instruction rules on per-share cells, rollover support and labelled conversions.\\\",\\n \\\"R018, R032, R034, R037, R039, R043, R044; Summary deal facts and inputs\\\",\\n \\\"Re-normalizing the rollover or adding net debt would be a new labelled calculation, not an observed price; treating the rollover as a membership change would alter the R039/R043 treatment and the unit-count narrative; treating the equity value as filing-stated would misstate its provenance.\\\",\\n 'Pending',''),\\n]\\nr = 2\\nfor q in Qs:\\n    for c, v in enumerate(q, 1):\\n        cell = wq.cell(row=r, column=c, value=v)\\n        cell.alignment = wrap; cell.border = border\\n        if c == 1: cell.font = Font(bold=True)\\n    wq.row_dimensions[r].height = est_height([q[2], q[3], q[5]], [60,60,44])\\n    r += 1\\nwq.freeze_panes = 'A2'\\n\\n# ============ Sheet 4: Source text ============\\nwt = wb.create_sheet('Source text')\\nfor c, h in enumerate(['Paragraph','Section','Page','Text'], 1):\\n    cell = wt.cell(row=1, column=c, value=h); cell.font = hdr_font; cell.fill = hdr_fill\\n    cell.alignment = Alignment(vertical='center', wrap_text=True); cell.border = border\\nwt.column_dimensions['A'].width = 11\\nwt.column_dimensions['B'].width = 46\\nwt.column_dimensions['C'].width = 6\\nwt.column_dimensions['D'].width = 160\\nwt.row_dimensions[1].height = 20\\nfor i, (pid, sec, pg, txt) in enumerate(SRC_ROWS):\\n    r = i + 2\\n    for c, v in enumerate([pid, sec, pg, txt], 1):\\n        cell = wt.cell(row=r, column=c, value=v)\\n        cell.alignment = wrap; cell.border = border\\n    wt.row_dimensions[r].height = est_height([txt], [158])\\nwt.freeze_panes = 'A2'\\nwt.auto_filter.ref = f'A1:D{len(SRC_ROWS)+1}'\\n\\n# ============ save ============\\nimport os\\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\\nwb.save(OUT)\\nprint('saved', OUT)\\n\", \"path\": \"/tmp/opencode/petsmart/build_xlsx.py\"}"},"time":{"start":1789824977348,"end":1789825021262}}}}
