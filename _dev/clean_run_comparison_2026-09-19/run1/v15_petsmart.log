{"type":"tool_use","timestamp":1789824904178,"sessionID":"ses_f462a6b74ffedf3OBDp51fgDmj","part":{"partID":"prt_0b9df9c920011eiqOLFUAqpyil","sessionID":"ses_f462a6b74ffedf3OBDp51fgDmj","messageID":"msg_0b9dee8910014bam0FhNSxb9DN","type":"tool","id":"call_00_VG7eE8Q6JmXDBCwbZxXk4848","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/petsmart/build_ledger.py","content":"# -*- coding: utf-8 -*-\n\"\"\"Build petsmart.xlsx deal ledger from the supplied DEFM14A per the extraction instruction.\"\"\"\nimport re, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.worksheet.hyperlink import Hyperlink\n\nSRC = '/tmp/opencode/petsmart/filing_text.txt'\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\n\nlines = open(SRC, encoding='utf-8').read().split('\\n')\ndef L(n):  # 1-based line\n    return lines[n-1].strip()\n\n# ---------------- Source text rows ----------------\n# P paragraphs: background, printed pp. 21-26\nP = []\nP.append(('P-001', 'The Merger (Proposal 1) - Background of the Merger', 21, L(725)))\nP.append(('P-002', 'The Merger (Proposal 1) - Background of the Merger', 21, L(726)))\nP.append(('P-003', 'The Merger (Proposal 1) - Background of the Merger', 21, L(727) + ' ' + L(732)))\nP.append(('P-004', 'The Merger (Proposal 1) - Background of the Merger', 22, L(733)))\nP.append(('P-005', 'The Merger (Proposal 1) - Background of the Merger', 22, L(734)))\nP.append(('P-006', 'The Merger (Proposal 1) - Background of the Merger', 22, L(735) + ' ' + L(740)))\nP.append(('P-007', 'The Merger (Proposal 1) - Background of the Merger', 23, L(741)))\nP.append(('P-008', 'The Merger (Proposal 1) - Background of the Merger', 23, L(742)))\nP.append(('P-009', 'The Merger (Proposal 1) - Background of the Merger', 23, L(743)))\nP.append(('P-010', 'The Merger (Proposal 1) - Background of the Merger', 23, L(744)))\nP.append(('P-011', 'The Merger (Proposal 1) - Background of the Merger', 23, L(745) + ' ' + L(750)))\nP.append(('P-012', 'The Merger (Proposal 1) - Background of the Merger', 24, L(751)))\nP.append(('P-013', 'The Merger (Proposal 1) - Background of the Merger', 24, L(752)))\nP.append(('P-014', 'The Merger (Proposal 1) - Background of the Merger', 24, L(753)))\nP.append(('P-015', 'The Merger (Proposal 1) - Background of the Merger', 24, L(754)))\nP.append(('P-016', 'The Merger (Proposal 1) - Background of the Merger', 24, L(755) + ' ' + L(760)))\nP.append(('P-017', 'The Merger (Proposal 1) - Background of the Merger', 25, L(761)))\nP.append(('P-018', 'The Merger (Proposal 1) - Background of the Merger', 25, L(762)))\nP.append(('P-019', 'The Merger (Proposal 1) - Background of the Merger', 25, L(763)))\nP.append(('P-020', 'The Merger (Proposal 1) - Background of the Merger', 25, L(764)))\nP.append(('P-021', 'The Merger (Proposal 1) - Background of the Merger', 25, L(765)))\nP.append(('P-022', 'The Merger (Proposal 1) - Background of the Merger', 25, L(766) + ' ' + L(771)))\nP.append(('P-023', 'The Merger (Proposal 1) - Background of the Merger', 26, L(772)))\nP.append(('P-024', 'The Merger (Proposal 1) - Background of the Merger', 26, L(773)))\nP.append(('P-025', 'The Merger (Proposal 1) - Background of the Merger', 26, L(774)))\n\nX = []\nX.append(('X-001', 'Summary (glossary)', 1, L(145)))\nX.append(('X-002', 'Summary - Voting Support Agreement', 2, L(194) + ' ' + L(199)))\nX.append(('X-003', 'Summary - Financing', 5, L(271) + ' ' + L(273) + ' ' + L(276) + ' ' + L(279)))\nX.append(('X-004', 'Summary - Termination Fee Commitment Letters', 5, L(283)))\nX.append(('X-005', 'The Parties to the Merger Agreement - PetSmart, Inc.', 16, L(638)))\nX.append(('X-006', 'The Parties to the Merger Agreement - Argos Holdings Inc. and Argos Merger Sub Inc.', 16, L(640)))\nX.append(('X-007', 'The Merger - Reasons for the Merger - Attractive Value', 26, L(778)))\nX.append(('X-008', 'The Merger - Reasons for the Merger - Best Alternative / Sale Process', 27, L(785)))\nX.append(('X-009', 'The Merger - Reasons for the Merger - Alternative Proposals (standstills)', 28, L(823)))\nX.append(('X-010', 'The Merger - Reasons for the Merger - Alternative Proposals (no offers by 02/02/2015)', 28, L(829)))\nX.append(('X-011', 'The Merger - Reasons for the Merger - Other Factors (Longview)', 29, L(848)))\nX.append(('X-012', 'The Merger - Opinion of J.P. Morgan (engagement)', 30, L(892)))\nX.append(('X-013', 'The Merger - Opinion of J.P. Morgan (opinion dates)', 30, L(893)))\nX.append(('X-014', 'The Merger - Opinion of J.P. Morgan (fee and relationships)', 37, L(1068)))\nX.append(('X-015', 'The Merger - Projected Financial Information (scope)', 37, L(1072)))\nX.append(('X-016', 'The Merger - Projected Financial Information (FY2014 update note)', 38, L(1085)))\nX.append(('X-017', 'The Merger - Financing (total funds required)', 40, L(1126) + ' ' + L(1128) + ' ' + L(1131) + ' ' + L(1134)))\nX.append(('X-018', 'The Merger - Financing - Equity Financing (commitment letters)', 40, L(1137)))\nX.append(('X-019', 'The Merger - Financing - Equity Financing (rollover agreement)', 41, L(1153)))\nX.append(('X-020', 'The Merger - Financing - Equity Financing (Longview other shares)', 41, L(1165)))\nX.append(('X-021', 'The Merger - Financing - Debt Financing (lenders)', 41, L(1167)))\nX.append(('X-022', 'The Merger - Termination Fee Commitment Letters', 44, L(1240)))\nX.append(('X-023', 'The Merger - Voting Support Agreement', 45, L(1258)))\nX.append(('X-024', 'Regulatory Approvals', 52, L(1394) + ' ' + L(1397)))\nX.append(('X-025', 'Litigation', 52, L(1399) + ' ' + L(1400)))\nX.append(('X-026', \"Market Price of the Company's Common Stock\", 76, L(2084)))\nX.append(('X-027', 'Security Ownership of Certain Beneficial Owners and Management', 77, L(2103) + ' ' + L(2106)))\nX.append(('X-028', 'The Special Meeting - Solicitation of Proxies (Innisfree)', 20, L(712)))\nX.append(('X-029', 'Summary - Record Date and Quorum', 2, L(188)))\nX.append(('X-030', 'Letter to Stockholders (proxy statement date)', None, L(89)))\nX.append(('X-031', 'Letter to Stockholders (transaction and consortium)', None, L(73)))\nX.append(('X-032', 'Summary - Termination (Company termination fee)', 7, L(326)))\n\nSRC_ROWS = P + X\nsrc_text = {pid: txt for pid, sec, pg, txt in SRC_ROWS}\ndef norm(s):\n    s = s.replace('\\u200b', '').replace('\\u200c', '').replace('\\u200d', '').replace('\\ufeff', '')\n    s = re.sub(r'\\s+', ' ', s)\n    return s\nSRC_NORM = {pid: norm(txt) for pid, txt in src_text.items()}\n\n# ---------------- Ledger rows ----------------\n# each row: dict\nR = []\ndef add(**kw):\n    R.append(kw)\n\nD = dt.date\nM='M'; # unused\n\n# 1\nadd(when='March 2014 (discussions during Spring 2014)', who='PetSmart (management) / Industry Participant (a privately held industry participant)',\n    what='Target interest', rnd=0, typ='',\n    terms=(\"Board authorized management in March 2014 to approach Industry Participant about a possible merger with or acquisition of it; CEO David Lenhardt spoke with Industry Participant's CEO over the Spring. Industry Participant said it was not for sale and believed antitrust clearance would not be obtained, or only with unacceptable conditions. PetSmart's own acquisition attempt, not a bid in its sale process; kept as context for the later decision to exclude Industry Participant.\"),\n    why=(\"Stated: the board used the first quarter of 2014 to consider an acquisition of another industry participant; direction is target-to-Industry Participant. \"\n         \"\\u201cIn March, 2014, the board authorized management to contact Industry Participant to determine Industry Participant\\u2019s interest in initiating exploratory discussions concerning the feasibility of a merger or acquisition transaction.\\u201d \"\n         \"\\u201cIndustry Participant\\u2019s CEO informed Mr. Lenhardt that Industry Participant was not for sale\\u201d. Scope is the whole of Industry Participant, not a bid for PetSmart.\"),\n    src=['P-001'], page=21, from_=D(2014,3,1), to=D(2014,5,31), wd=D(2014,3,1), basis='Reported interval', method='Assigned: bound',\n    related='R007; R010', review='', count=None,\n    qcheck=['In March, 2014, the board authorized management to contact Industry Participant to determine Industry Participant\\u2019s interest in initiating exploratory discussions concerning the feasibility of a merger or acquisition transaction.',\n            'Industry Participant\\u2019s CEO informed Mr. Lenhardt that Industry Participant was not for sale'])\n\n# 2\nadd(when='06/18/2014', who='PetSmart board', what='Target decision', rnd=0, typ='',\n    terms=(\"Board reviewed strategic and financial alternatives with a financial adviser and Wachtell Lipton; determined to explore capital-structure changes intensively, focused on returning capital to stockholders; established an ad hoc advisory subcommittee of independent directors (Gregory Josefowicz, Rakesh Gangwal, Thomas Stemberg) and authorized vetting and retention of a financial adviser. No sale decision at this meeting. R1 anchor candidate, rejected (R013).\"),\n    why=(\"Stated: June 18, 2014 board review and governance steps; a capital-structure review, not yet a sale decision. \"\n         \"\\u201cAt a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (\\u201cWachtell Lipton\\u201d), its legal advisor, the various strategic and financial alternatives potentially available to the Company\\u201d. \"\n         \"Follows the 05/21/2014 weak Q1 release and late-May/June communications from stockholders and interested parties.\"),\n    src=['P-002','P-003'], page=21, from_=D(2014,6,18), to=D(2014,6,18), wd=D(2014,6,18), basis='Reported day', method='Reported',\n    related='R004; R008', review='', count=None,\n    qcheck=['At a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (\\u201cWachtell Lipton\\u201d), its legal advisor, the various strategic and financial alternatives'])\n\n# 3\nadd(when='06/18/2014', who='PetSmart / Wachtell, Lipton, Rosen & Katz', what='Adviser service observed', rnd=0, typ='',\n    terms=(\"Legal adviser to PetSmart, described as its legal advisor and shown acting at the June 18, 2014 board meeting and throughout the process (negotiations, merger agreement, voting agreement). Engagement date not disclosed; observed service treated as the mandate start.\"),\n    why=(\"Stated: Wachtell Lipton is identified as PetSmart's legal advisor and present at the June 18, 2014 meeting. Engagement or retention date not disclosed, so an engagement row is not supported; earliest observed service is 06/18/2014. \"\n         \"\\u201cwith Wachtell, Lipton, Rosen & Katz (\\u201cWachtell Lipton\\u201d), its legal advisor\\u201d.\"),\n    src=['P-003'], page=21, from_=D(2014,6,18), to=D(2014,6,18), wd=D(2014,6,18), basis='Reported day', method='Reported',\n    related='R004', review='', count=None,\n    qcheck=['with Wachtell, Lipton, Rosen & Katz (\\u201cWachtell Lipton\\u201d), its legal advisor'])\n\n# 4\nadd(when='July 2014 (engagement letter effective 08/21/2014)', who='PetSmart / J.P. Morgan Securities LLC', what='Adviser engaged', rnd=0, typ='',\n    terms=(\"Engaged as PetSmart's financial adviser in July 2014 after the board interviewed several candidates; engagement letter effective 08/21/2014; scope covered a possible merger, acquisition of a majority of stock or assets. Delivered the fairness opinion (oral 12/13/2014; written 12/14/2014). Fee up to approximately $39 million, a substantial portion payable only on consummation.\"),\n    why=(\"Stated: selection month July 2014, engagement letter effective 08/21/2014, opinion dates and contingent fee disclosed. Working date is the earliest bound of the July selection window (Assigned: bound). \"\n         \"\\u201cIn July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor\\u201d; \\u201cPursuant to an engagement letter effective as of August 21, 2014, the Company retained J.P. Morgan as its financial advisor\\u201d; \\u201cFor services rendered in connection with the merger and the delivery of its opinion, the Company has agreed to pay J.P. Morgan an amount up to approximately $39 million\\u201d.\"),\n    src=['P-003','X-012','X-014'], page=21, from_=D(2014,7,1), to=D(2014,8,21), wd=D(2014,7,1), basis='Reported interval', method='Assigned: bound',\n    related='R003', review='', count=None,\n    qcheck=['In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor',\n            'Pursuant to an engagement letter effective as of August 21, 2014, the Company retained J.P. Morgan as its financial advisor',\n            'For services rendered in connection with the merger and the delivery of its opinion, the Company has agreed to pay J.P. Morgan an amount up to approximately $39 million'])\n\n# 5\nadd(when='07/03/2014 (through August 2014)', who='JANA Partners LLC (activist stockholder)', what='Activist pressure', rnd=0, typ='',\n    terms=(\"Schedule 13D disclosing a 9.9% stake and intent to discuss a review of strategic alternatives, including a sale; multiple amendments and public letters over July-August advocating a sale; met Company representatives in person on 07/10/2014 to press its views. JANA held 5,050,107 shares (5.1%) per its 01/26/2015 13D/A.\"),\n    why=(\"Stated: JANA filed on 07/03/2014 and publicly advocated a sale; ownership per the beneficial-ownership table. \"\n         \"\\u201cOn July 3, 2014, JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company\\u2019s outstanding common stock\\u201d; \\u201cOn July 10, 2014, representatives of JANA met in person with representatives of the Company\\u201d.\"),\n    src=['P-004','X-027'], page=22, from_=D(2014,7,3), to=D(2014,8,29), wd=D(2014,7,3), basis='Reported interval', method='Assigned: bound',\n    related='R006', review='', count=None,\n    qcheck=['On July 3, 2014, JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company\\u2019s outstanding common stock',\n            'On July 10, 2014, representatives of JANA met in person with representatives of the Company',\n            'JANA Partners LLC (3)  \\u200b 5,050,107'])\n\n# 6\nadd(when='07/07/2014', who='Longview Asset Management, LLC (stockholder; later rollover supporter)', what='Activist involvement', rnd=0, typ='',\n    terms=(\"Public letter to the board urging that it consider a sale (among other alternatives) and stating Longview would consider rolling part or all of its holdings into the acquirer's equity if needed to complete a transaction; Longview reiterated its advocacy in a 07/10/2014 call with the Company. In May 2014 Longview had met board members and management to present business views without advocating a specific transaction.\"),\n    why=(\"Stated: the 07/07/2014 public letter and the rollover willingness; the May meetings are involvement without a transaction proposal. \"\n         \"\\u201cLongview would consider, depending on the parties and terms involved, rolling part or all of its holdings into equity of the acquiring entity rather than receive cash consideration\\u201d; \\u201cLongview reiterated its advocacy for a sale of the Company\\u201d.\"),\n    src=['P-002','P-004'], page=22, from_=D(2014,7,7), to=D(2014,7,7), wd=D(2014,7,7), basis='Reported day', method='Reported',\n    related='R039; R043', review='', count=None,\n    qcheck=['Longview would consider, depending on the parties and terms involved, rolling part or all of its holdings into equity of the acquiring entity rather than receive cash consideration',\n            'Longview reiterated its advocacy for a sale of the Company'])\n\n# 7\nadd(when='08/07/2014', who='Industry Participant (via J.P. Morgan)', what='Bidder interest', rnd=0, typ='',\n    terms=(\"Unsolicited, unpriced approach: Industry Participant's representative told J.P. Morgan that if the Company pursued strategic alternatives, it might want to revisit the Spring discussions about a possible combination of the two companies; reported to the ad hoc committee. One of three strategic parties that made contact (the other two entered the 27 contacts), and the only one individually tracked.\"),\n    why=(\"Stated: inbound call dated 08/07/2014, unpriced, reported to the ad hoc committee. \"\n         \"\\u201cIndustry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies\\u201d.\"),\n    src=['P-005'], page=22, from_=D(2014,8,7), to=D(2014,8,7), wd=D(2014,8,7), basis='Reported day', method='Reported',\n    related='R001; R010', review='', count=None,\n    qcheck=['Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies'])\n\n# 8\nadd(when='08/13/2014', who='PetSmart board', what='Target sale decision', rnd=0, typ='',\n    terms=(\"Board completed its initial review and determined to explore strategic alternatives, including a possible sale, to maximize stockholder value; instructed management to plan the Profit Improvement Plan; authorized the ad hoc committee to oversee the sale exploration; planned J.P. Morgan outreach to likely buyers in the second half of September or early October and a public announcement to draw uncontacted parties. R1 anchor candidate, rejected (R013).\"),\n    why=(\"Stated: the decision to explore a sale, the process governance, planned outreach timing and publicity authorization. \"\n         \"\\u201cdetermined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders\\u201d. No irrevocable commitment to sell was recorded.\"),\n    src=['P-006'], page=22, from_=D(2014,8,13), to=D(2014,8,13), wd=D(2014,8,13), basis='Reported day', method='Reported',\n    related='R009; R013', review='', count=None,\n    qcheck=['determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders'])\n\n# 9\nadd(when='08/19/2014', who='PetSmart', what='Sale process announced', rnd=0, typ='',\n    terms=(\"Press release, concurrent with the second-quarter earnings announcement, disclosing the determination to explore strategic alternatives including a possible sale. R1 anchor candidate, rejected (R013); the announcement did not itself open a round, and the filing reports contacts coming to J.P. Morgan rather than a dated first target outreach wave.\"),\n    why=(\"Stated: public announcement dated 08/19/2014. The board had decided a public announcement would \\u201censure that interested parties not contacted would become aware of the process\\u201d. \"\n         \"\\u201cthe Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company\\u201d.\"),\n    src=['P-006'], page=23, from_=D(2014,8,19), to=D(2014,8,19), wd=D(2014,8,19), basis='Reported day', method='Reported',\n    related='R008; R013', review='', count=None,\n    qcheck=['the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company'])\n\n# 10\nadd(when='08/27/2014 (calls also 08/22/2014)', who='PetSmart (ad hoc committee via J.P. Morgan) / Industry Participant', what='Target decision', rnd=0, typ='',\n    terms=(\"Industry Participant told it would not be invited to the exploratory sale process; rationale: very high antitrust risk (likely second request, eight months to a year or more), risk of leaking competitively advantageous information, and risk of disrupting or delaying the process. J.P. Morgan added that a proposal or other communication from Industry Participant would be considered by the board; Industry Participant said it remained interested in a combination; no contact since 08/27/2014.\"),\n    why=(\"Stated: decision and communications dated 08/22 and 08/27; Industry Participant never entered (no NDA, no bid, never admitted), so this is a Target decision, not an outcome row. \"\n         \"\\u201cThe J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process, but that if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it.\\u201d\"),\n    src=['P-006','P-007'], page=22, from_=D(2014,8,22), to=D(2014,8,27), wd=D(2014,8,27), basis='Reported interval', method='Assigned: bound',\n    related='R001; R007; R012', review='', count=None,\n    qcheck=['The J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process, but that if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it.'])\n\n# 11\nadd(when='mid-August through October 2014', who='27 potential participants (3 strategic, 24 financial) via J.P. Morgan', what='Contact', rnd=0, typ='',\n    terms=(\"Aggregate contact activity: J.P. Morgan was contacted by (and, for the sale process, dealt with) 27 potential participants - three strategic parties (not counting Industry Participant) and 24 financial participants, including potential lead buyers and large suppliers of equity capital to lead buyers. These contacts fed the October confidentiality-agreement wave; about 15 parties expressed interest by the 10/03/2014 board meeting.\"),\n    why=(\"Stated: 27 individually uncounted contacts; the filing gives the type split, so no type is assigned to the cohort as a whole (contact aggregate). The board was later told \\u201capproximately 15 parties had expressed interest\\u201d. \"\n         \"\\u201cJ.P. Morgan was contacted by 27 potential participants in a sale process, including three strategic parties (not counting Industry Participant) and 24 financial participants\\u201d.\"),\n    src=['P-008','P-009'], page=23, from_=D(2014,8,15), to=D(2014,10,31), wd=D(2014,9,22), basis='Reported interval', method='Assigned: midpoint',\n    related='R014', review='', count=27,\n    qcheck=['J.P. Morgan was contacted by 27 potential participants in a sale process, including three strategic parties (not counting Industry Participant) and 24 financial participants',\n            'the board was informed that approximately 15 parties had expressed interest in participating in the process'])\n\n# 12\nadd(when='10/03/2014', who='PetSmart board', what='Material process update', rnd=0, typ='',\n    terms=(\"Board received an update on the sale process and the Profit Improvement Plan (planning complete); informed that about 15 parties had expressed interest; reaffirmed, for the August reasons, the determination not to invite Industry Participant to participate. R1 anchor candidate, rejected (R013).\"),\n    why=(\"Stated: board meeting and reaffirmation dated 10/03/2014. \"\n         \"\\u201creaffirmed the determination not to invite Industry Participant to participate in the sale process\\u201d and \\u201capproximately 15 parties had expressed interest in participating in the process\\u201d.\"),\n    src=['P-009'], page=23, from_=D(2014,10,3), to=D(2014,10,3), wd=D(2014,10,3), basis='Reported day', method='Reported',\n    related='R010; R014', review='', count=None,\n    qcheck=['reaffirmed the determination not to invite Industry Participant to participate in the sale process'])\n\n# 13\nadd(when='first week of October 2014', who='PetSmart / J.P. Morgan', what='Round opened', rnd=1, typ='',\n    terms=(\"R1 anchor: confidentiality-agreement wave (R014) - first target-organized step admitting participants (no dated first outreach wave is reported; contacts came to J.P. Morgan). Rejected candidate anchors: R008 (08/13 decision; planned outreach was for late September/early October, not within a week), R009 (08/19 announcement replacing outreach), R012 (10/03 board update). Objective: signed NDAs/standstills, due diligence and management presentations, then non-binding indications of interest due 10/30/2014. Round finality: Not final - preliminary non-binding stage, no final/binding announcement.\"),\n    why=(\"Convention and stated basis: the CA wave is the first target-organized admission step; no target outreach wave is dated in the filing (J.P. Morgan \\u201cwas contacted by 27 potential participants\\u201d), so the round boundary follows the confidentiality-agreement wave under the instruction's rule 3. \"\n         \"\\u201cIn the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\u201d.\"),\n    src=['P-008','P-010'], page=23, from_=D(2014,10,1), to=D(2014,10,7), wd=D(2014,10,4), basis='Reported interval', method='Assigned: midpoint',\n    related='R008; R009; R012; R014', review='Q1', count=None, finality='Not final',\n    qcheck=['In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers'])\n\n# 14\nadd(when='first week of October 2014', who='15 potentially interested financial buyers (cohort)', what='NDA signed', rnd=1, typ='Financial',\n    terms=(\"Confidentiality and standstill agreements executed with 15 financial buyers; all 15 then engaged in due diligence, received management presentations with the senior-most management and detailed financial and business-plan information including the Profit Improvement Plan. Standstills bar the signers from submitting (or seeking permission to submit) a higher bid once a definitive agreement is signed. Auction screen: met - 15 executed bidder-target confidentiality agreements covering more than one independent prospective acquiring bidder unit; no reused earlier agreements reported.\"),\n    why=(\"Stated: 15 executed confidentiality/standstill agreements, all financial buyers, uniform October access. Auction screen assessed from these executed bidder-target contracts (adviser and rollover-holder agreements excluded and none reported). \"\n         \"\\u201centered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\u201d; \\u201call 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company\\u2019s senior-most management, and received detailed financial and business plan information\\u201d.\"),\n    src=['P-010','X-009'], page=23, from_=D(2014,10,1), to=D(2014,10,7), wd=D(2014,10,4), basis='Reported interval', method='Assigned: midpoint',\n    related='R013; R015', review='Q3', count=15,\n    qcheck=['entered into confidentiality and standstill agreements with 15 potentially interested financial buyers',\n            'all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company\\u2019s senior-most management, and received detailed financial and business plan information',\n            'the confidentiality agreements entered into by the 15 potentially interested parties that engaged in due diligence contained standstill provisions that prevent those parties from submitting (or even seeking permission to submit) a higher bid once the Company entered into a definitive transaction agreement with the winning sale process participant'])\n\n# 15\nadd(when='October 2014 (day not disclosed)', who='PetSmart / J.P. Morgan', what='Deadline set', rnd=1, typ='',\n    terms=(\"Potential bidders informed that non-binding preliminary indications of interest were due 10/30/2014. Bidders were also told Longview was willing to roll over up to 7.5 million shares on terms and price acceptable to it (such shares would become equity rather than receive cash), and were asked to indicate their interest in a Longview participation - expressly not a condition to participating. Communication date within October not disclosed; Working date is the window midpoint.\"),\n    why=(\"Stated: due date 10/30/2014 and the Longview rollover notice, month only. Date basis is the October window (10/01-10/30); midpoint assigned. \"\n         \"\\u201cnon-binding preliminary indications of interest would be due on October 30, 2014\\u201d; \\u201cwilling to \\u201croll-over\\u201d up to 7.5 million shares on terms and price acceptable to Longview\\u201d.\"),\n    src=['P-011'], page=23, from_=D(2014,10,1), to=D(2014,10,30), wd=D(2014,10,15), basis='Approximate window', method='Assigned: midpoint',\n    related='R016; R039', review='Q7', count=None, due=D(2014,10,30),\n    qcheck=['non-binding preliminary indications of interest would be due on October 30, 2014',\n            'willing to \\u201croll-over\\u201d up to 7.5 million shares on terms and price acceptable to Longview'])\n\n# 16\nadd(when='10/30/2014', who='PetSmart / 15 NDA signers', what='Deadline', rnd=1, typ='',\n    terms=(\"IOI due date reached; six of the potentially interested parties submitted. J.P. Morgan then called all potential bidders, submitters and non-submitters alike, to hear price rationales and reasons for not submitting. The board advanced bidders at its 11/03/2014 meeting on the bids in hand - no extension and no late-bid acceptance.\"),\n    why=(\"Stated: submissions on the due date and the follow-up calls; next step was the 11/03 board decision. Deadline treatment Enforced (target took its next step without an extension). \"\n         \"\\u201cOn October 30, six of the potentially interested parties submitted indications of interest. From October 30 to November 2, 2014, representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest\\u201d.\"),\n    src=['P-012','P-013'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\n    related='R011; R014; R023', review='Q2', count=None, due=D(2014,10,30), treatment='Enforced',\n    qcheck=['On October 30, six of the potentially interested parties submitted indications of interest. From October 30 to November 2, 2014, representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest'])\n\n# 17\nadd(when='10/30/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=1, typ='Financial',\n    terms=(\"Non-binding preliminary indication of interest: $81.00-$83.00 per share (range later superseded). One of three bidders initially at or above $80.00; one of six IOI submitters. No price revision. Final-round units after 11/03 are tracked separately.\"),\n    why=(\"Stated: submitted 10/30/2014 with the $81.00-$83.00 range. Formality Informal - a preliminary non-binding IOI with no formal signal (no returned agreement, no final-stage response). Conditions Insufficient evidence: price known, financing/diligence conditions not described, and the stage itself (pre-final-round IOI after October diligence access) does not supply them; preferred reading is that no substantive condition was stated. \"\n         \"\\u201cthe Buyer Group, which indicated a range of $81.00 to $83.00 per share\\u201d.\"),\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\n    related='R014; R030; R037', review='Q6', count=1,\n    formality='Informal', cond='Insufficient evidence',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\n    p_low=81.0, p_high=83.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\n    qcheck=['the Buyer Group, which indicated a range of $81.00 to $83.00 per share'])\n\n# 18\nadd(when='10/30/2014', who='Unnamed financial bidder 1 (suggested $80.00-$85.00)', what='Bid', rnd=1, typ='Financial',\n    terms=(\"Non-binding preliminary indication of interest: $80.00-$85.00 per share. Individually distinguishable only by this price detail; one of the three bidders initially at or above $80.00 and among the four that advanced on 11/03/2014. Later path not individually identified - see R025 and the identity question Q5; no separate exit row is invented.\"),\n    why=(\"Stated: a distinct submitter described only by its range; included as an individual row so the remaining cohort is disjoint. Formality Informal (preliminary IOI, no formal signal); Conditions Insufficient evidence for the same reasons as R017. \"\n         \"\\u201canother bidder, which suggested a range of $80.00 to $85.00 per share\\u201d.\"),\n    src=['P-012','P-013'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\n    related='R020; R025; R034', review='Q3; Q5', count=1,\n    formality='Informal', cond='Insufficient evidence',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\n    p_low=80.0, p_high=85.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\n    qcheck=['another bidder, which suggested a range of $80.00 to $85.00 per share'])\n\n# 19\nadd(when='10/30/2014', who='Bidder 2', what='Bid', rnd=1, typ='Financial',\n    terms=(\"Non-binding preliminary indication of interest: $78.00 per share (submitted level), raised to $81.00-$84.00 during J.P. Morgan's follow-up calls (recorded at R022). Bidder type inferred from the cohort: all 15 NDA signers were financial buyers.\"),\n    why=(\"Stated: initial price $78.00 on 10/30/2014. Formality Informal (preliminary IOI, no formal signal); Conditions Insufficient evidence. \"\n         \"\\u201cBidder 2, which had initially indicated a price of $78.00\\u201d.\"),\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\n    related='R022', review='Q6', count=1,\n    formality='Informal', cond='Insufficient evidence',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\n    p_low=78.0, p_high=78.0, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Not stated',\n    qcheck=['Bidder 2, which had initially indicated a price of $78.00'])\n\n# 20\nadd(when='10/30/2014', who='3 remaining IOI submitters (cohort)', what='Bid', rnd=1, typ='Financial',\n    terms=(\"Disjoint residual cohort: 6 IOI submitters minus the three individually recorded (Buyer Group, R017; Unnamed financial bidder 1, R018; Bidder 2, R019) = 3 remaining submitters. By count these comprise the third bidder that initially indicated at or above $80.00 (no individual price or name disclosed) and two submitters whose prices were below the final-round threshold. Prices not disclosed for the cohort; no endpoints invented.\"),\n    why=(\"Calculated: 6 - 3 individually recorded submitters = 3, per the instruction's disjoint-residual rule; the filing's three-bidder disclosure at or above $80.00 is the only individual content, kept in Terms. Formality Informal and Conditions Insufficient evidence for the same preliminary-IOI reasons as R017. \"\n         \"\\u201cThree bidders initially indicated price ranges that reached at least $80.00 per share\\u201d.\"),\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\n    related='R017; R018; R019; R024', review='Q3; Q4', count=3,\n    formality='Informal', cond='Insufficient evidence',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\n    p_kind='Undisclosed', currency='USD', all_cash='Not stated',\n    qcheck=['Three bidders initially indicated price ranges that reached at least $80.00 per share'])\n\n# 21\nadd(when='by 10/30/2014', who='9 remaining NDA signers (unnamed cohort)', what='Did not submit', rnd=1, typ='Financial',\n    terms=(\"Inferred: residual - 15 NDA signers \\u2212 6 IOI submitters = 9 non-submitters. J.P. Morgan called all potential bidders including non-submitters on 10/30-11/02 to hear their reasons, so the filing accounts for their non-participation. No decision date, motive, identity or permanent withdrawal is inferred; a non-submitter may appear again in a later stage only with a Re-entered row.\"),\n    why=(\"Convention (inferred closing row): the base is the stated 15 executed confidentiality/standstill agreements; six submitters are accounted for at the 10/30/2014 deadline. \"\n         \"\\u201cOn October 30, six of the potentially interested parties submitted indications of interest\\u201d; \\u201centered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\u201d. Non-submission does not establish bidder agency, so Decided by is Unknown.\"),\n    src=['P-012','P-010'], page=24, from_=None, to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Assigned: deadline',\n    related='R014; R016; R020', review='Q4', count=9,\n    decided='Unknown', exit_reason='Not stated', outcome_basis='Inferred: residual',\n    qcheck=['On October 30, six of the potentially interested parties submitted indications of interest',\n            'entered into confidentiality and standstill agreements with 15 potentially interested financial buyers'])\n\n# 22\nadd(when='by 11/02/2014 (calls 10/30-11/02/2014)', who='Bidder 2', what='Bid', rnd=1, typ='Financial',\n    terms=(\"Revised indication: $81.00-$84.00 per share, raised from $78.00 as a result of J.P. Morgan's follow-up calls. This made Bidder 2 the fourth bidder at or above $80.00 and eligible for the final round. Same-round revision of R019; Count 0 because the same bidder unit is already recorded in R1.\"),\n    why=(\"Stated: revision and cause; price range endpoints. Formality Informal (still a preliminary non-binding indication, no formal signal); Conditions Insufficient evidence. \"\n         \"\\u201cincreased its indication to a range of $81.00 to $84.00 per share\\u201d.\"),\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,11,2), wd=D(2014,10,31), basis='Reported interval', method='Assigned: midpoint',\n    related='revises R019', review='Q7', count=0,\n    formality='Informal', cond='Insufficient evidence',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\n    p_low=81.0, p_high=84.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\n    qcheck=['increased its indication to a range of $81.00 to $84.00 per share'])\n\n# 23\nadd(when='11/03/2014', who='PetSmart board / J.P. Morgan', what='Round opened', rnd=2, typ='',\n    terms=(\"R2: board allowed the four bidders that had indicated a price or range at or above $80.00 to proceed to the final round - Buyer Group, Bidder 2 and two unnamed bidders (later combined as Bidder 3, R025); J.P. Morgan notified the eliminated parties. Objective: final-round diligence and management presentations, draft merger agreement, and updated offers. Round finality: Inferred final - no binding/best-and-final announcement at the opening, but the target advanced the field toward definitive documentation; the final-bid solicitation itself opens R3.\"),\n    why=(\"Stated: advancement decision, threshold, and the notification. Finality assessed as Inferred: the filing calls the stage the final round and the Company circulated a merger agreement in November, but no binding-stage announcement is dated at the opening. \"\n         \"\\u201cdetermined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process\\u201d.\"),\n    src=['P-013'], page=24, from_=D(2014,11,3), to=D(2014,11,3), wd=D(2014,11,3), basis='Reported day', method='Reported',\n    related='R017; R019; R022; R025; R026', review='Q1', count=None, finality='Inferred final',\n    qcheck=['determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process'])\n\n# 24\nadd(when='by 11/03/2014', who='2 eliminated IOI submitters (unnamed cohort)', what='Dropped by target', rnd=2, typ='Financial',\n    terms=(\"Inferred: residual - 6 IOI submitters \\u2212 4 advancing at or above $80.00 = 2 eliminated submitters, being the two members of R020 whose indications did not reach the threshold (the third member advanced within the unnamed finalists). J.P. Morgan notified the eliminated parties; none indicated any interest or ability to remain above its initial indications. Exclusion from the final round only; no motive or identity inferred.\"),\n    why=(\"Stated: notification of elimination after the 11/03/2014 board meeting; the number is the arithmetic residual. The two members are identified only by count within R020, so no identity is assigned. \"\n         \"\\u201crepresentatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications\\u201d.\"),\n    src=['P-013'], page=24, from_=None, to=D(2014,11,3), wd=D(2014,11,3), basis='Inferred day', method='Assigned: decision day',\n    related='R020; R023', review='Q4', count=2,\n    decided='Target', exit_reason='Lower offer than rivals', outcome_basis='Inferred: residual',\n    qcheck=['representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications'])\n\n# 25\nadd(when='after 11/03/2014 (day not disclosed)', who='Bidder 3 (two of the four final-round bidders)', what='Bidding group changed', rnd=2, typ='Financial',\n    terms=(\"Formation: two final-round bidders authorized to work together as \\u201cBidder 3\\u201d after one sought an equity partner given the size of an acquisition of PetSmart and the other had said it would drop out if not permitted to team; both had worked together successfully on prior large leveraged buyouts. Bidding units 4 \\u2192 3 (\\u201cunits \\u22121\\u201d); both members are unnamed, so the unit count falls without individual identity rows. All admitted bidders had indicated some interest in a Longview rollover, none made it a condition.\"),\n    why=(\"Stated: authorization by the ad hoc committee after the 11/03/2014 meeting; membership not individually identified by the filing, so the row states the unit effect by number under the instruction's anonymous-cohort convention. \"\n         \"\\u201cAfter deliberation and consultation with the Company\\u2019s financial and legal advisors, the ad hoc committee authorized these two bidders to work together.\\u201d; \\u201cWe refer to these two bidders together as \\u201cBidder 3.\\u201d\\u201d.\"),\n    src=['P-014'], page=24, from_=D(2014,11,3), to=None, wd=D(2014,11,3), basis='Relative only', method='Assigned: bound',\n    related='R023; R033', review='Q5', count=2,\n    qcheck=['After deliberation and consultation with the Company\\u2019s financial and legal advisors, the ad hoc committee authorized these two bidders to work together.',\n            'We refer to these two bidders together as \\u201cBidder 3.\\u201d'])\n\n# 26\nadd(when='November 2014 (day not disclosed)', who='PetSmart / Wachtell Lipton / final-round bidders', what='Round opened', rnd=3, typ='',\n    terms=(\"R3: Company circulated a form of merger agreement instructing bidders to submit proposed comments together with their final bids; the bid date was initially Friday 12/05/2014. Objective: obtain final bids and executable documentation from the three final-round bidding units. Round finality: Announced as final - bids were solicited as \\u201cfinal bids\\u201d; the 12/04-05 and 12/10-12 events are deadline revisions inside this round, not new rounds.\"),\n    why=(\"Stated: November circulation and final-bid instruction; initial 12/05 date. The first request for final offers opens this round under the instruction's round rule, even though the invited set is unchanged. \"\n         \"\\u201cthe Company circulated a form of merger agreement to the bidders with instructions that the bidders submit any proposed comments on the merger agreement together with their final bids\\u201d; \\u201chad initially set Friday, December 5 as the date for submission of bids\\u201d.\"),\n    src=['P-015','P-016'], page=24, from_=D(2014,11,1), to=D(2014,11,30), wd=D(2014,11,15), basis='Approximate window', method='Assigned: midpoint',\n    related='R023; R025; R028', review='Q1; Q7', count=None, due=D(2014,12,5), finality='Announced as final',\n    qcheck=['the Company circulated a form of merger agreement to the bidders with instructions that the bidders submit any proposed comments on the merger agreement together with their final bids',\n            'had initially set Friday, December 5 as the date for submission of bids'])\n\n# 27\nadd(when='November 2014 (following the Q3 earnings release)', who='All final-round bidders / J.P. Morgan', what='Information access changed', rnd=3, typ='',\n    terms=(\"Projections revised after bidding began: after the third-quarter earnings release, at bidders' request and the board's direction, J.P. Morgan provided the bidders with updates to the fiscal-year-2014 projections to reflect actual performance and better visibility on the Profit Improvement Plan (FY2014E revenue $7,081M vs $7,088M before; EBITDA $967M vs $958M; net income $445M vs $432M; cash flow from operations unchanged at $617M). The FY2020-24 extrapolations and J.P. Morgan's downside sensitivities were not provided to bidders - see Summary comparability.\"),\n    why=(\"Stated: revision and recipients; the update note gives before/after figures. A projection revision after bidding began is recorded as an information-access change; the same update went to all final-round bidders, so it is not a differentiated-access row. \"\n         \"\\u201cFollowing the Company\\u2019s third quarter earnings announcement and, at the request of bidders and the direction of the board and the Company, representatives of J.P. Morgan provided the bidders with updates to the Company\\u2019s fiscal year 2014 financial projections.\\u201d\"),\n    src=['P-015','X-015','X-016'], page=37, from_=D(2014,11,1), to=D(2014,11,30), wd=D(2014,11,15), basis='Approximate window', method='Assigned: midpoint',\n    related='R026', review='Q7', count=None,\n    qcheck=['Following the Company\\u2019s third quarter earnings announcement and, at the request of bidders and the direction of the board and the Company, representatives of J.P. Morgan provided the bidders with updates to the Company\\u2019s fiscal year 2014 financial projections.',\n            'projected revenue was $7,088 million, projected EBITDA was $958 million and projected net income was $432 million'])\n\n# 28\nadd(when='12/04/2014-12/05/2014', who='PetSmart ad hoc committee', what='Deadline revised', rnd=3, typ='',\n    terms=(\"Ad hoc committee, after consulting the Company's financial and legal advisers, replaced the initial 12/05/2014 bid date with the evening of 12/10/2014 (five days rather than ten before the anticipated 12/15/2014 completion), so the process could finish sooner and reduce the risk of leaks or unintended public disclosure; bidders were simultaneously asked to submit mark-ups of the draft merger agreement and other transaction documents and financing commitments, if possible, in advance. Old due date 12/05/2014 (superseded before arrival; no milestone row); new due date 12/10/2014. Deadline treatment records what followed 12/10/2014 (extended at R035).\"),\n    why=(\"Stated: the two-day committee decision, the reason and both dates. Working date is the last day of the decision span (Assigned: decision day). \"\n         \"\\u201cthe ad hoc committee concluded that these matters could be accomplished in a shorter period of time, which would reduce the risk of leaks or unintended public disclosure.\\u201d; \\u201cAccordingly, the Company set the evening of Wednesday, December 10\\u201d.\"),\n    src=['P-016'], page=24, from_=D(2014,12,4), to=D(2014,12,5), wd=D(2014,12,5), basis='Reported interval', method='Assigned: decision day',\n    related='R026; R029', review='Q2', count=None, due=D(2014,12,10), treatment='Extended',\n    qcheck=['the ad hoc committee concluded that these matters could be accomplished in a shorter period of time, which would reduce the risk of leaks or unintended public disclosure.',\n            'Accordingly, the Company set the evening of Wednesday, December 10'])\n\n# 29\nadd(when='12/10/2014', who='PetSmart / final-round bidders', what='Deadline', rnd=3, typ='',\n    terms=(\"Final-bid deadline reached: Buyer Group and Bidder 2 submitted final bid letters with revised merger agreement and transaction documents, and Bidder 3 gave a verbal indication (R030-R033). The same evening the ad hoc committee instructed improved bids by 12/12/2014 (R035) - this due date was extended, with no late-bid acceptance issue.\"),\n    why=(\"Stated: bids received on the date; extension decided that evening. Deadline treatment Extended because a Deadline revised row (R035) moved this date. \"\n         \"\\u201cOn December 10, PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 and a verbal indication from Bidder 3.\\u201d\"),\n    src=['P-020','P-021'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\n    related='R028; R035', review='Q2', count=None, due=D(2014,12,10), treatment='Extended',\n    qcheck=['On December 10, PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 and a verbal indication from Bidder 3.'])\n\n# 30\nadd(when='12/10/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=3, typ='Financial',\n    terms=(\"Final bid: $80.70 per share, in cash; final bid letter and revised merger agreement and other transaction documents, which were more favorable to the Company (less conditional, more likely to be completed, more certainty of protection) and reflected substantially more acceptance of the Company's positions than Bidder 2's. Financing commitment documents had been provided 12/06/2014. Bid not dependent on a Longview rollover, though partnering was not ruled out. Revised at R037.\"),\n    why=(\"Stated: price and cash form; documentation and financing facts. Formality Formal - signal 1 (bidder-returned acquisition agreement and transaction documents, substantially executable) plus the requested final-bid response. Conditions Light - no Heavy trigger; committed financing documented; remaining matters were final documentation (board approval on 12/13 was subject to resolving open points). \"\n         \"\\u201cThe Buyer Group offered $80.70 per share, in cash, and Bidder 2 offered $80.35 per share, in cash.\\u201d; \\u201cThe form of merger agreement and other transaction documentation submitted by the Buyer Group were more favorable to the Company\\u201d.\"),\n    src=['P-017','P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\n    related='R017; R028; R037', review='Q6', count=1,\n    formality='Formal', cond='Light',\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\n    p_low=80.70, p_high=80.70, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\n    qcheck=['The Buyer Group offered $80.70 per share, in cash, and Bidder 2 offered $80.35 per share, in cash.',\n            'The form of merger agreement and other transaction documentation submitted by the Buyer Group were more favorable to the Company'])\n\n# 31\nadd(when='12/10/2014', who='Bidder 2', what='Bid', rnd=3, typ='Financial',\n    terms=(\"Final bid: $80.35 per share, in cash; final bid letter and revised merger agreement and transaction documents. Bid not dependent on a Longview rollover; Bidder 2 said any partnering with Longview would occur only after signing a merger agreement. Financing commitment documents were provided with its 12/12 revision (R038). Revised at R038.\"),\n    why=(\"Stated: price and cash form; documentation; rollover position. Formality Formal - revised acquisition agreement and transaction documents submitted with the final-bid response. Conditions Light - no Heavy trigger; treat as subject to final documentation; financing not stated at this date (silence neither raises nor lowers; documents followed on 12/12). \"\n         \"\\u201cBidder 2 offered $80.35 per share, in cash\\u201d; \\u201ceach bidder indicated that its bid was not dependent on a rollover by Longview\\u201d.\"),\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\n    related='R022; R029; R038', review='Q6', count=1,\n    formality='Formal', cond='Light',\n    cond_detail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\n    p_low=80.35, p_high=80.35, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\n    qcheck=['Bidder 2 offered $80.35 per share, in cash',\n            'each bidder indicated that its bid was not dependent on a rollover by Longview'])\n\n# 32\nadd(when='12/10/2014', who='Bidder 3', what='Valuation statement', rnd=3, typ='Financial',\n    terms=(\"Verbal indication in response to the final-bid solicitation: Bidder 3's valuation would not be above the then-current stock price of approximately $78.00 per share. A communicated valuation ceiling, not a bid for the bid-price cells; the non-submission is recorded at R033.\"),\n    why=(\"Stated: the valuation statement and the comparison, on the final-bid date. Treated as a valuation statement (no offer made; the filing's price reference is the market price) so per-share cells are left blank and the value stays in text. \"\n         \"\\u201cBidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share.\\u201d\"),\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\n    related='R025; R033', review='Q6', count=None,\n    qcheck=['Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share.'])\n\n# 33\nadd(when='12/10/2014', who='Bidder 3', what='Did not submit', rnd=3, typ='Financial',\n    terms=(\"No written final offer: after J.P. Morgan told Bidder 3 its indication was unlikely to be competitive, it submitted no written offer. Its communicated valuation was at or below the ~$78.00 market price and below the $80.70/$80.35 rival bids. The combined unit is closed here; a written submission did not occur in this solicitation.\"),\n    why=(\"Stated: non-submission and the discouraging communication. Decided by Both - target discouragement followed by non-participation (mixed mechanism). Exit reason Value at or below market price (benchmark: current stock price ~$78; also below rivals, preserved in text). \"\n         \"\\u201cJ.P. Morgan communicated to Bidder 3 that it was unlikely to be competitive and accordingly Bidder 3 did not submit a written offer.\\u201d\"),\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\n    related='R032; R025', review='Q4; Q5', count=1,\n    decided='Both', exit_reason='Value at or below market price', outcome_basis='Stated',\n    qcheck=['J.P. Morgan communicated to Bidder 3 that it was unlikely to be competitive and accordingly Bidder 3 did not submit a written offer.'])\n\n# 34\nadd(when='by 12/10/2014', who='Unnamed financial bidder 1 (suggested $80.00-$85.00)', what='Did not submit', rnd=3, typ='Financial',\n    terms=(\"Inferred: identity - last individually observed advancing to the final round on 11/03/2014 (R018); not mentioned again. It may be one of the two unnamed finalists that combined as Bidder 3 (R025) and be closed by R033; alternatively its exit is already inside the anonymous final-round units. Count 0: no count moves from a cohort to a name on this basis. See Q5.\"),\n    why=(\"Convention (Count-0 identity row): the filing never mentions this submitter again after the advancement, and the two anonymous finalists absorbed two of the four advancing units. Recommended reading: within the Bidder 3 unit closed at R033. \"\n         \"\\u201canother bidder, which suggested a range of $80.00 to $85.00 per share\\u201d; \\u201cthe four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round\\u201d.\"),\n    src=['P-012','P-013','P-014'], page=24, from_=None, to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Assigned: decision day',\n    related='R018; R025; R033', review='Q4; Q5', count=0,\n    decided='Both', exit_reason='Value at or below market price', outcome_basis='Inferred: identity',\n    qcheck=['another bidder, which suggested a range of $80.00 to $85.00 per share',\n            'the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round'])\n\n# 35\nadd(when='12/10/2014', who='PetSmart ad hoc committee / J.P. Morgan', what='Deadline revised', rnd=3, typ='',\n    terms=(\"After receiving the 12/10 bids, the ad hoc committee found there could be no assurance the board would approve either bid unless improved, citing the closeness of the bids, positive developments from the 12/03/2014 board meeting and the shared view that neither bid was the bidder's best; J.P. Morgan was instructed to require increased bids due 12/12/2014. On the evening of 12/11/2014 J.P. Morgan also confirmed Longview's continued interest in rolling over shares, subject to approval. Old due date 12/10/2014 (extended at R029); new due date 12/12/2014. Deadline treatment records what followed 12/12/2014 (enforced at R036).\"),\n    why=(\"Stated: instruction and new date; reason and the 12/11 Longview call. Working date is the reported decision day. \"\n         \"\\u201cthe ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014.\\u201d\"),\n    src=['P-021'], page=25, from_=D(2014,12,10), to=D(2014,12,11), wd=D(2014,12,10), basis='Reported interval', method='Assigned: decision day',\n    related='R029; R036', review='Q2', count=None, due=D(2014,12,12), treatment='Enforced',\n    qcheck=['the ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014.'])\n\n# 36\nadd(when='12/12/2014', who='PetSmart / final-round bidders', what='Deadline', rnd=3, typ='',\n    terms=(\"Improved-bid deadline reached: Buyer Group and Bidder 2 submitted best-and-final offers with revised drafts and financing commitment documents (R037, R038). The board met on 12/13/2014 and acted on the bids in hand - enforced, with no further extension.\"),\n    why=(\"Stated: submissions on 12/12/2014 and the board meeting the next day. Deadline treatment Enforced. \"\n         \"\\u201ceach bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents\\u201d.\"),\n    src=['P-023','P-024'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\n    related='R035; R037; R038', review='Q2', count=None, due=D(2014,12,12), treatment='Enforced',\n    qcheck=['each bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents'])\n\n# 37\nadd(when='12/12/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=3, typ='Financial',\n    terms=(\"Support: Longview (rollover) - best and final offer of $83.00 per share, in cash, after an initial oral $82.50 the same evening that the Buyer Group said it was working to increase within hours. Revised merger agreement and transaction agreements in substantially executable form and financing commitment documents submitted; members of the group unwilling or unable to offer more. Longview's willingness to participate with respect to $250 million of common stock was helpful in achieving $83.00. Revises R030.\"),\n    why=(\"Stated: price and progression, documentation, and the Longview contribution's role. Formality Formal - signal 1 (substantially executable revised acquisition documents) confirmed by an actual best-and-final price; Conditions Light - committed financing documented and remaining matters were final documentation. \"\n         \"\\u201cLater in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash.\\u201d; \\u201cLongview\\u2019s willingness to participate in the Buyer Group with respect to $250 million of the common stock was helpful in achieving an $83.00 per share price.\\u201d\"),\n    src=['P-023','X-008','X-011'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\n    related='R030; R039', review='Q6', count=0,\n    formality='Formal', cond='Light',\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\n    p_low=83.0, p_high=83.0, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\n    qcheck=['Later in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash.',\n            'Longview\\u2019s willingness to participate in the Buyer Group with respect to $250 million of the common stock was helpful in achieving an $83.00 per share price.',\n            'initially submitted an oral offer of $82.50 per share, in cash'])\n\n# 38\nadd(when='12/12/2014', who='Bidder 2', what='Bid', rnd=3, typ='Financial',\n    terms=(\"Best and final offer: $81.50 per share, in cash; J.P. Morgan confirmed by telephone that evening that it was Bidder 2's best and final. Revised draft and financing commitment documents submitted; any Longview accommodation would not affect its price. Revises R031.\"),\n    why=(\"Stated: price, confirmation and documentation. Formality Formal - signal 1 (revised acquisition documents) and signal 3 (actual price confirmation during finalization); Conditions Light - committed financing documented with the revision and remaining matters were final documentation. \"\n         \"\\u201cDuring the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash.\\u201d; \\u201cRepresentatives of J.P. Morgan confirmed via a conversation with Bidder 2 on the evening of December 12, 2014 that $81.50 per share was its best and final offer.\\u201d\"),\n    src=['P-023'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\n    related='R031; R044', review='Q6', count=0,\n    formality='Formal', cond='Light',\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\n    p_low=81.50, p_high=81.50, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\n    qcheck=['During the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash.',\n            'Representatives of J.P. Morgan confirmed via a conversation with Bidder 2 on the evening of December 12, 2014 that $81.50 per share was its best and final offer.'])\n\n# 39\nadd(when='12/12/2014', who='PetSmart ad hoc committee / Buyer Group / Longview', what='Material process update', rnd=3, typ='',\n    terms=(\"Permitted: the ad hoc committee approved the Buyer Group's request to work more closely with Longview and include a rollover of Longview-managed shares in its bid, after the 12/09/2014 introductory meetings J.P. Morgan arranged between Longview and each of the Buyer Group and Bidder 2. Longview and the Buyer Group then signed a confidentiality agreement permitting exchange of detailed information including bid price, which had not previously been shared with Longview; Wachtell Lipton was instructed to provide a form of voting agreement to Longview. Bidder 2 declined any price effect and would consider Longview only after signing. Resolution recorded at R043.\"),\n    why=(\"Stated: request, approval, confidentiality agreement and voting-agreement instruction, all on 12/12/2014. One of the two permitted rows for the rollover relationship; support is not treated as a bidding-group membership change or a new NDA by a bidder for the auction screen. \"\n         \"\\u201cthe ad hoc committee approved the Buyer Group\\u2019s request, and, later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price\\u201d.\"),\n    src=['P-019','P-022'], page=25, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\n    related='R037; R043', review='Q8', count=None,\n    qcheck=['the ad hoc committee approved the Buyer Group\\u2019s request, and, later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price'])\n\n# 40\nadd(when='12/13/2014', who='PetSmart board', what='Target decision', rnd=3, typ='',\n    terms=(\"Board unanimously determined the merger agreement and the merger advisable and in the best interests of PetSmart and its stockholders and resolved to recommend adoption; the determination was subject to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved. J.P. Morgan delivered its oral fairness opinion on the $83.00 consideration (written opinion the next day); the board would reconvene if needed.\"),\n    why=(\"Stated: approval, qualification and opinion timing. Selection of the Buyer Group is reflected here and in the signing row; separate from the round opening. \"\n         \"\\u201cthe board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders\\u201d; \\u201csubject, however, to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved\\u201d.\"),\n    src=['P-024','X-013'], page=26, from_=D(2014,12,13), to=D(2014,12,13), wd=D(2014,12,13), basis='Reported day', method='Reported',\n    related='R041; R042', review='', count=None,\n    qcheck=['the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders',\n            'subject, however, to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved'])\n\n# 41\nadd(when='12/14/2014', who='PetSmart / Argos Holdings Inc. (Parent) / Argos Merger Sub Inc.', what='Merger agreement signed', rnd=3, typ='',\n    terms=(\"Executed the Agreement and Plan of Merger dated 12/14/2014: each outstanding share converts into the right to receive $83.00 in cash at the effective time; Company termination fee $255 million for a superior-proposal termination and Parent reverse termination fee $510 million in specified financing-failure cases; closing conditioned on stockholder adoption, antitrust clearances and no prohibitory order, with an outside date of 06/14/2015. Signing is not a bid: bid-price and formality/conditionality cells are left blank (agreed consideration appears in Cash at closing).\"),\n    why=(\"Stated: execution, consideration and payment form; fee framework and closing conditions. \"\n         \"\\u201cOn December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction.\\u201d\"),\n    src=['P-025','X-004','X-022','X-032'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\n    related='R040; R042; R043; R044', review='', count=None,\n    cash_close=83.0, currency='USD', all_cash='Yes',\n    qcheck=['On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction.'])\n\n# 42\nadd(when='12/14/2014', who='PetSmart / Parent', what='Merger announced', rnd=3, typ='',\n    terms=(\"Press release announcing the transaction, issued concurrently with execution. No go-shop was provided; the 15 NDA signers' standstill provisions bar them from submitting or seeking permission to submit a higher bid after a definitive agreement; as of 02/02/2015 no person had made an unsolicited offer or proposal to acquire PetSmart. Public disclosure of the signed deal is distinct from signing.\"),\n    why=(\"Stated: announcement and the absence of post-signing proposals to the proxy date; standstills preserved as the stated mechanism. \"\n         \"\\u201cas of February 2, 2015, the date of this proxy statement, no person has made an unsolicited offer or proposal to acquire PetSmart\\u201d.\"),\n    src=['P-025','X-009','X-010'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\n    related='R041', review='', count=None,\n    qcheck=['as of February 2, 2015, the date of this proxy statement, no person has made an unsolicited offer or proposal to acquire PetSmart'])\n\n# 43\nadd(when='12/14/2014', who='Longview / Parent', what='Material process update', rnd=3, typ='',\n    terms=(\"Resolved: rollover agreement executed under which Longview contributes 3,012,050 shares (about $250 million at $83.00) to Parent immediately before the effective time in exchange for equity interests in Parent; the Company is an express third-party beneficiary. Longview enters the \\u201cBuyer Group\\u201d definition from 12/12/2014 onward; its remaining shares receive the same $83.00 cash consideration. A rolling-over shareholder admitted to the buyer vehicle is not a bidding-group membership change.\"),\n    why=(\"Stated: agreement, share count and treatment of other shares. The second permitted row for the rollover relationship (permitted at R039, resolved here); no new bidder NDA or bid is created. \"\n         \"\\u201cLongview has agreed to contribute 3,012,050 shares (\\u201crollover shares\\u201d) to Parent immediately prior to the effective time in exchange for equity interests in Parent\\u201d; \\u201cLongview will receive the same $83.00 per share merger consideration as the other holders of the Company\\u2019s common stock for all other shares of common stock beneficially owned by it (other than the rollover shares).\\u201d\"),\n    src=['X-018','X-019','X-020','X-001'], page=41, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\n    related='R039; R041', review='Q8', count=None,\n    qcheck=['Longview has agreed to contribute 3,012,050 shares (\\u201crollover shares\\u201d) to Parent immediately prior to the effective time in exchange for equity interests in Parent',\n            'Longview will receive the same $83.00 per share merger consideration as the other holders of the Company\\u2019s common stock for all other shares of common stock beneficially owned by it (other than the rollover shares).'])\n\n# 44\nadd(when='12/14/2014', who='Bidder 2', what='Not selected at signing', rnd=3, typ='Financial',\n    terms=(\"The target signed with the Buyer Group; Bidder 2's $81.50 best-and-final was lower than the $83.00 price offered by the Buyer Group, and the board noted Bidder 2's $81.50 was its best and final. Participation had not previously ended, so this is a signing outcome, stated, not an invented earlier withdrawal; no Re-entered row follows.\"),\n    why=(\"Stated: the choice and the price comparison; a live finalist at signing is closed as Not selected at signing with Outcome basis Stated. Decided by Target (the board selected the Buyer Group's higher-priced, more executable offer). \"\n         \"\\u201cneither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group\\u201d.\"),\n    src=['P-024','X-008'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\n    related='R038; R040; R041', review='Q4', count=1,\n    decided='Target', exit_reason='Lower offer than rivals', outcome_basis='Stated',\n    qcheck=['neither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group'])\n\n# ---------------- Validate rows before writing ----------------\nids = [f'R{i+1:03d}' for i in range(len(R))]\nassert len(set(ids)) == len(ids)\nprev_wd = None\nfor i, r in enumerate(R):\n    assert r['wd'] is not None, ids[i]\n    if prev_wd is not None:\n        assert r['wd'] >= prev_wd, f\"{ids[i]} working date decreases\"\n    prev_wd = r['wd']\n    if r.get('from_') and r.get('to'):\n        assert r['from_'] <= r['wd'] <= r['to'], f\"{ids[i]} wd outside bounds\"\n    if r.get('from_'):\n        assert r['wd'] >= r['from_'], ids[i]\n    if r.get('to'):\n        assert r['wd'] <= r['to'], ids[i]\n    # method/basis pair\n    if r['method'] == 'Reported':\n        assert r['basis'] == 'Reported day', ids[i]\n    if r['method'] == 'Inferred':\n        assert r['basis'] == 'Inferred day', ids[i]\n    # quotes check\n    for q in r.get('qcheck', []):\n        ok = any(norm(q) in SRC_NORM[s] for s in r['src'])\n        assert ok, f\"{ids[i]} quote not found in cited sources: {q[:80]}\"\nprint(\"row validation OK:\", len(R), \"rows\")\n# save row data for the workbook build (next script section continues in same file)\nimport json\njson.dump(R, open('/tmp/opencode/petsmart/rows.json','w'), default=str, indent=1)\njson.dump([(p,s,g,t) for p,s,g,t in SRC_ROWS], open('/tmp/opencode/petsmart/source_rows.json','w'), indent=1)\nprint(\"saved\")\n"},"output":"Created file successfully: /tmp/opencode/petsmart/build_ledger.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/petsmart/build_ledger.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/petsmart/build_ledger.py\", \"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build petsmart.xlsx deal ledger from the supplied DEFM14A per the extraction instruction.\\\"\\\"\\\"\\nimport re, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.worksheet.hyperlink import Hyperlink\\n\\nSRC = '/tmp/opencode/petsmart/filing_text.txt'\\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\\n\\nlines = open(SRC, encoding='utf-8').read().split('\\\\n')\\ndef L(n):  # 1-based line\\n    return lines[n-1].strip()\\n\\n# ---------------- Source text rows ----------------\\n# P paragraphs: background, printed pp. 21-26\\nP = []\\nP.append(('P-001', 'The Merger (Proposal 1) - Background of the Merger', 21, L(725)))\\nP.append(('P-002', 'The Merger (Proposal 1) - Background of the Merger', 21, L(726)))\\nP.append(('P-003', 'The Merger (Proposal 1) - Background of the Merger', 21, L(727) + ' ' + L(732)))\\nP.append(('P-004', 'The Merger (Proposal 1) - Background of the Merger', 22, L(733)))\\nP.append(('P-005', 'The Merger (Proposal 1) - Background of the Merger', 22, L(734)))\\nP.append(('P-006', 'The Merger (Proposal 1) - Background of the Merger', 22, L(735) + ' ' + L(740)))\\nP.append(('P-007', 'The Merger (Proposal 1) - Background of the Merger', 23, L(741)))\\nP.append(('P-008', 'The Merger (Proposal 1) - Background of the Merger', 23, L(742)))\\nP.append(('P-009', 'The Merger (Proposal 1) - Background of the Merger', 23, L(743)))\\nP.append(('P-010', 'The Merger (Proposal 1) - Background of the Merger', 23, L(744)))\\nP.append(('P-011', 'The Merger (Proposal 1) - Background of the Merger', 23, L(745) + ' ' + L(750)))\\nP.append(('P-012', 'The Merger (Proposal 1) - Background of the Merger', 24, L(751)))\\nP.append(('P-013', 'The Merger (Proposal 1) - Background of the Merger', 24, L(752)))\\nP.append(('P-014', 'The Merger (Proposal 1) - Background of the Merger', 24, L(753)))\\nP.append(('P-015', 'The Merger (Proposal 1) - Background of the Merger', 24, L(754)))\\nP.append(('P-016', 'The Merger (Proposal 1) - Background of the Merger', 24, L(755) + ' ' + L(760)))\\nP.append(('P-017', 'The Merger (Proposal 1) - Background of the Merger', 25, L(761)))\\nP.append(('P-018', 'The Merger (Proposal 1) - Background of the Merger', 25, L(762)))\\nP.append(('P-019', 'The Merger (Proposal 1) - Background of the Merger', 25, L(763)))\\nP.append(('P-020', 'The Merger (Proposal 1) - Background of the Merger', 25, L(764)))\\nP.append(('P-021', 'The Merger (Proposal 1) - Background of the Merger', 25, L(765)))\\nP.append(('P-022', 'The Merger (Proposal 1) - Background of the Merger', 25, L(766) + ' ' + L(771)))\\nP.append(('P-023', 'The Merger (Proposal 1) - Background of the Merger', 26, L(772)))\\nP.append(('P-024', 'The Merger (Proposal 1) - Background of the Merger', 26, L(773)))\\nP.append(('P-025', 'The Merger (Proposal 1) - Background of the Merger', 26, L(774)))\\n\\nX = []\\nX.append(('X-001', 'Summary (glossary)', 1, L(145)))\\nX.append(('X-002', 'Summary - Voting Support Agreement', 2, L(194) + ' ' + L(199)))\\nX.append(('X-003', 'Summary - Financing', 5, L(271) + ' ' + L(273) + ' ' + L(276) + ' ' + L(279)))\\nX.append(('X-004', 'Summary - Termination Fee Commitment Letters', 5, L(283)))\\nX.append(('X-005', 'The Parties to the Merger Agreement - PetSmart, Inc.', 16, L(638)))\\nX.append(('X-006', 'The Parties to the Merger Agreement - Argos Holdings Inc. and Argos Merger Sub Inc.', 16, L(640)))\\nX.append(('X-007', 'The Merger - Reasons for the Merger - Attractive Value', 26, L(778)))\\nX.append(('X-008', 'The Merger - Reasons for the Merger - Best Alternative / Sale Process', 27, L(785)))\\nX.append(('X-009', 'The Merger - Reasons for the Merger - Alternative Proposals (standstills)', 28, L(823)))\\nX.append(('X-010', 'The Merger - Reasons for the Merger - Alternative Proposals (no offers by 02/02/2015)', 28, L(829)))\\nX.append(('X-011', 'The Merger - Reasons for the Merger - Other Factors (Longview)', 29, L(848)))\\nX.append(('X-012', 'The Merger - Opinion of J.P. Morgan (engagement)', 30, L(892)))\\nX.append(('X-013', 'The Merger - Opinion of J.P. Morgan (opinion dates)', 30, L(893)))\\nX.append(('X-014', 'The Merger - Opinion of J.P. Morgan (fee and relationships)', 37, L(1068)))\\nX.append(('X-015', 'The Merger - Projected Financial Information (scope)', 37, L(1072)))\\nX.append(('X-016', 'The Merger - Projected Financial Information (FY2014 update note)', 38, L(1085)))\\nX.append(('X-017', 'The Merger - Financing (total funds required)', 40, L(1126) + ' ' + L(1128) + ' ' + L(1131) + ' ' + L(1134)))\\nX.append(('X-018', 'The Merger - Financing - Equity Financing (commitment letters)', 40, L(1137)))\\nX.append(('X-019', 'The Merger - Financing - Equity Financing (rollover agreement)', 41, L(1153)))\\nX.append(('X-020', 'The Merger - Financing - Equity Financing (Longview other shares)', 41, L(1165)))\\nX.append(('X-021', 'The Merger - Financing - Debt Financing (lenders)', 41, L(1167)))\\nX.append(('X-022', 'The Merger - Termination Fee Commitment Letters', 44, L(1240)))\\nX.append(('X-023', 'The Merger - Voting Support Agreement', 45, L(1258)))\\nX.append(('X-024', 'Regulatory Approvals', 52, L(1394) + ' ' + L(1397)))\\nX.append(('X-025', 'Litigation', 52, L(1399) + ' ' + L(1400)))\\nX.append(('X-026', \\\"Market Price of the Company's Common Stock\\\", 76, L(2084)))\\nX.append(('X-027', 'Security Ownership of Certain Beneficial Owners and Management', 77, L(2103) + ' ' + L(2106)))\\nX.append(('X-028', 'The Special Meeting - Solicitation of Proxies (Innisfree)', 20, L(712)))\\nX.append(('X-029', 'Summary - Record Date and Quorum', 2, L(188)))\\nX.append(('X-030', 'Letter to Stockholders (proxy statement date)', None, L(89)))\\nX.append(('X-031', 'Letter to Stockholders (transaction and consortium)', None, L(73)))\\nX.append(('X-032', 'Summary - Termination (Company termination fee)', 7, L(326)))\\n\\nSRC_ROWS = P + X\\nsrc_text = {pid: txt for pid, sec, pg, txt in SRC_ROWS}\\ndef norm(s):\\n    s = s.replace('\\\\u200b', '').replace('\\\\u200c', '').replace('\\\\u200d', '').replace('\\\\ufeff', '')\\n    s = re.sub(r'\\\\s+', ' ', s)\\n    return s\\nSRC_NORM = {pid: norm(txt) for pid, txt in src_text.items()}\\n\\n# ---------------- Ledger rows ----------------\\n# each row: dict\\nR = []\\ndef add(**kw):\\n    R.append(kw)\\n\\nD = dt.date\\nM='M'; # unused\\n\\n# 1\\nadd(when='March 2014 (discussions during Spring 2014)', who='PetSmart (management) / Industry Participant (a privately held industry participant)',\\n    what='Target interest', rnd=0, typ='',\\n    terms=(\\\"Board authorized management in March 2014 to approach Industry Participant about a possible merger with or acquisition of it; CEO David Lenhardt spoke with Industry Participant's CEO over the Spring. Industry Participant said it was not for sale and believed antitrust clearance would not be obtained, or only with unacceptable conditions. PetSmart's own acquisition attempt, not a bid in its sale process; kept as context for the later decision to exclude Industry Participant.\\\"),\\n    why=(\\\"Stated: the board used the first quarter of 2014 to consider an acquisition of another industry participant; direction is target-to-Industry Participant. \\\"\\n         \\\"\\\\u201cIn March, 2014, the board authorized management to contact Industry Participant to determine Industry Participant\\\\u2019s interest in initiating exploratory discussions concerning the feasibility of a merger or acquisition transaction.\\\\u201d \\\"\\n         \\\"\\\\u201cIndustry Participant\\\\u2019s CEO informed Mr. Lenhardt that Industry Participant was not for sale\\\\u201d. Scope is the whole of Industry Participant, not a bid for PetSmart.\\\"),\\n    src=['P-001'], page=21, from_=D(2014,3,1), to=D(2014,5,31), wd=D(2014,3,1), basis='Reported interval', method='Assigned: bound',\\n    related='R007; R010', review='', count=None,\\n    qcheck=['In March, 2014, the board authorized management to contact Industry Participant to determine Industry Participant\\\\u2019s interest in initiating exploratory discussions concerning the feasibility of a merger or acquisition transaction.',\\n            'Industry Participant\\\\u2019s CEO informed Mr. Lenhardt that Industry Participant was not for sale'])\\n\\n# 2\\nadd(when='06/18/2014', who='PetSmart board', what='Target decision', rnd=0, typ='',\\n    terms=(\\\"Board reviewed strategic and financial alternatives with a financial adviser and Wachtell Lipton; determined to explore capital-structure changes intensively, focused on returning capital to stockholders; established an ad hoc advisory subcommittee of independent directors (Gregory Josefowicz, Rakesh Gangwal, Thomas Stemberg) and authorized vetting and retention of a financial adviser. No sale decision at this meeting. R1 anchor candidate, rejected (R013).\\\"),\\n    why=(\\\"Stated: June 18, 2014 board review and governance steps; a capital-structure review, not yet a sale decision. \\\"\\n         \\\"\\\\u201cAt a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (\\\\u201cWachtell Lipton\\\\u201d), its legal advisor, the various strategic and financial alternatives potentially available to the Company\\\\u201d. \\\"\\n         \\\"Follows the 05/21/2014 weak Q1 release and late-May/June communications from stockholders and interested parties.\\\"),\\n    src=['P-002','P-003'], page=21, from_=D(2014,6,18), to=D(2014,6,18), wd=D(2014,6,18), basis='Reported day', method='Reported',\\n    related='R004; R008', review='', count=None,\\n    qcheck=['At a meeting on June 18, 2014, the board reviewed, together with a financial advisor and with Wachtell, Lipton, Rosen & Katz (\\\\u201cWachtell Lipton\\\\u201d), its legal advisor, the various strategic and financial alternatives'])\\n\\n# 3\\nadd(when='06/18/2014', who='PetSmart / Wachtell, Lipton, Rosen & Katz', what='Adviser service observed', rnd=0, typ='',\\n    terms=(\\\"Legal adviser to PetSmart, described as its legal advisor and shown acting at the June 18, 2014 board meeting and throughout the process (negotiations, merger agreement, voting agreement). Engagement date not disclosed; observed service treated as the mandate start.\\\"),\\n    why=(\\\"Stated: Wachtell Lipton is identified as PetSmart's legal advisor and present at the June 18, 2014 meeting. Engagement or retention date not disclosed, so an engagement row is not supported; earliest observed service is 06/18/2014. \\\"\\n         \\\"\\\\u201cwith Wachtell, Lipton, Rosen & Katz (\\\\u201cWachtell Lipton\\\\u201d), its legal advisor\\\\u201d.\\\"),\\n    src=['P-003'], page=21, from_=D(2014,6,18), to=D(2014,6,18), wd=D(2014,6,18), basis='Reported day', method='Reported',\\n    related='R004', review='', count=None,\\n    qcheck=['with Wachtell, Lipton, Rosen & Katz (\\\\u201cWachtell Lipton\\\\u201d), its legal advisor'])\\n\\n# 4\\nadd(when='July 2014 (engagement letter effective 08/21/2014)', who='PetSmart / J.P. Morgan Securities LLC', what='Adviser engaged', rnd=0, typ='',\\n    terms=(\\\"Engaged as PetSmart's financial adviser in July 2014 after the board interviewed several candidates; engagement letter effective 08/21/2014; scope covered a possible merger, acquisition of a majority of stock or assets. Delivered the fairness opinion (oral 12/13/2014; written 12/14/2014). Fee up to approximately $39 million, a substantial portion payable only on consummation.\\\"),\\n    why=(\\\"Stated: selection month July 2014, engagement letter effective 08/21/2014, opinion dates and contingent fee disclosed. Working date is the earliest bound of the July selection window (Assigned: bound). \\\"\\n         \\\"\\\\u201cIn July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor\\\\u201d; \\\\u201cPursuant to an engagement letter effective as of August 21, 2014, the Company retained J.P. Morgan as its financial advisor\\\\u201d; \\\\u201cFor services rendered in connection with the merger and the delivery of its opinion, the Company has agreed to pay J.P. Morgan an amount up to approximately $39 million\\\\u201d.\\\"),\\n    src=['P-003','X-012','X-014'], page=21, from_=D(2014,7,1), to=D(2014,8,21), wd=D(2014,7,1), basis='Reported interval', method='Assigned: bound',\\n    related='R003', review='', count=None,\\n    qcheck=['In July, after interviewing several potential financial advisors, the Company retained J.P. Morgan as financial advisor',\\n            'Pursuant to an engagement letter effective as of August 21, 2014, the Company retained J.P. Morgan as its financial advisor',\\n            'For services rendered in connection with the merger and the delivery of its opinion, the Company has agreed to pay J.P. Morgan an amount up to approximately $39 million'])\\n\\n# 5\\nadd(when='07/03/2014 (through August 2014)', who='JANA Partners LLC (activist stockholder)', what='Activist pressure', rnd=0, typ='',\\n    terms=(\\\"Schedule 13D disclosing a 9.9% stake and intent to discuss a review of strategic alternatives, including a sale; multiple amendments and public letters over July-August advocating a sale; met Company representatives in person on 07/10/2014 to press its views. JANA held 5,050,107 shares (5.1%) per its 01/26/2015 13D/A.\\\"),\\n    why=(\\\"Stated: JANA filed on 07/03/2014 and publicly advocated a sale; ownership per the beneficial-ownership table. \\\"\\n         \\\"\\\\u201cOn July 3, 2014, JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company\\\\u2019s outstanding common stock\\\\u201d; \\\\u201cOn July 10, 2014, representatives of JANA met in person with representatives of the Company\\\\u201d.\\\"),\\n    src=['P-004','X-027'], page=22, from_=D(2014,7,3), to=D(2014,8,29), wd=D(2014,7,3), basis='Reported interval', method='Assigned: bound',\\n    related='R006', review='', count=None,\\n    qcheck=['On July 3, 2014, JANA Partners filed a Schedule 13D with the SEC disclosing that JANA had acquired 9.9% of the Company\\\\u2019s outstanding common stock',\\n            'On July 10, 2014, representatives of JANA met in person with representatives of the Company',\\n            'JANA Partners LLC (3)  \\\\u200b 5,050,107'])\\n\\n# 6\\nadd(when='07/07/2014', who='Longview Asset Management, LLC (stockholder; later rollover supporter)', what='Activist involvement', rnd=0, typ='',\\n    terms=(\\\"Public letter to the board urging that it consider a sale (among other alternatives) and stating Longview would consider rolling part or all of its holdings into the acquirer's equity if needed to complete a transaction; Longview reiterated its advocacy in a 07/10/2014 call with the Company. In May 2014 Longview had met board members and management to present business views without advocating a specific transaction.\\\"),\\n    why=(\\\"Stated: the 07/07/2014 public letter and the rollover willingness; the May meetings are involvement without a transaction proposal. \\\"\\n         \\\"\\\\u201cLongview would consider, depending on the parties and terms involved, rolling part or all of its holdings into equity of the acquiring entity rather than receive cash consideration\\\\u201d; \\\\u201cLongview reiterated its advocacy for a sale of the Company\\\\u201d.\\\"),\\n    src=['P-002','P-004'], page=22, from_=D(2014,7,7), to=D(2014,7,7), wd=D(2014,7,7), basis='Reported day', method='Reported',\\n    related='R039; R043', review='', count=None,\\n    qcheck=['Longview would consider, depending on the parties and terms involved, rolling part or all of its holdings into equity of the acquiring entity rather than receive cash consideration',\\n            'Longview reiterated its advocacy for a sale of the Company'])\\n\\n# 7\\nadd(when='08/07/2014', who='Industry Participant (via J.P. Morgan)', what='Bidder interest', rnd=0, typ='',\\n    terms=(\\\"Unsolicited, unpriced approach: Industry Participant's representative told J.P. Morgan that if the Company pursued strategic alternatives, it might want to revisit the Spring discussions about a possible combination of the two companies; reported to the ad hoc committee. One of three strategic parties that made contact (the other two entered the 27 contacts), and the only one individually tracked.\\\"),\\n    why=(\\\"Stated: inbound call dated 08/07/2014, unpriced, reported to the ad hoc committee. \\\"\\n         \\\"\\\\u201cIndustry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies\\\\u201d.\\\"),\\n    src=['P-005'], page=22, from_=D(2014,8,7), to=D(2014,8,7), wd=D(2014,8,7), basis='Reported day', method='Reported',\\n    related='R001; R010', review='', count=None,\\n    qcheck=['Industry Participant might be interested in re-visiting the conversations that had taken place in the Spring concerning the feasibility of a possible combination of the two Companies'])\\n\\n# 8\\nadd(when='08/13/2014', who='PetSmart board', what='Target sale decision', rnd=0, typ='',\\n    terms=(\\\"Board completed its initial review and determined to explore strategic alternatives, including a possible sale, to maximize stockholder value; instructed management to plan the Profit Improvement Plan; authorized the ad hoc committee to oversee the sale exploration; planned J.P. Morgan outreach to likely buyers in the second half of September or early October and a public announcement to draw uncontacted parties. R1 anchor candidate, rejected (R013).\\\"),\\n    why=(\\\"Stated: the decision to explore a sale, the process governance, planned outreach timing and publicity authorization. \\\"\\n         \\\"\\\\u201cdetermined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders\\\\u201d. No irrevocable commitment to sell was recorded.\\\"),\\n    src=['P-006'], page=22, from_=D(2014,8,13), to=D(2014,8,13), wd=D(2014,8,13), basis='Reported day', method='Reported',\\n    related='R009; R013', review='', count=None,\\n    qcheck=['determined to explore strategic alternatives (including a possible sale of the Company) for the Company to maximize value for stockholders'])\\n\\n# 9\\nadd(when='08/19/2014', who='PetSmart', what='Sale process announced', rnd=0, typ='',\\n    terms=(\\\"Press release, concurrent with the second-quarter earnings announcement, disclosing the determination to explore strategic alternatives including a possible sale. R1 anchor candidate, rejected (R013); the announcement did not itself open a round, and the filing reports contacts coming to J.P. Morgan rather than a dated first target outreach wave.\\\"),\\n    why=(\\\"Stated: public announcement dated 08/19/2014. The board had decided a public announcement would \\\\u201censure that interested parties not contacted would become aware of the process\\\\u201d. \\\"\\n         \\\"\\\\u201cthe Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company\\\\u201d.\\\"),\\n    src=['P-006'], page=23, from_=D(2014,8,19), to=D(2014,8,19), wd=D(2014,8,19), basis='Reported day', method='Reported',\\n    related='R008; R013', review='', count=None,\\n    qcheck=['the Company issued a press release announcing that it determined to explore strategic alternatives for the Company to maximize value for stockholders, including a possible sale of the Company'])\\n\\n# 10\\nadd(when='08/27/2014 (calls also 08/22/2014)', who='PetSmart (ad hoc committee via J.P. Morgan) / Industry Participant', what='Target decision', rnd=0, typ='',\\n    terms=(\\\"Industry Participant told it would not be invited to the exploratory sale process; rationale: very high antitrust risk (likely second request, eight months to a year or more), risk of leaking competitively advantageous information, and risk of disrupting or delaying the process. J.P. Morgan added that a proposal or other communication from Industry Participant would be considered by the board; Industry Participant said it remained interested in a combination; no contact since 08/27/2014.\\\"),\\n    why=(\\\"Stated: decision and communications dated 08/22 and 08/27; Industry Participant never entered (no NDA, no bid, never admitted), so this is a Target decision, not an outcome row. \\\"\\n         \\\"\\\\u201cThe J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process, but that if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it.\\\\u201d\\\"),\\n    src=['P-006','P-007'], page=22, from_=D(2014,8,22), to=D(2014,8,27), wd=D(2014,8,27), basis='Reported interval', method='Assigned: bound',\\n    related='R001; R007; R012', review='', count=None,\\n    qcheck=['The J.P. Morgan representative stated that Industry Participant would not be invited into the exploratory process, but that if Industry Participant were to wish to submit a proposal or other communication to the Company, the board would consider it.'])\\n\\n# 11\\nadd(when='mid-August through October 2014', who='27 potential participants (3 strategic, 24 financial) via J.P. Morgan', what='Contact', rnd=0, typ='',\\n    terms=(\\\"Aggregate contact activity: J.P. Morgan was contacted by (and, for the sale process, dealt with) 27 potential participants - three strategic parties (not counting Industry Participant) and 24 financial participants, including potential lead buyers and large suppliers of equity capital to lead buyers. These contacts fed the October confidentiality-agreement wave; about 15 parties expressed interest by the 10/03/2014 board meeting.\\\"),\\n    why=(\\\"Stated: 27 individually uncounted contacts; the filing gives the type split, so no type is assigned to the cohort as a whole (contact aggregate). The board was later told \\\\u201capproximately 15 parties had expressed interest\\\\u201d. \\\"\\n         \\\"\\\\u201cJ.P. Morgan was contacted by 27 potential participants in a sale process, including three strategic parties (not counting Industry Participant) and 24 financial participants\\\\u201d.\\\"),\\n    src=['P-008','P-009'], page=23, from_=D(2014,8,15), to=D(2014,10,31), wd=D(2014,9,22), basis='Reported interval', method='Assigned: midpoint',\\n    related='R014', review='', count=27,\\n    qcheck=['J.P. Morgan was contacted by 27 potential participants in a sale process, including three strategic parties (not counting Industry Participant) and 24 financial participants',\\n            'the board was informed that approximately 15 parties had expressed interest in participating in the process'])\\n\\n# 12\\nadd(when='10/03/2014', who='PetSmart board', what='Material process update', rnd=0, typ='',\\n    terms=(\\\"Board received an update on the sale process and the Profit Improvement Plan (planning complete); informed that about 15 parties had expressed interest; reaffirmed, for the August reasons, the determination not to invite Industry Participant to participate. R1 anchor candidate, rejected (R013).\\\"),\\n    why=(\\\"Stated: board meeting and reaffirmation dated 10/03/2014. \\\"\\n         \\\"\\\\u201creaffirmed the determination not to invite Industry Participant to participate in the sale process\\\\u201d and \\\\u201capproximately 15 parties had expressed interest in participating in the process\\\\u201d.\\\"),\\n    src=['P-009'], page=23, from_=D(2014,10,3), to=D(2014,10,3), wd=D(2014,10,3), basis='Reported day', method='Reported',\\n    related='R010; R014', review='', count=None,\\n    qcheck=['reaffirmed the determination not to invite Industry Participant to participate in the sale process'])\\n\\n# 13\\nadd(when='first week of October 2014', who='PetSmart / J.P. Morgan', what='Round opened', rnd=1, typ='',\\n    terms=(\\\"R1 anchor: confidentiality-agreement wave (R014) - first target-organized step admitting participants (no dated first outreach wave is reported; contacts came to J.P. Morgan). Rejected candidate anchors: R008 (08/13 decision; planned outreach was for late September/early October, not within a week), R009 (08/19 announcement replacing outreach), R012 (10/03 board update). Objective: signed NDAs/standstills, due diligence and management presentations, then non-binding indications of interest due 10/30/2014. Round finality: Not final - preliminary non-binding stage, no final/binding announcement.\\\"),\\n    why=(\\\"Convention and stated basis: the CA wave is the first target-organized admission step; no target outreach wave is dated in the filing (J.P. Morgan \\\\u201cwas contacted by 27 potential participants\\\\u201d), so the round boundary follows the confidentiality-agreement wave under the instruction's rule 3. \\\"\\n         \\\"\\\\u201cIn the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\\\u201d.\\\"),\\n    src=['P-008','P-010'], page=23, from_=D(2014,10,1), to=D(2014,10,7), wd=D(2014,10,4), basis='Reported interval', method='Assigned: midpoint',\\n    related='R008; R009; R012; R014', review='Q1', count=None, finality='Not final',\\n    qcheck=['In the first week of October 2014, the Company entered into confidentiality and standstill agreements with 15 potentially interested financial buyers'])\\n\\n# 14\\nadd(when='first week of October 2014', who='15 potentially interested financial buyers (cohort)', what='NDA signed', rnd=1, typ='Financial',\\n    terms=(\\\"Confidentiality and standstill agreements executed with 15 financial buyers; all 15 then engaged in due diligence, received management presentations with the senior-most management and detailed financial and business-plan information including the Profit Improvement Plan. Standstills bar the signers from submitting (or seeking permission to submit) a higher bid once a definitive agreement is signed. Auction screen: met - 15 executed bidder-target confidentiality agreements covering more than one independent prospective acquiring bidder unit; no reused earlier agreements reported.\\\"),\\n    why=(\\\"Stated: 15 executed confidentiality/standstill agreements, all financial buyers, uniform October access. Auction screen assessed from these executed bidder-target contracts (adviser and rollover-holder agreements excluded and none reported). \\\"\\n         \\\"\\\\u201centered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\\\u201d; \\\\u201call 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company\\\\u2019s senior-most management, and received detailed financial and business plan information\\\\u201d.\\\"),\\n    src=['P-010','X-009'], page=23, from_=D(2014,10,1), to=D(2014,10,7), wd=D(2014,10,4), basis='Reported interval', method='Assigned: midpoint',\\n    related='R013; R015', review='Q3', count=15,\\n    qcheck=['entered into confidentiality and standstill agreements with 15 potentially interested financial buyers',\\n            'all 15 of which, during the month of October engaged in due diligence, received management presentations involving the Company\\\\u2019s senior-most management, and received detailed financial and business plan information',\\n            'the confidentiality agreements entered into by the 15 potentially interested parties that engaged in due diligence contained standstill provisions that prevent those parties from submitting (or even seeking permission to submit) a higher bid once the Company entered into a definitive transaction agreement with the winning sale process participant'])\\n\\n# 15\\nadd(when='October 2014 (day not disclosed)', who='PetSmart / J.P. Morgan', what='Deadline set', rnd=1, typ='',\\n    terms=(\\\"Potential bidders informed that non-binding preliminary indications of interest were due 10/30/2014. Bidders were also told Longview was willing to roll over up to 7.5 million shares on terms and price acceptable to it (such shares would become equity rather than receive cash), and were asked to indicate their interest in a Longview participation - expressly not a condition to participating. Communication date within October not disclosed; Working date is the window midpoint.\\\"),\\n    why=(\\\"Stated: due date 10/30/2014 and the Longview rollover notice, month only. Date basis is the October window (10/01-10/30); midpoint assigned. \\\"\\n         \\\"\\\\u201cnon-binding preliminary indications of interest would be due on October 30, 2014\\\\u201d; \\\\u201cwilling to \\\\u201croll-over\\\\u201d up to 7.5 million shares on terms and price acceptable to Longview\\\\u201d.\\\"),\\n    src=['P-011'], page=23, from_=D(2014,10,1), to=D(2014,10,30), wd=D(2014,10,15), basis='Approximate window', method='Assigned: midpoint',\\n    related='R016; R039', review='Q7', count=None, due=D(2014,10,30),\\n    qcheck=['non-binding preliminary indications of interest would be due on October 30, 2014',\\n            'willing to \\\\u201croll-over\\\\u201d up to 7.5 million shares on terms and price acceptable to Longview'])\\n\\n# 16\\nadd(when='10/30/2014', who='PetSmart / 15 NDA signers', what='Deadline', rnd=1, typ='',\\n    terms=(\\\"IOI due date reached; six of the potentially interested parties submitted. J.P. Morgan then called all potential bidders, submitters and non-submitters alike, to hear price rationales and reasons for not submitting. The board advanced bidders at its 11/03/2014 meeting on the bids in hand - no extension and no late-bid acceptance.\\\"),\\n    why=(\\\"Stated: submissions on the due date and the follow-up calls; next step was the 11/03 board decision. Deadline treatment Enforced (target took its next step without an extension). \\\"\\n         \\\"\\\\u201cOn October 30, six of the potentially interested parties submitted indications of interest. From October 30 to November 2, 2014, representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest\\\\u201d.\\\"),\\n    src=['P-012','P-013'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\\n    related='R011; R014; R023', review='Q2', count=None, due=D(2014,10,30), treatment='Enforced',\\n    qcheck=['On October 30, six of the potentially interested parties submitted indications of interest. From October 30 to November 2, 2014, representatives of J.P. Morgan spoke by telephone with all of the potentially interested parties, including those that did not submit an indication of interest'])\\n\\n# 17\\nadd(when='10/30/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=1, typ='Financial',\\n    terms=(\\\"Non-binding preliminary indication of interest: $81.00-$83.00 per share (range later superseded). One of three bidders initially at or above $80.00; one of six IOI submitters. No price revision. Final-round units after 11/03 are tracked separately.\\\"),\\n    why=(\\\"Stated: submitted 10/30/2014 with the $81.00-$83.00 range. Formality Informal - a preliminary non-binding IOI with no formal signal (no returned agreement, no final-stage response). Conditions Insufficient evidence: price known, financing/diligence conditions not described, and the stage itself (pre-final-round IOI after October diligence access) does not supply them; preferred reading is that no substantive condition was stated. \\\"\\n         \\\"\\\\u201cthe Buyer Group, which indicated a range of $81.00 to $83.00 per share\\\\u201d.\\\"),\\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\\n    related='R014; R030; R037', review='Q6', count=1,\\n    formality='Informal', cond='Insufficient evidence',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\\n    p_low=81.0, p_high=83.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\\n    qcheck=['the Buyer Group, which indicated a range of $81.00 to $83.00 per share'])\\n\\n# 18\\nadd(when='10/30/2014', who='Unnamed financial bidder 1 (suggested $80.00-$85.00)', what='Bid', rnd=1, typ='Financial',\\n    terms=(\\\"Non-binding preliminary indication of interest: $80.00-$85.00 per share. Individually distinguishable only by this price detail; one of the three bidders initially at or above $80.00 and among the four that advanced on 11/03/2014. Later path not individually identified - see R025 and the identity question Q5; no separate exit row is invented.\\\"),\\n    why=(\\\"Stated: a distinct submitter described only by its range; included as an individual row so the remaining cohort is disjoint. Formality Informal (preliminary IOI, no formal signal); Conditions Insufficient evidence for the same reasons as R017. \\\"\\n         \\\"\\\\u201canother bidder, which suggested a range of $80.00 to $85.00 per share\\\\u201d.\\\"),\\n    src=['P-012','P-013'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\\n    related='R020; R025; R034', review='Q3; Q5', count=1,\\n    formality='Informal', cond='Insufficient evidence',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\\n    p_low=80.0, p_high=85.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\\n    qcheck=['another bidder, which suggested a range of $80.00 to $85.00 per share'])\\n\\n# 19\\nadd(when='10/30/2014', who='Bidder 2', what='Bid', rnd=1, typ='Financial',\\n    terms=(\\\"Non-binding preliminary indication of interest: $78.00 per share (submitted level), raised to $81.00-$84.00 during J.P. Morgan's follow-up calls (recorded at R022). Bidder type inferred from the cohort: all 15 NDA signers were financial buyers.\\\"),\\n    why=(\\\"Stated: initial price $78.00 on 10/30/2014. Formality Informal (preliminary IOI, no formal signal); Conditions Insufficient evidence. \\\"\\n         \\\"\\\\u201cBidder 2, which had initially indicated a price of $78.00\\\\u201d.\\\"),\\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\\n    related='R022', review='Q6', count=1,\\n    formality='Informal', cond='Insufficient evidence',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\\n    p_low=78.0, p_high=78.0, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Not stated',\\n    qcheck=['Bidder 2, which had initially indicated a price of $78.00'])\\n\\n# 20\\nadd(when='10/30/2014', who='3 remaining IOI submitters (cohort)', what='Bid', rnd=1, typ='Financial',\\n    terms=(\\\"Disjoint residual cohort: 6 IOI submitters minus the three individually recorded (Buyer Group, R017; Unnamed financial bidder 1, R018; Bidder 2, R019) = 3 remaining submitters. By count these comprise the third bidder that initially indicated at or above $80.00 (no individual price or name disclosed) and two submitters whose prices were below the final-round threshold. Prices not disclosed for the cohort; no endpoints invented.\\\"),\\n    why=(\\\"Calculated: 6 - 3 individually recorded submitters = 3, per the instruction's disjoint-residual rule; the filing's three-bidder disclosure at or above $80.00 is the only individual content, kept in Terms. Formality Informal and Conditions Insufficient evidence for the same preliminary-IOI reasons as R017. \\\"\\n         \\\"\\\\u201cThree bidders initially indicated price ranges that reached at least $80.00 per share\\\\u201d.\\\"),\\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Reported',\\n    related='R017; R018; R019; R024', review='Q3; Q4', count=3,\\n    formality='Informal', cond='Insufficient evidence',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\\n    p_kind='Undisclosed', currency='USD', all_cash='Not stated',\\n    qcheck=['Three bidders initially indicated price ranges that reached at least $80.00 per share'])\\n\\n# 21\\nadd(when='by 10/30/2014', who='9 remaining NDA signers (unnamed cohort)', what='Did not submit', rnd=1, typ='Financial',\\n    terms=(\\\"Inferred: residual - 15 NDA signers \\\\u2212 6 IOI submitters = 9 non-submitters. J.P. Morgan called all potential bidders including non-submitters on 10/30-11/02 to hear their reasons, so the filing accounts for their non-participation. No decision date, motive, identity or permanent withdrawal is inferred; a non-submitter may appear again in a later stage only with a Re-entered row.\\\"),\\n    why=(\\\"Convention (inferred closing row): the base is the stated 15 executed confidentiality/standstill agreements; six submitters are accounted for at the 10/30/2014 deadline. \\\"\\n         \\\"\\\\u201cOn October 30, six of the potentially interested parties submitted indications of interest\\\\u201d; \\\\u201centered into confidentiality and standstill agreements with 15 potentially interested financial buyers\\\\u201d. Non-submission does not establish bidder agency, so Decided by is Unknown.\\\"),\\n    src=['P-012','P-010'], page=24, from_=None, to=D(2014,10,30), wd=D(2014,10,30), basis='Reported day', method='Assigned: deadline',\\n    related='R014; R016; R020', review='Q4', count=9,\\n    decided='Unknown', exit_reason='Not stated', outcome_basis='Inferred: residual',\\n    qcheck=['On October 30, six of the potentially interested parties submitted indications of interest',\\n            'entered into confidentiality and standstill agreements with 15 potentially interested financial buyers'])\\n\\n# 22\\nadd(when='by 11/02/2014 (calls 10/30-11/02/2014)', who='Bidder 2', what='Bid', rnd=1, typ='Financial',\\n    terms=(\\\"Revised indication: $81.00-$84.00 per share, raised from $78.00 as a result of J.P. Morgan's follow-up calls. This made Bidder 2 the fourth bidder at or above $80.00 and eligible for the final round. Same-round revision of R019; Count 0 because the same bidder unit is already recorded in R1.\\\"),\\n    why=(\\\"Stated: revision and cause; price range endpoints. Formality Informal (still a preliminary non-binding indication, no formal signal); Conditions Insufficient evidence. \\\"\\n         \\\"\\\\u201cincreased its indication to a range of $81.00 to $84.00 per share\\\\u201d.\\\"),\\n    src=['P-012'], page=24, from_=D(2014,10,30), to=D(2014,11,2), wd=D(2014,10,31), basis='Reported interval', method='Assigned: midpoint',\\n    related='revises R019', review='Q7', count=0,\\n    formality='Informal', cond='Insufficient evidence',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: yes; Excl: not stated',\\n    p_low=81.0, p_high=84.0, p_kind='Bidder range', p_origin='Stated', currency='USD', all_cash='Not stated',\\n    qcheck=['increased its indication to a range of $81.00 to $84.00 per share'])\\n\\n# 23\\nadd(when='11/03/2014', who='PetSmart board / J.P. Morgan', what='Round opened', rnd=2, typ='',\\n    terms=(\\\"R2: board allowed the four bidders that had indicated a price or range at or above $80.00 to proceed to the final round - Buyer Group, Bidder 2 and two unnamed bidders (later combined as Bidder 3, R025); J.P. Morgan notified the eliminated parties. Objective: final-round diligence and management presentations, draft merger agreement, and updated offers. Round finality: Inferred final - no binding/best-and-final announcement at the opening, but the target advanced the field toward definitive documentation; the final-bid solicitation itself opens R3.\\\"),\\n    why=(\\\"Stated: advancement decision, threshold, and the notification. Finality assessed as Inferred: the filing calls the stage the final round and the Company circulated a merger agreement in November, but no binding-stage announcement is dated at the opening. \\\"\\n         \\\"\\\\u201cdetermined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process\\\\u201d.\\\"),\\n    src=['P-013'], page=24, from_=D(2014,11,3), to=D(2014,11,3), wd=D(2014,11,3), basis='Reported day', method='Reported',\\n    related='R017; R019; R022; R025; R026', review='Q1', count=None, finality='Inferred final',\\n    qcheck=['determined to allow the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round of the sale process'])\\n\\n# 24\\nadd(when='by 11/03/2014', who='2 eliminated IOI submitters (unnamed cohort)', what='Dropped by target', rnd=2, typ='Financial',\\n    terms=(\\\"Inferred: residual - 6 IOI submitters \\\\u2212 4 advancing at or above $80.00 = 2 eliminated submitters, being the two members of R020 whose indications did not reach the threshold (the third member advanced within the unnamed finalists). J.P. Morgan notified the eliminated parties; none indicated any interest or ability to remain above its initial indications. Exclusion from the final round only; no motive or identity inferred.\\\"),\\n    why=(\\\"Stated: notification of elimination after the 11/03/2014 board meeting; the number is the arithmetic residual. The two members are identified only by count within R020, so no identity is assigned. \\\"\\n         \\\"\\\\u201crepresentatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications\\\\u201d.\\\"),\\n    src=['P-013'], page=24, from_=None, to=D(2014,11,3), wd=D(2014,11,3), basis='Inferred day', method='Assigned: decision day',\\n    related='R020; R023', review='Q4', count=2,\\n    decided='Target', exit_reason='Lower offer than rivals', outcome_basis='Inferred: residual',\\n    qcheck=['representatives of J.P. Morgan notified the eliminated parties, none of which indicated any interest or ability to remain in the process at price levels above their respective initial indications'])\\n\\n# 25\\nadd(when='after 11/03/2014 (day not disclosed)', who='Bidder 3 (two of the four final-round bidders)', what='Bidding group changed', rnd=2, typ='Financial',\\n    terms=(\\\"Formation: two final-round bidders authorized to work together as \\\\u201cBidder 3\\\\u201d after one sought an equity partner given the size of an acquisition of PetSmart and the other had said it would drop out if not permitted to team; both had worked together successfully on prior large leveraged buyouts. Bidding units 4 \\\\u2192 3 (\\\\u201cunits \\\\u22121\\\\u201d); both members are unnamed, so the unit count falls without individual identity rows. All admitted bidders had indicated some interest in a Longview rollover, none made it a condition.\\\"),\\n    why=(\\\"Stated: authorization by the ad hoc committee after the 11/03/2014 meeting; membership not individually identified by the filing, so the row states the unit effect by number under the instruction's anonymous-cohort convention. \\\"\\n         \\\"\\\\u201cAfter deliberation and consultation with the Company\\\\u2019s financial and legal advisors, the ad hoc committee authorized these two bidders to work together.\\\\u201d; \\\\u201cWe refer to these two bidders together as \\\\u201cBidder 3.\\\\u201d\\\\u201d.\\\"),\\n    src=['P-014'], page=24, from_=D(2014,11,3), to=None, wd=D(2014,11,3), basis='Relative only', method='Assigned: bound',\\n    related='R023; R033', review='Q5', count=2,\\n    qcheck=['After deliberation and consultation with the Company\\\\u2019s financial and legal advisors, the ad hoc committee authorized these two bidders to work together.',\\n            'We refer to these two bidders together as \\\\u201cBidder 3.\\\\u201d'])\\n\\n# 26\\nadd(when='November 2014 (day not disclosed)', who='PetSmart / Wachtell Lipton / final-round bidders', what='Round opened', rnd=3, typ='',\\n    terms=(\\\"R3: Company circulated a form of merger agreement instructing bidders to submit proposed comments together with their final bids; the bid date was initially Friday 12/05/2014. Objective: obtain final bids and executable documentation from the three final-round bidding units. Round finality: Announced as final - bids were solicited as \\\\u201cfinal bids\\\\u201d; the 12/04-05 and 12/10-12 events are deadline revisions inside this round, not new rounds.\\\"),\\n    why=(\\\"Stated: November circulation and final-bid instruction; initial 12/05 date. The first request for final offers opens this round under the instruction's round rule, even though the invited set is unchanged. \\\"\\n         \\\"\\\\u201cthe Company circulated a form of merger agreement to the bidders with instructions that the bidders submit any proposed comments on the merger agreement together with their final bids\\\\u201d; \\\\u201chad initially set Friday, December 5 as the date for submission of bids\\\\u201d.\\\"),\\n    src=['P-015','P-016'], page=24, from_=D(2014,11,1), to=D(2014,11,30), wd=D(2014,11,15), basis='Approximate window', method='Assigned: midpoint',\\n    related='R023; R025; R028', review='Q1; Q7', count=None, due=D(2014,12,5), finality='Announced as final',\\n    qcheck=['the Company circulated a form of merger agreement to the bidders with instructions that the bidders submit any proposed comments on the merger agreement together with their final bids',\\n            'had initially set Friday, December 5 as the date for submission of bids'])\\n\\n# 27\\nadd(when='November 2014 (following the Q3 earnings release)', who='All final-round bidders / J.P. Morgan', what='Information access changed', rnd=3, typ='',\\n    terms=(\\\"Projections revised after bidding began: after the third-quarter earnings release, at bidders' request and the board's direction, J.P. Morgan provided the bidders with updates to the fiscal-year-2014 projections to reflect actual performance and better visibility on the Profit Improvement Plan (FY2014E revenue $7,081M vs $7,088M before; EBITDA $967M vs $958M; net income $445M vs $432M; cash flow from operations unchanged at $617M). The FY2020-24 extrapolations and J.P. Morgan's downside sensitivities were not provided to bidders - see Summary comparability.\\\"),\\n    why=(\\\"Stated: revision and recipients; the update note gives before/after figures. A projection revision after bidding began is recorded as an information-access change; the same update went to all final-round bidders, so it is not a differentiated-access row. \\\"\\n         \\\"\\\\u201cFollowing the Company\\\\u2019s third quarter earnings announcement and, at the request of bidders and the direction of the board and the Company, representatives of J.P. Morgan provided the bidders with updates to the Company\\\\u2019s fiscal year 2014 financial projections.\\\\u201d\\\"),\\n    src=['P-015','X-015','X-016'], page=37, from_=D(2014,11,1), to=D(2014,11,30), wd=D(2014,11,15), basis='Approximate window', method='Assigned: midpoint',\\n    related='R026', review='Q7', count=None,\\n    qcheck=['Following the Company\\\\u2019s third quarter earnings announcement and, at the request of bidders and the direction of the board and the Company, representatives of J.P. Morgan provided the bidders with updates to the Company\\\\u2019s fiscal year 2014 financial projections.',\\n            'projected revenue was $7,088 million, projected EBITDA was $958 million and projected net income was $432 million'])\\n\\n# 28\\nadd(when='12/04/2014-12/05/2014', who='PetSmart ad hoc committee', what='Deadline revised', rnd=3, typ='',\\n    terms=(\\\"Ad hoc committee, after consulting the Company's financial and legal advisers, replaced the initial 12/05/2014 bid date with the evening of 12/10/2014 (five days rather than ten before the anticipated 12/15/2014 completion), so the process could finish sooner and reduce the risk of leaks or unintended public disclosure; bidders were simultaneously asked to submit mark-ups of the draft merger agreement and other transaction documents and financing commitments, if possible, in advance. Old due date 12/05/2014 (superseded before arrival; no milestone row); new due date 12/10/2014. Deadline treatment records what followed 12/10/2014 (extended at R035).\\\"),\\n    why=(\\\"Stated: the two-day committee decision, the reason and both dates. Working date is the last day of the decision span (Assigned: decision day). \\\"\\n         \\\"\\\\u201cthe ad hoc committee concluded that these matters could be accomplished in a shorter period of time, which would reduce the risk of leaks or unintended public disclosure.\\\\u201d; \\\\u201cAccordingly, the Company set the evening of Wednesday, December 10\\\\u201d.\\\"),\\n    src=['P-016'], page=24, from_=D(2014,12,4), to=D(2014,12,5), wd=D(2014,12,5), basis='Reported interval', method='Assigned: decision day',\\n    related='R026; R029', review='Q2', count=None, due=D(2014,12,10), treatment='Extended',\\n    qcheck=['the ad hoc committee concluded that these matters could be accomplished in a shorter period of time, which would reduce the risk of leaks or unintended public disclosure.',\\n            'Accordingly, the Company set the evening of Wednesday, December 10'])\\n\\n# 29\\nadd(when='12/10/2014', who='PetSmart / final-round bidders', what='Deadline', rnd=3, typ='',\\n    terms=(\\\"Final-bid deadline reached: Buyer Group and Bidder 2 submitted final bid letters with revised merger agreement and transaction documents, and Bidder 3 gave a verbal indication (R030-R033). The same evening the ad hoc committee instructed improved bids by 12/12/2014 (R035) - this due date was extended, with no late-bid acceptance issue.\\\"),\\n    why=(\\\"Stated: bids received on the date; extension decided that evening. Deadline treatment Extended because a Deadline revised row (R035) moved this date. \\\"\\n         \\\"\\\\u201cOn December 10, PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 and a verbal indication from Bidder 3.\\\\u201d\\\"),\\n    src=['P-020','P-021'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\\n    related='R028; R035', review='Q2', count=None, due=D(2014,12,10), treatment='Extended',\\n    qcheck=['On December 10, PetSmart received final bid letters along with revised versions of the merger agreement and other transaction documents from the Buyer Group and from Bidder 2 and a verbal indication from Bidder 3.'])\\n\\n# 30\\nadd(when='12/10/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=3, typ='Financial',\\n    terms=(\\\"Final bid: $80.70 per share, in cash; final bid letter and revised merger agreement and other transaction documents, which were more favorable to the Company (less conditional, more likely to be completed, more certainty of protection) and reflected substantially more acceptance of the Company's positions than Bidder 2's. Financing commitment documents had been provided 12/06/2014. Bid not dependent on a Longview rollover, though partnering was not ruled out. Revised at R037.\\\"),\\n    why=(\\\"Stated: price and cash form; documentation and financing facts. Formality Formal - signal 1 (bidder-returned acquisition agreement and transaction documents, substantially executable) plus the requested final-bid response. Conditions Light - no Heavy trigger; committed financing documented; remaining matters were final documentation (board approval on 12/13 was subject to resolving open points). \\\"\\n         \\\"\\\\u201cThe Buyer Group offered $80.70 per share, in cash, and Bidder 2 offered $80.35 per share, in cash.\\\\u201d; \\\\u201cThe form of merger agreement and other transaction documentation submitted by the Buyer Group were more favorable to the Company\\\\u201d.\\\"),\\n    src=['P-017','P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\\n    related='R017; R028; R037', review='Q6', count=1,\\n    formality='Formal', cond='Light',\\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\\n    p_low=80.70, p_high=80.70, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\\n    qcheck=['The Buyer Group offered $80.70 per share, in cash, and Bidder 2 offered $80.35 per share, in cash.',\\n            'The form of merger agreement and other transaction documentation submitted by the Buyer Group were more favorable to the Company'])\\n\\n# 31\\nadd(when='12/10/2014', who='Bidder 2', what='Bid', rnd=3, typ='Financial',\\n    terms=(\\\"Final bid: $80.35 per share, in cash; final bid letter and revised merger agreement and transaction documents. Bid not dependent on a Longview rollover; Bidder 2 said any partnering with Longview would occur only after signing a merger agreement. Financing commitment documents were provided with its 12/12 revision (R038). Revised at R038.\\\"),\\n    why=(\\\"Stated: price and cash form; documentation; rollover position. Formality Formal - revised acquisition agreement and transaction documents submitted with the final-bid response. Conditions Light - no Heavy trigger; treat as subject to final documentation; financing not stated at this date (silence neither raises nor lowers; documents followed on 12/12). \\\"\\n         \\\"\\\\u201cBidder 2 offered $80.35 per share, in cash\\\\u201d; \\\\u201ceach bidder indicated that its bid was not dependent on a rollover by Longview\\\\u201d.\\\"),\\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\\n    related='R022; R029; R038', review='Q6', count=1,\\n    formality='Formal', cond='Light',\\n    cond_detail='Fin: not stated; DD required: not stated; DD open: no; Excl: not stated',\\n    p_low=80.35, p_high=80.35, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\\n    qcheck=['Bidder 2 offered $80.35 per share, in cash',\\n            'each bidder indicated that its bid was not dependent on a rollover by Longview'])\\n\\n# 32\\nadd(when='12/10/2014', who='Bidder 3', what='Valuation statement', rnd=3, typ='Financial',\\n    terms=(\\\"Verbal indication in response to the final-bid solicitation: Bidder 3's valuation would not be above the then-current stock price of approximately $78.00 per share. A communicated valuation ceiling, not a bid for the bid-price cells; the non-submission is recorded at R033.\\\"),\\n    why=(\\\"Stated: the valuation statement and the comparison, on the final-bid date. Treated as a valuation statement (no offer made; the filing's price reference is the market price) so per-share cells are left blank and the value stays in text. \\\"\\n         \\\"\\\\u201cBidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share.\\\\u201d\\\"),\\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\\n    related='R025; R033', review='Q6', count=None,\\n    qcheck=['Bidder 3 verbally communicated to J.P. Morgan that their valuation would not be above the current stock price of approximately $78 per share.'])\\n\\n# 33\\nadd(when='12/10/2014', who='Bidder 3', what='Did not submit', rnd=3, typ='Financial',\\n    terms=(\\\"No written final offer: after J.P. Morgan told Bidder 3 its indication was unlikely to be competitive, it submitted no written offer. Its communicated valuation was at or below the ~$78.00 market price and below the $80.70/$80.35 rival bids. The combined unit is closed here; a written submission did not occur in this solicitation.\\\"),\\n    why=(\\\"Stated: non-submission and the discouraging communication. Decided by Both - target discouragement followed by non-participation (mixed mechanism). Exit reason Value at or below market price (benchmark: current stock price ~$78; also below rivals, preserved in text). \\\"\\n         \\\"\\\\u201cJ.P. Morgan communicated to Bidder 3 that it was unlikely to be competitive and accordingly Bidder 3 did not submit a written offer.\\\\u201d\\\"),\\n    src=['P-020'], page=25, from_=D(2014,12,10), to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Reported',\\n    related='R032; R025', review='Q4; Q5', count=1,\\n    decided='Both', exit_reason='Value at or below market price', outcome_basis='Stated',\\n    qcheck=['J.P. Morgan communicated to Bidder 3 that it was unlikely to be competitive and accordingly Bidder 3 did not submit a written offer.'])\\n\\n# 34\\nadd(when='by 12/10/2014', who='Unnamed financial bidder 1 (suggested $80.00-$85.00)', what='Did not submit', rnd=3, typ='Financial',\\n    terms=(\\\"Inferred: identity - last individually observed advancing to the final round on 11/03/2014 (R018); not mentioned again. It may be one of the two unnamed finalists that combined as Bidder 3 (R025) and be closed by R033; alternatively its exit is already inside the anonymous final-round units. Count 0: no count moves from a cohort to a name on this basis. See Q5.\\\"),\\n    why=(\\\"Convention (Count-0 identity row): the filing never mentions this submitter again after the advancement, and the two anonymous finalists absorbed two of the four advancing units. Recommended reading: within the Bidder 3 unit closed at R033. \\\"\\n         \\\"\\\\u201canother bidder, which suggested a range of $80.00 to $85.00 per share\\\\u201d; \\\\u201cthe four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round\\\\u201d.\\\"),\\n    src=['P-012','P-013','P-014'], page=24, from_=None, to=D(2014,12,10), wd=D(2014,12,10), basis='Reported day', method='Assigned: decision day',\\n    related='R018; R025; R033', review='Q4; Q5', count=0,\\n    decided='Both', exit_reason='Value at or below market price', outcome_basis='Inferred: identity',\\n    qcheck=['another bidder, which suggested a range of $80.00 to $85.00 per share',\\n            'the four bidders that had indicated a price or range at or above $80.00 per share to proceed to the final round'])\\n\\n# 35\\nadd(when='12/10/2014', who='PetSmart ad hoc committee / J.P. Morgan', what='Deadline revised', rnd=3, typ='',\\n    terms=(\\\"After receiving the 12/10 bids, the ad hoc committee found there could be no assurance the board would approve either bid unless improved, citing the closeness of the bids, positive developments from the 12/03/2014 board meeting and the shared view that neither bid was the bidder's best; J.P. Morgan was instructed to require increased bids due 12/12/2014. On the evening of 12/11/2014 J.P. Morgan also confirmed Longview's continued interest in rolling over shares, subject to approval. Old due date 12/10/2014 (extended at R029); new due date 12/12/2014. Deadline treatment records what followed 12/12/2014 (enforced at R036).\\\"),\\n    why=(\\\"Stated: instruction and new date; reason and the 12/11 Longview call. Working date is the reported decision day. \\\"\\n         \\\"\\\\u201cthe ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014.\\\\u201d\\\"),\\n    src=['P-021'], page=25, from_=D(2014,12,10), to=D(2014,12,11), wd=D(2014,12,10), basis='Reported interval', method='Assigned: decision day',\\n    related='R029; R036', review='Q2', count=None, due=D(2014,12,12), treatment='Enforced',\\n    qcheck=['the ad hoc committee instructed J.P. Morgan to inform each bidder that it would need to increase its bid, and to instruct the bidders to submit improved bids on December 12, 2014.'])\\n\\n# 36\\nadd(when='12/12/2014', who='PetSmart / final-round bidders', what='Deadline', rnd=3, typ='',\\n    terms=(\\\"Improved-bid deadline reached: Buyer Group and Bidder 2 submitted best-and-final offers with revised drafts and financing commitment documents (R037, R038). The board met on 12/13/2014 and acted on the bids in hand - enforced, with no further extension.\\\"),\\n    why=(\\\"Stated: submissions on 12/12/2014 and the board meeting the next day. Deadline treatment Enforced. \\\"\\n         \\\"\\\\u201ceach bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents\\\\u201d.\\\"),\\n    src=['P-023','P-024'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\\n    related='R035; R037; R038', review='Q2', count=None, due=D(2014,12,12), treatment='Enforced',\\n    qcheck=['each bidder submitted a revised draft of the merger agreement and other transaction agreements, and copies of their respective financing commitment documents'])\\n\\n# 37\\nadd(when='12/12/2014', who='Buyer Group (BC Partners-led consortium)', what='Bid', rnd=3, typ='Financial',\\n    terms=(\\\"Support: Longview (rollover) - best and final offer of $83.00 per share, in cash, after an initial oral $82.50 the same evening that the Buyer Group said it was working to increase within hours. Revised merger agreement and transaction agreements in substantially executable form and financing commitment documents submitted; members of the group unwilling or unable to offer more. Longview's willingness to participate with respect to $250 million of common stock was helpful in achieving $83.00. Revises R030.\\\"),\\n    why=(\\\"Stated: price and progression, documentation, and the Longview contribution's role. Formality Formal - signal 1 (substantially executable revised acquisition documents) confirmed by an actual best-and-final price; Conditions Light - committed financing documented and remaining matters were final documentation. \\\"\\n         \\\"\\\\u201cLater in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash.\\\\u201d; \\\\u201cLongview\\\\u2019s willingness to participate in the Buyer Group with respect to $250 million of the common stock was helpful in achieving an $83.00 per share price.\\\\u201d\\\"),\\n    src=['P-023','X-008','X-011'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\\n    related='R030; R039', review='Q6', count=0,\\n    formality='Formal', cond='Light',\\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\\n    p_low=83.0, p_high=83.0, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\\n    qcheck=['Later in the evening, the Buyer Group submitted a best and final offer of $83.00 per share, in cash.',\\n            'Longview\\\\u2019s willingness to participate in the Buyer Group with respect to $250 million of the common stock was helpful in achieving an $83.00 per share price.',\\n            'initially submitted an oral offer of $82.50 per share, in cash'])\\n\\n# 38\\nadd(when='12/12/2014', who='Bidder 2', what='Bid', rnd=3, typ='Financial',\\n    terms=(\\\"Best and final offer: $81.50 per share, in cash; J.P. Morgan confirmed by telephone that evening that it was Bidder 2's best and final. Revised draft and financing commitment documents submitted; any Longview accommodation would not affect its price. Revises R031.\\\"),\\n    why=(\\\"Stated: price, confirmation and documentation. Formality Formal - signal 1 (revised acquisition documents) and signal 3 (actual price confirmation during finalization); Conditions Light - committed financing documented with the revision and remaining matters were final documentation. \\\"\\n         \\\"\\\\u201cDuring the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash.\\\\u201d; \\\\u201cRepresentatives of J.P. Morgan confirmed via a conversation with Bidder 2 on the evening of December 12, 2014 that $81.50 per share was its best and final offer.\\\\u201d\\\"),\\n    src=['P-023'], page=26, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\\n    related='R031; R044', review='Q6', count=0,\\n    formality='Formal', cond='Light',\\n    cond_detail='Fin: committed; DD required: not stated; DD open: no; Excl: not stated',\\n    p_low=81.50, p_high=81.50, p_kind='Point', p_origin='Stated', currency='USD', all_cash='Yes',\\n    qcheck=['During the evening of December 12, 2014, Bidder 2 submitted an offer of $81.50 per share, in cash.',\\n            'Representatives of J.P. Morgan confirmed via a conversation with Bidder 2 on the evening of December 12, 2014 that $81.50 per share was its best and final offer.'])\\n\\n# 39\\nadd(when='12/12/2014', who='PetSmart ad hoc committee / Buyer Group / Longview', what='Material process update', rnd=3, typ='',\\n    terms=(\\\"Permitted: the ad hoc committee approved the Buyer Group's request to work more closely with Longview and include a rollover of Longview-managed shares in its bid, after the 12/09/2014 introductory meetings J.P. Morgan arranged between Longview and each of the Buyer Group and Bidder 2. Longview and the Buyer Group then signed a confidentiality agreement permitting exchange of detailed information including bid price, which had not previously been shared with Longview; Wachtell Lipton was instructed to provide a form of voting agreement to Longview. Bidder 2 declined any price effect and would consider Longview only after signing. Resolution recorded at R043.\\\"),\\n    why=(\\\"Stated: request, approval, confidentiality agreement and voting-agreement instruction, all on 12/12/2014. One of the two permitted rows for the rollover relationship; support is not treated as a bidding-group membership change or a new NDA by a bidder for the auction screen. \\\"\\n         \\\"\\\\u201cthe ad hoc committee approved the Buyer Group\\\\u2019s request, and, later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price\\\\u201d.\\\"),\\n    src=['P-019','P-022'], page=25, from_=D(2014,12,12), to=D(2014,12,12), wd=D(2014,12,12), basis='Reported day', method='Reported',\\n    related='R037; R043', review='Q8', count=None,\\n    qcheck=['the ad hoc committee approved the Buyer Group\\\\u2019s request, and, later that day, Longview and the Buyer Group entered into a confidentiality agreement permitting the exchange of detailed information between them, including bid price'])\\n\\n# 40\\nadd(when='12/13/2014', who='PetSmart board', what='Target decision', rnd=3, typ='',\\n    terms=(\\\"Board unanimously determined the merger agreement and the merger advisable and in the best interests of PetSmart and its stockholders and resolved to recommend adoption; the determination was subject to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved. J.P. Morgan delivered its oral fairness opinion on the $83.00 consideration (written opinion the next day); the board would reconvene if needed.\\\"),\\n    why=(\\\"Stated: approval, qualification and opinion timing. Selection of the Buyer Group is reflected here and in the signing row; separate from the round opening. \\\"\\n         \\\"\\\\u201cthe board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders\\\\u201d; \\\\u201csubject, however, to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved\\\\u201d.\\\"),\\n    src=['P-024','X-013'], page=26, from_=D(2014,12,13), to=D(2014,12,13), wd=D(2014,12,13), basis='Reported day', method='Reported',\\n    related='R041; R042', review='', count=None,\\n    qcheck=['the board unanimously determined that the merger agreement and the transactions contemplated thereby, including the merger, were advisable and in the best interests of PetSmart and its stockholders',\\n            'subject, however, to confirmation that the remaining open points in the merger agreement had been satisfactorily resolved'])\\n\\n# 41\\nadd(when='12/14/2014', who='PetSmart / Argos Holdings Inc. (Parent) / Argos Merger Sub Inc.', what='Merger agreement signed', rnd=3, typ='',\\n    terms=(\\\"Executed the Agreement and Plan of Merger dated 12/14/2014: each outstanding share converts into the right to receive $83.00 in cash at the effective time; Company termination fee $255 million for a superior-proposal termination and Parent reverse termination fee $510 million in specified financing-failure cases; closing conditioned on stockholder adoption, antitrust clearances and no prohibitory order, with an outside date of 06/14/2015. Signing is not a bid: bid-price and formality/conditionality cells are left blank (agreed consideration appears in Cash at closing).\\\"),\\n    why=(\\\"Stated: execution, consideration and payment form; fee framework and closing conditions. \\\"\\n         \\\"\\\\u201cOn December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction.\\\\u201d\\\"),\\n    src=['P-025','X-004','X-022','X-032'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\\n    related='R040; R042; R043; R044', review='', count=None,\\n    cash_close=83.0, currency='USD', all_cash='Yes',\\n    qcheck=['On December 14, 2014, the parties executed the merger agreement, the voting agreement and related transaction agreements and issued a press release announcing the transaction.'])\\n\\n# 42\\nadd(when='12/14/2014', who='PetSmart / Parent', what='Merger announced', rnd=3, typ='',\\n    terms=(\\\"Press release announcing the transaction, issued concurrently with execution. No go-shop was provided; the 15 NDA signers' standstill provisions bar them from submitting or seeking permission to submit a higher bid after a definitive agreement; as of 02/02/2015 no person had made an unsolicited offer or proposal to acquire PetSmart. Public disclosure of the signed deal is distinct from signing.\\\"),\\n    why=(\\\"Stated: announcement and the absence of post-signing proposals to the proxy date; standstills preserved as the stated mechanism. \\\"\\n         \\\"\\\\u201cas of February 2, 2015, the date of this proxy statement, no person has made an unsolicited offer or proposal to acquire PetSmart\\\\u201d.\\\"),\\n    src=['P-025','X-009','X-010'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\\n    related='R041', review='', count=None,\\n    qcheck=['as of February 2, 2015, the date of this proxy statement, no person has made an unsolicited offer or proposal to acquire PetSmart'])\\n\\n# 43\\nadd(when='12/14/2014', who='Longview / Parent', what='Material process update', rnd=3, typ='',\\n    terms=(\\\"Resolved: rollover agreement executed under which Longview contributes 3,012,050 shares (about $250 million at $83.00) to Parent immediately before the effective time in exchange for equity interests in Parent; the Company is an express third-party beneficiary. Longview enters the \\\\u201cBuyer Group\\\\u201d definition from 12/12/2014 onward; its remaining shares receive the same $83.00 cash consideration. A rolling-over shareholder admitted to the buyer vehicle is not a bidding-group membership change.\\\"),\\n    why=(\\\"Stated: agreement, share count and treatment of other shares. The second permitted row for the rollover relationship (permitted at R039, resolved here); no new bidder NDA or bid is created. \\\"\\n         \\\"\\\\u201cLongview has agreed to contribute 3,012,050 shares (\\\\u201crollover shares\\\\u201d) to Parent immediately prior to the effective time in exchange for equity interests in Parent\\\\u201d; \\\\u201cLongview will receive the same $83.00 per share merger consideration as the other holders of the Company\\\\u2019s common stock for all other shares of common stock beneficially owned by it (other than the rollover shares).\\\\u201d\\\"),\\n    src=['X-018','X-019','X-020','X-001'], page=41, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\\n    related='R039; R041', review='Q8', count=None,\\n    qcheck=['Longview has agreed to contribute 3,012,050 shares (\\\\u201crollover shares\\\\u201d) to Parent immediately prior to the effective time in exchange for equity interests in Parent',\\n            'Longview will receive the same $83.00 per share merger consideration as the other holders of the Company\\\\u2019s common stock for all other shares of common stock beneficially owned by it (other than the rollover shares).'])\\n\\n# 44\\nadd(when='12/14/2014', who='Bidder 2', what='Not selected at signing', rnd=3, typ='Financial',\\n    terms=(\\\"The target signed with the Buyer Group; Bidder 2's $81.50 best-and-final was lower than the $83.00 price offered by the Buyer Group, and the board noted Bidder 2's $81.50 was its best and final. Participation had not previously ended, so this is a signing outcome, stated, not an invented earlier withdrawal; no Re-entered row follows.\\\"),\\n    why=(\\\"Stated: the choice and the price comparison; a live finalist at signing is closed as Not selected at signing with Outcome basis Stated. Decided by Target (the board selected the Buyer Group's higher-priced, more executable offer). \\\"\\n         \\\"\\\\u201cneither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group\\\\u201d.\\\"),\\n    src=['P-024','X-008'], page=26, from_=D(2014,12,14), to=D(2014,12,14), wd=D(2014,12,14), basis='Reported day', method='Reported',\\n    related='R038; R040; R041', review='Q4', count=1,\\n    decided='Target', exit_reason='Lower offer than rivals', outcome_basis='Stated',\\n    qcheck=['neither of which was willing to make a definitive offer at a price above $81.50, which was lower than the $83.00 price offered by the Buyer Group'])\\n\\n# ---------------- Validate rows before writing ----------------\\nids = [f'R{i+1:03d}' for i in range(len(R))]\\nassert len(set(ids)) == len(ids)\\nprev_wd = None\\nfor i, r in enumerate(R):\\n    assert r['wd'] is not None, ids[i]\\n    if prev_wd is not None:\\n        assert r['wd'] >= prev_wd, f\\\"{ids[i]} working date decreases\\\"\\n    prev_wd = r['wd']\\n    if r.get('from_') and r.get('to'):\\n        assert r['from_'] <= r['wd'] <= r['to'], f\\\"{ids[i]} wd outside bounds\\\"\\n    if r.get('from_'):\\n        assert r['wd'] >= r['from_'], ids[i]\\n    if r.get('to'):\\n        assert r['wd'] <= r['to'], ids[i]\\n    # method/basis pair\\n    if r['method'] == 'Reported':\\n        assert r['basis'] == 'Reported day', ids[i]\\n    if r['method'] == 'Inferred':\\n        assert r['basis'] == 'Inferred day', ids[i]\\n    # quotes check\\n    for q in r.get('qcheck', []):\\n        ok = any(norm(q) in SRC_NORM[s] for s in r['src'])\\n        assert ok, f\\\"{ids[i]} quote not found in cited sources: {q[:80]}\\\"\\nprint(\\\"row validation OK:\\\", len(R), \\\"rows\\\")\\n# save row data for the workbook build (next script section continues in same file)\\nimport json\\njson.dump(R, open('/tmp/opencode/petsmart/rows.json','w'), default=str, indent=1)\\njson.dump([(p,s,g,t) for p,s,g,t in SRC_ROWS], open('/tmp/opencode/petsmart/source_rows.json','w'), indent=1)\\nprint(\\\"saved\\\")\\n\"}"},"time":{"start":1789824834706,"end":1789824904178}}}}
