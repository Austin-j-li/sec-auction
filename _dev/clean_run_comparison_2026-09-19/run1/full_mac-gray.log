{"type":"tool_use","timestamp":1789825006821,"sessionID":"ses_f462a5515ffeVXejhZ4OL349Hs","part":{"partID":"prt_0b9e21dfc00126vXVf339fEEe5","sessionID":"ses_f462a5515ffeVXejhZ4OL349Hs","messageID":"msg_0b9e20cfb001ZY1kiNdmMh1YyX","type":"tool","id":"call_00_C6cNpb03dTsNbjGjX5Hz9396","tool":"write","state":{"status":"completed","input":{"content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"Verify the delivered workbook against the instruction's checks.\"\"\"\nimport re, json, datetime as dt\nfrom openpyxl import load_workbook\n\nPATH = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\nwb = load_workbook(PATH)\n\nprint(\"sheets:\", wb.sheetnames)\nfor name in wb.sheetnames:\n    print(\" \", name, \"state=\", wb[name].sheet_state)\n\nled = wb[\"Deal ledger\"]\nlast = led.max_row\nprint(\"ledger rows:\", last - 1)\n\nH = {c.value: c.column for c in led[1]}\nneed = [\"#\",\"When\",\"Who\",\"What happened\",\"Process\",\"Round\",\"Type\",\"Terms or outcome\",\"Formality\",\n        \"Conditions level\",\"Why and evidence\",\"Source\",\"Review\",\"Reviewer note\",\"Row id\",\"Include\",\"Count\",\n        \"Date from\",\"Date to\",\"Working date\",\"Date basis\",\"Date method\",\"Price low\",\"Price high\",\"Price kind\",\n        \"Price origin\",\"Currency\",\"All cash\",\"Cash at closing\",\"Conditions detail\",\"Due date\",\"Deadline treatment\",\n        \"Round finality\",\"Decided by\",\"Exit reason\",\"Outcome basis\",\"Page\",\"Related rows\",\"Deal\"]\nmissing = [n for n in need if n not in H]\nprint(\"missing headers:\", missing)\n\n# collect rows\nrows = []\nfor r in range(2, last+1):\n    d = {h: led.cell(row=r, column=H[h]).value for h in need}\n    d['_r'] = r\n    rows.append(d)\n\n# 1. sorting by working date then #\nprev = None\nok_sort = True\nfor d in rows:\n    wd = d['Working date']\n    if not isinstance(wd, (dt.date, dt.datetime)):\n        ok_sort = False; print(\"bad working date row\", d['_r'], wd)\n        continue\n    if isinstance(wd, dt.datetime): wd = wd.date()\n    if prev and wd < prev[0]:\n        ok_sort = False; print(\"sort break at\", d['_r'], prev, wd)\n    if prev and wd == prev[0] and d['#'] < prev[1]:\n        ok_sort = False; print(\"tie break break at\", d['_r'])\n    prev = (wd, d['#'])\nprint(\"sorted by working date then #:\", ok_sort)\n\n# 2. Date basis / method pairs + working date inside own window\npairs_bad = []\nwindow_bad = []\nfor d in rows:\n    basis, method = d['Date basis'], d['Date method']\n    if basis == 'Reported day' and method != 'Reported': pairs_bad.append((d['Row id'], basis, method))\n    if basis == 'Inferred day' and method != 'Inferred': pairs_bad.append((d['Row id'], basis, method))\n    if method == 'Reported' and basis != 'Reported day': pairs_bad.append((d['Row id'], basis, method))\n    if method == 'Inferred' and basis != 'Inferred day': pairs_bad.append((d['Row id'], basis, method))\n    df, dt_, wd = d['Date from'], d['Date to'], d['Working date']\n    def dd(x):\n        if isinstance(x, dt.datetime): return x.date()\n        return x\n    df, dt_, wd = dd(df), dd(dt_), dd(wd)\n    if df and wd and wd < df: window_bad.append((d['Row id'], 'wd<from'))\n    if dt_ and wd and wd > dt_: window_bad.append((d['Row id'], 'wd>to'))\nprint(\"basis/method pair violations:\", pairs_bad)\nprint(\"working-date window violations:\", window_bad)\n\n# 3. quote validation against Source text sheet\nst = wb[\"Source text\"]\ncorpus = ' '.join(str(st.cell(row=r, column=4).value or '') for r in range(2, st.max_row+1))\ndef norm(s): return re.sub(r'\\s+', ' ', str(s).replace('\\xa0', ' ')).strip()\ncorpus_n = norm(corpus)\nqbad = 0\nfor d in rows:\n    for q in re.findall(r'“(.*?)”', str(d['Why and evidence'] or ''), flags=re.S):\n        if norm(q) not in corpus_n:\n            qbad += 1\n            print(\"QUOTE NOT FOUND\", d['Row id'], norm(q)[:110])\nprint(\"quote failures:\", qbad)\n\n# 4. hyperlinks\nst_index = {}\nfor r in range(2, st.max_row+1):\n    pid = st.cell(row=r, column=1).value\n    st_index[pid] = r\nlink_bad = []\nfor r in range(2, last+1):\n    cell = led.cell(row=r, column=H['Source'])\n    src = str(cell.value or '').split(';')[0].strip()\n    if not cell.hyperlink:\n        link_bad.append((r, src, 'no hyperlink')); continue\n    loc = cell.hyperlink.location or ''\n    m = re.match(r\"'Source text'!A(\\d+)\", loc)\n    if not m or st.cell(row=int(m.group(1)), column=1).value != src:\n        link_bad.append((r, src, loc))\nprint(\"hyperlink problems:\", link_bad)\n\n# 5. controlled values in Lists\nlst = wb[\"Lists\"]\nlists = {}\nfor c in range(1, lst.max_column+1):\n    vals = [lst.cell(row=r, column=c).value for r in range(2, 62)]\n    lists[lst.cell(row=1, column=c).value.split()[-1]] = set(v for v in vals if v)\ndv_map = {'D':'A','G':'B','I':'C','J':'D','P':'E','U':'F','V':'G','Y':'H','Z':'I','AB':'J',\n          'AF':'K','AG':'L','AH':'M','AI':'N','AJ':'O'}\nbad_vals = []\nfor col, lcol in dv_map.items():\n    for d in rows:\n        v = d[[k for k in H if H[k] == ord(col)-64][0]]\n        # easier: direct by column letter\n    for r in range(2, last+1):\n        v = led.cell(row=r, column=ord(col)-64).value\n        if v not in (None, '') and v not in lists[lcol]:\n            bad_vals.append((r, col, v))\nprint(\"values outside Lists:\", bad_vals)\n\n# 6. Page filled where Source filled\npage_bad = [d['Row id'] for d in rows if d['Source'] and not d['Page']]\nprint(\"page missing rows:\", page_bad)\n\n# 7. tags\ntag_bad = []\nfor d in rows:\n    t = str(d['Terms or outcome'] or '')\n    if d['What happened'] == 'Round opened' and d['Round'] == '1' and not t.startswith('R1 anchor:'):\n        tag_bad.append((d['Row id'], 'missing R1 anchor'))\n    if str(d['What happened']) in ('Did not submit','Dropped by target') and d['Outcome basis'] and str(d['Outcome basis']).startswith('Inferred'):\n        if not t.startswith(str(d['Outcome basis'])):\n            tag_bad.append((d['Row id'], 'inferred opener'))\nprint(\"tag problems:\", tag_bad)\n\n# 8. deadline treatments match due-date rows\ndl = [(d['Row id'], d['Deadline treatment'], d['Working date']) for d in rows if d['What happened'] == 'Deadline']\nprint(\"deadline rows:\", dl)\n\n# 9. round finality on every round opened row\nrf = [(d['Row id'], d['Round'], d['Round finality']) for d in rows if d['What happened'] == 'Round opened']\nprint(\"round finality:\", rf)\n\n# 10. AI original matches\nai = wb[\"AI original\"]\nmismatch = 0\nfor r in range(2, min(last, ai.max_row)+1):\n    for c in range(1, 40):\n        a = led.cell(row=r, column=c).value\n        b = ai.cell(row=r, column=c).value\n        if isinstance(a, dt.datetime): a = a.date()\n        if isinstance(b, dt.datetime): b = b.date()\n        if a != b:\n            mismatch += 1\n            if mismatch < 8: print(\"AI mismatch\", r, c, repr(a), repr(b))\nprint(\"AI original mismatches:\", mismatch, \"ai rows:\", ai.max_row-1)\n\n# 11. conditional formatting present\nprint(\"cf ranges:\", {str(k): [r.type for r in v] for k, v in led.conditional_formatting._cf_rules.items()})\n\n# 12. count checks\nnda = sum(d['Count'] or 0 for d in rows if d['What happened'] == 'NDA signed')\ncontact = sum(d['Count'] or 0 for d in rows if d['What happened'] == 'Contact')\nbids = [d for d in rows if d['What happened'] == 'Bid']\nreaff = [d for d in rows if d['What happened'] == 'Bid reaffirmed']\nprint(\"NDA sum:\", nda, \"| contact sum:\", contact, \"| Bid rows:\", len(bids), \"| Bid reaffirmed:\", len(reaff),\n      \"| sum Bid counts:\", sum(d['Count'] or 0 for d in bids))\n\n# 13. per-stage balance\nentrants = {1: 20, 2: 4, 3: 4, 4: 3}\nexits = {}\nfor d in rows:\n    if d['Outcome basis'] in ('Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent'):\n        rnd = str(d['Round'])\n        exits[rnd] = exits.get(rnd, 0) + (d['Count'] or 0)\nprint(\"exits by round:\", exits)\n\n# 14. rows referencing R-ids in text resolve\nids = set(d['Row id'] for d in rows)\nbad_refs = set()\nfor d in rows:\n    for m in re.findall(r'\\bR\\d{3}\\b', ' '.join(str(d.get(k) or '') for k in ('Terms or outcome','Why and evidence','Related rows'))):\n        if m not in ids: bad_refs.add(m)\nfor q in wb[\"Questions\"].iter_rows(min_row=1, max_row=wb[\"Questions\"].max_row):\n    for c in q:\n        if isinstance(c.value, str):\n            for m in re.findall(r'\\bR\\d{3}\\b', c.value):\n                if m not in ids: bad_refs.add(m)\nfor q in wb[\"Summary\"].iter_rows(min_row=1, max_row=wb[\"Summary\"].max_row):\n    for c in q:\n        if isinstance(c.value, str):\n            for m in re.findall(r'\\bR\\d{3}\\b', c.value):\n                if m not in ids: bad_refs.add(m)\nprint(\"unresolved R ids:\", bad_refs)\n\nprint(\"done\")\n","path":"/tmp/opencode/verify_workbook.py"},"output":"Created file successfully: /tmp/opencode/verify_workbook.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/verify_workbook.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"#!/usr/bin/env python3\\n# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Verify the delivered workbook against the instruction's checks.\\\"\\\"\\\"\\nimport re, json, datetime as dt\\nfrom openpyxl import load_workbook\\n\\nPATH = '/home/uctpiaj/work/extraction/mac-gray.xlsx'\\nwb = load_workbook(PATH)\\n\\nprint(\\\"sheets:\\\", wb.sheetnames)\\nfor name in wb.sheetnames:\\n    print(\\\" \\\", name, \\\"state=\\\", wb[name].sheet_state)\\n\\nled = wb[\\\"Deal ledger\\\"]\\nlast = led.max_row\\nprint(\\\"ledger rows:\\\", last - 1)\\n\\nH = {c.value: c.column for c in led[1]}\\nneed = [\\\"#\\\",\\\"When\\\",\\\"Who\\\",\\\"What happened\\\",\\\"Process\\\",\\\"Round\\\",\\\"Type\\\",\\\"Terms or outcome\\\",\\\"Formality\\\",\\n        \\\"Conditions level\\\",\\\"Why and evidence\\\",\\\"Source\\\",\\\"Review\\\",\\\"Reviewer note\\\",\\\"Row id\\\",\\\"Include\\\",\\\"Count\\\",\\n        \\\"Date from\\\",\\\"Date to\\\",\\\"Working date\\\",\\\"Date basis\\\",\\\"Date method\\\",\\\"Price low\\\",\\\"Price high\\\",\\\"Price kind\\\",\\n        \\\"Price origin\\\",\\\"Currency\\\",\\\"All cash\\\",\\\"Cash at closing\\\",\\\"Conditions detail\\\",\\\"Due date\\\",\\\"Deadline treatment\\\",\\n        \\\"Round finality\\\",\\\"Decided by\\\",\\\"Exit reason\\\",\\\"Outcome basis\\\",\\\"Page\\\",\\\"Related rows\\\",\\\"Deal\\\"]\\nmissing = [n for n in need if n not in H]\\nprint(\\\"missing headers:\\\", missing)\\n\\n# collect rows\\nrows = []\\nfor r in range(2, last+1):\\n    d = {h: led.cell(row=r, column=H[h]).value for h in need}\\n    d['_r'] = r\\n    rows.append(d)\\n\\n# 1. sorting by working date then #\\nprev = None\\nok_sort = True\\nfor d in rows:\\n    wd = d['Working date']\\n    if not isinstance(wd, (dt.date, dt.datetime)):\\n        ok_sort = False; print(\\\"bad working date row\\\", d['_r'], wd)\\n        continue\\n    if isinstance(wd, dt.datetime): wd = wd.date()\\n    if prev and wd < prev[0]:\\n        ok_sort = False; print(\\\"sort break at\\\", d['_r'], prev, wd)\\n    if prev and wd == prev[0] and d['#'] < prev[1]:\\n        ok_sort = False; print(\\\"tie break break at\\\", d['_r'])\\n    prev = (wd, d['#'])\\nprint(\\\"sorted by working date then #:\\\", ok_sort)\\n\\n# 2. Date basis / method pairs + working date inside own window\\npairs_bad = []\\nwindow_bad = []\\nfor d in rows:\\n    basis, method = d['Date basis'], d['Date method']\\n    if basis == 'Reported day' and method != 'Reported': pairs_bad.append((d['Row id'], basis, method))\\n    if basis == 'Inferred day' and method != 'Inferred': pairs_bad.append((d['Row id'], basis, method))\\n    if method == 'Reported' and basis != 'Reported day': pairs_bad.append((d['Row id'], basis, method))\\n    if method == 'Inferred' and basis != 'Inferred day': pairs_bad.append((d['Row id'], basis, method))\\n    df, dt_, wd = d['Date from'], d['Date to'], d['Working date']\\n    def dd(x):\\n        if isinstance(x, dt.datetime): return x.date()\\n        return x\\n    df, dt_, wd = dd(df), dd(dt_), dd(wd)\\n    if df and wd and wd < df: window_bad.append((d['Row id'], 'wd<from'))\\n    if dt_ and wd and wd > dt_: window_bad.append((d['Row id'], 'wd>to'))\\nprint(\\\"basis/method pair violations:\\\", pairs_bad)\\nprint(\\\"working-date window violations:\\\", window_bad)\\n\\n# 3. quote validation against Source text sheet\\nst = wb[\\\"Source text\\\"]\\ncorpus = ' '.join(str(st.cell(row=r, column=4).value or '') for r in range(2, st.max_row+1))\\ndef norm(s): return re.sub(r'\\\\s+', ' ', str(s).replace('\\\\xa0', ' ')).strip()\\ncorpus_n = norm(corpus)\\nqbad = 0\\nfor d in rows:\\n    for q in re.findall(r'“(.*?)”', str(d['Why and evidence'] or ''), flags=re.S):\\n        if norm(q) not in corpus_n:\\n            qbad += 1\\n            print(\\\"QUOTE NOT FOUND\\\", d['Row id'], norm(q)[:110])\\nprint(\\\"quote failures:\\\", qbad)\\n\\n# 4. hyperlinks\\nst_index = {}\\nfor r in range(2, st.max_row+1):\\n    pid = st.cell(row=r, column=1).value\\n    st_index[pid] = r\\nlink_bad = []\\nfor r in range(2, last+1):\\n    cell = led.cell(row=r, column=H['Source'])\\n    src = str(cell.value or '').split(';')[0].strip()\\n    if not cell.hyperlink:\\n        link_bad.append((r, src, 'no hyperlink')); continue\\n    loc = cell.hyperlink.location or ''\\n    m = re.match(r\\\"'Source text'!A(\\\\d+)\\\", loc)\\n    if not m or st.cell(row=int(m.group(1)), column=1).value != src:\\n        link_bad.append((r, src, loc))\\nprint(\\\"hyperlink problems:\\\", link_bad)\\n\\n# 5. controlled values in Lists\\nlst = wb[\\\"Lists\\\"]\\nlists = {}\\nfor c in range(1, lst.max_column+1):\\n    vals = [lst.cell(row=r, column=c).value for r in range(2, 62)]\\n    lists[lst.cell(row=1, column=c).value.split()[-1]] = set(v for v in vals if v)\\ndv_map = {'D':'A','G':'B','I':'C','J':'D','P':'E','U':'F','V':'G','Y':'H','Z':'I','AB':'J',\\n          'AF':'K','AG':'L','AH':'M','AI':'N','AJ':'O'}\\nbad_vals = []\\nfor col, lcol in dv_map.items():\\n    for d in rows:\\n        v = d[[k for k in H if H[k] == ord(col)-64][0]]\\n        # easier: direct by column letter\\n    for r in range(2, last+1):\\n        v = led.cell(row=r, column=ord(col)-64).value\\n        if v not in (None, '') and v not in lists[lcol]:\\n            bad_vals.append((r, col, v))\\nprint(\\\"values outside Lists:\\\", bad_vals)\\n\\n# 6. Page filled where Source filled\\npage_bad = [d['Row id'] for d in rows if d['Source'] and not d['Page']]\\nprint(\\\"page missing rows:\\\", page_bad)\\n\\n# 7. tags\\ntag_bad = []\\nfor d in rows:\\n    t = str(d['Terms or outcome'] or '')\\n    if d['What happened'] == 'Round opened' and d['Round'] == '1' and not t.startswith('R1 anchor:'):\\n        tag_bad.append((d['Row id'], 'missing R1 anchor'))\\n    if str(d['What happened']) in ('Did not submit','Dropped by target') and d['Outcome basis'] and str(d['Outcome basis']).startswith('Inferred'):\\n        if not t.startswith(str(d['Outcome basis'])):\\n            tag_bad.append((d['Row id'], 'inferred opener'))\\nprint(\\\"tag problems:\\\", tag_bad)\\n\\n# 8. deadline treatments match due-date rows\\ndl = [(d['Row id'], d['Deadline treatment'], d['Working date']) for d in rows if d['What happened'] == 'Deadline']\\nprint(\\\"deadline rows:\\\", dl)\\n\\n# 9. round finality on every round opened row\\nrf = [(d['Row id'], d['Round'], d['Round finality']) for d in rows if d['What happened'] == 'Round opened']\\nprint(\\\"round finality:\\\", rf)\\n\\n# 10. AI original matches\\nai = wb[\\\"AI original\\\"]\\nmismatch = 0\\nfor r in range(2, min(last, ai.max_row)+1):\\n    for c in range(1, 40):\\n        a = led.cell(row=r, column=c).value\\n        b = ai.cell(row=r, column=c).value\\n        if isinstance(a, dt.datetime): a = a.date()\\n        if isinstance(b, dt.datetime): b = b.date()\\n        if a != b:\\n            mismatch += 1\\n            if mismatch < 8: print(\\\"AI mismatch\\\", r, c, repr(a), repr(b))\\nprint(\\\"AI original mismatches:\\\", mismatch, \\\"ai rows:\\\", ai.max_row-1)\\n\\n# 11. conditional formatting present\\nprint(\\\"cf ranges:\\\", {str(k): [r.type for r in v] for k, v in led.conditional_formatting._cf_rules.items()})\\n\\n# 12. count checks\\nnda = sum(d['Count'] or 0 for d in rows if d['What happened'] == 'NDA signed')\\ncontact = sum(d['Count'] or 0 for d in rows if d['What happened'] == 'Contact')\\nbids = [d for d in rows if d['What happened'] == 'Bid']\\nreaff = [d for d in rows if d['What happened'] == 'Bid reaffirmed']\\nprint(\\\"NDA sum:\\\", nda, \\\"| contact sum:\\\", contact, \\\"| Bid rows:\\\", len(bids), \\\"| Bid reaffirmed:\\\", len(reaff),\\n      \\\"| sum Bid counts:\\\", sum(d['Count'] or 0 for d in bids))\\n\\n# 13. per-stage balance\\nentrants = {1: 20, 2: 4, 3: 4, 4: 3}\\nexits = {}\\nfor d in rows:\\n    if d['Outcome basis'] in ('Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent'):\\n        rnd = str(d['Round'])\\n        exits[rnd] = exits.get(rnd, 0) + (d['Count'] or 0)\\nprint(\\\"exits by round:\\\", exits)\\n\\n# 14. rows referencing R-ids in text resolve\\nids = set(d['Row id'] for d in rows)\\nbad_refs = set()\\nfor d in rows:\\n    for m in re.findall(r'\\\\bR\\\\d{3}\\\\b', ' '.join(str(d.get(k) or '') for k in ('Terms or outcome','Why and evidence','Related rows'))):\\n        if m not in ids: bad_refs.add(m)\\nfor q in wb[\\\"Questions\\\"].iter_rows(min_row=1, max_row=wb[\\\"Questions\\\"].max_row):\\n    for c in q:\\n        if isinstance(c.value, str):\\n            for m in re.findall(r'\\\\bR\\\\d{3}\\\\b', c.value):\\n                if m not in ids: bad_refs.add(m)\\nfor q in wb[\\\"Summary\\\"].iter_rows(min_row=1, max_row=wb[\\\"Summary\\\"].max_row):\\n    for c in q:\\n        if isinstance(c.value, str):\\n            for m in re.findall(r'\\\\bR\\\\d{3}\\\\b', c.value):\\n                if m not in ids: bad_refs.add(m)\\nprint(\\\"unresolved R ids:\\\", bad_refs)\\n\\nprint(\\\"done\\\")\\n\", \"path\": \"/tmp/opencode/verify_workbook.py\"}"},"time":{"start":1789824998908,"end":1789825006821}}}}
