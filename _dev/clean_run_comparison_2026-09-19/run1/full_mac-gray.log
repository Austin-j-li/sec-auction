as of October 14, 2013, which we \nSource: P-075; P-076; P-077; X-002; X-005; X-026; X-017; X-018; X-006\nReview: Q5\nRow id: R051\nInclude: Yes\nDate from: 2013-10-14 00:00:00\nDate to: 2013-10-14 00:00:00\nWorking date: 2013-10-14 00:00:00\nDate basis: Reported day\nDate method: Reported\nPage: 41\nRelated rows: R043; R050; R052; R007\nDeal: Mac-Gray\n\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /tmp/opencode && python3 - <<'EOF'\\nfrom openpyxl import load_workbook\\nwb = load_workbook('/home/uctpiaj/work/extraction/mac-gray.xlsx')\\nled = wb['Deal ledger']\\nH = {c.value: c.column for c in led[1]}\\nfor r in (12, 22, 52):\\n    print(\\\"=\\\"*100)\\n    for col in H:\\n        v = led.cell(row=r, column=H[col]).value\\n        if v not in (None, ''):\\n            print(f\\\"{col}: {str(v)[:700]}\\\")\\n    print()\\nEOF\"}"},"time":{"start":1789825139724,"end":1789825140451}}}}
