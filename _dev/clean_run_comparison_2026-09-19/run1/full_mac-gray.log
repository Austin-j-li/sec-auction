3\n2504:A-4\n2519:A-5\n2535:A-6\n2623:A-7\n2702:A-8\n2716:A-9\n2727:A-10\n2736:A-11\n2744:A-12\n2759:A-13\n===\n========== PAGE None (segment 103, zeq=None) ==========\nTable of Contents\nTABLE OF CONTENTS\nPage\nARTICLE 1 DEFINITIONS\nA-1\nSection 1.01\nDefinitions\nA-1\nSection 1.02\nOther Definitional and Interpretative Provisions A-8\nARTICLE 2 THE MERGER\nA-9\nSection 2.01\nThe Closing\nA-9\nSection 2.02\nThe Merger A-9\nSection 2.03\nConversion of Shares A-9\nSection 2.04\nSurrender and Payment A-10\nSection 2.05\nDissenting Shares A-11\nSection 2.06\nCompany Stock Options; Restricted Stock Unit Awards; ESPP A-11\nSection 2.07\nAdjustments A-12\nSection 2.08\nWithholding Rights A-13\nSection 2.09\nLost Certificates A-13\nARTICLE 3 THE SURVIVING CORPORATION\nA-13\nSection 3.01\nCertificate of Incorporation\nA-13\nSection 3.02\nBylaws A-13\nSection 3.03\nDirectors and Officers A-13\nARTICLE 4 REPRESENTATIONS AND WARRANTIES OF THE COMPANY\nA-13\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /tmp/opencode && grep -n -E '^[A-D]-[0-9]+' filing_numbered.txt | head -30; echo ===; sed -n '2218,2260p' filing_numbered.txt\"}"},"time":{"start":1789824576529,"end":1789824577005}}}}
