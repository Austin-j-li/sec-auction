= norm(' '.join(p['text'] for p in bg) + ' ' + ' '.join(p['text'] for p in x))\\n\\nfail = 0\\nfor r in ROWS:\\n    ev = r['evidence']\\n    quotes = re.findall(r'“(.*?)”', ev, flags=re.S)\\n    for q in quotes:\\n        qn = norm(q)\\n        if qn not in corpus:\\n            fail += 1\\n            print(f\\\"FAIL {r['key']}: {qn[:160]}\\\")\\nprint(\\\"total failures:\\\", fail)\\n\", \"path\": \"/tmp/opencode/validate_quotes.py\"}"},"time":{"start":1789824826320,"end":1789824827098}}}}
