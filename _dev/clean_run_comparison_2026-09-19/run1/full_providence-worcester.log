 cond=\"Heavy\",\n","status":"modified","additions":1,"deletions":1}],"truncated":false},"content":[{"type":"text","text":"Edited rows_ledger.py (1 replacement)"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"newString\": \"  source=[\\\"P-024\\\"], review=\\\"Q4; Q5\\\", count=0,\\n  dfrom=\\\"2016-08-02\\\", dto=\\\"2016-08-02\\\", wdate=\\\"2016-08-02\\\",\", \"oldString\": \"  source=[\\\"P-024\\\"], review=\\\"Q4; Q5\\\", count=1,\\n  dfrom=\\\"2016-08-02\\\", dto=\\\"2016-08-02\\\", wdate=\\\"2016-08-02\\\",\", \"path\": \"/home/uctpiaj/work/rows_ledger.py\"}"},"time":{"start":1789825033859,"end":1789825034351}}}}
