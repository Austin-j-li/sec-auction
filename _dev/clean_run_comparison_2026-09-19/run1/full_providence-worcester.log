ta":{"metadata":{"status":"completed","truncated":false,"exit":0},"content":[{"type":"text","text":"[[139|td|p6]] 26\n[[140|p|p6]] Voting Agreement\n[[141|td|p6]] 26\n[[142|p|p6]] Shares Held in the PWRR Profit-Sharing Plan\n[[143|td|p6]] 26\n[[144|p|p6]] Shares Purchased Under the PWRR Employee Stock Purchase Plan\n[[145|td|p6]] 26\n[[146|p|p6]] PROPOSAL NO. 1—THE MERGER\n[[147|td|p6]] 27\n[[148|p|p6]] General\n[[149|td|p6]] 27\n[[150|p|p6]] Background of the Merger\n[[151|td|p6]] 27\n[[152|p|p6]] Recommendation of the Board of Directors and Reasons for the Merger\n[[153|td|p6]] 32\n[[154|p|p6]] Opinion of the Company’s Financial Advisor\n[[155|td|p6]] 36\n[[156|p|p6]] Summary of Financial Analysis of BMO Capital Markets Corp.\n[[157|td|p6]] 39\n[[158|p|p6]] Projected Financial Information\n[[159|td|p6]] 42\n[[160|p|p6]] Delisting and Deregistration of Common Stock Following the Merger\n[[161|td|p6]] 43\n[[162|p|p6]] Interests of Directors and Executive Officers in the Merger\n[[163|td|p6]] 44\n[[164|p|p6]] PROPOSAL NO. 2—ADVISORY (NON-BINDING) VOTE ON MERGER-RELATED EXECUTIVE COMPENSATION ARRANGEMENTS\n[[165|td|p6]] 48\n[[166|p|p6]] PROPOSAL NO. 3—VOTE ON POSSIBLE ADJOURNMENT TO SOLICIT ADDITIONAL PROXIES, IF NECESSARY\n[[167|td|p6]] 49\n[[168|p|p6]] THE MERGER AGREEMENT\n[[169|td|p6]] 50\n[[170|p|p6]] Structure of the Merger\n[[171|td|p6]] 50\n[[172|p|p6]] Closing of the Merger\n[[173|td|p6]] 50\n[[174|p|p6]] Organizational Documents; Board of Directors and Officers of the Company Following the Merger\n[[175|td|p6]] 50\n[[176|p|p6]] Merger Consideration\n[[177|td|p6]] 50\n[[178|p|p6]] (i)\n[[179|h5|p7]] Table of Contents\n"},{"type":"text","text":"Command exited with code 0."}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"command\": \"cd /home/uctpiaj/work && sed -n '140,180p' filing_blocks.txt\"}"},"time":{"start":1789824158439,"end":1789824158584}}}}
