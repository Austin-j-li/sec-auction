{"type":"tool_use","timestamp":1789825095664,"sessionID":"ses_f46293c76ffe0Qb4SRXqQEDupS","part":{"partID":"prt_0b9e300e8001pk3RaQD2OUetEF","sessionID":"ses_f46293c76ffe0Qb4SRXqQEDupS","messageID":"msg_0b9e2dbe2001625Ls6yUp7903G","type":"tool","id":"call_00_S1bxN61skiBO9vYQDFtB2718","tool":"write","state":{"status":"completed","input":{"content":"# -*- coding: utf-8 -*-\n\"\"\"Write the petsmart ledger workbook.\"\"\"\nimport json, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\nfrom openpyxl.utils import get_column_letter\nfrom openpyxl.worksheet.datavalidation import DataValidation\nfrom openpyxl.workbook.defined_name import DefinedName\n\nLA = json.load(open('/tmp/opencode/petsmart/ledger_draft.json'))\nSRC = json.load(open('/tmp/opencode/petsmart/source_rows.json'))\n\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\n\n# ---------- styles ----------\nHDR_FILL = PatternFill('solid', fgColor='1F3864')\nHDR_FONT = Font(bold=True, color='FFFFFF', size=10)\nSEC_FILL = PatternFill('solid', fgColor='D9E2F3')\nSEC_FONT = Font(bold=True, size=11)\nWRAP = Alignment(wrap_text=True, vertical='top')\nWRAP_C = Alignment(wrap_text=True, vertical='top', horizontal='center')\nTHIN = Side(style='thin', color='BFBFBF')\nBORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)\nLINK_FONT = Font(color='0563C1', underline='single', size=10)\nBODY = Font(size=10)\n\nwb = Workbook()\n\n# ============================================================================\n# Lists sheet (hidden)\n# ============================================================================\nLISTS = [\n ('What happened', ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed']),\n ('Type', ['Strategic','Financial','Mixed','Unknown']),\n ('Formality', ['Formal','Informal','Insufficient evidence','Varies']),\n ('Conditions level', ['None','Light','Heavy','Insufficient evidence','Varies']),\n ('Include', ['Yes','No']),\n ('Date basis', ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated']),\n ('Date method', ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence']),\n ('Price kind', ['Point','Bidder range','Group envelope','Bound only','Undisclosed']),\n ('Price origin', ['Stated','Carried forward','Inferred']),\n ('All cash', ['Yes','No','Not stated']),\n ('Deadline treatment', ['Extended','Late bids accepted','Extended; Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated']),\n ('Round finality', ['Announced as final','Inferred final','Not final']),\n ('Decided by', ['Bidder','Target','Both','Unknown']),\n ('Exit reason', ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated']),\n ('Outcome basis', ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity']),\n]\nls = wb.active\nls.title = 'Lists'\nfor col, (name, vals) in enumerate(LISTS, start=1):\n    c = get_column_letter(col)\n    ls[f'{c}1'] = name\n    ls[f'{c}1'].font = Font(bold=True, size=10)\n    for i, v in enumerate(vals, start=2):\n        ls[f'{c}{i}'] = v\n    ls.column_dimensions[c].width = max(14, min(30, max(len(v) for v in vals) + 2))\n    dn = 'List_' + ''.join(ch for ch in name.title() if ch.isalnum())\n    ref = f\"Lists!${c}$2:${c}${len(vals)+1}\"\n    wb.defined_names.add(DefinedName(dn, attr_text=ref))\n\n# ============================================================================\n# Deal ledger\n# ============================================================================\nws = wb.create_sheet('Deal ledger', 0)\nHEAD = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome','Formality','Conditions level',\n        'Why and evidence','Source','Review','Reviewer note',\n        'Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\n        'Price low','Price high','Price kind','Price origin','Currency','All cash','Cash at closing',\n        'Conditions detail','Due date','Deadline treatment','Round finality','Decided by','Exit reason','Outcome basis',\n        'Page','Related rows','Deal']\nfor j, h in enumerate(HEAD, start=1):\n    c = ws.cell(row=1, column=j, value=h)\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\n\ndef val(r, k):\n    return r.get(k)\n\nfor i, r in enumerate(LA):\n    row = i + 2\n    reason = r['why']\n    if r['quotes']:\n        qs = ' '.join(f\"“{q['text']}” (p. {q['page']})\" for q in r['quotes'])\n        reason = reason + ' Quotation' + ('s' if len(r['quotes'])>1 else '') + ': ' + qs\n    src_txt = '; '.join(r['src_ids'])\n    data = [r['num'], r['when'], r['who'], r['what'], r['process'], int(r['round']) if r['round'].isdigit() else r['round'],\n            r['type'], r['terms'], r['formality'], r['cond_level'], reason, src_txt, r['review'], '',\n            r['rid'], 'Yes', r['count'], r['dfrom'], r['dto'], r['wdate'], r['basis'], r['method'],\n            r['plow'], r['phigh'], r['pkind'], r['porigin'], r['ccy'], r['allcash'], r['cashclose'],\n            r['conddetail'], r['duedate'], r['dtreat'], r['rfinal'], r['decidedby'], r['exitreason'], r['obasis'],\n            r['page'], r['related'], r['deal']]\n    for j, v in enumerate(data, start=1):\n        c = ws.cell(row=row, column=j, value=v)\n        c.font = BODY; c.border = BORDER\n        c.alignment = WRAP\n        if j in (1,5,6,13,16,17,20,22,25,26,27,28,32,33,34,35,36,37):\n            c.alignment = WRAP_C\n        if j in (18,19,20,31):\n            c.number_format = 'MM/DD/YYYY'\n        if j in (23,24,29):\n            c.number_format = '#,##0.00'\n        if j == 11:\n            c.font = Font(size=10)\n    # local link on Source cell to main paragraph\n    sc = ws.cell(row=row, column=12)\n    sc.hyperlink = f\"#'Source text'!A{SRC.index(next(s for s in SRC if s['id']==r['main_id']))+2}\"\n    sc.font = LINK_FONT\n\nwidths = {'A':4,'B':26,'C':26,'D':18,'E':8,'F':7,'G':11,'H':64,'I':12,'J':15,'K':95,'L':20,'M':10,'N':14,\n          'O':8,'P':8,'Q':7,'R':10,'S':10,'T':11,'U':15,'V':15,'W':9,'X':9,'Y':12,'Z':10,'AA':8,'AB':9,'AC':11,\n          'AD':46,'AE':10,'AF':15,'AG':13,'AH':10,'AI':20,'AJ':14,'AK':6,'AL':16,'AM':9}\nfor c, w in widths.items():\n    ws.column_dimensions[c].width = w\n# collapsed expandable groups\nfor start, end in [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]:\n    ws.column_dimensions.group(start, end, outline_level=1, hidden=True)\nws.freeze_panes = 'D2'\nws.auto_filter.ref = f'A1:AM{len(LA)+1}'\nws.sheet_properties.outlinePr.summaryRight = False\n\n# data validations\nDV_COLS = {'D':'List_WhatHappened','G':'List_Type','I':'List_Formality','J':'List_ConditionsLevel','P':'List_Include',\n           'U':'List_DateBasis','V':'List_DateMethod','Y':'List_PriceKind','Z':'List_PriceOrigin','AB':'List_AllCash',\n           'AF':'List_DeadlineTreatment','AG':'List_RoundFinality','AH':'List_DecidedBy','AI':'List_ExitReason','AJ':'List_OutcomeBasis'}\nfor col, dn in DV_COLS.items():\n    dv = DataValidation(type='list', formula1=f'={dn}', allow_blank=True, showErrorMessage=True)\n    ws.add_data_validation(dv)\n    dv.add(f'{col}2:{col}{len(LA)+1}')\n\n# ============================================================================\n# Source text\n# ============================================================================\nss = wb.create_sheet('Source text', 1)\nfor j, h in enumerate(['Paragraph','Section','Page','Text'], start=1):\n    c = ss.cell(row=1, column=j, value=h)\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\nfor i, s in enumerate(SRC):\n    row = i + 2\n    ss.cell(row=row, column=1, value=s['id']).font = BODY\n    ss.cell(row=row, column=2, value=s['section']).font = BODY\n    ss.cell(row=row, column=3, value=s['page']).font = BODY\n    tc = ss.cell(row=row, column=4, value=s['text']); tc.font = BODY\n    for j in range(1,5):\n        ss.cell(row=row, column=j).alignment = WRAP\n        ss.cell(row=row, column=j).border = BORDER\nss.column_dimensions['A'].width = 10\nss.column_dimensions['B'].width = 26\nss.column_dimensions['C'].width = 6\nss.column_dimensions['D'].width = 150\nss.freeze_panes = 'A2'\nss.auto_filter.ref = f'A1:D{len(SRC)+1}'\n\n# ============================================================================\n# Summary\n# ============================================================================\nsm = wb.create_sheet('Summary', 2)\nsm.column_dimensions['A'].width = 44\nsm.column_dimensions['B'].width = 132\nr = 1\ndef sec(title):\n    global r\n    c = sm.cell(row=r, column=1, value=title); c.font = SEC_FONT; c.fill = SEC_FILL\n    sm.cell(row=r, column=2).fill = SEC_FILL\n    r += 1\ndef line(label, value, bold=False, formula=False):\n    global r\n    a = sm.cell(row=r, column=1, value=label); a.font = Font(bold=bold, size=10); a.alignment = WRAP\n    b = sm.cell(row=r, column=2, value=value); b.font = Font(bold=bold, size=10); b.alignment = WRAP\n    if formula:\n        b.value = value\n    r += 1\ndef blank():\n    global r\n    r += 1\n\nt = sm.cell(row=1, column=1, value='PetSmart, Inc. — deal ledger summary (target: petsmart / BC Partners-led Buyer Group / Argos Holdings)')\nt.font = Font(bold=True, size=13)\nr = 2\n\nsec('Status, instruction and source coverage')\nline('Status', 'AI first pass; not human-approved.')\nline('Instruction', 'SEC deal-ledger extraction instruction, short-form revision of 19 September 2026 (ledger rules and schema; no self-check/correction sheet requested).')\nline('Source coverage', 'Supplied filing only: PetSmart DEFM14A filed 02/02/2015 (raw_filing/petsmart_2015-02-02_DEFM14A.htm). Primary extraction from the Background of the Merger (pp. 21–26); cross-checked against the Summary (pp. 1–9), Reasons for the Merger (pp. 26–30), Opinion of J.P. Morgan (pp. 30–37), Projected Financial Information (pp. 37–40), Financing (pp. 40–45), Termination Fee Commitment Letters (p. 44), Voting Support Agreement (p. 45), the merger-agreement description (pp. 53–73), Regulatory Approvals and Litigation (p. 52). Source text is HTML-decoded with layout-only whitespace normalization; all quotations are recoverable from the Source text sheet.')\nblank()\n\nsec('Commercial account')\nsm.cell(row=r-1, column=1).value = None\naccount = (\"PetSmart entered 2014 reviewing alternatives — including a possible combination with a privately-held industry participant — and, \"\n \"after a weak first quarter, faced stockholder and activist pressure (JANA Partners' 13D of 07/03/2014 at 9.9%; Longview's public sale advocacy of \"\n \"07/07/2014) that pushed the board into a formal exploration announced 08/19/2014. Through an independent-director ad hoc committee and J.P. Morgan, \"\n \"the target contacted 27 potential participants, signed confidentiality and standstill agreements with 15 financial buyers in early October, and received \"\n \"six non-binding indications of interest on 10/30/2014 (three individually described $80–$85 ranges and three residual submitters). On 11/03/2014 the board \"\n \"advanced the four bidders at or above $80.00 to a final round; two bidders combined into 'Bidder 3'. Final bids on 12/10/2014 were $80.70 in cash from the \"\n \"Buyer Group and $80.35 from Bidder 2, with Bidder 3 dropping out at a valuation at or below about $78; after the target demanded improvements, Bidder 2 \"\n \"delivered a best-and-final $81.50 and the Buyer Group a best-and-final $83.00 in cash on 12/12/2014. The board approved the Buyer Group on 12/13/2014 and \"\n \"the merger agreement was signed and announced on 12/14/2014: $83.00 per share in cash, with Longview rolling over 3,012,050 shares (~$250 million) into \"\n \"Parent and voting its 7,424,591 shares for the deal. No superior proposal is reported as of the 02/02/2015 proxy; closing was expected in the first half of \"\n \"2015 and is not observed in the filing.\")\nline('Sale story', account)\nblank()\n\nsec('Deal facts')\nline('Target', 'PetSmart, Inc., a Delaware corporation (principal offices Phoenix, AZ); NASDAQ: PETM; 1,404 stores and 202 in-store boarding facilities. [XPS]')\nline('Focal acquirer', 'Argos Holdings Inc. (\"Parent\") and Argos Merger Sub Inc. — affiliates of funds advised by BC Partners, Inc.; at closing owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP, and (at all times after 12/12/2014) Longview Asset Management, LLC. Type: Financial (PE-led consortium of financial investors). [XBG; XARG; XOWN]')\nline('Agreed consideration', '$83.00 per share in cash for each outstanding share (other than excluded/appraisal shares); Longview contributes 3,012,050 shares (~$250 million worth) to Parent for equity and receives $83.00 on its other shares; voting agreement covers 7,424,591 shares (~7.5%). [XEFF; XROLL; XLVS; XVOTE]')\nline('Financing / funds', 'Total funds required estimated at ~$8.4 billion: cash equity commitments up to ~$1.83 billion plus Longview stock ($250 million); committed debt up to $6.95 billion ($4.3bn term loan B, $750m ABL revolver, $1.9bn bridge/senior notes); ~$425 million cash on hand; not subject to a financing condition. [XFIN; XNOFIN; XEQ; XDEBT]')\nline('Signing / announcement / closing', 'Signed 12/14/2014; announced 12/14/2014 (press release with signing). Completion expected in the first half of 2015 (end date 06/14/2015) — no closing observed in the supplied filing. Signing, announcement and (unobserved) closing kept separate. [P-031; XCLOSE; XTERN]')\nline('Termination fees', 'Company termination fee $255 million; Parent reverse termination fee $510 million (supported by several Buyer Group termination-fee commitment letters up to the $510 million cap); expense reimbursement up to $15 million. [XCTF; XPTF; XTFC; XTFC2; XEXP]')\nline('Filing identity and link', 'DEFM14A definitive proxy statement, filed 02/02/2015, for the special meeting on 03/06/2015; record date 01/29/2015, 99,455,151 shares outstanding. Background at pp. 21–26. Local source: ../raw_filing/petsmart_2015-02-02_DEFM14A.htm')\nblank()\n\nsec('Process and round map (Process 1 — single continuing sale attempt; ends in signing; no termination or restart observed)')\nline('Round 0 (no Round opened row)', 'Pre-process: Industry Participant approaches and exclusion (R001, R009, R011); JANA/Longview activism (R006–R008); 06/18/2014 capital-structure review and adviser search (R003–R005); 08/13/2014 sale decision (R010); 08/19/2014 announcement (R012); 27 contacts incl. ~15 expressions of interest (R013/R014, R015).')\nline('Round 1 — solicitation / IOI stage', 'Opened R016, anchored on the confidentiality-agreement wave (first week of October 2014; Not final). Scope: 15 financial NDA signers (R017; all engaged in diligence and received the Profit Improvement Plan information). Deadline set in October: non-binding IOIs due 10/30/2014 (R018), treatment Enforced (R019). Six indicated (R020–R023); nine non-submitters inferred (R024). Two submitters eliminated on 11/03/2014 (R027). Round-bidder tally: 6 new bidder units.')\nline('Round 2 — finalist stage', 'Opened R026 on 11/03/2014 (Inferred final): four bidders at/above $80.00 advanced (Buyer Group, Bidder 2, and the two bidders later forming Bidder 3; see Q2). Two bidders authorized to combine → Bidder 3 (R028; final-round units 4 → 3). Further diligence during November. Round-bidder tally: 0 new bid units (no priced submission in this stage).')\nline('Round 3 — final-bid stage', 'Opened R029, anchored on the first request for final bids (merger-agreement circulation, November 2014; Announced as final). Deadline history: 12/05/2014 initial date set (R032; superseded before arrival, no milestone row) → revised 12/04–05 to evening 12/10/2014 (R033), treatment Extended (R034) → improved bids 12/12/2014 (R039), treatment Enforced (R040). Bids: 12/10 — Buyer Group $80.70 cash (R035), Bidder 2 $80.35 cash (R036), Bidder 3 verbal ≤ ~$78 (R037; did not submit, R038); 12/12 — Bidder 2 $81.50 best-and-final (R042), Buyer Group $82.50 interim (R043) then $83.00 best-and-final (R044). Approval 12/13/2014 (R045); Bidder 2 not selected at signing (R046). Round-bidder tally: 3 new bid units; 2 units submitted improved best-and-final bids.')\nline('Post-signing', 'No post-signing competing proposals, go-shop or agreement termination observed. No go-shop was provided; the 15 signers\\' standstills limit post-signing bids (XSTAND). As of 02/02/2015 no unsolicited offer had been made (XNOOFF).')\nblank()\n\nsec('Participants and advisers')\nline('Buyer Group (winner)', 'Financial. Consortium of funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd and affiliates of StepStone Group LP; Longview Asset Management, LLC joins after 12/12/2014 (rollover, not a bidding-unit membership change). First observed 10/30/2014 (IOI $81–$83; R020); final bids $80.70 (R035), $82.50 interim (R043), $83.00 best and final (R044); signed 12/14/2014 (R047). Receives Longview support (R041). No exit row (winner).')\nline('Bidder 2', 'Financial (member of the 15 financial NDA signers). IOI $78 (R021) revised to $81–$84 (R025); final bids $80.35 (R036) and $81.50 best and final (R042); closed Not selected at signing (R046; Stated; lower offer than rivals).')\nline('Bidder 3', 'Financial. Combined unit of two unnamed final-round bidders (one sought an equity partner; one would drop out unless permitted to combine); formed after 11/03/2014 (R028). Verbal valuation ≤ ~$78 on 12/10 (R037); did not submit a written offer (R038; Stated; Decided by Both; value at or below market price).')\nline('Unnamed bidder 1 (range $80–$85)', 'Financial; individual IOI submitter (R022). Whether it is one of the two Bidder 3 members is not established in the filing — kept as a hypothesis in Q2, not mapped in the ledger.')\nline('Unnamed IOI submitters (residual of 3)', 'Financial; one indicated at or above $80.00 (advanced within the final-round four) and two were below $80.00 (dropped 11/03/2014). Prices and identities not disclosed (R023; R027).')\nline('Industry Participant', 'Strategic operating company in PetSmart\\'s industry; PetSmart explored acquiring it in Spring 2014 (R001) and it re-approached the Company on 08/07/2014 (R009); excluded from the exploratory process (R011; communicated 08/22 and 08/27/2014). Never entered the process; no outcome row.')\nline('Longview Asset Management, LLC', 'Shareholder/activist (~9%); urged a sale and offered a rollover (R007); provided rollover support to the Buyer Group (R041); executed rollover agreement (3,012,050 shares) and voting agreement (7,424,591 shares) on 12/14/2014 (R047). Not a bidder.')\nline('JANA Partners', 'Activist shareholder (9.9% 13D; R006; July 10 meeting and July–August letters; R008). Not a bidder.')\nline('Advisers — target', 'J.P. Morgan Securities LLC — financial advisor; retained July 2014 (engagement letter effective 08/21/2014); fee up to ~$39 million, substantially contingent; disclosed Buyer Group relationships of ~$110 million over two years and the James Crown/Longview connection (R005; XFEE; XREL; XENG). Wachtell, Lipton, Rosen & Katz — legal advisor, first shown advising 06/18/2014; retention date not disclosed (R004). Innisfree M&A Incorporated — proxy solicitor (~$240,000 expected; R049).')\nline('Advisers — buyer side', 'Not disclosed in the supplied filing. Debt financing provided by Citigroup, Barclays, Deutsche Bank, Nomura and Jefferies (initial lenders) plus RBC Capital Markets, Macquarie Capital (USA) and Natixis (XDEBT).')\nblank()\n\nsec('Counts and auction screen (scoped ledger tallies with formulas; Include = No excluded)')\nline('Contacts (formula)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$50,\\'Deal ledger\\'!$D$2:$D$50,\"Contact\",\\'Deal ledger\\'!$P$2:$P$50,\"Yes\")', formula=True)\nline('  reconciliation', 'Filing: \"27 potential participants ... three strategic ... and 24 financial\" (P-011) and \"more than 25\" (XPROC). Ledger contact tally = 27 (3 strategic + 24 financial) plus R009 (Industry Participant first contact, Count 1 on a Bidder interest row; identified inclusion) = 28 distinct contacted parties. Units: parties contacted, not bidders or NDA signers; the 24 include equity-capital suppliers; the 15 signers are a subset.')\nline('NDA signers (formula)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$50,\\'Deal ledger\\'!$D$2:$D$50,\"NDA signed\",\\'Deal ledger\\'!$P$2:$P$50,\"Yes\")', formula=True)\nline('  reconciliation', 'Filing: \"15 potentially interested financial buyers\" / \"approximately 15 parties had expressed interest\" (P-012, P-013). All new signatures in this process; no reuse from an earlier attempt; lender/adviser/rollover-holder agreements excluded. Auction screen: MET — more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements (15 units).')\nline('Round 1 bid units (formula)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$50,\\'Deal ledger\\'!$D$2:$D$50,\"Bid\",\\'Deal ledger\\'!$F$2:$F$50,1,\\'Deal ledger\\'!$P$2:$P$50,\"Yes\")', formula=True)\nline('  reconciliation', 'Filing: \"six of the potentially interested parties submitted indications of interest\" (P-016) and \"first round indications of interest from 5 bidder groups\" (XPROC). Ledger: 6 submitting units = 3 individually described (Buyer Group $81–83; Bidder 2 $78; unnamed $80–85) + residual cohort of 3. The 5-group count is best explained by counting the two later Bidder 3 members as one group (hypothesis in Q2). Revisions carry Count 0 so units are not double-counted.')\nline('Round 2 entrants / units', '4 bidding units admitted at ≥$80.00 (P-017); two combine → 3 units (R028 states units −1). No priced submission in the stage.')\nline('Round 3 bid units (formula)', '=SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$50,\\'Deal ledger\\'!$D$2:$D$50,\"Bid\",\\'Deal ledger\\'!$F$2:$F$50,3,\\'Deal ledger\\'!$P$2:$P$50,\"Yes\")', formula=True)\nline('  reconciliation', '3 units responded to the 12/10/2014 final-bid solicitation (Buyer Group, Bidder 2, Bidder 3); 2 units (Buyer Group, Bidder 2) submitted improved best-and-final bids on 12/12/2014 (Count 0 rows R042–R044 for the same units).')\nline('Outcome tallies', 'Did not submit: formula =SUMIFS(\\'Deal ledger\\'!$Q$2:$Q$50,\\'Deal ledger\\'!$D$2:$D$50,\"Did not submit\",\\'Deal ledger\\'!$P$2:$P$50,\"Yes\") = 10 affected units (9-row inferred residual R024 + Bidder 3 stated R038). Dropped by target: 2 (R027). Not selected at signing: 1 (R046). These are occurrences/affected units, not unique permanent exits.')\nline('Per-stage balance (bidding units)', 'R0: no entrants/admissions (Industry Participant excluded; activists never bid). R1: +15 entrants (R017) − 9 inferred non-submitters (R024) = 6 units. R2: 6 − 2 dropped (R027) = 4 entering − 1 unit from the Bidder 3 combination (R028) = 3 units. R3: 3 − 1 (Bidder 3 did not submit, R038) = 2 − 1 (Bidder 2 not selected at signing, R046) = 1 winner (Buyer Group). Inferred share: 9 of 15 round-1 entrants (60%) are closed by one inferred residual row; no inferred row is needed for the winner; balance never negative.')\nblank()\n\nsec('Comparability and inputs')\nline('Other-scope / context', 'R001 (PetSmart\\'s own attempt to acquire Industry Participant) is context only, outside core bid counts; Industry Participant never entered. No segment, asset or minority-stake proposals occurred.')\nline('Unusual consideration', 'All cash for cashed-out shares; Longview rollover shares (3,012,050; ~$250 million) are exchanged for Parent equity rather than cash. Contingent instruments: none disclosed for shareholders.')\nline('Stated share count / benchmarks', '99,455,151 shares outstanding at the 01/29/2015 record date (XSH); market closes $78.82 (12/09/2014) and $59.81 (07/02/2014); 38.8% premium to the 07/02/2014 price (XPREM; XMKT); J.P. Morgan DCF reference range $78.25–$106.25 (XDCF); estimated net debt/(cash) of $91 million as of 01/31/2015 used in a J.P. Morgan sensitivity (XND).')\nline('Labelled calculation (not stated)', 'Record-date shares × merger consideration: 99,455,151 × $83.00 = $8,254,777,533 (~$8.25 billion). This is a labelled arithmetic calculation, not a stated deal value and not a bid.')\nline('Glossary', 'NDA = confidentiality agreement; IOI = indication of interest; final round = the target-organized stage admitting selected bidders to final diligence and bidding; standstill = confidentiality-agreement provision barring a signer from bidding once a definitive agreement is signed; rollover = contributing shares to the buyer for equity instead of cash; reverse termination fee = fee payable by the buyer if the deal fails in specified circumstances; HSR = U.S. Hart-Scott-Rodino antitrust waiting period; CVR = contingent value right (none here).')\nblank()\nline('Note on formulas', 'All formula totals are scoped by What happened / Process / Round / Include and exclude Include = No; blank Count cells are ignored by SUMIFS. They are working research totals, not audited sums.')\n\n# ============================================================================\n# Questions\n# ============================================================================\nqs = wb.create_sheet('Questions', 3)\nQHDR = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\nfor j, h in enumerate(QHDR, start=1):\n    c = qs.cell(row=1, column=j, value=h)\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\n\nQUESTIONS = [\n ('Q1','Process and round map: single process; R1 anchor; R2/R3 split; finality values',\n  'Keep one process (the 2014 sale attempt ending in the 12/14/2014 signing). Round 1 opens with the confidentiality-agreement wave (R016 anchor; rejected candidates R010, R012, R013/R014, R015 remain separate rows). Split Round 2 (11/03/2014 selection; Inferred final) from Round 3 (November first request for final bids; Announced as final). Alternatives: a two-round map folding R2/R3, or anchoring R3 on the 12/04–05 final-bid deadline.',\n  'R1 anchor: the filing reports no clean target outreach wave and parties contacted or were contacted by J.P. Morgan (P-013; P-011). R2/R3: selection to the \"final round\" (P-017) is followed by the merger-agreement circulation with instructions to submit \"final bids\" (P-019) — the instruction makes the first final-offer request a new round. R2 finality inferred from selection/definitive-negotiation progress; R3 announced via \"final bids\"/\"best and final\" (P-021; P-029).',\n  'Rounds on R010–R016, R026, R029–R034, R040; Round finality on R016 (Not final), R026 (Inferred final), R029 (Announced as final)',\n  'Moving the R1 boundary to 08/13, 08/19 or 10/03 shifts R013–R015 into Round 1; folding R2/R3 changes round-bidder tallies (currently R1 = 6, R3 = 3 new units) and the finality labels. Boundary-candidate rows are isolated so either move is mechanical.',\n  'Pending',''),\n ('Q2','Round-1 and final-round counts and identities: six IOIs vs \"5 bidder groups\"; four bidders ≥ $80 vs three described ranges; residual cohort; Bidder 3 membership',\n  'Read the six IOI submitters as: Buyer Group ($81–83), Bidder 2 ($78, revised $81–84), Unnamed bidder 1 ($80–85) and a 3-unit residual cohort (one at/above $80, two below). Read the four ≥$80 finalists as Buyer Group, Bidder 2 and the two bidders later forming Bidder 3, so the final round falls to 3 units post-combination. Do not map Unnamed bidder 1 or any specific bidder to a Bidder 3 member.',\n  'Six submitters stated (P-016); four advanced (P-017); \"5 bidder groups\" (XPROC); two bidders formed Bidder 3 (P-018). The filing does not name the members or the fourth ≥$80 unit. The recommended reading makes all counts reconcile without inventing identities.',\n  'R020–R023 (bids/residual), R026 (four admitted), R027 (two dropped), R028 (Bidder 3 formation), R046 (Bidder 2 outcome)',\n  'If the two Bidder 3 members were not both among the four admitted, the final round would carry an extra unnamed bidder needing its own close-out and the R2 unit balance would change (currently 4 → 3). If \"5 bidder groups\" counts something else, Round 1 bid units stay 6 but the group tally presentation changes.',\n  'Pending',''),\n ('Q3','Bidder types and anonymous identities',\n  'Keep every bidder unit classified Financial on the filing\\'s own description of the 15 signers as \"financial buyers\" (P-013), including Bidder 2, Unnamed bidder 1 and Bidder 3. Do not identify anonymous participants from outside knowledge; no person/entity mapping is asserted for Unnamed bidder 1 or the Bidder 3 members.',\n  'P-013 describes the confidentiality signers as financial buyers; bidders drew from that population; Bidder 3\\'s members had prior large-LBO experience (P-018). No strategic bidder entered; the winner is a PE-led consortium (XBG).',\n  'Type cells on R020–R023, R025, R028, R035–R038, R042–R044',\n  'A different type basis would change cohort descriptions but no counts; leaving the winner Unknown is not supported (BC Partners consortium).',\n  'Pending',''),\n ('Q4','Formality and Conditions borderline calls (IOIs; December bids; Bidder 3 bound-only valuation)',\n  'Keep IOIs Informal with Conditions \"Insufficient evidence\" (prices stated, financing/conditions silent, substantive October diligence access context). Keep the 12/10–12/12 Buyer Group and Bidder 2 bids Formal/Light (returned revised transaction documents and financing commitments; no reported Heavy trigger). Keep Bidder 3\\'s verbal ≤ ~$78 indication Informal (no documentation) and its price as Bound only (Price high 78; no low endpoint).',\n  'IOIs: \"non-binding preliminary indications\" (P-014, P-016). December: final bid letters with \"revised versions of the merger agreement\" (P-025) and, on 12/12, \"revised draft ... and copies of their respective financing commitment documents\", Buyer Group versions \"substantially executable\" (P-029); committed financing per \"committed debt financing ... and committed equity financing\" (p. 28 quote in XCOND context) and XEQ. Bidder 3: \"valuation would not be above the current stock price of approximately $78\" (P-025).',\n  'Formality/Conditions on R020–R023, R025, R035–R037, R042–R044; Conditions detail strings on the same rows',\n  'Reclassifying formality/conditions affects review flags and which signals are credited, not counts. If the IOIs were judged Heavy by context, the conditions labels on R020–R023/R025 would change to Heavy; if Bidder 3 was judged to have submitted a formal indication, its formality would rise but the no-write-offer record stands.',\n  'Pending',''),\n ('Q5','Inferred closing-out of participants (9 non-submitting NDA signers at the 10/30/2014 solicitation)',\n  'Keep one inferred residual row (R024): 15 NDA signers − 6 submitters = 9 non-submitters, Outcome basis Inferred: residual, Decided by Unknown, Exit reason Not stated, Count 9, Working date = the 10/30/2014 due date. All other close-outs are stated: 2 dropped (R027), Bidder 3 did not submit (R038), Bidder 2 not selected at signing (R046); the winner has no exit row.',\n  'Base: 15 signers and the October IOI instruction (P-013, P-014); submitters: six (P-016). The arithmetic assumes every signer was eligible to submit and the six exhaust the submissions; non-submission at this solicitation is not permanent withdrawal and does not reveal identity or motive. Two strategic contacts never entered and need no close-out.',\n  'R024 (inferred row); related tallies on R017, R020–R023; balance shown in Summary',\n  'If a non-submitter had actually advanced to the final round by an oral indication, the residual would still count 9 non-submissions at the written IOI step, but the four-finalist composition reading in Q2 would shift; if some signers were not invited to submit, the base would be smaller and Count would fall accordingly.',\n  'Pending',''),\n ('Q6','Deadlines and working-date conventions (12/05 superseded; 12/10 Extended; 12/12 Enforced; assigned dates deciding order)',\n  'Keep the deadline history as extracted: 12/05/2014 initial date set (R032, superseded before arrival; no milestone row), revised 12/04–05 to 12/10 (R033) so R034 reads Extended, improved bids due 12/12 (R039) with R040 Enforced. Keep assigned Working dates that decide in-round order where days are undisclosed (R025 midpoint 10/31; R029/R030 November midpoint 11/15; R028 first day after selection 11/04; R018 midpoint 10/15; R024 due date 10/30).',\n  'Deadline facts: P-020 (initial 12/15 completion and 12/05 submissions), P-021 (12/10 set), P-026 (12/12 request). Treatment decisions follow the instruction rules and what followed in each round (board selection 11/03; board approval 12/13). Assigned dates are disclosed conventions, not observed dates.',\n  'R018, R019, R024, R025, R028–R034, R040; Date basis/method fields on those rows',\n  'Changing treatments would alter the Summary deadline map (e.g., reading 12/10 as Enforced if the 12/12 request is not treated as its extension). Moving assigned dates may reorder rows within the round; Row ids and quotes would need re-sorting.',\n  'Pending',''),\n ('Q7','Advisers and conflicts (J.P. Morgan; Wachtell Lipton; Innisfree; buyer-side advisers)',\n  'Keep J.P. Morgan as the target\\'s financial adviser with the disclosed conflict facts in the row (fee up to ~$39 million, substantially contingent; ~$110 million of Buyer Group relationships over two years; James Crown\\'s Longview/JPMorgan Chase connection). Keep Wachtell Lipton as service observed with the retention date undisclosed. Keep Innisfree as a disclosed proxy-solicitation adviser. Buyer-side advisers: not disclosed.',\n  'P-005, XENG, XFEE, XREL, P-037 quote (relationships), XINN, P-004. The filing discloses the relationships itself; no outside knowledge is used.',\n  'R004, R005, R049; Summary adviser block',\n  'If reviewers prefer strict adviser-only rows, Innisfree moves to Summary; J.P. Morgan conflict facts would remain because the filing makes them material to the fairness opinion and the board\\'s process.',\n  'Pending',''),\n ('Q8','Coverage conventions (Industry Participant context; rollover communication; regulatory/litigation; no go-shop)',\n  'Keep Industry Participant as one context row (R001) plus the exclusion decision (R011), outside core bid and auction-screen counts; it never entered and is never closed. Keep the October Longview rollover communication folded into R018 (stage information), with the support relationship recorded once at formation (R041) and once through signing (R047). Keep regulatory filings/clearances and the seven class actions in one Summary line each. No go-shop row: none was provided; the standstills are recorded on R017.',\n  'R001/P-002 and P-008–P-010 (Industry Participant); P-014/P-015 (rollover communication); P-013/XSTAND (standstills); XHSR (regulatory); XLIT (litigation); XNOOFF (no unsolicited offer as of 02/02/2015).',\n  'R001, R011, R017, R018, R041; Summary coverage lines',\n  'If reviewers want the Industry Participant attempt excluded entirely, R001 can be set Include = No without disturbing counts; if the rollover communication should be its own row, R018 splits into deadline-set and a Material process update.',\n  'Pending',''),\n]\nfor i, row in enumerate(QUESTIONS):\n    rr = i + 2\n    for j, v in enumerate(row, start=1):\n        c = qs.cell(row=rr, column=j, value=v)\n        c.font = Font(size=10); c.alignment = WRAP; c.border = BORDER\n        if j == 1:\n            c.alignment = WRAP_C\nqs.column_dimensions['A'].width = 6\nqs.column_dimensions['B'].width = 38\nqs.column_dimensions['C'].width = 70\nqs.column_dimensions['D'].width = 70\nqs.column_dimensions['E'].width = 30\nqs.column_dimensions['F'].width = 50\nqs.column_dimensions['G'].width = 10\nqs.column_dimensions['H'].width = 18\nqs.freeze_panes = 'A2'\n\n# order sheets\nwb._sheets = [wb['Deal ledger'], wb['Summary'], wb['Questions'], wb['Source text'], wb['Lists']]\nwb['Lists'].sheet_state = 'hidden'\nwb.active = 0\nimport os\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\nwb.save(OUT)\nprint('saved', OUT)\n","path":"/tmp/opencode/petsmart/write_book.py"},"output":"Created file successfully: /tmp/opencode/petsmart/write_book.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/petsmart/write_book.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Write the petsmart ledger workbook.\\\"\\\"\\\"\\nimport json, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment, PatternFill, Border, Side\\nfrom openpyxl.utils import get_column_letter\\nfrom openpyxl.worksheet.datavalidation import DataValidation\\nfrom openpyxl.workbook.defined_name import DefinedName\\n\\nLA = json.load(open('/tmp/opencode/petsmart/ledger_draft.json'))\\nSRC = json.load(open('/tmp/opencode/petsmart/source_rows.json'))\\n\\nOUT = '/home/uctpiaj/work/extraction/petsmart.xlsx'\\n\\n# ---------- styles ----------\\nHDR_FILL = PatternFill('solid', fgColor='1F3864')\\nHDR_FONT = Font(bold=True, color='FFFFFF', size=10)\\nSEC_FILL = PatternFill('solid', fgColor='D9E2F3')\\nSEC_FONT = Font(bold=True, size=11)\\nWRAP = Alignment(wrap_text=True, vertical='top')\\nWRAP_C = Alignment(wrap_text=True, vertical='top', horizontal='center')\\nTHIN = Side(style='thin', color='BFBFBF')\\nBORDER = Border(left=THIN, right=THIN, top=THIN, bottom=THIN)\\nLINK_FONT = Font(color='0563C1', underline='single', size=10)\\nBODY = Font(size=10)\\n\\nwb = Workbook()\\n\\n# ============================================================================\\n# Lists sheet (hidden)\\n# ============================================================================\\nLISTS = [\\n ('What happened', ['Target interest','Bidder interest','Target sale decision','Activist pressure','Activist involvement','Adviser engaged','Adviser service observed','Adviser ended','Contact','NDA signed','Round opened','Deadline set','Deadline revised','Deadline','Target decision','Information access changed','Material process update','Exclusivity changed','Bid','Bid reaffirmed','Offer update','Other-scope bid','Valuation statement','Bidding group changed','Joined group','Dropped by target','Withdrew','Did not submit','Participation paused','Re-entered','Not selected at signing','Sale process announced','Bid announced','Merger announced','Merger agreement signed','Go-shop changed','Process terminated','Process restarted','Agreement terminated','Closed']),\\n ('Type', ['Strategic','Financial','Mixed','Unknown']),\\n ('Formality', ['Formal','Informal','Insufficient evidence','Varies']),\\n ('Conditions level', ['None','Light','Heavy','Insufficient evidence','Varies']),\\n ('Include', ['Yes','No']),\\n ('Date basis', ['Reported day','Inferred day','Reported interval','Approximate window','Relative only','Undated']),\\n ('Date method', ['Reported','Inferred','Assigned: deadline','Assigned: decision day','Assigned: midpoint','Assigned: bound','Assigned: sequence']),\\n ('Price kind', ['Point','Bidder range','Group envelope','Bound only','Undisclosed']),\\n ('Price origin', ['Stated','Carried forward','Inferred']),\\n ('All cash', ['Yes','No','Not stated']),\\n ('Deadline treatment', ['Extended','Late bids accepted','Extended; Late bids accepted','Enforced','Passed without action','Unclear','No deadline stated']),\\n ('Round finality', ['Announced as final','Inferred final','Not final']),\\n ('Decided by', ['Bidder','Target','Both','Unknown']),\\n ('Exit reason', ['Value below market price','Value at or below market price','Value below earlier offer','Value at earlier offer','Would not improve earlier offer','Lower offer than rivals','Terms or process','Other stated reason','Not stated']),\\n ('Outcome basis', ['Stated','Inferred: residual','Inferred: exclusivity','Inferred: silent','Inferred: identity']),\\n]\\nls = wb.active\\nls.title = 'Lists'\\nfor col, (name, vals) in enumerate(LISTS, start=1):\\n    c = get_column_letter(col)\\n    ls[f'{c}1'] = name\\n    ls[f'{c}1'].font = Font(bold=True, size=10)\\n    for i, v in enumerate(vals, start=2):\\n        ls[f'{c}{i}'] = v\\n    ls.column_dimensions[c].width = max(14, min(30, max(len(v) for v in vals) + 2))\\n    dn = 'List_' + ''.join(ch for ch in name.title() if ch.isalnum())\\n    ref = f\\\"Lists!${c}$2:${c}${len(vals)+1}\\\"\\n    wb.defined_names.add(DefinedName(dn, attr_text=ref))\\n\\n# ============================================================================\\n# Deal ledger\\n# ============================================================================\\nws = wb.create_sheet('Deal ledger', 0)\\nHEAD = ['#','When','Who','What happened','Process','Round','Type','Terms or outcome','Formality','Conditions level',\\n        'Why and evidence','Source','Review','Reviewer note',\\n        'Row id','Include','Count','Date from','Date to','Working date','Date basis','Date method',\\n        'Price low','Price high','Price kind','Price origin','Currency','All cash','Cash at closing',\\n        'Conditions detail','Due date','Deadline treatment','Round finality','Decided by','Exit reason','Outcome basis',\\n        'Page','Related rows','Deal']\\nfor j, h in enumerate(HEAD, start=1):\\n    c = ws.cell(row=1, column=j, value=h)\\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\n\\ndef val(r, k):\\n    return r.get(k)\\n\\nfor i, r in enumerate(LA):\\n    row = i + 2\\n    reason = r['why']\\n    if r['quotes']:\\n        qs = ' '.join(f\\\"“{q['text']}” (p. {q['page']})\\\" for q in r['quotes'])\\n        reason = reason + ' Quotation' + ('s' if len(r['quotes'])>1 else '') + ': ' + qs\\n    src_txt = '; '.join(r['src_ids'])\\n    data = [r['num'], r['when'], r['who'], r['what'], r['process'], int(r['round']) if r['round'].isdigit() else r['round'],\\n            r['type'], r['terms'], r['formality'], r['cond_level'], reason, src_txt, r['review'], '',\\n            r['rid'], 'Yes', r['count'], r['dfrom'], r['dto'], r['wdate'], r['basis'], r['method'],\\n            r['plow'], r['phigh'], r['pkind'], r['porigin'], r['ccy'], r['allcash'], r['cashclose'],\\n            r['conddetail'], r['duedate'], r['dtreat'], r['rfinal'], r['decidedby'], r['exitreason'], r['obasis'],\\n            r['page'], r['related'], r['deal']]\\n    for j, v in enumerate(data, start=1):\\n        c = ws.cell(row=row, column=j, value=v)\\n        c.font = BODY; c.border = BORDER\\n        c.alignment = WRAP\\n        if j in (1,5,6,13,16,17,20,22,25,26,27,28,32,33,34,35,36,37):\\n            c.alignment = WRAP_C\\n        if j in (18,19,20,31):\\n            c.number_format = 'MM/DD/YYYY'\\n        if j in (23,24,29):\\n            c.number_format = '#,##0.00'\\n        if j == 11:\\n            c.font = Font(size=10)\\n    # local link on Source cell to main paragraph\\n    sc = ws.cell(row=row, column=12)\\n    sc.hyperlink = f\\\"#'Source text'!A{SRC.index(next(s for s in SRC if s['id']==r['main_id']))+2}\\\"\\n    sc.font = LINK_FONT\\n\\nwidths = {'A':4,'B':26,'C':26,'D':18,'E':8,'F':7,'G':11,'H':64,'I':12,'J':15,'K':95,'L':20,'M':10,'N':14,\\n          'O':8,'P':8,'Q':7,'R':10,'S':10,'T':11,'U':15,'V':15,'W':9,'X':9,'Y':12,'Z':10,'AA':8,'AB':9,'AC':11,\\n          'AD':46,'AE':10,'AF':15,'AG':13,'AH':10,'AI':20,'AJ':14,'AK':6,'AL':16,'AM':9}\\nfor c, w in widths.items():\\n    ws.column_dimensions[c].width = w\\n# collapsed expandable groups\\nfor start, end in [('O','P'),('Q','Q'),('R','V'),('W','AA'),('AB','AC'),('AD','AD'),('AE','AG'),('AH','AJ'),('AK','AK'),('AL','AL'),('AM','AM')]:\\n    ws.column_dimensions.group(start, end, outline_level=1, hidden=True)\\nws.freeze_panes = 'D2'\\nws.auto_filter.ref = f'A1:AM{len(LA)+1}'\\nws.sheet_properties.outlinePr.summaryRight = False\\n\\n# data validations\\nDV_COLS = {'D':'List_WhatHappened','G':'List_Type','I':'List_Formality','J':'List_ConditionsLevel','P':'List_Include',\\n           'U':'List_DateBasis','V':'List_DateMethod','Y':'List_PriceKind','Z':'List_PriceOrigin','AB':'List_AllCash',\\n           'AF':'List_DeadlineTreatment','AG':'List_RoundFinality','AH':'List_DecidedBy','AI':'List_ExitReason','AJ':'List_OutcomeBasis'}\\nfor col, dn in DV_COLS.items():\\n    dv = DataValidation(type='list', formula1=f'={dn}', allow_blank=True, showErrorMessage=True)\\n    ws.add_data_validation(dv)\\n    dv.add(f'{col}2:{col}{len(LA)+1}')\\n\\n# ============================================================================\\n# Source text\\n# ============================================================================\\nss = wb.create_sheet('Source text', 1)\\nfor j, h in enumerate(['Paragraph','Section','Page','Text'], start=1):\\n    c = ss.cell(row=1, column=j, value=h)\\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\nfor i, s in enumerate(SRC):\\n    row = i + 2\\n    ss.cell(row=row, column=1, value=s['id']).font = BODY\\n    ss.cell(row=row, column=2, value=s['section']).font = BODY\\n    ss.cell(row=row, column=3, value=s['page']).font = BODY\\n    tc = ss.cell(row=row, column=4, value=s['text']); tc.font = BODY\\n    for j in range(1,5):\\n        ss.cell(row=row, column=j).alignment = WRAP\\n        ss.cell(row=row, column=j).border = BORDER\\nss.column_dimensions['A'].width = 10\\nss.column_dimensions['B'].width = 26\\nss.column_dimensions['C'].width = 6\\nss.column_dimensions['D'].width = 150\\nss.freeze_panes = 'A2'\\nss.auto_filter.ref = f'A1:D{len(SRC)+1}'\\n\\n# ============================================================================\\n# Summary\\n# ============================================================================\\nsm = wb.create_sheet('Summary', 2)\\nsm.column_dimensions['A'].width = 44\\nsm.column_dimensions['B'].width = 132\\nr = 1\\ndef sec(title):\\n    global r\\n    c = sm.cell(row=r, column=1, value=title); c.font = SEC_FONT; c.fill = SEC_FILL\\n    sm.cell(row=r, column=2).fill = SEC_FILL\\n    r += 1\\ndef line(label, value, bold=False, formula=False):\\n    global r\\n    a = sm.cell(row=r, column=1, value=label); a.font = Font(bold=bold, size=10); a.alignment = WRAP\\n    b = sm.cell(row=r, column=2, value=value); b.font = Font(bold=bold, size=10); b.alignment = WRAP\\n    if formula:\\n        b.value = value\\n    r += 1\\ndef blank():\\n    global r\\n    r += 1\\n\\nt = sm.cell(row=1, column=1, value='PetSmart, Inc. — deal ledger summary (target: petsmart / BC Partners-led Buyer Group / Argos Holdings)')\\nt.font = Font(bold=True, size=13)\\nr = 2\\n\\nsec('Status, instruction and source coverage')\\nline('Status', 'AI first pass; not human-approved.')\\nline('Instruction', 'SEC deal-ledger extraction instruction, short-form revision of 19 September 2026 (ledger rules and schema; no self-check/correction sheet requested).')\\nline('Source coverage', 'Supplied filing only: PetSmart DEFM14A filed 02/02/2015 (raw_filing/petsmart_2015-02-02_DEFM14A.htm). Primary extraction from the Background of the Merger (pp. 21–26); cross-checked against the Summary (pp. 1–9), Reasons for the Merger (pp. 26–30), Opinion of J.P. Morgan (pp. 30–37), Projected Financial Information (pp. 37–40), Financing (pp. 40–45), Termination Fee Commitment Letters (p. 44), Voting Support Agreement (p. 45), the merger-agreement description (pp. 53–73), Regulatory Approvals and Litigation (p. 52). Source text is HTML-decoded with layout-only whitespace normalization; all quotations are recoverable from the Source text sheet.')\\nblank()\\n\\nsec('Commercial account')\\nsm.cell(row=r-1, column=1).value = None\\naccount = (\\\"PetSmart entered 2014 reviewing alternatives — including a possible combination with a privately-held industry participant — and, \\\"\\n \\\"after a weak first quarter, faced stockholder and activist pressure (JANA Partners' 13D of 07/03/2014 at 9.9%; Longview's public sale advocacy of \\\"\\n \\\"07/07/2014) that pushed the board into a formal exploration announced 08/19/2014. Through an independent-director ad hoc committee and J.P. Morgan, \\\"\\n \\\"the target contacted 27 potential participants, signed confidentiality and standstill agreements with 15 financial buyers in early October, and received \\\"\\n \\\"six non-binding indications of interest on 10/30/2014 (three individually described $80–$85 ranges and three residual submitters). On 11/03/2014 the board \\\"\\n \\\"advanced the four bidders at or above $80.00 to a final round; two bidders combined into 'Bidder 3'. Final bids on 12/10/2014 were $80.70 in cash from the \\\"\\n \\\"Buyer Group and $80.35 from Bidder 2, with Bidder 3 dropping out at a valuation at or below about $78; after the target demanded improvements, Bidder 2 \\\"\\n \\\"delivered a best-and-final $81.50 and the Buyer Group a best-and-final $83.00 in cash on 12/12/2014. The board approved the Buyer Group on 12/13/2014 and \\\"\\n \\\"the merger agreement was signed and announced on 12/14/2014: $83.00 per share in cash, with Longview rolling over 3,012,050 shares (~$250 million) into \\\"\\n \\\"Parent and voting its 7,424,591 shares for the deal. No superior proposal is reported as of the 02/02/2015 proxy; closing was expected in the first half of \\\"\\n \\\"2015 and is not observed in the filing.\\\")\\nline('Sale story', account)\\nblank()\\n\\nsec('Deal facts')\\nline('Target', 'PetSmart, Inc., a Delaware corporation (principal offices Phoenix, AZ); NASDAQ: PETM; 1,404 stores and 202 in-store boarding facilities. [XPS]')\\nline('Focal acquirer', 'Argos Holdings Inc. (\\\"Parent\\\") and Argos Merger Sub Inc. — affiliates of funds advised by BC Partners, Inc.; at closing owned by the Buyer Group: funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd, affiliates of StepStone Group LP, and (at all times after 12/12/2014) Longview Asset Management, LLC. Type: Financial (PE-led consortium of financial investors). [XBG; XARG; XOWN]')\\nline('Agreed consideration', '$83.00 per share in cash for each outstanding share (other than excluded/appraisal shares); Longview contributes 3,012,050 shares (~$250 million worth) to Parent for equity and receives $83.00 on its other shares; voting agreement covers 7,424,591 shares (~7.5%). [XEFF; XROLL; XLVS; XVOTE]')\\nline('Financing / funds', 'Total funds required estimated at ~$8.4 billion: cash equity commitments up to ~$1.83 billion plus Longview stock ($250 million); committed debt up to $6.95 billion ($4.3bn term loan B, $750m ABL revolver, $1.9bn bridge/senior notes); ~$425 million cash on hand; not subject to a financing condition. [XFIN; XNOFIN; XEQ; XDEBT]')\\nline('Signing / announcement / closing', 'Signed 12/14/2014; announced 12/14/2014 (press release with signing). Completion expected in the first half of 2015 (end date 06/14/2015) — no closing observed in the supplied filing. Signing, announcement and (unobserved) closing kept separate. [P-031; XCLOSE; XTERN]')\\nline('Termination fees', 'Company termination fee $255 million; Parent reverse termination fee $510 million (supported by several Buyer Group termination-fee commitment letters up to the $510 million cap); expense reimbursement up to $15 million. [XCTF; XPTF; XTFC; XTFC2; XEXP]')\\nline('Filing identity and link', 'DEFM14A definitive proxy statement, filed 02/02/2015, for the special meeting on 03/06/2015; record date 01/29/2015, 99,455,151 shares outstanding. Background at pp. 21–26. Local source: ../raw_filing/petsmart_2015-02-02_DEFM14A.htm')\\nblank()\\n\\nsec('Process and round map (Process 1 — single continuing sale attempt; ends in signing; no termination or restart observed)')\\nline('Round 0 (no Round opened row)', 'Pre-process: Industry Participant approaches and exclusion (R001, R009, R011); JANA/Longview activism (R006–R008); 06/18/2014 capital-structure review and adviser search (R003–R005); 08/13/2014 sale decision (R010); 08/19/2014 announcement (R012); 27 contacts incl. ~15 expressions of interest (R013/R014, R015).')\\nline('Round 1 — solicitation / IOI stage', 'Opened R016, anchored on the confidentiality-agreement wave (first week of October 2014; Not final). Scope: 15 financial NDA signers (R017; all engaged in diligence and received the Profit Improvement Plan information). Deadline set in October: non-binding IOIs due 10/30/2014 (R018), treatment Enforced (R019). Six indicated (R020–R023); nine non-submitters inferred (R024). Two submitters eliminated on 11/03/2014 (R027). Round-bidder tally: 6 new bidder units.')\\nline('Round 2 — finalist stage', 'Opened R026 on 11/03/2014 (Inferred final): four bidders at/above $80.00 advanced (Buyer Group, Bidder 2, and the two bidders later forming Bidder 3; see Q2). Two bidders authorized to combine → Bidder 3 (R028; final-round units 4 → 3). Further diligence during November. Round-bidder tally: 0 new bid units (no priced submission in this stage).')\\nline('Round 3 — final-bid stage', 'Opened R029, anchored on the first request for final bids (merger-agreement circulation, November 2014; Announced as final). Deadline history: 12/05/2014 initial date set (R032; superseded before arrival, no milestone row) → revised 12/04–05 to evening 12/10/2014 (R033), treatment Extended (R034) → improved bids 12/12/2014 (R039), treatment Enforced (R040). Bids: 12/10 — Buyer Group $80.70 cash (R035), Bidder 2 $80.35 cash (R036), Bidder 3 verbal ≤ ~$78 (R037; did not submit, R038); 12/12 — Bidder 2 $81.50 best-and-final (R042), Buyer Group $82.50 interim (R043) then $83.00 best-and-final (R044). Approval 12/13/2014 (R045); Bidder 2 not selected at signing (R046). Round-bidder tally: 3 new bid units; 2 units submitted improved best-and-final bids.')\\nline('Post-signing', 'No post-signing competing proposals, go-shop or agreement termination observed. No go-shop was provided; the 15 signers\\\\' standstills limit post-signing bids (XSTAND). As of 02/02/2015 no unsolicited offer had been made (XNOOFF).')\\nblank()\\n\\nsec('Participants and advisers')\\nline('Buyer Group (winner)', 'Financial. Consortium of funds advised by BC Partners, Inc., La Caisse de dépôt et placement du Québec, affiliates of GIC Special Investments Pte Ltd and affiliates of StepStone Group LP; Longview Asset Management, LLC joins after 12/12/2014 (rollover, not a bidding-unit membership change). First observed 10/30/2014 (IOI $81–$83; R020); final bids $80.70 (R035), $82.50 interim (R043), $83.00 best and final (R044); signed 12/14/2014 (R047). Receives Longview support (R041). No exit row (winner).')\\nline('Bidder 2', 'Financial (member of the 15 financial NDA signers). IOI $78 (R021) revised to $81–$84 (R025); final bids $80.35 (R036) and $81.50 best and final (R042); closed Not selected at signing (R046; Stated; lower offer than rivals).')\\nline('Bidder 3', 'Financial. Combined unit of two unnamed final-round bidders (one sought an equity partner; one would drop out unless permitted to combine); formed after 11/03/2014 (R028). Verbal valuation ≤ ~$78 on 12/10 (R037); did not submit a written offer (R038; Stated; Decided by Both; value at or below market price).')\\nline('Unnamed bidder 1 (range $80–$85)', 'Financial; individual IOI submitter (R022). Whether it is one of the two Bidder 3 members is not established in the filing — kept as a hypothesis in Q2, not mapped in the ledger.')\\nline('Unnamed IOI submitters (residual of 3)', 'Financial; one indicated at or above $80.00 (advanced within the final-round four) and two were below $80.00 (dropped 11/03/2014). Prices and identities not disclosed (R023; R027).')\\nline('Industry Participant', 'Strategic operating company in PetSmart\\\\'s industry; PetSmart explored acquiring it in Spring 2014 (R001) and it re-approached the Company on 08/07/2014 (R009); excluded from the exploratory process (R011; communicated 08/22 and 08/27/2014). Never entered the process; no outcome row.')\\nline('Longview Asset Management, LLC', 'Shareholder/activist (~9%); urged a sale and offered a rollover (R007); provided rollover support to the Buyer Group (R041); executed rollover agreement (3,012,050 shares) and voting agreement (7,424,591 shares) on 12/14/2014 (R047). Not a bidder.')\\nline('JANA Partners', 'Activist shareholder (9.9% 13D; R006; July 10 meeting and July–August letters; R008). Not a bidder.')\\nline('Advisers — target', 'J.P. Morgan Securities LLC — financial advisor; retained July 2014 (engagement letter effective 08/21/2014); fee up to ~$39 million, substantially contingent; disclosed Buyer Group relationships of ~$110 million over two years and the James Crown/Longview connection (R005; XFEE; XREL; XENG). Wachtell, Lipton, Rosen & Katz — legal advisor, first shown advising 06/18/2014; retention date not disclosed (R004). Innisfree M&A Incorporated — proxy solicitor (~$240,000 expected; R049).')\\nline('Advisers — buyer side', 'Not disclosed in the supplied filing. Debt financing provided by Citigroup, Barclays, Deutsche Bank, Nomura and Jefferies (initial lenders) plus RBC Capital Markets, Macquarie Capital (USA) and Natixis (XDEBT).')\\nblank()\\n\\nsec('Counts and auction screen (scoped ledger tallies with formulas; Include = No excluded)')\\nline('Contacts (formula)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$50,\\\\'Deal ledger\\\\'!$D$2:$D$50,\\\"Contact\\\",\\\\'Deal ledger\\\\'!$P$2:$P$50,\\\"Yes\\\")', formula=True)\\nline('  reconciliation', 'Filing: \\\"27 potential participants ... three strategic ... and 24 financial\\\" (P-011) and \\\"more than 25\\\" (XPROC). Ledger contact tally = 27 (3 strategic + 24 financial) plus R009 (Industry Participant first contact, Count 1 on a Bidder interest row; identified inclusion) = 28 distinct contacted parties. Units: parties contacted, not bidders or NDA signers; the 24 include equity-capital suppliers; the 15 signers are a subset.')\\nline('NDA signers (formula)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$50,\\\\'Deal ledger\\\\'!$D$2:$D$50,\\\"NDA signed\\\",\\\\'Deal ledger\\\\'!$P$2:$P$50,\\\"Yes\\\")', formula=True)\\nline('  reconciliation', 'Filing: \\\"15 potentially interested financial buyers\\\" / \\\"approximately 15 parties had expressed interest\\\" (P-012, P-013). All new signatures in this process; no reuse from an earlier attempt; lender/adviser/rollover-holder agreements excluded. Auction screen: MET — more than one independent prospective acquiring bidder unit executed bidder-target confidentiality agreements (15 units).')\\nline('Round 1 bid units (formula)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$50,\\\\'Deal ledger\\\\'!$D$2:$D$50,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$50,1,\\\\'Deal ledger\\\\'!$P$2:$P$50,\\\"Yes\\\")', formula=True)\\nline('  reconciliation', 'Filing: \\\"six of the potentially interested parties submitted indications of interest\\\" (P-016) and \\\"first round indications of interest from 5 bidder groups\\\" (XPROC). Ledger: 6 submitting units = 3 individually described (Buyer Group $81–83; Bidder 2 $78; unnamed $80–85) + residual cohort of 3. The 5-group count is best explained by counting the two later Bidder 3 members as one group (hypothesis in Q2). Revisions carry Count 0 so units are not double-counted.')\\nline('Round 2 entrants / units', '4 bidding units admitted at ≥$80.00 (P-017); two combine → 3 units (R028 states units −1). No priced submission in the stage.')\\nline('Round 3 bid units (formula)', '=SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$50,\\\\'Deal ledger\\\\'!$D$2:$D$50,\\\"Bid\\\",\\\\'Deal ledger\\\\'!$F$2:$F$50,3,\\\\'Deal ledger\\\\'!$P$2:$P$50,\\\"Yes\\\")', formula=True)\\nline('  reconciliation', '3 units responded to the 12/10/2014 final-bid solicitation (Buyer Group, Bidder 2, Bidder 3); 2 units (Buyer Group, Bidder 2) submitted improved best-and-final bids on 12/12/2014 (Count 0 rows R042–R044 for the same units).')\\nline('Outcome tallies', 'Did not submit: formula =SUMIFS(\\\\'Deal ledger\\\\'!$Q$2:$Q$50,\\\\'Deal ledger\\\\'!$D$2:$D$50,\\\"Did not submit\\\",\\\\'Deal ledger\\\\'!$P$2:$P$50,\\\"Yes\\\") = 10 affected units (9-row inferred residual R024 + Bidder 3 stated R038). Dropped by target: 2 (R027). Not selected at signing: 1 (R046). These are occurrences/affected units, not unique permanent exits.')\\nline('Per-stage balance (bidding units)', 'R0: no entrants/admissions (Industry Participant excluded; activists never bid). R1: +15 entrants (R017) − 9 inferred non-submitters (R024) = 6 units. R2: 6 − 2 dropped (R027) = 4 entering − 1 unit from the Bidder 3 combination (R028) = 3 units. R3: 3 − 1 (Bidder 3 did not submit, R038) = 2 − 1 (Bidder 2 not selected at signing, R046) = 1 winner (Buyer Group). Inferred share: 9 of 15 round-1 entrants (60%) are closed by one inferred residual row; no inferred row is needed for the winner; balance never negative.')\\nblank()\\n\\nsec('Comparability and inputs')\\nline('Other-scope / context', 'R001 (PetSmart\\\\'s own attempt to acquire Industry Participant) is context only, outside core bid counts; Industry Participant never entered. No segment, asset or minority-stake proposals occurred.')\\nline('Unusual consideration', 'All cash for cashed-out shares; Longview rollover shares (3,012,050; ~$250 million) are exchanged for Parent equity rather than cash. Contingent instruments: none disclosed for shareholders.')\\nline('Stated share count / benchmarks', '99,455,151 shares outstanding at the 01/29/2015 record date (XSH); market closes $78.82 (12/09/2014) and $59.81 (07/02/2014); 38.8% premium to the 07/02/2014 price (XPREM; XMKT); J.P. Morgan DCF reference range $78.25–$106.25 (XDCF); estimated net debt/(cash) of $91 million as of 01/31/2015 used in a J.P. Morgan sensitivity (XND).')\\nline('Labelled calculation (not stated)', 'Record-date shares × merger consideration: 99,455,151 × $83.00 = $8,254,777,533 (~$8.25 billion). This is a labelled arithmetic calculation, not a stated deal value and not a bid.')\\nline('Glossary', 'NDA = confidentiality agreement; IOI = indication of interest; final round = the target-organized stage admitting selected bidders to final diligence and bidding; standstill = confidentiality-agreement provision barring a signer from bidding once a definitive agreement is signed; rollover = contributing shares to the buyer for equity instead of cash; reverse termination fee = fee payable by the buyer if the deal fails in specified circumstances; HSR = U.S. Hart-Scott-Rodino antitrust waiting period; CVR = contingent value right (none here).')\\nblank()\\nline('Note on formulas', 'All formula totals are scoped by What happened / Process / Round / Include and exclude Include = No; blank Count cells are ignored by SUMIFS. They are working research totals, not audited sums.')\\n\\n# ============================================================================\\n# Questions\\n# ============================================================================\\nqs = wb.create_sheet('Questions', 3)\\nQHDR = ['Q','Review topic','Recommended answer','Why and source','Affected rows/fields','Consequence of changing it','Status','Reviewer note']\\nfor j, h in enumerate(QHDR, start=1):\\n    c = qs.cell(row=1, column=j, value=h)\\n    c.font = HDR_FONT; c.fill = HDR_FILL; c.alignment = WRAP_C; c.border = BORDER\\n\\nQUESTIONS = [\\n ('Q1','Process and round map: single process; R1 anchor; R2/R3 split; finality values',\\n  'Keep one process (the 2014 sale attempt ending in the 12/14/2014 signing). Round 1 opens with the confidentiality-agreement wave (R016 anchor; rejected candidates R010, R012, R013/R014, R015 remain separate rows). Split Round 2 (11/03/2014 selection; Inferred final) from Round 3 (November first request for final bids; Announced as final). Alternatives: a two-round map folding R2/R3, or anchoring R3 on the 12/04–05 final-bid deadline.',\\n  'R1 anchor: the filing reports no clean target outreach wave and parties contacted or were contacted by J.P. Morgan (P-013; P-011). R2/R3: selection to the \\\"final round\\\" (P-017) is followed by the merger-agreement circulation with instructions to submit \\\"final bids\\\" (P-019) — the instruction makes the first final-offer request a new round. R2 finality inferred from selection/definitive-negotiation progress; R3 announced via \\\"final bids\\\"/\\\"best and final\\\" (P-021; P-029).',\\n  'Rounds on R010–R016, R026, R029–R034, R040; Round finality on R016 (Not final), R026 (Inferred final), R029 (Announced as final)',\\n  'Moving the R1 boundary to 08/13, 08/19 or 10/03 shifts R013–R015 into Round 1; folding R2/R3 changes round-bidder tallies (currently R1 = 6, R3 = 3 new units) and the finality labels. Boundary-candidate rows are isolated so either move is mechanical.',\\n  'Pending',''),\\n ('Q2','Round-1 and final-round counts and identities: six IOIs vs \\\"5 bidder groups\\\"; four bidders ≥ $80 vs three described ranges; residual cohort; Bidder 3 membership',\\n  'Read the six IOI submitters as: Buyer Group ($81–83), Bidder 2 ($78, revised $81–84), Unnamed bidder 1 ($80–85) and a 3-unit residual cohort (one at/above $80, two below). Read the four ≥$80 finalists as Buyer Group, Bidder 2 and the two bidders later forming Bidder 3, so the final round falls to 3 units post-combination. Do not map Unnamed bidder 1 or any specific bidder to a Bidder 3 member.',\\n  'Six submitters stated (P-016); four advanced (P-017); \\\"5 bidder groups\\\" (XPROC); two bidders formed Bidder 3 (P-018). The filing does not name the members or the fourth ≥$80 unit. The recommended reading makes all counts reconcile without inventing identities.',\\n  'R020–R023 (bids/residual), R026 (four admitted), R027 (two dropped), R028 (Bidder 3 formation), R046 (Bidder 2 outcome)',\\n  'If the two Bidder 3 members were not both among the four admitted, the final round would carry an extra unnamed bidder needing its own close-out and the R2 unit balance would change (currently 4 → 3). If \\\"5 bidder groups\\\" counts something else, Round 1 bid units stay 6 but the group tally presentation changes.',\\n  'Pending',''),\\n ('Q3','Bidder types and anonymous identities',\\n  'Keep every bidder unit classified Financial on the filing\\\\'s own description of the 15 signers as \\\"financial buyers\\\" (P-013), including Bidder 2, Unnamed bidder 1 and Bidder 3. Do not identify anonymous participants from outside knowledge; no person/entity mapping is asserted for Unnamed bidder 1 or the Bidder 3 members.',\\n  'P-013 describes the confidentiality signers as financial buyers; bidders drew from that population; Bidder 3\\\\'s members had prior large-LBO experience (P-018). No strategic bidder entered; the winner is a PE-led consortium (XBG).',\\n  'Type cells on R020–R023, R025, R028, R035–R038, R042–R044',\\n  'A different type basis would change cohort descriptions but no counts; leaving the winner Unknown is not supported (BC Partners consortium).',\\n  'Pending',''),\\n ('Q4','Formality and Conditions borderline calls (IOIs; December bids; Bidder 3 bound-only valuation)',\\n  'Keep IOIs Informal with Conditions \\\"Insufficient evidence\\\" (prices stated, financing/conditions silent, substantive October diligence access context). Keep the 12/10–12/12 Buyer Group and Bidder 2 bids Formal/Light (returned revised transaction documents and financing commitments; no reported Heavy trigger). Keep Bidder 3\\\\'s verbal ≤ ~$78 indication Informal (no documentation) and its price as Bound only (Price high 78; no low endpoint).',\\n  'IOIs: \\\"non-binding preliminary indications\\\" (P-014, P-016). December: final bid letters with \\\"revised versions of the merger agreement\\\" (P-025) and, on 12/12, \\\"revised draft ... and copies of their respective financing commitment documents\\\", Buyer Group versions \\\"substantially executable\\\" (P-029); committed financing per \\\"committed debt financing ... and committed equity financing\\\" (p. 28 quote in XCOND context) and XEQ. Bidder 3: \\\"valuation would not be above the current stock price of approximately $78\\\" (P-025).',\\n  'Formality/Conditions on R020–R023, R025, R035–R037, R042–R044; Conditions detail strings on the same rows',\\n  'Reclassifying formality/conditions affects review flags and which signals are credited, not counts. If the IOIs were judged Heavy by context, the conditions labels on R020–R023/R025 would change to Heavy; if Bidder 3 was judged to have submitted a formal indication, its formality would rise but the no-write-offer record stands.',\\n  'Pending',''),\\n ('Q5','Inferred closing-out of participants (9 non-submitting NDA signers at the 10/30/2014 solicitation)',\\n  'Keep one inferred residual row (R024): 15 NDA signers − 6 submitters = 9 non-submitters, Outcome basis Inferred: residual, Decided by Unknown, Exit reason Not stated, Count 9, Working date = the 10/30/2014 due date. All other close-outs are stated: 2 dropped (R027), Bidder 3 did not submit (R038), Bidder 2 not selected at signing (R046); the winner has no exit row.',\\n  'Base: 15 signers and the October IOI instruction (P-013, P-014); submitters: six (P-016). The arithmetic assumes every signer was eligible to submit and the six exhaust the submissions; non-submission at this solicitation is not permanent withdrawal and does not reveal identity or motive. Two strategic contacts never entered and need no close-out.',\\n  'R024 (inferred row); related tallies on R017, R020–R023; balance shown in Summary',\\n  'If a non-submitter had actually advanced to the final round by an oral indication, the residual would still count 9 non-submissions at the written IOI step, but the four-finalist composition reading in Q2 would shift; if some signers were not invited to submit, the base would be smaller and Count would fall accordingly.',\\n  'Pending',''),\\n ('Q6','Deadlines and working-date conventions (12/05 superseded; 12/10 Extended; 12/12 Enforced; assigned dates deciding order)',\\n  'Keep the deadline history as extracted: 12/05/2014 initial date set (R032, superseded before arrival; no milestone row), revised 12/04–05 to 12/10 (R033) so R034 reads Extended, improved bids due 12/12 (R039) with R040 Enforced. Keep assigned Working dates that decide in-round order where days are undisclosed (R025 midpoint 10/31; R029/R030 November midpoint 11/15; R028 first day after selection 11/04; R018 midpoint 10/15; R024 due date 10/30).',\\n  'Deadline facts: P-020 (initial 12/15 completion and 12/05 submissions), P-021 (12/10 set), P-026 (12/12 request). Treatment decisions follow the instruction rules and what followed in each round (board selection 11/03; board approval 12/13). Assigned dates are disclosed conventions, not observed dates.',\\n  'R018, R019, R024, R025, R028–R034, R040; Date basis/method fields on those rows',\\n  'Changing treatments would alter the Summary deadline map (e.g., reading 12/10 as Enforced if the 12/12 request is not treated as its extension). Moving assigned dates may reorder rows within the round; Row ids and quotes would need re-sorting.',\\n  'Pending',''),\\n ('Q7','Advisers and conflicts (J.P. Morgan; Wachtell Lipton; Innisfree; buyer-side advisers)',\\n  'Keep J.P. Morgan as the target\\\\'s financial adviser with the disclosed conflict facts in the row (fee up to ~$39 million, substantially contingent; ~$110 million of Buyer Group relationships over two years; James Crown\\\\'s Longview/JPMorgan Chase connection). Keep Wachtell Lipton as service observed with the retention date undisclosed. Keep Innisfree as a disclosed proxy-solicitation adviser. Buyer-side advisers: not disclosed.',\\n  'P-005, XENG, XFEE, XREL, P-037 quote (relationships), XINN, P-004. The filing discloses the relationships itself; no outside knowledge is used.',\\n  'R004, R005, R049; Summary adviser block',\\n  'If reviewers prefer strict adviser-only rows, Innisfree moves to Summary; J.P. Morgan conflict facts would remain because the filing makes them material to the fairness opinion and the board\\\\'s process.',\\n  'Pending',''),\\n ('Q8','Coverage conventions (Industry Participant context; rollover communication; regulatory/litigation; no go-shop)',\\n  'Keep Industry Participant as one context row (R001) plus the exclusion decision (R011), outside core bid and auction-screen counts; it never entered and is never closed. Keep the October Longview rollover communication folded into R018 (stage information), with the support relationship recorded once at formation (R041) and once through signing (R047). Keep regulatory filings/clearances and the seven class actions in one Summary line each. No go-shop row: none was provided; the standstills are recorded on R017.',\\n  'R001/P-002 and P-008–P-010 (Industry Participant); P-014/P-015 (rollover communication); P-013/XSTAND (standstills); XHSR (regulatory); XLIT (litigation); XNOOFF (no unsolicited offer as of 02/02/2015).',\\n  'R001, R011, R017, R018, R041; Summary coverage lines',\\n  'If reviewers want the Industry Participant attempt excluded entirely, R001 can be set Include = No without disturbing counts; if the rollover communication should be its own row, R018 splits into deadline-set and a Material process update.',\\n  'Pending',''),\\n]\\nfor i, row in enumerate(QUESTIONS):\\n    rr = i + 2\\n    for j, v in enumerate(row, start=1):\\n        c = qs.cell(row=rr, column=j, value=v)\\n        c.font = Font(size=10); c.alignment = WRAP; c.border = BORDER\\n        if j == 1:\\n            c.alignment = WRAP_C\\nqs.column_dimensions['A'].width = 6\\nqs.column_dimensions['B'].width = 38\\nqs.column_dimensions['C'].width = 70\\nqs.column_dimensions['D'].width = 70\\nqs.column_dimensions['E'].width = 30\\nqs.column_dimensions['F'].width = 50\\nqs.column_dimensions['G'].width = 10\\nqs.column_dimensions['H'].width = 18\\nqs.freeze_panes = 'A2'\\n\\n# order sheets\\nwb._sheets = [wb['Deal ledger'], wb['Summary'], wb['Questions'], wb['Source text'], wb['Lists']]\\nwb['Lists'].sheet_state = 'hidden'\\nwb.active = 0\\nimport os\\nos.makedirs('/home/uctpiaj/work/extraction', exist_ok=True)\\nwb.save(OUT)\\nprint('saved', OUT)\\n\", \"path\": \"/tmp/opencode/petsmart/write_book.py\"}"},"time":{"start":1789825057000,"end":1789825095664}}}}
