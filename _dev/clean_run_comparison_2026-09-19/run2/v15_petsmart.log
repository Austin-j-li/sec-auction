l.name, txt))\\n    return out\\n\\n_page_blocks = {}\\nfor _i, _p in enumerate(_pgs):\\n    _printed = _i + 1 - 7\\n    if _printed >= 1:\\n        _page_blocks[_printed] = _blocks(_p)\\n\\ndef page_blocks(pg):\\n    return _page_blocks.get(pg, [])\\n\\ndef find(pg, needle, occurrence=0):\\n    \\\"\\\"\\\"Return list of block texts on page pg containing needle.\\\"\\\"\\\"\\n    hits = [b[2] for b in page_blocks(pg) if needle.lower() in b[2].lower()]\\n    return hits\\n\", \"path\": \"/tmp/opencode/petsmart/utils.py\"}"},"time":{"start":1789824776931,"end":1789824778532}}}}
