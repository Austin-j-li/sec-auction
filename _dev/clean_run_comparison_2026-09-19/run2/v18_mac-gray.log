{"type":"tool_use","timestamp":1789825528420,"sessionID":"ses_f461ef367ffe0p6nB1IHi4bUUU","part":{"partID":"prt_0b9e9a75c0013ldcPDlBXh6Acj","sessionID":"ses_f461ef367ffe0p6nB1IHi4bUUU","messageID":"msg_0b9e891b4001uRcdNmoNf4U9Nr","type":"tool","id":"call_00_HMOcGcWYCkpOPNaYs1ez6514","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/build_ledger.py","content":"#!/usr/bin/env python3\n\"\"\"Build mac-gray.xlsx deal ledger from the DEFM14A extraction.\"\"\"\nimport datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Alignment, Font\nfrom openpyxl.utils import get_column_letter\n\nD = lambda m, d, y: dt.date(y, m, d)\n\n# ---------------------------------------------------------------- ledger rows\n# Each row: dict with keys. Tokens {XX} in notes resolved to row numbers after build.\nrows = [\n dict(when=\"10/23/2012\", who=\"BofA Merrill Lynch\", type=\"\", event=\"Adviser\", process=\"\", rnd=\"\",\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"BofA engaged for the 2011-2012 Discussions (Mac-Gray's possible acquisition of CSC); mandate terminated 05/15/2013 and re-engaged for the sale process 05/30/2013.\",\n      quote='\"Mac-Gray engaged BofA Merrill Lynch on October 23, 2012\" (p. 27)',\n      sort=\"2012-10-23\", dfrom=\"2012-10-23\", dto=\"2012-10-23\", flag=\"\"),\n dict(when=\"04/05/2013\", who=\"Mac-Gray (Board of Directors)\", type=\"\", event=\"Target sale decision\", process=1, rnd=0,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Board authorized management and BofA to explore opportunities, including with Party A; further consideration deferred to the 05/09 meeting - a qualified exploration.\",\n      quote='\"authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities that might be available to Mac-Gray, including opportunities with another strategic party\" (p. 27)',\n      sort=\"2013-04-05\", dfrom=\"2013-04-05\", dto=\"2013-04-05\", flag=\"Q7\"),\n dict(when=\"04/08/2013\", who=\"Party A\", type=\"Strategic\", event=\"Target interest\", process=1, rnd=0,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"BofA acted on the Board's instruction (04/05); first contact of the sale process; no price named.\",\n      quote='\"representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray\" (p. 27)',\n      sort=\"2013-04-08\", dfrom=\"2013-04-08\", dto=\"2013-04-08\", flag=\"Q7\"),\n dict(when=\"05/15/2013\", who=\"BofA Merrill Lynch\", type=\"\", event=\"Adviser ended\", process=\"\", rnd=\"\",\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Termination of the 2011-2012 Discussions engagement; Transaction Committee decided 05/14, letter sent 05/15.\",\n      quote='\"On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions\" (p. 29)',\n      sort=\"2013-05-15\", dfrom=\"2013-05-15\", dto=\"2013-05-15\", flag=\"\"),\n dict(when=\"05/30/2013\", who=\"BofA Merrill Lynch\", type=\"\", event=\"Adviser\", process=1, rnd=0,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Re-engaged as Mac-Gray's financial adviser; Board approved 05/30, engagement letter 05/31; BofA barred from buyer financing without consent.\",\n      quote='\"the Board unanimously approved the engagement of BofA Merrill Lynch on the terms discussed at this meeting\" (p. 29)',\n      sort=\"2013-05-30\", dfrom=\"2013-05-30\", dto=\"2013-05-30\", flag=\"\"),\n dict(when=\"05/30/2013\", who=\"Moab Partners, L.P.\", type=\"\", event=\"Activist\", process=1, rnd=0,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Moab's proxy contest won two board seats (Rothenberg, Hyman); Rothenberg is Moab's co-founder and GP; board reduced to seven; Moab later sought a rollover (see {M1}, {M2}).\",\n      quote='\"Mac-Gray and Moab engaged in a proxy contest leading up to the annual meeting and Mr. Rothenberg and Mr. Hyman were elected in place of Mac-Gray\\'s incumbent nominees\" (p. 29)',\n      sort=\"2013-05-30\", dfrom=\"2013-05-30\", dto=\"2013-05-30\", flag=\"\"),\n dict(when=\"06/21/2013\", who=\"Party A\", type=\"Strategic\", event=\"Bid\", process=1, rnd=0,\n      plo=17.00, phi=19.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"Unsolicited all-cash proposal; no diligence access yet, so Heavy by context; later revised (see {PA2}).\",\n      quote='\"Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share\" (p. 30)',\n      sort=\"2013-06-21\", dfrom=\"2013-06-21\", dto=\"2013-06-21\", flag=\"Q7\"),\n dict(when=\"06/24/2013\", who=\"Mac-Gray (Special Committee)\", type=\"\", event=\"Round opened\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Special Committee concluded a sale should be considered and determined to approach 50 parties (15 strategic, 35 financial); outreach began within days.\",\n      quote='\"the Special Committee concluded that it would be in the best interests of stockholders to consider a potential sale of Mac-Gray\" (p. 31)',\n      sort=\"2013-06-24\", dfrom=\"2013-06-24\", dto=\"2013-06-24\", flag=\"Q1\"),\n dict(when=\"June-July 2013\", who=\"13 strategic parties\", type=\"Strategic\", event=\"Contact\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=13, exitr=\"\", inf=\"\",\n      note=\"Residual of the 15 strategic parties BofA approached; Party A (04/08 contact) and CSC/Pamplona (06/28 contact) are recorded separately.\",\n      quote='\"15 of which were potential strategic buyers and 35 of which were potential financial buyers\" (p. 32)',\n      sort=\"2013-06-24\", dfrom=\"2013-06-24\", dto=\"2013-07-23\", flag=\"\"),\n dict(when=\"June-July 2013\", who=\"35 financial parties\", type=\"Financial\", event=\"Contact\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=35, exitr=\"\", inf=\"\",\n      note=\"All 35 financial parties BofA approached; no individual contacts reported; Party B and Party C appear later under NDA.\",\n      quote='\"BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting\" (p. 32)',\n      sort=\"2013-06-24\", dfrom=\"2013-06-24\", dto=\"2013-07-23\", flag=\"\"),\n dict(when=\"by 06/28/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"Contact\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"BofA's first contact with Pamplona; it expressed interest, including an acquisition by its portfolio company CSC; said diligence would be minimal.\",\n      quote='\"BofA Merrill Lynch also reported that they had spoken with representatives of Pamplona, as instructed by the Special Committee, who expressed interest in a transaction\" (p. 32)',\n      sort=\"2013-06-28\", dfrom=\"\", dto=\"2013-06-28\", flag=\"\"),\n dict(when=\"06/28/2013\", who=\"Party B\", type=\"Financial\", event=\"NDA signed\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\",\n      quote='\"Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\" (p. 32)',\n      sort=\"2013-06-28\", dfrom=\"2013-06-28\", dto=\"2013-06-28\", flag=\"\"),\n dict(when=\"06/30/2013\", who=\"Party C\", type=\"Financial\", event=\"NDA signed\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\",\n      quote='\"On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\" (p. 32)',\n      sort=\"2013-06-30\", dfrom=\"2013-06-30\", dto=\"2013-06-30\", flag=\"\"),\n dict(when=\"07/06/2013\", who=\"Moab\", type=\"\", event=\"Other material event\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Denied Moab's request (made 07/03) to partner exclusively with CSC/Pamplona at this stage; rollover talks deferred to a later stage (see {M2}).\",\n      quote='\"the Special Committee decided to deny the exclusivity request at this stage ... so that the potential equity rollover of Moab\\'s shares could be available as a source of capital\" (p. 33)',\n      sort=\"2013-07-06\", dfrom=\"2013-07-06\", dto=\"2013-07-06\", flag=\"\"),\n dict(when=\"07/11/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"NDA signed\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\",\n      quote='\"On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package\" (p. 33)',\n      sort=\"2013-07-11\", dfrom=\"2013-07-11\", dto=\"2013-07-11\", flag=\"\"),\n dict(when=\"07/23/2013\", who=\"Mac-Gray\", type=\"\", event=\"Deadline\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Preliminary IOIs due; CSC/Pamplona submitted on 07/23; Party B and Party C arrived 07/24-07/25 and were considered.\",\n      quote='\"furnished an informational package ... to formulate a preliminary indication of interest, which they were instructed to submit by July 23, 2013\" (p. 32)',\n      sort=\"2013-07-23\", dfrom=\"2013-07-23\", dto=\"2013-07-23\", flag=\"Q2\"),\n dict(when=\"by 07/23/2013\", who=\"16 residual NDA signers\", type=\"Financial\", event=\"Did not submit\", process=1, rnd=1,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=16, exitr=\"Not stated\", inf=\"Y\",\n      note=\"Inferred: 20 NDA signers less Party A, Party B, Party C and CSC/Pamplona (recorded individually) = 16; no submission or later mention.\",\n      quote='\"a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders ... entered into confidentiality agreements with Mac-Gray\" (p. 32)',\n      sort=\"2013-07-23\", dfrom=\"\", dto=\"2013-07-23\", flag=\"\"),\n dict(when=\"07/23/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"Bid\", process=1, rnd=1,\n      plo=18.50, phi=18.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"Preliminary IOI; pre-diligence so Heavy by context; Pamplona had said diligence would be minimal; later revised (see {CP2}).\",\n      quote='\"On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share\" (p. 33)',\n      sort=\"2013-07-23\", dfrom=\"2013-07-23\", dto=\"2013-07-23\", flag=\"Q6\"),\n dict(when=\"07/24/2013\", who=\"Party B\", type=\"Financial\", event=\"Bid\", process=1, rnd=1,\n      plo=17.00, phi=18.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"Preliminary IOI submitted one day after the 07/23 due date; pre-diligence so Heavy by context; later revised (see {PB2}).\",\n      quote='\"On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share\" (p. 33)',\n      sort=\"2013-07-24\", dfrom=\"2013-07-24\", dto=\"2013-07-24\", flag=\"\"),\n dict(when=\"07/24/2013\", who=\"Party C\", type=\"Financial\", event=\"Bid\", process=1, rnd=1,\n      plo=15.00, phi=17.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"Oral preliminary IOI to BofA; pre-diligence so Heavy by context; written revision next day (see {PC2}).\",\n      quote='\"representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share\" (p. 33)',\n      sort=\"2013-07-24\", dfrom=\"2013-07-24\", dto=\"2013-07-24\", flag=\"\"),\n dict(when=\"07/25/2013\", who=\"Mac-Gray (Special Committee)\", type=\"\", event=\"Round opened\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"IOIs judged lower than expected; four bidders advanced to staged disclosure and management meetings (held 08/06-08/14); revised IOIs to follow.\",\n      quote='\"authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure ... and to reach out to each of the four interested bidders and arrange management meetings\" (p. 34)',\n      sort=\"2013-07-25\", dfrom=\"2013-07-25\", dto=\"2013-07-25\", flag=\"Q1\"),\n dict(when=\"07/25/2013\", who=\"Party C\", type=\"Financial\", event=\"Bid\", process=1, rnd=1,\n      plo=16.00, phi=16.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {PC1}; written IOI submitted after the round-2 decision; pre-diligence so Heavy by context; later revised (see {PC3}).\",\n      quote='\"Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share\" (p. 34)',\n      sort=\"2013-07-25\", dfrom=\"2013-07-25\", dto=\"2013-07-25\", flag=\"\"),\n dict(when=\"08/05/2013\", who=\"Party A\", type=\"Strategic\", event=\"NDA signed\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"\", inf=\"\",\n      note=\"Late entrant; signing followed stalled negotiations over non-solicit provisions (07/11-07/23); package to improve its 06/21 proposal (see {PA1}).\",\n      quote='\"On August 5, 2013, Party A entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\" (p. 34)',\n      sort=\"2013-08-05\", dfrom=\"2013-08-05\", dto=\"2013-08-05\", flag=\"\"),\n dict(when=\"between 08/06/2013 and 08/27/2013\", who=\"Mac-Gray (Special Committee)\", type=\"\", event=\"Other material event\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Staged access: broad data-site access for financial bidders Party B and Party C; limited access for strategic bidders Party A and CSC/Pamplona; customer data reserved.\",\n      quote='\"Party B and Party C ... were given broad access to an electronic data site, and Party A and CSC/Pamplona ... were given somewhat limited access\" (p. 34)',\n      sort=\"2013-08-16\", dfrom=\"2013-08-06\", dto=\"2013-08-27\", flag=\"\"),\n dict(when=\"08/27/2013\", who=\"BofA Merrill Lynch (for Mac-Gray)\", type=\"\", event=\"Deadline set\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Authorized 08/15; instructed the four to submit revised written proposals by 09/09 addressing valuation, financing, regulatory approvals and covenants.\",\n      quote='\"sent a letter to each of Party A, Party B, Party C and CSC/Pamplona instructing such bidders to submit revised written proposals no later than September 9, 2013\" (p. 35)',\n      sort=\"2013-08-27\", dfrom=\"2013-08-27\", dto=\"2013-08-27\", flag=\"\"),\n dict(when=\"09/09/2013\", who=\"Mac-Gray\", type=\"\", event=\"Deadline\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"CSC/Pamplona and Party B submitted on time; Party A and Party C arrived 09/10 and were considered on 09/11.\",\n      quote='\"submit revised written proposals no later than September 9, 2013 if such bidders wished to proceed further in the process\" (p. 35)',\n      sort=\"2013-09-09\", dfrom=\"2013-09-09\", dto=\"2013-09-09\", flag=\"Q3\"),\n dict(when=\"09/09/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"Bid\", process=1, rnd=2,\n      plo=19.50, phi=19.50, cash=\"Yes\", form=\"Informal\", cond=\"Light\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {CP1}; Pamplona committed to 100% of the capital; requested two-week exclusive negotiations; later revised (see {CP3}).\",\n      quote='\"CSC/Pamplona submitted a revised indication of interest with an all-cash purchase price of $19.50 per share, indicating that Pamplona was committed to provide 100% of the capital required\" (p. 35)',\n      sort=\"2013-09-09\", dfrom=\"2013-09-09\", dto=\"2013-09-09\", flag=\"\"),\n dict(when=\"09/09/2013\", who=\"Party B\", type=\"Financial\", event=\"Bid\", process=1, rnd=2,\n      plo=18.50, phi=18.50, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {PB1}; affiliated-fund equity plus third-party debt; no firm financing commitment so Heavy; later revised (see {PB3}).\",\n      quote='\"Party B also submitted a revised indication of interest with an all-cash purchase price of $18.50 per share\" (p. 35)',\n      sort=\"2013-09-09\", dfrom=\"2013-09-09\", dto=\"2013-09-09\", flag=\"\"),\n dict(when=\"09/10/2013\", who=\"Party A\", type=\"Strategic\", event=\"Bid\", process=1, rnd=2,\n      plo=18.00, phi=19.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {PA1}; credit facilities or affiliated equity; no firm financing commitment so Heavy; reaffirmed 09/18 (see {PA3}).\",\n      quote='\"Party A submitted a revised indication of interest with an all-cash purchase price of $18.00 to $19.00 per share, to be financed by outstanding credit facilities or affiliated equity sources\" (p. 35)',\n      sort=\"2013-09-10\", dfrom=\"2013-09-10\", dto=\"2013-09-10\", flag=\"\"),\n dict(when=\"09/10/2013\", who=\"Party C\", type=\"Financial\", event=\"Bid\", process=1, rnd=2,\n      plo=16.00, phi=17.00, cash=\"Yes\", form=\"Informal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {PC2}; oral revised IOI to BofA; no firm financing commitment so Heavy; out at the final deadline (see {PCX}).\",\n      quote='\"a representative of Party C indicated that it was submitting a revised oral indication of interest with an all-cash purchase price of $16.00 to $17.00 per share\" (p. 35)',\n      sort=\"2013-09-10\", dfrom=\"2013-09-10\", dto=\"2013-09-10\", flag=\"\"),\n dict(when=\"09/11/2013\", who=\"Mr. MacDonald (CEO)\", type=\"\", event=\"Other material event\", process=1, rnd=2,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Declined to roll over any shares; briefed in detail 09/12; supported continuing but said Mac-Gray should seek higher value.\",\n      quote='\"Mr. MacDonald indicated that he had decided that he was not interested in rolling over any of his shares in any transaction\" (p. 35)',\n      sort=\"2013-09-11\", dfrom=\"2013-09-11\", dto=\"2013-09-11\", flag=\"\"),\n dict(when=\"09/11/2013\", who=\"Mac-Gray (Special Committee)\", type=\"\", event=\"Round opened\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Final indications of interest requested by 09/18; short exclusive negotiations possible depending on price and deal certainty.\",\n      quote='\"the Special Committee instructed BofA Merrill Lynch to call each of Party A, Party B, Party C and CSC/Pamplona to request final indications of interest\" (p. 36)',\n      sort=\"2013-09-11\", dfrom=\"2013-09-11\", dto=\"2013-09-11\", flag=\"Q1\"),\n dict(when=\"09/18/2013\", who=\"Mac-Gray\", type=\"\", event=\"Deadline\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"CSC/Pamplona, Party A and Party B responded; Party C did not submit or reiterate.\",\n      quote='\"request final indications of interest by September 18, 2013\" (p. 36)',\n      sort=\"2013-09-18\", dfrom=\"2013-09-18\", dto=\"2013-09-18\", flag=\"Q4\"),\n dict(when=\"09/18/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"Bid\", process=1, rnd=3,\n      plo=20.75, phi=20.75, cash=\"Yes\", form=\"Formal\", cond=\"Light\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {CP2}; Pamplona committed to 100% of the capital; requested two-week exclusive negotiations; later revised (see {CP4}).\",\n      quote='\"CSC/Pamplona submitted a proposal for an all-cash purchase price of $20.75 per share, reiterating that Pamplona was committed to provide 100% of the capital required\" (p. 36)',\n      sort=\"2013-09-18\", dfrom=\"2013-09-18\", dto=\"2013-09-18\", flag=\"\"),\n dict(when=\"09/18/2013\", who=\"Party A\", type=\"Strategic\", event=\"Bid reaffirmed\", process=1, rnd=3,\n      plo=18.00, phi=19.00, cash=\"Yes\", form=\"Formal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"Confirmed its standing offer as best and final, declining to improve; financing not committed so Heavy; out when exclusivity executed (see {XA}).\",\n      quote='\"its previous indication of interest with an all-cash purchase price of $18.00 to $19.00 per share was its best and final offer\" (p. 36)',\n      sort=\"2013-09-18\", dfrom=\"2013-09-18\", dto=\"2013-09-18\", flag=\"\"),\n dict(when=\"09/18/2013\", who=\"Party B\", type=\"Financial\", event=\"Bid\", process=1, rnd=3,\n      plo=21.50, phi=21.50, cash=\"No\", form=\"Formal\", cond=\"Heavy\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {PB2}; $19.00 cash at closing plus options (10% of new equity, strike at cost basis) valued by Party B at $2.50/share; financing not committed.\",\n      quote='\"submitted a revised indication of interest with a purchase price that Party B valued at $21.50 per share, including $19.00 of cash to be paid at closing\" (p. 36)',\n      sort=\"2013-09-18\", dfrom=\"2013-09-18\", dto=\"2013-09-18\", flag=\"\"),\n dict(when=\"09/18/2013\", who=\"Party C\", type=\"Financial\", event=\"Did not submit\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"Not stated\", inf=\"\",\n      note=\"No revised indication at the final request and no reasons given; not mentioned again.\",\n      quote='\"Party C did not submit a revised indication of interest or reiterate its prior indication of interest ... nor did it specify any reasons in connection therewith\" (p. 36)',\n      sort=\"2013-09-18\", dfrom=\"2013-09-18\", dto=\"2013-09-18\", flag=\"Q4\"),\n dict(when=\"09/19/2013\", who=\"Mac-Gray (Special Committee)\", type=\"\", event=\"Other material event\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Selected CSC/Pamplona as preferred bidder and set $21.25 per share for exclusivity; Party B's option-heavy bid considered less certain; MacDonald supportive.\",\n      quote='\"authorized the Transaction Committee to inform CSC/Pamplona that the Special Committee would be prepared to move into exclusivity at a price of $21.25 per share\" (p. 37)',\n      sort=\"2013-09-19\", dfrom=\"2013-09-19\", dto=\"2013-09-19\", flag=\"Q1\"),\n dict(when=\"09/21/2013\", who=\"CSC/Pamplona\", type=\"Strategic\", event=\"Bid\", process=1, rnd=3,\n      plo=21.25, phi=21.25, cash=\"Yes\", form=\"Formal\", cond=\"Light\", count=1, exitr=\"\", inf=\"\",\n      note=\"revises {CP3}; last and best offer tied to two-week exclusive negotiations; no financing contingency; MacDonald voting agreements requested.\",\n      quote='\"CSC/Pamplona were willing to increase their all-cash purchase price to $21.25 per share as a last and best offer\" (p. 37)',\n      sort=\"2013-09-21\", dfrom=\"2013-09-21\", dto=\"2013-09-21\", flag=\"Q1\"),\n dict(when=\"09/24/2013\", who=\"CSC/Pamplona\", type=\"\", event=\"Exclusivity changed\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Executed (authorized 09/23): exclusive negotiations until 5 p.m. ET on 10/12/2013, subject to no adverse change to the final proposal.\",\n      quote='\"On September 24, 2013, CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations until 5 p.m. ET on October 12, 2013\" (p. 38)',\n      sort=\"2013-09-24\", dfrom=\"2013-09-24\", dto=\"2013-09-24\", flag=\"Q6\"),\n dict(when=\"by 09/24/2013\", who=\"Party A\", type=\"Strategic\", event=\"Dropped by target\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"Would not improve earlier offer\", inf=\"Y\",\n      note=\"Inferred: out when the target executed exclusivity with CSC/Pamplona; its 09/18 best-and-final declined to improve.\",\n      quote='\"CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations\" (p. 38)',\n      sort=\"2013-09-24\", dfrom=\"\", dto=\"2013-09-24\", flag=\"Q5\"),\n dict(when=\"by 09/24/2013\", who=\"Party B\", type=\"Financial\", event=\"Dropped by target\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=1, exitr=\"Not stated\", inf=\"Y\",\n      note=\"Inferred: out when exclusivity executed; the target had preferred CSC/Pamplona's certainty after weighing Party B's option-heavy $21.50 bid.\",\n      quote='\"CSC, Pamplona and Mac-Gray executed the exclusivity agreement providing for exclusive negotiations\" (p. 38)',\n      sort=\"2013-09-24\", dfrom=\"\", dto=\"2013-09-24\", flag=\"Q5\"),\n dict(when=\"by 10/07/2013\", who=\"Moab\", type=\"\", event=\"Other material event\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Rollover resolved: after Pamplona discussions (facilitated 09/23, continuing to 10/07), Moab determined not to roll over; Rothenberg then briefed.\",\n      quote='\"after discussions between Moab and representatives of Pamplona, it was determined that Moab would not rollover any Moab shares in the transaction\" (p. 39)',\n      sort=\"2013-10-07\", dfrom=\"\", dto=\"2013-10-07\", flag=\"\"),\n dict(when=\"10/12/2013\", who=\"CSC/Pamplona\", type=\"\", event=\"Exclusivity changed\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Extended to 11:59 p.m. ET on 10/15/2013 (requested by CSC/Pamplona and authorized 10/09) as negotiations continued.\",\n      quote='\"On October 12, 2013, CSC, Pamplona and Mac-Gray executed a letter agreement extending exclusivity until 11:59 p.m. ET on October 15, 2013\" (p. 41)',\n      sort=\"2013-10-12\", dfrom=\"2013-10-12\", dto=\"2013-10-12\", flag=\"Q1\"),\n dict(when=\"10/14/2013\", who=\"Mac-Gray and CSC/Pamplona\", type=\"\", event=\"Merger agreement signed\", process=1, rnd=3,\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Board approved on the Special Committee's recommendation; $21.25/share cash; no financing contingency; Pamplona commitment letter delivered; $11M Mac-Gray and $15M reverse termination fees.\",\n      quote='\"on October 14, 2013, the merger agreement was executed, the Pamplona commitment letter was delivered\" (p. 41)',\n      sort=\"2013-10-14\", dfrom=\"2013-10-14\", dto=\"2013-10-14\", flag=\"\"),\n dict(when=\"10/15/2013\", who=\"Mac-Gray and CSC\", type=\"\", event=\"Merger announced\", process=\"\", rnd=\"post\",\n      plo=None, phi=None, cash=\"\", form=\"\", cond=\"\", count=None, exitr=\"\", inf=\"\",\n      note=\"Joint announcement before the U.S. markets opened; $21.25 per share in cash.\",\n      quote='\"On October 15, 2013, before the U.S. stock markets opened, Mac-Gray and CSC jointly announced the execution of the merger agreement\" (p. 41)',\n      sort=\"2013-10-15\", dfrom=\"2013-10-15\", dto=\"2013-10-15\", flag=\"\"),\n]\n\n# resolve note tokens -> row numbers\ntokens = {\"PA1\": None, \"PA2\": None, \"PA3\": None, \"PB1\": None, \"PB2\": None, \"PB3\": None,\n          \"PC1\": None, \"PC2\": None, \"PC3\": None, \"PCX\": None, \"CP1\": None, \"CP2\": None,\n          \"CP3\": None, \"CP4\": None, \"M1\": None, \"M2\": None, \"XA\": None, \"XB\": None}\nfor i, r in enumerate(rows, 1):\n    key = (r[\"who\"], r[\"event\"], r[\"when\"])\n    if key == (\"Party A\", \"Bid\", \"06/21/2013\"): tokens[\"PA1\"] = i\n    if key == (\"Party A\", \"Bid\", \"09/10/2013\"): tokens[\"PA2\"] = i\n    if key == (\"Party A\", \"Bid reaffirmed\", \"09/18/2013\"): tokens[\"PA3\"] = i\n    if key == (\"Party B\", \"Bid\", \"07/24/2013\"): tokens[\"PB1\"] = i\n    if key == (\"Party B\", \"Bid\", \"09/09/2013\"): tokens[\"PB2\"] = i\n    if key == (\"Party B\", \"Bid\", \"09/18/2013\"): tokens[\"PB3\"] = i\n    if key == (\"Party C\", \"Bid\", \"07/24/2013\"): tokens[\"PC1\"] = i\n    if key == (\"Party C\", \"Bid\", \"07/25/2013\"): tokens[\"PC2\"] = i\n    if key == (\"Party C\", \"Bid\", \"09/10/2013\"): tokens[\"PC3\"] = i\n    if key == (\"Party C\", \"Did not submit\", \"09/18/2013\"): tokens[\"PCX\"] = i\n    if key == (\"CSC/Pamplona\", \"Bid\", \"07/23/2013\"): tokens[\"CP1\"] = i\n    if key == (\"CSC/Pamplona\", \"Bid\", \"09/09/2013\"): tokens[\"CP2\"] = i\n    if key == (\"CSC/Pamplona\", \"Bid\", \"09/18/2013\"): tokens[\"CP3\"] = i\n    if key == (\"CSC/Pamplona\", \"Bid\", \"09/21/2013\"): tokens[\"CP4\"] = i\n    if key == (\"Moab\", \"Other material event\", \"07/06/2013\"): tokens[\"M1\"] = i\n    if key == (\"Moab\", \"Other material event\", \"by 10/07/2013\"): tokens[\"M2\"] = i\n    if key == (\"Party A\", \"Dropped by target\", \"by 09/24/2013\"): tokens[\"XA\"] = i\n    if key == (\"Party B\", \"Dropped by target\", \"by 09/24/2013\"): tokens[\"XB\"] = i\nprint(\"tokens:\", tokens)\nfor r in rows:\n    for t, v in tokens.items():\n        r[\"note\"] = r[\"note\"].replace(\"{\" + t + \"}\", \"#\" + str(v))\n\n# ---------------------------------------------------------------- validations\nproblems = []\nfor i, r in enumerate(rows, 1):\n    nw = len(r[\"note\"].split())\n    if nw > 40: problems.append(f\"row {i}: note {nw} words\")\n    q = r[\"quote\"].split(\"(p.\")[0]\n    qw = len([w for w in q.split() if w.strip('\"') != \"...\"])\n    if qw > 30: problems.append(f\"row {i}: quote {qw} words\")\n    for f in (\"when\", \"who\", \"event\", \"sort\"):\n        if not r[f]: problems.append(f\"row {i}: empty {f}\")\n# sort monotonic\nprev = None\nfor i, r in enumerate(rows, 1):\n    s = dt.date.fromisoformat(r[\"sort\"])\n    if prev and s < prev: problems.append(f\"row {i}: sort decreases\")\n    if r[\"dfrom\"] and r[\"dto\"] and dt.date.fromisoformat(r[\"dfrom\"]) > dt.date.fromisoformat(r[\"dto\"]):\n        problems.append(f\"row {i}: from>to\")\n    if r[\"dfrom\"] and dt.date.fromisoformat(r[\"dfrom\"]) > s: problems.append(f\"row {i}: sort before from\")\n    if r[\"dto\"] and dt.date.fromisoformat(r[\"dto\"]) < s: problems.append(f\"row {i}: sort after to\")\n    prev = s\nprint(\"problems:\", problems if problems else \"none\")\nprint(\"rows:\", len(rows))\n\n# ---------------------------------------------------------------- workbook\nwb = Workbook()\nws = wb.active\nws.title = \"Deal ledger\"\nheaders = [\"#\", \"When\", \"Who\", \"Type\", \"Event\", \"Process\", \"Round\", \"Price low\", \"Price high\",\n           \"All cash\", \"Formality\", \"Conditions\", \"Count\", \"Exit reason\", \"Inferred\", \"Note\",\n           \"Quote and page\", \"Flag\", \"Reviewer note\", \"Sort date\", \"Date from\", \"Date to\"]\nws.append(headers)\nfor i, r in enumerate(rows, 1):\n    ws.append([i, r[\"when\"], r[\"who\"], r[\"type\"], r[\"event\"], r[\"process\"], r[\"rnd\"],\n               r[\"plo\"], r[\"phi\"], r[\"cash\"], r[\"form\"], r[\"cond\"], r[\"count\"], r[\"exitr\"],\n               r[\"inf\"], r[\"note\"], r[\"quote\"], r[\"flag\"], None,\n               dt.date.fromisoformat(r[\"sort\"]),\n               dt.date.fromisoformat(r[\"dfrom\"]) if r[\"dfrom\"] else None,\n               dt.date.fromisoformat(r[\"dto\"]) if r[\"dto\"] else None])\n\n# Rounds sheet\nws2 = wb.create_sheet(\"Rounds\")\nws2.append([\"Process\", \"Round\", \"Opened\", \"How opened\", \"Who was in\", \"Due dates\",\n            \"Deadline outcome\", \"Finality\", \"Bids received\", \"How it ended\"])\nrounds = [\n [1, 0, None, \"Pre-process: Party A interest 04/08; unsolicited proposal 06/21\",\n  \"None admitted; Party A live with a standing offer\", \"none stated\", \"No deadline stated\",\n  \"Not final\", \"1: Party A $17.00-$19.00\", \"Party A's standing offer carried into round 1\"],\n [1, 1, dt.date(2013, 6, 24), \"Special Committee concluded a sale should be considered; determined to approach 50 parties (15 strategic, 35 financial); outreach began within days\",\n  \"20 NDA signers: 2 strategic (Party A 08/05, CSC/Pamplona 07/11); 18 financial incl. Party B 06/28, Party C 06/30\",\n  \"07/23/2013\", \"Late bids accepted\", \"Not final\",\n  \"3: CSC/Pamplona $18.50; Party B $17.00-$18.00; Party C $15.00-$17.00 oral, then $16.00-$16.50 written\",\n  \"four advanced; sixteen residual signers out\"],\n [1, 2, dt.date(2013, 7, 25), \"Four IOI bidders advanced to staged disclosure and management meetings; revised IOIs requested\",\n  \"4: Party A (Strategic), CSC/Pamplona (Strategic), Party B (Financial), Party C (Financial)\",\n  \"09/09/2013\", \"Late bids accepted\", \"Not final\",\n  \"4: CSC/Pamplona $19.50; Party B $18.50; Party A $18.00-$19.00; Party C $16.00-$17.00\",\n  \"three advanced; Party C out\"],\n [1, 3, dt.date(2013, 9, 11), \"Final indications of interest requested by 09/18; short exclusive negotiations possible\",\n  \"4: Party A (Strategic), CSC/Pamplona (Strategic), Party B (Financial), Party C (Financial)\",\n  \"09/18/2013\", \"Enforced\", \"Announced as final\",\n  \"3: CSC/Pamplona $20.75 then $21.25; Party B $21.50 (valued); Party A $18.00-$19.00 reaffirmed\",\n  \"CSC/Pamplona advanced to exclusivity; signing\"],\n]\nfor r in rounds:\n    ws2.append(r)\n\n# Questions sheet\nws3 = wb.create_sheet(\"Questions\")\nws3.append([\"Q\", \"Question\", \"Recommended answer\", \"Why, with page\", \"Rows affected\",\n            \"What changes if answered differently\", \"Reviewer note\"])\nquestions = [\n [\"Q1\",\n  \"Round map: one process; round 1 opened 06/24/2013 by the Special Committee's decision to approach 50 parties; round 2 on 07/25/2013 (four advanced to staged diligence and revised IOIs); round 3 on 09/11/2013 (final indications due 09/18); the 09/19-09/24 price increase and exclusivity sit inside round 3. Correct?\",\n  \"Keep the map: rounds 1-3 as dated; round 0 holds the pre-process events (04/08 Party A contact; 06/21 proposal); the exclusive stage is not a fourth round.\",\n  \"C8: a round opens when the target selects who advances and seeks updated offers (pp. 31, 34), and final/best-and-final requests open one even with unchanged bidders (p. 36); 'exclusivity inside an established final stage' is not a new round.\",\n  \"#8-#10, #21, #32, #38-#42, #44\",\n  \"Starting round 1 at the 06/28 first reported outreach moves #8-#10; treating the exclusive stage as round 4 adds a Round opened row and moves #39-#44.\",\n  None],\n [\"Q2\",\n  \"Round 1's 07/23/2013 due date: CSC/Pamplona submitted on time; Party B (07/24) and Party C (07/24 oral; 07/25 written) arrived after it but were reviewed on 07/25. 'Late bids accepted'?\",\n  \"Late bids accepted - they were considered with no recorded extension.\",\n  \"C11: a bid is late only if its Date from is after the due date; both late arrivals were reviewed at the 07/25 meeting (p. 34), and no Deadline revised row exists.\",\n  \"#16-#20, #22\",\n  \"Enforced would drop the late-bid reading for Party B and Party C; an Extended reading would add a Deadline revised row.\",\n  None],\n [\"Q3\",\n  \"Round 2's 09/09/2013 due date: CSC/Pamplona and Party B on time; Party A and Party C submitted 09/10 and were reviewed 09/11. 'Late bids accepted'?\",\n  \"Late bids accepted - they were considered with no recorded extension.\",\n  \"C11; both Dates from fall after the 08/27 letter's 09/09 deadline (p. 35); the Special Committee reviewed them on 09/11 (p. 36).\",\n  \"#26-#30\",\n  \"Enforced would remove the late reading; a de facto extension reading would add a Deadline revised row and change the round-2 outcome.\",\n  None],\n [\"Q4\",\n  \"Round 3's 09/18/2013 due date: three bids arrived; Party C neither submitted nor reiterated. 'Enforced', with Party C exiting as Did not submit at the due date?\",\n  \"Enforced; Party C Did not submit on 09/18 (not necessarily permanent, but never mentioned again).\",\n  \"C11 Enforced = the target's next step on the bids in hand (09/19 preferred-bidder decision, p. 37); C16 Did not submit; Party C's absence is reported at p. 36.\",\n  \"#33, #37\",\n  \"If Party C were still live at exclusivity, add a Dropped by target exit at 09/24 and count 4->3 only from 09/24.\",\n  None],\n [\"Q5\",\n  \"Exit reasons for the two rivals displaced at exclusivity (inferred exits, 09/24): Party A 'Would not improve earlier offer' and Party B 'Not stated'?\",\n  \"Party A: Would not improve earlier offer (its 09/18 call was best and final). Party B: Not stated (no bidder-stated reason; the target-side certainty preference is reported, not Party B's reason).\",\n  \"C16: 'A bidder that is asked to improve and declines takes Would not improve earlier offer'; Party A declined (p. 36). Inferred exits default to Not stated (C16).\",\n  \"#41, #42\",\n  \"Both Not stated would drop Party A's reported refusal to improve; 'Terms or process' for Party B would attribute the target's certainty preference to Party B.\",\n  None],\n [\"Q6\",\n  \"Winner type: CSC/Pamplona as Strategic (sponsor-owned operating company, Pamplona providing financing support), or Mixed as a joint bid by an operator and a fund?\",\n  \"Strategic. CSC is an operating laundry company owned by Pamplona; Pamplona's role is committed financing support, and the filing counts CSC/Pamplona among the strategic bidders.\",\n  \"C3 ('including a sponsor-owned operating company'; 'not a strategic buyer with financing support'); the filing's own count at p. 32; Pamplona commitment at pp. 38, 59.\",\n  \"#11, #15, #18, #27, #34, #39, #40, #45\",\n  \"Mixed would reinterpret the winner's type across its rows; no prices or counts change.\",\n  None],\n [\"Q7\",\n  \"Initiation: 'Target-led' or 'Mixed'? The Board authorized exploration first (04/05) and its banker approached Party A (04/08), but Party A then bid unsolicited (06/21) and Moab was an activist presence.\",\n  \"Target-led - the Board's authorization and banker approach came first; the unsolicited proposal and Moab's activism shaped, but did not start, the process.\",\n  \"C6; pp. 27 (04/05 authorization; 04/08 contact), 29 (Moab proxy contest), 30 (Party A proposal).\",\n  \"#2, #3, #7\",\n  \"Mixed would change the Deal facts initiation classification and flag bidder and activist influence.\",\n  None],\n]\nfor q in questions:\n    ws3.append(q)\n\n# Deal facts sheet\nws4 = wb.create_sheet(\"Deal facts\")\nws4.append([\"Field\", \"Value\"])\nfacts = [\n [\"Target\", \"Mac-Gray Corporation (Waltham, Massachusetts; laundry facilities management)\"],\n [\"Acquirer\", \"CSC ServiceWorks, Inc. and affiliates (Spin Holdco Inc., CSC Fenway Inc.), funded by Pamplona Capital Partners III, L.P.\"],\n [\"Acquirer type\", \"Strategic - sponsor-owned operating company (Pamplona-owned CSC; laundry services)\"],\n [\"Agreed price and consideration\", \"$21.25 per share in cash, without interest and less applicable withholding taxes\"],\n [\"Merger agreement signed\", dt.date(2013, 10, 14)],\n [\"Merger announced\", dt.date(2013, 10, 15)],\n [\"Filing type and date\", \"DEFM14A definitive proxy statement, dated December 4, 2013\"],\n [\"Background pages\", \"pp. 27-41\"],\n [\"Initiation\", \"Target-led (Board authorized exploration 04/05/2013; banker approached Party A 04/08; unsolicited Party A proposal 06/21; Moab activist involvement)\"],\n [\"Number of processes\", \"1\"],\n [\"Auction screen\", \"Met - 20 confidentiality agreements with prospective acquirers (2 strategic, 18 financial)\"],\n [\"Whole-company bids\", \"Yes - all four bidders bid for the whole company\"],\n [\"Currency and units of bid prices\", \"US dollars; per share\"],\n [\"Target financial advisers\", \"BofA Merrill Lynch (sole; engaged 05/31/2013; prior 2011-2012 mandate ended 05/15/2013)\"],\n [\"Target legal advisers\", \"Goodwin Procter LLP\"],\n [\"Account\", \"Mac-Gray, a laundry facilities management company, ran one sale process. After the Board authorized exploration in April 2013 and its banker approached Party A, an unsolicited Party A proposal in June ($17.00-$19.00) led the Special Committee to solicit 50 parties (15 strategic, 35 financial) on June 24; 20 signed confidentiality agreements and four bid seriously: CSC/Pamplona and Party A (both strategic), and financial bidders Party B and Party C. Round 1 indications (due July 23) were judged low; the four advanced to management meetings and revised indications (due September 9), then to final indications (due September 18). CSC/Pamplona led at every stage ($18.50, $19.50, $20.75), Party B put the highest headline value on September 18 ($21.50 per share as valued, cash plus options), and Party C dropped out at the final deadline. On September 19 the Special Committee chose CSC/Pamplona, secured $21.25 per share with exclusivity on September 24, and signed the merger agreement on October 14, 2013, announced October 15.\"],\n]\nfor f in facts:\n    ws4.append(f)\n\n# ---------------------------------------------------------------- formatting\nwrap = Alignment(wrap_text=True, vertical=\"top\")\nhdr = Font(bold=True)\nfor sheet, widths in ((ws, [4, 20, 22, 11, 20, 8, 6, 9, 9, 8, 10, 10, 7, 16, 8, 46, 46, 6, 12, 11, 10, 10]),\n                      (ws2, [8, 6, 11, 46, 46, 12, 16, 16, 46, 34]),\n                      (ws3, [5, 52, 46, 46, 18, 40, 12]),\n                      (ws4, [30, 100])):\n    for i, w in enumerate(widths, 1):\n        sheet.column_dimensions[get_column_letter(i)].width = w\n    for row in sheet.iter_rows(min_row=1, max_row=sheet.max_row, max_col=sheet.max_column):\n        for c in row:\n            c.alignment = wrap\n            if c.row == 1:\n                c.font = hdr\n    sheet.freeze_panes = \"A2\"\n    sheet.auto_filter.ref = f\"A1:{get_column_letter(sheet.max_column)}{sheet.max_row}\"\n\n# date formats\nfor row in ws.iter_rows(min_row=2, max_row=ws.max_row):\n    for col in (20, 21, 22):\n        if row[col - 1].value is not None:\n            row[col - 1].number_format = \"MM/DD/YYYY\"\n    for col in (8, 9):\n        if row[col - 1].value is not None:\n            row[col - 1].number_format = \"0.00\"\nfor row in ws2.iter_rows(min_row=2, max_row=ws2.max_row):\n    if row[2].value is not None:\n        row[2].number_format = \"MM/DD/YYYY\"\nfor row in ws4.iter_rows(min_row=2, max_row=ws4.max_row):\n    if isinstance(row[1].value, dt.date):\n        row[1].number_format = \"MM/DD/YYYY\"\n\nout = \"/home/uctpiaj/work/extraction/mac-gray.xlsx\"\nwb.save(out)\nprint(\"saved\", out)\n\n# round-trip check\nfrom openpyxl import load_workbook\nwb2 = load_workbook(out)\nprint(\"sheets:\", wb2.sheetnames)\nfor s in wb2.sheetnames:\n    print(s, wb2[s].max_row, \"rows x\", wb2[s].max_column, \"cols, freeze:\", wb2[s].freeze_panes, \"filter:\", wb2[s].auto_filter.ref)\n"},"output":"Created file successfully: /tmp/opencode/build_ledger.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/build_ledger.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/build_ledger.py\", \"content\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Build mac-gray.xlsx deal ledger from the DEFM14A extraction.\\\"\\\"\\\"\\nimport datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Alignment, Font\\nfrom openpyxl.utils import get_column_letter\\n\\nD = lambda m, d, y: dt.date(y, m, d)\\n\\n# ---------------------------------------------------------------- ledger rows\\n# Each row: dict with keys. Tokens {XX} in notes resolved to row numbers after build.\\nrows = [\\n dict(when=\\\"10/23/2012\\\", who=\\\"BofA Merrill Lynch\\\", type=\\\"\\\", event=\\\"Adviser\\\", process=\\\"\\\", rnd=\\\"\\\",\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"BofA engaged for the 2011-2012 Discussions (Mac-Gray's possible acquisition of CSC); mandate terminated 05/15/2013 and re-engaged for the sale process 05/30/2013.\\\",\\n      quote='\\\"Mac-Gray engaged BofA Merrill Lynch on October 23, 2012\\\" (p. 27)',\\n      sort=\\\"2012-10-23\\\", dfrom=\\\"2012-10-23\\\", dto=\\\"2012-10-23\\\", flag=\\\"\\\"),\\n dict(when=\\\"04/05/2013\\\", who=\\\"Mac-Gray (Board of Directors)\\\", type=\\\"\\\", event=\\\"Target sale decision\\\", process=1, rnd=0,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Board authorized management and BofA to explore opportunities, including with Party A; further consideration deferred to the 05/09 meeting - a qualified exploration.\\\",\\n      quote='\\\"authorized Mac-Gray management to work with BofA Merrill Lynch to explore transactional opportunities that might be available to Mac-Gray, including opportunities with another strategic party\\\" (p. 27)',\\n      sort=\\\"2013-04-05\\\", dfrom=\\\"2013-04-05\\\", dto=\\\"2013-04-05\\\", flag=\\\"Q7\\\"),\\n dict(when=\\\"04/08/2013\\\", who=\\\"Party A\\\", type=\\\"Strategic\\\", event=\\\"Target interest\\\", process=1, rnd=0,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"BofA acted on the Board's instruction (04/05); first contact of the sale process; no price named.\\\",\\n      quote='\\\"representatives of BofA Merrill Lynch, as instructed by the Board, telephoned a representative of Party A to discuss generally a possible business combination between Party A and Mac-Gray\\\" (p. 27)',\\n      sort=\\\"2013-04-08\\\", dfrom=\\\"2013-04-08\\\", dto=\\\"2013-04-08\\\", flag=\\\"Q7\\\"),\\n dict(when=\\\"05/15/2013\\\", who=\\\"BofA Merrill Lynch\\\", type=\\\"\\\", event=\\\"Adviser ended\\\", process=\\\"\\\", rnd=\\\"\\\",\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Termination of the 2011-2012 Discussions engagement; Transaction Committee decided 05/14, letter sent 05/15.\\\",\\n      quote='\\\"On May 15, 2013, Mac-Gray sent a letter to BofA Merrill Lynch terminating their engagement in connection with the 2011-2012 Discussions\\\" (p. 29)',\\n      sort=\\\"2013-05-15\\\", dfrom=\\\"2013-05-15\\\", dto=\\\"2013-05-15\\\", flag=\\\"\\\"),\\n dict(when=\\\"05/30/2013\\\", who=\\\"BofA Merrill Lynch\\\", type=\\\"\\\", event=\\\"Adviser\\\", process=1, rnd=0,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Re-engaged as Mac-Gray's financial adviser; Board approved 05/30, engagement letter 05/31; BofA barred from buyer financing without consent.\\\",\\n      quote='\\\"the Board unanimously approved the engagement of BofA Merrill Lynch on the terms discussed at this meeting\\\" (p. 29)',\\n      sort=\\\"2013-05-30\\\", dfrom=\\\"2013-05-30\\\", dto=\\\"2013-05-30\\\", flag=\\\"\\\"),\\n dict(when=\\\"05/30/2013\\\", who=\\\"Moab Partners, L.P.\\\", type=\\\"\\\", event=\\\"Activist\\\", process=1, rnd=0,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Moab's proxy contest won two board seats (Rothenberg, Hyman); Rothenberg is Moab's co-founder and GP; board reduced to seven; Moab later sought a rollover (see {M1}, {M2}).\\\",\\n      quote='\\\"Mac-Gray and Moab engaged in a proxy contest leading up to the annual meeting and Mr. Rothenberg and Mr. Hyman were elected in place of Mac-Gray\\\\'s incumbent nominees\\\" (p. 29)',\\n      sort=\\\"2013-05-30\\\", dfrom=\\\"2013-05-30\\\", dto=\\\"2013-05-30\\\", flag=\\\"\\\"),\\n dict(when=\\\"06/21/2013\\\", who=\\\"Party A\\\", type=\\\"Strategic\\\", event=\\\"Bid\\\", process=1, rnd=0,\\n      plo=17.00, phi=19.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Unsolicited all-cash proposal; no diligence access yet, so Heavy by context; later revised (see {PA2}).\\\",\\n      quote='\\\"Party A submitted an unsolicited proposal to the Mac-Gray Board of Directors offering to purchase Mac-Gray for an all-cash purchase price of $17.00 to $19.00 per share\\\" (p. 30)',\\n      sort=\\\"2013-06-21\\\", dfrom=\\\"2013-06-21\\\", dto=\\\"2013-06-21\\\", flag=\\\"Q7\\\"),\\n dict(when=\\\"06/24/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", type=\\\"\\\", event=\\\"Round opened\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Special Committee concluded a sale should be considered and determined to approach 50 parties (15 strategic, 35 financial); outreach began within days.\\\",\\n      quote='\\\"the Special Committee concluded that it would be in the best interests of stockholders to consider a potential sale of Mac-Gray\\\" (p. 31)',\\n      sort=\\\"2013-06-24\\\", dfrom=\\\"2013-06-24\\\", dto=\\\"2013-06-24\\\", flag=\\\"Q1\\\"),\\n dict(when=\\\"June-July 2013\\\", who=\\\"13 strategic parties\\\", type=\\\"Strategic\\\", event=\\\"Contact\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=13, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Residual of the 15 strategic parties BofA approached; Party A (04/08 contact) and CSC/Pamplona (06/28 contact) are recorded separately.\\\",\\n      quote='\\\"15 of which were potential strategic buyers and 35 of which were potential financial buyers\\\" (p. 32)',\\n      sort=\\\"2013-06-24\\\", dfrom=\\\"2013-06-24\\\", dto=\\\"2013-07-23\\\", flag=\\\"\\\"),\\n dict(when=\\\"June-July 2013\\\", who=\\\"35 financial parties\\\", type=\\\"Financial\\\", event=\\\"Contact\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=35, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"All 35 financial parties BofA approached; no individual contacts reported; Party B and Party C appear later under NDA.\\\",\\n      quote='\\\"BofA Merrill Lynch contacted the strategic and financial parties identified at the June 24th Special Committee meeting\\\" (p. 32)',\\n      sort=\\\"2013-06-24\\\", dfrom=\\\"2013-06-24\\\", dto=\\\"2013-07-23\\\", flag=\\\"\\\"),\\n dict(when=\\\"by 06/28/2013\\\", who=\\\"CSC/Pamplona\\\", type=\\\"Strategic\\\", event=\\\"Contact\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"BofA's first contact with Pamplona; it expressed interest, including an acquisition by its portfolio company CSC; said diligence would be minimal.\\\",\\n      quote='\\\"BofA Merrill Lynch also reported that they had spoken with representatives of Pamplona, as instructed by the Special Committee, who expressed interest in a transaction\\\" (p. 32)',\\n      sort=\\\"2013-06-28\\\", dfrom=\\\"\\\", dto=\\\"2013-06-28\\\", flag=\\\"\\\"),\\n dict(when=\\\"06/28/2013\\\", who=\\\"Party B\\\", type=\\\"Financial\\\", event=\\\"NDA signed\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\\\",\\n      quote='\\\"Later on June 28, 2013, Party B, entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\\\" (p. 32)',\\n      sort=\\\"2013-06-28\\\", dfrom=\\\"2013-06-28\\\", dto=\\\"2013-06-28\\\", flag=\\\"\\\"),\\n dict(when=\\\"06/30/2013\\\", who=\\\"Party C\\\", type=\\\"Financial\\\", event=\\\"NDA signed\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\\\",\\n      quote='\\\"On June 30, 2013, Party C entered into a confidentiality and standstill agreement with Mac-Gray and was provided with an informational package\\\" (p. 32)',\\n      sort=\\\"2013-06-30\\\", dfrom=\\\"2013-06-30\\\", dto=\\\"2013-06-30\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/06/2013\\\", who=\\\"Moab\\\", type=\\\"\\\", event=\\\"Other material event\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Denied Moab's request (made 07/03) to partner exclusively with CSC/Pamplona at this stage; rollover talks deferred to a later stage (see {M2}).\\\",\\n      quote='\\\"the Special Committee decided to deny the exclusivity request at this stage ... so that the potential equity rollover of Moab\\\\'s shares could be available as a source of capital\\\" (p. 33)',\\n      sort=\\\"2013-07-06\\\", dfrom=\\\"2013-07-06\\\", dto=\\\"2013-07-06\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/11/2013\\\", who=\\\"CSC/Pamplona\\\", type=\\\"Strategic\\\", event=\\\"NDA signed\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Confidentiality and standstill agreement; informational package for a preliminary IOI due 07/23.\\\",\\n      quote='\\\"On July 11, 2013, CSC/Pamplona entered into a confidentiality and standstill agreement with Mac-Gray and were provided with an informational package\\\" (p. 33)',\\n      sort=\\\"2013-07-11\\\", dfrom=\\\"2013-07-11\\\", dto=\\\"2013-07-11\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/23/2013\\\", who=\\\"Mac-Gray\\\", type=\\\"\\\", event=\\\"Deadline\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Preliminary IOIs due; CSC/Pamplona submitted on 07/23; Party B and Party C arrived 07/24-07/25 and were considered.\\\",\\n      quote='\\\"furnished an informational package ... to formulate a preliminary indication of interest, which they were instructed to submit by July 23, 2013\\\" (p. 32)',\\n      sort=\\\"2013-07-23\\\", dfrom=\\\"2013-07-23\\\", dto=\\\"2013-07-23\\\", flag=\\\"Q2\\\"),\\n dict(when=\\\"by 07/23/2013\\\", who=\\\"16 residual NDA signers\\\", type=\\\"Financial\\\", event=\\\"Did not submit\\\", process=1, rnd=1,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=16, exitr=\\\"Not stated\\\", inf=\\\"Y\\\",\\n      note=\\\"Inferred: 20 NDA signers less Party A, Party B, Party C and CSC/Pamplona (recorded individually) = 16; no submission or later mention.\\\",\\n      quote='\\\"a total of 20 potential bidders, including two strategic bidders (Party A and CSC/Pamplona) and 18 financial bidders ... entered into confidentiality agreements with Mac-Gray\\\" (p. 32)',\\n      sort=\\\"2013-07-23\\\", dfrom=\\\"\\\", dto=\\\"2013-07-23\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/23/2013\\\", who=\\\"CSC/Pamplona\\\", type=\\\"Strategic\\\", event=\\\"Bid\\\", process=1, rnd=1,\\n      plo=18.50, phi=18.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Preliminary IOI; pre-diligence so Heavy by context; Pamplona had said diligence would be minimal; later revised (see {CP2}).\\\",\\n      quote='\\\"On July 23, 2013, CSC/Pamplona submitted a preliminary indication of interest at an all-cash purchase price of $18.50 per share\\\" (p. 33)',\\n      sort=\\\"2013-07-23\\\", dfrom=\\\"2013-07-23\\\", dto=\\\"2013-07-23\\\", flag=\\\"Q6\\\"),\\n dict(when=\\\"07/24/2013\\\", who=\\\"Party B\\\", type=\\\"Financial\\\", event=\\\"Bid\\\", process=1, rnd=1,\\n      plo=17.00, phi=18.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Preliminary IOI submitted one day after the 07/23 due date; pre-diligence so Heavy by context; later revised (see {PB2}).\\\",\\n      quote='\\\"On July 24, 2013, Party B submitted a preliminary indication of interest at an all-cash purchase price of $17.00 to $18.00 per share\\\" (p. 33)',\\n      sort=\\\"2013-07-24\\\", dfrom=\\\"2013-07-24\\\", dto=\\\"2013-07-24\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/24/2013\\\", who=\\\"Party C\\\", type=\\\"Financial\\\", event=\\\"Bid\\\", process=1, rnd=1,\\n      plo=15.00, phi=17.00, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"Oral preliminary IOI to BofA; pre-diligence so Heavy by context; written revision next day (see {PC2}).\\\",\\n      quote='\\\"representatives from Party C called BofA Merrill Lynch and presented an oral preliminary indication of interest at an all-cash purchase price of $15.00 to $17.00 per share\\\" (p. 33)',\\n      sort=\\\"2013-07-24\\\", dfrom=\\\"2013-07-24\\\", dto=\\\"2013-07-24\\\", flag=\\\"\\\"),\\n dict(when=\\\"07/25/2013\\\", who=\\\"Mac-Gray (Special Committee)\\\", type=\\\"\\\", event=\\\"Round opened\\\", process=1, rnd=2,\\n      plo=None, phi=None, cash=\\\"\\\", form=\\\"\\\", cond=\\\"\\\", count=None, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"IOIs judged lower than expected; four bidders advanced to staged disclosure and management meetings (held 08/06-08/14); revised IOIs to follow.\\\",\\n      quote='\\\"authorized and instructed BofA Merrill Lynch to proceed with the staged disclosure ... and to reach out to each of the four interested bidders and arrange management meetings\\\" (p. 34)',\\n      sort=\\\"2013-07-25\\\", dfrom=\\\"2013-07-25\\\", dto=\\\"2013-07-25\\\", flag=\\\"Q1\\\"),\\n dict(when=\\\"07/25/2013\\\", who=\\\"Party C\\\", type=\\\"Financial\\\", event=\\\"Bid\\\", process=1, rnd=1,\\n      plo=16.00, phi=16.50, cash=\\\"Yes\\\", form=\\\"Informal\\\", cond=\\\"Heavy\\\", count=1, exitr=\\\"\\\", inf=\\\"\\\",\\n      note=\\\"revises {PC1}; written IOI submitted after the round-2 decision; pre-diligence so Heavy by context; later revised (see {PC3}).\\\",\\n      quote='\\\"Later on July 25, 2013, Party C submitted a written indication of interest at an all-cash purchase price of $16.00 to $16.50 per share\\\" (p. 34)',\\n      sort=\