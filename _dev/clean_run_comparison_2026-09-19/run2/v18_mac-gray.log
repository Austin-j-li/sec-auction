n# bid inventory\\nprint(\\\"\\\\nBids:\\\")\\nfor r in range(2, ws.max_row+1):\\n    if ws.cell(r,5).value in (\\\"Bid\\\",\\\"Bid reaffirmed\\\"):\\n        print(f\\\"  #{ws.cell(r,1).value} {ws.cell(r,3).value} {ws.cell(r,2).value} {ws.cell(r,8).value}-{ws.cell(r,9).value} \\\"\\n              f\\\"{ws.cell(r,11).value}/{ws.cell(r,12).value} rnd={ws.cell(r,7).value}\\\")\\nprint(\\\"\\\\nExits:\\\")\\nfor r in range(2, ws.max_row+1):\\n    if ws.cell(r,5).value in (\\\"Dropped by target\\\",\\\"Withdrew\\\",\\\"Did not submit\\\",\\\"Not selected at signing\\\"):\\n        print(f\\\"  #{ws.cell(r,1).value} {ws.cell(r,3).value} {ws.cell(r,2).value} {ws.cell(r,14).value} inf={ws.cell(r,15).value}\\\")\\n\\n# 4) structure checks\\nfor name in wb.sheetnames:\\n    s=wb[name]\\n    if s.freeze_panes!='A2': errors.append(f\\\"{name}: freeze {s.freeze_panes}\\\")\\n    if not s.auto_filter.ref: errors.append(f\\\"{name}: no filter\\\")\\n    if s.merged_cells.ranges: errors.append(f\\\"{name}: merged cells\\\")\\nprint(\\\"\\\\nERRORS:\\\", len(errors))\\nfor e in errors: print(\\\"  E:\\\", e)\\nprint(\\\"WARN:\\\", len(warn))\\nfor w in warn: print(\\\"  W:\\\", w)\\n\", \"path\": \"/tmp/opencode/verify_ledger.py\"}"},"time":{"start":1789825621921,"end":1789825628766}}}}
