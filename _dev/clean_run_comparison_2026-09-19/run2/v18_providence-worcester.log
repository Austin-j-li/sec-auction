{"type":"tool_use","timestamp":1789825538334,"sessionID":"ses_f461f2da0ffepmGxMLqn7fNdlL","part":{"partID":"prt_0b9ea0136001lqBvshAZP0U84V","sessionID":"ses_f461f2da0ffepmGxMLqn7fNdlL","messageID":"msg_0b9e9a417001zQ46K8Aq272VLH","type":"tool","id":"call_00_MisRcgYMdLLqqthI5gKd7858","tool":"write","state":{"status":"completed","input":{"path":"/tmp/opencode/pw/build.py","content":"# -*- coding: utf-8 -*-\n\"\"\"Build providence-worcester.xlsx per SEC_Deal_Ledger_Extraction_Instruction.md (v1.8).\"\"\"\nimport re, datetime as dt\nfrom openpyxl import Workbook\nfrom openpyxl.styles import Font, Alignment\nfrom openpyxl.utils import get_column_letter\n\nD = dt.date\n\n# ---------- source text for verification ----------\nraw = open('/tmp/opencode/pw/filing.txt', encoding='utf-8').read()\nnorm = re.sub(r'\\s+', ' ', raw)\nlines = raw.split('\\n')\n\n# page markers: standalone numbers (footers)\nmarks = []\nfor i, l in enumerate(lines):\n    m = re.fullmatch(r'\\s*(\\d{1,3})\\s*', l)\n    if m and 1 <= int(m.group(1)) <= 90:\n        marks.append((i + 1, int(m.group(1))))\n\n\ndef page_of_quote(q):\n    # find first line where the quote starts, using whitespace-normalized per-line scan\n    flat = norm\n    pos = flat.find(q)\n    if pos < 0:\n        return None\n    # line number containing the start of the match: walk through lines\n    acc = 0\n    for idx, l in enumerate(lines, start=1):\n        ln = re.sub(r'\\s+', ' ', l)\n        # approximate: find the line where the remaining text begins\n        if acc + len(ln) + 1 > pos:\n            ln_no = idx\n            break\n        acc += len(ln) + 1\n    else:\n        return None\n    for mln, pg in marks:\n        if mln >= ln_no:\n            return pg\n    return None\n\n\n# ---------- Deal ledger ----------\nL_HDR = [\"#\", \"When\", \"Who\", \"Type\", \"Event\", \"Process\", \"Round\", \"Price low\", \"Price high\",\n         \"All cash\", \"Formality\", \"Conditions\", \"Count\", \"Exit reason\", \"Inferred\", \"Note\",\n         \"Quote and page\", \"Flag\", \"Reviewer note\", \"Sort date\", \"Date from\", \"Date to\"]\n\n# row tuple: when, who, type, event, round, plow, phigh, allcash, formality, conditions, count,\n#            exitreason, inferred, note, quote, page, flag, sort, dfrom, dto\nledger = []\n\nledger.append((\"Q4 2015\", \"Party A\", \"Strategic\", \"Bidder interest\", 0, None, None, None, None, None, 1,\n    None, None,\n    \"Class I rail partner raised joint-venture ideas and interest in acquiring equity; no price or offer made. Prompted the Board's banker interviews on strategic options.\",\n    \"Party A suggested possible joint venture arrangements and expressed some interest in acquiring equity in the Company\", 27, None,\n    D(2015,11,15), D(2015,10,1), D(2015,12,31)))\n\nledger.append((\"Q4 2015\", \"PWRR\", None, \"Other material event\", 0, None, None, None, None, None, None,\n    None, None,\n    \"Appointed an independent-director subcommittee (Barrett, Anderson) to interview investment banks for possible Party A negotiations and to evaluate strategic options, including a change of control; several firms interviewed.\",\n    \"the Board appointed a subcommittee of two independent directors, Frank W. Barrett and Richard W. Anderson, to interview potential investment bankers\", 27, None,\n    D(2015,12,1), D(2015,10,1), D(2015,12,31)))\n\nledger.append((\"01/27/2016\", \"GHF\", None, \"Adviser\", 0, None, None, None, None, None, None,\n    None, None,\n    \"Target's financial adviser; selected after subcommittee interviews; agreed not to represent any buyer or offer financier. GHF's business was acquired by BMO on 08/01/2016 \\u2014 same adviser, one relationship.\",\n    \"the Board approved the subcommittee\\u2019s recommendation and the Company engaged GHF\", 27, None,\n    D(2016,1,27), D(2016,1,27), D(2016,1,27)))\n\nledger.append((\"03/14/2016\", \"PWRR\", None, \"Target sale decision\", 0, None, None, None, None, None, None,\n    None, None,\n    \"Board approved the strategy: discussions with Party A plus solicitation of other parties, and appointed the Transaction Committee (Barrett chair; Anderson; Garvey), which could not itself approve a transaction.\",\n    \"Representatives of GHF then proposed a process pursuant to which the Company would proceed with discussions with Party A and also solicit interest from other potential third parties\", 27, None,\n    D(2016,3,14), D(2016,3,14), D(2016,3,14)))\n\nledger.append((\"03/24/2016\", \"Hinckley Allen\", None, \"Adviser\", 0, None, None, None, None, None, None,\n    None, None,\n    \"Target legal counsel; first seen acting at the 03/24/2016 Transaction Committee call and participated in all Committee meetings; later negotiated the merger agreement.\",\n    \"representatives of each of GHF and the Company\\u2019s legal counsel, Hinckley, Allen & Snyder LLP\", 28, None,\n    D(2016,3,24), D(2016,3,24), D(2016,3,24)))\n\nledger.append((\"week of March 28, 2016\", \"GHF\", None, \"Round opened\", 1, None, None, None, None, None, None,\n    None, None,\n    \"First outreach wave: GHF contacted 11 potential strategic buyers (incl. Party A) and 18 potential financial buyers; five strategic buyers (incl. G&W) met management at the April 3\\u20136 Connections Convention.\",\n    \"representatives of GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers\", 28, \"Q1\",\n    D(2016,3,31), D(2016,3,28), D(2016,4,3)))\n\nledger.append((\"by 04/07/2016\", \"2 additional Class I railroads\", \"Strategic\", \"Contact\", 1, None, None, None, None, None, 2,\n    None, None,\n    \"Company approached two further Class I railroads to gauge interest; the filing does not say whether they signed confidentiality agreements, remained in the process, or bid.\",\n    \"Mr. Noreck reported that the Company had also approached two additional Class I railroads to determine their interest in a possible transaction\", 28, \"Q3\",\n    D(2016,4,7), None, D(2016,4,7)))\n\nledger.append((\"by 04/22/2016\", \"11 strategic NDA signers\", \"Strategic\", \"NDA signed\", 1, None, None, None, None, None, 11,\n    None, None,\n    \"All 11 contacted strategic buyers executed confidentiality agreements with no standstills; signers received the Company memorandum (also given to Party C later) and were advised of the IOI deadline.\",\n    \"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements\", 28, \"Q3\",\n    D(2016,4,9), D(2016,3,28), D(2016,4,22)))\n\nledger.append((\"by 04/22/2016\", \"14 financial NDA signers\", \"Financial\", \"NDA signed\", 1, None, None, None, None, None, 14,\n    None, None,\n    \"14 of 18 contacted financial buyers signed confidentiality agreements (4 did not); with the 11 strategic signers these are the filing's stated 25 signers.\",\n    \"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements\", 28, \"Q3\",\n    D(2016,4,9), D(2016,3,28), D(2016,4,22)))\n\nledger.append((\"04/27/2016\", \"PWRR\", None, \"Deadline set\", 1, None, None, None, None, None, None,\n    None, None,\n    \"Board reviewed the process; potential buyers had been advised to submit non-binding IOIs by 05/10/2016; the deadline was later postponed to 05/19/2016.\",\n    \"each potential buyer had been advised to submit a non-binding indication of interest by May 10, 2016\", 29, None,\n    D(2016,4,27), D(2016,4,27), D(2016,4,27)))\n\nledger.append((\"subsequently to 04/27/2016\", \"PWRR\", None, \"Deadline revised\", 1, None, None, None, None, None, None,\n    None, None,\n    \"IOI deadline postponed from 05/10/2016 to 05/19/2016 so buyers could prepare their most compelling offers; 05/10 was superseded before arrival, so no outcome is recorded for it.\",\n    \"which deadline was subsequently postponed to May 19, 2016 to ensure the potential buyers had sufficient time to formulate their most compelling offers\", 29, None,\n    D(2016,5,3), D(2016,4,27), D(2016,5,10)))\n\nledger.append((\"05/19/2016\", \"PWRR\", None, \"Deadline\", 1, None, None, None, None, None, None,\n    None, None,\n    \"IOI due date reached; nine IOIs arrived over 05/19\\u201306/01 and were considered. Rounds sheet records Late bids accepted (Q2).\",\n    \"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest (\\u201cIOIs\\u201d) from potential buyers\", 29, \"Q2\",\n    D(2016,5,19), D(2016,5,19), D(2016,5,19)))\n\nledger.append((\"between 05/19/2016 and 06/01/2016\", \"Nine IOI submitters\", \"Unknown\", \"Bid\", 1, 17.93, 26.50, \"Not stated\", \"Informal\", \"Heavy\", 9,\n    None, None,\n    \"Nine unnamed submitters; as-converted per-share prices implying $90\\u2013134 million equity; preliminary and pre-diligence, so Heavy by context; includes the five bidders later named in the LOI round.\",\n    \"the Company received nine written indications of interest (\\u201cIOIs\\u201d) from potential buyers, with offer prices per share ranging from $17.93 to $26.50\", 29, None,\n    D(2016,5,19), D(2016,5,19), D(2016,6,1)))\n\nledger.append((\"by 05/19/2016\", \"16 NDA signers\", \"Unknown\", \"Did not submit\", 1, None, None, None, None, None, 16,\n    \"Not stated\", \"Y\",\n    \"Arithmetic: 25 signers \\u2212 9 IOI submitters = 16; identities and types not disclosed. May include Party A. Exits inferred at the IOI deadline (Q3).\",\n    \"the Company received nine written indications of interest (\\u201cIOIs\\u201d) from potential buyers\", 29, \"Q3\",\n    D(2016,5,19), None, D(2016,5,19)))\n\nledger.append((\"between 05/23/2016 and 06/01/2016\", \"Two low bidders\", \"Unknown\", \"Dropped by target\", 1, None, None, None, None, None, 2,\n    \"Lower offer than rivals\", None,\n    \"Lowest of the nine IOI submitters excluded to spare management time before presentations; identities and types not disclosed.\",\n    \"In view of the substantial amount of management time that would be required for management presentations, the Transaction Committee concluded that the two low bidders should be excluded\", 29, None,\n    D(2016,5,27), D(2016,5,23), D(2016,6,1)))\n\nledger.append((\"between 05/23/2016 and 06/01/2016\", \"PWRR (Transaction Committee)\", None, \"Round opened\", 2, None, None, None, None, None, None,\n    None, None,\n    \"Committee excluded the two low bidders and advanced seven to in-person management presentations and internet-data-site diligence, tied to the mid-June LOI request (Q1).\",\n    \"authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers\", 29, \"Q1\",\n    D(2016,5,27), D(2016,5,23), D(2016,6,1)))\n\nledger.append((\"mid-June 2016\", \"GHF\", None, \"Deadline set\", 2, None, None, None, None, None, None,\n    None, None,\n    \"GHF instructed all potential buyers to submit non-binding LOIs by 07/20/2016 with markups of merger agreement, disclosure letter and voting agreement, valuing 100% of the common stock per share (as converted).\",\n    \"representatives of GHF instructed all potential buyers to submit non-binding letters of intent (\\u201cLOIs\\u201d) by July 20, 2016\", 29, None,\n    D(2016,6,15), D(2016,6,11), D(2016,6,19)))\n\nledger.append((\"early July 2016\", \"Party C\", \"Strategic\", \"Bidder interest\", 2, None, None, None, None, None, 1,\n    None, None,\n    \"Late entrant not previously in the process approached management about acquiring the Company; then signed a confidentiality agreement and received the memorandum.\",\n    \"a potential strategic buyer that had not previously been part of the process (\\u201cParty C\\u201d) approached the Company\\u2019s management and expressed interest in acquiring the Company\", 29, None,\n    D(2016,7,5), D(2016,7,1), D(2016,7,10)))\n\nledger.append((\"early July 2016\", \"Party C\", \"Strategic\", \"NDA signed\", 2, None, None, None, None, None, 1,\n    None, None,\n    \"Late entrant's confidentiality agreement; afterwards provided the memorandum already given to the 25 signers. The filing's 25-signer count does not clearly include Party C (Q3).\",\n    \"After executing a confidentiality agreement, Party C was provided the memorandum concerning the Company provided to the other potential buyers\", 29, \"Q3\",\n    D(2016,7,6), D(2016,7,1), D(2016,7,10)))\n\nledger.append((\"07/12/2016\", \"Party C\", \"Strategic\", \"Bid\", 2, 21.00, 21.00, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"IOI at $21.00 per share; implied equity value $108 million; made before Party C received data-site access and a management presentation, so preliminary and Heavy by context.\",\n    \"Party C submitted an IOI with an offer price per share of $21.00 (implying an equity value of $108 million)\", 29, None,\n    D(2016,7,12), D(2016,7,12), D(2016,7,12)))\n\nledger.append((\"07/14/2016\", \"Party C\", \"Strategic\", \"Other material event\", 2, None, None, None, None, None, 1,\n    None, None,\n    \"Catch-up access: after its 07/12 IOI, Party C was given internet data-site access and a telephone management presentation; the seven earlier bidders had in-person presentations.\",\n    \"Party C was provided access to the internet data site and the Company\\u2019s management held a management presentation with Party C by telephone\", 29, None,\n    D(2016,7,14), D(2016,7,14), D(2016,7,14)))\n\nledger.append((\"07/20/2016\", \"PWRR\", None, \"Deadline\", 2, None, None, None, None, None, None,\n    None, None,\n    \"LOI/markup due date reached; six LOIs arrived in late July, including G&W's dated 07/21 after the deadline, which the Company considered; recorded as Late bids accepted (Q2).\",\n    \"In late July 2016, the Company received six LOIs with offer prices per share ranging from $19.20 to $24.00\", 29, \"Q2\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,20)))\n\nledger.append((\"late July 2016\", \"Party B\", \"Strategic\", \"Bid\", 2, 24.00, 24.00, \"Not stated\", \"Formal\", \"Light\", 1,\n    None, None,\n    \"LOI with markups of the merger agreement and voting agreement; subject to an expedited diligence review; highest of the six LOIs.\",\n    \"Party B submitted an LOI to acquire the Company for a price of $24.00 per share (subject to an expedited diligence review)\", 29, \"Q6\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\n\nledger.append((\"late July 2016\", \"Party E\", \"Strategic\", \"Bid\", 2, 21.26, 21.26, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"LOI subject to a 60-day exclusivity period for diligence and definitive documentation; provided an issues summary rather than a markup, so classified Informal.\",\n    \"Party E (a strategic buyer) submitted an LOI to acquire the Company for a price of $21.26 per share\", 30, \"Q6\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\n\nledger.append((\"late July 2016\", \"Party D\", \"Financial\", \"Bid\", 2, 21.00, 21.00, \"Not stated\", \"Formal\", \"Heavy\", 1,\n    None, None,\n    \"Financial buyer's LOI with markups of the merger agreement and voting agreement; subject to a four-week diligence period.\",\n    \"Party D (a financial buyer) submitted an LOI to acquire the Company for a price of $21.00 per share (subject to a four-week diligence period)\", 30, \"Q6\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\n\nledger.append((\"late July 2016\", \"Party C\", \"Strategic\", \"Bid\", 2, 19.30, 19.30, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"LOI subject to a 30-day diligence period; no markup reported; lower than Party C's 07/12 IOI.\",\n    \"Party C submitted an LOI to acquire the Company for a price of $19.30 per share (subject to a 30-day diligence period)\", 30, \"Q6\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\n\nledger.append((\"late July 2016\", \"Party F\", \"Strategic\", \"Bid\", 2, 19.20, 19.20, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"LOI subject to a 30-day due diligence period; lowest of the six. Later gave financing support to Party E's 08/01 revised bid.\",\n    \"Party F (a strategic buyer) submitted an LOI to acquire the Company for a price of $19.20 per share (subject to a 30-day due diligence period)\", 30, \"Q6\",\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\n\nledger.append((\"by 07/20/2016\", \"1 strategic non-submitter\", \"Strategic\", \"Did not submit\", 2, None, None, None, None, None, 1,\n    \"Not stated\", None,\n    \"One unnamed strategic buyer in the LOI stage elected not to submit an LOI; reported by the filing without further detail.\",\n    \"One strategic buyer and one financial buyer elected not to submit an LOI\", 30, None,\n    D(2016,7,20), None, D(2016,7,20)))\n\nledger.append((\"by 07/20/2016\", \"1 financial non-submitter\", \"Financial\", \"Did not submit\", 2, None, None, None, None, None, 1,\n    \"Not stated\", None,\n    \"One unnamed financial buyer in the LOI stage elected not to submit an LOI; reported by the filing without further detail.\",\n    \"One strategic buyer and one financial buyer elected not to submit an LOI\", 30, None,\n    D(2016,7,20), None, D(2016,7,20)))\n\nledger.append((\"07/21/2016\", \"G&W\", \"Strategic\", \"Bid\", 2, 21.15, 21.15, \"Yes\", \"Formal\", \"Heavy\", 1,\n    None, None,\n    \"$20.02 cash at closing plus $1.13 CVR based on the South Quay property sale; three-week exclusive diligence condition; markups of merger agreement, voting agreement and disclosure letter; one day late.\",\n    \"G&W submitted an LOI on July 21, 2016 to acquire the Company for a price of $21.15 per share (subject to a three-week exclusive diligence period)\", 29, \"Q6\",\n    D(2016,7,21), D(2016,7,21), D(2016,7,21)))\n\nledger.append((\"07/26/2016\", \"G&W\", \"Strategic\", \"Bid\", 2, 22.15, 22.15, \"Yes\", \"Formal\", \"Heavy\", 1,\n    None, None,\n    \"Revised after GHF said the $21.15 price and CVR structure were not competitive: $21.02 cash plus $1.13 CVR; three-week exclusive diligence condition unchanged.\",\n    \"G&W submitted a revised LOI, which increased its offer to $22.15 per share (including $21.02 in cash and $1.13 CVR)\", 29, \"Q6\",\n    D(2016,7,26), D(2016,7,26), D(2016,7,26)))\n\nledger.append((\"07/27/2016\", \"PWRR (Transaction Committee)\", None, \"Round opened\", 3, None, None, None, None, None, None,\n    None, None,\n    \"Committee advanced G&W and Party B to confirmatory due diligence and negotiations on their higher offers; no exclusivity executed; post-selection bids and diligence follow (Q1).\",\n    \"the Company should proceed with confirmatory due diligence and negotiations with G&W and Party B because of the higher offers made by each of G&W and Party B\", 30, \"Q1\",\n    D(2016,7,27), D(2016,7,27), D(2016,7,27)))\n\nfor nm, pr in ((\"Party C\", 19.30), (\"Party D\", 21.00), (\"Party E\", 21.26), (\"Party F\", 19.20)):\n    who_type = \"Financial\" if nm == \"Party D\" else \"Strategic\"\n    ledger.append((\"07/27/2016\", nm, who_type, \"Dropped by target\", 2, None, None, None, None, None, 1,\n        \"Lower offer than rivals\", None,\n        \"Told by GHF after the 07/27 selection that it was no longer involved; $%.2f LOI below the two finalists' offers.\" % pr,\n        \"representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process\", 30, None,\n        D(2016,7,27), D(2016,7,27), D(2016,7,27)))\n\nledger.append((\"08/01/2016\", \"Party D\", \"Financial\", \"Bid\", 3, 24.00, 24.00, \"Not stated\", \"Formal\", \"Heavy\", 1,\n    None, None,\n    \"returned after exit #34; revised LOI at a matching $24.00 with a 30-day due diligence period; on 08/02 declined to shorten it.\",\n    \"On August 1, 2016, Party D submitted a revised LOI at a price of $24.00 per share\", 30, None,\n    D(2016,8,1), D(2016,8,1), D(2016,8,1)))\n\nledger.append((\"08/01/2016\", \"Party E\", \"Strategic\", \"Bid\", 3, 23.81, 23.81, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"returned after exit #35; revised LOI with a 30-day due diligence period and financing support from Party F, which had already left the process \\u2014 no new row for F.\",\n    \"Party E submitted a revised LOI, along with financing support, from Party F, at a price of $23.81 per share\", 30, None,\n    D(2016,8,1), D(2016,8,1), D(2016,8,1)))\n\nledger.append((\"08/02/2016\", \"Party E\", \"Strategic\", \"Bid\", 3, 21.26, 21.26, \"Not stated\", \"Informal\", \"Heavy\", 1,\n    None, None,\n    \"revises #38: withdrew the $23.81 revision and confirmed its original $21.26 proposal \\u2014 a new bid at the old level, not an exit; standing 60-day exclusivity condition.\",\n    \"Party E withdrew its revised proposal on August 2, 2016 (but confirmed its original proposal of $21.26 per share)\", 30, None,\n    D(2016,8,2), D(2016,8,2), D(2016,8,2)))\n\nledger.append((\"08/02/2016\", \"Party D\", \"Financial\", \"Withdrew\", 3, None, None, None, None, None, 1,\n    \"Terms or process\", None,\n    \"D's decision: declined to shorten its 30-day diligence period and sought a no-signing commitment during it; Company refused; D would not proceed with further diligence at that time.\",\n    \"Party D declined to shorten its due diligence period and requested that the Company commit that it would not enter into an agreement with another bidder\", 30, None,\n    D(2016,8,2), D(2016,8,2), D(2016,8,2)))\n\nledger.append((\"by 08/04/2016\", \"Party E\", \"Strategic\", \"Dropped by target\", 3, None, None, None, None, None, 1,\n    \"Not stated\", \"Y\",\n    \"E not among the parties the Committee directed on 08/04 to continue diligence and negotiations (G&W, Party B); closed by inference \\u2014 no reported exclusion or statement (Q5).\",\n    \"During that discussion, the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B\", 31, \"Q5\",\n    D(2016,8,4), None, D(2016,8,4)))\n\nledger.append((\"08/04/2016\", \"Party B\", \"Strategic\", \"Bid reaffirmed\", 3, 24.00, 24.00, \"Not stated\", \"Formal\", \"Light\", 1,\n    None, None,\n    \"reaffirmed by returned draft: B's counsel returned a revised merger agreement draft after the Committee decided to complete the agreement with B; $24.00 carried from #23; standing expedited-diligence condition.\",\n    \"legal counsel for Party B provided a revised draft of the merger agreement\", 31, \"Q4\",\n    D(2016,8,4), D(2016,8,4), D(2016,8,4)))\n\nledger.append((\"08/09/2016\", \"G&W\", \"Strategic\", \"Other material event\", 3, None, None, None, None, None, 1,\n    None, None,\n    \"Informed G&W the Company intended to enter a merger agreement with another bidder; G&W asked to continue physical diligence on 08/10\\u201308/11 to prepare an improved offer; granted.\",\n    \"the Transaction Committee directed representatives of BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder\", 31, None,\n    D(2016,8,9), D(2016,8,9), D(2016,8,9)))\n\nledger.append((\"08/10/2016\", \"Simpson Thacher\", None, \"Adviser\", 3, None, None, None, None, None, None,\n    None, None,\n    \"G&W's legal counsel; first seen acting in the 08/10/2016 discussion of merger and voting agreement provisions; submitted G&W's disclosure-letter markup on 08/12.\",\n    \"representatives of Hinckley Allen and Simpson Thacher & Bartlett LLP (which we refer to as \\u201cSimpson Thacher\\u201d), G&W\\u2019s legal counsel\", 31, None,\n    D(2016,8,10), D(2016,8,10), D(2016,8,10)))\n\nledger.append((\"08/12/2016\", \"G&W\", \"Strategic\", \"Bid\", 3, 25.00, 25.00, \"Yes\", \"Formal\", \"None\", 1,\n    None, None,\n    \"Revised LOI at $25.00 all cash, dropping the CVR; markups of merger agreement and voting agreement (disclosure-letter markup later); offer to expire 6:00 p.m. 08/13; no financing condition in the executed agreement.\",\n    \"G&W submitted a revised LOI to acquire the Company for a price of $25.00 per share in cash, which excluded the previously proposed CVR\", 31, None,\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\n\nledger.append((\"08/12/2016\", \"Party B\", \"Strategic\", \"Not selected at signing\", 3, None, None, None, None, None, 1,\n    \"Would not improve earlier offer\", None,\n    \"Asked on 08/12 whether it would raise its standing $24.00 bid after another party bid higher; declined; Board then determined G&W's $25.00 superior and signed.\",\n    \"Party B indicated that it would not increase its price\", 32, None,\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\n\nledger.append((\"08/12/2016\", \"PWRR and G&W\", None, \"Merger agreement signed\", 3, None, None, None, None, None, None,\n    None, None,\n    \"Agreed price $25.00 per share of common stock in cash; preferred converts 100-for-1 (plus accrued dividends) and receives the same $25.00. Board approved; Eder Trusts signed the voting agreement.\",\n    \"the Company and G&W executed the merger agreement, and the Company, G&W and the Eder Trusts executed the voting agreement\", 32, None,\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\n\nledger.append((\"08/15/2016\", \"PWRR\", None, \"Merger announced\", \"post\", None, None, None, None, None, None,\n    None, None,\n    \"Press release before market open announced the signed merger; prior close $16.30, a 53% premium.\",\n    \"The Company issued a press release publicly announcing the transaction on Monday, August 15, 2016 prior to the opening of trading\", 32, None,\n    D(2016,8,15), D(2016,8,15), D(2016,8,15)))\n\n# assign numbers\nrows = []\nfor i, r in enumerate(ledger, start=1):\n    rows.append((i,) + r)\n\n# ---------- validation ----------\nerrors = []\nprev = None\nfor r in rows:\n    (num, when, who, typ, ev, rnd, plow, phigh, allcash, form, cond, count, exitr, inf, note, quote, page, flag, srt, dfr, dto) = r\n    wc = len(note.split())\n    if wc > 40:\n        errors.append(f\"row {num}: note {wc} words\")\n    qwc = len(quote.split())\n    if qwc > 30:\n        errors.append(f\"row {num}: quote {qwc} words\")\n    if quote not in norm:\n        errors.append(f\"row {num}: QUOTE NOT FOUND: {quote[:60]}\")\n    else:\n        pg = page_of_quote(quote)\n        if pg != page:\n            errors.append(f\"row {num}: page mismatch got {pg} want {page}\")\n    if not who:\n        errors.append(f\"row {num}: empty Who\")\n    if srt is None:\n        errors.append(f\"row {num}: empty sort date\")\n    if prev and srt < prev:\n        errors.append(f\"row {num}: sort date decreased {prev} -> {srt}\")\n    prev = srt\n    if dfr and srt < dfr or dto and srt > dto:\n        errors.append(f\"row {num}: sort outside from-to\")\n    for lab, val, allowed in ((\"Type\", typ, {\"Strategic\", \"Financial\", \"Mixed\", \"Unknown\"}),\n                              (\"All cash\", allcash, {\"Yes\", \"No\", \"Not stated\"}),\n                              (\"Formality\", form, {\"Formal\", \"Informal\", \"Unclear\"}),\n                              (\"Conditions\", cond, {\"None\", \"Light\", \"Heavy\", \"Unclear\"}),\n                              (\"Exit reason\", exitr, {\"Value below market price\", \"Value at or below market price\",\n                                                      \"Value below earlier offer\", \"Value at earlier offer\",\n                                                      \"Would not improve earlier offer\", \"Lower offer than rivals\",\n                                                      \"Terms or process\", \"Other stated reason\", \"Not stated\"}),\n                              (\"Inferred\", inf, {\"Y\"})):\n        if val is not None and val not in allowed:\n            errors.append(f\"row {num}: bad {lab}={val}\")\n    if rnd not in (0, 1, 2, 3, \"post\"):\n        errors.append(f\"row {num}: bad round {rnd}\")\n\nprint(\"LEDGER ROWS:\", len(rows))\nif errors:\n    print(\"ERRORS:\")\n    for e in errors:\n        print(\" \", e)\nelse:\n    print(\"All ledger validation checks passed.\")\n\n# exit-reference sanity for numbered notes\nimport sys\nsys.stdout.flush()\n"},"output":"Created file successfully: /tmp/opencode/pw/build.py","title":"write","metadata":{"metadata":{"truncated":false},"content":[{"type":"text","text":"Created file successfully: /tmp/opencode/pw/build.py"}],"providerCall":{"executed":false},"providerResult":{"executed":false},"rawInput":"{\"path\": \"/tmp/opencode/pw/build.py\", \"content\": \"# -*- coding: utf-8 -*-\\n\\\"\\\"\\\"Build providence-worcester.xlsx per SEC_Deal_Ledger_Extraction_Instruction.md (v1.8).\\\"\\\"\\\"\\nimport re, datetime as dt\\nfrom openpyxl import Workbook\\nfrom openpyxl.styles import Font, Alignment\\nfrom openpyxl.utils import get_column_letter\\n\\nD = dt.date\\n\\n# ---------- source text for verification ----------\\nraw = open('/tmp/opencode/pw/filing.txt', encoding='utf-8').read()\\nnorm = re.sub(r'\\\\s+', ' ', raw)\\nlines = raw.split('\\\\n')\\n\\n# page markers: standalone numbers (footers)\\nmarks = []\\nfor i, l in enumerate(lines):\\n    m = re.fullmatch(r'\\\\s*(\\\\d{1,3})\\\\s*', l)\\n    if m and 1 <= int(m.group(1)) <= 90:\\n        marks.append((i + 1, int(m.group(1))))\\n\\n\\ndef page_of_quote(q):\\n    # find first line where the quote starts, using whitespace-normalized per-line scan\\n    flat = norm\\n    pos = flat.find(q)\\n    if pos < 0:\\n        return None\\n    # line number containing the start of the match: walk through lines\\n    acc = 0\\n    for idx, l in enumerate(lines, start=1):\\n        ln = re.sub(r'\\\\s+', ' ', l)\\n        # approximate: find the line where the remaining text begins\\n        if acc + len(ln) + 1 > pos:\\n            ln_no = idx\\n            break\\n        acc += len(ln) + 1\\n    else:\\n        return None\\n    for mln, pg in marks:\\n        if mln >= ln_no:\\n            return pg\\n    return None\\n\\n\\n# ---------- Deal ledger ----------\\nL_HDR = [\\\"#\\\", \\\"When\\\", \\\"Who\\\", \\\"Type\\\", \\\"Event\\\", \\\"Process\\\", \\\"Round\\\", \\\"Price low\\\", \\\"Price high\\\",\\n         \\\"All cash\\\", \\\"Formality\\\", \\\"Conditions\\\", \\\"Count\\\", \\\"Exit reason\\\", \\\"Inferred\\\", \\\"Note\\\",\\n         \\\"Quote and page\\\", \\\"Flag\\\", \\\"Reviewer note\\\", \\\"Sort date\\\", \\\"Date from\\\", \\\"Date to\\\"]\\n\\n# row tuple: when, who, type, event, round, plow, phigh, allcash, formality, conditions, count,\\n#            exitreason, inferred, note, quote, page, flag, sort, dfrom, dto\\nledger = []\\n\\nledger.append((\\\"Q4 2015\\\", \\\"Party A\\\", \\\"Strategic\\\", \\\"Bidder interest\\\", 0, None, None, None, None, None, 1,\\n    None, None,\\n    \\\"Class I rail partner raised joint-venture ideas and interest in acquiring equity; no price or offer made. Prompted the Board's banker interviews on strategic options.\\\",\\n    \\\"Party A suggested possible joint venture arrangements and expressed some interest in acquiring equity in the Company\\\", 27, None,\\n    D(2015,11,15), D(2015,10,1), D(2015,12,31)))\\n\\nledger.append((\\\"Q4 2015\\\", \\\"PWRR\\\", None, \\\"Other material event\\\", 0, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Appointed an independent-director subcommittee (Barrett, Anderson) to interview investment banks for possible Party A negotiations and to evaluate strategic options, including a change of control; several firms interviewed.\\\",\\n    \\\"the Board appointed a subcommittee of two independent directors, Frank W. Barrett and Richard W. Anderson, to interview potential investment bankers\\\", 27, None,\\n    D(2015,12,1), D(2015,10,1), D(2015,12,31)))\\n\\nledger.append((\\\"01/27/2016\\\", \\\"GHF\\\", None, \\\"Adviser\\\", 0, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Target's financial adviser; selected after subcommittee interviews; agreed not to represent any buyer or offer financier. GHF's business was acquired by BMO on 08/01/2016 \\\\u2014 same adviser, one relationship.\\\",\\n    \\\"the Board approved the subcommittee\\\\u2019s recommendation and the Company engaged GHF\\\", 27, None,\\n    D(2016,1,27), D(2016,1,27), D(2016,1,27)))\\n\\nledger.append((\\\"03/14/2016\\\", \\\"PWRR\\\", None, \\\"Target sale decision\\\", 0, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Board approved the strategy: discussions with Party A plus solicitation of other parties, and appointed the Transaction Committee (Barrett chair; Anderson; Garvey), which could not itself approve a transaction.\\\",\\n    \\\"Representatives of GHF then proposed a process pursuant to which the Company would proceed with discussions with Party A and also solicit interest from other potential third parties\\\", 27, None,\\n    D(2016,3,14), D(2016,3,14), D(2016,3,14)))\\n\\nledger.append((\\\"03/24/2016\\\", \\\"Hinckley Allen\\\", None, \\\"Adviser\\\", 0, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Target legal counsel; first seen acting at the 03/24/2016 Transaction Committee call and participated in all Committee meetings; later negotiated the merger agreement.\\\",\\n    \\\"representatives of each of GHF and the Company\\\\u2019s legal counsel, Hinckley, Allen & Snyder LLP\\\", 28, None,\\n    D(2016,3,24), D(2016,3,24), D(2016,3,24)))\\n\\nledger.append((\\\"week of March 28, 2016\\\", \\\"GHF\\\", None, \\\"Round opened\\\", 1, None, None, None, None, None, None,\\n    None, None,\\n    \\\"First outreach wave: GHF contacted 11 potential strategic buyers (incl. Party A) and 18 potential financial buyers; five strategic buyers (incl. G&W) met management at the April 3\\\\u20136 Connections Convention.\\\",\\n    \\\"representatives of GHF contacted 11 potential strategic buyers (including Party A) and 18 potential financial buyers\\\", 28, \\\"Q1\\\",\\n    D(2016,3,31), D(2016,3,28), D(2016,4,3)))\\n\\nledger.append((\\\"by 04/07/2016\\\", \\\"2 additional Class I railroads\\\", \\\"Strategic\\\", \\\"Contact\\\", 1, None, None, None, None, None, 2,\\n    None, None,\\n    \\\"Company approached two further Class I railroads to gauge interest; the filing does not say whether they signed confidentiality agreements, remained in the process, or bid.\\\",\\n    \\\"Mr. Noreck reported that the Company had also approached two additional Class I railroads to determine their interest in a possible transaction\\\", 28, \\\"Q3\\\",\\n    D(2016,4,7), None, D(2016,4,7)))\\n\\nledger.append((\\\"by 04/22/2016\\\", \\\"11 strategic NDA signers\\\", \\\"Strategic\\\", \\\"NDA signed\\\", 1, None, None, None, None, None, 11,\\n    None, None,\\n    \\\"All 11 contacted strategic buyers executed confidentiality agreements with no standstills; signers received the Company memorandum (also given to Party C later) and were advised of the IOI deadline.\\\",\\n    \\\"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements\\\", 28, \\\"Q3\\\",\\n    D(2016,4,9), D(2016,3,28), D(2016,4,22)))\\n\\nledger.append((\\\"by 04/22/2016\\\", \\\"14 financial NDA signers\\\", \\\"Financial\\\", \\\"NDA signed\\\", 1, None, None, None, None, None, 14,\\n    None, None,\\n    \\\"14 of 18 contacted financial buyers signed confidentiality agreements (4 did not); with the 11 strategic signers these are the filing's stated 25 signers.\\\",\\n    \\\"Each of the potential strategic buyers and 14 potential financial buyers subsequently executed confidentiality agreements\\\", 28, \\\"Q3\\\",\\n    D(2016,4,9), D(2016,3,28), D(2016,4,22)))\\n\\nledger.append((\\\"04/27/2016\\\", \\\"PWRR\\\", None, \\\"Deadline set\\\", 1, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Board reviewed the process; potential buyers had been advised to submit non-binding IOIs by 05/10/2016; the deadline was later postponed to 05/19/2016.\\\",\\n    \\\"each potential buyer had been advised to submit a non-binding indication of interest by May 10, 2016\\\", 29, None,\\n    D(2016,4,27), D(2016,4,27), D(2016,4,27)))\\n\\nledger.append((\\\"subsequently to 04/27/2016\\\", \\\"PWRR\\\", None, \\\"Deadline revised\\\", 1, None, None, None, None, None, None,\\n    None, None,\\n    \\\"IOI deadline postponed from 05/10/2016 to 05/19/2016 so buyers could prepare their most compelling offers; 05/10 was superseded before arrival, so no outcome is recorded for it.\\\",\\n    \\\"which deadline was subsequently postponed to May 19, 2016 to ensure the potential buyers had sufficient time to formulate their most compelling offers\\\", 29, None,\\n    D(2016,5,3), D(2016,4,27), D(2016,5,10)))\\n\\nledger.append((\\\"05/19/2016\\\", \\\"PWRR\\\", None, \\\"Deadline\\\", 1, None, None, None, None, None, None,\\n    None, None,\\n    \\\"IOI due date reached; nine IOIs arrived over 05/19\\\\u201306/01 and were considered. Rounds sheet records Late bids accepted (Q2).\\\",\\n    \\\"Between May 19, 2016 and June 1, 2016, the Company received nine written indications of interest (\\\\u201cIOIs\\\\u201d) from potential buyers\\\", 29, \\\"Q2\\\",\\n    D(2016,5,19), D(2016,5,19), D(2016,5,19)))\\n\\nledger.append((\\\"between 05/19/2016 and 06/01/2016\\\", \\\"Nine IOI submitters\\\", \\\"Unknown\\\", \\\"Bid\\\", 1, 17.93, 26.50, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 9,\\n    None, None,\\n    \\\"Nine unnamed submitters; as-converted per-share prices implying $90\\\\u2013134 million equity; preliminary and pre-diligence, so Heavy by context; includes the five bidders later named in the LOI round.\\\",\\n    \\\"the Company received nine written indications of interest (\\\\u201cIOIs\\\\u201d) from potential buyers, with offer prices per share ranging from $17.93 to $26.50\\\", 29, None,\\n    D(2016,5,19), D(2016,5,19), D(2016,6,1)))\\n\\nledger.append((\\\"by 05/19/2016\\\", \\\"16 NDA signers\\\", \\\"Unknown\\\", \\\"Did not submit\\\", 1, None, None, None, None, None, 16,\\n    \\\"Not stated\\\", \\\"Y\\\",\\n    \\\"Arithmetic: 25 signers \\\\u2212 9 IOI submitters = 16; identities and types not disclosed. May include Party A. Exits inferred at the IOI deadline (Q3).\\\",\\n    \\\"the Company received nine written indications of interest (\\\\u201cIOIs\\\\u201d) from potential buyers\\\", 29, \\\"Q3\\\",\\n    D(2016,5,19), None, D(2016,5,19)))\\n\\nledger.append((\\\"between 05/23/2016 and 06/01/2016\\\", \\\"Two low bidders\\\", \\\"Unknown\\\", \\\"Dropped by target\\\", 1, None, None, None, None, None, 2,\\n    \\\"Lower offer than rivals\\\", None,\\n    \\\"Lowest of the nine IOI submitters excluded to spare management time before presentations; identities and types not disclosed.\\\",\\n    \\\"In view of the substantial amount of management time that would be required for management presentations, the Transaction Committee concluded that the two low bidders should be excluded\\\", 29, None,\\n    D(2016,5,27), D(2016,5,23), D(2016,6,1)))\\n\\nledger.append((\\\"between 05/23/2016 and 06/01/2016\\\", \\\"PWRR (Transaction Committee)\\\", None, \\\"Round opened\\\", 2, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Committee excluded the two low bidders and advanced seven to in-person management presentations and internet-data-site diligence, tied to the mid-June LOI request (Q1).\\\",\\n    \\\"authorized representatives of GHF to schedule in-person management presentations with the remaining seven potential buyers\\\", 29, \\\"Q1\\\",\\n    D(2016,5,27), D(2016,5,23), D(2016,6,1)))\\n\\nledger.append((\\\"mid-June 2016\\\", \\\"GHF\\\", None, \\\"Deadline set\\\", 2, None, None, None, None, None, None,\\n    None, None,\\n    \\\"GHF instructed all potential buyers to submit non-binding LOIs by 07/20/2016 with markups of merger agreement, disclosure letter and voting agreement, valuing 100% of the common stock per share (as converted).\\\",\\n    \\\"representatives of GHF instructed all potential buyers to submit non-binding letters of intent (\\\\u201cLOIs\\\\u201d) by July 20, 2016\\\", 29, None,\\n    D(2016,6,15), D(2016,6,11), D(2016,6,19)))\\n\\nledger.append((\\\"early July 2016\\\", \\\"Party C\\\", \\\"Strategic\\\", \\\"Bidder interest\\\", 2, None, None, None, None, None, 1,\\n    None, None,\\n    \\\"Late entrant not previously in the process approached management about acquiring the Company; then signed a confidentiality agreement and received the memorandum.\\\",\\n    \\\"a potential strategic buyer that had not previously been part of the process (\\\\u201cParty C\\\\u201d) approached the Company\\\\u2019s management and expressed interest in acquiring the Company\\\", 29, None,\\n    D(2016,7,5), D(2016,7,1), D(2016,7,10)))\\n\\nledger.append((\\\"early July 2016\\\", \\\"Party C\\\", \\\"Strategic\\\", \\\"NDA signed\\\", 2, None, None, None, None, None, 1,\\n    None, None,\\n    \\\"Late entrant's confidentiality agreement; afterwards provided the memorandum already given to the 25 signers. The filing's 25-signer count does not clearly include Party C (Q3).\\\",\\n    \\\"After executing a confidentiality agreement, Party C was provided the memorandum concerning the Company provided to the other potential buyers\\\", 29, \\\"Q3\\\",\\n    D(2016,7,6), D(2016,7,1), D(2016,7,10)))\\n\\nledger.append((\\\"07/12/2016\\\", \\\"Party C\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 21.00, 21.00, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"IOI at $21.00 per share; implied equity value $108 million; made before Party C received data-site access and a management presentation, so preliminary and Heavy by context.\\\",\\n    \\\"Party C submitted an IOI with an offer price per share of $21.00 (implying an equity value of $108 million)\\\", 29, None,\\n    D(2016,7,12), D(2016,7,12), D(2016,7,12)))\\n\\nledger.append((\\\"07/14/2016\\\", \\\"Party C\\\", \\\"Strategic\\\", \\\"Other material event\\\", 2, None, None, None, None, None, 1,\\n    None, None,\\n    \\\"Catch-up access: after its 07/12 IOI, Party C was given internet data-site access and a telephone management presentation; the seven earlier bidders had in-person presentations.\\\",\\n    \\\"Party C was provided access to the internet data site and the Company\\\\u2019s management held a management presentation with Party C by telephone\\\", 29, None,\\n    D(2016,7,14), D(2016,7,14), D(2016,7,14)))\\n\\nledger.append((\\\"07/20/2016\\\", \\\"PWRR\\\", None, \\\"Deadline\\\", 2, None, None, None, None, None, None,\\n    None, None,\\n    \\\"LOI/markup due date reached; six LOIs arrived in late July, including G&W's dated 07/21 after the deadline, which the Company considered; recorded as Late bids accepted (Q2).\\\",\\n    \\\"In late July 2016, the Company received six LOIs with offer prices per share ranging from $19.20 to $24.00\\\", 29, \\\"Q2\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,20)))\\n\\nledger.append((\\\"late July 2016\\\", \\\"Party B\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 24.00, 24.00, \\\"Not stated\\\", \\\"Formal\\\", \\\"Light\\\", 1,\\n    None, None,\\n    \\\"LOI with markups of the merger agreement and voting agreement; subject to an expedited diligence review; highest of the six LOIs.\\\",\\n    \\\"Party B submitted an LOI to acquire the Company for a price of $24.00 per share (subject to an expedited diligence review)\\\", 29, \\\"Q6\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\\n\\nledger.append((\\\"late July 2016\\\", \\\"Party E\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 21.26, 21.26, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"LOI subject to a 60-day exclusivity period for diligence and definitive documentation; provided an issues summary rather than a markup, so classified Informal.\\\",\\n    \\\"Party E (a strategic buyer) submitted an LOI to acquire the Company for a price of $21.26 per share\\\", 30, \\\"Q6\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\\n\\nledger.append((\\\"late July 2016\\\", \\\"Party D\\\", \\\"Financial\\\", \\\"Bid\\\", 2, 21.00, 21.00, \\\"Not stated\\\", \\\"Formal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"Financial buyer's LOI with markups of the merger agreement and voting agreement; subject to a four-week diligence period.\\\",\\n    \\\"Party D (a financial buyer) submitted an LOI to acquire the Company for a price of $21.00 per share (subject to a four-week diligence period)\\\", 30, \\\"Q6\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\\n\\nledger.append((\\\"late July 2016\\\", \\\"Party C\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 19.30, 19.30, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"LOI subject to a 30-day diligence period; no markup reported; lower than Party C's 07/12 IOI.\\\",\\n    \\\"Party C submitted an LOI to acquire the Company for a price of $19.30 per share (subject to a 30-day diligence period)\\\", 30, \\\"Q6\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\\n\\nledger.append((\\\"late July 2016\\\", \\\"Party F\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 19.20, 19.20, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"LOI subject to a 30-day due diligence period; lowest of the six. Later gave financing support to Party E's 08/01 revised bid.\\\",\\n    \\\"Party F (a strategic buyer) submitted an LOI to acquire the Company for a price of $19.20 per share (subject to a 30-day due diligence period)\\\", 30, \\\"Q6\\\",\\n    D(2016,7,20), D(2016,7,20), D(2016,7,31)))\\n\\nledger.append((\\\"by 07/20/2016\\\", \\\"1 strategic non-submitter\\\", \\\"Strategic\\\", \\\"Did not submit\\\", 2, None, None, None, None, None, 1,\\n    \\\"Not stated\\\", None,\\n    \\\"One unnamed strategic buyer in the LOI stage elected not to submit an LOI; reported by the filing without further detail.\\\",\\n    \\\"One strategic buyer and one financial buyer elected not to submit an LOI\\\", 30, None,\\n    D(2016,7,20), None, D(2016,7,20)))\\n\\nledger.append((\\\"by 07/20/2016\\\", \\\"1 financial non-submitter\\\", \\\"Financial\\\", \\\"Did not submit\\\", 2, None, None, None, None, None, 1,\\n    \\\"Not stated\\\", None,\\n    \\\"One unnamed financial buyer in the LOI stage elected not to submit an LOI; reported by the filing without further detail.\\\",\\n    \\\"One strategic buyer and one financial buyer elected not to submit an LOI\\\", 30, None,\\n    D(2016,7,20), None, D(2016,7,20)))\\n\\nledger.append((\\\"07/21/2016\\\", \\\"G&W\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 21.15, 21.15, \\\"Yes\\\", \\\"Formal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"$20.02 cash at closing plus $1.13 CVR based on the South Quay property sale; three-week exclusive diligence condition; markups of merger agreement, voting agreement and disclosure letter; one day late.\\\",\\n    \\\"G&W submitted an LOI on July 21, 2016 to acquire the Company for a price of $21.15 per share (subject to a three-week exclusive diligence period)\\\", 29, \\\"Q6\\\",\\n    D(2016,7,21), D(2016,7,21), D(2016,7,21)))\\n\\nledger.append((\\\"07/26/2016\\\", \\\"G&W\\\", \\\"Strategic\\\", \\\"Bid\\\", 2, 22.15, 22.15, \\\"Yes\\\", \\\"Formal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"Revised after GHF said the $21.15 price and CVR structure were not competitive: $21.02 cash plus $1.13 CVR; three-week exclusive diligence condition unchanged.\\\",\\n    \\\"G&W submitted a revised LOI, which increased its offer to $22.15 per share (including $21.02 in cash and $1.13 CVR)\\\", 29, \\\"Q6\\\",\\n    D(2016,7,26), D(2016,7,26), D(2016,7,26)))\\n\\nledger.append((\\\"07/27/2016\\\", \\\"PWRR (Transaction Committee)\\\", None, \\\"Round opened\\\", 3, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Committee advanced G&W and Party B to confirmatory due diligence and negotiations on their higher offers; no exclusivity executed; post-selection bids and diligence follow (Q1).\\\",\\n    \\\"the Company should proceed with confirmatory due diligence and negotiations with G&W and Party B because of the higher offers made by each of G&W and Party B\\\", 30, \\\"Q1\\\",\\n    D(2016,7,27), D(2016,7,27), D(2016,7,27)))\\n\\nfor nm, pr in ((\\\"Party C\\\", 19.30), (\\\"Party D\\\", 21.00), (\\\"Party E\\\", 21.26), (\\\"Party F\\\", 19.20)):\\n    who_type = \\\"Financial\\\" if nm == \\\"Party D\\\" else \\\"Strategic\\\"\\n    ledger.append((\\\"07/27/2016\\\", nm, who_type, \\\"Dropped by target\\\", 2, None, None, None, None, None, 1,\\n        \\\"Lower offer than rivals\\\", None,\\n        \\\"Told by GHF after the 07/27 selection that it was no longer involved; $%.2f LOI below the two finalists' offers.\\\" % pr,\\n        \\\"representatives of GHF subsequently contacted the remaining bidders to inform them that they were no longer involved in the process\\\", 30, None,\\n        D(2016,7,27), D(2016,7,27), D(2016,7,27)))\\n\\nledger.append((\\\"08/01/2016\\\", \\\"Party D\\\", \\\"Financial\\\", \\\"Bid\\\", 3, 24.00, 24.00, \\\"Not stated\\\", \\\"Formal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"returned after exit #34; revised LOI at a matching $24.00 with a 30-day due diligence period; on 08/02 declined to shorten it.\\\",\\n    \\\"On August 1, 2016, Party D submitted a revised LOI at a price of $24.00 per share\\\", 30, None,\\n    D(2016,8,1), D(2016,8,1), D(2016,8,1)))\\n\\nledger.append((\\\"08/01/2016\\\", \\\"Party E\\\", \\\"Strategic\\\", \\\"Bid\\\", 3, 23.81, 23.81, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"returned after exit #35; revised LOI with a 30-day due diligence period and financing support from Party F, which had already left the process \\\\u2014 no new row for F.\\\",\\n    \\\"Party E submitted a revised LOI, along with financing support, from Party F, at a price of $23.81 per share\\\", 30, None,\\n    D(2016,8,1), D(2016,8,1), D(2016,8,1)))\\n\\nledger.append((\\\"08/02/2016\\\", \\\"Party E\\\", \\\"Strategic\\\", \\\"Bid\\\", 3, 21.26, 21.26, \\\"Not stated\\\", \\\"Informal\\\", \\\"Heavy\\\", 1,\\n    None, None,\\n    \\\"revises #38: withdrew the $23.81 revision and confirmed its original $21.26 proposal \\\\u2014 a new bid at the old level, not an exit; standing 60-day exclusivity condition.\\\",\\n    \\\"Party E withdrew its revised proposal on August 2, 2016 (but confirmed its original proposal of $21.26 per share)\\\", 30, None,\\n    D(2016,8,2), D(2016,8,2), D(2016,8,2)))\\n\\nledger.append((\\\"08/02/2016\\\", \\\"Party D\\\", \\\"Financial\\\", \\\"Withdrew\\\", 3, None, None, None, None, None, 1,\\n    \\\"Terms or process\\\", None,\\n    \\\"D's decision: declined to shorten its 30-day diligence period and sought a no-signing commitment during it; Company refused; D would not proceed with further diligence at that time.\\\",\\n    \\\"Party D declined to shorten its due diligence period and requested that the Company commit that it would not enter into an agreement with another bidder\\\", 30, None,\\n    D(2016,8,2), D(2016,8,2), D(2016,8,2)))\\n\\nledger.append((\\\"by 08/04/2016\\\", \\\"Party E\\\", \\\"Strategic\\\", \\\"Dropped by target\\\", 3, None, None, None, None, None, 1,\\n    \\\"Not stated\\\", \\\"Y\\\",\\n    \\\"E not among the parties the Committee directed on 08/04 to continue diligence and negotiations (G&W, Party B); closed by inference \\\\u2014 no reported exclusion or statement (Q5).\\\",\\n    \\\"During that discussion, the Transaction Committee directed the management team and representatives of each of BMO and Hinckley Allen to continue diligence and negotiations with both G&W and Party B\\\", 31, \\\"Q5\\\",\\n    D(2016,8,4), None, D(2016,8,4)))\\n\\nledger.append((\\\"08/04/2016\\\", \\\"Party B\\\", \\\"Strategic\\\", \\\"Bid reaffirmed\\\", 3, 24.00, 24.00, \\\"Not stated\\\", \\\"Formal\\\", \\\"Light\\\", 1,\\n    None, None,\\n    \\\"reaffirmed by returned draft: B's counsel returned a revised merger agreement draft after the Committee decided to complete the agreement with B; $24.00 carried from #23; standing expedited-diligence condition.\\\",\\n    \\\"legal counsel for Party B provided a revised draft of the merger agreement\\\", 31, \\\"Q4\\\",\\n    D(2016,8,4), D(2016,8,4), D(2016,8,4)))\\n\\nledger.append((\\\"08/09/2016\\\", \\\"G&W\\\", \\\"Strategic\\\", \\\"Other material event\\\", 3, None, None, None, None, None, 1,\\n    None, None,\\n    \\\"Informed G&W the Company intended to enter a merger agreement with another bidder; G&W asked to continue physical diligence on 08/10\\\\u201308/11 to prepare an improved offer; granted.\\\",\\n    \\\"the Transaction Committee directed representatives of BMO to inform G&W that the Company intended to enter into a merger agreement with another bidder\\\", 31, None,\\n    D(2016,8,9), D(2016,8,9), D(2016,8,9)))\\n\\nledger.append((\\\"08/10/2016\\\", \\\"Simpson Thacher\\\", None, \\\"Adviser\\\", 3, None, None, None, None, None, None,\\n    None, None,\\n    \\\"G&W's legal counsel; first seen acting in the 08/10/2016 discussion of merger and voting agreement provisions; submitted G&W's disclosure-letter markup on 08/12.\\\",\\n    \\\"representatives of Hinckley Allen and Simpson Thacher & Bartlett LLP (which we refer to as \\\\u201cSimpson Thacher\\\\u201d), G&W\\\\u2019s legal counsel\\\", 31, None,\\n    D(2016,8,10), D(2016,8,10), D(2016,8,10)))\\n\\nledger.append((\\\"08/12/2016\\\", \\\"G&W\\\", \\\"Strategic\\\", \\\"Bid\\\", 3, 25.00, 25.00, \\\"Yes\\\", \\\"Formal\\\", \\\"None\\\", 1,\\n    None, None,\\n    \\\"Revised LOI at $25.00 all cash, dropping the CVR; markups of merger agreement and voting agreement (disclosure-letter markup later); offer to expire 6:00 p.m. 08/13; no financing condition in the executed agreement.\\\",\\n    \\\"G&W submitted a revised LOI to acquire the Company for a price of $25.00 per share in cash, which excluded the previously proposed CVR\\\", 31, None,\\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\\n\\nledger.append((\\\"08/12/2016\\\", \\\"Party B\\\", \\\"Strategic\\\", \\\"Not selected at signing\\\", 3, None, None, None, None, None, 1,\\n    \\\"Would not improve earlier offer\\\", None,\\n    \\\"Asked on 08/12 whether it would raise its standing $24.00 bid after another party bid higher; declined; Board then determined G&W's $25.00 superior and signed.\\\",\\n    \\\"Party B indicated that it would not increase its price\\\", 32, None,\\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\\n\\nledger.append((\\\"08/12/2016\\\", \\\"PWRR and G&W\\\", None, \\\"Merger agreement signed\\\", 3, None, None, None, None, None, None,\\n    None, None,\\n    \\\"Agreed price $25.00 per share of common stock in cash; preferred converts 100-for-1 (plus accrued dividends) and receives the same $25.00. Board approved; Eder Trusts signed the voting agreement.\\\",\\n    \\\"the Company and G&W executed the merger agreement, and the Company, G&W and the Eder Trusts executed the voting agreement\\\", 32, None,\\n    D(2016,8,12), D(2016,8,12), D(2016,8,12)))\\n\\nledger.append((\\\"08/15/2016\\\", \\\"PWRR\\\", None, \\\"Merger announced\\\", \\\"post\\\", None, None, None, None, None, None,\\n    None, None,\\n    \\\"Press release before market open announced the signed merger; prior close $16.30, a 53% premium.\\\",\\n    \\\"The Company issued a press release publicly announcing the transaction on Monday, August 15, 2016 prior to the opening of trading\\\", 32, None,\\n    D(2016,8,15), D(2016,8,15), D(2016,8,15)))\\n\\n# assign numbers\\nrows = []\\nfor i, r in enumerate(ledger, start=1):\\n    rows.append((i,) + r)\\n\\n# ---------- validation ----------\\nerrors = []\\nprev = None\\nfor r in rows:\\n    (num, when, who, typ, ev, rnd, plow, phigh, allcash, form, cond, count, exitr, inf, note, quote, page, flag, srt, dfr, dto) = r\\n    wc = len(note.split())\\n    if wc > 40:\\n        errors.append(f\\\"row {num}: note {wc} words\\\")\\n    qwc = len(quote.split())\\n    if qwc > 30:\\n        errors.append(f\\\"row {num}: quote {qwc} words\\\")\\n    if quote not in norm:\\n        errors.append(f\\\"row {num}: QUOTE NOT FOUND: {quote[:60]}\\\")\\n    else:\\n        pg = page_of_quote(quote)\\n        if pg != page:\\n            errors.append(f\\\"row {num}: page mismatch got {pg} want {page}\\\")\\n    if not who:\\n        errors.append(f\\\"row {num}: empty Who\\\")\\n    if srt is None:\\n        errors.append(f\\\"row {num}: empty sort date\\\")\\n    if prev and srt < prev:\\n        errors.append(f\\\"row {num}: sort date decreased {prev} -> {srt}\\\")\\n    prev = srt\\n    if dfr and srt < dfr or dto and srt > dto:\\n        errors.append(f\\\"row {num}: sort outside from-to\\\")\\n    for lab, val, allowed in ((\\\"Type\\\", typ, {\\\"Strategic\\\", \\\"Financial\\\", \\\"Mixed\\\", \\\"Unknown\\\"}),\\n                              (\\\"All cash\\\", allcash, {\\\"Yes\\\", \\\"No\\\", \\\"Not stated\\\"}),\\n                              (\\\"Formality\\\", form, {\\\"Formal\\\", \\\"Informal\\\", \\\"Unclear\\\"}),\\n                              (\\\"Conditions\\\", cond, {\\\"None\\\", \\\"Light\\\", \\\"Heavy\\\", \\\"Unclear\\\"}),\\n                              (\\\"Exit reason\\\", exitr, {\\\"Value below market price\\\", \\\"Value at or below market price\\\",\\n                                                      \\\"Value below earlier offer\\\", \\\"Value at earlier offer\\\",\\n                                                      \\\"Would not improve earlier offer\\\", \\\"Lower offer than rivals\\\",\\n                                                      \\\"Terms or process\\\", \\\"Other stated reason\\\", \\\"Not stated\\\"}),\\n                              (\\\"Inferred\\\", inf, {\\\"Y\\\"})):\\n        if val is not None and val not in allowed:\\n            errors.append(f\\\"row {num}: bad {lab}={val}\\\")\\n    if rnd not in (0, 1, 2, 3, \\\"post\\\"):\\n        errors.append(f\\\"row {num}: bad round {rnd}\\\")\\n\\nprint(\\\"LEDGER ROWS:\\\", len(rows))\\nif errors:\\n    print(\\\"ERRORS:\\\")\\n    for e in errors:\\n        print(\\\" \\\", e)\\nelse:\\n    print(\\\"All ledger validation checks passed.\\\")\\n\\n# exit-reference sanity for numbered notes\\nimport sys\\nsys.stdout.flush()\\n\"}"},"time":{"start":1789825515830,"end":1789825538334}}}}
