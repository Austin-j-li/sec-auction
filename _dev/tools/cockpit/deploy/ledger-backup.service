[Unit]
Description=Ledger cockpit nightly backup (sec-extraction): workspace database and file store

[Service]
Type=oneshot
WorkingDirectory=%h/work/Projects/sec-extraction
ExecStart=/usr/bin/python3 _dev/tools/cockpit/backup.py create
Environment=PYTHONUSERBASE=%h/work/.local
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
