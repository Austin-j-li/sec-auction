+class ReleaseTests(unittest.TestCase):
+    """Gate 12 (D25): move the nine workbooks, repoint the catalog, then export the v1.14 runs to extraction/."""
+
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.cockpit = nine_deal_repo(self.root)  # as before the release
+
+    def tearDown(self): self.temp.cleanup()
+
+    def export(self, *args: str) -> tuple[int, str]:
+        err = io.StringIO()
+        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(err):
+            code = export_repo.main(["--repo-root", str(self.root), *args])
+        return code, err.getvalue()
+
+    def test_working_copies_survive_relocation_and_the_export(self):
+        for slug in ("kraton", "mac-gray"):
+            edit(self.cockpit, slug)
+        runs = {slug: import_version(self.cockpit, slug) for slug in imp.DEALS}
+        before = {slug: shown(self.cockpit.deal(slug)) for slug in imp.DEALS}
+        code, err = self.export("deal", "kraton", "--version", "run1")
+        self.assertEqual(code, 1)
+        self.assertIn("immutable original", err)
+        relocate(self.root)
+        catalog = json.loads((self.root / "_dev/cockpit/catalog.json").read_text(encoding="utf-8"))
+        cockpit = data.Cockpit(self.root)
+        for slug in imp.DEALS:
+            version = catalog["deals"][slug]["versions"][0]
+            self.assertEqual((version["id"], version["sha256"], version["instruction_version"], version["path"]),
+                             (imp.VERSION_ID, before[slug][2], "v1.13.2", f"{imp.WORKBOOKS}/{slug}.xlsx"))
+            self.assertEqual(shown(cockpit.deal(slug)), before[slug])
+        self.assertEqual([before[slug][0] for slug in ("kraton", "mac-gray", "stec")], [1, 1, 0])
+        verify_catalog.verify(self.root)
+        for slug in imp.DEALS:
+            self.assertEqual(self.export("deal", slug, "--version", "run1", "--write"), (0, ""))
+            self.assertEqual((self.root / "extraction" / f"{slug}.xlsx").read_bytes(), runs[slug])
+        cockpit = data.Cockpit(self.root)
+        self.assertEqual(cockpit.slugs(), sorted(imp.DEALS))
+        for slug in imp.DEALS:
+            self.assertEqual(shown(cockpit.deal(slug)), before[slug])
+        outcome = verify_catalog.verify(self.root)
+        self.assertEqual(outcome["deals"]["kraton"]["versions"], ["working", imp.VERSION_ID, "run1"])
+
+
 if __name__ == "__main__":
     unittest.main()
